{"slug": "thyme-and-feta-lamb", "nyt_id": 10429, "url": "https://cooking.nytimes.com/recipes/10429-thyme-and-feta-lamb", "name": "Thyme and Feta Lamb", "author": "Sara Dickerman", "description": "Sara Dickerman", "servings": {"text": "Serves 4", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "15 minutes, plus 1 hour's refrigeration"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cloves garlic, smashed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "smashed", "optional": false}, {"position": 4, "raw": "2 tablespoons fresh thyme leaves, finely chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh thyme leaves", "preparation": "finely chopped", "optional": false}, {"position": 5, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "12 small lamb chops (2 to 2 ½ pounds total)", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "small lamb chops (2 to 2 ½ pounds total)", "preparation": null, "optional": false}, {"position": 7, "raw": "4 ounces feta cheese, preferably Greek or French", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "feta cheese", "preparation": "preferably Greek or French", "optional": false}, {"position": 8, "raw": "2 tablespoons chopped mint leaves", "group": null, "quantity": 2.
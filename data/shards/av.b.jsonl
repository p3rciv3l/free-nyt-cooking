{"slug": "avocado-and-beet-salad-with-citrus-vinaigrette", "nyt_id": 11008, "url": "https://cooking.nytimes.com/recipes/11008-avocado-and-beet-salad-with-citrus-vinaigrette", "name": "Avocado And Beet Salad With Citrus Vinaigrette", "author": "Marian Burros", "description": "Marian Burros", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "6 medium red or golden beets", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "medium red or golden beets", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon red wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon, plus ¾ cup extra virgin olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "tablespoon", "preparation": "plus ¾ cup extra virgin olive oil", "optional": false}, {"position": 5, "raw": "1 large shallot, finely diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large shallot", "preparation": "finely diced", "optional": false}, {"position": 6, "raw": "2 tablespoons white wine vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "white wine vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon orange juice", "grou
{"slug": "avocado-artichoke-salad", "nyt_id": 3128, "url": "https://cooking.nytimes.com/recipes/3128-avocado-artichoke-salad", "name": "Avocado-Artichoke Salad", "author": "Moira Hodgson", "description": "", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": 15, "cook_minutes": 40, "total_minutes": 55, "raw": {"total": "55 minutes", "prep": "15 minutes", "cook": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "4 large artichokes", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large artichokes", "preparation": null, "optional": false}, {"position": 2, "raw": "2 ripe avocados", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "ripe avocados", "preparation": null, "optional": false}, {"position": 3, "raw": "2 large ripe tomatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large ripe tomatoes", "preparation": null, "optional": false}, {"position": 4, "raw": "3 to 4 tablespoons red-wine vinegar (according to taste)", "group": null, "quantity": 3.0, "quantity_max": 4.0, "unit": "tbsp", "item": "red-wine vinegar (according to taste)", "preparation": null, "optional": false}, {"position": 5, "raw": "¾ cup extra-virgin oil", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "extra-virgin oil", "preparation": null, "optional": false}, {"position": 6, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons fresh herbs such as chives, tarragon or chervil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh herbs such as chives", "preparation": "tarragon or chervil", "optional": false}], "steps": [{"position": 1, "text": "Cook the artichokes until tender in boiling salted water (about 30 to 40 minutes. Drain and cool. Cut them in half and remove the chokes. Slice the artichokes thin, vertically."}, {"position": 2, "text": "Combine the vinegar, oil, salt and pepper for the dressing."}, {"position": 3, "text": "Pit, peel and slice the avocados lengthwise. Slice the tomatoes and arrange them on a round serving platter. Arrange the avocado in alternating slices with the artichokes on top of the tomatoes, in a pattern forming the spokes of a wheel. Pour the dressing lightly over the slices and sprinkle with the herbs. Serve at once."}], "nutrition": {"calories": 309.0, "protein_g": 4.1, "carbohydrates_g": 14.7, "fat_g": 28.0, "saturated_fat_g": 2.6, "trans_fat_g": 0.1, "cholesterol_mg": 0.0, "sodium_mg": 460.4, "fiber_g": 8.4, "sugar_g": 2.2, "unsaturated_fat_g": 24.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["artichoke", "avocado", "quick", "salad", "summer", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 13}, "video_url": null, "comment_count": null, "published_at": "1987-09-20", "scraped_at": "2026-09-07T00:18:15.254436+00:00", "scraper_version": "1.0.0"}

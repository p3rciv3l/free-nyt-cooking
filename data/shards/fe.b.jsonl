{"slug": "fettuccine-with-asparagus-and-shiitake-mushrooms", "nyt_id": 9077, "url": "https://cooking.nytimes.com/recipes/9077-fettuccine-with-asparagus-and-shiitake-mushrooms", "name": "Fettuccine With Asparagus And Shiitake Mushrooms", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 main-course servings", "min": 4, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ pounds asparagus, tough stalks trimmed and all stalks cut into ¾-inch pieces", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "asparagus", "preparation": "tough stalks trimmed and all stalks cut into ¾-inch pieces", "optional": false}, {"position": 2, "raw": "1 pound fettuccine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fettuccine", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 garlic clove, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "garlic clove", "preparation": "minced", "optional": false}, {"position": 5, "raw": "3 shallots, chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "shallots", "preparation": "chopped", "optional": false}, {"position": 6, "raw": "6 shiitake mushrooms, sliced", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "shiitake mushrooms", "preparation": "sliced", "optional": false}, {"position": 7, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons parsley,
{"slug": "fettuccine-with-asparagus-fava-beans-and-prosciutto", "nyt_id": 5435, "url": "https://cooking.nytimes.com/recipes/5435-fettuccine-with-asparagus-fava-beans-and-prosciutto", "name": "Fettuccine With Asparagus, Fava Beans and Prosciutto", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound asparagus", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "asparagus", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ pounds fava beans, peeled and their pulps removed", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "fava beans", "preparation": "peeled and their pulps removed", "optional": false}, {"position": 3, "raw": "1 pound fettuccine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fettuccine", "preparation": null, "optional": false}, {"position": 4, "raw": "3 tablespoons unsalted butter", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 5, "raw": "2 shallots, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "shallots", "preparation": "minced", "optional": false}, {"position": 6, "raw": "¼ pound prosciutto, diced", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "prosciutto", "preparation": "diced", "optional": false}, {"position": 7, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon fresh tarragon leaves, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh tarragon leaves", "preparation": "chopped", "optional": false}, {"position": 9, "raw": "Coarse salt and freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "Freshly grated Parmesan cheese", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Trim the tough ends of the stalks from the asparagus. With a vegetable peeler, pare away any tough skin from the lower half of the stalk. Cut the asparagus into one-and-a-half-inch pieces."}, {"position": 2, "text": "Cook the asparagus in boiling salted water until barely tender. Rinse under cool running water and drain well. Set aside and keep warm."}, {"position": 3, "text": "Steam the fava beans until barely tender. Set them aside and keep them warm. Meanwhile, bring six quarts salted water to boil for the fettuccine."}, {"position": 4, "text": "Melt the butter in a saute pan. Add the shallots and the prosciutto and saute for one minute. Add the cream and bring to a simmer. Add the tarragon and salt and pepper and cook, stirring, for five minutes, or until the sauce has thickened slightly. Add the asparagus and fava beans and heat through. Keep the sauce warm until the fettuccine is cooked."}, {"position": 5, "text": "When the fettuccine is al dente, drain it and transfer it to a heated serving bowl. Add the sauce, toss and serve. Pass freshly grated Parmesan cheese separately."}], "nutrition": {"calories": 654.6, "protein_g": 29.3, "carbohydrates_g": 84.9, "fat_g": 25.0, "saturated_fat_g": 14.3, "trans_fat_g": 0.5, "cholesterol_mg": 76.5, "sodium_mg": 828.3, "fiber_g": 13.4, "sugar_g": 16.6, "unsaturated_fat_g": 8.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "mea
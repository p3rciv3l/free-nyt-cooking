{"slug": "fettuccine-with-fennel-and-shiitake-mushrooms", "nyt_id": 6415, "url": "https://cooking.nytimes.com/recipes/6415-fettuccine-with-fennel-and-shiitake-mushrooms", "name": "Fettuccine With Fennel And Shiitake Mushrooms", "author": "Florence Fabricant", "description": "", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": 10, "cook_minutes": 20, "total_minutes": 30, "raw": {"total": "30 minutes", "prep": "10 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ pound fresh shiitake mushrooms, sliced very thin", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "fresh shiitake mushrooms", "preparation": "sliced very thin", "optional": false}, {"position": 3, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "1 ½ cups very thinly sliced fennel bulbs", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "very thinly sliced fennel bulbs", "preparation": null, "optional": false}, {"position": 5, "raw": "6 ounces fresh fettuccine", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "oz", "item": "fresh fettuccine", "preparation": null, "optional": false}, {"position": 6, "raw": "⅓ cup heavy cream", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 7, "raw": "1 sun-dried tomato, slivered", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "sun-dried tomato", "preparation": "slivered", "optional": false}, {"position": 8, "raw": "½ tablespoon minced fenne
{"slug": "fettuccine-with-eggplant-and-tomato-sauce", "nyt_id": 4081, "url": "https://cooking.nytimes.com/recipes/4081-fettuccine-with-eggplant-and-tomato-sauce", "name": "Fettuccine With Eggplant And Tomato Sauce", "author": "Marian Burros", "description": "", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound eggplant", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "eggplant", "preparation": null, "optional": false}, {"position": 2, "raw": "Olive oil pan spray", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "olive oil pan spray", "preparation": null, "optional": false}, {"position": 3, "raw": "1 large clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large clove garlic", "preparation": null, "optional": false}, {"position": 4, "raw": "1 4-ounce onion or 3 ounces chopped onion (1 cup)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "4-ounce onion or 3 ounces chopped onion (1 cup)", "preparation": null, "optional": false}, {"position": 5, "raw": "1 28-ounce can chopped or crushed tomatoes, no salt added", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "28-ounce can chopped or crushed tomatoes", "preparation": "no salt added", "optional": false}, {"position": 6, "raw": "1 ½ tablespoons tomato paste, no salt added", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "tomato paste", "preparation": "no salt added", "optional": false}, {"position": 7, "raw": "1 teaspoon capers", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "capers", "preparation": null, "optional": false}, {"position": 8, "raw": "Fresh basil", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "fresh basil", "preparation": null, "optional": false}, {"position": 9, "raw": "8 ounces no-egg fettuccine", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "no-egg fettuccine", "preparation": null, "optional": false}, {"position": 10, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring water to boil in covered pot for fettuccine; turn on broiler; cover broiler pan with aluminum foil."}, {"position": 2, "text": "Wash eggplant and trim off ends. Slice eggplant into rounds ¼-inch thick; arrange on a foil-covered pan and spray lightly with olive oil. Broil 2 to 3 inches from heat source for about 10 minutes. Don't let the slices burn."}, {"position": 3, "text": "Mince garlic; chop the whole onion."}, {"position": 4, "text": "Heat a nonstick pan and spray lightly with olive oil. Saute garlic and onion until onion begins to soften."}, {"position": 5, "text": "Add tomatoes, tomato paste and capers. Cook over high heat for 10 minutes or so."}, {"position": 6, "text": "Turn eggplant and spray the other side; continue to broil another 6 or 7 minutes."}, {"position": 7, "text": "Cook pasta according to package directions."}, {"position": 8, "text": "Wash, dry and chop basil to make 1 tablespoon. Stir into the tomatoes; season with freshly ground black pepper."}, {"position": 9, "text": "Remove eggplant from broiler and roughly cut it into large chunks; do not peel. Stir into the sauce. To serve, drain pasta and top with sauce."}], "nutrition": {"calories": 672.6, "protein_g": 25.8, "carbohydrates_g": 137.6, "fat_g": 5.9, "saturated_fat_g": 0.9, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 882.2, "fiber_g": 20.5, "sugar_g": 32.5, "unsaturated_fat_g": 3.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"]
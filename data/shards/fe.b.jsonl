{"slug": "fettuccine-with-roasted-mushrooms", "nyt_id": 10749, "url": "https://cooking.nytimes.com/recipes/10749-fettuccine-with-roasted-mushrooms", "name": "Fettuccine With Roasted Mushrooms", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoon extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cloves garlic, sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "sliced", "optional": false}, {"position": 3, "raw": "4 sprigs fresh thyme", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "sprig", "item": "fresh thyme", "preparation": null, "optional": false}, {"position": 4, "raw": "10 ounces shiitake mushrooms", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "shiitake mushrooms", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "10 ounces fresh fettuccine", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "fresh fettuccine", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 325 degrees. Line a baking sheet with foil. Brush the foil with about a teaspoon of the oil and scatter the garlic and thyme over the foil."}, {"position": 2, "text": "Remove and discard the stems from the mushrooms. Place the mushroom caps stem side down in a single layer on the baking sheet. Roast the mushrooms for 30 minutes."}, {"position": 3, "text": "Remove the mushroom caps from the oven and slice them into slivers about a fourth of an inch wide. Chop the garlic and the thyme from the baking sheet. This much of the recipe can be prepared up to 4 hours in advance."}, {"position": 4, "text": "Shortly before serving, bring a large pot of salted water to a boil. Cook the fettuccine about three minutes. Drain it well, then place it in a shallow saucepan or a skillet. Add the mushrooms, chopped thyme and garlic and the remaining olive oil. Cook over low heat a few minutes, tossing the noodles gently, to mix all of the ingredients. Season to taste with salt and pepper, gently fold in the parsley and serve the fettuccine alongside the monkfish."}], "nutrition": {"calories": 294.3, "protein_g": 9.9, "carbohydrates_g": 45.1, "fat_g": 8.8, "saturated_fat_g": 1.2, "trans_fat_g": 0.0, "cholesterol_mg": 51.7, "sodium_mg": 356.9, "fiber_g": 2.3, "sugar_g": 1.7, "unsaturated_fat_g": 6.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "vegan", "vegetarian"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["boil", "fettuccine", "five ingredient", "pastas", "roast", "shiitake"]}, "images": [], "rating": {"average": 4.0, "count": 11}, "video_url": null, "comment_count": null, "published_at": "1993-07-11", "scraped_at": "2026-09-06T22:31:35.522214+00:00", "scraper_version": "1.0.0"}

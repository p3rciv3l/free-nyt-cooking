{"slug": "duck-ham-taleggio-and-mushroom-panini", "nyt_id": 11375, "url": "https://cooking.nytimes.com/recipes/11375-duck-ham-taleggio-and-mushroom-panini", "name": "Duck-Ham-Taleggio-And-Mushroom Panini", "author": "Maura Egan", "description": "Maura Egan", "servings": {"text": "5 panini", "min": 5, "max": 5, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "About 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound hen-of-the wood mushrooms", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "hen-of-the wood mushrooms", "preparation": null, "optional": false}, {"position": 2, "raw": "Olive oil for cooking", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "olive oil for cooking", "preparation": null, "optional": false}, {"position": 3, "raw": "Kosher salt, freshly ground black pepper, extra-virgin olive oil and sherry vinegar to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt", "preparation": "freshly ground black pepper, extra-virgin olive oil and sherry vinegar to taste", "optional": false}, {"position": 4, "raw": "5 ciabata rolls", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "ciabata rolls", "preparation": null, "optional": false}, {"position": 5, "raw": "1 whole smoked magret (duck breast), thinly sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "whole smoked magret (duck breast)", "preparation": "thinly sliced", "optional": false}, {"position": 6, "raw": "1 pound of taleggio cheese, sliced lengthwise", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "of taleggio cheese", "preparation": "sliced lengthwise", "optional": false}], "steps": [{"position": 1, "text": "Slice caps off stalks of mushrooms. Discard the stalks. Sauté the caps in oil and season with salt and pepper. Remove and drain on paper towels. Let cool. Adjust seasonings and dress to taste with oil and vinegar."}, {"position": 2, "text": "Slice rolls. If the bread is too doughy, scoop out center."}, {"position": 3, "text": "Lay about 8 slices of duck on bread. Cover with 2 tablespoons of mushrooms. Add 2 slices of cheese. Top with bread. Repeat for 4 sandwiches."}, {"position": 4, "text": "If you own a panini press, use it. If not, use two sauté pans. Heat both pans and place sandwich in one and gently place other pan on top of the sandwich. Grill for 3 minutes and remove. Season to taste with olive oil, salt and pepper. Serve."}], "nutrition": {"calories": 568.8, "protein_g": 33.1, "carbohydrates_g": 33.9, "fat_g": 33.6, "saturated_fat_g": 15.7, "trans_fat_g": 0.0, "cholesterol_mg": 90.9, "sodium_mg": 1097.9, "fiber_g": 2.4, "sugar_g": 3.2, "unsaturated_fat_g": 15.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["cheese", "duck", "five ingredient", "grill", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "2002-04-28", "scraped_at": "2026-09-06T23:46:07.627986+00:00", "scraper_version": "1.0.0"}
{"slug": "duck-legs-with-cabbage-and-tomatoes", "nyt_id": 10436, "url": "https://cooking.nytimes.com/recipes/10436-duck-legs-with-cabbage-and-tomatoes", "name": "Duck Legs With Cabbage and Tomatoes", "author": "Moira Hodgson", "description": "Braised duck legs, falling off the bone, has long been a match for vegetables such as cabbage, turnips or white beans. This recipe, based on a dish by Paul Bertolli of Chez Panisse featured in “The Open Hand Cookbook” (Pocket Books, 1989), can be doubled or quadrupled easily. Moira Hodgson", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": 120, "cook_minutes": 130, "total_minutes": 250, "raw": {"total": "2 hours, plus 2 hours’ marinating", "prep": "2 hours", "cook": "2 hours unattended, 10 minutes attended"}}, "ingredients": [{"position": 1, "raw": "2 duck legs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "duck legs", "preparation": null, "optional": false}, {"position": 2, "raw": "Coarse salt and freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon fresh rosemary leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh rosemary leaves", "preparation": null, "optional": false}, {"position": 4, "raw": "1 small red onion, sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small red onion", "preparation": "sliced", "optional": false}, {"position": 5, "raw": "¼ green cabbage, cut in thick slices", "group": null, "quantity": 0.25, "quantity_max": null, "unit": null, "item": "green cabbage", "preparation": "cut in thick slices", "optional": false}, {"position": 6, "raw": "1 tablespoon balsamic vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "2 ripe tomatoes peeled, seeded and chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "ripe tomatoes peeled", "preparation": "seeded and chopped", "optional": false}], "steps": [{"position": 1, "text": "Trim the fat from under the skin around the duck legs. Combine the salt, pepper and rosemary. Sprinkle the mixture on the legs and let them marinate at room temperature for two hours."}, {"position": 2, "text": "Preheat oven to 350 degrees. Heat a cast iron casserole and place the duck legs skin side down. Cook slowly for 20 minutes, until the legs are evenly browned. Pour the excess fat off as you cook."}, {"position": 3, "text": "Remove the legs from the pan and leave in one tablespoon duck fat. Add the onion and cook until soft. Add the cabbage, balsamic vinegar, pepper to taste and cook until the cabbage is wilted. Place the cabbage in a baking dish and put the duck legs on top. Spread the tomatoes over the top, cover and bake for one-and-a-half hours or until the duck legs are tender."}], "nutrition": {"calories": 960.8, "protein_g": 27.7, "carbohydrates_g": 10.5, "fat_g": 89.2, "saturated_fat_g": 29.9, "trans_fat_g": 0.0, "cholesterol_mg": 171.8, "sodium_mg": 920.7, "fiber_g": 2.5, "sugar_g": 6.0, "unsaturated_fat_g": 53.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "cabbage", "duck leg", "marinate", "saute", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 15}, "video_url": null, "comment_count": null, "published_at": "1990-10-14", "scraped_at": "2026-09-06T22:23:03.777120+00:00", "scraper_version": "1.0.0"}
{"slug": "duck-salad", "nyt_id": 2188, "url": "https://cooking.nytimes.com/recipes/2188-duck-salad", "name": "Duck Salad", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 25, "cook_minutes": 180, "total_minutes": 205, "raw": {"total": "3 hours 25 minutes", "prep": "25 minutes", "cook": "3 hours"}}, "ingredients": [{"position": 1, "raw": "1 Long Island duckling, 4 ½ to 5 pounds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "long island duckling", "preparation": "4 ½ to 5 pounds", "optional": false}, {"position": 2, "raw": "1 8-ounce package Japanese buckwheat noodles (soba)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "8-ounce package japanese buckwheat noodles (soba)", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup peanut oil", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "peanut oil", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "1 large sweet yellow pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large sweet yellow pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "4 scallions, chopped", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "chopped", "optional": false}, {"position": 7, "raw": "1 cucumber, peeled, seeded and cut into julliene slivers", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "cucumber", "preparation": "peeled, seeded and cut into julliene slivers", "optional": false}, {"position": 8, "raw": "2 tablespoons minced fresh coriander", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh coriander", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons sesame oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sesame oil", "preparation": null, "optional": false}, {"position": 10, "raw": "Juice of 2 lemons", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 2 lemons", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon light soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "light soy sauce", "preparation": null, "optional": false}, {"position": 12, "raw": "2 bunches watercress", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "bunch", "item": "watercress", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Roast the duck according to the directions in the recipe for Basic Roast Duck, through Step 5. Remove the duck from the oven and allow to cool."}, {"position": 2, "text": "Boil the noodles until just done, about five minutes. Drain, rinse in cold water and allow to drain again. When thoroughly drained, toss the noodles with two tablespoons of the peanut oil and season lightly with salt and pepper."}, {"position": 3, "text": "Roast the pepper by turning it over a gas flame or placing it under a broiler until the skin has blackened. Place the pepper in a plastic or paper bag for about 10 minutes to steam off the charred skin. Remove the skin, seed the pepper and cut it in slivers. Toss the noodles with the pepper, scallions, cucumber and coriander."}, {"position": 4, "text": "Remove the duck skin from the duck and reserve. Pull the meat of the duck off the bones."}, {"position": 5, "text": "Dice the duck skin and fry the pieces in a skillet until crisp. Allow to drain on absorbent paper."}, {"position": 6, "text": "Combine the remaining peanut oil, the sesame oil, lemon juice and soy sauce. Beat until well-blended."}, {"position": 7, "text": "Arrange the watercress on each of six plates. Toss the noodles with about half the sauce and arrange atop the watercress on each plate. Arrange the duck pieces on the noodles and sprinkle with the rest of the sauce. Scatter the bits of fried duck skin on top and serve."}], "nutrition": {"calories": 1760.4, "protein_g": 49.0, "carbohydrates_g": 37.0, "fat_g": 158.2, "saturated_fat_g": 50.2, "trans_fat_g": 0.0, "cholesterol_mg": 272.9, "sodium_mg": 1388.6, "fiber_g": 2.2, "sugar_g": 1.8, "unsaturated_fat_g": 98.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["boil", "duck", "roast", "salad", "soba noodle", "watercress"]}, "images": [], "rating": {"average": 4.0, "count": 12}, "video_url": null, "comment_count": null, "published_at": "1987-06-07", "scraped_at": "2026-09-07T00:09:03.568875+00:00", "scraper_version": "1.0.0"}
{"slug": "duck-wilted-spinach-and-white-bean-salad", "nyt_id": 4132, "url": "https://cooking.nytimes.com/recipes/4132-duck-wilted-spinach-and-white-bean-salad", "name": "Duck, Wilted Spinach And White Bean Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 small duck breasts (1 ¼ pounds), skinned and boned", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small duck breasts (1 ¼ pounds)", "preparation": "skinned and boned", "optional": false}, {"position": 2, "raw": "1 teaspoon salt, plus more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 3, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "3 teaspoons canola oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tsp", "item": "canola oil", "preparation": null, "optional": false}, {"position": 5, "raw": "20 cups fresh spinach (about 3 pounds)", "group": null, "quantity": 20.0, "quantity_max": null, "unit": "cup", "item": "fresh spinach (about 3 pounds)", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups cooked cannellini beans", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "cooked cannellini beans", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup balsamic vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "balsamic vinegar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Season the duck breasts with the salt and pepper to taste. Heat the oil in a large cast-iron skillet over medium heat until almost smoking. Add the duck and cook for 3 minutes. Turn and cook until crisp and brown on the outside and still rare in the center, about 3 minutes longer. Remove the duck from the pan and set aside; keep warm."}, {"position": 2, "text": "Gradually place the spinach in the skillet, and stir-fry until barely wilted, adding more as room allows. Place in a bowl and toss with the beans. Add the vinegar to the skillet and cook, stirring with a wooden spoon and scraping up any browned bits stuck to the bottom of the pan. Add to the spinach mixture and toss to combine. Season with salt and pepper to taste."}, {"position": 3, "text": "Cut the duck on the diagonal into thin slices. Divide the spinach mixture among 4 plates and drape the duck slices over it. Serve immediately."}], "nutrition": {"calories": 425.3, "protein_g": 46.8, "carbohydrates_g": 38.7, "fat_g": 11.1, "saturated_fat_g": 2.4, "trans_fat_g": 0.0, "cholesterol_mg": 109.1, "sodium_mg": 940.9, "fiber_g": 13.6, "sugar_g": 4.1, "unsaturated_fat_g": 6.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free"], "course": ["main course"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["cannellini bean", "duck breast", "easy", "fry", "quick", "salad", "saute", "spinach", "stir-fry"]}, "images": [], "rating": {"average": 4.0, "count": 7}, "video_url": null, "comment_count": null, "published_at": "1994-10-30", "scraped_at": "2026-09-07T00:30:07.281613+00:00", "scraper_version": "1.0.0"}

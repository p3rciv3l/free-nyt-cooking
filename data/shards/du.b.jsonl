4.0, "quantity_max": null, "unit": null, "item": "duck breasts", "preparation": "skin removed", "optional": false}, {"position": 10, "raw": "1 head chicory (or curly endive)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "chicory (or curly endive)", "preparation": null, "optional": false}, {"position": 11, "raw": "⅔ cup chicken or duck stock", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "chicken or duck stock", "preparation": null, "optional": false}, {"position": 12, "raw": "¼ pound mushrooms (Japanese and Chinese mushrooms work well), sliced", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "mushrooms (japanese and chinese mushrooms work well)", "preparation": "sliced", "optional": false}, {"position": 13, "raw": "1 tablespoon minced shallots", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced shallots", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Make vinaigrette by mixing olive oil, mustard, vinegar and salt and pepper. Place in bottom of large mixing bowl. Toss well with chicory. Arrange salad on 4 serving plates."}, {"position": 2, "text": "Peel mangoes and arrange slices around rim of dishes."}, {"position": 3, "text": "Saute French bread slices in 2 tablespoons of the butter until golden. Remove and rub with garlic cloves. Keep them warm."}, {"position": 4, "text": "In skillet saute duck breasts in 1 tablespoon butter until rare (about 5 minutes). Keep warm."}, {"position": 5, "text": "Deglaze pan with 2 tablespoons red-wine vinegar and add stock. Reduce by half. Set aside. In another pan saute mushrooms and shallots in 2 tablespoons butter. When cooked, place over salads. Slice warm duck breasts and distribute over middle of salads. Place French bread on plates. Reheat sauce, check for seasonings and pour over duck slices. Serve immediately."}], "nutrition": {"calories": 673.9, "pr
{"slug": "russian-potato-salad", "nyt_id": 6298, "url": "https://cooking.nytimes.com/recipes/6298-russian-potato-salad", "name": "Russian Potato Salad", "author": "Marian Burros", "description": "", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "9 ounces tiny new potatoes", "group": null, "quantity": 9.0, "quantity_max": null, "unit": "oz", "item": "tiny new potatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ tablespoons low-fat mayonnaise", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "low-fat mayonnaise", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ tablespoons plain nonfat yogurt", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "plain nonfat yogurt", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ tablespoons Dijon mustard", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablespoons cider vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "cider vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ tablespoons horseradish", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "horseradish", "preparation": null, "optional": false}, {"position": 7, "raw": "1 sprig tarragon to yield 1 teaspoon chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "tarragon to yield 1 teaspoon chopped", "preparation": null, "optional": false}, {"position": 8, "raw": "⅔ cup drained, sliced canned beets (no-salt variety, if available)", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "drained", "p
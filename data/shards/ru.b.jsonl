{"slug": "ruby-peach-soup", "nyt_id": 10433, "url": "https://cooking.nytimes.com/recipes/10433-ruby-peach-soup", "name": "Ruby Peach Soup", "author": "Jonathan Reynolds", "description": "Jonathan Reynolds", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes, plus chilling"}}, "ingredients": [{"position": 1, "raw": "½ bottle sweet riesling", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "bottle", "item": "sweet riesling", "preparation": null, "optional": false}, {"position": 2, "raw": "8 red peaches, very ripe, pitted and cut in quarters", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "red peaches", "preparation": "very ripe, pitted and cut in quarters", "optional": false}, {"position": 3, "raw": "Pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 5, "raw": "2 to 4 tablespoons sugar", "group": null, "quantity": 2.0, "quantity_max": 4.0, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups fresh cherries, pitted and roughly chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "fresh cherries", "preparation": "pitted and roughly chopped", "optional": false}, {"position": 7, "raw": "½ cup toasted pistachios, chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "toasted pistachios", "preparation": "chopped", "optional": false}, {"position": 8, "raw": "1 red peach, pitted and diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red peach", "preparation": "
{"slug": "ruby-peach-soup", "nyt_id": 10433, "url": "https://cooking.nytimes.com/recipes/10433-ruby-peach-soup", "name": "Ruby Peach Soup", "author": "Jonathan Reynolds", "description": "Jonathan Reynolds", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes, plus chilling"}}, "ingredients": [{"position": 1, "raw": "½ bottle sweet riesling", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "bottle", "item": "sweet riesling", "preparation": null, "optional": false}, {"position": 2, "raw": "8 red peaches, very ripe, pitted and cut in quarters", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "red peaches", "preparation": "very ripe, pitted and cut in quarters", "optional": false}, {"position": 3, "raw": "Pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 5, "raw": "2 to 4 tablespoons sugar", "group": null, "quantity": 2.0, "quantity_max": 4.0, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups fresh cherries, pitted and roughly chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "fresh cherries", "preparation": "pitted and roughly chopped", "optional": false}, {"position": 7, "raw": "½ cup toasted pistachios, chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "toasted pistachios", "preparation": "chopped", "optional": false}, {"position": 8, "raw": "1 red peach, pitted and diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red peach", "preparation": "pitted and diced", "optional": false}, {"position": 9, "raw": "1 pint cherry sorbet", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "cherry sorbet", "preparation": null, "optional": false}, {"position": 10, "raw": "2 pints peach sorbet (see recipe)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "pint", "item": "peach sorbet (see recipe)", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup toasted whole pistachios", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "toasted whole pistachios", "preparation": null, "optional": false}, {"position": 12, "raw": "15 mint leaves, chiffonade", "group": null, "quantity": 15.0, "quantity_max": null, "unit": null, "item": "mint leaves", "preparation": "chiffonade", "optional": false}], "steps": [{"position": 1, "text": "Place the first 4 ingredients of the soup in a nonreactive pot and gently simmer for 5 to 10 minutes. The peaches should be very tender. Place all in a blender and purée until smooth, strain and add sugar to desired taste (you might not need all of it depending on the sweetness of the peaches). Ice down until chilled and reserve."}, {"position": 2, "text": "Mix the cherries, chopped pistachios and peach well in a small bowl. Portion out the mixture into the centers of eight serving bowls, forming flat rectangles about 3 inches long by 1 ½ inches wide. Pour 2 to 3 ounces of cold soup around the mix in each bowl, then top each rectangle with 1 quenelle of cherry sorbet and 2 quenelles of peach sorbet. Sprinkle with whole pistachios and garnish with mint."}], "nutrition": {"calories": 425.0, "protein_g": 4.8, "carbohydrates_g": 87.1, "fat_g": 5.8, "saturated_fat_g": 0.8, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 31.7, "fiber_g": 7.3, "sugar_g": 76.8, "unsaturated_fat_g": 4.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal":
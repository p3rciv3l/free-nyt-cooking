{"slug": "orecchiette-with-chickpeas-and-spinach", "nyt_id": 11189, "url": "https://cooking.nytimes.com/recipes/11189-orecchiette-with-chickpeas-and-spinach", "name": "Orecchiette With Chickpeas And Spinach", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound orecchiette", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "orecchiette", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 large red bell peppers, stemmed, cored, deribbed and diced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large red bell peppers", "preparation": "stemmed, cored, deribbed and diced", "optional": false}, {"position": 4, "raw": "12 cups stemmed and torn spinach leaves, coarsely chopped", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "cup", "item": "stemmed and torn spinach leaves", "preparation": "coarsely chopped", "optional": false}, {"position": 5, "raw": "1 teaspoon chopped fresh rosemary", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped fresh rosemary", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup rich fowl glaze (see recipe)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "rich fowl glaze (see recipe)", "preparation": null, "optional": false}, {"position": 7, "raw": "1 1-pound can chickpeas, drained and rinsed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "1-pound can chickpeas", "preparation": "drained and rinsed", "optional": false}, {"position": 8, "raw": "
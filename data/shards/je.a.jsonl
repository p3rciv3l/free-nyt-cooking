{"slug": "jerk-chicken-wings", "nyt_id": 1015015, "url": "https://cooking.nytimes.com/recipes/1015015-jerk-chicken-wings", "name": "Jerk Chicken Wings", "author": "Mark Bittman", "description": "", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "3 pounds of chicken wings", "group": null, "quantity": 3.0, "unit": "lb", "item": "of chicken wings", "preparation": null, "optional": false}, {"position": 2, "raw": "4 roughly chopped scallions", "group": null, "quantity": 4.0, "unit": null, "item": "roughly chopped scallions", "preparation": null, "optional": false}, {"position": 3, "raw": "1 peeled shallot", "group": null, "quantity": 1.0, "unit": null, "item": "peeled shallot", "preparation": null, "optional": false}, {"position": 4, "raw": "½ habanero or Scotch bonnet chili", "group": null, "quantity": 0.5, "unit": null, "item": "habanero or scotch bonnet chili", "preparation": null, "optional": false}, {"position": 5, "raw": "½-inch peeled fresh ginger", "group": null, "quantity": 0.5, "unit": null, "item": "inch peeled fresh ginger", "preparation": null, "optional": false}, {"position": 6, "raw": "2 garlic cloves", "group": null, "quantity": 2.0, "unit": null, "item": "garlic cloves", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon fresh thyme leaves", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "fresh thyme leaves", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon allspice berries", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "allspice berries", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon honey", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons lime juice", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "lime juice", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup vegetable oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 12, "raw": "salt and pepper", "group": null, "quantity": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut 3 pounds of chicken wings into 3 sections; save the wing tips for stock. Toss the wings with a little neutral oil to keep them from sticking."}, {"position": 2, "text": "Heat a charcoal or gas grill; the fire should be moderately hot and the rack 4 to 6 inches from the heat. Leave one side of the grill cooler for indirect cooking."}, {"position": 3, "text": "Put the wings on the cool side of the grill. Cover the grill and cook, checking and turning once or twice, until most of the fat has been rendered and the wings are cooked through, 15 to 20 minutes."}, {"position": 4, "text": "While the wings cook, combine 4 roughly chopped scallions, 1 peeled shallot, ½ habanero or Scotch bonnet chili, ½-inch peeled fresh ginger, 2 garlic cloves, 1 tablespoon fresh thyme leaves, 1 tablespoon allspice berries, 1 tablespoon honey, 2 tablespoons lime juice, ¼ cup vegetable oil, salt and pepper in a food processor or blender. Blend or process into a paste."}, {"position": 5, "text": "When the wings are cooked, put them in a large bowl with the sauce, and toss to coat. Now put the wings on the hot part of the grill, and cook, uncovered, turning as necessary, until they’re nicely browned on both sides."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 327.2, "protein_g": 24.2, "carbohydrates_g": 4.5, "fat_g": 23.1, "saturated_fat_g": 5.2, "unsaturated_fat_g": 4.4, "trans_fat_g": 0.1, "cholesterol_mg": 151.0, "sodium_mg": 375.1, "fiber_g": 0.7, "sugar_g": 2.4, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer-barbecues"], "meal": [], "occasion": [], "other": ["chicken-wing", "easy"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 34}, "video_url": null, "comment_count": null, "published_at": "2013-09-01", "scraped_at": "2026-09-07T02:33:16Z", "scraper_version": "1.0.0"}
{"slug": "jerusalem-artichoke-soup-with-crispy-sage-leaves", "nyt_id": 1015365, "url": "https://cooking.nytimes.com/recipes/1015365-jerusalem-artichoke-soup-with-crispy-sage-leaves", "name": "Jerusalem Artichoke Soup With Crispy Sage Leaves", "author": "Tara Parker-Pope", "description": "Tara Parker-Pope", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "¼ cup extra-virgin olive oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 leek, white and pale green parts, rinsed and finely chopped", "group": null, "quantity": 1.0, "unit": null, "item": "leek", "preparation": "white and pale green parts, rinsed and finely chopped", "optional": false}, {"position": 3, "raw": "½ cup finely chopped white onion", "group": null, "quantity": 0.5, "unit": "cup", "item": "finely chopped white onion", "preparation": null, "optional": false}, {"position": 4, "raw": "2 pounds Jerusalem artichokes, peeled and rinsed", "group": null, "quantity": 2.0, "unit": "lb", "item": "jerusalem artichokes", "preparation": "peeled and rinsed", "optional": false}, {"position": 5, "raw": "5 cups water or vegetable stock", "group": null, "quantity": 5.0, "unit": "cup", "item": "water or vegetable stock", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon sea salt", "group": null, "quantity": 1.0, "unit": "tsp", "item": "sea salt", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon extra-virgin olive oil", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "8 to 12 fresh sage leaves", "group": null, "quantity": 8.0, "unit": null, "item": "fresh sage leaves", "preparation": null, "optional": false, "quantity_max": 12.0}], "steps": [{"position": 1, "text": "Heat the olive oil in a soup pot over medium heat. Add the leek and onion and sauté until softened, about 5 minutes. Add the Jerusalem artichokes, water and salt and bring to a boil. Decrease the heat, cover and simmer until the artichokes are tender, about 30 minutes."}, {"position": 2, "text": "Remove from the heat and let cool. Transfer the mixture to a blender and process until smooth. Taste and adjust the seasonings if necessary. Gently reheat before serving."}, {"position": 3, "text": "To crisp the sage leaves, heat the olive oil in a small sauté pan over medium heat. Add the sage leaves and sauté until just crisp, about 2 minutes. Drain on paper towels. Garnish each serving with a couple of the sage leaves."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 231.66666666666666, "protein_g": 3.6, "carbohydrates_g": 31.1, "fat_g": 11.6, "saturated_fat_g": 1.7, "unsaturated_fat_g": 1.3, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 353.8, "fiber_g": 3.7, "sugar_g": 15.8, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-lunch-soup"], "meal": [], "occasion": [], "other": ["sage", "sunchoke"]}, "images": [{"url": "https://static01.nyt.com/images/2011/11/17/health/Well_veggie_artisoup/Well_veggie_artisoup-superJumbo.jpg", "alt": "Jerusalem Artichoke Soup with Crispy Sage Leaves", "primary": true}, {"url": "https://static01.nyt.com/images/2011/11/17/health/Well_veggie_artisoup/Well_veggie_artisoup-facebookJumbo-v2.jpg", "alt": "Jerusalem Artichoke Soup with Crispy Sage Leaves", "primary": false}], "rating": {"average": 5.0, "count": 408}, "video_url": null, "comment_count": null, "published_at": "2011-11-01", "scraped_at": "2026-09-07T02:42:14Z", "scraper_version": "1.0.0"}

], "steps": [{"position": 1, "text": "Pick over the spinach and discard any tough stems or blemished leaves. Rinse well and drain."}, {"position": 2, "text": "Bring the water to the boil in a saucepan and add the spinach. Let it cook about two minutes and drain, pressing or squeezing to extract as much liquid as possible from the leaves."}, {"position": 3, "text": "Heat one tablespoon of the butter in a saucepan and add the flour, stirring with a wire whisk. When blended, add the milk, stirring vigorously with the whisk. Add the salt, pepper, nutmeg and cayenne pepper. Cook, stirring, until the mixture is thickened and smooth."}, {"position": 4, "text": "Put the spinach into the container of a food processor or electric blender and blend thoroughly, stirring down as necessary. There should be about one cup."}, {"position": 5, "text": "Put the spinach in the sauce and stir to blend. Bring to the simmer and swirl in the remaining one tablespoon of butter."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 135.0, "protein_g": 6.5, "carbohydrates_g": 11.2, "fat_g": 8.4, "saturated_fat_g": 4.8, "unsaturated_fat_g": 0.6, "trans_fat_g": null, "cholesterol_mg": 21.4, "sodium_mg": 1048.3, "fiber_g": 3.6, "sugar_g": 3.7, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side-dish"], "meal": [], "occasion": [], "other": ["butter", "easy", "milk", "quick", "spinach"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 52}, "video_url": null, "comment_count": null, "published_at": "1985-11-03", "scraped_at": "2026-09-07T01:16:52Z", "scraper_version": "1.0.0"}

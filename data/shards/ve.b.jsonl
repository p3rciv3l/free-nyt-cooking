{"slug": "veal-shanks-with-vegetables", "nyt_id": 10734, "url": "https://cooking.nytimes.com/recipes/10734-veal-shanks-with-vegetables", "name": "Veal Shanks With Vegetables", "author": "Bryan Miller, Pierre Franey", "description": "", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "About 1 hour 45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 veal shank, about 3 pounds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "veal shank", "preparation": "about 3 pounds", "optional": false}, {"position": 2, "raw": "4 cloves garlic, cut lengthwise into 3 strips", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "cut lengthwise into 3 strips", "optional": false}, {"position": 3, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "4 cups fresh or canned chicken broth", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "fresh or canned chicken broth", "preparation": null, "optional": false}, {"position": 5, "raw": "2 cups water", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup dark soy sauce", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dark soy sauce", "preparation": null, "optional": false}, {"position": 7, "raw": "2 whole cloves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "whole cloves", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon anise seed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "anise seed", "preparation": null, "optional": false}, {"position": 9, "raw": "1 cup dry white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ cups scallions cut into 1-inch lengths", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "scallions cut into 1-inch lengths", "preparation": null, "optional": false}, {"position": 11, "raw": "5 cups coarsely chopped kale", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "cup", "item": "coarsely chopped kale", "preparation": null, "optional": false}, {"position": 12, "raw": "½ head Chinese cabbage, coarsely chopped (about 5 cups)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "head", "item": "chinese cabbage", "preparation": "coarsely chopped (about 5 cups)", "optional": false}, {"position": 13, "raw": "12 baby carrots, peeled", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "baby carrots", "preparation": "peeled", "optional": false}, {"position": 14, "raw": "½ cup chopped fresh coriander", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped fresh coriander", "preparation": null, "optional": false}, {"position": 15, "raw": "½ pound snow peas", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "snow peas", "preparation": null, "optional": false}, {"position": 16, "raw": "1 ½ cups bean sprouts", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "bean sprouts", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Make small incisions around the veal shank and insert the strips of garlic. Rub the shank with pepper."}, {"position": 2, "text": "In a large kettle, combine the veal shank, broth, water, soy sauce, cloves, anise seed and wine. Bring to a boil, cover and simmer for one hour and 15 minutes, or until tender. Add the scallions, kale, Chinese cabbage and carrots. Cook for 15 minutes. Add the coriander, snow peas and bean sprouts. Cook for five minutes. Taste for seasonings and serve."}], "nutrition": {"calories": 364.9, "protein_g": 49.6, "carbohydrates_g": 14.3, "fat_g": 9.0, "saturated_fat_g": 2.5, "trans_fat_g": 0.0, "cholesterol_mg": 173.4, "sodium_mg": 1464.0, "fiber_g": 4.6, "sugar_g": 6.1, "unsaturated_fat_g": 4.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": ["dairy-free", "gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["boil", "braise", "great leftovers", "stew", "veal"]}, "images": [], "rating": {"average": 2.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1989-09-10", "scraped_at": "2026-09-06T22:31:26.686125+00:00", "scraper_version": "1.0.0"}
{"slug": "veal-tuna-and-caper-sandwich", "nyt_id": 10435, "url": "https://cooking.nytimes.com/recipes/10435-veal-tuna-and-caper-sandwich", "name": "Veal, Tuna and Caper Sandwich", "author": "Jonathan Reynolds", "description": "Jonathan Reynolds", "servings": {"text": "8 to 10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 3270, "raw": {"total": "30 minutes, plus 54 hours' refrigeration"}}, "ingredients": [{"position": 1, "raw": "12-pound boneless veal loin roast, tied at ¼-inch intervals", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "-pound boneless veal loin roast", "preparation": "tied at ¼-inch intervals", "optional": false}, {"position": 2, "raw": "Olive oil", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "Kosher salt and freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "2 egg yolks", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 5, "raw": "2 cups olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "6 tablespoons fresh lemon juice", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 7, "raw": "16-ounce can tuna packed in olive oil, drained", "group": null, "quantity": 16.0, "quantity_max": null, "unit": null, "item": "-ounce can tuna packed in olive oil", "preparation": "drained", "optional": false}, {"position": 8, "raw": "3 anchovy fillets", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "anchovy fillets", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons drained capers", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "drained capers", "preparation": null, "optional": false}, {"position": 10, "raw": "Kosher salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "16 to 20 slices good soft white sandwich bread (like Pepperidge Farm)", "group": null, "quantity": 16.0, "quantity_max": 20.0, "unit": "slice", "item": "good soft white sandwich bread (like pepperidge farm)", "preparation": null, "optional": false}, {"position": 12, "raw": "2 ripe tomatoes, very thinly sliced and drained on paper towels", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "ripe tomatoes", "preparation": "very thinly sliced and drained on paper towels", "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Rub veal with oil and sprinkle with salt and pepper. Sear loin on all sides over medium heat until browned, about 5 minutes in all. Roast until medium well, about 1 hour, or until internal temperature registers 140 degrees. Let sit at room temperature until cool, then cover and refrigerate until cold and firm, about 6 hours. Slice into ⅛-inch slices, removing strings as you slice."}, {"position": 2, "text": "In a food processor, pulse the yolks to blend. With the machine running add ½ cup of oil in a steady, slow stream and add 2 tablespoons of lemon juice. Keep processing while pouring in 1 cup more oil, then the tuna, in chunks, then anchovies, capers and remaining lemon juice, and then the remaining oil. Season well with salt and pepper."}, {"position": 3, "text": "Spread just enough of the tuna sauce over the bottom of a nonreactive loaf pan to cover. Top with a layer of veal and cover with a thin layer of tuna sauce. Repeat until all the veal and sauce are used. Cover and refrigerate 6 to 48 hours."}, {"position": 4, "text": "To assemble: Spread sauce on one side of all the bread slices. Cover half the slices with the veal, scraping off most of the sauce from the meat. Top with tomatoes and remaining bread, spread sides down. Cut off crusts and cut sandwiches in half."}], "nutrition": {"calories": 1694.2, "protein_g": 129.7, "carbohydrates_g": 29.7, "fat_g": 115.2, "saturated_fat_g": 28.4, "trans_fat_g": 2.3, "cholesterol_mg": 359.4, "sodium_mg": 1717.7, "fiber_g": 3.6, "sugar_g": 3.9, "unsaturated_fat_g": 77.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["lunch"], "occasion": [], "other": ["canned tuna", "caper", "roast", "saute", "summer", "veal"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2002-08-04", "scraped_at": "2026-09-06T22:23:00.573088+00:00", "scraper_version": "1.0.0"}
{"slug": "vegan-worcestershire-sauce-two-ways", "nyt_id": 12199, "url": "https://cooking.nytimes.com/recipes/12199-vegan-worcestershire-sauce-two-ways", "name": "Vegan Worcestershire Sauce, Two Ways", "author": "Mark Bittman", "description": "", "servings": {"text": "2 cups thick sauce; 6 cups thin", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": 2160, "cook_minutes": null, "total_minutes": 300, "raw": {"total": "4 to 5 hours", "prep": "plus about 36 hours advance soaking time"}}, "ingredients": [{"position": 1, "raw": "1 piece kombu (dried kelp), 4 to 6 inches long", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "piece", "item": "kombu (dried kelp)", "preparation": "4 to 6 inches long", "optional": false}, {"position": 2, "raw": "3 dried shiitake mushrooms", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "dried shiitake mushrooms", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups vegetable trimmings (stalks, stems and skins from vegetables like tomatoes, onions, celeriac, carrots, ginger, cabbage, broccoli or cauliflower and potatoes)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "vegetable trimmings (stalks", "preparation": "stems and skins from vegetables like tomatoes, onions, celeriac, carrots, ginger, cabbage, broccoli or cauliflower and potatoes)", "optional": false}, {"position": 4, "raw": "3 pounds tomatoes, blanched and peeled", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "tomatoes", "preparation": "blanched and peeled", "optional": false}, {"position": 5, "raw": "1 large yellow onion, peeled and roughly chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large yellow onion", "preparation": "peeled and roughly chopped", "optional": false}, {"position": 6, "raw": "4 small carrots, peeled and cut into ½ inch slices", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "small carrots", "preparation": "peeled and cut into ½ inch slices", "optional": false}, {"position": 7, "raw": "1 large celery rib, cut into ½ inch slices", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large celery rib", "preparation": "cut into ½ inch slices", "optional": false}, {"position": 8, "raw": "4 inches fresh ginger, peeled and thinly sliced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "inches fresh ginger", "preparation": "peeled and thinly sliced", "optional": false}, {"position": 9, "raw": "1 teaspoon cinnamon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cinnamon", "preparation": null, "optional": false}, {"position": 10, "raw": "6 bay leaves", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 11, "raw": "½ teaspoon black peppercorns", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "black peppercorns", "preparation": null, "optional": false}, {"position": 12, "raw": "½ teaspoon sansho peppercorns, Sichuan peppercorns or green peppercorns", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "sansho peppercorns", "preparation": "Sichuan peppercorns or green peppercorns", "optional": false}, {"position": 13, "raw": "1 tablespoon ground, dried sage", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "ground", "preparation": "dried sage", "optional": false}, {"position": 14, "raw": "1 tablespoon soybean powder (optional)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soybean powder", "preparation": null, "optional": true}, {"position": 15, "raw": "1 teaspoon ground cloves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground cloves", "preparation": null, "optional": false}, {"position": 16, "raw": "1 teaspoon ground nutmeg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground nutmeg", "preparation": null, "optional": false}, {"position": 17, "raw": "1 teaspoon dried thyme", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 18, "raw": "½ small dried hot red chili", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "small dried hot red chili", "preparation": null, "optional": false}, {"position": 19, "raw": "1 cup rice vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "rice vinegar", "preparation": null, "optional": false}, {"position": 20, "raw": "¾ cup soy sauce (preferably a mixture of tamari and shoyu)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "soy sauce (preferably a mixture of tamari and shoyu)", "preparation": null, "optional": false}, {"position": 21, "raw": "½ cup light brown sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 22, "raw": "2 tablespoons plus 1 teaspoon salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "plus 1 teaspoon salt", "preparation": null, "optional": false}, {"position": 23, "raw": "1 cup red wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "red wine", "preparation": null, "optional": false}, {"position": 24, "raw": "1 large apple, peeled and finely grated", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large apple", "preparation": "peeled and finely grated", "optional": false}, {"position": 25, "raw": "Shichimi (Japanese seven-spice powder) to taste.", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "shichimi (japanese seven-spice powder) to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Two days before you want to make the Worcestershire sauce, combine the kombu with 1 cup cold water and refrigerate overnight. Strain and reserve both the kombu and the liquid. Then soak the shiitake mushrooms in the liquid overnight."}, {"position": 2, "text": "Put the kombu in a large stockpot with 8 cups water. Bring to a boil, then reduce the heat and very gently simmer for 2 hours. Add the vegetable trimmings to the stockpot and cook for another 1 to 2 hours."}, {"position": 3, "text": "While the stock is cooking, pure the tomatoes in a blender or food processor; strain with a fine sieve into a large pot over high heat. Drain and thinly slice the reconstituted shiitake mushrooms (discard their soaking liquid). Add the mushrooms, onion, carrots, celery and ginger to the tomato purée. Bring the tomato mixture to a boil, then reduce the heat to low and simmer for 1 hour."}, {"position": 4, "text": "Add the cinnamon, bay leaves, black peppercorns, sansho peppercorns, sage, soybean powder (if you're using it), cloves, nutmeg, thyme and chili to the tomato mixture; cook for 10 minutes. Cool slightly, then blend gently in a blender or food processor; you want all the spices to be finely ground but not liquefied. Return the tomato mixture to the pot and add the rice vinegar, soy sauce, brown sugar and salt. Cook over medium heat for 10 minutes, then turn the heat to medium-high and cook for another 10 minutes; turn the heat to low."}, {"position": 5, "text": "Strain the vegetable stock and discard the solids. Put the wine and 3 cups of the vegetable stock in a saucepan over high heat; cook until reduced by .75, about 15 minutes. Strain .5 of the tomato mixture into the reduced wine-stock mixture and keep warm (this is the \"thin\" sauce)."}, {"position": 6, "text": "Add the apple to the remaining tomato mixture; simmer for another 10 minutes, then add a dash of shichimi. Taste and adjust the seasoning. (This is your \"thick” sauce.) Use the sauces immediately or transfer to airtight containers and refrigerate for up to 2 weeks."}], "nutrition": {"calories": 423.2, "protein_g": 13.7, "carbohydrates_g": 79.3, "fat_g": 5.7, "saturated_fat_g": 1.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 3473.6, "fiber_g": 20.2, "sugar_g": 40.5, "unsaturated_fat_g": 3.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegan", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["boil", "condiments", "project"]}, "images": [{"url": "https://static01.nyt.com/images/2014/04/02/dining/Vegan-Worcestershire-Sauce/Vegan-Worcestershire-Sauce-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 22}, "video_url": null, "comment_count": null, "published_at": "2012-01-19", "scraped_at": "2026-09-06T23:53:49.871664+00:00", "scraper_version": "1.0.0"}
{"slug": "vegetable-and-ricotta-tortino", "nyt_id": 10791, "url": "https://cooking.nytimes.com/recipes/10791-vegetable-and-ricotta-tortino", "name": "Vegetable-and-Ricotta Tortino", "author": "Molly O’Neill", "description": "Molly O'Neill", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "1 hour 45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups shelled fresh peas", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "shelled fresh peas", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups asparagus, halved and cut into 1-inch lengths", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "asparagus", "preparation": "halved and cut into 1-inch lengths", "optional": false}, {"position": 3, "raw": "4 tablespoons extra-virgin olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "8 cups sliced spring onions, including white and green portions", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "cup", "item": "sliced spring onions", "preparation": "including white and green portions", "optional": false}, {"position": 5, "raw": "6 celery ribs, diced", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "celery ribs", "preparation": "diced", "optional": false}, {"position": 6, "raw": "4 cups washed and stemmed watercress", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "washed and stemmed watercress", "preparation": null, "optional": false}, {"position": 7, "raw": "14 cups stemmed, rinsed and coarsely chopped white Swiss chard", "group": null, "quantity": 14.0, "quantity_max": null, "unit": "cup", "item": "stemmed", "preparation": "rinsed and coarsely chopped white Swiss chard", "optional": false}, {"position": 8, "raw": "Kosher salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "4 large eggs", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "cream", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup finely grated Parmigiano- Reggiano", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "finely grated parmigiano- reggiano", "preparation": null, "optional": false}, {"position": 12, "raw": "¾ cup ricotta, preferably sheep's milk ricotta", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "ricotta", "preparation": "preferably sheep's milk ricotta", "optional": false}, {"position": 13, "raw": "1 teaspoon Aleppo pepper (see note )", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "aleppo pepper (see note )", "preparation": null, "optional": false}, {"position": 14, "raw": "½ teaspoon kosher salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 15, "raw": "⅛ teaspoon freshly ground black pepper", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 16, "raw": "½ cup fresh mint leaves", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "fresh mint leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring a pot of salted water to a boil and add the peas and asparagus. Cook until the vegetables are just tender. Drain and immediately plunge the vegetables into a large bowl of cold water to stop the cooking. Drain and set aside."}, {"position": 2, "text": "In a large kettle, heat 3 tablespoons of the olive oil over medium heat and add the onions, celery and watercress. Begin adding the Swiss chard, stirring until the leaves fit into the pot. Cook, stirring frequently, until the vegetables are very tender. Season with salt and pepper and drain if necessary. Set aside to cool."}, {"position": 3, "text": "In a large bowl, combine the eggs, remaining tablespoon of olive oil, cream, ¼ cup of the Parmigiano, ricotta, Aleppo pepper and ½ teaspoon kosher salt. Stir until smooth. Add the peas, asparagus and cooled vegetables and stir to combine."}, {"position": 4, "text": "Preheat the oven to 350 degrees. Pour the tortino mixture into a large, lightly greased casserole dish, sprinkle with the black pepper and cover with foil. (Make sure it does not touch the vegetables.) Place the dish in a large roasting pan and pour in boiling water to rise halfway up the sides."}, {"position": 5, "text": "Bake for 40 minutes. Remove the foil and continue to bake until the center of the tortino is set, an additional 10 to 15 minutes. Remove the casserole from the roasting pan and sprinkle the remaining Parmigiano on the top. Place the casserole under a broiler until the cheese is nicely browned, 2 to 3 minutes. Allow to cool slightly, cut into squares and garnish with mint and serve."}], "nutrition": {"calories": 360.4, "protein_g": 15.7, "carbohydrates_g": 21.7, "fat_g": 25.3, "saturated_fat_g": 11.6, "trans_fat_g": 0.5, "cholesterol_mg": 144.3, "sodium_mg": 886.0, "fiber_g": 7.7, "sugar_g": 7.2, "unsaturated_fat_g": 12.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["gluten-free", "vegetarian"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "boil", "broil", "ricotta", "saute", "steam", "swiss chard"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1998-08-23", "scraped_at": "2026-09-06T22:32:04.630507+00:00", "scraper_version": "1.0.0"}
{"slug": "vegetable-broth", "nyt_id": 11884, "url": "https://cooking.nytimes.com/recipes/11884-vegetable-broth", "name": "Vegetable Broth", "author": "Barbara Kafka", "description": "", "servings": {"text": "Three and one-half cups", "min": 3, "max": 3, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 2920, "raw": {"total": "40 minutes, plus 2 days' refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 medium onion, peeled and quartered", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "peeled and quartered", "optional": false}, {"position": 2, "raw": "3 ribs celery, cut into 2-inch pieces", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "ribs celery", "preparation": "cut into 2-inch pieces", "optional": false}, {"position": 3, "raw": "6 ounces white cabbage, cored and cut into wedges", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "oz", "item": "white cabbage", "preparation": "cored and cut into wedges", "optional": false}, {"position": 4, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the onion, celery and cabbage in a food processor and process until coarsely chopped."}, {"position": 2, "text": "Scrape the chopped vegetables into a two-and-one-half-quart souffle dish or casserole with a tightly fitting lid. Add four cups of cold water and the bay leaf. Cover and cook at 100 percent power in a 650- to 700-watt oven for 25 minutes."}, {"position": 3, "text": "Remove from the oven and uncover. Strain through a fine sieve. With the back of a ladle or large spoon, squeeze all the liquid from the vegetables through the sieve."}, {"position": 4, "text": "Cool the broth. Store, covered, in the refrigerator for up to two days, or freeze."}], "nutrition": {"calories": 4.2, "pro
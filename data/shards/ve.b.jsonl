{"slug": "vegetable-salad", "nyt_id": 11694, "url": "https://cooking.nytimes.com/recipes/11694-vegetable-salad", "name": "Vegetable Salad", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "½ pound green beans", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "green beans", "preparation": null, "optional": false}, {"position": 2, "raw": "3 small zucchini, about ½ pound, trimmed", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "small zucchini", "preparation": "about ½ pound, trimmed", "optional": false}, {"position": 3, "raw": "1 medium-size sweet green or, preferably, red pepper, about ¼ pound", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size sweet green or", "preparation": "preferably, red pepper, about ¼ pound", "optional": false}, {"position": 4, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon Dijon-style mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dijon-style mustard", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon red-wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 8, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup coarsely chopped red onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "coarsely chopped red onion", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon chopped fresh basil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh basil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Trim off the ends of green beans. Rinse and drain. Cut beans into 2-inch lengths. There should be about 2 cups."}, {"position": 2, "text": "Cut zucchini into 1 ½-inch-long rounds. Cut each into quarters or eighths."}, {"position": 3, "text": "Core pepper and cut away the white veins inside. Cut pepper into strips. There should be about 1 ½ cups."}, {"position": 4, "text": "Bring enough water to boil to cover beans and zucchini when added. Add salt and beans. Simmer about 5 minutes."}, {"position": 5, "text": "Add zucchini and pepper strips and cook about 2 minutes. Drain well."}, {"position": 6, "text": "Run vegetables under cold water to chill well. Drain."}, {"position": 7, "text": "Mix mustard, vinegar, garlic, salt and pepper in a bowl, stirring rapidly with a wire whisk. Add oil, beating vigorously."}, {"position": 8, "text": "Add vegetables, onion and basil to bowl and toss to blend. Serve at room temperature."}], "nutrition": {"calories": 166.3, "protein_g": 2.4, "carbohydrates_g": 10.1, "fat_g": 14.0, "saturated_fat_g": 2.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 427.0, "fiber_g": 3.3, "sugar_g": 5.4, "unsaturated_fat_g": 11.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "me
{"slug": "vegetables-cakes-with-red-pepper-coulis", "nyt_id": 12110, "url": "https://cooking.nytimes.com/recipes/12110-vegetables-cakes-with-red-pepper-coulis", "name": "Vegetables Cakes With Red-Pepper Coulis", "author": "Marian Burros", "description": "Marian Burros", "servings": {"text": "6 servings as an appetizer", "min": 6, "max": 6, "yield_type": "pieces"}, "time": {"prep_minutes": 30, "cook_minutes": 70, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes", "prep": "30 minutes", "cook": "1 hour 10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 medium-size baking potatoes (1 pound), well scrubbed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium-size baking potatoes (1 pound)", "preparation": "well scrubbed", "optional": false}, {"position": 2, "raw": "1 cup diced celery", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "diced celery", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup diced carrots", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "diced carrots", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup diced onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "diced onion", "preparation": null, "optional": false}, {"position": 5, "raw": "1 medium-size tomato, peeled, seeded and diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size tomato", "preparation": "peeled, seeded and diced", "optional": false}, {"position": 6, "raw": "Vegetable stock, if necessary", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "vegetable stock", "preparation": "if necessary", "optional": false}, {"position": 7, "raw": "1 cup fresh or frozen peas", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh or frozen peas", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons chopped fresh basil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh basil", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon ground cumin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 10, "raw": "½ teaspoon turmeric", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "turmeric", "preparation": null, "optional": false}, {"position": 11, "raw": "Pinch red pepper flakes", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch red pepper flakes", "preparation": null, "optional": false}, {"position": 12, "raw": "3 egg whites from large eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "egg whites from large eggs", "preparation": null, "optional": false}, {"position": 13, "raw": "3 tablespoons nonfat milk", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "nonfat milk", "preparation": null, "optional": false}, {"position": 14, "raw": "½ to ¾ cup dried bread crumbs", "group": null, "quantity": 0.5, "quantity_max": 0.75, "unit": "cup", "item": "dried bread crumbs", "preparation": null, "optional": false}, {"position": 15, "raw": "Red-pepper coulis (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "red-pepper coulis (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 400 degrees. Bake the potatoes until tender."}, {"position": 2, "text": "In a large nonstick skillet, slowly cook the celery, carrots, onion and tomato until they are tender, 10 to 15 minutes. If the tomato is not juicy, add a little vegetable stock."}, {"position": 3, "text": "Add the peas, basil, cumin, turmeric and pepper flakes. Mix, then set aside to cool."}, {"position": 4, "text": "In a small mixing bowl whisk together
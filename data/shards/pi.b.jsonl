{"slug": "pickled-beet-salad", "nyt_id": 11444, "url": "https://cooking.nytimes.com/recipes/11444-pickled-beet-salad", "name": "Pickled Beet Salad", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 bunches red beets, trimmed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "bunch", "item": "red beets", "preparation": "trimmed", "optional": false}, {"position": 2, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons red-wine vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons vegetable or olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable or olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon ground cumin", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 7, "raw": "1 large red onion, thinly sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large red onion", "preparation": "thinly sliced", "optional": false}, {"position": 8, "raw": "4 tablespoons finely chopped parsley", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the beets with water to cover in a saucepan with salt to taste. Bring to a boil and simmer until tender. Cooking time will vary depending on the size and the age of the beets. Let cool."}, {"position": 2, "text": "Remove the skin under cold running water. Slice them, and place in a salad bowl. Add vinegar, oil, sugar, cumin and salt and pepper. Blend well, and check seasoning."}, {"position": 3, "text": "Add the onions and parsley. Toss well, and serve."}], "nutrition": {"calories": 181.5, "protein_g": 4.3, "carbohydrates_g": 27.1, "fat_g": 7.3, "saturated_fat_g": 1.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 660.5, "fiber_g": 7.3, "sugar_g": 18.0, "unsaturated_fat_g": 5.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegan", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["beet", "boil", "salad", "spring", "vegetables"]}, "images": [], "rating": {"average": 4.0, "count": 43}, "video_url": null, "comment_count": null, "published_at": "1993-05-12", "scraped_at": "2026-09-06T23:46:49.559427+00:00", "scraper_version": "1.0.0"}
{"slug": "pickled-duck-with-mustard-sauce-and-red-cabbage", "nyt_id": 10482, "url": "https://cooking.nytimes.com/recipes/10482-pickled-duck-with-mustard-sauce-and-red-cabbage", "name": "Pickled Duck With Mustard Sauce and Red Cabbage", "author": "Marian Burros", "description": "", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes, plus overnight marination"}}, "ingredients": [{"position": 1, "raw": "2 ducks, 4 ½ to 5 pounds each", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "ducks", "preparation": "4 ½ to 5 pounds each", "optional": false}, {"position": 2, "raw": "⅔ cups water", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ⅓ cups salt plus 1 ½ tablespoons", "group": null, "quantity": 1.3333333333333333, "quantity_max": null, "unit": "cup", "item": "salt plus 1 ½ tablespoons", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "2 large bunches parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large bunches parsley", "preparation": null, "optional": false}, {"position": 6, "raw": "2 bay leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 7, "raw": "Pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "2 cups chicken stock", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": null, "optional": false}, {"position": 9, "raw": "Kale and gooseberries for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kale and gooseberries for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Marinate ducks overnight in mixture of water, salt and sugar. Before cooking, drain and wash. Fill cavities with parsley and bay leaves. Season with pepper. Place in large roasting pan and roast at 450 degrees for 15 minutes."}, {"position": 2, "text": "Add stock to depth of one-quarter inch; lift ducks so stock can run underneath. Continue cooking 30 to 35 minutes, adding stock if necessary. Cool 15 minutes."}, {"position": 3, "text": "Slice breasts and thighs thinly so that there are a total of 20 slices. Reserve remaining duck for other uses."}, {"position": 4, "text": "To reheat, wrap stacked slices of duck in foil and place in warm oven for 20 minutes."}, {"position": 5, "text": "Serve with mustard sauce and red cabbage, and garnish with kale and gooseberries."}], "nutrition": {"calories": 1923.2, "protein_g": 51.4, "carbohydrates_g": 43.9, "fat_g": 170.1, "saturated_fat_g": 57.1, "trans_fat_g": 0.0, "cholesterol_mg": 328.9, "sodium_mg": 1358.7, "fiber_g": 1.0, "sugar_g": 40.8, "unsaturated_fat_g": 103.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["nordic"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["duck", "marinate", "roast"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1982-10-24", "scraped_at": "2026-09-06T22:25:46.254759+00:00", "scraper_version": "1.0.0"}
{"slug": "pink-bean-soup-with-radicchio", "nyt_id": 1177, "url": "https://cooking.nytimes.com/recipes/1177-pink-bean-soup-with-radicchio", "name": "Pink Bean Soup With Radicchio", "author": "Barbara Kafka", "description": "", "servings": {"text": "4 - 5 servings", "min": 4, "max": 5, "yield_type": "servings"}, "time": {"prep_minutes": 20, "cook_minutes": 260, "total_minutes": 280, "raw": {"total": "4 hours 40 minutes", "prep": "20 minutes", "cook": "4 hours 20 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ pound pink beans, preferably Spanish habichuelas rosadas", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "pink beans", "preparation": "preferably Spanish habichuelas rosadas", "optional": false}, {"position": 2, "raw": "2 ½ cups water", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "2 heads radicchio", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "head", "item": "radicchio", "preparation": null, "optional": false}, {"position": 4, "raw": "2 ½ cups liquid (veal stock, chicken stock, cooking liquid from other radicchio recipes or a combination of these)", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "liquid (veal stock", "preparation": "chicken stock, cooking liquid from other radicchio recipes or a combination of these)", "optional": false}, {"position": 5, "raw": "Kosher salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "1 medium-size potato, peeled and cut into ½-inch chunks, cooked in boiling salted water until almost done", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size potato", "preparation": "peeled and cut into ½-inch chunks, cooked in boiling salted water until almost done", "optional": false}, {"position": 8, "raw": "2 teaspoons shredded fresh basil leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "shredded fresh basil leaves", "preparation": null, "optional": false}, {"position": 9, "raw": "2 teaspoons fruity olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "fruity olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "Grated Parmesan cheese", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Rinse beans. In a small soup pot, add beans and 2 ½ cups water. Bring quickly to a boil, shut off heat and cover. Allow to sit 1 hour."}, {"position": 2, "text": "Put radicchio in a saucepan and add stock. Simmer for 40 minutes, turning once. Drain, but reserve cooking liquid. Cut radicchio crosswise into half-inch strips. There should be about a cup."}, {"position": 3, "text": "Drain and rinse beans. Return to soup pot and cover with reserved cooking liquid. Simmer 1 to 1 ½ hours or until tender."}, {"position": 4, "text": "Stir in cooked and sliced radicchio, plus salt and pepper to taste ."}, {"position": 5, "text": "Add remaining ingredients, except cheese, and reheat to boiling. Remove from heat and serve with Parmesan cheese."}], "nutrition": {"calories": 167.8, "protein_g": 9.8, "carbohydrates_g": 24.7, "fat_g": 3.9, "saturated_fat_g": 1.2, "trans_fat_g": 0.0, "cholesterol_mg": 6.3, "sodium_mg": 848.4, "fiber_g": 5.1, "sugar_g": 1.7, "unsaturated_fat_g": 2.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["boil", "great leftovers", "radicchio", "soup"]}, "images": [], "rating": {"average": 4.0, "count": 12}, "video_url": null, "comment_count": null, "published_at": "1988-12-21", "scraped_at": "2026-09-06T23:49:41.489161+00:00", "scraper_version": "1.0.0"}
{"slug": "pink-grapefruit-radish-and-calamata-olive-salad", "nyt_id": 10911, "url": "https://cooking.nytimes.com/recipes/10911-pink-grapefruit-radish-and-calamata-olive-salad", "name": "Pink Grapefruit, Radish And Calamata Olive Salad", "author": "Melissa Clark", "description": "Melissa Clark", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pink grapefruit", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "pink grapefruit", "preparation": null, "optional": false}, {"position": 2, "raw": "1 orange", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "orange", "preparation": null, "optional": false}, {"position": 3, "raw": "1 2-ounce length of daikon radish, thinly sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "2-ounce length of daikon radish", "preparation": "thinly sliced", "optional": false}, {"position": 4, "raw": "4 French breakfast or red radishes, thinly sliced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "french breakfast or red radishes", "preparation": "thinly sliced", "optional": false}, {"position": 5, "raw": "½ cup of radish sprouts", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "of radish sprouts", "preparation": null, "optional": false}, {"position": 6, "raw": "10 calamata olives, pitted and halved", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "calamata olives", "preparation": "pitted and halved", "optional": false}, {"position": 7, "raw": "2 tablespoons mild fresh goat cheese, crumbled", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "mild fresh goat cheese", "preparation": "crumbled", "optional": false}, {"position": 8, "raw": "1 tablespoon freshly squeezed lemon, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "freshly squeezed lemon", "preparation": "or to taste", "optional": false}, {"position": 9, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "Fleur de sel or coarse sea salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "fleur de sel or coarse sea salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Slice ends off grapefruit and stand it up on a cutting board. Slice off peel, following curve of fruit. Make sure to cut away all the white pith, exposing flesh. Working over a bowl to catch juices, use a small paring knife to cut out segments. Repeat with orange."}, {"position": 2, "text": "Spread daikon radish in one layer on a serving platter or two salad plates. Top with citrus segments, then arrange the breakfast or red radishes over citrus. Sprinkle with radish sprouts, olives and goat cheese. Drizzle with lemon juice and then olive oil. Sprinkle with salt to taste."}], "nutrition": {"calories": 260.2, "protein_g": 4.4, "carbohydrates_g": 24.1, "fat_g": 18.0, "saturated_fat_g": 3.9, "trans_fat_g": 0.0, "cholesterol_mg": 5.2, "sodium_mg": 652.2, "fiber_g": 4.7, "sugar_g": 15.6, "unsaturated_fat_g": 13.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["kalamata olive", "radish", "salad"]}, "images": [], "rating": {"average": 4.0, "count": 8}, "video_url": null, "comment_count": null, "published_at": "2002-04-10", "scraped_at": "2026-09-06T22:33:45.023520+00:00", "scraper_version": "1.0.0"}
{"slug": "pistachio-polenta-cake", "nyt_id": 788291333, "url": "https://cooking.nytimes.com/recipes/788291333-pistachio-polenta-cake", "name": "Pistachio Polenta Cake", "author": "Melissa Clark", "description": "Adapted from “I’ll Bring Dessert: Simple, Sweet Recipes for Every Occasion” by Benjamina Ebuehi (Quadrille, 2024), this lemon-flavored cake is both easy to make and very festive. It also happens to be gluten-free. You will need a food processor to grind the pistachios, but the cake batter can be mixed together with a whisk. Along with the grated lemon zest, a little chopped preserved lemon  adds a complex, salty-savory note, but feel free to leave it out for a more straightforward citrus flavor. This cake keeps well overnight if you want to bake it ahead of time (store it at room temperature).", "servings": {"text": "1 cake", "min": 1, "max": 1, "yield_type": "servings"}, "time": {"prep_minutes": 25, "cook_minutes": 35, "total_minutes": 60, "raw": {"total": "50 to 60 min, plus cooling", "prep": "PT0H25M", "cook": "PT0H35M"}}, "ingredients": [{"position": 1, "raw": "7 tablespoons/100 grams extra-virgin olive oil or grapeseed oil, plus more for greasing", "group": null, "quantity": 7.0, "quantity_max": null, "unit": null, "item": "tablespoons/100 grams extra-virgin olive oil or grapeseed oil", "preparation": "plus more for greasing", "optional": false}, {"position": 2, "raw": "1 ½ cups/180 grams shelled pistachios, plus chopped pistachios to decorate the top", "group": null, "quantity": 1.5, "quantity_max": null, "unit": null, "item": "cups/180 grams shelled pistachios", "preparation": "plus chopped pistachios to decorate the top", "optional": false}, {"position": 3, "raw": "½ cup/80 grams fine-ground polenta or cornmeal", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "cup/80 grams fine-ground polenta or cornmeal", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup/150 grams sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": null, "item": "cup/150 grams sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon baking soda", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon baking powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 7, "raw": "2 large eggs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 8, "raw": "⅓ cup/80 grams plain yogurt", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": null, "item": "cup/80 grams plain yogurt", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon finely chopped preserved lemon or use ½ teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped preserved lemon or use ½ teaspoon salt", "preparation": null, "optional": false}, {"position": 10, "raw": "Grated zest of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated zest of 1 lemon", "preparation": null, "optional": false}, {"position": 11, "raw": "¾ cup/90 grams powdered sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": null, "item": "cup/90 grams powdered sugar", "preparation": null, "optional": false}, {"position": 12, "raw": "1 to 2 tablespoons fresh lemon juice", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 350 degrees. Grease an 8-inch cake pan, then line the bottom with parchment paper."}, {"position": 2, "text": "In a food processor, pulse the pistachios until finely ground. Add the polenta, sugar, baking soda and baking powder and pulse to combine."}, {"position": 3, "text": "In a large bowl, whisk together the eggs, 7 tablespoons oil, yogurt, preserved lemon (or salt) and lemon zest. Add pistachio mixture and fold to combine."}, {"position": 4, "text": "Pour batter into the prepared cake pan. Bake until the top is golden brown and a cake tester comes out clean, 25 to 35 minutes. Transfer to a wire rack to cool completely before glazing. Note that the cake will sink a bit in the middle as it cools."}, {"position": 5, "text": "To make the glaze, in a medium bowl, whisk together the powdered sugar and 1 tablespoon lemon juice. Continue whisking in more lemon juice as needed to yield a very thick but pourable glaze."}, {"position": 6, "text": "Spoon the glaze on the top of the cooled cake, using the back of a spoon to push it to the edges. Decorate top with chopped pistachios and let set for at least 30 minutes before serving."}], "nutrition": {"calories": 839.7, "protein_g": 14.8, "carbohydrates_g": 92.0, "fat_g": 49.2, "saturated_fat_g": 7.4, "trans_fat_g": 0.0, "cholesterol_mg": 95.6, "sodium_mg": 520.7, "fiber_g": 6.2, "sugar_g": 65.0, "unsaturated_fat_g": 40.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["alcohol-free", "fish-free", "pork-free", "shellfish-free", "soy-free", "vegetarian", "pescatarian"], "course": ["dessert"], "meal": [], "occasion": [], "other": ["pistachio", "cornmeal", "yogurt", "preserved lemon", "lemon zest", "confectioners' sugar", "lemon juice", "cake", "bake", "food processor", "easy", "make-ahead", "lemon (flav)"]}, "images": [{"url": "https://static01.nyt.com/images/2026/09/01/multimedia/02FD-APPE-CAKEREX-MC-Pistachio-polenta-cake-1-plgq/02FD-APPE-CAKEREX-MC-Pistachio-polenta-cake-1-plgq-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 40}, "video_url": null, "comment_count": null, "published_at": "2026-09-01", "scraped_at": "2026-09-06T22:28:47.108512+00:00", "scraper_version": "1.0.0"}

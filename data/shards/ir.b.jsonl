{"slug": "irish-coffee", "nyt_id": 12369, "url": "https://cooking.nytimes.com/recipes/12369-irish-coffee", "name": "Irish Coffee", "author": "Patrick Farrell", "description": "For a holiday that has come to involve so much alcohol, St. Patrick’s Day is badly in need of a good drink. Beer, even tinted green, is too workaday. Stout is too stolid. Sweet liqueurs like Irish Mist and Baileys Irish Cream are just too everything. But Irish coffee is worth toasting: the boggy funk of whiskey rising through an equatorial brew to meet a cool cloud of whipped cream.", "servings": {"text": "1 drink", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "4 ounces (½ cup) heavy cream, cold", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "(½ cup) heavy cream", "preparation": "cold", "optional": false}, {"position": 2, "raw": "1 teaspoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "Vanilla extract, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "vanilla extract", "preparation": "if desired", "optional": false}, {"position": 4, "raw": "1 ½ ounces (3 tablespoons) Irish whiskey", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "(3 tablespoons) irish whiskey", "preparation": null, "optional": false}, {"position": 5, "raw": "6 ounces (¾ cup) hot, fresh coffee", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "oz", "item": "(¾ cup) hot", "preparation": "fresh coffee", "optional": false}], "steps": [{"position": 1, "text": "Whip the heavy cream. Add ½ teaspoon sugar and a dash of vanilla, if desired, just before the cream starts to form soft peaks. Whip until firm."}, {"position": 2, "text": "Pour the remaining ½ teaspoon sugar into a tall ceramic or glass mug."}, {"position": 3, "text": "Add the whiskey, then pour in the coffee to about an inch below the brim."}, {"position": 4, "text": "Apply a generous dollop of whipped cream to the top."}], "nutrition": {"calories": 513.8, "protein_g": 3.4, "carbohydrates_g": 7.6, "fat_g": 41.0, "saturated_fat_g": 26.1, "trans_fat_g": 1.4, "cholesterol_mg": 128.1, "sodium_mg": 34.2, "fiber_g": 0.0, "sugar_g": 7.7, "unsaturated_fat_g": 12.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["irish"], "diet": [], "course": [], "meal": [], "occasion": ["st. patrick’s day"], "other": ["cocktails", "coffee", "easy", "heavy cream", "not-shoppable-ic", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2025/02/25/multimedia/PF-Irish-Coffee-ltbz/PF-Irish-Coffee-ltbz-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 152}, "video_url": null, "comment_count": null, "published_at": "2012-03-13", "scraped_at": "2026-09-07T03:02:56.645094+00:00", "scraper_version": "1.0.0"}
{"slug": "irish-cream-caramel-sauce", "nyt_id": 1453, "url": "https://cooking.nytimes.com/recipes/1453-irish-cream-caramel-sauce", "name": "Irish Cream Caramel Sauce", "author": "Florence Fabricant", "description": "", "servings": {"text": "0 3/4 cup", "min": 0, "max": 0, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes, plus refrigeration"}}, "ingredients": [{"position": 1, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "4 tablespoons water", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup heavy cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 4, "raw": "3 tablespoons Irish whisky (see note)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "irish whisky (see note)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Swirl sugar and water together in a heavy saucepan until the sugar dissolves. Place over medium-high heat and cook, stirring occasionally, until the mixture turns a uniform honey-brown color. Remove from heat."}, {"position": 2, "text": "Pour a tablespoon or two of the cream into the caramel, standing back from the pan, because the mixture may spatter. Stir to blend in the cream, then add the remaining cream, stirring until completely mixed."}, {"position": 3, "text": "Stir in the whisky, transfer the mixture to a jar or other container and refrigerate until ready to use. The sauce may be warmed before using but it will not be as thick as if it is chilled. Serve over ice cream, crepes, cake or puddings."}], "nutrition": {"calories": 597.2, "protein_g": 2.3, "carbohydrates_g": 68.9, "fat
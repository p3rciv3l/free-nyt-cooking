{"slug": "irish-spiced-lamb", "nyt_id": 3460, "url": "https://cooking.nytimes.com/recipes/3460-irish-spiced-lamb", "name": "Irish Spiced Lamb", "author": "Molly O’Neill", "description": "", "servings": {"text": "Ten to twelve servings", "min": 10, "max": 12, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 80, "raw": {"total": "1 hour 20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon juniper berries", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "juniper berries", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon whole allspice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "whole allspice", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon whole cloves", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "whole cloves", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon whole black peppercorns", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "whole black peppercorns", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon coriander seeds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "coriander seeds", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon dried thyme", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon dried savory", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dried savory", "preparation": null, "optional": false}, {"position": 8, "raw": "3 cloves garlic, peeled and mashed into a paste", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and mashed into a paste", "optional": false}, {"position": 9, "raw": "¾ cup Dijon mustard", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons honey", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 11, "raw": "1 spring leg of lamb, 6 pounds, at room temperature", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "spring leg of lamb", "preparation": "6 pounds, at room temperature", "optional": false}, {"position": 12, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 350 degrees. Grind all of the spices and herbs in a spice mill until finely ground. Mix together the spice mixture, garlic paste, mustard and honey. Set aside."}, {"position": 2, "text": "Cut 8 to 12 ¼-inch-deep slices, 1 inch apart, across the top of the leg. Rub the spice paste into the slices and all over the top. Put the leg, seasoned side up, on a rack over a large roasting pan and place in oven. After 50 minutes start testing for doneness by inserting a meat thermometer in the large end of the leg. The thermometer should read 125 degrees for rare meat, or 130 degrees for medium rare. Season the lamb with salt and let it rest for at least 20 minutes before carving."}], "nutrition": {"calories": 575.8, "protein_g": 49.6, "carbohydrates_g": 4.6, "fat_g": 38.7, "saturated_fat_g": 16.5, "trans_fat_g": 0.0, "cholesterol_mg": 179.7, "sodium_mg": 419.7, "fiber_g": 0.9, "sugar_g": 3.0, "unsaturated_fat_g": 19.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["irish"], "diet": ["dairy-free", "gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["lamb", "roast", "roasts", "spring"]}, "images": [], "rating": null
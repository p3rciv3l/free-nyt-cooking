{"slug": "irma-rombauers-classic-potato-salad", "nyt_id": 9471, "url": "https://cooking.nytimes.com/recipes/9471-irma-rombauers-classic-potato-salad", "name": "Irma Rombauer's Classic Potato Salad", "author": "Suzanne Hamlin", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 50, "raw": {"total": "50 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds boiling potatoes, scrubbed but not peeled", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "boiling potatoes", "preparation": "scrubbed but not peeled", "optional": false}, {"position": 2, "raw": "½ cup chicken, beef or vegetable broth", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chicken", "preparation": "beef or vegetable broth", "optional": false}, {"position": 3, "raw": "½ to 1 cup celery, chopped fine", "group": null, "quantity": 0.5, "quantity_max": 1.0, "unit": "cup", "item": "celery", "preparation": "chopped fine", "optional": false}, {"position": 4, "raw": "1 bunch scallions, trimmed and cut in thin rounds, including some green", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "scallions", "preparation": "trimmed and cut in thin rounds, including some green", "optional": false}, {"position": 5, "raw": "3 hard-cooked eggs, peeled and chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "hard-cooked eggs", "preparation": "peeled and chopped", "optional": false}, {"position": 6, "raw": "capers, pickles, olives, cucumbers", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "capers", "preparation": "pickles, olives, cucumbers", "optional": false}, {"position": 7, "raw": "Salt, freshly ground pepper and cayenne pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": "freshly ground pepper and cayenne pepper to taste", "optional": false}, {"position": 8, "raw": "1 large egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup cider vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "cider vinegar", "preparation": null, "optional": false}, {"position": 10, "raw": "½ to 1 teaspoon dry mustard", "group": null, "quantity": 0.5, "quantity_max": 1.0, "unit": "tsp", "item": "dry mustard", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 12, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ teaspoon paprika", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "paprika", "preparation": null, "optional": false}, {"position": 15, "raw": "½ cup cold water", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "cold water", "preparation": null, "optional": false}, {"position": 16, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 17, "raw": "⅓ to ½ cup sour cream, yogurt or heavy cream", "group": null, "quantity": 0.3333333333333333, "quantity_max": 0.5, "unit": "cup", "item": "sour cream", "preparation": "yogurt or heavy cream", "optional": false}], "steps": [{"position": 1, "text": "Cut the potatoes in half if large, put in a pot and add enough lightly salted water to cover them by 2 inches. Bring to a boil and cook, uncovered, until just tender, about 15 minutes. Drain. Peel and cut into cubes or slices."}, {"position": 2, "text": "Put warm potato pieces in a serving bowl and mix with broth. Let stand for 30 minutes so broth can be absorbed."}, {"position": 3, "text": "Mix in celery, scallions and eggs. Add optional ingredients. Add salt, pepper and cayenne to taste."}, {"position": 4, "text": "To make the dressing, in the top of a double boiler, mix the egg and cider vinegar. In a small bowl, mix the dry mustard, sugar, salt, flour and paprika. Gradually blend in the cold water until smooth. Whisk into the egg and vinegar mix."}, {"position": 5, "text": "Cook over boiling water, stirring with a whisk until the dressing is thick and smooth, about 3 minutes. Remove from the heat and whisk in butter. Let cool slightly and thin with sour cream, yogurt or cream if desired. Mix well with potatoes and adjust seasonings. Serve immediately or cover and chill overnight."}], "nutrition": {"calories": 254.1, "protein_g": 7.9, "carbohydrates_g": 33.6, "fat_g": 10.2, "saturated_fat_g": 5.0, "trans_fat_g": 0.1, "cholesterol_mg": 125.2, "sodium_mg": 663.6, "fiber_g": 4.0, "sugar_g": 4.8, "unsaturated_fat_g": 3.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": ["fourth of july"], "other": ["boil", "celery", "egg", "potato", "potato salad"]}, "images": [], "rating": {"average": 4.0, "count": 31}, "video_url": null, "comment_count": null, "published_at": "1997-07-02", "scraped_at": "2026-09-07T01:30:28.138770+00:00", "scraper_version": "1.0.0"}

{"slug": "irish-stew", "nyt_id": 2669, "url": "https://cooking.nytimes.com/recipes/2669-irish-stew", "name": "Irish Stew", "author": "Barbara Kafka", "description": "", "servings": {"text": "6 to 8 servings (makes 8 cups; 362 calories per cup)", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": 20, "cook_minutes": 25, "total_minutes": 45, "raw": {"total": "45 minutes", "prep": "20 minutes", "cook": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds stewing lamb (neck or shoulder) with bones, cut into 1- or 2-inch chunks", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "stewing lamb (neck or shoulder) with bones", "preparation": "cut into 1- or 2-inch chunks", "optional": false}, {"position": 2, "raw": "3 medium-size carrots, scraped and cut into pieces about 2 by ¼ by ¼ inches", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "medium-size carrots", "preparation": "scraped and cut into pieces about 2 by ¼ by ¼ inches", "optional": false}, {"position": 3, "raw": "½ pound small white onions, peeled", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "small white onions", "preparation": "peeled", "optional": false}, {"position": 4, "raw": "1 pound small new potatoes, or 1 pound large potatoes cut in half or quartered", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "small new potatoes", "preparation": "or 1 pound large potatoes cut in half or quartered", "optional": false}, {"position": 5, "raw": "½ pound small turnips, scrubbed and cut into 8 wedges each", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "small turnips", "preparation": "scrubbed and cut into 8 wedges each", "optional": false}, {"position": 6, "raw": "1 tablespoon kosher salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ cups water", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 9, "raw": "1 cup peas (if they are frozen, place in a sieve under warm running water to defrost)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "peas (if they are frozen", "preparation": "place in a sieve under warm running water to defrost)", "optional": false}, {"position": 10, "raw": "½ cup chopped fresh mint", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped fresh mint", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place lamb in two layers around inside rim of an oval dish, about 10 by 8 by 3 inches. Mound carrots, onions, potatoes and turnips in center. Sprinkle with salt and pepper. Add water. Cover tightly with microwave plastic wrap. Cook at 100 percent power for 20 minutes."}, {"position": 2, "text": "Remove from oven. Prick plastic with the tip of a sharp knife to release steam. Uncover dish carefully. Stir well, making sure any uncooked pieces of meat are on top. Stir in peas. Recover dish with a fresh piece of plastic. Cook at 100 percent power for 5 minutes."}, {"position": 3, "text": "Remove from oven. Prick plastic and remove. Stir in mint and serve immediately, or allow stew to mellow overnight and add mint after reheating from room temperature for 5 minutes. If you are reheating from the refrigerator, it will take 10 minutes."}], "nutrition": {"calories": 411.7, "protein_g": 22.0, "carbohydrates_g": 20.3, "fat_g": 26.8, "saturated_fat_g": 11.6, "trans_fat_g": 0.0, "cholesterol_mg": 82.8, "sodium_mg": 741.4, "fiber_g": 4.5, "sugar_g": 4.9, "unsaturated_fat_g": 13.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["irish"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["great leftovers", "lamb", "microwave", "stew"]}, "images": [], "rating": {"average": 3.0, "count": 35}, "video_url": null, "comment_count": null, "published_at": "1988-02-03", "scraped_at": "2026-09-07T04:37:01.604575+00:00", "scraper_version": "1.0.0"}
{"slug": "irish-whisky-pots-de-creme", "nyt_id": 3997, "url": "https://cooking.nytimes.com/recipes/3997-irish-whisky-pots-de-creme", "name": "Irish Whisky Pots de Creme", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "30 minutes plus about 2 hours refrigeration time"}}, "ingredients": [{"position": 1, "raw": "1 pint heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup vanilla sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "vanilla sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 teaspoons powdered espresso coffee", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "powdered espresso coffee", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon unsweetened Dutch cocoa mixed with 2 tablespoons water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "unsweetened dutch cocoa mixed with 2 tablespoons water", "preparation": null, "optional": false}, {"position": 5, "raw": "12 ounces semisweet chocolate, chopped", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "semisweet chocolate", "preparation": "chopped", "optional": false}, {"position": 6, "raw": "6 large egg yolks", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "large egg yolks", "preparation": null, "optional": false}, {"position": 7, "raw": "4 tablespoons Irish whisky", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "irish whisky", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a heavy saute pan, mix the cream, sugar and powdered espresso. Bring to a boil a
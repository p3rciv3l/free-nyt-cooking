{"slug": "15-minute-chocolate-cake", "nyt_id": 6971, "url": "https://cooking.nytimes.com/recipes/6971-15-minute-chocolate-cake", "name": "15-Minute Chocolate Cake", "author": "Julia Reed", "description": "Julia Reed", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound chocolate with a cocoa-solids content of at least 70 percent", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "chocolate with a cocoa-solids content of at least 70 percent", "preparation": null, "optional": false}, {"position": 2, "raw": "2 ½ sticks unsalted butter", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "stick", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "6 eggs, preferably organic", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "preferably organic", "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 425. Generously grease a 10-inch springform cake pan and line with baking parchment."}, {"position": 2, "text": "Break the chocolate into pieces and melt with the butter in a bowl over simmering water."}, {"position": 3, "text": "In a separate bowl over simmering water, beat the eggs until they start to thicken. Remove from heat and beat about 4 or 5 more minutes. Fold half the eggs into the melted chocolate, then fold in the remainder. Pour the batter into the pan and cover with buttered foil."}, {"position": 4, "text": "Place in a bain-marie of very hot water. It is essential, if the cake is to cook evenly, that the water comes halfway up the side of the cake pan."}, {"position": 5, "text": "Bake for five minutes, remove the foil and bake for 10 minutes longer until just set. Remove from the water and cool in the pan. Unmold when completely cool."}], "n
{"slug": "15-minute-shrimp-toast", "nyt_id": 2588, "url": "https://cooking.nytimes.com/recipes/2588-15-minute-shrimp-toast", "name": "15-Minute Shrimp Toast", "author": "Robert Farrar Capon", "description": "", "servings": {"text": "40 pieces", "min": 40, "max": 40, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "About 15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound fresh shrimp", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fresh shrimp", "preparation": null, "optional": false}, {"position": 2, "raw": "1 acorn-size piece fresh ginger, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "acorn-size piece fresh ginger", "preparation": "minced", "optional": false}, {"position": 3, "raw": "1 small onion, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small onion", "preparation": "minced", "optional": false}, {"position": 4, "raw": "½ teaspoon sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 egg, beaten", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": "beaten", "optional": false}, {"position": 6, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon cornstarch", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon dry Sherry", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dry sherry", "preparation": null, "optional": false}, {"position": 9, "raw": "Black pepper as desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "ite
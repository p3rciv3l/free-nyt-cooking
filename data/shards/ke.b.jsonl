al": false}, {"position": 18, "raw": "1 tablespoon finely minced fresh coriander", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced fresh coriander", "preparation": null, "optional": false}, {"position": 19, "raw": "1 ½ tablespoons peanut oil", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "peanut oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a small bowl combine the soy sauce, rice wine, sesame oil and one-fourth teaspoon pepper. Place the tuna on a plate, spread the mixture evenly over the tuna on both sides, cover with plastic wrap and refrigerate for two hours."}, {"position": 2, "text": "Heat a wok or a heavy skillet. Add the olive oil, then the scallions, garlic, ginger, shallots and chili. Stir- fry for one minute, then add the carrots, zucchini and red pepper. Stir-fry another minute, then add the cumin, salt, sugar and remaining black pepper. Stir-fry another minute, remove from heat, stir in the fresh coriander and set aside."}, {"position": 3, "text": "Just before serving remove the tuna from the marinade, reserving the marinade. Pat the tuna dry on paper towels."}, {"position": 4, "text": "Clean the wok or skillet and reheat it over high heat. Add the peanut oil. Add the tuna; reduce the heat to medium and sear on one side. Turn the tuna over and sear on the other side, long enough to brown the outside but keeping the inside rare. Remove the tuna to warm plates. Alternatively, the tuna can be brushed with the oil and grilled or broiled."}, {"position": 5, "text": "Pour the marinade into the wok or skillet and bring to a boil. Pour the heated marinade over the tuna and spoon the vegetable mixture on top. Serve at once."}], "nutrition": {"calories": 283.2, "protein_g": 29.5, "carbohydrates_g": 6.3, "fat_g": 14.4, "saturated_fat_g": 2.3, "trans_fat_g": 0.0, "cholesterol_mg": 44.2, "sodium_mg": 719.2, "fiber_g": 1.0, "sugar_g": 2.3, "unsaturate
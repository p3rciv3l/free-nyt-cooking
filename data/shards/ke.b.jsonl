{"slug": "ken-homs-shrimp-with-cashew-nuts", "nyt_id": 6498, "url": "https://cooking.nytimes.com/recipes/6498-ken-homs-shrimp-with-cashew-nuts", "name": "Ken Hom's Shrimp With Cashew Nuts", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 5, "total_minutes": 30, "raw": {"total": "30 minutes", "prep": "5 minutes", "cook": "5 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound medium shrimp, peeled and deveined", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "medium shrimp", "preparation": "peeled and deveined", "optional": false}, {"position": 2, "raw": "4 teaspoons salt", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "1 egg white", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg white", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "2 teaspoons cornstarch", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup peanut oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "peanut oil", "preparation": null, "optional": false}, {"position": 7, "raw": "2 teaspoons finely chopped peeled fresh ginger", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "finely chopped peeled fresh ginger", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons finely chopped scallions", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped scallions", "preparation": null, "optional": false}, {
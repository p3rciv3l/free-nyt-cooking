{"slug": "kerala-beef", "nyt_id": 12574, "url": "https://cooking.nytimes.com/recipes/12574-kerala-beef", "name": "Kerala Beef", "author": "Mark Bittman", "description": "A marinade of garlic, ginger and chili powder meet the strong flavors of tamarind concentrate, garam masala, coriander and turmeric in this spicy beef dish. Once the spices are toasted, the beef is quickly seared over high heat in a second skillet, then transferred to cook among them. Serve it topped with cilantro for bright bite to contrast the beef's earthiness and heat.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 45, "total_minutes": 45, "raw": {"total": "45 minutes, partly unattended.", "cook": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons minced garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon minced fresh ginger", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh ginger", "preparation": null, "optional": false}, {"position": 3, "raw": "½ tablespoon chili powder", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "chili powder", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "1 pound beef tenderloin, cut into 1 ½-inch strips", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "beef tenderloin", "preparation": "cut into 1 ½-inch strips", "optional": false}, {"position": 6, "raw": "¾ tablespoon tamarind concentrate", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tbsp", "item": "tamarind concentrate", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons coconut oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "coconut oil", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon mustard seeds", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "mustard seeds", "preparation": null, "optional": false}, {"position": 9, "raw": "5 fresh curry leaves", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "fresh curry leaves", "preparation": null, "optional": false}, {"position": 10, "raw": "3 medium red onions, finely chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "medium red onions", "preparation": "finely chopped", "optional": false}, {"position": 11, "raw": "2 green chilies, seeded and finely chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "green chilies", "preparation": "seeded and finely chopped", "optional": false}, {"position": 12, "raw": "2 tablespoons garam masala", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "garam masala", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon ground coriander", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "ground coriander", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ teaspoon ground turmeric", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "ground turmeric", "preparation": null, "optional": false}, {"position": 15, "raw": "½ teaspoon powdered black pepper", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "powdered black pepper", "preparation": null, "optional": false}, {"position": 16, "raw": "3 tablespoons whole milk yogurt", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "whole milk yogurt", "preparation": null, "optional": false}, {"position": 17, "raw": "Freshly chopped cilantro for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly chopped cilantro for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine the garlic, ginger, chili powder and ½ teaspoon salt in a medium bowl. Rub the mixture into the beef and let sit for at least 20 minutes."}, {"position": 2, "text": "Combine the tamarind concentrate with 3 tablespoons boiling water in a small bowl; stir until tamarind concentrate is dissolved, and set aside."}, {"position": 3, "text": "Put 2 tablespoons coconut oil in a large skillet on medium heat. When the oil is hot, add the mustard seeds and curry leaves. Let simmer for 1 minute, then add the onions and chilies, and cook until onions start to soften, about 5 minutes."}, {"position": 4, "text": "Add the garam masala, ground coriander, ground turmeric, powdered black pepper and ½ teaspoon salt to the onions. (The mixture will be quite dry.) Cook for another 5 minutes, stirring occasionally, then reduce the heat to low and stir in the tamarind concentrate and yogurt. Cook 3 to 5 minutes, or until the liquid is almost completely evaporated."}, {"position": 5, "text": "Heat the additional tablespoon coconut oil in a second skillet over high heat. Add the beef strips and sear for 30 seconds, turning once."}, {"position": 6, "text": "Using tongs, carefully transfer the beef strips to the skillet with onions, folding them into the onion mixture, and let simmer 3 to 5 minutes, stirring occasionally, until tender and cooked through. Discard the curry leaves; taste and adjust the seasoning, adding more salt if necessary. Garnish with fresh cilantro."}], "nutrition": {"calories": 447.8, "protein_g": 25.2, "carbohydrates_g": 16.9, "fat_g": 31.7, "saturated_fat_g": 17.0, "trans_fat_g": 0.0, "cholesterol_mg": 97.9, "sodium_mg": 596.4, "fiber_g": 3.7, "sugar_g": 5.9, "unsaturated_fat_g": 10.9, "source": "nyt", "basis": "per_serving", "computed_with": nul
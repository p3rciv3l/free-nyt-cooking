{"slug": "kerrie-buitragos-fruit", "nyt_id": 2489, "url": "https://cooking.nytimes.com/recipes/2489-kerrie-buitragos-fruit", "name": "Kerrie Buitrago's Fruit", "author": "Bryan Miller", "description": "", "servings": {"text": "Enough for two 9-inch tarts", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "45 minutes, plus 1 hour's refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 ¾ cups all-purpose flour", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "1 stick sweet butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "stick", "item": "sweet butter", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons sugar", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": null, "optional": false}, {"position": 5, "raw": "4 ¼ cups milk", "group": null, "quantity": 4.25, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ¼ cup sugar", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "10 egg yolks", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup cornstarch", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 9, "raw": "1 vanilla bean, scraped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "vanilla bean", "preparation": "scraped", "optional": false}, {"position": 10, "raw": "3 tablespoons Grand Marnier or Kirsch", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "grand marnier or kirsch", "preparation": null, "optional": false}, {"position": 11, "raw": "⅓ cup heavy cream whipped", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "heavy cream whipped", "preparation": null, "optional": false}, {"position": 12, "raw": "Variety of fruits in season", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "variety of fruits in season", "preparation": null, "optional": false}, {"position": 13, "raw": "Apricot jam for glaze", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "apricot jam for glaze", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put all ingredients in a mixing bowl. Using your fingers, combine all ingredients and form into a ball. Do not overwork. Refrigerate one hour before using."}, {"position": 2, "text": "Line a 9-inch pastry shell with the dough. Place a layer of parchment paper over it and weight with dried beans, rice or lentils."}, {"position": 3, "text": "Bake for 15 minutes in a preheated 400-degree oven or until crust is golden. Let cool."}, {"position": 4, "text": "Bring milk to boil."}, {"position": 5, "text": "Beat egg yolks and sugar together in a separate bowl. Add cornstarch while whisking. Pour a ladle of warm milk into the egg yolk mixture, return to heat and add vanilla. Whisk until just thick. Cool."}, {"position": 6, "text": "Mix pastry cream with Grand Marnier or Kirsch to taste and lighten with a small amount of whipped cream."}, {"position": 7, "text": "Fill prebaked tart shell with pastry cream."}, {"position": 8, "text": "Arrange a variety of fresh fruits on top, such as strawberries, raspberries, blueberries, bananas, cantaloupe, black and green grapes, kiwi slices. Fill in with mandarin oranges and lichee nuts for color contrast"}, {"position": 9, "text": "Glaze with hot apricot jam. Mix ¼ cup of jam with two tablespoons of water to thin out if necessary, so that the coating is very light and not coagulated. Brush on apricot coating with a pastry brush."}], "nutrition": null, "tags": {"cuisine": ["french"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "egg", "fruit"]}, "images": [], "rating": {"average": 4.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1983-06-15", "scraped_at": "2026-09-07T04:28:28.319402+00:00", "scraper_version": "1.0.0"}

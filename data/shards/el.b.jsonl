{"slug": "elizabeth-frinks-roast-lemon-chicken", "nyt_id": 5559, "url": "https://cooking.nytimes.com/recipes/5559-elizabeth-frinks-roast-lemon-chicken", "name": "Elizabeth Frink's Roast Lemon Chicken", "author": "Julia Reed", "description": "Julia Reed", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "1 hour 45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 3-pound chicken", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "3-pound chicken", "preparation": null, "optional": false}, {"position": 2, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ teaspoon pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "2 lemons", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "lemons", "preparation": null, "optional": false}, {"position": 5, "raw": "6 cloves garlic, peeled", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled", "optional": false}, {"position": 6, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon coarsely chopped fresh parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "coarsely chopped fresh parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 325 degrees. Place the chicken in a large baking dish and season inside and out with salt and pepper. Rub the peel of one of the lemons over the outside of the chicken. Then cut the lemon into 8 pieces and squeeze juice over and into the chicken. Put the lemon pieces inside the chicken along with the garlic cloves. In a small pan, melt the butter in the olive oil and pour on top and inside the chicken. Tie the legs together with kitchen string."}, {"position": 2, "text": "Roast the chicken for 1 ½ hours, until an instant-read thermometer inserted in the thickest part of the leg registers 180 degrees, basting every 15 minutes with pan juices. Half an hour before taking the chicken out, pour the juice from the second lemon over the chicken and sprinkle with parsley."}], "nutrition": {"calories": 861.7, "protein_g": 64.1, "carbohydrates_g": 5.6, "fat_g": 64.0, "saturated_fat_g": 19.2, "trans_fat_g": 0.3, "cholesterol_mg": 270.4, "sodium_mg": 532.2, "fiber_g": 1.3, "sugar_g": 1.1, "unsaturated_fat_g": 39.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["chicken", "easy", "garlic", "lemon", "roast", "roasts"]}, "images": [], "rating": {"average": 5.0, "count": 25}, "video_url": null, "comment_count": null, "published_at": "2001-07-08", "scraped_at": "2026-09-07T07:41:05.541773+00:00", "scraper_version": "1.0.0"}
{"slug": "elviss-fried-potato-sandwich", "nyt_id": 11316, "url": "https://cooking.nytimes.com/recipes/11316-elviss-fried-potato-sandwich", "name": "Elvis's Fried-Potato Sandwich", "author": "Liz Smith", "description": "It is perhaps not advisable to follow an Elvis Presley diet for more than a meal or two. But for one? Let us take care of business. Fried bacon, onions, potatoes, soft white bread sliced with mustard: this is a glorious, if greasy feast. Presley led a life in which he snacked without guilt. Although he never heard of it, he lived deeply within the Greek philosophy of eudaemonia, meaning “human flourishing.” Try it for lunch some time. (Sam Sifton)", "servings": {"text": "1 sandwich", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "35 minutes"}}, "ingredients": [{"position": 1, "raw": "½ pound bacon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "bacon", "preparation": null, "optional": false}, {"position": 2, "raw": "2 small russet potatoes (about 3 ounces each), peeled, sliced ¼-inch thick", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small russet potatoes (about 3 ounces each)", "preparation": "peeled, sliced ¼-inch thick", "optional": false}, {"position": 3, "raw": "2 small yellow onions (about 2 ounces each), peeled, thinly sliced crosswise into rings", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small yellow onions (about 2 ounces each)", "preparation": "peeled, thinly sliced crosswise into rings", "optional": false}, {"position": 4, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "2 large slices country-style white bread", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large slices country-style white bread", "preparation": null, "optional": false}, {"position": 6, "raw": "Mustard to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "mustard to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Fry the bacon in a heavy cast-iron skillet to desired doneness and drain on paper towels. Heat the bacon drippings over medium heat, add the potatoes and onions and sprinkle with salt and pepper. Fry until the potatoes are browned and crisp on the outside and tender on the inside and the onions are tender. (Do not turn the potatoes until they are crisp.) Taste for seasoning."}, {"position": 2, "text": "Grill or broil the bread until toasted on one side. Smear the untoasted sides generously with mustard and layer the bacon, potatoes and onions on top of one mustard side. Cover with the remaining bread, mustard side down."}], "nutrition": {"calories": 213.2, "protein_g": 7.4, "carbohydrates_g": 12.9, "fat_g": 14.7, "saturated_fat_g": 4.9, "trans_fat_g": 0.1, "cholesterol_mg": 24.9, "sodium_mg": 359.3, "fiber_g": 1.3, "sugar_g": 1.8, "unsaturated_fat_g": 8.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["bacon", "broil", "fry", "grill", "russet potato"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/01/dining/Elviss-Fried-Potato-Sandwich/Elviss-Fried-Potato-Sandwich-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 63}, "video_url": null, "comment_count": null, "published_at": "2002-11-10", "scraped_at": "2026-09-07T02:13:55.738613+00:00", "scraper_version": "1.0.0"}

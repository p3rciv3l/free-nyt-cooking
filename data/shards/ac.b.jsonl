, "text": "Combine softened bulgur with raisins, walnuts and three tablespoons of the melted butter. Season to taste with a little salt."}, {"position": 4, "text": "Cut squashes in half and remove the seeds. Brush cut sides with melted butter. Fill cavities of the squash with bulgur and raisin mixture and cover with foil. Bake 25 minutes."}, {"position": 5, "text": "Uncover and bake until squash is tender, about 20 to 25 minutes longer."}], "nutrition": {"calories": 304.0, "protein_g": 4.4, "carbohydrates_g": 42.8, "fat_g": 15.5, "saturated_fat_g": 7.6, "trans_fat_g": 0.0, "cholesterol_mg": 30.5, "sodium_mg": 671.3, "fiber_g": 5.3, "sugar_g": 9.9, "unsaturated_fat_g": 7.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["middle eastern"], "diet": ["vegetarian"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["acorn squash", "bake", "bulgur", "raisin", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 62}, "video_url": null, "comment_count": null, "published_at": "1986-10-12", "scraped_at": "2026-09-07T00:10:43.213879+00:00", "scraper_version": "1.0.0"}
{"slug": "acorn-squash-with-sausage-bread-stuffing", "nyt_id": 4244, "url": "https://cooking.nytimes.com/recipes/4244-acorn-squash-with-sausage-bread-stuffing", "name": "Acorn Squash With Sausage Bread Stuffing", "author": "Molly O’Neill", "description": "", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "3 large acorn squash, halved crosswise, seeds and fibers scooped out", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large acorn squash", "preparation": "halved crosswise, seeds and fibers scooped out", "optional": false}, {"position": 2, "raw": "1 teaspoon unsalted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "1 medium onion, peeled and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "peeled and chopped", "optional": false}, {"position": 4, "raw": "12 ounces breakfast-style pork sausage", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "breakfast-style pork sausage", "preparation": null, "optional": false}, {"position": 5, "raw": "2 teaspoons dried thyme", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup toasted pecan halves", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "toasted pecan halves", "preparation": null, "optional": false}, {"position": 9, "raw": "4 cups of ¼-inch cubes of lightly toasted sourdough bread", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "of ¼-inch cubes of lightly toasted sourdough bread", "preparation": null, "optional": false}, {"position": 10, "raw": "¾ cup chicken broth, homemade or low-sodium canned", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": "homemade or low-sodium canned", "optional": false}, {"position": 11, "raw": "4 teaspoons chopped fresh Italian parsley", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "chopped fresh italian parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Slice off the bottom of each squash half so that they stand flat, being careful not to cut into the flesh. Place in a large roasting pan and set aside."}, {"position": 2, "text": "Melt the butter in a large nonstick skillet over medium heat. Add the onion and cook until softened, about 5 minutes. Add the sausage and cook, breaking it up with the back of a spoon, until no traces of pink remain, about 8 minutes. Transfer the mixture to a large bowl and stir in the thyme, salt, pepper, pecans, bread cubes and chicken broth until well mixed."}, {"position": 3, "text": "Divide the stuffing mixture among the squash halves. Add enough water to the roasting pan to make a depth of about ¼ inch. Cover the squash loosely with aluminum foil. Roast until the squash is tender, about 45 minutes. Place 1 squash half on each of 6 plates, garnish with parsley and serve immediately."}], "nutrition": {"calories": 419.6, "protein_g": 15.3, "carbohydrates_g": 45.6, "fat_g": 21.9, "saturated_fat_g": 5.5, "trans_fat_g": 0.1, "cholesterol_mg": 42.3, "sodium_mg": 806.2, "fiber_g": 6.1, "sugar_g": 3.2, "unsaturated_fat_g": 14.1, "sourc
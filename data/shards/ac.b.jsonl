{"slug": "acorn-squash-with-polenta-souffle-and-pulled-pork", "nyt_id": 8718, "url": "https://cooking.nytimes.com/recipes/8718-acorn-squash-with-polenta-souffle-and-pulled-pork", "name": "Acorn Squash With Polenta Soufflé and Pulled Pork", "author": "Molly O’Neill", "description": "Molly O'Neill", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 450, "raw": {"total": "7 hours 30 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons mild paprika", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "mild paprika", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon black pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon chili powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chili powder", "preparation": null, "optional": false}, {"position": 4, "raw": "½ tablespoon garlic powder", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "garlic powder", "preparation": null, "optional": false}, {"position": 5, "raw": "½ tablespoon cumin powder", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "cumin powder", "preparation": null, "optional": false}, {"position": 6, "raw": "½ tablespoon sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "salt", "preparation": null, "optional": false}, {"position": 8, "raw": "1 Boston butt (pork-shoulder roast with bone, 6 to 7 pounds)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "boston butt (pork-shoulder roast with bone", "preparation": "6 to 7 pounds)", "optional": false}, {"position": 9, "raw": "2 cups hickory, apple or cherry wood chips", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "hickory", "preparation": "apple or cherry wood chips", "optional": false}, {"position": 10, "raw": "6 small acorn squash", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "small acorn squash", "preparation": null, "optional": false}, {"position": 11, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 12, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ cup masa harina (corn flour)", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "masa harina (corn flour)", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ cup yellow cornmeal", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "yellow cornmeal", "preparation": null, "optional": false}, {"position": 15, "raw": "½ cup milk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 16, "raw": "3 eggs, separated", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "separated", "optional": false}, {"position": 17, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 18, "raw": "1 teaspoon freshly ground pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "freshly ground pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the pulled pork, combine the spices and sugar, rub them all over the pork roast and refrigerate overnight."}, {"position": 2, "text": "Soak the wood chips in water 20 minutes before cooking. When ready to cook, partly fill a metal bowl with water. In the bottom of a charcoal grill, surround the bowl with charcoals. Ignite the coals, and when they are white, place the roast, fat side up, over the bowl and add some wood chips to the fire. Cook, covered, 4 to 6 hours, adding wood chips and charcoal every hour as needed, until the roast has reached an internal temperature of 185 degrees. Allow it to cool for an hour before removing the fat and pulling the pork into pieces."}, {"position": 3, "text": "Meanwhile, make the acorn squash. Preheat oven to 350 degrees. Slice off the tops of the squash and enough off the bottoms to make them sit flat. Scoop out the seeds and rub about 2 teaspoons of butter inside each. Roast for 40 minutes and keep warm."}, {"position": 4, "text": "To make the polenta souffle, melt the butter in a medium pan. Stir in the corn flour and cornmeal and cook over medium heat for 2 minutes. Mix in the milk and 1 cup water and cook, stirring, 5 minutes."}, {"position": 5, "text": "Remove from heat. Beat 2 tablespoons water into egg yolks, then stir thoroughly into the flour mixture. Add the salt and pepper."}, {"position": 6, "text": "Meanwhile, whisk the egg whites until they form stiff but not dry peaks; gently mix them into the polenta, using a wooden spoon."}, {"position": 7, "text": "Place about cup of the pulled pork in each squash, and over that, spoon in ¼ to ½ cup of the souffle mixture. Bake until the souffle has become puffy and brown, 30 to 40 minutes. Serve immediately alongside additional pulled pork."}], "nutrition": {"calories": 480.7, "protein_g": 16.3, "carbohydrates_g": 53.4, "fat_g": 25.3, "saturated_fat_g": 12.9, "trans_fat_g": 0.1, "cholesterol_mg": 152.5, "sodium_mg": 1133.0, "fiber_g": 8.1, "sugar_g": 6.4, "unsaturated_fat_g": 10.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["acorn squash", "bake", "fall", "polenta", "pork", "project"]}, "images": [], "rating": {"average": 3.0, "count": 25}, "video_url": null, "comment_count": null, "published_at": "1998-09-13", "scraped_at": "2026-09-07T01:23:28.114537+00:00", "scraper_version": "1.0.0"}
{"slug": "acorn-squash-with-sausage-bread-stuffing", "nyt_id": 4244, "url": "https://cooking.nytimes.com/recipes/4244-acorn-squash-with-sausage-bread-stuffing", "name": "Acorn Squash With Sausage Bread Stuffing", "author": "Molly O’Neill", "description": "", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "3 large acorn squash, halved crosswise, seeds and fibers scooped out", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large acorn squash", "preparation": "halved crosswise, seeds and fibers scooped out", "optional": false}, {"position": 2, "raw": "1 teaspoon unsalted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "1 medium onion, peeled and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "peeled and chopped", "optional": false}, {"position": 4, "raw": "12 ounces breakfast-style pork sausage", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "breakfast-style pork sausage", "preparation": null, "optional": false}, {"position": 5, "raw": "2 teaspoons dried thyme", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup toasted pecan halves", "group": null, "quant
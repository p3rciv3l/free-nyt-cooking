{"slug": "acorn-squash-stuffed-with-bulgur", "nyt_id": 2345, "url": "https://cooking.nytimes.com/recipes/2345-acorn-squash-stuffed-with-bulgur", "name": "Acorn Squash Stuffed With Bulgur", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "About 1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ cup bulgur", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "bulgur", "preparation": null, "optional": false}, {"position": 2, "raw": "⅓ cup orange juice", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "orange juice", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup golden raisins", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "golden raisins", "preparation": null, "optional": false}, {"position": 4, "raw": "3 tablespoon chopped walnuts", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chopped walnuts", "preparation": null, "optional": false}, {"position": 5, "raw": "4 tablespoons butter, melted", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": "melted", "optional": false}, {"position": 6, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "2 acorn squashes (about 2 pounds)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "acorn squashes (about 2 pounds)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place bulgur in a bowl. Warm orange juice and pour over bulgur. Allow to soak until bulgur has softend, about 30 minutes."}, {"position": 2, "text": "Preheat oven to 400 degrees."}, {"position": 3
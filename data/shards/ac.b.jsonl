 "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "nutmeg", "preparation": null, "optional": false}, {"position": 10, "raw": "1 tablespoon cider vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "cider vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 12, "raw": "1 ½ cups unsalted, unbuttered popcorn, optional", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "unsalted", "preparation": "unbuttered popcorn", "optional": true}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Place the squash halves cut side down on a foil-lined baking sheet, and bake until tender, about 40 minutes."}, {"position": 2, "text": "Meanwhile, melt the butter in a large saucepan. Add the onion, saute until tender and then add the applejack. Scoop out the flesh of the squash, and add it to the saucepan along with the cider and chicken stock. Cook for 20 minutes."}, {"position": 3, "text": "Puree the mixture in a blender, in batches if necessary, until very smooth. Return to the saucepan, reheat and season with cardamom, cinnamon and nutmeg. Stir in the vinegar, and season to taste with salt and pepper. Garnish each serving with popcorn, if desired."}], "nutrition": {"calories": 225.6, "protein_g": 5.1, "carbohydrates_g": 34.6, "fat_g": 5.1, "saturated_fat_g": 2.4, "trans_fat_g": 0.0, "cholesterol_mg": 11.2, "sodium_mg": 957.3, "fiber_g": 3.7, "sugar_g": 10.7, "unsaturated_fat_g": 2.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": [], "occasion": ["thanksgiving"], "other": ["acorn squash", "bake", "fall", "great leftovers", "saute", "soup"]}, "ima
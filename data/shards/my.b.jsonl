{"slug": "my-mothers-tuna-salad", "nyt_id": 7443, "url": "https://cooking.nytimes.com/recipes/7443-my-mothers-tuna-salad", "name": "My Mother's Tuna Salad", "author": "Julia Reed", "description": "This is Julia Reed’s favorite tuna salad, the one she subsisted on for years as a child, eaten with a fork straight out of a container in her mother’s refrigerator. It’s an unfussy thing that is exactly suited to be layered between two pieces of white bread — toasted, if you must — and then eaten at the kitchen table, or, after summer ends, at the lunchroom table. The ingredients are simple and easily acquired, and be sure to use real mayonnaise.", "servings": {"text": "About 3 cups", "min": 3, "max": 3, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "1 (12-ounce) can StarKist solid white albacore tuna in water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(12-ounce) can starkist solid white albacore tuna in water", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup Hellmann's mayonnaise", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "hellmann's mayonnaise", "preparation": null, "optional": false}, {"position": 3, "raw": "4 large ribs celery, peeled and finely chopped", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large ribs celery", "preparation": "peeled and finely chopped", "optional": false}, {"position": 4, "raw": "3 hard-boiled eggs, chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "hard-boiled eggs", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "3 tablespoons chopped sweet pickles, with their juice", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chopped sweet pickles", "preparation": "with their juice", "optional": false}, {"position": 6, "raw": "1 tablespoon minced onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced onion", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon celery salt or more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "celery salt or more to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon McCormick Season-All or more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "mccormick season-all or more to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "6 dashes Tabasco", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "dash", "item": "tabasco", "preparation": null, "optional": false}, {"position": 10, "raw": "Cracked pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "cracked pepper to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Drain the tuna, place it in a bowl and break it up with a fork. Add ¼ cup of mayonnaise and blend well. Mix in the remaining ingredients, and add the rest of the mayonnaise. Check for celery salt, Season-All, salt and pepper. This is better if it sits at least one hour before serving."}], "nutrition": {"calories": 251.2, "protein_g": 16.3, "carbohydrates_g": 3.8, "fat_g": 18.8, "saturated_fat_g": 3.4, "trans_fat_g": 0.0, "cholesterol_mg": 105.9, "sodium_mg": 381.3, "fiber_g": 0.8, "sugar_g": 2.2, "unsaturated_fat_g": 14.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course", "side dish"], "meal": [], "occasion": [], "other": ["mayonnaise", "tuna"]}, "images": [], "rating": {"average": 4.0, "count": 43}, "video_ur
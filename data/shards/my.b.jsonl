{"slug": "mystery-cake", "nyt_id": 12016, "url": "https://cooking.nytimes.com/recipes/12016-mystery-cake", "name": "Mystery Cake", "author": "Jennifer Steinhauer", "description": "This is an easy spice cake from \"The Joy of Cooking\" made moist and delicious by using a stealthy ingredient: a can of condensed tomato soup. Make it and see if your guests can guess the secret. Jennifer Steinhauer", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "2 cups sifted flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sifted flour", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon baking soda", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon ground cinnamon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon ground nutmeg", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "ground nutmeg", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon ground cloves", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "ground cloves", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup unsalted butter", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 9, "raw": "1 10 ¾-ounce can condensed tomato soup", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "10 ¾-ounce can condensed tomato soup", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup chopped walnuts or pecans", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped walnuts or pecans", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup raisins", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "raisins", "preparation": null, "optional": false}, {"position": 12, "raw": "Confectioners sugar, optional", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "confectioners sugar", "preparation": null, "optional": true}, {"position": 13, "raw": "Cooking-oil spray for greasing pan", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "cooking-oil spray for greasing pan", "preparation": null, "optional": false}, {"position": 14, "raw": "8 ounces cream cheese, chilled", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "cream cheese", "preparation": "chilled", "optional": false}, {"position": 15, "raw": "6 tablespoons unsalted butter, softened", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": "softened", "optional": false}, {"position": 16, "raw": "2 teaspoons vanilla", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "vanilla", "preparation": null, "optional": false}, {"position": 17, "raw": "3 cups confectioners sugar, sifted", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "confectioners sugar", "preparation": "sifted", "optional": false}, {"position": 18, "raw": "Grated lemon or orange zest, ground", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated lemon or orange zest", "preparation": "ground", "optional": false}, {"position": 19, "raw": "cinnamon or any liqueur to taste, optional", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "cinnamon or any liqueur to taste", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "Preheat the oven to 350 degrees. Grease a 9-inch square baking pan with cooking spray. In a large bowl whisk together the flour, baking soda, cinnamon, nutmeg, cloves and salt."}, {"position": 2, "text": "Using an electric mixer, beat the butter and sugar on high speed until well-combined, 3 to 5 minutes. On low speed, beat in the flour mixture in 3 parts, alternating with the tomato soup in 2 parts. Fold in the nuts and raisins. Spread the batter into the pan and smooth the top. Bake until a toothpick inserted in the center comes out clean, 40 to 45 minutes. Cool the cake in the pan on a rack."}, {"position": 3, "text": "If you choose to make the frosting, combine the cream cheese, butter, vanilla and sugar in the bowl of a mixer and mix until just smooth and creamy. If the frosting is too stiff, beat for a few seconds longer, being careful not to overbeat it. If you choose, stir in the zest, cinnamon or liqueur."}, {"position": 4, "text": "To serve, remove the cake from the pan and either sprinkle with powdered sugar or cover with the frosting."}], "nutrition": {"calories": 801.8, "protein_g": 8.5, "carbohydrates_g": 113.6, "fat_g": 37.2, "saturated_fat_g": 15.9, "trans_fat_g": 0.3, "cholesterol_mg": 66.8, "sodium_mg": 509.3, "fiber_g": 3.6, "sugar_g": 80.8, "unsaturated_fat_g": 18.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["all-purpose flour", "bake"]}, "images": [{"url": "https://static01.nyt.com/images/2016/08/17/dining/17COOKINGRECIPE-CARROTCAKE1/17COOKINGRECIPE-CARROTCAKE1-facebookJumbo.jpg", "alt": "", "primary": true}], "r
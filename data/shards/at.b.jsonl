{"slug": "atjar-bloemkool-pickled-cauliflower-indonesian-style", "nyt_id": 3591, "url": "https://cooking.nytimes.com/recipes/3591-atjar-bloemkool-pickled-cauliflower-indonesian-style", "name": "Atjar Bloemkool (Pickled Cauliflower Indonesian Style)", "author": "Eileen Yin-Fei Lo", "description": "", "servings": {"text": "Four to six servings as a side dish", "min": 4, "max": 6, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 head cauliflower, about 1 ½ pounds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "cauliflower", "preparation": "about 1 ½ pounds", "optional": false}, {"position": 2, "raw": "1 teaspoon fresh or frozen turmeric, minced (see note)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "fresh or frozen turmeric", "preparation": "minced (see note)", "optional": false}, {"position": 3, "raw": "1 teaspoon ginger, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ginger", "preparation": "minced", "optional": false}, {"position": 4, "raw": "2 cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 5, "raw": "1 cup white vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ cups water", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut the florets from the cauliflower into pieces two and a half inches in length by about one and a half inches wide. Wash and drain them."}, {"position": 2, "text": "Place eight cups of water in a large pot. Bring the water to a boil. Add the cauliflower and cook for 10 to 15 seconds, until the florets whiten slightly. Remove the pot from the heat and run cold water into it. Drain the cauliflower, put it back in the pot, run cold water over it again. Drain. Place in a large bowl and reserve."}, {"position": 3, "text": "In the pot, place all the other ingredients and bring to a boil. Stir to dissolve the sugar. Turn off the heat, pour the mixture over the cauliflower florets and mix well so that the cauliflower is covered and the florets turn bright yellow. Place the bowl, covered, in the refrigerator for at least 12 hours, or overnight. Serve cold. Leftover cauliflower florets may be kept in a jar, refrigerated, for about four to six weeks."}], "nutrition": {"calories": 97.4, "protein_g": 1.8, "carbohydrates_g": 21.9, "fat_g": 0.3, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 418.6, "fiber_g": 1.9, "sugar_g": 18.4, "unsaturated_fat_g": 0.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["indonesian"], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "cauliflower", "pickles"]}, "images": [], "rating": {"average": 4.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "1989-06-11", "scraped_at": "2026-09-07T05:20:37.499709+00:00", "scraper_version": "1.0.0"}

{"slug": "cedar-roasted-carrots-with-tofu-and-carrot-pesto", "nyt_id": 12905, "url": "https://cooking.nytimes.com/recipes/12905-cedar-roasted-carrots-with-tofu-and-carrot-pesto", "name": "Cedar-Roasted Carrots With Tofu and Carrot Pesto", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "28 baby carrots in mixed colors, with tops, or larger carrots halved crosswise and lengthwise, rinsed", "group": null, "quantity": 28.0, "quantity_max": null, "unit": null, "item": "baby carrots in mixed colors", "preparation": "with tops, or larger carrots halved crosswise and lengthwise, rinsed", "optional": false}, {"position": 2, "raw": "1 small clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small clove garlic", "preparation": null, "optional": false}, {"position": 3, "raw": "Juice of ½ lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of ½ lemon", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup plus 1 tablespoon extra-virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "plus 1 tablespoon extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and ground black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "½ pound regular carrots, peeled and diced", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "regular carrots", "preparation": "peeled and diced", "optional": false}, {"position": 7, "raw": "1 cup fresh carrot juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh carrot juice", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon finely grated fresh ginger", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely grated fresh ginger", "preparation": null, "optional": false}, {"position": 9, "raw": "½ pound soft tofu, diced", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "soft tofu", "preparation": "diced", "optional": false}, {"position": 10, "raw": "2 tablespoons toasted sesame seeds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "toasted sesame seeds", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 325 degrees. Soak 4 sheets of cedar paper, about 8 inches square (sold in cookware and Japanese kitchen-equipment stores) in water for 10 minutes. Cut tops off carrots. Reserve 4 sprigs and chop 1 cup, packed, of the tops. Turn on food processor. Drop garlic in through the feed tube and process until minced, scraping down workbowl once or twice. Place chopped carrot tops and lemon juice in processor and process until minced. With machine running, drizzle in ½ cup olive oil. Process to a purée. Season with salt and pepper and set aside."}, {"position": 2, "text": "Place baby carrots in a large bowl and toss with 1 tablespoon olive oil. Drain cedar paper and spread in the bottom of a roasting pan. Spread carrots evenly on top, cover with foil, place over medium-high heat until the oil starts to sizzle, then place in the oven until carrots are tender, about 30 to 40 minutes, depending on the size of the carrots. Remove from oven and wrap loosely in the foil to keep warm."}, {"position": 3, "text": "Combine diced carrots and carrot juice in a saucepan and cook on medium about 5 minutes until about half the liquid has evaporated. Transfer to a blender, add grated ginger and process to a purée. Season with salt and pepper and keep warm. Microwave tofu one minute to warm it, or warm in a steamer."}, {"position": 4, "text": "Make a pool of carrot purée on each of 4 dinner plates, spoon the tofu on each and arrange the roasted carrots on top. Drizzle the pesto around, garnish with some sprigs of carrot tops and scatter sesame seeds on top. Serve warm."}], "nutrition": {"calories": 407.5, "protein_g": 6.7, "carbohydrates_g": 20.4, "fat_g": 35.1, "saturated_fat_g": 4.9, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 676.0, "fiber_g": 5.3, "sugar_g": 9.0, "unsaturated_fat_g": 29.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["bake", "carrot", "fall", "saute", "tofu", "vegetables", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2012/10/31/dining/31CARROTS1_SPAN/31CARROTS1_SPAN-facebookJumbo-v2.jpg", "alt": "Cedar-roasted carrots with tofu and carrot pesto.", "primary": true}], "rating": {"average": 4.0, "count": 8}, "video_url": null, "comment_count": null, "published_at": "2012-10-31", "scraped_at": "2026-09-07T00:02:08.840694+00:00", "scraper_version": "1.0.0"}

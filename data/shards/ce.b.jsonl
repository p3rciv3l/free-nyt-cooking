], "steps": [{"position": 1, "text": "Peel celery root and cut into 1-inch cubes. There should be 6 to 7 cups."}, {"position": 2, "text": "Peel potatoes and cut into 1-inch cubes. Combine potatoes and celery-root pieces in a saucepan. Add water to cover and salt to taste. Bring to a boil and cook about 15 minutes or until vegetable pieces are tender."}, {"position": 3, "text": "Meanwhile, preheat broiler to high."}, {"position": 4, "text": "Drain vegetables and pour them into the bowl of a food processor. Blend thoroughly and add salt, pepper, nutmeg, butter and cream. Blend well."}, {"position": 5, "text": "Spoon and scrape mixture into a small baking dish and smooth over the top. Sprinkle evenly with Parmesan cheese."}, {"position": 6, "text": "Place dish under broiler about 6 inches from heat. Broil about 5 minutes or until cheese is nicely browned and glazed."}], "nutrition": {"calories": 340.9, "protein_g": 9.8, "carbohydrates_g": 42.4, "fat_g": 16.1, "saturated_fat_g": 9.8, "trans_fat_g": 0.2, "cholesterol_mg": 44.0, "sodium_mg": 911.8, "fiber_g": 6.8, "sugar_g": 5.2, "unsaturated_fat_g": 5.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "broil", "easy", "potato", "quick"]}, "images": [], "rating": {"average": 5.0, "count": 38}, "video_url": null, "comment_count": null, "published_at": "1987-12-30", "scraped_at": "2026-09-06T22:25:02.474317+00:00", "scraper_version": "1.0.0"}

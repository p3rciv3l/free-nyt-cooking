{"slug": "celery-and-apple-salad", "nyt_id": 3936, "url": "https://cooking.nytimes.com/recipes/3936-celery-and-apple-salad", "name": "Celery and Apple Salad", "author": "Jacques Pépin", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "6 ribs celery (about 8 ounces), as white as possible", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "ribs celery (about 8 ounces)", "preparation": "as white as possible", "optional": false}, {"position": 2, "raw": "2 medium-size Red Delicious apples (12 ounces)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium-size red delicious apples (12 ounces)", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ tablespoons lemon juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup sour cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 5, "raw": "¾ teaspoon freshly ground black pepper", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 8, "raw": "6 lettuce leaves, for garnish", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "lettuce leaves", "preparation": "for garnish", "optional": false}], "steps": [{"position": 1, "text": "Trim celery ribs to remove leaves (reserving the trimmings for stock), and peel ribs with vegetable peeler if outer surface is tough or fibrous. Wash and cut the ribs into 2-inch pieces. Then press the pieces flat on the table and cut them lengthwise into thin strips. You should have about 2 ½ cups. Place in a bowl."}, {"position": 2, "text": "Since the apples are not peeled, wash them thoroughly in warm water, scraping lightly with a knife if necessary to remove any surface wax. Stand apples up and cut them lengthwise on all sides into slices ½-inch thick until you reach core. Discard it, pile apple slices together and cut into ½-inch strips. Add pieces to celery along with the all ingredients except lettuce leaves and mix well."}, {"position": 3, "text": "To serve, arrange lettuce leaves on six individual plates and spoon the salad onto the leaves."}], "nutrition": {"calories": 81.6, "protein_g": 1.0, "carbohydrates_g": 11.3, "fat_g": 3.9, "saturated_fat_g": 2.0, "trans_fat_g": 0.2, "cholesterol_mg": 11.3, "sodium_mg": 231.1, "fiber_g": 2.0, "sugar_g": 8.0, "unsaturated_fat_g": 1.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "vegetarian"], "course": ["appetizer", "side dish"], "meal": [], "occasion": [], "other": ["apple", "celery", "salad", "sour cream", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 30}, "video_url": null, "comment_count": null, "published_at": "1991-02-20", "scraped_at": "2026-09-07T00:27:34.232070+00:00", "scraper_version": "1.0.0"}

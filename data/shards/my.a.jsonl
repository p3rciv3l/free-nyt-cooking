{"slug": "myra-waldos-swedish-lamb", "nyt_id": 1015959, "url": "https://cooking.nytimes.com/recipes/1015959-myra-waldos-swedish-lamb", "name": "Myra Waldo's Swedish Lamb", "author": "Craig Claiborne", "description": "Craig Claiborne brought this marvelous dinner-party centerpiece to The Times in 1958, after securing it from Myra Waldo, a globetrotting food and travel writer who edited “The Complete Round-the-World Cookbook,” featuring recipes gathered by Pan American Airways. Mr. Claiborne recommended this one in a column in the newspaper four years later: a leg of lamb roasted above carrots and onions, broth, hot coffee, cream and a sprinkling of sugar. Really! The result on the plate is remarkable in the way the richness of the sauce mingles with the big taste of the lamb. All we needed to do to improve it was exchange the beef broth Claiborne used (too tinny in flavor) for some of the low-sodium chicken variety. (Sam Sifton)", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "PT2H"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon salt", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "salt", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon freshly ground black pepper", "group": null, "quantity": 1.0, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "1 five-pound leg of lamb", "group": null, "quantity": 1.0, "unit": null, "item": "five-pound leg of lamb", "preparation": null, "optional": false}, {"position": 4, "raw": "3 onions, sliced", "group": null, "quantity": 3.0, "unit": null, "item": "onions", "preparation": "sliced", "optional": false}, {"position": 5, "raw": "3 carrots, sliced", "group": null, "quantity": 3.0, "unit": null, "item": "carrots", "preparation": "sliced", "optional": false}, {"position": 6, "raw": "1 cup low-sodium chicken broth", "group": null, "quantity": 1.0, "unit": "cup", "item": "low-sodium chicken broth", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ cups hot strong coffee", "group": null, "quantity": 1.5, "unit": "cup", "item": "hot strong coffee", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup heavy cream", "group": null, "quantity": 0.5, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Rub salt and pepper into the lamb. Place the lamb in a roasting pan and surround with onions."}, {"position": 2, "text": "Roast in a hot oven (425 degrees) for 30 minutes and skim off the fat."}, {"position": 3, "text": "Reduce heat to moderate (350 degrees) and add the carrots and broth. Roast 30 minutes longer and add the coffee, cream and sugar. Continue roasting, basting frequently, for 40 minutes."}, {"position": 4, "text": "Transfer lamb to a warm platter and force the gravy through a sieve or purée in an electric blender."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 558.75, "protein_g": 54.4, "carbohydrates_g": 9.8, "fat_g": 46.7, "saturated_fat_g": 21.2, "unsaturated_fat_g": 3.6, "trans_fat_g": 0.2, "cholesterol_mg": 210.5, "sodium_mg": 1069.0, "fiber_g": 1.5, "sugar_g": 5.5, "computed_with": null}, "tags": {"cuisine": ["nordic"], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["lamb"]}, "images": [{"url": "https://static01.nyt.com/images/2014/01/15/dining/recipes-myrawaldoswedishlamb/recipes-myrawaldoswedishlamb-superJumbo.jpg", "alt": "Myra Waldo's Swedish lamb.", "primary": true}, {"url": "https://static01.nyt.com/images/2014/01/15/dining/recipes-myrawaldoswedishlamb/recipes-myrawaldoswedishlamb-facebookJumbo-v2.jpg", "alt": "Myra Waldo's Swedish lamb.", "primary": false}], "rating": {"average": 4.0, "count": 234}, "video_url": null, "comment_count": null, "published_at": "1958-03-20", "scraped_at": "2026-09-07T02:58:24Z", "scraper_version": "1.0.0"}

{"slug": "off-oven-roast-beef", "nyt_id": 1014492, "url": "https://cooking.nytimes.com/recipes/1014492-off-oven-roast-beef", "name": "Off-Oven Roast Beef", "author": "Sam Sifton", "description": "", "servings": {"text": "4 to 6 main courses, with leftovers for sandwiches", "min": 4, "max": 6, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "PT2H30M"}}, "ingredients": [{"position": 1, "raw": "1 beef roast, like top, eye or bottom round, approximately 3 pounds", "group": null, "quantity": 1.0, "unit": null, "item": "beef roast", "preparation": "like top, eye or bottom round, approximately 3 pounds", "optional": false}, {"position": 2, "raw": "1 tablespoon kosher salt", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon freshly ground black pepper", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "3 cloves garlic, peeled and minced", "group": null, "quantity": 3.0, "unit": "clove", "item": "garlic", "preparation": "peeled and minced", "optional": false}, {"position": 5, "raw": "1 tablespoon olive oil", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "Red-pepper flakes to taste", "group": null, "quantity": null, "unit": null, "item": "red-pepper flakes to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Remove roast from refrigerator. Preheat oven to 500 degrees."}, {"position": 2, "text": "In a small bowl, mix together salt, pepper, garlic, olive oil and red-pepper flakes to create a kind of paste. Rub this all over the roast. Place beef in a roasting pan or cast-iron skillet, fat-side up, and put in oven. Cook undisturbed for 5 minutes per pound."}, {"position": 3, "text": "Turn off oven. Do not open oven door. Leave roast to continue cooking, undisturbed, for two hours."}, {"position": 4, "text": "After two hours, remove roast from oven. Slice and serve alongside, ideally, a watercress salad, some skillet-fried potatoes and a small tureen of Henry Bain sauce."}], "nutrition": null, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["beef-roast", "five-ingredient", "one-pot", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2013/01/20/magazine/20eat1/20eat1-superJumbo-v2.jpg", "alt": "Roast beef, greens and potatoes.", "primary": true}, {"url": "https://static01.nyt.com/images/2013/01/20/magazine/20eat1/20eat1-facebookJumbo-v2.jpg", "alt": "Roast beef, greens and potatoes.", "primary": false}], "rating": {"average": 5.0, "count": 1724}, "video_url": null, "comment_count": null, "published_at": "2013-01-20", "scraped_at": "2026-09-07T02:18:52Z", "scraper_version": "1.0.0"}

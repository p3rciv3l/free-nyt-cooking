{"slug": "kerala-style-vegetable-korma", "nyt_id": 1024095, "url": "https://cooking.nytimes.com/recipes/1024095-kerala-style-vegetable-korma", "name": "Kerala-Style Vegetable Korma", "author": "Zainab Shah", "description": "A korma can be made with any combination of meats and vegetables, braised or stewed. In the Indian coastal state of Kerala, where coconuts are abundant, vegetable korma is made with desiccated fresh coconut and coconut milk. This quick, convenient version uses the same foundation — onion, tomatoes, ginger and garlic — while skipping the fresh coconut. It works just as well with whatever combination of fresh or frozen vegetables that might be handy. Cashew butter is used in place of making a paste from soaked cashews. Black mustard seeds add complex bitterness; Thai green chiles, black pepper and garam masala give it a kick. Cutting corners doesn’t quell any flavor in this recipe.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 2, "cook_minutes": 976, "total_minutes": 18, "raw": {"prep": "PT2M", "cook": "PT16H16M", "total": "PT18M"}}, "ingredients": [{"position": 1, "raw": "¼ cup ghee, coconut oil or neutral oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "ghee", "preparation": "coconut oil or neutral oil", "optional": false}, {"position": 2, "raw": "2 teaspoons black mustard seeds", "group": null, "quantity": 2.0, "unit": "tsp", "item": "black mustard seeds", "preparation": null, "optional": false}, {"position": 3, "raw": "1 yellow or red onion, finely chopped", "group": null, "quantity": 1.0, "unit": null, "item": "yellow or red onion", "preparation": "finely chopped", "optional": false}, {"position": 4, "raw": "1 teaspoon ginger paste or freshly grated ginger", "group": null, "quantity": 1.0, "unit": "tsp", "item": "ginger paste or freshly grated ginger", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon garlic paste or freshly grated garlic", "group": null, "quantity": 1.0, "unit": "tsp", "item": "garlic paste or freshly grated garlic", "preparation": null, "optional": false}, {"position": 6, "raw": "3 Thai green chiles, sliced", "group": null, "quantity": 3.0, "unit": null, "item": "thai green chiles", "preparation": "sliced", "optional": false}, {"position": 7, "raw": "2 teaspoons coarsely ground Malabar black pepper or 1 ½ teaspoons coarsely ground black pepper", "group": null, "quantity": 2.0, "unit": "tsp", "item": "coarsely ground malabar black pepper or 1 ½ teaspoons coarsely ground black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ teaspoons fine sea salt", "group": null, "quantity": 1.5, "unit": "tsp", "item": "fine sea salt", "preparation": null, "optional": false}, {"position": 9, "raw": "¾ teaspoon Kashmiri or other mild red chile powder (optional)", "group": null, "quantity": 0.75, "unit": "tsp", "item": "kashmiri or other mild red chile powder", "preparation": null, "optional": true}, {"position": 10, "raw": "½ teaspoon turmeric powder", "group": null, "quantity": 0.5, "unit": "tsp", "item": "turmeric powder", "preparation": null, "optional": false}, {"position": 11, "raw": "3 Roma tomatoes (optional), finely chopped", "group": null, "quantity": 3.0, "unit": null, "item": "roma tomatoes", "preparation": "finely chopped", "optional": true}, {"position": 12, "raw": "2 tablespoons cashew butter", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "cashew butter", "preparation": null, "optional": false}, {"position": 13, "raw": "1 pound frozen (not thawed) or fresh mixed vegetables, such as cauliflower florets, chopped carrots, peas, broccoli florets, chopped green beans and corn", "group": null, "quantity": 1.0, "unit": "lb", "item": "frozen or fresh mixed vegetables", "preparation": "such as cauliflower florets, chopped carrots, peas, broccoli florets, chopped green beans and corn", "optional": false}, {"position": 14, "raw": "1 (13.5-ounce) can full-fat coconut milk", "group": null, "quantity": 1.0, "unit": "can", "item": "full-fat coconut milk", "preparation": null, "optional": false}, {"position": 15, "raw": "½ teaspoon garam masala", "group": null, "quantity": 0.5, "unit": "tsp", "item": "garam masala", "preparation": null, "optional": false}, {"position": 16, "raw": "2 tablespoons chopped cilantro (optional)", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped cilantro", "preparation": null, "optional": true}, {"position": 17, "raw": "Rice, roti or naan, for serving", "group": null, "quantity": null, "unit": null, "item": "rice", "preparation": "roti or naan, for serving", "optional": false}], "steps": [{"position": 1, "text": "Heat ghee or oil in a large pot over high for 30 seconds. Add mustard seeds. When they start to sputter, add onion, ginger, garlic and green chiles. Continue cooking, stirring occasionally until the onions are translucent, about 5 minutes."}, {"position": 2, "text": "Stir in black pepper, salt, red chile powder and turmeric. Add tomatoes (if using) and cashew butter and stir until the cashew butter has melted. (If using the tomatoes, continue cooking until the tomatoes start to break down, about 5 minutes.) Stir in vegetables then coconut milk. Once the liquid is boiling, reduce the heat to medium and continue simmering until the vegetables are cooked through, 8 to 10 minutes."}, {"position": 3, "text": "Top with garam masala and cilantro, if using. Serve with rice, roti or naan."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 358.6666666666667, "protein_g": 5.4, "carbohydrates_g": 30.2, "fat_g": 26.1, "saturated_fat_g": 13.4, "unsaturated_fat_g": 3.4, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 576.5, "fiber_g": 3.8, "sugar_g": 6.5, "computed_with": null}, "tags": {"cuisine": ["indian"], "diet": [], "course": ["dinner-lunch-main-course-side-dish-vegetables"], "meal": [], "occasion": [], "other": ["broccoli", "carrot", "cashew-butter", "cauliflower", "chile", "coconut-milk", "coconut-oil", "corn", "easy", "eid-al-fitr", "frozen-mixed-vegetable", "ghee", "great-leftovers", "green-bean", "one-pot", "pea", "quick", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2023/04/12/multimedia/ZS-vegetable-korma-hblf/ZS-vegetable-korma-hblf-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2023/04/12/multimedia/ZS-vegetable-korma-hblf/ZS-vegetable-korma-hblf-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2023/04/12/multimedia/ZS-vegetable-korma-hblf/ZS-vegetable-korma-hblf-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2023/04/12/multimedia/ZS-vegetable-korma-hblf/ZS-vegetable-korma-hblf-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 2017}, "video_url": "https://vp.nyt.com/video/2026/01/23/159697_1_Kerala-Style-Vegetable-Korma-YT-VID_wg_480p.mp4", "comment_count": null, "published_at": "2023-04-06", "scraped_at": "2026-09-07T00:54:16Z", "scraper_version": "1.0.0"}

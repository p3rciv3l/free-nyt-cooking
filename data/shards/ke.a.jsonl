{"slug": "keftikes-de-poyo-chicken-croquettes", "nyt_id": 10056, "url": "https://cooking.nytimes.com/recipes/10056-keftikes-de-poyo-chicken-croquettes", "name": "Keftikes de Poyo (Chicken Croquettes)", "author": "Henry Kamm", "description": "", "servings": {"text": "15 to 20 croquettes", "min": 15, "max": 20, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "4 large chicken breasts", "group": null, "quantity": 4.0, "unit": null, "item": "large chicken breasts", "preparation": null, "optional": false}, {"position": 2, "raw": "1 medium onion, finely chopped", "group": null, "quantity": 1.0, "unit": null, "item": "medium onion", "preparation": "finely chopped", "optional": false}, {"position": 3, "raw": "½ pound ground beef", "group": null, "quantity": 0.5, "unit": "lb", "item": "ground beef", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup matzoh meal", "group": null, "quantity": 0.5, "unit": "cup", "item": "matzoh meal", "preparation": null, "optional": false}, {"position": 5, "raw": "3 eggs", "group": null, "quantity": 3.0, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons finely chopped fresh dill", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "finely chopped fresh dill", "preparation": null, "optional": false}, {"position": 7, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "unit": null, "item": "salt and pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Poach the chicken breasts in very little water until the meat is very tender and can be easily removed from the bones."}, {"position": 2, "text": "Pass chicken and onion through a coarse grinder and mix with beef, matzoh meal, eggs, dill, salt and pepper in a large bowl."}, {"position": 3, "text": "Break off egg-sized pieces of the mixture and shape into round, slightly flattened croquettes. Saute gently in olive oil until well browned on both sides. Serve hot or cold."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 155.44444444444446, "protein_g": 20.3, "carbohydrates_g": 2.1, "fat_g": 6.7, "saturated_fat_g": 1.8, "unsaturated_fat_g": 0.7, "trans_fat_g": 0.2, "cholesterol_mg": 90.8, "sodium_mg": 243.8, "fiber_g": 0.2, "sugar_g": 0.3, "computed_with": null}, "tags": {"cuisine": ["greek"], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["chicken-breast", "ground-beef", "matzo-meal"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "1986-04-02", "scraped_at": "2026-09-07T01:15:50Z", "scraper_version": "1.0.0"}
{"slug": "kelly-fieldss-haystack-cookies", "nyt_id": 1017844, "url": "https://cooking.nytimes.com/recipes/1017844-kelly-fieldss-haystack-cookies", "name": "Kelly Fields’s Haystack Cookies", "author": "Martha Rose Shulman", "description": "I toasted the rolled oats called for in Ms. Fields's recipe, just to get a little more texture out of them. Make sure the mixture is hot when you drop the cookies or the texture will be too crumbly.", "servings": {"text": "30 to 36 cookies", "min": 30, "max": 36, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 50, "raw": {"total": "PT50M"}}, "ingredients": [{"position": 1, "raw": "1 ⅓ cups plus 1 tablespoon rolled oats/160 grams", "group": null, "quantity": 1.3333333333333333, "unit": "cup", "item": "plus 1 tablespoon rolled oats/160 grams", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup sugar/219 grams", "group": null, "quantity": 1.0, "unit": "cup", "item": "sugar/219 grams", "preparation": null, "optional": false}, {"position": 3, "raw": "2 ounces unsalted butter/56 grams", "group": null, "quantity": 2.0, "unit": "oz", "item": "unsalted butter/56 grams", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup dark cocoa powder/28 grams", "group": null, "quantity": 0.25, "unit": "cup", "item": "dark cocoa powder/28 grams", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup evaporated milk/60 grams", "group": null, "quantity": 0.25, "unit": "cup", "item": "evaporated milk/60 grams", "preparation": null, "optional": false}, {"position": 6, "raw": "Pinch salt/1 gram", "group": null, "quantity": null, "unit": null, "item": "pinch salt/1 gram", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon vanilla extract/5 grams", "group": null, "quantity": 1.0, "unit": "tsp", "item": "vanilla extract/5 grams", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup finely grated coconut/41 grams", "group": null, "quantity": 0.5, "unit": "cup", "item": "finely grated coconut/41 grams", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 300 degrees. Spread rolled oats on a baking sheet and toast for 20 to 30 minutes, until slightly darker and toasty smelling. Remove from heat."}, {"position": 2, "text": "Line baking sheets or your work surface with parchment or wax paper. In a heavy saucepan, combine sugar, butter, cocoa powder, evaporated milk and salt and bring to a boil, stirring. Remove from heat and stir in vanilla extract, oats and coconut."}, {"position": 3, "text": "Immediately drop the warm mixture by scant tablespoons onto parchment or wax paper. Allow to cool and store in a tin."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 57.0, "protein_g": 0.8, "carbohydrates_g": 9.1, "fat_g": 2.3, "saturated_fat_g": 1.4, "unsaturated_fat_g": 0.1, "trans_fat_g": null, "cholesterol_mg": 4.2, "sodium_mg": 7.2, "fiber_g": 0.7, "sugar_g": 6.4, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["cookie"], "meal": [], "occasion": [], "other": ["christmas", "cocoa-powder", "evaporated-milk", "new-year-s-day", "rolled-oat", "thanksgiving"]}, "images": [{"url": "https://static01.nyt.com/images/2015/12/02/dining/02MARTHA1/02MARTHA1-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2015/12/02/dining/02MARTHA1/02MARTHA1-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 360}, "video_url": null, "comment_count": null, "published_at": "2015-12-02", "scraped_at": "2026-09-07T03:49:12Z", "scraper_version": "1.0.0"}
{"slug": "kenmares-asparagus-gratin", "nyt_id": 1015590, "url": "https://cooking.nytimes.com/recipes/1015590-kenmares-asparagus-gratin", "name": "Kenmare’s Asparagus Gratin", "author": "Elaine Louie", "description": "Elaine Louie", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 70, "raw": {"total": "PT1H10M"}}, "ingredients": [{"position": 1, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 2, "raw": "2 shallots, finely chopped", "group": null, "quantity": 2.0, "unit": null, "item": "shallots", "preparation": "finely chopped", "optional": false}, {"position": 3, "raw": "¼ cup dry white wine, such as Chenin Blanc or Sauvignon Blanc", "group": null, "quantity": 0.25, "unit": "cup", "item": "dry white wine", "preparation": "such as Chenin Blanc or Sauvignon Blanc", "optional": false}, {"position": 4, "raw": "¼ cup crushed pecans", "group": null, "quantity": 0.25, "unit": "cup", "item": "crushed pecans", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup panko bread crumbs", "group": null, "quantity": 0.25, "unit": "cup", "item": "panko bread crumbs", "preparation": null, "optional": false}, {"position": 6, "raw": "1 bunch fresh spring asparagus, peeled and cut diagonally into ½-inch slices, ends discarded", "group": null, "quantity": 1.0, "unit": "bunch", "item": "fresh spring asparagus", "preparation": "peeled and cut diagonally into ½-inch slices, ends discarded", "optional": false}, {"position": 7, "raw": "¼ cup grated fontina cheese", "group": null, "quantity": 0.25, "unit": "cup", "item": "grated fontina cheese", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup grated Parmigiano Reggiano", "group": null, "quantity": 0.25, "unit": "cup", "item": "grated parmigiano reggiano", "preparation": null, "optional": false}, {"position": 9, "raw": "2 large endive, trimmed, and cut into diagonal slices, 1-inch wide", "group": null, "quantity": 2.0, "unit": null, "item": "large endive", "preparation": "trimmed, and cut into diagonal slices, 1-inch wide", "optional": false}, {"position": 10, "raw": "½ small head of radicchio, trimmed, and leaves torn into 1-inch pieces", "group": null, "quantity": 0.5, "unit": null, "item": "small head of radicchio", "preparation": "trimmed, and leaves torn into 1-inch pieces", "optional": false}, {"position": 11, "raw": "Extra virgin olive oil, as needed", "group": null, "quantity": null, "unit": null, "item": "extra virgin olive oil", "preparation": "as needed", "optional": false}, {"position": 12, "raw": "Fresh lemon juice, as needed", "group": null, "quantity": null, "unit": null, "item": "fresh lemon juice", "preparation": "as needed", "optional": false}, {"position": 13, "raw": "Salt and freshly ground black pepper.", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground black pepper.", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. In a medium saucepan, combine the cream, shallots and wine. Place over medium heat and simmer until reduced by half, 20 to 30 minutes."}, {"position": 2, "text": "Spread pecans on a baking sheet and bake, stirring once or twice, until toasted, 10 to 15 minutes. Meanwhile, place a skillet over low heat, add panko, and stir until golden brown, about 5 minutes. Remove from heat and set aside to cool. When pecans are toasted, remove from oven and set aside to cool."}, {"position": 3, "text": "Increase oven temperature to 400 degrees. When the pecans are cool, place in a blender and chop for a few seconds until coarsely ground. Mix with panko and set aside."}, {"position": 4, "text": "In a mixing bowl combine asparagus, reduced cream, fontina, and Parmigiano Reggiano. Mix well and place in a gratin dish that is about 10 inches long and 4 inches wide, or an other shallow, ovenproof baking dish. Bake until asparagus are tender, the sauce is bubbling and the top is turning golden, 6 to 10 minutes. Remove from oven and top with pecan-bread crumb mixture. In a separate bowl, mix the endive and radicchio with olive oil, lemon juice, and salt and pepper to taste. Spread over the top of the asparagus gratin. Serve hot."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 410.5, "protein_g": 10.6, "carbohydrates_g": 16.0, "fat_g": 34.3, "saturated_fat_g": 17.5, "unsaturated_fat_g": 2.9, "trans_fat_g": 0.7, "cholesterol_mg": 83.1, "sodium_mg": 565.4, "fiber_g": 4.2, "sugar_g": 5.9, "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["dinner-lunch-side-dish"], "meal": [], "occasion": [], "other": ["asparagus"]}, "images": [{"url": "https://static01.nyt.com/images/2014/04/25/dining/Asparagus-Gratin/Asparagus-Gratin-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/04/25/dining/Asparagus-Gratin/Asparagus-Gratin-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 38}, "video_url": null, "comment_count": null, "published_at": "2010-05-24", "scraped_at": "2026-09-07T02:50:04Z", "scraper_version": "1.0.0"}

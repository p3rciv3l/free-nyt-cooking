ull, "optional": false}, {"position": 9, "raw": "⅛ teaspoon ground saffron", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "ground saffron", "preparation": null, "optional": false}, {"position": 10, "raw": "16 medium-sized new potatoes, peeled", "group": null, "quantity": 16.0, "quantity_max": null, "unit": null, "item": "medium-sized new potatoes", "preparation": "peeled", "optional": false}, {"position": 11, "raw": "2 large carrots, peeled and cut in 2-inch chunks", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large carrots", "preparation": "peeled and cut in 2-inch chunks", "optional": false}, {"position": 12, "raw": "4 eggs in their shells (optional)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "eggs in their shells", "preparation": null, "optional": true}, {"position": 13, "raw": "Juice of one lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of one lemon", "preparation": null, "optional": false}, {"position": 14, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 15, "raw": "2 tablespoons toasted slivered almonds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "toasted slivered almonds", "preparation": null, "optional": false}, {"position": 16, "raw": "2 tablespoons chopped fresh mint", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh mint", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place chickpeas and beans in a bowl, cover with water to a depth of 2 inches and soak at least 4 hours or overnight. Drain and rinse the beans."}, {"position": 2, "text": "Heat the oil in a heavy casserole. Add onions and saute until golden. Stir in the garlic, saute for 
{"slug": "raspberry-tarragon-vinegar", "nyt_id": 10023, "url": "https://cooking.nytimes.com/recipes/10023-raspberry-tarragon-vinegar", "name": "Raspberry-Tarragon Vinegar", "author": "Molly O’Neill", "description": "", "servings": {"text": "2 cups", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "PT20M"}}, "ingredients": [{"position": 1, "raw": "1 17-ounce bottle good-quality white-wine vinegar", "group": null, "quantity": 18.0, "unit": null, "item": "ounce bottle good-quality white-wine vinegar", "preparation": null, "optional": false}, {"position": 2, "raw": "1 pint fresh raspberries", "group": null, "quantity": 1.0, "unit": "pint", "item": "fresh raspberries", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup fresh tarragon leaves and stems, bruised slightly", "group": null, "quantity": 0.25, "unit": "cup", "item": "fresh tarragon leaves and stems", "preparation": "bruised slightly", "optional": false}, {"position": 4, "raw": "1 tablespoon honey", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the vinegar in a nonreactive saucepan over low heat until warm. Place the raspberries and tarragon in a sterilized, wide-mouthed jar. Pour in the warm vinegar. Seal tight. Let stand in a warm place for two weeks."}, {"position": 2, "text": "Strain the vinegar, pressing the raspberries firmly. Place in a nonreactive saucepan with the honey and bring to a boil. Lower the heat and simmer for 10 minutes. Pour into a sterilized bottle and seal with a new cork. Keep refrigerated."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 171.0, "protein_g": 3.0, "carbohydrates_g": 29.8, "fat_g": 1.4, "saturated_fat_g": 0.1, "unsaturated_fat_g": 0.8, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 9.9, "fiber_g": 10.5, "sugar_g": 15.6, "computed_with":
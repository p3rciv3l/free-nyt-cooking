{"slug": "raw-artichoke-salad", "nyt_id": 1014663, "url": "https://cooking.nytimes.com/recipes/1014663-raw-artichoke-salad", "name": "Raw Artichoke Salad", "author": "David Tanis", "description": "In Italy, a favorite way to serve fresh small artichokes is raw, dressed with oil and lemon. It couldn’t be a simpler presentation, and it’s sensational. Slice the trimmed artichokes as thinly as possible, then season and toss with fruity extra-virgin olive oil and lemon juice. Serve over arugula and add curls of Parmesan.", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "4 baby artichokes", "group": null, "quantity": 4.0, "unit": null, "item": "baby artichokes", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 3, "raw": "1 small garlic clove, smashed to a paste, optional", "group": null, "quantity": 1.0, "unit": null, "item": "small garlic clove", "preparation": "smashed to a paste, optional", "optional": true}, {"position": 4, "raw": "Salt and pepper", "group": null, "quantity": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons extra virgin olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "2 handfuls arugula", "group": null, "quantity": 2.0, "unit": "handful", "item": "arugula", "preparation": null, "optional": false}, {"position": 7, "raw": "Parmesan, for garnish", "group": null, "quantity": null, "unit": null, "item": "parmesan", "preparation": "for garnish", "optional": false}], "steps": [{"position": 1, "text": "Remove dark tough exterior leaves from artichokes. Trim stem end and cut off top of each artichoke. Slice artichokes as thinly as possible and place in a small mixing bowl. Add lemon juice and garlic, if using. Season well with salt and pepper, add olive oil and toss to coat."}, {"position": 2, "text": "Put arugula in a shallow bowl or on a platter. Spoon artichokes over greens. Garnish with a few shavings of Parmesan."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 382.0, "protein_g": 15.2, "carbohydrates_g": 33.6, "fat_g": 24.3, "saturated_fat_g": 5.0, "unsaturated_fat_g": 2.4, "trans_fat_g": null, "cholesterol_mg": 9.6, "sodium_mg": 806.3, "fiber_g": 16.5, "sugar_g": 3.2, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["arugula", "baby-artichoke", "five-ingredient", "parmesan", "quick"]}, "images": [{"url": "https://static01.nyt.com/images/2013/04/10/dining/10KITCH1_SPAN/10KITCH1-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2013/04/10/dining/10KITCH1_SPAN/10KITCH1_SPAN-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 49}, "video_url": null, "comment_count": null, "published_at": "2013-04-10", "scraped_at": "2026-09-06T23:54:04Z", "scraper_version": "1.0.0"}

{"slug": "raspberry-champagne-soup-with-rosemary-raspberry-sorbet", "nyt_id": 10026, "url": "https://cooking.nytimes.com/recipes/10026-raspberry-champagne-soup-with-rosemary-raspberry-sorbet", "name": "Raspberry-Champagne Soup With Rosemary- Raspberry Sorbet", "author": "Molly O’Neill", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "PT1H30M"}}, "ingredients": [{"position": 1, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup water", "group": null, "quantity": 0.5, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ pints fresh raspberries", "group": null, "quantity": 1.5, "unit": "pint", "item": "fresh raspberries", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons balsamic vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "2 ½ tablespoons chopped fresh rosemary", "group": null, "quantity": 2.5, "unit": "tbsp", "item": "chopped fresh rosemary", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup water", "group": null, "quantity": 0.5, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ pints fresh raspberries", "group": null, "quantity": 1.5, "unit": "pint", "item": "fresh raspberries", "preparation": null, "optional": false}, {"position": 9, "raw": "2 cups good-quality Champagne or other sparkling wine, chilled", "group": null, "quantity": 2.0, "unit": "cup", "item": "good-quality champagne or other sparkling wine", "preparation": "chilled", "optional": false}], "steps": [{"position": 1, "text": "To make the sorbet, combine the sugar and water in a small saucepan over medium heat. Simmer for 5 minutes and set aside to cool. Place the raspberries, sugar syrup, vinegar and rosemary in a blender and puree until smooth. Let stand for 1 hour. Strain through a fine-mesh sieve. Refrigerate until cold. Freeze according to the directions on your ice-cream machine."}, {"position": 2, "text": "To make the soup, combine the sugar and water in a small saucepan over medium heat. Simmer just until the sugar dissolves. Let cool. Place all but one-half cup of the raspberries in a blender with the sugar syrup. Puree until smooth. Strain through a fine mesh sieve and refrigerate until cold."}, {"position": 3, "text": "Just before serving, divide the soup mixture among four bowls and add one-half cup of Champagne to each. Place a scoop of the sorbet in the soup and garnish with the remaining raspberries."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 516.75, "protein_g": 3.0, "carbohydrates_g": 107.5, "fat_g": 1.6, "saturated_fat_g": 0.1, "unsaturated_fat_g": 0.9, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 13.5, "fiber_g": 15.4, "sugar_g": 87.5, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert-sorbet-soup"], "meal": [], "occasion": [], "other": ["champagne", "fall", "raspberry", "rosemary", "summer"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": null, "video_url": null, "comment_count": null, "published_at": "1996-06-02", "scraped_at": "2026-09-06T22:26:26Z", "scraper_version": "1.0.0"}

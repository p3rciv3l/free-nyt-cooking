{"slug": "asparagus-and-goat-curd-salad", "nyt_id": 10927, "url": "https://cooking.nytimes.com/recipes/10927-asparagus-and-goat-curd-salad", "name": "Asparagus-and-Goat-Curd Salad", "author": "Amanda Hesser", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "Sea salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sea salt", "preparation": null, "optional": false}, {"position": 2, "raw": "½ pound asparagus, woody ends trimmed", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "asparagus", "preparation": "woody ends trimmed", "optional": false}, {"position": 3, "raw": "3 large handfuls young arugula", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large handfuls young arugula", "preparation": null, "optional": false}, {"position": 4, "raw": "Juice of 1 blood orange", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1 blood orange", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon red wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup grapeseed oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "grapeseed oil", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup goat curd (or fresh goat cheese), chilled", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "goat curd (or fresh goat cheese)", "preparation": "chilled", "optional": false}], "steps": [{"position": 1, "text": "Bring a large pan of water to a boil. Add enough salt to make the water salty. Add the asparagus and cook for 3 minutes. Drain and run under cold water. Lay the asparagus out to cool completely and dry. Slice into 1-to-1 ½-inch lengths. Combine the asparagus and arugula in a bowl."}, {"position": 2, "text": "In a small bowl, whisk together the blood-orange juice, vinegar and mustard and a little salt and pepper. Add the oil in gradual amounts, first in drops, then in a thin stream, until the vinaigrette is thick and emulsified. Season to taste."}, {"position": 3, "text": "Pour the dressing over the arugula and asparagus. Toss to coat. Add the goat curd, broken into lumps. Toss gently to mix. Taste and adjust seasoning."}], "nutrition": {"calories": 178.9, "protein_g": 4.9, "carbohydrates_g": 7.6, "fat_g": 15.1, "saturated_fat_g": 1.8, "trans_fat_g": 0.0, "cholesterol_mg": 4.8, "sodium_mg": 323.5, "fiber_g": 2.3, "sugar_g": 5.0, "unsaturated_fat_g": 12.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["arugula", "asparagus", "boil", "easy", "goat cheese", "quick", "salad"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2002-06-16", "scraped_at": "2026-09-06T22:34:00.559677+00:00", "scraper_version": "1.0.0"}
{"slug": "asparagus-salad-italian-style", "nyt_id": 12597, "url": "https://cooking.nytimes.com/recipes/12597-asparagus-salad-italian-style", "name": "Asparagus Salad, Italian-Style", "author": "Mark Bittman", "description": "Here, raw asparagus is simply dressed with lemon juice, olive oil and Parmesan shavings.", "servings": {"text": "2 to 4 servings", "min": 2, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ to 2 pounds asparagus, not too skinny (fat is fine)", "group": null, "quantity": 1.5, "quantity_max": 2.0, "unit": "lb", "item": "asparagus", "preparation": "not too skinny (fat is fine)", "optional": false}, {"position": 2, "raw": "2 tablespoons olive oil, or to taste", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": "or to taste", "optional": false}, {"position": 3, "raw": "Lemon juice to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "lemon juice to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "Freshly shaved Parmesan to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly shaved parmesan to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut off the woodsy bottoms of the asparagus spears; discard. Cut off the flower ends and set aside."}, {"position": 2, "text": "Use a vegetable peeler to remove the dark green outer skin of each spear; you should get three or four ribbons from each one. Set aside. Cut the remaining stalks crosswise into ¼-inch rounds."}, {"position": 3, "text": "Combine ribbons, sliced rounds and tips in a large bowl. Drizzle asparagus with oil, then sprinkle with lemon juice. Season with salt and pepper, then top with Parmesan."}], "nutrition": null, "tags": {"cuisine": ["italian", "japanese"], "diet": ["gluten-free", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["asparagus", "easy", "five ingredient", "quick", "salad", "spring", "vegetables"]}, "images": [{"url": "https://static01.nyt.com/images/2016/04/18/dining/18COOKING-ASPARAGUSSALAD3/18COOKING-ASPARAGUSSALAD3-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 287}, "video_url": null, "comment_count": null, "published_at": "2012-07-11", "scraped_at": "2026-09-06T23:57:56.922155+00:00", "scraper_version": "1.0.0"}

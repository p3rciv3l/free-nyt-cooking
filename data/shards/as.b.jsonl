{"slug": "asparagus-salad-italian-style", "nyt_id": 12597, "url": "https://cooking.nytimes.com/recipes/12597-asparagus-salad-italian-style", "name": "Asparagus Salad, Italian-Style", "author": "Mark Bittman", "description": "Here, raw asparagus is simply dressed with lemon juice, olive oil and Parmesan shavings.", "servings": {"text": "2 to 4 servings", "min": 2, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ to 2 pounds asparagus, not too skinny (fat is fine)", "group": null, "quantity": 1.5, "quantity_max": 2.0, "unit": "lb", "item": "asparagus", "preparation": "not too skinny (fat is fine)", "optional": false}, {"position": 2, "raw": "2 tablespoons olive oil, or to taste", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": "or to taste", "optional": false}, {"position": 3, "raw": "Lemon juice to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "lemon juice to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "Freshly shaved Parmesan to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly shaved parmesan to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut off the woodsy bottoms of the asparagus spears; discard. Cut off the flower ends and set aside."}, {"position": 2, "text": "Use a vegetable peeler to remove the dark green outer skin of each spear; you should get three or four ribbons from each one. Set aside. Cut the remaining stalks crosswise into ¼-inch rounds."}, {"position": 3, "text": "Combine ribbons, sliced rounds and tips in a large
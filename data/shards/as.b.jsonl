tem": "peanut oil", "preparation": null, "optional": false}, {"position": 10, "raw": "1 tablespoon fresh chopped ginger root", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh chopped ginger root", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Remove duck or chicken meat from bones and shred."}, {"position": 2, "text": "Trim green beans, cut into three-inch lengths."}, {"position": 3, "text": "Fill a large pot with water and bring to boil. Add ½ teaspoon salt and green beans and cook about five minutes. Drain and rinse in cold water."}, {"position": 4, "text": "Peel and halve water chestnuts. Peel and dice mangoes. Chop the scallions. Remove seeds and ribs from pepper and cut into thin strips."}, {"position": 5, "text": "In a large bowl, mix lime juice with oil. Add mango and ginger root. Mix, and add the meat, beans, water chestnuts, scallions and peppers. Mix gently. Season with salt and pepper. Arrange on a large platter."}], "nutrition": {"calories": 645.5, "protein_g": 39.3, "carbohydrates_g": 28.1, "fat_g": 42.9, "saturated_fat_g": 10.8, "trans_fat_g": 0.2, "cholesterol_mg": 150.0, "sodium_mg": 1000.9, "fiber_g": 4.8, "sugar_g": 18.1, "unsaturated_fat_g": 28.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": [], "course": [], "meal": ["dinner"], "occasion": [], "other": ["boil", "duck", "salad"]}, "images": [], "rating": {"average": 5.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1992-03-04", "scraped_at": "2026-09-07T00:32:13.150882+00:00", "scraper_version": "1.0.0"}
{"slug": "asian-marinated-eggplant", "nyt_id": 3371, "url": "https://cooking.nytimes.com/recipes/3371-asian-marinated-eggplant", "name": "Asian Marinated Eggplant", "author": "Barbara Kafka", "description": "", "servings": {"text": "4 side-dish servings", "min": 4, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 18, "raw": {"total": "18 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ cup tamari", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "tamari", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons loosely packed cilantro leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "loosely packed cilantro leaves", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon rice-wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "rice-wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon toasted sesame oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "toasted sesame oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 ½ medium-size cloves garlic, smashed and peeled", "group": null, "quantity": 1.5, "quantity_max": null, "unit": null, "item": "medium-size cloves garlic", "preparation": "smashed and peeled", "optional": false}, {"position": 6, "raw": "⅜ ounce peeled fresh ginger (a 1-by- ¼-inch piece), cut crosswise into ¼-inch slices", "group": null, "quantity": 0.375, "quantity_max": null, "unit": "oz", "item": "peeled fresh ginger (a 1-by- ¼-inch piece)", "preparation": "cut crosswise into ¼-inch slices", "optional": false}, {"position": 7, "raw": "4 medium-size Chinese eggplants (2 ounces each)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "medium-size chinese eggplants (2 ounces each)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine all ingredients, except eggplants, in a blender. Process until smooth."}, {"position": 2, "text": "Prick the eggplants several times with a fork and pull off the leaves. Cut in half lengthwise. On the open side of each half, make three deep diagonal slashes in each direction. Place eggplants skin side down in a 13-by-9-by-2-inch oval dish."}, {"position": 3, "text": "Spoon 1 ½ teaspoons of the marinade over each eggplant half. Rub the marinade into the flesh so that it runs into the cuts. Turn eggplants skin side up. Pour remaining marinade into dish. Let stand for 45 minutes."}, {"position": 4, "text": "Turn eggplants skin side down. Cover tightly with microwave plastic wrap. Cook at 100 percent power in a high-power oven for 10 minutes. Prick plastic to release steam."}, {"position": 5, "text": "Remove from oven and uncover. Spoon sauce over eggplants."}], "nutrition": {"calories": 39.5, "protein_g": 2.6, "carbohydrates_g": 5.2, "fat_g": 1.3, "saturated_fat_g": 0.2, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 1008.2, "fiber_g": 1.9, "sugar_g": 2.4, "unsaturated_fat_g": 1.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": ["dairy-free", "gluten-free", "low-fat", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["easy", "eggplant", "garlic", "ginger", "low calorie", "low cholesterol", "marinate", "microwave"]}, "images": [], "rating": {"average": 4.0, "count": 57}, "video_url": null, "comment_count": null, "published_at": "1992-07-08", "scraped_at": "2026-09-07T00:21:25.120349+00:00", "scraper_version": "1.0.0"}

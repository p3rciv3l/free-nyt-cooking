{"slug": "english-cream-with-dark-rum", "nyt_id": 1267, "url": "https://cooking.nytimes.com/recipes/1267-english-cream-with-dark-rum", "name": "English Cream With Dark Rum", "author": "Pierre Franey", "description": "", "servings": {"text": "3 cups", "min": 3, "max": 3, "yield_type": "volume"}, "time": {"prep_minutes": 10, "cook_minutes": 10, "total_minutes": 20, "raw": {"total": "20 minutes", "prep": "10 minutes", "cook": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "5 egg yolks", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 2, "raw": "⅔ cup sugar", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups milk", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon vanilla", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "vanilla", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon dark rum, kirsch or Cognac, if desired", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dark rum", "preparation": "kirsch or Cognac, if desired", "optional": false}], "steps": [{"position": 1, "text": "Place the yolks in a saucepan and add the sugar. Beat with a wire whisk until thick and lemon colored."}, {"position": 2, "text": "Heat the milk and the vanilla in a saucepan. Do not boil."}, {"position": 3, "text": "Gradually add the milk to the yolks. Cook over medium heat with a wooden spatula, swirling and scraping constantly to keep the mixture moving. Draw your index finger along the back of the spatula. If
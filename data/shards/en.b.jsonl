n": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Trim the tops from the beets, leaving an inch of stalk. Place the beets in the oven on a rack and bake for one-and-a-half to two hours, or until tender when pierced with a fork."}, {"position": 2, "text": "When the beets are cool enough to handle, flip off the skins. Cut the beets into half-inch pieces and place them in a bowl."}, {"position": 3, "text": "Combine the mustard, vinegar and walnut oil. Season to taste with salt and pepper. Toss the beets in three-quarters of the dressing."}, {"position": 4, "text": "Cut four quarter-inch slices off the bottom of the endives. Cut the slices in half vertically and add them to the beets."}, {"position": 5, "text": "Arrange the endive leaves in a circle around the rim of a large plate and pour the remaining dressing on top. Place the beet mixture in the middle and sprinkle with walnuts and chives."}], "nutrition": {"calories": 229.1, "protein_g": 2.5, "carbohydrates_g": 9.9, "fat_g": 20.8, "saturated_fat_g": 1.9, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 297.5, "fiber_g": 3.4, "sugar_g": 5.6, "unsaturated_fat_g": 17.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["bake", "beet", "salad", "walnut", "weeknight", "winter"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1988-02-07", "scraped_at": "2026-09-07T00:07:53.352167+00:00", "scraper_version": "1.0.0"}

{"slug": "english-ginger-snaps", "nyt_id": 1174, "url": "https://cooking.nytimes.com/recipes/1174-english-ginger-snaps", "name": "English Ginger Snaps", "author": "Moira Hodgson", "description": "", "servings": {"text": "About 60 cookies", "min": 60, "max": 60, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "½ cup unsalted butter at room temperature", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "unsalted butter at room temperature", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup white sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "white sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups sifted all-purpose flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sifted all-purpose flour", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon baking soda", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ teaspoons ground ginger", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "ground ginger", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon ground cloves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground cloves", "preparation": null, "optional": false}, {"position": 8, "raw": "½ teaspoon ground cinnamon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 9, "raw": "1 large egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg", "preparation": null, "optional": false}, {"position": 10, "raw": "1 teaspoon white vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "4 tablespoons molasses", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "molasses", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 325 degrees. Cream the butter and the sugar. Sift in the flour with the baking soda and add the salt. Mix together the ginger, cloves and cinnamon and set aside. Beat the egg, vinegar, spice mixture, molasses and flour into the creamed butter."}, {"position": 2, "text": "Using your hands, shape the dough into balls one inch in diameter. Place them an inch apart on a baking sheet. Slightly flatten the balls with the wet prongs of a fork. Press again, with the prongs at right angles to the mark already made on the cookies, making a crosshatch pattern. The cookies should be about one-half inch high. Bake for 18 to 20 minutes."}, {"position": 3, "text": "Let the cookies cool on the baking sheets for five minutes. Then remove them with a spatula and cool on a rack."}], "nutrition": {"calories": 47.2, "protein_g": 0.6, "carbohydrates_g": 7.6, "fat_g": 1.7, "saturated_fat_g": 1.0, "trans_fat_g": 0.0, "cholesterol_mg": 7.2, "sodium_mg": 27.7, "fiber_g": 0.1, "sugar_g": 4.4, "unsaturated_fat_g": 0.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["bake", "easy", "ginger", "molasses", "winter"]}, "images": [], "rating": {"average": 5.0, "count": 203}, "video_url": null, "comment_count": null, "published_at": "1992-12-06", "scraped_at": "2026-09-07T02:34:57.891476+00:00", "scraper_version": "1.0.0"}
{"slug": "english-tea-cart-wafers", "nyt_id": 1211, "url": "https://cooking.nytimes.com/recipes/1211-english-tea-cart-wafers", "name": "English Tea Cart Wafers", "author": "Molly O’Neill", "description": "", "servings": {"text": "24 cookies", "min": 24, "max": 24, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup cool, lightly salted butter, cut into chunks", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "cool", "preparation": "lightly salted butter, cut into chunks", "optional": false}, {"position": 2, "raw": "⅔ cup sugar", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 egg yolks", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 5, "raw": "2 ¼ cups sifted flour", "group": null, "quantity": 2.25, "quantity_max": null, "unit": "cup", "item": "sifted flour", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon baking powder", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup raspberry preserves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "raspberry preserves", "preparation": null, "optional": false}, {"position": 8, "raw": "2 ounces semisweet chocolate", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "oz", "item": "semisweet chocolate", "preparation": null, "optional": false}, {"position": 9, "raw": "2 teaspoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "butter", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons water", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "water", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 375 degrees. Cream together the butter and sugar. Add the egg yolks and the vanilla and beat until smooth. Combine the flour and baking powder. Stir to combine with butter mixture."}, {"position": 2, "text": "Line a cookie sheet with parchment paper. Place dough in a cookie press with a 1-inch bar cookie disc with 3 stripes. Press out dough 2 inches apart. Bake until set, but not brown, 5 to 8 minutes. Transfer cookies to a rack to cool."}, {"position": 3, "text": "Place glaze ingredients in a double boiler over low heat. Stir frequently until chocolate is melted and sugar dissolves. Dip each end of half of the wafers in the glaze. Return to the rack to dry."}, {"position": 4, "text": "Gently spread raspberry preserves on the flat side of each undipped wafer. Top each spread wafer with a chocolate dipped wafer to make a sandwich. Handle very carefully. Do not freeze. Store in a cool place for up to 3 weeks."}], "nutrition": {"calories": 167.6, "protein_g": 1.6, "carbohydrates_g": 20.5, "fat_g": 9.1, "saturated_fat_g": 5.6, "trans_fat_g": 0.3, "cholesterol_mg": 33.3, "sodium_mg": 66.9, "fiber_g": 0.5, "sugar_g": 10.6, "unsaturated_fat_g": 2.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["british"], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["bake", "raspberry preserve", "semisweet chocolate", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 9}, "video_url": null,
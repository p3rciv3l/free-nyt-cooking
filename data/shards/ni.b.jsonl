{"slug": "nick-nethongkomes-thai-style-cucumber-salad", "nyt_id": 2332, "url": "https://cooking.nytimes.com/recipes/2332-nick-nethongkomes-thai-style-cucumber-salad", "name": "Nick Nethongkome's Thai-Style Cucumber Salad", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "About two cups", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 firm, fresh cucumbers, about ¾ pound", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "firm", "preparation": "fresh cucumbers, about ¾ pound", "optional": false}, {"position": 2, "raw": "1 tablespoon finely shredded, trimmed, seeded hot pepper, preferably red", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely shredded", "preparation": "trimmed, seeded hot pepper, preferably red", "optional": false}, {"position": 3, "raw": "¼ cup sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 5, "raw": "5 tablespoons white vinegar", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "5 tablespoons water", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "water", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon shallots sliced as thin as possible", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "shallots sliced as thin as possible", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup chopped fresh coriander", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped fresh coriander", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Trim off the ends of the cucumbers and scrape them. Quarter the cucumbers lengthwise and scrape out the seeds. Cut the cucumbers crosswise into thin slices. There should be about two cups. Put the slices into a mixing bowl and add the pepper."}, {"position": 2, "text": "Combine the sugar, salt, vinegar, water and shallots in a saucepan and bring to the boil. Cook, stirring, until the sugar dissolves."}, {"position": 3, "text": "Pour the sauce over the cucumber mixture and stir. Sprinkle with coriander."}], "nutrition": {"calories": 154.5, "protein_g": 2.2, "carbohydrates_g": 37.3, "fat_g": 0.4, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 957.9, "fiber_g": 1.8, "sugar_g": 30.7, "unsaturated_fat_g": 0.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["thai"], "diet": ["vegan", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["cilantro", "cucumber", "salad", "summer", "vegetables"]}, "images": [], "rating": {"average": 3.0, "count": 36}, "video_url": null, "comment_count": null, "published_at": "1985-04-21", "scraped_at": "2026-09-07T00:10:33.557782+00:00", "scraper_version": "1.0.0"}
{"slug": "nicoise-salad-with-grilled-olive-oil-marinated-tuna", "nyt_id": 9181, "url": "https://cooking.nytimes.com/recipes/9181-nicoise-salad-with-grilled-olive-oil-marinated-tuna", "name": "Nicoise Salad With Grilled, Olive-Oil- Marinated Tuna", "author": "Molly O’Neill", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 12-ounce tuna steak, about 1 inches thick", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "12-ounce tuna steak", "preparation": "about 1 inches thick", "optional": false}, {"position": 2, "raw": "Kosher salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "¾ cup olive oil", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "4 cloves garlic, thinly sliced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "thinly sliced", "optional": false}, {"position": 5, "raw": "1 pound small Yukon Gold potatoes, scrubbed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "small yukon gold potatoes", "preparation": "scrubbed", "optional": false}, {"position": 6, "raw": "½ pound green beans or wax beans, ends trimmed", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "green beans or wax beans", "preparation": "ends trimmed", "optional": false}, {"position": 7, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 8, "raw": "1 clove minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 9, "raw": "1 large tomato, seeded and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large tomato", "preparation": "seeded and chopped", "optional": false}, {"position": 10, "raw": "½ cup chopped parsley", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 11, "raw": "⅓ cup nicoise or other black olives, pitted and sliced", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "nicoise or other black olives", "preparation": "pitted and sliced", "optional": false}], "steps": [{"position": 1, "text": "Prepare a charcoal grill or preheat a broiler. Season the tuna generously with salt and pepper and grill or broil very close to the heat source until it is seared on the outside but still rosy in the center, 3 to 4 minutes per side. Transfer the tuna to a small bowl and add the olive oil and sliced garlic. Cover and refrigerate for at least 6 hours or overnight."}, {"position": 2, "text": "Place the potatoes in a large saucepan and cover with cold, salted water. Bring to a boil, lower the heat and simmer, covered, until tender, about 20 minutes. Drain, cool and slice the potatoes. Set aside."}, {"position": 3, "text": "Bring another large saucepan filled ⅔ full of salted water to a boil and add the beans. Cook until the beans just begin to become tender, about 3 minutes. Drain the beans and immediately plunge them into a large bowl of cold water. When cooled, drain the beans and chop them in half if they are large. Set aside."}, {"position": 4, "text": "Drain the tuna, reserving 5 tablespoons of the olive oil and discarding the rest. Place the reserved oil in a large bowl and whisk in the lemon juice, minced garlic, ½ teaspoon of kosher salt and ¼ teaspoon pepper. Add the potatoes, beans, tomato, parsley and olives. Toss well and season to taste with more salt and pepper. Using a sharp knife, slice the tuna on the bias into thin slices. Lay the slices carefully over the vegetables and serve."}], "nutrition": {"calories": 587.4, "protein_g": 25.1, "carbohydrates_g": 28.6, "fat_g": 42.6, "saturated_fat_g": 6.1, "trans_fat_g": 0.0, "cholesterol_mg": 33.2, "sodium_mg": 840.5, "fiber_g": 5.2, "sugar_g": 4.0, "unsaturated_fat_g": 35.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["fall", "grill", "olive oil", "tuna", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 70}, "video_url": null, "comment_count": null, "published_at": "1998-07-19", "scraped_at": "2026-09-07T01:27:38.865064+00:00", "scraper_version": "1.0.0"}
{"slug": "nicola-civettas-quaglie-giardiniere-quail-gardeners-style", "nyt_id": 5925, "url": "https://cooking.nytimes.com/recipes/5925-nicola-civettas-quaglie-giardiniere-quail-gardeners-style", "name": "Nicola Civetta's Quaglie Giardiniere (Quail Gardener's Style)", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "8 quail", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "quail", "preparation": null, "optional": false}, {"position": 2, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup extra virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 carrot, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "carrot", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "½ pound fresh peas", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "fresh peas", "preparation": null, "optional": false}, {"position": 6, "raw": "1 zucchini, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "zucchini", "preparation": "chopped", "optional": false}, {"position": 7, "raw": "6 mushrooms, chopped", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "mushrooms", "preparation": "chopped", "optional": false}, {"position": 8, "raw": "2 shallots, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "shallots", "preparation": "minced", "optional": false}, {"position": 9, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup dry red wine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry red wine", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup beef broth", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "beef broth", "preparation": null, "optional": false}, {"position": 12, "raw": "2 slices foie gras", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "slice", "item": "foie gras", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Season the quail inside and out with salt and pepper and truss them."}, {"position": 2, "text": "In a large frying pan, lightly saute the birds in the oil until they are golden brown, turning them to be sure they are done on all sides. Remove and keep warm."}, {"position": 3, "text": "Add the carrots and peas and cook for 5 to 10 minutes. Add the zucchini and mushrooms and cook an additional five minutes."}, {"position": 4, "text": "In a separate pan saute the shallots in the butter. Add the wine and the beef broth and reduce to a cup. Add the vegetables and quail. Simmer 10 minutes, uncovered. Stir in the foie gras and mix well."}], "nutrition": {"calories": 1014.6, "protein_g": 52.9, "carbohydrates_g": 20.9, "fat_g": 77.8, "saturated_fat_g": 22.6, "trans_fat_g": 0.5, "cholesterol_mg": 238.7, "sodium_mg": 1293.2, "fiber_g": 5.4, "sugar_g": 8.5, "unsaturated_fat_g": 49.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["saute"]}, "images": [], "rating": {"average": 3.0, "count": 12}, "video_url": null, "comment_count": null, "published_at": "1981-11-25", "scraped_at": "2026-09-07T07:56:
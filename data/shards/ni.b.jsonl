{"slug": "nicole-kaplans-gougeres-served-at-eleven-madison-park", "nyt_id": 7143, "url": "https://cooking.nytimes.com/recipes/7143-nicole-kaplans-gougeres-served-at-eleven-madison-park", "name": "Nicole Kaplan's Gougères (Served at Eleven Madison Park)", "author": "Jonathan Reynolds", "description": "", "servings": {"text": "About 4 1/2 dozen", "min": 54, "max": 54, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 2, "raw": "4 tablespoons softened unsalted butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "softened unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon kosher salt, plus extra for sprinkling", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": "plus extra for sprinkling", "optional": false}, {"position": 4, "raw": "¼ teaspoon cayenne pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cayenne pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup bread flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "bread flour", "preparation": null, "optional": false}, {"position": 6, "raw": "4 large eggs, at room temperature", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "at room temperature", "optional": false}, {"position": 7, "raw": "6 ounces grated Gruyère cheese, plus extra for sprinkling", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "oz", "item": "grated gruyère cheese", "preparation": "plus extra for sprinkling", "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 350 degrees if baking the gougères right away. Bring water, butter, ½ teaspoon salt and the cayenne to a boil in a small saucepan."}, {"position": 2, "text": "Place the flour in the bowl of a mixer, add the boiling water mixture and mix with a paddle, if available (not a whisk), or use a wooden spoon in a bowl. Beat in eggs, one at a time, until the dough is smooth. Beat in the cheese and mix until dough is thick and cheese has pretty much melted. Place the dough in a pastry bag fitted with a medium plain tip."}, {"position": 3, "text": "Line 2 large baking sheets with parchment and pipe the dough in small mounds onto them. Sprinkle each with a pinch of extra grated cheese and kosher salt. Bake 20-25 minutes, until golden brown and puffed about 3 times their original size. Try not to open the oven door for the first 10-12 minutes to keep them from deflating. Serve and eat IMMEDIATELY!"}], "nutrition": {"calories": 35.0, "protein_g": 1.7, "carbohydrates_g": 1.9, "fat_g": 2.3, "saturated_fat_g": 1.2, "trans_fat_g": 0.0, "cholesterol_mg": 19.5, "sodium_mg": 34.5, "fiber_g": 0.1, "sugar_g": 0.0, "unsaturated_fat_g": 0.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["appetizer", "side dish"], "meal": [], "occasion": [], "other": ["bake", "boil", "bread flour", "butter", "egg", "five ingredient", "gruyere"]}, "images": [], "rating": {"average": 4.0, "count": 54}, "video_url": null, "comment_count": null, "published_at": "2001-09-30", "scraped_at": "2026-09-07T08:55:47.972392+00:00", "scraper_version": "1.0.0"}
{"slug": "nifty-dulce-de-leche-semi-frio", "nyt_id": 1888, "url": "https://cooking.nytimes.com/recipes/1888-nifty-dulce-de-leche-semi-frio", "name": "Nifty (Dulce de Leche Semi-frío)", "author": "Oliver Schwaner-Albright", "description": "", "servings": {"text": "Serves 6", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes, plus freezing"}}, "ingredients": [{"position": 1, "raw": "2 teaspoons (about 1 ¼ -ounce envelope) unflavored gelatin powder", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "(about 1 ¼ -ounce envelope) unflavored gelatin powder", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ¼ cups heavy cream", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup dulce de leche, at room temperature", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dulce de leche", "preparation": "at room temperature", "optional": false}, {"position": 4, "raw": "½ cup toasted almonds, finely chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "toasted almonds", "preparation": "finely chopped", "optional": false}], "steps": [{"position": 1, "text": "Pour the gelatin into a bowl. In a saucepan, heat ¼ cup of the cream until steaming and add to the gelatin. Mix and let stand for 5 minutes."}, {"position": 2, "text": "Place the dulce de leche in a large bowl and whisk for 1 minute. Strain the gelatin mixture into the dulce de leche and whisk to incorporate."}, {"position": 3, "text": "In a medium bowl, beat the remaining cup of cold cream with an electric hand mixer until it holds soft peaks. Fold a third of the beaten cream into the dulce de leche to incorporate and fold in the remaining cream. Pour into 6 -cup ramekins or muffin cups and freeze until solid."}, 
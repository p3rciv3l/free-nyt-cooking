{"slug": "nigella-lawsons-red-cabbage", "nyt_id": 9098, "url": "https://cooking.nytimes.com/recipes/9098-nigella-lawsons-red-cabbage", "name": "Nigella Lawson's Red Cabbage", "author": "Nigella Lawson", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 140, "total_minutes": 140, "raw": {"cook": "2 hours 20 minutes", "total": "2 hours 20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 onion, peeled, halved and thinly sliced into half-moons", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "onion", "preparation": "peeled, halved and thinly sliced into half-moons", "optional": false}, {"position": 3, "raw": "Scant tablespoon Maldon salt (available at specialty food stores), or more as desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "scant tablespoon maldon salt (available at specialty food stores)", "preparation": "or more as desired", "optional": false}, {"position": 4, "raw": "1 red cabbage, finely shredded (about 10 cups, loosely packed)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red cabbage", "preparation": "finely shredded (about 10 cups, loosely packed)", "optional": false}, {"position": 5, "raw": "3 tablespoons light brown sugar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups red wine", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "red wine", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup freshly squeezed orange juice", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "freshly squeezed orange juice", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon allspice, or more as desired", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "allspice", "preparation": "or more as desired", "optional": false}, {"position": 9, "raw": "2 apples", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "apples", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place a large heavy-bottom saucepan or casserole over medium-low heat, and add oil. When oil is hot, add onion and salt. Sauté gently until onion is softened but not colored."}, {"position": 2, "text": "Add cabbage to pan on top of onion. Sprinkle sugar over cabbage; add wine, orange juice and allspice. Peel, core and finely chop apples, and add to pan. Cover, and let mixture steam until cabbage is wilted, about 10 minutes."}, {"position": 3, "text": "Gently stir to mix all ingredients; cover and reduce heat to its lowest possible setting. Cook about 2 hours, and adjust salt and allspice as desired. Serve hot, or allow to cool to room temperature and refrigerate overnight. (The flavors improve with reheating.)"}], "nutrition": {"calories": 137.7, "protein_g": 0.6, "carbohydrates_g": 18.8, "fat_g": 2.4, "saturated_fat_g": 0.3, "unsaturated_fat_g": null, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 399.2, "fiber_g": 1.9, "sugar_g": 13.8, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": ["asian"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["fall", "light brown sugar", "red cabbage", "red wine", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 125}, "video_url": null, "comment_count": null, "published_at": "2003-03-19", "scraped_at": "2026-09-07T11:09:52.097399+00:00", "scraper_version": "1.0.0"}
{"slug": "nina-balducci", "nyt_id": 9987, "url": "https://cooking.nytimes.com/recipes/9987-nina-balducci", "name": "Nina Balducci", "author": "Marian Burros", "description": "Marian Burros", "servings": {"text": "10 to 12 servings", "min": 10, "max": 12, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 30, "total_minutes": 30, "raw": {"cook": "30 minutes, plus refrigeration", "total": "30 minutes, plus refrigeration"}}, "ingredients": [{"position": 1, "raw": "24 Italian ladyfingers (see note with Il Cantinori recipe for tiramis u)", "group": null, "quantity": 24.0, "quantity_max": null, "unit": null, "item": "italian ladyfingers (see note with il cantinori recipe for tiramis u)", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ cups espresso, cooled", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "espresso", "preparation": "cooled", "optional": false}, {"position": 3, "raw": "6 eggs, separated", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "separated", "optional": false}, {"position": 4, "raw": "3 tablespoons sugar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 pound mascarpone", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "mascarpone", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons each Marsala, triple sec and brandy", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "each marsala", "preparation": "triple sec and brandy", "optional": false}, {"position": 7, "raw": "1 teaspoon orange extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "orange extract", "preparation": null, "optional": false}, {"position": 8, "raw": "8 ounces bittersweet chocolate, chopped", "group": null, "quantity": 8.0, "quantity_max": n
{"slug": "ninh-hoah-skewered-vietnamese-meatballs", "nyt_id": 9552, "url": "https://cooking.nytimes.com/recipes/9552-ninh-hoah-skewered-vietnamese-meatballs", "name": "Ninh Hoah (Skewered Vietnamese Meatballs)", "author": "Molly O’Neill", "description": "", "servings": {"text": "6 first-course servings", "min": 6, "max": 6, "yield_type": "other"}, "time": {"prep_minutes": null, "cook_minutes": 20, "total_minutes": 20, "raw": {"cook": "20 minutes", "total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound ground pork", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "ground pork", "preparation": null, "optional": false}, {"position": 2, "raw": "½ teaspoon freshly ground pepper", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "freshly ground pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "3 stalks lemongrass, tough outer leaves discarded and ends trimmed, minced", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "stalk", "item": "lemongrass", "preparation": "tough outer leaves discarded and ends trimmed, minced", "optional": false}, {"position": 4, "raw": "6 cloves garlic, minced", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 5, "raw": "2 medium shallots, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium shallots", "preparation": "minced", "optional": false}, {"position": 6, "raw": "1 tablespoon granulated sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "2 ½ teaspoons cornstarch", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "tsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon fish sauce", "group": null, "quantity": 1.0, "quan
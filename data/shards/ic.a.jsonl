{"slug": "ice-cream-sundaes-with-maple-butter-rum-sauce-and-walnuts", "nyt_id": 1013792, "url": "https://cooking.nytimes.com/recipes/1013792-ice-cream-sundaes-with-maple-butter-rum-sauce-and-walnuts", "name": "Ice Cream Sundaes With Maple Butter Rum Sauce and Walnuts", "author": "Melissa Clark", "description": "A delectable concoction of maple syrup, butter, rum and walnuts takes an everyday ice cream sundae to a whole new level. Let the syrup cool a bit before assembling the sundaes, or you’ll end up with a soupy mess. But who’s to say that’s a bad thing?", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 10, "total_minutes": 15, "raw": {"cook": "PT10M", "total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "½ cup plus 2 tablespoons maple syrup, preferably grade B", "group": null, "quantity": 0.5, "unit": "cup", "item": "plus 2 tablespoons maple syrup", "preparation": "preferably grade B", "optional": false}, {"position": 2, "raw": "½ cup light brown sugar", "group": null, "quantity": 0.5, "unit": "cup", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup heavy cream", "group": null, "quantity": 0.5, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup (4 tablespoons) unsalted butter", "group": null, "quantity": 0.25, "unit": "cup", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon dark rum", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "dark rum", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "⅓ cup toasted walnuts", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "toasted walnuts", "preparation": null, "optional": false}, {"position": 8, "raw": "1 pint maple, ginger, vanilla chocolate chip or other ice cream", "group": null, "quantity": 1.0, "unit": "pint", "item": "maple", "preparation": "ginger, vanilla chocolate chip or other ice cream", "optional": false}, {"position": 9, "raw": "Extra-bitter chocolate, for serving", "group": null, "quantity": null, "unit": null, "item": "extra-bitter chocolate", "preparation": "for serving", "optional": false}, {"position": 10, "raw": "Crème fraîche, lightly whipped optional", "group": null, "quantity": null, "unit": null, "item": "crème fraîche", "preparation": "lightly whipped optional", "optional": true}], "steps": [{"position": 1, "text": "In a small heavy-bottomed pot, over medium-low heat, stir together ½ cup of the maple syrup, the brown sugar, cream, butter, rum and salt. Cook, stirring constantly and scraping the sides and the bottom of the pan, until the sauce is thick and coats the back of the spoon, about 10 minutes. Pour into a heat-proof container and let cool a bit before making the sundaes."}, {"position": 2, "text": "In a small bowl, combine the remaining maple syrup with the nuts. Scoop the ice cream into dishes. Top with the warm sauce and maple nuts. Grate some of the chocolate over the top and serve with a dollop of crème fraîche and more chocolate shavings if you like."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 1047.75, "protein_g": 8.0, "carbohydrates_g": 131.3, "fat_g": 55.8, "saturated_fat_g": 31.3, "unsaturated_fat_g": 5.6, "trans_fat_g": 0.6, "cholesterol_mg": 80.9, "sodium_mg": 242.8, "fiber_g": 3.8, "sugar_g": 120.0, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert-ice-creams-and-sorbets"], "meal": [], "occasion": [], "other": ["ice-cream", "maple-syrup", "quick", "summer"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "2011-08-17", "scraped_at": "2026-09-07T02:01:43Z", "scraper_version": "1.0.0"}

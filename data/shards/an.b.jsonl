{"slug": "angel-hair-pasta-with-vegetables-and-cheese", "nyt_id": 3974, "url": "https://cooking.nytimes.com/recipes/3974-angel-hair-pasta-with-vegetables-and-cheese", "name": "Angel-Hair Pasta With Vegetables and Cheese", "author": "Marian Burros", "description": "", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": 15, "cook_minutes": 20, "total_minutes": 35, "raw": {"total": "35 minutes", "prep": "15 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ pound mushrooms", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "mushrooms", "preparation": null, "optional": false}, {"position": 2, "raw": "1 pound broccoli", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "broccoli", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup low-fat cottage cheese", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "low-fat cottage cheese", "preparation": null, "optional": false}, {"position": 5, "raw": "¾ cup nonfat yogurt", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "nonfat yogurt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups canned Italian plum tomatoes", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "canned italian plum tomatoes", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon dried oregano", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "dried oregano", "preparation": null, "optional": false}, {"position": 8, "raw": "½ teaspoon dried basil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "dried basil", "preparation": null, "optional": false}, {"position": 9, "raw": "8 ounces fresh angel-hair pasta", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "fresh angel-hair pasta", "preparation": null, "optional": false}, {"position": 10, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup freshly grated Parmigiano Reggiano", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "freshly grated parmigiano reggiano", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring 3 quarts of water to boil in a covered pot."}, {"position": 2, "text": "Wash, trim and slice mushrooms."}, {"position": 3, "text": "Wash broccoli and remove tough stems. Cut remaining stems into thin slices and break up the florets."}, {"position": 4, "text": "Heat the oil in a skillet and cook mushrooms and broccoli, covered, over medium-high heat for 5 minutes."}, {"position": 5, "text": "Proces cottage cheese and yogurt in food processor until smooth."}, {"position": 6, "text": "Break up tomatoes with your fingers and add to the vegetables with the oregano and basil. Cover and continue cooking over medium heat until broccoli is softened but still crisp."}, {"position": 7, "text": "Cook pasta in boiling water for about 30 seconds; drain."}, {"position": 8, "text": "Remove sauce from heat; stir in cottage-cheese mixture and pour over pasta. Season with black pepper. Serve with grated cheese."}], "nutrition": {"calories": 755.1, "protein_g": 43.0, "carbohydrates_g": 96.6, "fat_g": 24.2, "saturated_fat_g": 6.5, "trans_fat_g": 0.1, "cholesterol_mg": 107.4, "sodium_mg": 664.8, "fiber_g": 8.5, "sugar_g": 18.4, "unsaturated_fat_g": 15.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["low-fat", "vegetarian"], "course": ["main cou
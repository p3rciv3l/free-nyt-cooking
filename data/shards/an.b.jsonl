{"slug": "an-american-vegetable-soup", "nyt_id": 2132, "url": "https://cooking.nytimes.com/recipes/2132-an-american-vegetable-soup", "name": "An American Vegetable Soup", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "About 14 cups", "min": 14, "max": 14, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "½ pound leeks", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "leeks", "preparation": null, "optional": false}, {"position": 2, "raw": "½ pound celery", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "celery", "preparation": null, "optional": false}, {"position": 3, "raw": "½ pound green beans", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "green beans", "preparation": null, "optional": false}, {"position": 4, "raw": "½ pound carrots", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "carrots", "preparation": null, "optional": false}, {"position": 5, "raw": "1 to 2 zucchini, about ½ pound", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": null, "item": "zucchini", "preparation": "about ½ pound", "optional": false}, {"position": 6, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup finely chopped onions", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "finely chopped onions", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup crushed red ripe fresh tomatoes or use canned, preferably imported", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "crushed red ripe fresh tomatoes or use canned", "preparation": "preferably imported", "optional": false}, {"position": 9, "raw": "8 cups beef broth", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "cup", "item": "beef broth", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 11, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 12, "raw": "1 ½ cups fresh corn kernels, scraped from the cob", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "fresh corn kernels", "preparation": "scraped from the cob", "optional": false}, {"position": 13, "raw": "2 cups freshly shelled green peas", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "freshly shelled green peas", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ cup chopped fresh basil or parsley", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped fresh basil or parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Trim off the root end of the leeks. Split the leeks in half and rinse well between the leaves. Pat dry. Cut the leeks into very small dice. There should be about two cups."}, {"position": 2, "text": "Trim the celery and cut it into small dice. There should be about two cups."}, {"position": 3, "text": "Trim off the ends of the green beans and cut them into small dice. There should be about two cups."}, {"position": 4, "text": "Trim and scrape the carrots. Cut them into one-quarter-inch slices. Stack the slices and cut them into one-quarter-inch strips. Cut the strips into one-quarter-inch dice. There should be about one and one-half cups."}, {"position": 5, "text": "Trim the ends of the zucchini and cut the zucchini into one-half-inch dice. There should be about two cups."}, {"position": 6, "text": "Heat the butter in a kettle and add the onions and leeks. Cook, stirring, about five minutes. Add the carrots, celery and green beans. Cook, stirring, about three minutes and stir in the crushed tomatoes."}, {"position": 7, "text": "Add the broth, salt and pepper and bring to the boil. Let simmer 20 minutes. Add the zucchini, corn and peas and continue cooking about 10 minutes longer. Serve sprinkled with basil or parsley."}], "nutrition": {"calories": 236.8, "protein_g": 13.3, "carbohydrates_g": 38.6, "fat_g": 5.4, "saturated_fat_g": 2.7, "trans_fat_g": 0.0, "cholesterol_mg": 10.2, "sodium_mg": 1515.8, "fiber_g": 8.7, "sugar_g": 13.4, "unsaturated_fat_g": 2.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["beef broth", "boil", "great leftovers", "saute", "soup", "summer"]}, "images": [], "rating": {"average": 4.0, "count": 57}, "video_url": null, "comment_count": null, "published_at": "1985-07-07", "scraped_at": "2026-09-07T00:08:14.004375+00:00", "scraper_version": "1.0.0"}
{"slug": "angel-hair-with-prosciutto-and-wild-mushrooms", "nyt_id": 3204, "url": "https://cooking.nytimes.com/recipes/3204-angel-hair-with-prosciutto-and-wild-mushrooms", "name": "Angel Hair With Prosciutto And Wild Mushrooms", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "About 30 minutes"}}, "ingredients": [{"position": 1, "raw": "½ pound wild mushrooms such as shiitake, morels or oyster mushrooms or an equal weight of cultivated mushrooms", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "wild mushrooms such as shiitake", "preparation": "morels or oyster mushrooms or an equal weight of cultivated mushrooms", "optional": false}, {"position": 2, "raw": "6 plum tomatoes, about ¾ pound", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "plum tomatoes", "preparation": "about ¾ pound", "optional": false}, {"position": 3, "raw": "¼ pound thinly sliced prosciutto", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "thinly sliced prosciutto", "preparation": null, "optional": false}, {"position": 4, "raw": "½ pound snow pea pods", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "snow pea pods", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "Salt to taste if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste if desired", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon finely chopped jalapeno peppers, optional", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely chopped jalapeno peppers", "preparation": null, "optional": true}, {"position": 10, "raw": "1 sprig fresh rosemary or ½ teaspoon dried", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "fresh rosemary or ½ teaspoon dried", "preparation": null, "optional": false}, {"position": 11, "raw": "½ pound angel hair (capellini) pasta or vermicelli", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "angel hair (capellini) pasta or vermicelli", "preparation": null, "optional": false}, {"position": 12, "raw": "1 ½ cups heavy cream", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ cup freshly grated Parmesan cheese, plus additional cheese to be served on the side", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "freshly grated parmesan cheese", "preparation": "plus additional cheese to be served on the side", "optional": false}, {"position": 15, "raw": "½ cup shredded fresh basil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "shredded fresh basil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Rinse the mushrooms and pat them dry. Cut off and reserve the stems. Cut the caps into thin strips. There should be about 4 cups of caps and stems combined."}, {"position": 2, "text": "Core the tomatoes and cut into ½-inch cubes."}, {"position": 3, "text": "Cut the prosciutto into very thin strips. There should be about 1 ½ cups."}, {"position": 4, "text": "Pull off, if necessary, any tough ''strings'' from the pea pods. There should be about 2 cups of pea pods. Put them in a saucepan and add water to cover. Bring to the boil and simmer one minute. Drain."}, {"position": 5, "text": "Meanwhile, heat the oil in a large, heavy casserole and add the mushrooms, salt and pepper. Cook, stirring, about 3 minutes and add the garlic, jalapeno peppers and prosciutto. Cook, stirring, about one minute. Add the rosemary."}, {"position": 6, "text": "Add the capellini to 3 quarts of boiling water and stir so that the strands are submerged. Cook about four minutes or to the desired degree of doneness. Reserve ½ cup of the cooking liquid. Drain the pasta."}, {"position": 7, "text": "Add the tomatoes to the mushroom mixture and stir. Add the cream and bring to a boil. Add the pasta, pea pods and reserved pasta cooking liquid to the casserole and stir. Add the butter, ¼ cup Parmesan cheese and shredded basil and toss to blend. Serve with additional Parmesan cheese on the side."}], "nutrition": {"calories": 839.1, "protein_g": 24.4, "carbohydrates_g": 58.2, "fat_g": 58.1, "saturated_fat_g": 28.6, "trans_fat_g": 1.1, "cholesterol_mg": 144.1, "sodium_mg": 953.0, "fiber_g": 6.2, "sugar_g": 9.4, "unsaturated_fat_g": 25.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["boil", "mushroom", "pasta", "pastas", "prosciutto", "saute"]}, "images": [], "rating": {"average": 5.0, "count": 53}, "video_url": null, "comment_count": null, "published_at": "1987-07-29", "scraped_at": "2026-09-07T00:19:26.667156+00:00", "scraper_version": "1.0.0"}

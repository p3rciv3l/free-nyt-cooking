lse}, {"position": 8, "raw": "¼ pounds of dried navy beans", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "of dried navy beans", "preparation": null, "optional": false}, {"position": 9, "raw": "1 pound bacon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "bacon", "preparation": null, "optional": false}, {"position": 10, "raw": "5 large onions, peeled and chopped", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "large onions", "preparation": "peeled and chopped", "optional": false}, {"position": 11, "raw": "⅔ cup minced garlic", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 12, "raw": "¼ cup toasted coriander seeds, ground", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "toasted coriander seeds", "preparation": "ground", "optional": false}, {"position": 13, "raw": "¼ cup toasted cumin seeds, ground", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "toasted cumin seeds", "preparation": "ground", "optional": false}, {"position": 14, "raw": "¼ cup ground cinnamon", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 15, "raw": "¼ cup paprika", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "paprika", "preparation": null, "optional": false}, {"position": 16, "raw": "¼ cup cayenne pepper, or to taste", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "cayenne pepper", "preparation": "or to taste", "optional": false}, {"position": 17, "raw": "½ cup ground dried poblano chili peppers", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "ground dried poblano chili peppers", "preparation": null, "optional": false}, {"position": 
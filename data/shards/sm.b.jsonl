{"slug": "smoked-salmon-with-creamed-spinach-and-poached-egg", "nyt_id": 10480, "url": "https://cooking.nytimes.com/recipes/10480-smoked-salmon-with-creamed-spinach-and-poached-egg", "name": "Smoked Salmon With Creamed Spinach and Poached Egg", "author": "Marian Burros", "description": "", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes, plus up to 24 hours' refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 pint heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 2, "raw": "2 10-ounce bags fresh spinach", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "10-ounce bags fresh spinach", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt, pepper and nutmeg to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": "pepper and nutmeg to taste", "optional": false}, {"position": 5, "raw": "10 eggs", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon white vinegar, approximately", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "white vinegar", "preparation": "approximately", "optional": false}, {"position": 7, "raw": "10 slices smoked salmon", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "slice", "item": "smoked salmon", "preparation": null, "optional": false}, {"position": 8, "raw": "10 sprigs dill", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "sprig", "item": "dill", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Simmer cream to reduce by half."}, {"position": 2, "text": "Wash spinach and steam in water that clings to leaves until done, five to seven minutes. Let drain thoroughly, pressing to remove moisture. Puree. Return to heat with butter and seasonings to taste. Stir in cream. Set aside."}, {"position": 3, "text": "Poach eggs in water to cover with white vinegar. Butter pan so eggs will not stick. Plunge eggs into cold water to stop cooking. Trim off uneven edges. Set aside. These can be stored up to 24 hours in cold water in the refrigerator. To serve, bring eggs to room temperature and reheat in hot, not boiling, water."}, {"position": 4, "text": "Reheat spinach."}, {"position": 5, "text": "On each plate, arrange spinach with a slice of salmon, an egg and a sprig of dill."}], "nutrition": {"calories": 301.4, "protein_g": 13.8, "carbohydrates_g": 5.0, "fat_g": 25.7, "saturated_fat_g": 14.5, "trans_fat_g": 0.6, "cholesterol_mg": 226.5, "sodium_mg": 424.6, "fiber_g": 1.8, "sugar_g": 1.8, "unsaturated_fat_g": 9.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["nordic"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["boil", "egg", "poach", "smoked salmon", "spinach", "steam"]}, "images": [], "rating": {"average": 3.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "1982-10-24", "scraped_at": "2026-09-06T22:25:40.318699+00:00", "scraper_version": "1.0.0"}
{"slug": "smoked-scallop-and-celery-root-salad", "nyt_id": 3911, "url": "https://cooking.nytimes.com/recipes/3911-smoked-scallop-and-celery-root-salad", "name": "Smoked Scallop and Celery Root Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 small celery roots, trimmed and peeled", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small celery roots", "preparation": "trimmed and peeled", "optional": false}, {"position": 2, "raw": "2 tablespoons fresh lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 3, "raw": "2 teaspoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ teaspoons salt", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "½ pound smoked scallops", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "smoked scallops", "preparation": null, "optional": false}, {"position": 7, "raw": "4 teaspoons chopped Italian parsley", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "chopped italian parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Coarsely grate 1 celery root and julienne the other. Bring a medium-size pot of water to a boil and blanch the julienned celery root until tender, about 2 minutes. Drain. Whisk together the lemon juice, olive oil, salt and pepper. Toss ⅔ of the lemon mixture with the grated celery root and the rest with the julienned one."}, {"position": 2, "text": "Divide the grated celery root among 4 plates, mounding it in the center. Arrange the julienned celery root around it. Top with the scallops and sprinkle with parsley. Serve immediately."}], "nutrition": {"calories": 86.7, "protein_g": 7.8, "carbohydrates_g": 8.0, "fat_g": 2.7, "saturated_fat_g": 0.4, "trans_fat_g": 0.0, "cholesterol_mg": 13.6, "sodium_mg": 294.7, "fiber_g": 1.2, "sugar_g": 1.1, "unsaturated_fat_g": 2.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free"], "course": ["appetizer"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["boil", "five ingredient", "quick", "salad", "scallop"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1994-10-16", "scraped_at": "2026-09-07T00:27:18.683913+00:00", "scraper_version": "1.0.0"}

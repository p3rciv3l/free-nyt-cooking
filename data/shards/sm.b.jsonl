": [{"position": 1, "text": "Whisk the vinegar and mustard together in a small bowl. Slowly whisk in the olive oil. Add the salt, pepper and rosemary. Toss all but 1 tablespoon of the dressing with the arugula. Divide among 2 or 4 plates. Arrange the smoked vegetables over the arugula and drizzle with the remaining dressing. Serve immediately."}], "nutrition": {"calories": 187.4, "protein_g": 6.6, "carbohydrates_g": 22.4, "fat_g": 8.1, "saturated_fat_g": 1.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 555.6, "fiber_g": 7.1, "sugar_g": 1.3, "unsaturated_fat_g": 6.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["appetizer", "side dish"], "meal": [], "occasion": [], "other": ["arugula", "fall", "salad", "smoke"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1994-10-09", "scraped_at": "2026-09-07T00:25:42.854947+00:00", "scraper_version": "1.0.0"}
{"slug": "smokey-roasted-eggplants-peppers-and-goat-cheese", "nyt_id": 3789, "url": "https://cooking.nytimes.com/recipes/3789-smokey-roasted-eggplants-peppers-and-goat-cheese", "name": "Smokey Roasted Eggplants, Peppers and Goat Cheese", "author": "Joanna Pruess", "description": "", "servings": {"text": "Six to eight servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 ½ pounds Japanese eggplant, cut into ½-inch slices lengthwise but left attached at the stem", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "lb", "item": "japanese eggplant", "preparation": "cut into ½-inch slices lengthwise but left attached at the stem", "optional": false}, {"position": 2, "raw": "Olive oil", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 medium red pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium red pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 medium yellow pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium yellow pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "4 thin slices red onion, separated into rings", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "thin slices red onion", "preparation": "separated into rings", "optional": false}, {"position": 6, "raw": "4 ounces crumbly goat cheese", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "crumbly goat cheese", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons balsamic vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon fresh thyme leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "fresh thyme leaves", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons chopped flat-leaf parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped flat-leaf parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat your barbecue or broiler until hot. Position the rack about four inches from the heat."}, {"position": 2, "text": "Brush the eggplant slices liberally with olive oil on both sides. Place them directly on the grill or under the broiler and cook until the eggplant is tender and lightly browned. Turn once. Watch carefully so they do not burn. Remove and set them aside on paper towels to cool slightly."}, {"position": 3, "text": "Place the whole peppers on the hot grill, turning until the skin is completely charred. Place the charred peppers in a brown paper bag and close. Allow the peppers to steam for about 10 minutes. Remove and scrape off the charred skin, seeds and membranes, and slice into one-inch strips."}, {"position": 4, "text": "Remove the stems from the eggplant. Arrange the eggplant slices, pepper strips and onion rings in a shallow bowl. Crumble the goat cheese on top."}, {"position": 5, "text": "In a small bowl, whisk together the balsamic vinegar, olive oil, thyme, and salt and pepper. Drizzle it over the eggplant mixture. Sprinkle on the parsley and serve either warm or at room temperature. Add extra vinegar if needed."}], "nutrition": {"calories": 205.6, "protein_g": 4.6, "carbohydrates_g": 12.3, "fat_g": 16.4, "saturated_fat_g": 3.9, "trans_fat_g": 0.0, "cholesterol_mg": 6.5, "sodium_mg": 505.3, "fiber_g": 5.1, "sugar_g": 6.4, "unsaturated_fat_g": 11.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "vegetarian"], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["bell pepper", "broil", "eggplant", "goat cheese", "grill", "steam"]}, "images": [], "rating": {"average": 4.0, "count": 14}, "video_url": null, "comment_count": null, "published_at": "1989-06-18", "scraped_at": "2026-09-07T00:25:17.306690+00:00", "scraper_version": "1.0.0"}

", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Rub the eggplant with the olive oil and sprinkle generously with salt and pepper. Grill over medium-high heat until golden brown, 3 to 4 minutes a side. Remove from heat and cut into medium dice."}, {"position": 2, "text": "In a skillet, heat the vegetable oil over medium-high heat until hot but not smoking. Add the onion and cook, stirring occasionally, until slightly colored, 6 to 8 minutes. Add the eggplant, sugar, vinegar and salt and pepper to taste and cook, stirring frequently, for 3 minutes. Add cilantro and serve."}], "nutrition": {"calories": 192.7, "protein_g": 1.6, "carbohydrates_g": 16.7, "fat_g": 14.0, "saturated_fat_g": 1.4, "trans_fat_g": 0.1, "cholesterol_mg": 0.0, "sodium_mg": 441.9, "fiber_g": 4.6, "sugar_g": 12.2, "unsaturated_fat_g": 12.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["indian"], "diet": ["dairy-free"], "course": ["side dish"], "meal": ["dinner"], "occasion": [], "other": ["cider vinegar", "cilantro", "easy", "eggplant", "five ingredient", "grill", "saute", "summer", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2014/03/28/dining/chutney/chutney-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 271}, "video_url": null, "comment_count": null, "published_at": "2012-08-22", "scraped_at": "2026-09-06T23:59:28.123074+00:00", "scraper_version": "1.0.0"}

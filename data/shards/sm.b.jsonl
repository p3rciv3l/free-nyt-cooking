{"slug": "smelts-with-deep-fried-parsley", "nyt_id": 10481, "url": "https://cooking.nytimes.com/recipes/10481-smelts-with-deep-fried-parsley", "name": "Smelts With Deep-Fried Parsley", "author": "Marian Burros", "description": "", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes, plus several hours' marination"}}, "ingredients": [{"position": 1, "raw": "10 smelts, whole, butterflied with center bone removed", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "smelts", "preparation": "whole, butterflied with center bone removed", "optional": false}, {"position": 2, "raw": "1 to 1 ½ cups light cream", "group": null, "quantity": 1.0, "quantity_max": 1.5, "unit": "cup", "item": "light cream", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons Worcestershire sauce", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "worcestershire sauce", "preparation": null, "optional": false}, {"position": 4, "raw": "10 teaspoons chopped dill", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "tsp", "item": "chopped dill", "preparation": null, "optional": false}, {"position": 5, "raw": "Rye flour", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "rye flour", "preparation": null, "optional": false}, {"position": 6, "raw": "5 tablespoons salted butter, approximately", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "salted butter", "preparation": "approximately", "optional": false}, {"position": 7, "raw": "10 large sprigs parsley", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "large sprigs parsley", "preparation": null, "optional": false}, {"position": 8, "raw": "Vegetable oil for deep frying", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "vegetable oil for deep frying", "preparation": null, "optional": false}, {"position": 9, "raw": "10 lemon wedges", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "lemon wedges", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Marinate smelts for several hours in refrigerator in mixture of cream and Worcestershire sauce. When ready to cook, place one teaspoon chopped dill in center of each fillet; close up and dip in flour. Saute in butter until brown."}, {"position": 2, "text": "Remove stems from parsley. Deep fry in hot oil for five seconds. Drain."}, {"position": 3, "text": "Serve each smelt with deep-fried parsley and lemon wedge."}], "nutrition": {"calories": 204.4, "protein_g": 0.9, "carbohydrates_g": 3.0, "fat_g": 21.6, "saturated_fat_g": 9.8, "trans_fat_g": 0.3, "cholesterol_mg": 48.4, "sodium_mg": 123.1, "fiber_g": 0.3, "sugar_g": 1.6, "unsaturated_fat_g": 10.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["nordic"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["deep fry", "marinate", "parsley", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 15}, "video_url": null, "comment_count": null, "published_at": "1982-10-24", "scraped_at": "2026-09-06T22:25:43.574732+00:00", "scraper_version": "1.0.0"}
{"slug": "smoked-autumn-vegetables", "nyt_id": 3811, "url": "https://cooking.nytimes.com/recipes/3811-smoked-autumn-vegetables", "name": "Smoked Autumn Vegetables", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons wood chips", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "wood chips", "preparation": null, "optional": false}, {"position": 2, "raw": "½ medium butternut squash, peeled, seeded and cut lengthwise into ½-inch-thick slices", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "medium butternut squash", "preparation": "peeled, seeded and cut lengthwise into ½-inch-thick slices", "optional": false}, {"position": 3, "raw": "2 medium sweet potatoes, peeled and cut into ½-inch-thick rounds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium sweet potatoes", "preparation": "peeled and cut into ½-inch-thick rounds", "optional": false}, {"position": 4, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "6 shallots, peeled", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "shallots", "preparation": "peeled", "optional": false}, {"position": 6, "raw": "2 portobello mushrooms, stemmed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "portobello mushrooms", "preparation": "stemmed", "optional": false}, {"position": 7, "raw": "4 cremini mushrooms, stemmed", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "cremini mushrooms", "preparation": "stemmed", "optional": false}], "steps": [{"position": 1, "text": "Place half of the wood chips in the bottom of a stove-top smoker and place the squash and sweet potatoes on the rack over the chips. Season lightly with salt and pepper. Place over medium heat until the wood begins to smolder. Cover and cook until tender, about 30 minutes."}, {"position": 2, "text": "Remove the vegetables from the rack and keep warm. Add the remaining wood chips to the smoker. Place the shallots and mushrooms on the rack, season, cover and cook until tender, about 40 minutes. Thinly slice all of the vegetables and serve."}], "nutrition": {"calories": 160.4, "protein_g": 5.0, "carbohydrates_g": 37.7, "fat_g": 0.4, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 616.2, "fiber_g": 6.8, "sugar_g": 12.2, "unsaturated_fat_g": 0.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["butternut squash", "mushroom", "smoke", "sweet potato"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1994-10-09", "scraped_at": "2026-09-07T00:25:39.414913+00:00", "scraper_version": "1.0.0"}
{"slug": "smoked-catfish-salad", "nyt_id": 12138, "url": "https://cooking.nytimes.com/recipes/12138-smoked-catfish-salad", "name": "Smoked Catfish Salad", "author": "Dana Bowen", "description": "Dana Bowen", "servings": {"text": "At least 5 appetizer portions", "min": 5, "max": 5, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 teaspoons hickory- or alder-wood shavings", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "hickory- or alder-wood shavings", "preparation": null, "optional": false}, {"position": 2, "raw": "3 pounds catfish fillets", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "catfish fillets", "preparation": null, "optional": false}, {"position": 3, "raw": "1 8-ounce block cream cheese", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "8-ounce block cream cheese", "preparation": null, "optional": false}, {"position": 4, "raw": "½ to ¾ cup sour cream", "group": null, "quantity": 0.5, "quantity_max": 0.75, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 5, "raw": "2 large shallots, finely minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large shallots", "preparation": "finely minced", "optional": false}, {"position": 6, "raw": "2 tablespoons capers in liquid", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "capers in liquid", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon caper juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "caper juice", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon granulated garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "granulated garlic", "preparation": null, "optional": false}, {"position": 9, "raw": "5 shakes Tabasco", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "shakes tabasco", "preparation": null, "optional": false}, {"position": 10, "raw": "6 grinds freshly ground pepper, or more to taste", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "grinds freshly ground pepper", "preparation": "or more to taste", "optional": false}, {"position": 11, "raw": "Salt, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": "to taste", "optional": false}], "steps": [{"position": 1, "text": "Place wood shavings in center of smoker; top with drip pan and rack. Add catfish, leaving enough room between fillets so smoke can circulate. Place on stove over medium heat and smoke for 20 to 25 minutes. Shut off heat and let rest, covered, for 5 minutes. Catfish should be fully cooked and bronzed, with crisp edges."}, {"position": 2, "text": "While fillets are still warm, break them into pieces in a large bowl. Add remaining ingredients and mix well. Taste for seasoning, adding more sour cream if too dry. Serve immediately or refrigerate and serve cool."}], "nutrition": {"calories": 593.6, "protein_g": 47.1, "carbohydrates_g": 16.3, "fat_g": 37.7, "saturated_fat_g": 15.7, "trans_fat_g": 0.9, "cholesterol_mg": 212.5, "sodium_mg": 1217.7, "fiber_g": 3.6, "sugar_g": 8.6, "unsaturated_fat_g": 16.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["southern"], "diet": ["gluten-free"], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["catfish", "salad", "seafood", "smoke"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2007-01-24", "scraped_at": "2026-09-06T23:53:17.527338+00:00", "scraper_version": "1.0.0"}
{"slug": "smoked-chicken-salad", "nyt_id": 3807, "url": "https://cooking.nytimes.com/recipes/3807-smoked-chicken-salad", "name": "Smoked Chicken Salad", "author": "Molly O’Neill", "description": "Smoked chicken is given a husky taste that complements the inherent sweetness of the fowl and brings a hearty note to the pasta it’s combined with. The sweeter-smelling the wood used, the more alluring the flavor it leaves behind. Hickory or fruitwoods, maple, oak and alder chips, dried grapevine trimmings or herb branches lend a sweet, firm flavor to food cooked in a closed container above it.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "½ large shallot, peeled and minced", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "large shallot", "preparation": "peeled and minced", "optional": false}, {"position": 2, "raw": "¼ cup red wine vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons walnut oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "walnut oil", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon canola oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "canola oil", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon salt, plus more to taste", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 6, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": 
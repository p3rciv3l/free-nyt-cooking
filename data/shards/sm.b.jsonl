blespoon minced scallions", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced scallions", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon minced fresh chili pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "minced fresh chili pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "2 smoked chicken breasts, skinned and slivered", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "smoked chicken breasts", "preparation": "skinned and slivered", "optional": false}, {"position": 11, "raw": "¼ cup fresh coriander leaves, coarsely chopped", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fresh coriander leaves", "preparation": "coarsely chopped", "optional": false}], "steps": [{"position": 1, "text": "Beat the mustard and vinegar together in a salad bowl. Beat in the olive oil. Season the dressing to taste."}, {"position": 2, "text": "Add the peppers, onion, scallions and chili pepper and mix."}, {"position": 3, "text": "Add the chicken and toss all the ingredients together. Just before serving, fold in the coriander."}], "nutrition": {"calories": 238.7, "protein_g": 21.3, "carbohydrates_g": 4.9, "fat_g": 14.7, "saturated_fat_g": 2.2, "trans_fat_g": 0.0, "cholesterol_mg": 66.2, "sodium_mg": 435.8, "fiber_g": 1.6, "sugar_g": 2.7, "unsaturated_fat_g": 11.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["bell pepper", "chicken salad", "easy", "quick", "spring"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1989-01-15", "scraped_at": "2026-09-07T00:19:23.315122+00:00", "scraper_version": "1.0.0"}
{"slug": "smoked-duck-salad-sandwich-with-grapes-and-jicama", "nyt_id": 11126, "url": "https://cooking.nytimes.com/recipes/11126-smoked-duck-salad-sandwich-with-grapes-and-jicama", "name": "Smoked Duck Salad Sandwich With Grapes and Jicama", "author": "Nancy Harmon Jenkins", "description": "", "servings": {"text": "2 large or 4 small sandwiches", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup skinned, smoked duck breast, cut into half-inch pieces (see note)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "skinned", "preparation": "smoked duck breast, cut into half-inch pieces (see note)", "optional": false}, {"position": 2, "raw": "1 tablespoon diced red bell pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "diced red bell pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon diced yellow bell pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "diced yellow bell pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon diced carrot", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "diced carrot", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablespoons julienne strips of jicama", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "julienne strips of jicama", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon diced chayote", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "diced chayote", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons red seedless grapes, cut into small slivers", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "red seedless grapes", "preparation": "cut into small slivers", "optional": false}, {"position": 8, "raw": "3 tablespoons blanched Sugar Snap or English peas", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "blanched sugar snap or english peas", "preparation": null, "optional": false}, {"position": 9, "raw": "4 tablespoons roasted pine nuts", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "roasted pine nuts", "preparation": null, "optional": false}, {"position": 10, "raw": "1 egg yolk", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg yolk", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 12, "raw": "Juice of half a lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of half a lemon", "preparation": null, "optional": false}, {"position": 13, "raw": "1 small shallot, diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small shallot", "preparation": "diced", "optional": false}, {"position": 14, "raw": "2 tablespoons chopped fresh green coriander", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh green coriander", "preparation": null, "optional": false}, {"position": 15, "raw": "1 teaspoon chopped chives", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped chives", "preparation": null, "optional": false}, {"position": 16, "raw": "1 teaspoon chopped parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 17, "raw": "½ cup olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 18, "raw": "½ cup vegetable oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 19, "raw": "Additional salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "additional salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 20, "raw": "4 (or 8) slices of whole-grain bread, such as honey-wheat or wheat-berry", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "(or 8) slices of whole-grain bread", "preparation": "such as honey-wheat or wheat-berry", "optional": false}], "steps": [{"position": 1, "text": "In large mixing bowl, combine duck breast pieces with remaining salad ingredients. Set aside while making coriander mayonnaise."}, {"position": 2, "text": "To make the mayonnaise, place first seven ingredients in a small mixing bowl and whisk to blend. Combine olive oil and vegetable oil, and slowly, drop by drop, pour into bowl, whisking continuously. As the mayonnaise thickens, you may increase the volume of oil, so that by the end it is coming in a thin but constant stream. When all the oil has been incorporated, continue whisking for 15 seconds."}, {"position": 3, "text": "Or make the mayonnaise in a blender or food processor. Blend egg yolk, salt and lemon juice, and incorporate the oils as above, starting with drops and building up to a thin but steady stream. When all the oil is incorporated and the mayonnaise is thick, remove from blender or processor and stir in chopped seasonings."}, {"position": 4, "text": "Stir half a cup of mayonnaise into duck mixture and taste for seasonings, adding salt and pepper if desired."}, {"position": 5, "text": "Toast bread slices, if desired, before making sandwiches."}], "nutrition": {"calories": 1340.0, "protein_g": 19.7, "carbohydrates_g": 39.0, "fat_g": 127.4, "saturated_fat_g": 13.6, "trans_f
{"slug": "dirty-rice-with-mushrooms", "nyt_id": 1023001, "url": "https://cooking.nytimes.com/recipes/1023001-dirty-rice-with-mushrooms", "name": "Dirty Rice With Mushrooms", "author": "Kay Chun", "description": "This vegetarian version of Southern dirty rice replaces the traditional ground beef and chicken livers with hearty mushrooms, creamy black-eyed peas and flavorful spices for a satisfying one-pot meal. The recipe starts with the classic Cajun holy trinity — onion, green bell pepper and celery in equal parts — to create a flavorful foundation. Mushroom broth adds even more depth and reinforces the earthy cremini mushrooms, while a drizzle of hot sauce adds tang and kick. Serve with simple leafy greens or chopped salad.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "PT35M"}}, "ingredients": [{"position": 1, "raw": "¼ cup neutral oil, such as safflower or canola", "group": null, "quantity": 0.25, "unit": "cup", "item": "neutral oil", "preparation": "such as safflower or canola", "optional": false}, {"position": 2, "raw": "½ cup finely chopped yellow onion", "group": null, "quantity": 0.5, "unit": "cup", "item": "finely chopped yellow onion", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup finely chopped celery", "group": null, "quantity": 0.5, "unit": "cup", "item": "finely chopped celery", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup finely chopped green bell pepper", "group": null, "quantity": 0.5, "unit": "cup", "item": "finely chopped green bell pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "Kosher salt (Diamond Crystal) and black pepper", "group": null, "quantity": null, "unit": null, "item": "kosher salt and black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "8 ounces cremini mushrooms, trimmed and finely chopped", "group": null, "quantity": 8.0, "unit": "oz", "item": "cremini mushrooms", "preparation": "trimmed and finely chopped", "optional": false}, {"position": 7, "raw": "1 tablespoon minced garlic", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 8, "raw": "2 cups long-grain white rice", "group": null, "quantity": 2.0, "unit": "cup", "item": "long-grain white rice", "preparation": null, "optional": false}, {"position": 9, "raw": "2 teaspoons Cajun seasoning", "group": null, "quantity": 2.0, "unit": "tsp", "item": "cajun seasoning", "preparation": null, "optional": false}, {"position": 10, "raw": "3 cups store-bought or homemade mushroom broth", "group": null, "quantity": 3.0, "unit": "cup", "item": "store-bought or homemade mushroom broth", "preparation": null, "optional": false}, {"position": 11, "raw": "1 (15-ounce can) black-eyed peas, rinsed and drained", "group": null, "quantity": 1.0, "unit": null, "item": "black-eyed peas", "preparation": "rinsed and drained", "optional": false}, {"position": 12, "raw": "½ cup thinly sliced scallions, plus more for garnish", "group": null, "quantity": 0.5, "unit": "cup", "item": "thinly sliced scallions", "preparation": "plus more for garnish", "optional": false}, {"position": 13, "raw": "Hot sauce, for serving", "group": null, "quantity": null, "unit": null, "item": "hot sauce", "preparation": "for serving", "optional": false}], "steps": [{"position": 1, "text": "In a large Dutch oven, heat 2 tablespoons of the oil over medium. Add onion, celery and bell pepper, and season with salt and pepper. Cook, stirring occasionally, until softened, 5 minutes. Add mushrooms, season with salt and pepper, and cook, stirring occasionally, until mushrooms are tender and their liquid is absorbed, 5 minutes. Stir in garlic until fragrant, 1 minute."}, {"position": 2, "text": "Add rice, Cajun seasoning, 1 teaspoon salt, ½ teaspoon pepper and the remaining 2 tablespoons oil. Stir until well blended, then add broth, scraping bottom of pot to remove any browned bits. Bring to a boil over high heat."}, {"position": 3, "text": "Cover and reduce heat to low. Cook until rice is tender and liquid is absorbed, about 15 minutes. Scatter black-eyed peas on top in an even layer, cover and cook 3 minutes longer. Turn off heat."}, {"position": 4, "text": "Add scallions to the pot, and fluff rice with a fork. Divide among bowls and garnish with more scallions. Serve with hot sauce."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 522.5, "protein_g": 15.1, "carbohydrates_g": 101.2, "fat_g": 6.6, "saturated_fat_g": 0.8, "unsaturated_fat_g": 4.4, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 1112.6, "fiber_g": 6.1, "sugar_g": 6.9, "computed_with": null}, "tags": {"cuisine": ["american-southern"], "diet": [], "course": ["dinner-grains-and-rice-main-course-side-dish"], "meal": [], "occasion": [], "other": ["mushroom", "rice", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2022/02/24/dining/kc-dirty-rice-with-mushrooms/merlin_202658598_1bd6d8a0-8c55-43ba-bee1-bc4c497e79bb-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2022/02/24/dining/kc-dirty-rice-with-mushrooms/merlin_202658598_1bd6d8a0-8c55-43ba-bee1-bc4c497e79bb-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2022/02/24/dining/kc-dirty-rice-with-mushrooms/kc-dirty-rice-with-mushrooms-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2022/02/24/dining/kc-dirty-rice-with-mushrooms/merlin_202658598_1bd6d8a0-8c55-43ba-bee1-bc4c497e79bb-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 965}, "video_url": null, "comment_count": null, "published_at": "2022-02-24", "scraped_at": "2026-09-07T00:45:51Z", "scraper_version": "1.0.0"}
{"slug": "diy-vegan-mayonnaise", "nyt_id": 1018107, "url": "https://cooking.nytimes.com/recipes/1018107-diy-vegan-mayonnaise", "name": "D.I.Y. Vegan Mayonnaise", "author": "Jane Black", "description": "This recipe is adapted from one by Sir Kensington's, the condiment company in New York that uses chickpea liquid, or aquafaba, to make its vegan mayonnaise. Vegans have embraced the liquid, which whips up instantly into peaks and froths and retains none of its bean-like flavors, and works perfectly as a leavener and as a base for delicious homemade mayo. Jane Black", "servings": {"text": "cup", "min": null, "max": null, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "PT10M"}}, "ingredients": [{"position": 1, "raw": "1 15-ounce can of chickpeas", "group": null, "quantity": 16.0, "unit": null, "item": "ounce can of chickpeas", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon white vinegar", "group": null, "quantity": 1.0, "unit": "tsp", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon fine salt", "group": null, "quantity": 0.5, "unit": "tsp", "item": "fine salt", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon sugar", "group": null, "quantity": 0.5, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon lemon juice", "group": null, "quantity": 1.0, "unit": "tsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons dry mustard", "group": null, "quantity": 2.0, "unit": "tsp", "item": "dry mustard", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup sunflower oil", "group": null, "quantity": 0.75, "unit": "cup", "item": "sunflower oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Drain the chickpeas, reserving the bean liquid. (Save chickpeas for another use.) Measure out ¼ cup of the bean liquid (aquafaba) in a large glass measuring cup. Add vinegar, salt, sugar, lemon juice and dry mustard."}, {"position": 2, "text": "Using an immersion blender, mix until combined. With the blender running, very slowly drizzle in the oil in a thin stream. It should take 4 to 5 minutes to add all of the oil. The mixture will emulsify and thicken."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 1374.6666666666667, "protein_g": 20.7, "carbohydrates_g": 67.3, "fat_g": 117.0, "saturated_fat_g": 14.8, "unsaturated_fat_g": 42.7, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 937.8, "fiber_g": 18.2, "sugar_g": 13.0, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["condiments"], "meal": [], "occasion": [], "other": ["chickpea", "lemon-juice"]}, "images": [{"url": "https://static01.nyt.com/images/2016/05/11/dining/11JPAQUAFABA3-WEB/11JPAQUAFABA3-WEB-videoSixteenByNineJumbo1600-v2.jpg", "alt": "Mayonnaise made with aquafaba.", "primary": true}, {"url": "https://static01.nyt.com/images/2016/05/11/dining/11JPAQUAFABA3-WEB/11JPAQUAFABA3-WEB-superJumbo-v2.jpg", "alt": "Mayonnaise made with aquafaba.", "primary": false}, {"url": "https://static01.nyt.com/images/2016/05/11/dining/11JPAQUAFABA3-WEB/11JPAQUAFABA3-WEB-facebookJumbo-v2.jpg", "alt": "Mayonnaise made with aquafaba.", "primary": false}], "rating": {"average": 4.0, "count": 327}, "video_url": null, "comment_count": null, "published_at": "2016-05-11", "scraped_at": "2026-09-07T00:18:16Z", "scraper_version": "1.0.0"}

{"slug": "vanilla-bean-pound-cake-with-muscat-macerated-fruit", "nyt_id": 9945, "url": "https://cooking.nytimes.com/recipes/9945-vanilla-bean-pound-cake-with-muscat-macerated-fruit", "name": "Vanilla Bean Pound Cake With Muscat-Macerated Fruit", "author": "Melissa Clark", "description": "Melissa Clark", "servings": {"text": "8 to 10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "½ cup butter, at room temperature", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "butter", "preparation": "at room temperature", "optional": false}, {"position": 2, "raw": "½ cup shortening, at room temperature", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "shortening", "preparation": "at room temperature", "optional": false}, {"position": 3, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "4 large eggs", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon vanilla extract", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 6, "raw": "½ vanilla bean, split lengthwise and center scraped with tip of a knife", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "vanilla bean", "preparation": "split lengthwise and center scraped with tip of a knife", "optional": false}, {"position": 7, "raw": "1 ¾ cups all-purpose flour", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 8, "raw": "¾ teaspoons salt", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 9, "raw": "Muscat-macerated fruit (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "muscat-macerated fruit (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Grease and flour a loaf pan. Using an electric mixer, cream butter, shortening and sugar until very fluffy, about 3 to 4 minutes. Whisk together eggs, vanilla extract and vanilla bean scrapings (reserve bean for fruit sauce). Gradually add egg mixture to butter mixture, beating well."}, {"position": 2, "text": "Sift together flour and salt. Add half the flour mixture to batter, and beat to combine. Add remaining flour, gently folding it in with a spatula. Scrape batter into prepared pan, and smooth the top."}, {"position": 3, "text": "Bake cake until a tester inserted into middle comes out clean, about 1 hour and 10 minutes. If top of cake seems to be getting overly browned before center is set, cover with foil, and continue baking. Let cool on a rack before inverting."}, {"position": 4, "text": "Serve slices of pound cake topped with macerated fruit."}], "nutrition": {"calories": 370.9, "protein_g": 4.9, "carbohydrates_g": 37.7, "fat_g": 21.6, "saturated_fat_g": 9.0, "trans_fat_g": 1.4, "cholesterol_mg": 98.8, "sodium_mg": 205.3, "fiber_g": 0.6, "sugar_g": 20.1, "unsaturated_fat_g": 11.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["valentine’s day"], "other": ["all-purpose flour", "bake", "vanilla bean"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2000-05-03", "scraped_at": "2026-09-07T01:35:03.497546+00:00", "scraper_version": "1.0.0"}

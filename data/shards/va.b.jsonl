{"slug": "vanilla-custard-sauce-creme-anglaise", "nyt_id": 1086, "url": "https://cooking.nytimes.com/recipes/1086-vanilla-custard-sauce-creme-anglaise", "name": "Vanilla Custard Sauce (Creme Anglaise)", "author": "Molly O’Neill", "description": "", "servings": {"text": "2 cups", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "About 30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups milk", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 2, "raw": "1 vanilla bean, split", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "vanilla bean", "preparation": "split", "optional": false}, {"position": 3, "raw": "4 egg yolks", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "Pinch salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a saucepan, combine the milk and vanilla bean and bring just to a boil. Remove from the heat, cover and allow to sit 10 minutes. Meanwhile, in a medium bowl, whisk together the yolks, sugar and salt until thick and light-colored, and set aside."}, {"position": 2, "text": "Discard the vanilla bean and very slowly whisk the hot milk into the yolk mixture. Return the mixture to the saucepan, set over medium-low heat and cook, stirring constantly, until the custard thickens just enough to coat the back of the spoon, about 10 minutes. (Do not overcook or the custard will curdle.)"}, {"position": 3, "text": "Immediately remove from the heat and strain through a fine-mesh sieve into a clean bowl. Serve warm or chilled. (If necessary, rewarm the sauce in the top of a double boiler set over barely simmering water.)"}], "nutrition": {"calories": 169.8, "protein_g": 6.0, "carbohydrates_g": 19.0, "fat_g": 7.5, "saturated_fat_g": 3.6, "trans_fat_g": 0.0, "cholesterol_mg": 157.6, "sodium_mg": 96.0, "fiber_g": 0.0, "sugar_g": 18.9, "unsaturated_fat_g": 3.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["egg yolk", "milk", "sauces and gravies", "vanilla bean"]}, "images": [], "rating": {"average": 5.0, "count": 60}, "video_url": null, "comment_count": null, "published_at": "1998-12-13", "scraped_at": "2026-09-07T01:52:47.132267+00:00", "scraper_version": "1.0.0"}
{"slug": "vanilla-flan", "nyt_id": 1124, "url": "https://cooking.nytimes.com/recipes/1124-vanilla-flan", "name": "Vanilla Flan", "author": "Molly O’Neill", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "8 large eggs", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups milk", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup half-and-half", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "half-and-half", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Place 1 cup of the sugar in a skillet and set over medium heat. When the sugar begins to melt, stir constantly with a fork until it is completely melted and has turned an amber color. Immediately pour the melted sugar into an 8-cup ovenproof baking dish and swirl to coat the bottom and an inch or two up the sides of the dish."}, {"position": 2, "text": "In a large bowl, whisk the eggs together. Whisk in the milk, half-and-half, vanilla and the remaining cup of sugar. Strain through a sieve into the dish."}, {"position": 3, "text": "Place the dish in a roasting pan and pour boiling water into the pan about halfway up the sides of the dish. Bake in the top third of the oven until the center of the custard is set, 50 to 60 minutes. Cool the flan for 5 minutes. Run a knife around the edge of the dish and invert the flan onto a serving plate. (There will be a fair amount of liquid, so choose one with a rim.) Serve warm or chilled."}], "nutrition": {"calories": 457.8, "protein_g": 12.2, "carbohydrates_g": 72.9, "fat_g": 13.6, "saturated_fat_g": 6.4, "trans_fat_g": 0.2, "cholesterol_mg": 270.2, "sodium_mg": 155.0, "fiber_g": 0.0, "sugar_g": 72.6, "unsaturated_fat_g": 6.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["mexican"], "diet": [], "course": [], "meal": [], "occasion": ["christmas"], "other": ["bake", "egg", "half and half", "milk", "saute", "winter"]}, "images": [], "rating": {"average": 5.0, "count": 280}, "video_url": null, "comment_count": null, "published_at": "1998-12-20", "scraped_at": "2026-09-07T02:10:15.780395+00:00", "scraper_version": "1.0.0"}

{"slug": "spinach-and-chickpeas", "nyt_id": 12228, "url": "https://cooking.nytimes.com/recipes/12228-spinach-and-chickpeas", "name": "Spinach and Chickpeas", "author": "Mark Bittman", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 or 3 slices crusty bread, for crumbs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "or 3 slices crusty bread", "preparation": "for crumbs", "optional": false}, {"position": 2, "raw": "2 cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 3, "raw": "¼ cup plus 1 tablespoon olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "plus 1 tablespoon olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pound spinach", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "spinach", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon pimenton (smoked paprika)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "pimenton (smoked paprika)", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon ground cumin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 7, "raw": "16-ounce can or 2 cups cooked chickpeas", "group": null, "quantity": 16.0, "quantity_max": null, "unit": null, "item": "-ounce can or 2 cups cooked chickpeas", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon sherry vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Pulse bread in a food processor to make crumbs. Saute garlic in ¼ cup olive oil until fragrant, then add bread crumbs and stir frequently until evenly toasted; remove."}, {"position": 2, "text": "Add remaining oil to the pan and add the spinach, along with the pimenton and cumin. Cook until it is quite soft, about 10 minutes."}, {"position": 3, "text": "Add the chickpeas to the pan and cook for 5 minutes or so. When ready to serve, stir in the sherry vinegar and sprinkle with the toasted bread crumbs."}], "nutrition": {"calories": 417.4, "protein_g": 15.5, "carbohydrates_g": 44.8, "fat_g": 21.3, "saturated_fat_g": 2.9, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 452.8, "fiber_g": 12.1, "sugar_g": 7.0, "unsaturated_fat_g": 16.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "high fiber", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["chickpea", "easy", "quick", "saute", "spinach"]}, "images": [], "rating": {"average": 4.0, "count": 63}, "video_url": null, "comment_count": null, "published_at": "2013-02-27", "scraped_at": "2026-09-06T23:54:11.955887+00:00", "scraper_version": "1.0.0"}
{"slug": "spring-vegetable-ragout", "nyt_id": 10962, "url": "https://cooking.nytimes.com/recipes/10962-spring-vegetable-ragout", "name": "Spring Vegetable Ragout", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "½ pound sugar snap peas", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "sugar snap peas", "preparation": null, "optional": false}, {"position": 2, "raw": "1 pound slender but not pencil-thin asparagus", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "slender but not pencil-thin asparagus", "preparation": null, "optional": false}, {"position": 3, "raw": "1 lemon, halved", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "lemon", "preparation": "halved", "optional": false}, {"position": 4, "raw": "½ pound baby artichokes (about 12)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "baby artichokes (about 12)", "preparation": null, "optional": false}, {"position": 5, "raw": "4 tablespoons extra virgin olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 bunch scallions, trimmed and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "scallions", "preparation": "trimmed and chopped", "optional": false}, {"position": 7, "raw": "1 cup well-flavored chicken stock, approximately", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "well-flavored chicken stock", "preparation": "approximately", "optional": false}, {"position": 8, "raw": "1 ½ tablespoons fresh thyme sprigs", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "fresh thyme sprigs", "preparation": null, "optional": false}, {"position": 9, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "½ tablespoon finely chopped parsley", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "finely chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Break off the stem ends of the sugar snap peas, and pull off the strings. Set aside."}, {"position": 2, "text": "Rinse the asparagus, and snap off the ends where they break naturally. Cut the stalks in thirds. Set aside."}, {"position": 3, "text": "Squeeze the lemon into a bowl of water large enough to hold the artichokes, and put the squeezed halves in the bowl. Trim the stem ends of the artichokes, and slice about ¼ inch off the tops. Pull off one or two layers of the outer leaves, slice the artichokes in half lengthwise and drop them into the bowl of acidulated water."}, {"position": 4, "text": "Place a large, heavy saute pan or skillet over high heat. Add 2 tablespoons olive oil and half the scallions. Saute until they soften, then add the peas and stir-fry until they begin to turn bright green. Add the asparagus, and continue to stir-fry about 3 minutes, until asparagus turns bright green. Remove vegetables from pan."}, {"position": 5, "text": "Add another tablespoon of the oil, the remaining scallions and the artichokes. Stir-fry over high heat for 2 to 3 minutes, until the artichokes barely start to brown. Add the chicken stock and thyme, reduce heat to low, cover and simmer until the artichokes are tender, about 20 minutes. Return the peas and asparagus to the pan, and cook, uncovered, over medium heat until the peas and the artichokes are also tender, about 5 minutes longer. There should be enough liquid in the pan to moisten the vegetables. If not, add a little more stock."}, {"position": 6, "text": "Stir in the remaining oil, season to taste with salt and pepper, dust with parsley and serve."}], "nutrition": {"calories": 155.3, "protein_g": 5.6, "carbohydrates_g": 14.5, "fat_g": 9.8, "saturated_fat_g": 1.5, "trans_fat_g": 0.0, "cholesterol_mg": 1.2, "sodium_mg": 545.7, "fiber_g": 5.8, "sugar_g": 4.7, "unsaturated_fat_g": 8.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["asparagus", "pea", "saute"]}, "images": [], "rating": {"average": 5.0, "count": 7}, "video_url": null, "comment_count": null, "published_at": "1998-04-15", "scraped_at": "2026-09-06T22:34:36.504039+00:00", "scraper_version": "1.0.0"}
{"slug": "spring-vegetable-risotto", "nyt_id": 10501, "url": "https://cooking.nytimes.com/recipes/10501-spring-vegetable-risotto", "name": "Spring-Vegetable Risotto", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 first-course servings", "min": 4, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 medium onion chopped fine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion chopped fine", "preparation": null, "optional": false}, {"position": 2, "raw": "2 small carrots, diced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small carrots", "preparation": "diced", "optional": false}, {"position": 3, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup Arborio rice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "arborio rice", "preparation": null, "optional": false}, {"position": 5, "raw": "Pinch saffron", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch saffron", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup dry white wine", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 7, "raw": "3 ½ cups chicken stock, hot", "group": null, "quantity": 3.5, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": "hot", "optional": false}, {"position": 8, "raw": "1 cup peeled fresh fava beans, or peas", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "peeled fresh fava beans", "preparation": "or peas", "optional": false}, {"position": 9, "raw": "8 small asparagus spears, cut in 1-inch pieces on the diagonal", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "small asparagus spears", "preparation": "cut in 1-inch pieces on the diagonal", "optional": false}, {"position": 10, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup freshly grated Parmesan cheese", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large frying pan, soften the onion with the carrots in one tablespoon butter. Add the rice and cook, stirring, for a couple of minutes until the rice is well coated with butter and starts to turn opaque. Add the saffron and wine and stir thoroughly."}, {"position": 2, "text": "Add a cup of hot chicken stock and cook, stirring, until most of the liquid is absorbed."}, {"position": 3, "text": "Add one-half cup more stock and continue cooking, stirring frequently."}, {"position": 4, "text": "Add the fava beans and asparagus and another cup of stock. Continue cooking and adding stock until the rice is al dente. It is done when it is firm but tender and creamy. The vegetables should be barely tender. Season to taste with salt and pepper."}, {"position": 5, "text": "Stir in the cheese and remaining butter. Serve immediately."}], "nutrition": {"calories": 447.3, "protein_g": 19.0, "carbohydrates_g": 60.2, "fat_g": 13.6, "saturated_fat_g": 7.2, "trans_fat_g": 0.0, "cholesterol_mg": 34.2, "sodium_mg": 952.6, "fiber_g": 5.7, "sugar_g": 9.2, "unsaturated_fat_g": 5.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course", "side dish"], "meal": ["dinner"], "occasion": [], "other": ["arborio rice", "aspara
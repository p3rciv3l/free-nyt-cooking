{"slug": "spring-vegetables-marinated", "nyt_id": 10500, "url": "https://cooking.nytimes.com/recipes/10500-spring-vegetables-marinated", "name": "Spring Vegetables, Marinated", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 servings as a first course", "min": 8, "max": 8, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup extra-virgin olive oil Approximately", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil approximately", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup red wine vinegar (or to taste)", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "red wine vinegar (or to taste)", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cloves garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "2 red peppers", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "red peppers", "preparation": null, "optional": false}, {"position": 7, "raw": "1 yellow pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "yellow pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "20 baby artichokes", "group": null, "quantity": 20.0, "quantity_max": null, "unit": null, "item": "baby artichokes", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ½ pounds fresh fava beans", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "fresh fava beans", "preparation": null, "optional": false}, {"position": 10, "raw": "½ head cauliflower", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "head", "item": "cauliflower", "preparation": null, "optional": false}, {"position": 11, "raw": "1 pound thin asparagus", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "thin asparagus", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons chives, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chives", "preparation": "chopped", "optional": false}], "steps": [{"position": 1, "text": "Combine the oil, vinegar and mustard, tasting as you go so that the proportions of oil to vinegar are correct."}, {"position": 2, "text": "Cut the garlic cloves in half, leaving the skins on, and with the tip of a knife, remove the greenish or yellow shoot in the center of the clove. Place the garlic in a press and squeeze into the oil-vinegar mixture. Season to taste with salt and pepper. Set aside."}, {"position": 3, "text": "Preheat broiler. Cut the peppers into strips about two inches wide, removing the seeds. Place the peppers skin side up on a broiling pan and broil until the skins are charred and puffed. Place the pepper strips in a paper bag and close the bag. Let rest for a few minutes, then remove the peppers and peel away the skin."}, {"position": 4, "text": "Slice the peppers into thin strips. While they are still warm, toss in a little of the garlic vinaigrette sauce and place on a serving platter large enough to hold all the vegetables attractively."}, {"position": 5, "text": "Place the artichokes in a vegetable steamer and steam until cooked. Peel the fava beans and steam (if you have a Chinese bamboo steamer several layers can be cooked at the same time). Break the cauliflower into florets, trim the asparagus, and steam."}, {"position": 6, "text": "Slice the tops off the artichokes about one-half inch down and remove the outer leaves. The part you have left should be tender enough to eat whole. Dust the artichokes in some of the vinaigrette dressing and place on the serving platter."}, {"position": 7, "text": "Peel the tough skin from the fava beans and toss the beans in the dressing. Place on the serving platter along with the cooked cauliflower and asparagus. Pour the remaining dressing over the asparagus and cauliflower and sprinkle the vegetables with the chives. Let sit at room temperature for an hour before serving."}], "nutrition": {"calories": 532.3, "protein_g": 21.8, "carbohydrates_g": 63.1, "fat_g": 28.6, "saturated_fat_g": 4.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 1495.7, "fiber_g": 29.9, "sugar_g": 14.6, "unsaturated_fat_g": 23.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["asparagus", "baby artichoke", "broil", "fava bean", "marinate", "spring", "steam"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1986-05-04", "scraped_at": "2026-09-06T22:29:09.572742+00:00", "scraper_version": "1.0.0"}

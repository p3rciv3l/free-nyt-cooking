ide."}, {"position": 2, "text": "Combine heavy cream, butter and ham in small saucepan and heat. Season to taste with salt and pepper. Add the fava beans and set aside."}, {"position": 3, "text": "Cook the tagliatelle until al dente. Drain and mix with the ham sauce and serve additional Parmesan cheese separately."}], "nutrition": {"calories": 857.1, "protein_g": 37.7, "carbohydrates_g": 86.1, "fat_g": 42.7, "saturated_fat_g": 23.8, "trans_fat_g": 0.7, "cholesterol_mg": 205.8, "sodium_mg": 814.8, "fiber_g": 9.1, "sugar_g": 12.5, "unsaturated_fat_g": 14.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner", "lunch"], "occasion": ["easter"], "other": ["boil", "easy", "fava bean", "ham", "pastas", "quick", "steam"]}, "images": [], "rating": {"average": 4.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "1991-03-31", "scraped_at": "2026-09-06T22:23:51.509602+00:00", "scraper_version": "1.0.0"}
{"slug": "taleggio-and-mushroom-tart", "nyt_id": 10591, "url": "https://cooking.nytimes.com/recipes/10591-taleggio-and-mushroom-tart", "name": "Taleggio And Mushroom Tart", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 ¼ cups flour, plus more for rolling", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": "plus more for rolling", "optional": false}, {"position": 2, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "6 tablespoons cold butter, preferably high-fat", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "cold butter", "preparation": "preferably high-fat", "optional": false}, {"position": 4, "raw": "1 large egg yolk, beaten with 2 tablespoons ice water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg yolk", "preparation": "beaten with 2 tablespoons ice water", "optional": false}, {"position": 5, "raw": "1 tablespoon extra virgin olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon cumin seeds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cumin seeds", "preparation": null, "optional": false}, {"position": 7, "raw": "8 ounces shiitake mushrooms, sliced and stems discarded", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "shiitake mushrooms", "preparation": "sliced and stems discarded", "optional": false}, {"position": 8, "raw": "1 tablespoon finely sliced shallots", "group": null, "quantity": 1
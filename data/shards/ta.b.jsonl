{"slug": "tarragon-potato-salad", "nyt_id": 2634, "url": "https://cooking.nytimes.com/recipes/2634-tarragon-potato-salad", "name": "Tarragon Potato Salad", "author": "Moira Hodgson", "description": "", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": 20, "cook_minutes": 20, "total_minutes": 40, "raw": {"total": "40 minutes", "prep": "20 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds red-skinned potatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "red-skinned potatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "2 egg yolks", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 3, "raw": "1 to 2 tablespoons tarragon vinegar (or more to taste)", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "tbsp", "item": "tarragon vinegar (or more to taste)", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon Dijon mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup safflower oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "safflower oil", "preparation": null, "optional": false}, {"position": 6, "raw": "½ to ¾ cup extra-virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": 0.75, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons chopped tarragon", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item"
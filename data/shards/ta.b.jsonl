{"slug": "tabbouleh-salad-with-grilled-eggplant", "nyt_id": 4634, "url": "https://cooking.nytimes.com/recipes/4634-tabbouleh-salad-with-grilled-eggplant", "name": "Tabbouleh Salad With Grilled Eggplant", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 cup bulgur", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "bulgur", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ cups boiling water", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "boiling water", "preparation": null, "optional": false}, {"position": 3, "raw": "Juice of 1 ½ lemons", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1 ½ lemons", "preparation": null, "optional": false}, {"position": 4, "raw": "A 1-pound eggplant, sliced ½-inch thick", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "a 1-pound eggplant", "preparation": "sliced ½-inch thick", "optional": false}, {"position": 5, "raw": "3 tablespoons minced scallions", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "minced scallions", "preparation": null, "optional": false}, {"position": 6, "raw": "1 medium-size tomato, peeled, seeded, juiced and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size tomato", "preparation": "peeled, seeded, juiced and chopped", "optional": false}, {"position": 7, "raw": "1 garlic clove, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "garlic clove", "preparation": "minced", "optional": false}, {"position": 8, "raw": "3 tablespoons minced fresh flat-leaf parsley", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh flat-leaf parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons minced fresh mint", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh mint", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ to 2 tablespoons extra-virgin olive oil", "group": null, "quantity": 1.5, "quantity_max": 2.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the bulgur in a bowl, pour the boiling water over it and stir in the lemon juice. Cover and set it aside."}, {"position": 2, "text": "Preheat a grill or broiler. Grill or broil the eggplant slices until they are nicely browned, turning them once to brown both sides. Coarsely chop the eggplant and set it aside."}, {"position": 3, "text": "After about 30 minutes, when the bulgur has softened and is cool enough to handle, transfer it to a fine-mesh sieve and press out any excess liquid. Return the bulgur to a bowl."}, {"position": 4, "text": "Fold in the eggplant and all the remaining ingredients. Serve at room temperature."}], "nutrition": {"calories": 148.1, "protein_g": 4.3, "carbohydrates_g": 26.0, "fat_g": 4.5, "saturated_fat_g": 0.7, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 492.0, "fiber_g": 6.5, "sugar_g": 3.9, "unsaturated_fat_g": 3.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["middle eastern"], "diet": ["low-fat"], "course": [], "meal": ["lunch"], "occasion": [], "other": ["broil", "bulgur", "eggplant", "grains and rice", "salad", "tomato", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 21}, "video_url": null, "comment_count": null, "published_a
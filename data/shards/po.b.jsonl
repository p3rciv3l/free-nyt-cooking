{"slug": "potato-salad-with-dijon-vinaigrette", "nyt_id": 12060, "url": "https://cooking.nytimes.com/recipes/12060-potato-salad-with-dijon-vinaigrette", "name": "Potato Salad With Dijon Vinaigrette", "author": "William Norwich", "description": "There’s nothing complicated about this potato salad — it’s really just boiled red potatoes tossed with a simple Dijon mustard vinaigrette and a generous smattering of scallions and fresh herbs — and that’s the beauty of it. It’s served cold or at room temperature, and its flavor gets better as it sits, making it an ideal dish to bring to a potluck or a picnic.", "servings": {"text": " 8 to 10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "3 pounds red new potatoes", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "red new potatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup red wine vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons whole grain Dijon mustard", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "whole grain dijon mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "6 scallions, chopped", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "chopped", "optional": false}, {"position": 6, "raw": "½ cup chopped parsley", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup chopped dill", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped dill", "preparation": null, "optional": false}, {"position": 8, "raw": "Salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the potatoes in a large stockpot, and cover with water. Bring to a boil, and cook until the potatoes are tender, about 20 minutes. Drain and allow to cool. When cool, cut the potatoes in half."}, {"position": 2, "text": "Combine the vinegar and mustard in a large bowl. Slowly whisk in the olive oil."}, {"position": 3, "text": "Add the potatoes to the vinaigrette, and mix gently but thoroughly. Toss in the scallions, parsley and dill. Salt and pepper to taste."}], "nutrition": {"calories": 209.3, "protein_g": 3.3, "carbohydrates_g": 25.2, "fat_g": 11.1, "saturated_fat_g": 1.5, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 394.4, "fiber_g": 3.5, "sugar_g": 1.4, "unsaturated_fat_g": 9.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "potato", "potato salad", "spring", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2017/06/26/dining/26COOKING-POTATO1/26COOKING-POTATO1-facebookJumbo-v2.jpg", "alt": "Potato salad with Dijon vinaigrette.", "primary": true}], "rating": {"average": 5.0, "count": 4942}, "video_url": null, "comment_count": null, "published_at": "2002-03-24", "scraped_at": "2026-09-06T23:52:55.047112+00:00", "scraper_version": "1.0.0"}
{"slug": "potato-salad-with-sweet-pickles", "nyt_id": 10684, "url": "https://cooking.nytimes.com/recipes/10684-potato-salad-with-sweet-pickles", "name": "Potato Salad With Sweet Pickles", "author": "Amanda Hesser", "description": "", "servings": {"text": "serves 4", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 ½ pounds white potatoes, scrubbed", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "white potatoes", "preparation": "scrubbed", "optional": false}, {"position": 2, "raw": "2 eggs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup, halved and thinly sliced, small sweet pickles", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "cup", "preparation": "halved and thinly sliced, small sweet pickles", "optional": false}, {"position": 4, "raw": "2 stalks celery, thinly sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "stalk", "item": "celery", "preparation": "thinly sliced", "optional": false}, {"position": 5, "raw": "3 scallions, thinly sliced", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "thinly sliced", "optional": false}, {"position": 6, "raw": "¾ cup Miracle Whip", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "miracle whip", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ tablespoons white-wine vinegar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "white-wine vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put the potatoes in a large pot and cover with cold water. Bring it to a simmer over medium heat and cook until tender, about 30 minutes. Meanwhile, fill a small saucepan with water and bring it to a boil. Lower the eggs into the water and simmer for 10 minutes. Drain the eggs and peel them under running water. Coarsely chop the eggs and add them to a large serving bowl."}, {"position": 2, "text": "Drain the potatoes, and when they are cool enough to handle, peel them, cut them into quarters lengthwise and then slice them thinly. Place them in the bowl with the eggs."}, {"position": 3, "text": "Add the pickles, celery, scallions, Miracle Whip and vinegar. Season with salt. Fold the salad together, again and again, until well blended. Taste as you go and adjust the salt if you need to."}], "nutrition": {"calories": 174.7, "protein_g": 6.0, "carbohydrates_g": 33.6, "fat_g": 2.3, "saturated_fat_g": 0.7, "trans_fat_g": 0.0, "cholesterol_mg": 80.0, "sodium_mg": 566.3, "fiber_g": 4.8, "sugar_g": 6.8, "unsaturated_fat_g": 1.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["easy", "potato"]}, "images": [], "rating": {"average": 4.0, "count": 13}, "video_url": null, "comment_count": null, "published_at": "2004-10-24", "scraped_at": "2026-09-06T22:30:49.653751+00:00", "scraper_version": "1.0.0"}

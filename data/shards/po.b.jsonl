 null, "unit": null, "item": "large black truffle (see note)", "preparation": null, "optional": false}, {"position": 9, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ teaspoon thyme", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "thyme", "preparation": null, "optional": false}, {"position": 11, "raw": "1 pound chestnuts (see note)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "chestnuts (see note)", "preparation": null, "optional": false}, {"position": 12, "raw": "1 three-pound chicken", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "three-pound chicken", "preparation": null, "optional": false}, {"position": 13, "raw": "1 carrot, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "carrot", "preparation": "chopped", "optional": false}, {"position": 14, "raw": "1 small onion, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small onion", "preparation": "minced", "optional": false}, {"position": 15, "raw": "1 celery stalk, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "celery stalk", "preparation": "chopped", "optional": false}, {"position": 16, "raw": "1 sprig fresh thyme", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "fresh thyme", "preparation": null, "optional": false}, {"position": 17, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 18, "raw": "2 sprigs parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "sprig", "item": "parsley", "preparation": null, "optional": false}, {"position": 19, "raw": "1 cup chicken broth", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 20, "raw": "1 cup Port", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "port", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees."}, {"position": 2, "text": "Chop the shallots and cook them for a few minutes in the butter. Add the sausage meat and sausages and cook, stirring with a fork, until the meat is lightly browned."}, {"position": 3, "text": "Add the bread crumbs, soaked in milk and well drained, the Cognac, the mushrooms and the truffle, cut into small sticks. Season with salt and pepper to taste. Add the thyme and set aside."}, {"position": 4, "text": "Peel and cook the chestnuts and cool them. Break into pieces, reserving about eight whole ones. Add the pieces to the stuffing mixture. Blend well. Add the remaining whole chestnuts."}, {"position": 5, "text": "Fill the chicken cavity with the stuffing and close the opening by sewing with kitchen thread. Rub the chicken with salt and pepper and roast for about one and one-half hour."}, {"position": 6, "text": "After half an hour add the carrot, onion, celery, thyme, bay leaf and parsley to the pan in which the chicken is cooking."}, {"position": 7, "text": "Transfer the chicken to a serving dish. Keep it warm, covered with aluminum foil."}, {"position": 8, "text": "Skim the fat and vegetables from the pan. Add the chicken broth and bring it to a slow boil. Reduce, add Port, correct seasonings and drain in a sieve. Pour the sauce over the chicken."}], "nutrition": {"calories": 1397.1, "protein_g": 81.0, "carbohydrates_g": 87.8, "fat_g": 72.2, "saturated_fat_g": 21.6, "trans_fat_g": 0.4, "cholesterol_mg": 304.3, "sodium_mg": 1763.9, "fiber_g": 4.7, "sugar_g": 9.3, "unsaturated_fat_g": 43.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "t
{"slug": "polenta-with-hot-tomato-eggplant-sauce", "nyt_id": 10897, "url": "https://cooking.nytimes.com/recipes/10897-polenta-with-hot-tomato-eggplant-sauce", "name": "Polenta With Hot Tomato-Eggplant Sauce", "author": "Marian Burros", "description": "", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "About 40 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ pounds eggplant", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "eggplant", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cloves garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 4, "raw": "⅛ teaspoon hot-pepper flakes", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "hot-pepper flakes", "preparation": null, "optional": false}, {"position": 5, "raw": "2 cups canned no-salt-added tomatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "canned no-salt-added tomatoes", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon balsamic vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "6 tablespoons instant or finely ground polenta", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "instant or finely ground polenta", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"posi
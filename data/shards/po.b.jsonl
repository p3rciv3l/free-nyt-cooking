{"slug": "poached-cucumbers-with-marrow", "nyt_id": 10485, "url": "https://cooking.nytimes.com/recipes/10485-poached-cucumbers-with-marrow", "name": "Poached Cucumbers With Marrow", "author": "Marian Burros", "description": "", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "10 two-inch Kirby cucumbers", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "two-inch kirby cucumbers", "preparation": null, "optional": false}, {"position": 2, "raw": "2 pounds beef-marrow bone, cut in 10 one inch lengths by butcher", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "beef-marrow bone", "preparation": "cut in 10 one inch lengths by butcher", "optional": false}, {"position": 3, "raw": "1 ¼ cups brown sauce (see note)", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "brown sauce (see note)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel cucumbers and remove seeds. Hollow out slightly to make boat. Trim bottom to make cucumbers stand flat, if necessary. Poach in salted water for 10 to 15 minutes, or until tender-firm. Drain and set aside, but keep warm."}, {"position": 2, "text": "Gently poach marrow bone in boiling water to barely cover, one and one-half to two minutes. Marrow should remain pink. Carefully remove marrow from bone with grapefruit knife. Set aside."}, {"position": 3, "text": "Heat brown sauce."}, {"position": 4, "text": "Coat 10 small plates with brown sauce, reserving enough to place one teaspoon in cavity of each cucumber boat. Place one slice of marrow on top."}], "nutrition": null, "tags": {"cuisine": ["nordic"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["beef", "cucumber", "five ingredient", "poach"]}, "images": [], "rating":
{"slug": "lucciariello-broccoli-and-sausage-pie", "nyt_id": 3149, "url": "https://cooking.nytimes.com/recipes/3149-lucciariello-broccoli-and-sausage-pie", "name": "Lucciariello (Broccoli and Sausage Pie)", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "2 hours 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 recipe pizza dough (see above)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "recipe pizza dough (see above)", "preparation": null, "optional": false}, {"position": 2, "raw": "12 ounces broccoli", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "broccoli", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cloves garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon red pepper flakes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "red pepper flakes", "preparation": null, "optional": false}, {"position": 6, "raw": "4 Italian butcher sausages or coarse-cut pork sausages", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "italian butcher sausages or coarse-cut pork sausages", "preparation": null, "optional": false}, {"position": 7, "raw": "2 large ripe tomatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large ripe tomatoes", "preparation": null, "optional": false}, {"position": 8, "raw": "salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 425 degrees. Divide the dough into two parts, one slightly larger than the other. Roll out the larger piece into a 12-inch circle and let it rise on a flat oiled pizza tin. Roll out the second piece into a slightly smaller circle and leave it on a floured work surface."}, {"position": 2, "text": "Trim the broccoli, cook in salted boiling water until almost tender, drain and chop into pieces the size of small walnuts. In a saute or frying pan, heat two tablespoons of the olive oil and warm the garlic, sliced, and the red pepper flakes. Do not let these burn. Add the broccoli and turn it until it has absorbed the flavors."}, {"position": 3, "text": "In another pan, heat another tablespoon of oil and gently brown the sausages, skinned and crumbled into small pieces. Mix the broccoli and cooked sausage, taste to check the seasoning and let the mixture cool."}, {"position": 4, "text": "Spread the filling over the larger circle of dough, leaving a border around the edge. Peel and thinly slice the tomatoes and arrange them over the filling, then salt and pepper to taste. Take the smaller circle of dough and place it on top of the filling. Bring the edges of the bottom circle up and over the top circle, pinching them together to tightly seal. Paint on the remaining olive oil and bake for 20 to 25 minutes until the crust is golden and crisp."}], "nutrition": {"calories": 340.5, "protein_g": 12.8, "carbohydrates_g": 25.3, "fat_g": 21.6, "saturated_fat_g": 5.0, "trans_fat_g": 0.1, "cholesterol_mg": 31.7, "sodium_mg": 591.7, "fiber_g": 3.1, "sugar_g": 4.6, "unsaturated_fat_g": 14.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "broccoli", "pizza dough", "pizza and calzones", "sausage"]}, "images": [], "rating": {"average": 4.0, "count": 7}, "video_url": null, "comment_count": null, "published_at": "1991-08-04", "scraped_at": "2026-09-07T04:59:46.454357+00:00", "scraper_version": "1.0.0"}
{"slug": "lucy-ferignos-ricotta-cake", "nyt_id": 3032, "url": "https://cooking.nytimes.com/recipes/3032-lucy-ferignos-ricotta-cake", "name": "Lucy Ferigno's Ricotta Cake", "author": "Nancy Harmon Jenkins", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "2 hours, plus cool time"}}, "ingredients": [{"position": 1, "raw": "1 ¼ pounds fresh whole-milk ricotta", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "lb", "item": "fresh whole-milk ricotta", "preparation": null, "optional": false}, {"position": 2, "raw": "pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 4, "raw": "4 tablespoons sugar", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "4 large eggs, separated", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "separated", "optional": false}, {"position": 6, "raw": "1 teaspoon freshly grated orange rind", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "freshly grated orange rind", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon candied orange peel", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "candied orange peel", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons confectioner's sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "confectioner's sugar", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon powdered cinnamon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "powdered cinnamon", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place ricotta in a fine-mesh sieve and set aside to drain for approximately one hour."}, {"position": 2, "text": "Preheat oven to 375 degrees."}, {"position": 3, "text": "In a large bowl, mix together drained ricotta, salt, flour, sugar, egg yolks and orange rind. Beat well for approximately five minutes until mixture is thick. Add candied peel and mix well with a wooden spoon to distribute pieces throughout mixture."}, {"position": 4, "text": "In a separate bowl, beat egg whites until stiff. Fold gently but thoroughly into egg yolk mixture."}, {"position": 5, "text": "Butter and flour a deep, round, springform cake pan, 8 ½ to 9 inches in diameter. Pour batter into pan - it should not be more than half full. Place in oven and bake for 40 to 45 minutes, or until middle is firm to the touch and cake is lightly golden brown on top."}, {"position": 6, "text": "Remove from oven and set aside to cool. As the cake cools, it will shrink somewhat. When cool, remove sides of pan and gently transfer cake to a serving dish. Sift confectioner's sugar and cinnamon, mixed together, over the top."}], "nutrition": {"calories": 179.4, "protein_g": 8.6, "carbohydrates_g": 14.8, "fat_g": 9.6, "saturated_fat_g": 5.3, "trans_fat_g": 0.2, "cholesterol_mg": 127.7, "sodium_mg": 132.1, "fiber_g": 0.3, "sugar_g": 8.5, "unsaturated_fat_g": 3.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "egg", "ricotta"]}, "images": [], "rating": {"average": 4.0, "count": 74}, "video_url": null, "comment_count": null, "published_at": "1985-09-25", "scraped_at": "2026-09-07T04:53:57.994845+00:00", "scraper_version": "1.0.0"}
{"slug": "lucy-ferignos-ricotta-puffs", "nyt_id": 3030, "url": "https://cooking.nytimes.com/recipes/3030-lucy-ferignos-ricotta-puffs", "name": "Lucy Ferigno's Ricotta Puffs", "author": "Nancy Harmon Jenkins", "description": "", "servings": {"text": "24 to 30 puffs", "min": 24, "max": 30, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 135, "raw": {"total": "2 hours 15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound fresh whole-milk ricotta", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fresh whole-milk ricotta", "preparation": null, "optional": false}, {"position": 2, "raw": "3 eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons anise- or orange-flavored liqueur", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "anise- or orange-flavored liqueur", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": null, "optional": false}, {"position": 6, "raw": "4 teaspoons baking powder", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 8, "raw": "Oil for deep frying", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "oil for deep frying", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup confectioner's sugar, more if necessary", "group":
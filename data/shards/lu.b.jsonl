{"slug": "lucciariello-broccoli-and-sausage-pie", "nyt_id": 3149, "url": "https://cooking.nytimes.com/recipes/3149-lucciariello-broccoli-and-sausage-pie", "name": "Lucciariello (Broccoli and Sausage Pie)", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "2 hours 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 recipe pizza dough (see above)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "recipe pizza dough (see above)", "preparation": null, "optional": false}, {"position": 2, "raw": "12 ounces broccoli", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "broccoli", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cloves garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon red pepper flakes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "red pepper flakes", "preparation": null, "optional": false}, {"position": 6, "raw": "4 Italian butcher sausages or coarse-cut pork sausages", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "italian butcher sausages or coarse-cut pork sausages", "preparation": null, "optional": false}, {"position": 7, "raw": "2 large ripe tomatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large ripe tomatoes", "preparation": null, "optional": false}, {"position": 8, "raw": "salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 425 degrees. Divide the dough into two parts, one slightly larger than the other. Roll out the larger piece into a 12-inch circle and let it rise on a flat oiled pizza tin. Roll out the second piece into a slightly smaller circle and leave it on a floured work surface."}, {"position": 2, "text": "Trim the broccoli, cook in salted boiling water until almost tender, drain and chop into pieces the size of small walnuts. In a saute or frying pan, heat two tablespoons of the olive oil and warm the garlic, sliced, and the red pepper flakes. Do not let these burn. Add the broccoli and turn it until it has absorbed the flavors."}, {"position": 3, "text": "In another pan, heat another tablespoon of oil and gently brown the sausages, skinned and crumbled into small pieces. Mix the broccoli and cooked sausage, taste to check the seasoning and let the mixture cool."}, {"position": 4, "text": "Spread the filling over the larger circle of dough, leaving a border around the edge. Peel and thinly slice the tomatoes and arrange them over the filling, then salt and pepper to taste. Take the smaller circle of dough and place it on top of the filling. Bring the edges of the bottom circle up and over the top circle, pinching them together to tightly seal. Paint on the remaining olive oil and bake for 20 to 25 minutes until the crust is golden and crisp."}], "nutrition": {"calories": 340.5, "protein_g": 12.8, "carbohydrates_g": 25.3, "fat_g": 21.6, "saturated_fat_g": 5.0, "trans_fat_g": 0.1, "cholesterol_mg": 31.7, "sodium_mg": 591.7, "fiber_g": 3.1, "sugar_g": 4.6, "unsaturated_fat_g": 14.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "broccoli", "pizza dough", "pizza and calzones", "sausage"]}, "images": [], "rating": {"average": 4.0, "count": 7}, "video_url": null,
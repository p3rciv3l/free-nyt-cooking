{"slug": "luteces-bay-scallops-with-tomato-and-chives", "nyt_id": 7696, "url": "https://cooking.nytimes.com/recipes/7696-luteces-bay-scallops-with-tomato-and-chives", "name": "Lutece's Bay Scallops With Tomato and Chives", "author": "Mark Bittman", "description": "Mark Bittman", "servings": {"text": "4 appetizer or 2 small main-course servings", "min": 4, "max": 4, "yield_type": "other"}, "time": {"prep_minutes": null, "cook_minutes": 15, "total_minutes": 15, "raw": {"cook": "15 minutes", "total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "3 ripe tomatoes, peeled and seeded", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "ripe tomatoes", "preparation": "peeled and seeded", "optional": false}, {"position": 2, "raw": "1 shallot, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "shallot", "preparation": "chopped", "optional": false}, {"position": 3, "raw": "½ garlic clove, minced", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "garlic clove", "preparation": "minced", "optional": false}, {"position": 4, "raw": "⅓ cup heavy cream", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup chopped parsley", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 6, "raw": "20 bay scallops", "group": null, "quantity": 20.0, "quantity_max": null, "unit": null, "item": "bay scallops", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons butter, cut into bits", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": "cut into bits", "optional": false}, {"position": 8, "raw": "¼ cup minced chives", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "minced chives", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon fish stock or water, if necessary", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fish stock or water", "preparation": "if necessary", "optional": false}, {"position": 10, "raw": "½ lemon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemon", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 400 degrees."}, {"position": 2, "text": "Puree the tomatoes in a food mill, blender or food processor. Combine in a small nonreactive saucepan with the shallot, garlic and cream. Bring to a boil, turn the heat to low and cook for 2 minutes. Stir in the parsley, and keep warm."}, {"position": 3, "text": "Place the scallops on a nonstick or lightly greased baking sheet, and bake for 3 minutes."}, {"position": 4, "text": "Reheat the sauce slightly; over minimum heat, whisk in the butter a little at a time until the sauce thickens slightly. Add the chives. Adjust the texture of the sauce by reducing it a little further or by stirring in a little of the fish stock or water. Taste the sauce, and add a little lemon juice if it is bland. Serve the scallops with a bit of the sauce."}], "nutrition": {"calories": 263.7, "protein_g": 17.4, "carbohydrates_g": 12.1, "fat_g": 16.7, "saturated_fat_g": 10.1, "unsaturated_fat_g": null, "trans_fat_g": 0.3, "cholesterol_mg": 75.3, "sodium_mg": 511.1, "fiber_g": 2.1, "sugar_g": 4.5, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["main course"], "meal": [], "occasion": [], "other": ["bake", "bay scallop", "cream", "dinner", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 16}, "video_url": null, "comment_count": null, "published_at": "1997-02-05", "scraped_at": "2026-09-07T10:08:59.862809+00:00", "scraper_version": "1.0.0"}

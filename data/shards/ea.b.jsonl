{"slug": "easter-dandelion-salad-salade-de-pissenlit-pasquale", "nyt_id": 2057, "url": "https://cooking.nytimes.com/recipes/2057-easter-dandelion-salad-salade-de-pissenlit-pasquale", "name": "Easter Dandelion Salad (Salade De Pissenlit Pasquale)", "author": "Marian Burros", "description": "", "servings": {"text": "Ten servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 ½ pounds dandelion greens", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "lb", "item": "dandelion greens", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup finely diced smoked bacon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "finely diced smoked bacon", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons tarragon vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "tarragon vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons peanut oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "peanut oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "½ tablespoon Dijon mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 7, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup croutons", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "croutons", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 10, "raw": "5 hard-cooked eggs", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "hard-cooked eggs", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Wash, clean and trim the dandelion greens. Soak for 30 minutes in cold water. Dry and put them in a salad bowl."}, {"position": 2, "text": "Saute the diced bacon, shaking the pan until the bacon browns a bit; drain on a paper towel and then add to the salad."}, {"position": 3, "text": "Discard the drippings and add the vinegar to the hot skillet. Bring to a boil and pour over the dandelions. Cover the bowl for five minutes."}, {"position": 4, "text": "Mix the oils, mustard, salt and pepper into the salad."}, {"position": 5, "text": "Saute the croutons in the butter and sprinkle on top of the salad."}, {"position": 6, "text": "Arrange sliced eggs around the edge of the salad."}], "nutrition": {"calories": 197.3, "protein_g": 7.6, "carbohydrates_g": 13.2, "fat_g": 13.7, "saturated_fat_g": 4.4, "trans_fat_g": 0.0, "cholesterol_mg": 88.2, "sodium_mg": 372.8, "fiber_g": 4.3, "sugar_g": 1.1, "unsaturated_fat_g": 8.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": [], "meal": [], "occasion": ["easter"], "other": ["bacon", "dandelion greens", "egg", "salad", "saute", "spring"]}, "images": [], "rating": {"average": 4.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "1987-04-12", "scraped_at": "2026-09-07T00:07:46.944102+00:00", "scraper_version": "1.0.0"}
{"slug": "easy-thai-beef-salad", "nyt_id": 3170, "url": "https://cooking.nytimes.com/recipes/3170-easy-thai-beef-salad", "name": "Easy Thai Beef Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "Eight servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes, plus refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 cup fresh lime juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh lime juice", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup Thai fish sauce (nam pla)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "thai fish sauce (nam pla)", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons minced Thai chili or jalapeno", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "minced thai chili or jalapeno", "preparation": null, "optional": false}, {"position": 5, "raw": "2 small tomatoes, peeled, seeded, cored and diced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small tomatoes", "preparation": "peeled, seeded, cored and diced", "optional": false}, {"position": 6, "raw": "2 small cucumbers, peeled, seeded and diced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small cucumbers", "preparation": "peeled, seeded and diced", "optional": false}, {"position": 7, "raw": "2 12-ounce pieces flank steak", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "12-ounce pieces flank steak", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup fresh mint leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh mint leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Prepare a charcoal fire. Combine the lime juice, fish sauce, sugar and chili in a large glass or ceramic bowl. Add the tomatoes and cucumbers. Toss. Refrigerate."}, {"position": 2, "text": "Grill the steaks over hot coals until medium rare, about 3 to 5 minutes per side. Let stand for 5 minutes. Slice the meat across the grain into thin slices. Add to the salad. Add mint leaves and toss well. Serve at room temperature."}], "nutrition": {"calories": 176.3, "protein_g": 19.9, "carbohydrates_g": 8.3, "fat_g": 7.3, "saturated_fat_g": 3.0, "trans_fat_g": 0.0, "cholesterol_mg": 57.8, "sodium_mg": 1465.1, "fiber_g": 1.4, "sugar_g": 4.1, "unsaturated_fat_g": 3.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["thai"], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["grill", "lime juice", "mint", "salad", "steak", "summer"]}, "images": [], "rating": {"average": 4.0, "count": 35}, "video_url": null, "comment_count": null, "published_at": "1994-05-22", "scraped_at": "2026-09-07T00:18:42.910714+00:00", "scraper_version": "1.0.0"}
{"slug": "easy-yogurt-muffins", "nyt_id": 787075249, "url": "https://cooking.nytimes.com/recipes/787075249-easy-yogurt-muffins", "name": "Easy Yogurt Muffins", "author": "Clare de Boer", "description": "These muffins remove the pesky aspects of baking with kids without losing any of the joy. The batter is made entirely in a food processor, so you don’t have to worry about the delayed gratification of tempering butter or the potential burns that come with using the melted kind. There are plenty of opportunities to press buttons! The food processor also lets you skip processed sugar. This recipe uses dates instead, creaming them into the butter in the first step. You can let your kids go nuts decorating the tops with whatever they like (our favorite is blueberries) before sliding them into the oven. The resulting muffins are just sweet enough to qualify as a treat, and they're lovely enough for grown-ups, too. If you don’t have a food processor, finely chop the dates and have your kid smush them with a pestle and mortar before beating them into the butter by hand.", "servings": {"text": "12 muffins", "min": 12, "max": 12, "yield_type": "pieces"}, "time": {"prep_minutes": 10, "cook_minutes": 30, "total_minutes": 40, "raw": {"total": "40 min plus cooling time", "prep": "PT0H10M", "cook": "PT0H30M"}}, "ingredients": [{"position": 1, "raw": "8 tablespoons/113 grams unsalted butter, plus more for greasing the tin", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "tablespoons/113 grams unsalted butter", "preparation": "plus more for greasing the tin", "optional": false}, {"position": 2, "raw": "8 large Medjool dates, pitted", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "large medjool dates", "preparation": "pitted", "optional": false}, {"position": 3, "raw": "3 large eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup whole-milk yogurt (preferably European style)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "whole-milk yogurt (preferably european style)", "preparation": null, "optional": false}, {"position": 5, "raw": "2 to 4 tablespoons maple syrup (depending on desired sweetness)", "group": null, "quantity": 2.0, "quantity_max": 4.0, "unit": "tbsp", "item": "maple syrup (depending on desired sweetness)", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons vanilla extract", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon kosher salt (such as Diamond Crystal)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt (such as diamond crystal)", "preparation": null, "optional": false}, {"position": 8, "raw": "½ teaspoon ground cinnamon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 9, "raw": "1¾ cups/225 grams all-purpose flour, or another flour such as spelt or einkorn", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "¾ cups/225 grams all-purpose flour", "preparation": "or another flour such as spelt or einkorn", "optional": false}, {"position": 10, "raw": "½ cup/50 grams almond meal", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "cup/50 grams almond meal", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons ground flaxseed (optional)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "ground flaxseed", "preparation": null, "optional": true}, {"position": 12, "raw": "1 tablespoon baking powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 13, "raw": "½ teaspoon baking soda", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 14, "raw": "Banana slices", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "banana slices", "preparation": null, "optional": false}, {"position": 15, "raw": "Fresh or frozen berries", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "fresh or frozen berries", "preparation": null, "optional": false}, {"position": 16, "raw": "Rolled oats", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "rolled oats", "preparation": null, "optional": false}, {"position": 17, "raw": "Chopped nuts", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "chopped nuts", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oven to 375 degrees. Grease a standard 12-cup muffin tin or line it with paper liners."}, {"position": 2, "text": "Place the butter, dates and eggs in the bowl of a food processor. Process until light and fluffy and the dates have nearly disappeared, 3 to 5 minutes. The mixture may look a little split but it will come back together."}, {"position": 3, "text": "Add the yogurt, maple syrup, vanilla, salt and cinnamon; process until smooth."}, {"position": 4, "text": "Add the flour, almond meal, flaxseed (if using), baking powder and baking soda. Pulse briefly, just until no dry flour remains. Do not overmix."}, {"position": 5, "text": "Divide the batter evenly among the prepared muffin cups (about ⅓ cup per muffin)."}, {"position": 6, "text": "Decorate the muffin tops as you like, pressing the toppings lightly into the batter. Scatter some with berries, others with chopped nuts or rolled oats. Every muffin can be different."}, {"position": 7, "text": "Bake until the muffins are puffed, golden and a skewer inserted into the center comes out clean, 22 to 25 minutes. Cool in the pan for 5 minutes before transferring to a wire rack. Muffins are best eaten the day they are baked, or can be frozen for a month or two."}], "nutrition": {"calories": 268.4, "protein_g": 6.6, "carbohydrates_g": 36.2, "fat_g": 12.4, "saturated_fat_g": 5.8, "trans_fat_g": 0.0, "cholesterol_mg": 68.7, "sodium_mg": 228.6, "fiber_g": 4.4, "sugar_g": 19.8, "unsaturated_fat_g": 4.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["soy-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "alcohol-free", "vegetarian", "pescatarian", "healthy", "peanut-free"], "course": [], "meal": ["breakfast", "snack"], "occasion": [], "other": ["medjool date", "maple syrup", "yogurt", "muffin", "bake", "food processor", "easy", "quick", "almond flour", "kid-friendly", "freezer friendly", "baking"]}, "images": [{"url": "https://static01.nyt.com/images/2026/08/19/multimedia/19FD-KIDS-MUFFINSREX-CDB-Easy-Yogurt-Muffins-1-bkmv/19FD-KIDS-MUFFINSREX-CDB-Easy-Yogurt-Muffins-1-bkmv-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 53}, "video_url": null, "comment_count": null, "published_at": "2026-08-18", "scraped_at": "2026-09-06T22:28:03.128093+00:00", "scraper_version": "1.0.0"}

{"slug": "adi-giovanettis-pasta-alla-checca-linguine-with-fresh-herbs", "nyt_id": 3389, "url": "https://cooking.nytimes.com/recipes/3389-adi-giovanettis-pasta-alla-checca-linguine-with-fresh-herbs", "name": "Adi Giovanetti's Pasta Alla Checca (Linguine with fresh herbs)", "author": "Nancy Harmon Jenkins", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons extravirgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extravirgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "½ medium yellow onion, chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "medium yellow onion", "preparation": "chopped", "optional": false}, {"position": 3, "raw": "1 16-ounce can imported Italian tomatoes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "16-ounce can imported italian tomatoes", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "1 bunch arugula (see note)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "arugula (see note)", "preparation": null, "optional": false}, {"position": 6, "raw": "½ pound grated pecorino Romano cheese", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "grated pecorino romano cheese", "preparation": null, "optional": false}, {"position": 7, "raw": "1 pound linguine or spaghettini or other thin pasta", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "linguine or spaghettini or other thin pasta", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Over medium heat, saute the chopped onion in the olive oil until onion is just golden brown. Remove from heat and add the tomatoes, juice and all. Crush the tomatoes slightly with a fork. Return to low heat and simmer until the sauce has thickened. Taste for seasoning and add salt and freshly ground black pepper if desired."}, {"position": 2, "text": "While the sauce is cooking, wash and dry the arugula, discarding thick stems. Cut into thin ribbons and set aside."}, {"position": 3, "text": "Bring 4 quarts of water to a rolling boil. Add salt if desired and when water reboils, add pasta. Stir vigorously with a long-handled wooden spoon or fork to separate pasta strands and bring water quickly back to a boil."}, {"position": 4, "text": "When pasta is done, drain quickly and turn into a warm serving bowl. Remove sauce from fire and add the arugola, stirring to mix well. Pour sauce over pasta and sprinkle with half the pecorino cheese. Serve immediately, passing the rest of the cheese separately."}], "nutrition": {"calories": 493.5, "protein_g": 23.6, "carbohydrates_g": 63.2, "fat_g": 16.3, "saturated_fat_g": 7.4, "trans_fat_g": 0.0, "cholesterol_mg": 39.3, "sodium_mg": 642.8, "fiber_g": 4.8, "sugar_g": 5.4, "unsaturated_fat_g": 7.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["arugula", "boil", "easy", "five ingredient", "pasta", "pastas", "quick", "saute", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 13}, "video_url": null, "comment_count": null, "published_at": "1984-05-09", "scraped_at": "2026-09-07T05:10:35.507523+00:00", "scraper_version": "1.0.0"}
{"slug": "adolfo-calless-aioli", "nyt_id": 4438, "url": "https://cooking.nytimes.com/recipes/4438-adolfo-calless-aioli", "name": "Adolfo Calles's Aioli", "author": "Susan Herrmann Loomis", "description": "", "servings": {"text": "1 1/3 cups", "min": 1, "max": 1, "yield_type": "volume"}, "time": {"prep_minutes": 5, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "5 minutes", "prep": "5 minutes"}}, "ingredients": [{"position": 1, "raw": "1 whole egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "whole egg", "preparation": null, "optional": false}, {"position": 2, "raw": "1 egg yolk", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg yolk", "preparation": null, "optional": false}, {"position": 3, "raw": "Juice from ½ lemon, about 2 tablespoons", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice from ½ lemon", "preparation": "about 2 tablespoons", "optional": false}, {"position": 4, "raw": "10 cloves garlic, peeled", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon Dijon-style mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dijon-style mustard", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup extra-virgin olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place all ingredients except olive oil in work bowl of a food processor fitted with a steel blade; puree them. With food processor on, gradually add oil in a thin stream. Aioli will thicken, but it will be less thick than regular mayonnaise."}], "nutrition": {"calories": 194.5, "protein_g": 0.9, "carbohydrates_g": 1.4, "fat_g": 21.0, "saturated_fat_g": 3.0, "trans_fat_g": 0.0, "cholesterol_mg": 28.6, "sodium_mg": 76.2, "fiber_g": 0.2, "sugar_g": 0.2, "unsaturated_fat_g": 17.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["condiments", "egg", "garlic", "lemon juice"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1987-09-30", "scraped_at": "2026-09-07T06:00:06.664174+00:00", "scraper_version": "1.0.0"}

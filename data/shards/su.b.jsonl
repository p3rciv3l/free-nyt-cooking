{"slug": "summer-melon-spoon-salad", "nyt_id": 785872919, "url": "https://cooking.nytimes.com/recipes/785872919-summer-melon-spoon-salad", "name": "Summer Melon Spoon Salad", "author": "Genevieve Ko", "description": "Meant to be scooped into your mouth with a spoon — all the better to capture the lemony dressing in each bite — this cool monochrome salad of juicy sweet melon and crisp cucumbers is especially refreshing. The chefs Sarah Hymanson and Sara Kramer don’t serve it at their Los Angeles restaurants, but they created it for “Kismet” (Clarkson Potter, 2024), their cookbook of the same name. In it, they capture their love of fruits and vegetables with dishes meant for home cooks, and this is their California take on classic Middle Eastern diced tomato-cucumber salads. Mixing in ripe avocado at the end keeps the cubes from falling apart but still lends creaminess to the mix. It’s a great dish to serve with other salads, anything grilled or just a hunk of bread for a light meal. Genevieve Ko", "servings": {"text": "4-6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 15, "cook_minutes": 5, "total_minutes": 20, "raw": {"total": "20 min", "prep": "PT0H15M", "cook": "PT0H5M"}}, "ingredients": [{"position": 1, "raw": "2 cups diced seeded green melon, such as honeydew", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "diced seeded green melon", "preparation": "such as honeydew", "optional": false}, {"position": 2, "raw": "2 cups diced mini cucumbers (3 or 4 cucumbers)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "diced mini cucumbers (3 or 4 cucumbers)", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons finely chopped white onion", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped white onion", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup extra-virgin olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup lemon juice (from about 2 lemons)", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "lemon juice (from about 2 lemons)", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons kosher salt (such as Diamond Crystal)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt (such as diamond crystal)", "preparation": null, "optional": false}, {"position": 7, "raw": "⅛ teaspoon freshly ground black pepper", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ripe avocado, diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "ripe avocado", "preparation": "diced", "optional": false}, {"position": 9, "raw": "½ cup basil leaves, torn if large", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "basil leaves", "preparation": "torn if large", "optional": false}, {"position": 10, "raw": "¼ cup dill leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dill leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large bowl, combine the melon, cucumbers and onion. (To make ahead, cover and refrigerate for up to 6 hours.)"}, {"position": 2, "text": "Add the olive oil, lemon juice, salt and pepper and toss gently to coat. Just before serving, add the avocado, basil and dill and lightly toss to mix well."}], "nutrition": {"calories": 185.0, "protein_g": 2.3, "carbohydrates_g": 15.7, "fat_g": 14.2, "saturated_fat_g": 2.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 645.0, "fiber_g": 3.7, "sugar_g": 8.3, "unsaturated_fat_g": 11.5, "source": "nyt", "basis": "per_serving", "computed
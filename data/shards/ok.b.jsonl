{"slug": "oklahoma-black-eyed-peas", "nyt_id": 2919, "url": "https://cooking.nytimes.com/recipes/2919-oklahoma-black-eyed-peas", "name": "Oklahoma Black-Eyed Peas", "author": "Linda Wells", "description": "", "servings": {"text": "Eight servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "About 2 hours"}}, "ingredients": [{"position": 1, "raw": "2 strips bacon", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "strip", "item": "bacon", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup chopped onions", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped onions", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup chopped bell pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped bell pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup chopped celery", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped celery", "preparation": null, "optional": false}, {"position": 5, "raw": "2 to 3 tomatoes, skinned, seeded and chopped", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": null, "item": "tomatoes", "preparation": "skinned, seeded and chopped", "optional": false}, {"position": 6, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon minced fresh basil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh basil", "preparation": null, "optional": false}, {"position": 9, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "qu
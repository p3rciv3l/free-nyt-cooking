{"slug": "okra-rice-and-hominy-soup", "nyt_id": 8509, "url": "https://cooking.nytimes.com/recipes/8509-okra-rice-and-hominy-soup", "name": "Okra, Rice and Hominy Soup", "author": "Molly O’Neill", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 45, "total_minutes": 45, "raw": {"cook": "45 minutes", "total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "⅔ cup Basmati rice", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "basmati rice", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ¼ cups water", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ¾ teaspoons salt", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 4, "raw": "1 10-ounce package frozen cut okra", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "-ounce package frozen cut okra", "preparation": null, "optional": false}, {"position": 5, "raw": "3 cups chicken broth", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 6, "raw": "1 15-ounce can hominy, drained and rinsed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "-ounce can hominy", "preparation": "drained and rinsed", "optional": false}, {"position": 7, "raw": "1 large jalapeno pepper, seeded and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large jalapeno pepper", "preparation": "seeded and minced", "optional": false}, {"position": 8, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": 
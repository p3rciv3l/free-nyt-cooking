{"slug": "okra-with-tomato-sauce-dips-country-kitchen", "nyt_id": 2089, "url": "https://cooking.nytimes.com/recipes/2089-okra-with-tomato-sauce-dips-country-kitchen", "name": "Okra With Tomato Sauce (Dip's Country Kitchen)", "author": "Craig Claiborne", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds fresh baby okra or two 10-ounce packages of frozen whole okra", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "fresh baby okra or two 10-ounce packages of frozen whole okra", "preparation": null, "optional": false}, {"position": 2, "raw": "4 cups canned tomatoes", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "canned tomatoes", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 5, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Wash the okra, whether fresh or frozen, well in cold water. If frozen is used, continue rinsing until the okra is defrosted. Drain well."}, {"position": 2, "text": "Put the okra in a saucepan and add about ½-cup of cold water. Bring to the boil and cover. Let cook about seven minutes."}, {"position": 3, "text": "Meanwhile, blend the tomatoes thoroughly in the container of a food processor or electric blender."}, {"position": 4, "tex
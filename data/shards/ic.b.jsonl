{"slug": "iced-tea-bars", "nyt_id": 1212, "url": "https://cooking.nytimes.com/recipes/1212-iced-tea-bars", "name": "Iced Tea Bars", "author": "Molly O’Neill", "description": "", "servings": {"text": "About 100 bars", "min": 100, "max": 100, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "½ cup plus 2 tablespoons and 1 teaspoon lightly salted butter, softened", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "plus 2 tablespoons and 1 teaspoon lightly salted butter", "preparation": "softened", "optional": false}, {"position": 2, "raw": "1 cup plus 2 tablespoons flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "plus 2 tablespoons flour", "preparation": null, "optional": false}, {"position": 3, "raw": "2 eggs, well beaten", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "well beaten", "optional": false}, {"position": 4, "raw": "⅛ teaspoon salt", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups brown sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "brown sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup shredded coconut", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "shredded coconut", "preparation": null, "optional": false}, {"position": 8, "raw": "¾ chopped pecans", "group": null, "quantity": 0.75, "quantity_max": null, "unit": null, "item": "chopped pecans", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ½ cup sifted po
: null, "unit": "cup", "item": "finely chopped flat-leaf parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "Juice of two lemons", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of two lemons", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 11, "raw": "2 teaspoons salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Pass the tomatoes through a food mill and refrigerate overnight. Gently strain through a fine-mesh strainer and season to taste with salt and pepper."}, {"position": 2, "text": "cover the bulgur with cold water and soak for 2 hours. Drain and squeeze out the excess water. In a bowl, combine the bulgur, onion, mint, parsley, lemon juice and oil and stir well. Add salt to taste."}, {"position": 3, "text": "To serve, ladle the tomato essence into 6 bowls. Garnish with cucumber and salad."}], "nutrition": {"calories": 364.4, "protein_g": 8.9, "carbohydrates_g": 46.0, "fat_g": 19.7, "saturated_fat_g": 2.8, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 1591.7, "fiber_g": 11.2, "sugar_g": 16.5, "unsaturated_fat_g": 15.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["cucumber", "project", "salad", "soup", "summer", "tomato"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1997-06-22", "scraped_at": "2026-09-07T01:18:17.007401+00:00", "scraper_version": "1.0.0"}
{"slug": "icelandic-lamb-loins", "nyt_id": 8931, "url": "https://cooking.nytimes.com/recipes/8931-icelandic-lamb-loins", "name": "Icelandic Lamb Loins", "author": "Jason Epstein", "description": "Icelanders eat lamb at an impressive annual rate, as Jason Epstein noted in his 2002 Times magazine article. While there, he and his friends prepared a few pounds of lamb loin, browning them in butter and finishing them in the oven. “It was an evening I shall never forget,” he wrote, “and one that I have since recreated many times, omitting the sugary potatoes and adding a dab of rosemary-infused demi-glace in a red-wine reduction to the lamb.” He shares that recipe here, and while he recommends the delicate Icelandic variety, domestic lamb will also suffice.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 75, "total_minutes": 75, "raw": {"cook": "1 hour 15 minutes", "total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "3 pounds boned Icelandic lamb loins (about 3 ounces each) and tenderloins (1 to 2 ounces each); see note", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "boned icelandic lamb loins (about 3 ounces each) and tenderloins (1 to 2 ounces each); see note", "preparation": null, "optional": false}, {"position": 2, "raw": "1 bottle pinot noir or other full-bodied red wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bottle pinot noir or other full-bodied red wine", "preparation": null, "optional": false}, {"position": 3, "raw": "1 medium carrot, trimmed, peeled and chopped coarsely", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium carrot", "preparation": "trimmed, peeled and chopped coarsely", "optional": false}, {"position": 4, "raw": "1 medium onion, peeled and chopped coarsely", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "peeled and chopped coarsely", "optional": false}, {"position": 5, "raw": "1 celery rib, trimmed and chopped coarsely", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "celery rib", "preparation": "trimmed and chopped coarsely", "optional": false}, {"position": 6, "raw": "2 cloves garlic, peeled and crushed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and crushed", "optional": false}, {"position": 7, "raw": "1 6 ½-ounce container D'Artagnan Rich Duck and Veal Stock", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "½-ounce container d'artagnan rich duck and veal stock", "preparation": null, "optional": false}, {"position": 8, "raw": "Demi-Glace (see note)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "demi-glace (see note)", "preparation": null, "optional": false}, {"position": 9, "raw": "2 large sprigs fresh rosemary", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large sprigs fresh rosemary", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons peanut or corn oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "peanut or corn oil", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon unsalted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "One hour before you are ready to cook the lamb, remove it from the refrigerator."}, {"position": 2, "text": "Meanwhile, in a 3-quart nonreactive shallow saucepan, bring the wine to a boil. With a long match, ignite the wine and boil for 2 to 3 minutes, or until the flame subsides and the alcohol evaporates. Add the carrot, onion, celery and garlic; cook at a low boil for about 10 minutes, or until reduced by half. Add the demi-glace and simmer about 15 minutes, or until reduced by half. Remove the pan from the heat; add the rosemary to steep and set aside."}, {"position": 3, "text": "Preheat the oven to 500 degrees. Heat a large skillet (preferably cast iron) over high heat. Add 1 tablespoon of the oil. When the oil begins to shimmer, add about half the loins and brown about 1 minute on each side. (Do not overcrowd the meat.) Season with salt and pepper and set aside. Repeat with the remaining loins."}, {"position": 4, "text": "Return all the loins to the skillet and transfer it to the oven. Roast the loins for 4 to 5 minutes, or until the meat is firm to the touch and an instant-read thermometer in the thickest part registers 120 degrees. Transfer the loins to a platter, cover loosely with foil and let stand 5 minutes. (The temperature will reach 125 to 130 degrees for medium rare.)"}, {"position": 5, "text": "Wipe out the skillet. Brown the tenderloins in batches with the remaining tablespoon of oil for 1 to 1 ½ minutes per side for medium rare."}, {"position": 6, "text": "Add any juices from the meat to the reserved sauce. Strain it into a bowl through a fine sieve, pressing the vegetables with the back of a spoon to extract as much liquid as possible. Wipe out the saucepan, add the strained sauce and return to a simmer. Whisk in the butter until melted. Remove from the heat and season with salt and pepper. (Makes about 1 cup.)"}, {"position": 7, "text": "Slice the loins on the bias and the tenderloins into thirds. Divide among 6 plates, nap with sauce and serve with Roasted Tomatoes and Summer Peas (see recipes)."}], "nutrition": {"calories": 1089.3, "protein_g": 48.4, "carbohydrates_g": 8.0, "fat_g": 84.4, "saturated_fat_g": 34.8, "unsaturated_fat_g": null, "trans_fat_g": 0.0, "cholesterol_mg": 221.3, "sodium_mg": 1185.1, "fiber_g": 1.4, "sugar_g": 2.1, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": ["icelandic"], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["carrot", "dinner", "lamb", "onion", "project", "roast", "spring"]}, "images": [], "rating": {"average": 4.0, "count": 28}, "video_url": null, "comment_count": null, "published_at": "2002-07-07", "scraped_at": "2026-09-07T11:02:44.471871+00:00", "scraper_version": "1.0.0"}
{"slug": "icing", "nyt_id": 1645, "url": "https://cooking.nytimes.com/recipes/1645-icing", "name": "Icing", "author": "Moira Hodgson", "description": "", "servings": {"text": "1 12-inch cake", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": 15, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "About 10 minutes", "prep": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound confectioners' sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "confectioners' sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "Juice 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice 1 lemon", "preparation": null, "optional": false}, {"position": 3, "raw": "2 egg whites", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "egg whites", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Sift the sugar carefully to remove all lumps. Stir in the lemon juice. In a separate bowl, whip the egg whites until moderately stiff,"}, {"position": 2, "text": "Stir the egg whites into the sugar and finish beating with an electric beater. Ice the cake immediately. If you cannot ice the cake immediately, cover the icing with a damp cloth, otherwise it will harden."}], "nutrition": {"calories": 1816.3, "protein_g": 6.7, "carbohydrates_g": 460.9, "fat_g": 0.3, "saturated_fat_g": 0.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 98.4, "fiber_g": 2.4, "sugar_g": 446.1, "unsaturated_fat_g": 0.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["british"], "diet": ["vegetarian"], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["confectioners' sugar", "egg white", "lemon juice", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 20}, "video_url": null, "comment_count": null, "published_at": "1989-12-31", "scraped_at": "2026-09-07T03:44:10.85707
aw": "6 slices white bread, crusts removed", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "slice", "item": "white bread", "preparation": "crusts removed", "optional": false}, {"position": 10, "raw": "1 clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 11, "raw": "Pinch each salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch each salt", "preparation": null, "optional": false}, {"position": 12, "raw": "Pinch each white pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch each white pepper", "preparation": null, "optional": false}, {"position": 13, "raw": "Pinch each sugar", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch each sugar", "preparation": null, "optional": false}, {"position": 14, "raw": "1 cup grapeseed oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "grapeseed oil", "preparation": null, "optional": false}, {"position": 15, "raw": "⅓ cup grapeseed oil", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "grapeseed oil", "preparation": null, "optional": false}, {"position": 16, "raw": "½ cup loosely packed Italian parsley leaves", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "loosely packed italian parsley leaves", "preparation": null, "optional": false}, {"position": 17, "raw": "3 ½ ounces spinach leaves, steamed", "group": null, "quantity": 3.5, "quantity_max": null, "unit": "oz", "item": "spinach leaves", "preparation": "steamed", "optional": false}, {"position": 18, "raw": "18-inch piece daikon, peeled, cooked and sliced into ½-inch rounds", "group": null, "quantity": 18.0, "quantity_max": null, "unit": null, "item": "-inch piece daikon", "preparation": "peeled, cooked and sliced into ½-inch rounds", "optional": false}, {"position": 19, "raw": "2 leeks, cleaned, cut in half lengthwise and poached", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "leeks", "preparation": "cleaned, cut in half lengthwise and poached", "optional": false}, {"position": 20, "raw": "4 small Yukon gold potatoes, peeled and boiled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "small yukon gold potatoes", "preparation": "peeled and boiled", "optional": false}, {"position": 21, "raw": "8 ounces soy beans, shelled and cooked", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "soy beans", "preparation": "shelled and cooked", "optional": false}], "steps": [{"position": 1, "text": "Split guinea fowl or poussins. Remove wing portions and backbones. Bone breasts and thighs, leaving breast and thigh pieces attached with skin. Place each piece in a separate zip-top plastic freezer bag and spoon in 2 tablespoons fat. Add a pinch of pepper, sugar and salt to each, expel air from the bags, seal. Squeeze to mix."}, {"position": 2, "text": "For chicken jus: Boil chicken stock in a saucepan until reduced to about 1 ½ cups. Add port and boil until mixture is syrupy and reduced to ⅔ cup, about 20 minutes. Season with soy sauce, walnut oil and salt."}, {"position": 3, "text": "For bread sauce: Place bread, garlic, salt, pepper and sugar in a food processor and blend into crumbs. Drizzle in oil and blend into a paste."}, {"position": 4, "text": "For parsley oil: Combine oil and parsley in a blender and purée."}, {"position": 5, "text": "Heat 3 quarts of water in a 5-quart saucepan to 140 degrees. Place the fowl packets in the water, cover and cook 35 minutes, until you can push your finger into the thigh of the bird. Do not test flesh through the skin side. Remove from bags and arrange on a foil-lined baking sheet. Sprinkle with sea salt and broil until golden on each side, about 8 minutes total."}, {"position": 6, "text": "Reheat jus. Divide the spinach and daikon among 4 plates and drizzle with 2 tablespoons jus. Top each with a half fowl, then the remaining jus. Drizzle with parsley oil and arrange a leek half over top. Place the potatoes, beans and a dollop of bread sauce to the side."}], "nutrition": {"calories": 1714.8, "protein_g": 49.7, "carbohydrates_g": 88.8, "fat_g": 129.2, "saturated_fat_g": 24.5, "unsaturated_fat_g": null, "trans_fat_g": 0.0, "cholesterol_mg": 197.8, "sodium_mg": 1998.2, "fiber_g": 13.2, "sugar_g": 22.7, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": ["australian"], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["boil", "broil", "dinner"]}, "images": [], "rating": {"average": 4.0, "count": 15}, "video_url": null, "comment_count": null, "published_at": "2001-11-04", "scraped_at": "2026-09-07T11:25:35.446345+00:00", "scraper_version": "1.0.0"}
{"slug": "guinness-stout-ice-cream", "nyt_id": 10608, "url": "https://cooking.nytimes.com/recipes/10608-guinness-stout-ice-cream", "name": "Guinness Stout Ice Cream", "author": "Daisann McLane", "description": "", "servings": {"text": "About 5 1/2 cups ice cream", "min": 5, "max": 5, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 195, "raw": {"total": "15 minutes, plus 3 hours' freezing"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons cornstarch", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup sweetened condensed milk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sweetened condensed milk", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ cups evaporated milk", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "evaporated milk", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup Guinness stout", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "guinness stout", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a heavy saucepan, dissolve the cornstarch in the water and cook, stirring constantly with a wire whisk, over medium heat until the mixture thickens slightly, about 2 minutes."}, {"position": 2, "text": "Reduce the heat to low and stir in both milks, salt and sugar. Cook, stirring, until the sugar is completely dissolved, about 1 to 2 minutes."}, {"position": 3, "text": "Remove from the heat and let cool. Stir in the stout and pour into a freezer-proof bowl and place in the freezer."}, {"position": 4, "text": "When the mixture starts to set, about 45 minutes to 1 hour, remove from the freezer and whip well. Return the mixture to the freezer and allow to freeze through, about 2 hours."}], "nutrition": {"calories": 332.2, "protein_g": 4.8, "carbohydrates_g": 67.5, "fat_g": 5.2, "saturated_fat_g": 3.2, "trans_fat_g": 0.0, "cholesterol_mg": 20.2, "sodium_mg": 149.6, "fiber_g": 0.0, "sugar_g": 65.0, "unsaturated_fat_g": 1.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["caribbean"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["evaporated milk", "five ingredient", "ice creams and sorbets", "sweetened condensed milk"]}, "images": [], "rating": {"average": 4.0, "count": 23}, "video_url": null, "comment_count": null, "published_at": "1991-05-26", "scraped_at": "2026-09-07T01:41:21.673357+00:00", "scraper_version": "1.0.0"}

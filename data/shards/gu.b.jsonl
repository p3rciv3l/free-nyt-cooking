{"slug": "guinness-stout-ice-cream", "nyt_id": 10608, "url": "https://cooking.nytimes.com/recipes/10608-guinness-stout-ice-cream", "name": "Guinness Stout Ice Cream", "author": "Daisann McLane", "description": "", "servings": {"text": "About 5 1/2 cups ice cream", "min": 5, "max": 5, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 195, "raw": {"total": "15 minutes, plus 3 hours' freezing"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons cornstarch", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup sweetened condensed milk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sweetened condensed milk", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ cups evaporated milk", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "evaporated milk", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup Guinness stout", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "guinness stout", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a heavy saucepan, dissolve the cornstarch in the water and cook, stirring constantly with a wire whisk, over medium heat until the mixture thickens slightly, about 2 minutes."}, {"position": 2, "text": "Reduce the heat to low and stir in both mi
{"slug": "gulf-shrimp-in-exotic-spice", "nyt_id": 8853, "url": "https://cooking.nytimes.com/recipes/8853-gulf-shrimp-in-exotic-spice", "name": "Gulf Shrimp in Exotic Spice", "author": "Christine Muhlke", "description": "Christine Muhlke", "servings": {"text": "Serves 4 as an appetizer", "min": 4, "max": 4, "yield_type": "other"}, "time": {"prep_minutes": null, "cook_minutes": 30, "total_minutes": 30, "raw": {"cook": "30 minutes", "total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "12 tablespoons unsalted butter, softened", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": "softened", "optional": false}, {"position": 2, "raw": "¼ cup Vadouvan Exotique spice mix", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "vadouvan exotique spice mix", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup red-grapefruit juice", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "red-grapefruit juice", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pinch sea salt or fleur de sel", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pinch", "item": "sea salt or fleur de sel", "preparation": null, "optional": false}, {"position": 5, "raw": "⅓ cup kosher salt", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons white-wine vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "white-wine vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 pound head-on large gulf shrimp or 9 ounces head-off (12 to 15 count per pound)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "head-on large gulf shrimp or 9 ounces head-off (12 to 15 count per pound)", "preparation": null, "optional": false}, {"position": 8, "raw": "1 red grapefruit, peeled and segmented, optional", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red grapefruit", "preparation": "peeled and segmented, optional", "optional": true}], "steps": [{"position": 1, "text": "In a large pot, bring 1 gallon of water to a boil over high heat. In a large skillet, melt 8 tablespoons of butter over medium heat until the butter starts to separate. Add the Vadouvan Exotique and brown the butter over low heat until it begins to smell nutty, 8 to 10 minutes. Let cool until lukewarm, then mix in the remaining butter until incorporated. Stir in the grapefruit juice and season with sea salt."}, {"position": 2, "text": "Season the boiling water with the kosher salt and vinegar. Add the shrimp, cover with a lid and turn off the heat. Poach for 4 minutes, then drain. When cool enough to handle, peel the shrimp, leaving the heads on, and devein."}, {"position": 3, "text": "Toss the shrimp in the spiced butter. Serve with the remaining sauce and, if you choose, grapefruit segments."}], "nutrition": null, "tags": {"cuisine": ["southern"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["poach", "shrimp", "spring", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "2007-03-04", "scraped_at": "2026-09-07T10:59:35.193257+00:00", "scraper_version": "1.0.0"}

{"slug": "cucumber-and-israeli-couscous-salad", "nyt_id": 12607, "url": "https://cooking.nytimes.com/recipes/12607-cucumber-and-israeli-couscous-salad", "name": "Cucumber and Israeli Couscous Salad", "author": "Martha Rose Shulman", "description": "I love this tabbouleh-like mixture because of all the herbs and refreshing flavors, and also because of the nice contrast in textures. Make sure that you cook the couscous until the spheres are tender but not gummy. I have seen package directions that call for too little water; make sure you cook them in twice their volume of water.", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "About 30 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ cup extra virgin olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup Israeli couscous", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "israeli couscous", "preparation": null, "optional": false}, {"position": 3, "raw": "6 to 8 tablespoons fresh lemon juice, to taste", "group": null, "quantity": 6.0, "quantity_max": 8.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": "to taste", "optional": false}, {"position": 4, "raw": "3 cups chopped fresh flat-leaf parsley (from 3 large bunches)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "chopped fresh flat-leaf parsley (from 3 large bunches)", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup chopped fresh mint", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped fresh mint", "preparation": null, "optional": false}, {"position": 6, "raw": "½ pound ripe tomatoes, very finely chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", 
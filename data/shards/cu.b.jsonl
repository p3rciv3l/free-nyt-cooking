e, cut across into ⅛-inch thick slices", "optional": false}, {"position": 8, "raw": "1 small celery root, trimmed, peeled and cut into ¼-inch cubes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small celery root", "preparation": "trimmed, peeled and cut into ¼-inch cubes", "optional": false}, {"position": 9, "raw": "1 medium sweet potato, peeled and cut into ½-inch cubes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium sweet potato", "preparation": "peeled and cut into ½-inch cubes", "optional": false}, {"position": 10, "raw": "3 tablespoons all-purpose flour", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 11, "raw": "2 teaspoons salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 12, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon chopped fresh Italian parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh italian parsley", "preparation": null, "optional": false}, {"position": 14, "raw": "1 cup all-purpose flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 15, "raw": "1 ½ teaspoons baking powder", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 16, "raw": "¾ teaspoon salt", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 17, "raw": "½ teaspoon ground mace", "group": null, "quan
{"slug": "fudge-pudding-cake", "nyt_id": 11285, "url": "https://cooking.nytimes.com/recipes/11285-fudge-pudding-cake", "name": "Fudge Pudding Cake", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "12 to 16 servings", "min": 12, "max": 16, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 80, "raw": {"total": "1 hour 20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ¼ cups whole wheat flour", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "whole wheat flour", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup granulated sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "¾ cup unsweetened cocoa powder", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "unsweetened cocoa powder", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons baking powder", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 large egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup milk", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons vanilla extract", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon instant espresso powder", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "instant espresso powder", "preparation": null, "optional": false}, {"position": 10, "raw": "4 tablespoons unsalted butter, melted", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": "melted", "optional": false}, {"position": 11, "raw": "¾ cup, packed, light or dark brown sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": null, "item": "cup", "preparation": "packed, light or dark brown sugar", "optional": false}, {"position": 12, "raw": "1 ½ cups hot brewed coffee or hot water", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "hot brewed coffee or hot water", "preparation": null, "optional": false}, {"position": 13, "raw": "Vanilla or coffee ice cream for serving", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "vanilla or coffee ice cream for serving", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 350 degrees. In a large bowl, whisk together flour, granulated sugar, ½ cup cocoa, baking powder and salt. In another bowl, beat egg into milk and add vanilla, espresso powder and melted butter. Add to dry ingredients. Mix to blend. Spread in a 9-inch square baking pan or a glass or ceramic baking dish."}, {"position": 2, "text": "Whisk remaining cocoa with brown sugar and spread over batter. Slowly pour hot coffee or water on top. Do not mix."}, {"position": 3, "text": "Place pan in oven and bake 35 to 40 minutes, until batter appears set and sauce is bubbling. Remove to a rack and let rest 15 minutes. To serve, scoop portions into goblets or onto plates and top each with ice cream."}], "nutrition": {"calories": 162.6, "protein_g": 3.3, "carbohydrates_g": 29.6, "fat_g": 5.0, "saturated_fat_g": 2.8, "trans_fat_g": 0.0, "cholesterol_mg": 23.3, "sodium_mg": 150.2, "fiber_g": 2.9, "sugar_g": 19.1, "unsaturated_fat_g": 1.8, "source": "nyt", "basis": "per_
{"slug": "fudge-pudding-cake", "nyt_id": 11285, "url": "https://cooking.nytimes.com/recipes/11285-fudge-pudding-cake", "name": "Fudge Pudding Cake", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "12 to 16 servings", "min": 12, "max": 16, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 80, "raw": {"total": "1 hour 20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ¼ cups whole wheat flour", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "whole wheat flour", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup granulated sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "¾ cup unsweetened cocoa powder", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "unsweetened cocoa powder", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons baking powder", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 large egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup milk", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons vanilla extract", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon instant espresso powder", "group": null, "quantity": 0.5, "quan
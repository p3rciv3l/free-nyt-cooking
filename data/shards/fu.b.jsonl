{"slug": "fusilli-with-tomatoes-eggplant-and-pine-nuts", "nyt_id": 7044, "url": "https://cooking.nytimes.com/recipes/7044-fusilli-with-tomatoes-eggplant-and-pine-nuts", "name": "Fusilli With Tomatoes, Eggplant and Pine Nuts", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 main-course servings, 8 first-course servings", "min": 4, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 eggplant", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "eggplant", "preparation": null, "optional": false}, {"position": 2, "raw": "Coarse salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 5, "raw": "1 pound fusilli", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fusilli", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons chopped fresh oregano", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh oregano", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup pitted black olives", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "pitted black olives", "preparation": null, "optional": false}, {"position": 8, "raw": "4 large ripe tomatoes, seeded and chopped", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large ripe tomatoes", "preparation": "seeded and chopped", "optional": false}, {"position": 9, "raw": "½ cup toasted pine nuts", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "toasted pine nuts", "preparation": null, "optional": false}, {"position": 10, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "Freshly grated Parmesan", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly grated parmesan", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Slice the eggplant and sprinkle with salt. Leave them for 30 minutes, then pat them dry with paper towels."}, {"position": 2, "text": "Preheat grill or broiler. Brush the eggplant slices on both sides with olive oil and sprinkle them with garlic. Grill them until tender and set aside. When the eggplant has cooled, chop it into half-inch pieces."}, {"position": 3, "text": "Meanwhile, bring six quarts salted water to a rolling boil and add the fusilli. Cook until al dente."}, {"position": 4, "text": "While the pasta is cooking, chop the oregano and saute it in the remaining olive oil for one to two minutes. Add the olives, tomatoes and eggplant and heat them through."}, {"position": 5, "text": "Drain the fusilli. Put the sauce in a heated serving bowl and add the pasta. Toss well and add the pine nuts. Season with salt and pepper and serve. Freshly grated Parmesan cheese should be passed separately."}], "nutrition": {"calories": 741.5, "protein_g": 22.8, "carbohydrates_g": 104.4, "fat_g": 27.6, "saturated_fat_g": 4.1, "trans_fat_g": 0.0, "cholesterol_mg": 4.8, "sodium_mg": 1066.6, "fiber_g": 11.5, "sugar_g": 12.6, "unsaturated_fat_g": 20.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["vegetarian"], "course": ["appetizer", "main course"], "meal": ["dinner"], "occasion": [], "other": ["
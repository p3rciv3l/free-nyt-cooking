{"slug": "fusion-coq-au-vin", "nyt_id": 6448, "url": "https://cooking.nytimes.com/recipes/6448-fusion-coq-au-vin", "name": "Fusion Coq Au Vin", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ ounces dried Chinese black mushrooms", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "dried chinese black mushrooms", "preparation": null, "optional": false}, {"position": 2, "raw": "4 ounces smoked slab bacon, diced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "smoked slab bacon", "preparation": "diced", "optional": false}, {"position": 3, "raw": "2 medium red onions, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium red onions", "preparation": "chopped", "optional": false}, {"position": 4, "raw": "3 cloves garlic, sliced", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "sliced", "optional": false}, {"position": 5, "raw": "1 2-inch piece fresh ginger, peeled and sliced thin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "2-inch piece fresh ginger", "preparation": "peeled and sliced thin", "optional": false}, {"position": 6, "raw": "8 chicken thighs, well dried", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "chicken thighs", "preparation": "well dried", "optional": false}, {"position": 7, "raw": "Salt and ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and ground black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon five-spice powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "five-spice powder", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup brandy", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "brandy", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ cups pinot noir", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "pinot noir", "preparation": null, "optional": false}, {"position": 11, "raw": "1 ½ tablespoons Chinese soy sauce", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "chinese soy sauce", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon minced cilantro", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced cilantro", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place mushrooms in a bowl, cover with warm water and set aside. In a heavy 4-quart casserole, sauté bacon until brown. Remove, draining well. Add onions and sauté until soft. Add garlic and ginger and sauté until fragrant. Remove contents of pan. Increase heat to high."}, {"position": 2, "text": "Season chicken with salt and pepper and brown a few pieces at a time on both sides in pan. Dust with five-spice powder. Reduce heat and return all chicken to pan. Add brandy, avert your face and ignite with a long match. When flames subside, add wine. Drain mushrooms and add along with bacon and onion mixture. Cover and simmer 35 minutes. Remove chicken from pan."}, {"position": 3, "text": "Add soy sauce to pan and boil until reduced by one-third. Add lemon juice. Season sauce with salt and pepper. Return chicken to pan. Reheat, transfer to a serving dish, sprinkle with cilantro and serve."}], "nutrition": {"calories": 1109.4, "protein_g": 69.4, "carbohydrates_g": 12.0, "fat_g": 74.9, "saturated_fat_g": 21.1, "trans_fat_g": 0.4, "cholesterol_mg": 397.0, "sodium_mg": 1392.1, "fiber_g": 1.9, "sugar_g": 2.9, "unsaturated_fat_g": 46.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian", "french"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bacon", "boil", "braise", "brandy", "chicken thigh", "cilantro", "dried mushroom", "five-spice powder", "garlic", "ginger", "lemon juice", "poultry", "red onion", "saute", "soy sauce", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 29}, "video_url": null, "comment_count": null, "published_at": "2004-04-14", "scraped_at": "2026-09-07T08:24:06.077908+00:00", "scraper_version": "1.0.0"}
{"slug": "fuyu-persimmon-salad", "nyt_id": 12897, "url": "https://cooking.nytimes.com/recipes/12897-fuyu-persimmon-salad", "name": "Fuyu Persimmon Salad", "author": "David Tanis", "description": "The Fuyu persimmon, round and squat and rather tomato-shaped, is the kind you can eat raw. You want to buy the ones that have turned truly orange (if they are greenish-gold, let them ripen for a few days), then peel them and slice them. The flesh is firm but sweet. Eat them plain, in the Japanese fashion, with a pot of tea. Fuyus persimmons make wonderful salads, too.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "About 20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 shallot, finely diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "shallot", "preparation": "finely diced", "optional": false}, {"position": 2, "raw": "Salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon sherry vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "4 tablespoons extra-virgin olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "3 Fuyu persimmons", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "fuyu persimmons", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup thinly sliced tender celery stalks and leaves", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "thinly sliced tender celery stalks and leaves", "preparation": null, "optional": false}, {"position": 8, "raw": "1 head radicchio, leaves torn into 2-inch wide ribbons", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "radicchio", "preparation": "leaves torn into 2-inch wide ribbons", "optional": false}, {"position": 9, "raw": "Chunk of Parmesan, for shaving", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "chunk of parmesan", "preparation": "for shaving", "optional": false}], "steps": [{"position": 1, "text": "Make the vinaigrette: put diced shallot in a small bowl with a pinch of salt. Add lemon juice and sherry vinegar and leave to macerate for about 5 minutes. Stir in olive oil. Season with additional salt and pepper to taste."}, {"position": 2, "text": "With a sharp paring knife, remove and discard the leafy calyx at the top of each persimmon. Peel persimmons and cut in half vertically. Lay persimmons flat side down and cut into ½-inch wedges."}, {"position": 3, "text": "Put persimmon wedges and celery slices in a low, wide salad bowl. Season with salt and pepper. Whisk vinaigrette, then pour over persimmon and celery and toss to coat well. Add radicchio and toss lightly."}, {"position": 4, "text": "With a vegetable peeler, shave about 1 ounce of Parmesan in thin strips over salad."}], "nutrition": {"calories": 147.7, "protein_g": 4.1, "carbohydrates_g": 7.8, "fat_g": 11.5, "saturated_fat_g": 2.7, "trans_fat_g": 0.0, "cholesterol_mg": 6.5, "sodium_mg": 179.2, "fiber_g": 0.7, "sugar_g": 1.1, "unsaturated_fat_g": 8.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["american"], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["celery", "easy", "fall", "persimmon", "quick", "radicchio", "salad", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/imag
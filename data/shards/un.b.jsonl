antity_max": null, "unit": null, "item": "juice of 2 lemons", "preparation": null, "optional": false}, {"position": 9, "raw": "4 yellowfin tuna steaks, weighing 8 to 10 ounces each, cut into cubes", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "yellowfin tuna steaks", "preparation": "weighing 8 to 10 ounces each, cut into cubes", "optional": false}, {"position": 10, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup pickled ginger", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "pickled ginger", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine all the marinade ingredients in a bowl and place the tuna steaks in it. Refrigerate for 3 hours, turning the tuna every hour."}, {"position": 2, "text": "About half an hour before cooking, remove the tuna from the marinade to a plate, and let it reach room temperature. Preheat a grill, barbecue or pan to very hot."}, {"position": 3, "text": "Brush the tuna steaks with olive oil. Grill for 1 to 2 minutes on each side. The outside should be well seared, and the center should be just warm and very rare."}, {"position": 4, "text": "Garnish each tuna steak with pickled ginger, and serve."}], "nutrition": {"calories": 517.1, "protein_g": 72.0, "carbohydrates_g": 32.3, "fat_g": 8.4, "saturated_fat_g": 1.4, "trans_fat_g": 0.0, "cholesterol_mg": 99.5, "sodium_mg": 5636.3, "fiber_g": 2.3, "sugar_g": 22.0, "unsaturated_fat_g": 6.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["easy", "fry", "grill", "marinate", "tuna"]}, "images": [], "rating": {"average": 4.0, "count": 70}, "video_url": null, "comment_count": null, "published_at": "1994-05-25"
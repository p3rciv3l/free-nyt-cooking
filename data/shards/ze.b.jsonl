{"slug": "zebra-tomato-and-polenta-lasagna", "nyt_id": 6584, "url": "https://cooking.nytimes.com/recipes/6584-zebra-tomato-and-polenta-lasagna", "name": "Zebra Tomato And Polenta Lasagna", "author": "Molly O’Neill", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 teaspoons kosher salt, plus more for seasoning", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": "plus more for seasoning", "optional": false}, {"position": 2, "raw": "1 cup dry uncooked polenta", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry uncooked polenta", "preparation": null, "optional": false}, {"position": 3, "raw": "25 green zebra tomatoes", "group": null, "quantity": 25.0, "quantity_max": null, "unit": null, "item": "green zebra tomatoes", "preparation": null, "optional": false}, {"position": 4, "raw": "1 clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon white pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "white pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "1 bunch fresh oregano", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "fresh oregano", "preparation": null, "optional": false}, {"position": 8, "raw": "6 ounces feta cheese", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "oz", "item": "feta cheese", "preparation": null, "optional": false}, {"position": 9, "raw": "8 ounces fresh ricotta cheese", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "fresh ricotta cheese", "preparation": null, "optional": false}, {"position": 10, "raw": "1 egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Put 4 ¾ cups water in large pot, add salt and bring to a boil. Slowly sprinkle polenta into water in a thin stream, whisking constantly until it is absorbed. Reduce heat to simmer, and cook, covered, for 35 minutes. Every 10 minutes, give the pot 1 minute of vigorous stirring; after final stir, allow polenta to cook for 5 more minutes. Turn out into a bowl."}, {"position": 2, "text": "Meanwhile, cut 5 tomatoes into quarters, and place them with garlic in blender. Blend tomatoes until very smooth. Taste puree mixture, season lightly with salt and white pepper, and set aside. Slice remaining tomatoes into disks, each ¼ inch thick."}, {"position": 3, "text": "Grease 8-by-8-inch baking dish with olive oil. Spoon half of polenta into dish, and press it out to sides in even layer. Arrange 1 layer of tomatoes on top of polenta, season lightly with salt and white pepper, and place 1 oregano leaf on each tomato slice. Drizzle about 3 tablespoons of puree mixture over tomatoes. Sprinkle a third of crumbled feta over puree."}, {"position": 4, "text": "Beat ricotta cheese and egg together, and season lightly with salt and white pepper to taste. Build second layer of tomatoes, salt, white pepper and oregano. Spread half of ricotta mixture over this layer. Make another layer from the rest of the polenta."}, {"position": 5, "text": "Place layer of tomatoes, salt, white pepper and oregano over polenta. Add remaining ricotta and then remaining sliced tomatoes, and season again as above. Spread remaining puree over all, and then sprinkle remaining crumbled feta over top."}, {"position": 6, "text": "Bake for 35 to 45 minutes, until tomatoes are bubbling and cheese is golden."}], "nutrition": {"calories": 566.0, "protein_g": 24.6, "carbohydrates_g": 81.2, "fat_g": 19.5, "saturated_fat_g": 10.2, "trans_fat_g": 0.2, "cholesterol_mg": 105.6, "sodium_mg": 1613.4, "fiber_g": 11.9, "sugar_g": 33.4, "unsaturated_fat_g": 7.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["vegetarian"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "boil", "casseroles", "feta", "great leftovers", "lasagna", "oregano", "polenta", "ricotta", "summer", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "1998-06-03", "scraped_at": "2026-09-07T08:29:44.897331+00:00", "scraper_version": "1.0.0"}

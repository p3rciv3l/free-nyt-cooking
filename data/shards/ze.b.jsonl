{"slug": "zesty-barbecue-sauce", "nyt_id": 5959, "url": "https://cooking.nytimes.com/recipes/5959-zesty-barbecue-sauce", "name": "Zesty Barbecue Sauce", "author": "Marian Burros", "description": "", "servings": {"text": "8 cups", "min": 8, "max": 8, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "4 cups finely chopped onion", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "finely chopped onion", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup salad oil", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "salad oil", "preparation": null, "optional": false}, {"position": 3, "raw": "8 cups tomato sauce", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "cup", "item": "tomato sauce", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup cider vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "cider vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup fresh lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 6, "raw": "¾ cup Worcestershire sauce", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "worcestershire sauce", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup firmly packed brown sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "firmly packed brown sugar", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup prepared mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "prepared mustard", "preparation": null, "optional": false}, {"position": 9, "raw": "1 to 2 teaspoons hot pepper sauce", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "tsp", "item": "hot pepper sauce", "preparation": null, "optional": false}, {"position": 10, "raw": "4 cloves garlic, crushed", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "crushed", "optional": false}, {"position": 11, "raw": "2 bay leaves, crushed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": "crushed", "optional": false}, {"position": 12, "raw": "1 tablespoon chili powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chili powder", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Saute onions in hot oil until tender; do not brown."}, {"position": 2, "text": "Stir in remaining ingredients; bring to boil. Reduce heat and simmer, uncovered, 45 to 60 minutes, until mixture begins to thicken. Cool and pour into pint jars with tight-fitting lids. Store in refrigerator. Keeps a year."}, {"position": 3, "text": "Use as you would any barbecue sauce: to grill poultry, beef, pork; to mix with ground beef to make barbecued beef. Or just as a sauce spooned over roasted or broiled meats."}], "nutrition": {"calories": 185.8, "protein_g": 2.4, "carbohydrates_g": 21.7, "fat_g": 11.0, "saturated_fat_g": 0.9, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 864.6, "fiber_g": 3.1, "sugar_g": 14.6, "unsaturated_fat_g": 9.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["dips and spreads", "easy", "onion", "sauces and gravies", "tomato sauce"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1981-11-29", "scraped_at": "2026-09-07T07:58:09.556107+00:00", "scraper_version": "1.0.0"}

{"slug": "kale-with-potatoes-anchovies-and-hot-pepper", "nyt_id": 11180, "url": "https://cooking.nytimes.com/recipes/11180-kale-with-potatoes-anchovies-and-hot-pepper", "name": "Kale With Potatoes, Anchovies and Hot Pepper", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "About 4 tablespoons olive oil", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "about 4 tablespoons olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "2 large cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": "minced", "optional": false}, {"position": 3, "raw": "1 ½ pounds small red potatoes, scrubbed, halved and sliced ¼-inch thick", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "small red potatoes", "preparation": "scrubbed, halved and sliced ¼-inch thick", "optional": false}, {"position": 4, "raw": "1 ½ pounds kale, stripped and washed, cut in ½-inch strips", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "kale", "preparation": "stripped and washed, cut in ½-inch strips", "optional": false}, {"position": 5, "raw": "½ cup water", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon crumbled dried hot chili peppers or crushed hot pepper", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "crumbled dried hot chili peppers or crushed hot pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "6 anchovy fillets, drained and cut into ½-inch pieces", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "anchovy fillets", "preparation": "drained and cut into ½-inch pieces", "optional": false}, {"position": 8, "raw": "Lemon juice", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "lemon juice", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat two tablespoons oil in a flameproof casserole, add garlic and stir over low heat until lightly colored. Add potatoes; toss. Add kale, water and chilies."}, {"position": 2, "text": "Cover and cook over medium-low heat until potatoes are just barely tender, about 30 minutes, stirring occasionally."}, {"position": 3, "text": "Add anchovies and lemon juice to taste. Toss with olive oil to taste. Serve sprinkled with black pepper."}], "nutrition": {"calories": 319.9, "protein_g": 10.2, "carbohydrates_g": 37.0, "fat_g": 16.9, "saturated_fat_g": 2.4, "trans_fat_g": 0.0, "cholesterol_mg": 5.1, "sodium_mg": 343.2, "fiber_g": 10.3, "sugar_g": 4.2, "unsaturated_fat_g": 13.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["anchovy", "kale", "potato", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 32}, "video_url": null, "comment_count": null, "published_at": "1991-01-06", "scraped_at": "2026-09-06T23:01:32.830646+00:00", "scraper_version": "1.0.0"}

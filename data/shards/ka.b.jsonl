{"slug": "kabawa-rum-punch", "nyt_id": 785432641, "url": "https://cooking.nytimes.com/recipes/785432641-kabawa-rum-punch", "name": "Kabawa Rum Punch", "author": "Eric Asimov", "description": "This pleasantly tart but balanced punch, from Kathryn Stashek, bartender at Bar Kabawa in Manhattan’s East Village, resembles a daiquiri, yet it differs in an important way. Rafa García Febles, the general manager at Kabawa and Bar Kabawa, says that the essence of a daiquiri is in the frothy texture, which comes from being shaken to order. But this punch, which is not shaken, will be equally appealing to a crowd. “If somebody wants to call it a daiquiri, we’re not sticklers about it,” he said. It’s easy to make in advance, which makes entertaining a group more relaxing. Be sure to keep refrigerated.  Eric Asimov", "servings": {"text": "8-10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 10, "total_minutes": 15, "raw": {"total": "15 min, plus chilling", "prep": "PT0H5M", "cook": "PT0H10M"}}, "ingredients": [{"position": 1, "raw": "20 ounces aged Caribbean rum, such as Real McCoy 5-Year from Barbados", "group": null, "quantity": 20.0, "quantity_max": null, "unit": "oz", "item": "aged caribbean rum", "preparation": "such as Real McCoy 5-Year from Barbados", "optional": false}, {"position": 2, "raw": "10 ounces cane syrup, see Tip", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "cane syrup", "preparation": "see Tip", "optional": false}, {"position": 3, "raw": "7½ ounces lime juice, preferably fresh squeezed (from about 8 limes)", "group": null, "quantity": 7.0, "quantity_max": null, "unit": null, "item": "½ ounces lime juice", "preparation": "preferably fresh squeezed (from about 8 limes)", "optional": false}, {"position": 4, "raw": "½ ounce Angostura bitters", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "oz", "item": "angostura bitters", "preparation": null, "optional": false}, {"position": 5, "raw": "15 ounces distilled water", "group": null, "quantity": 15.0, "quantity_max": null, "unit": "oz", "item": "distilled water", "preparation": null, "optional": false}, {"position": 6, "raw": "Sliced fruit, such as pineapple, orange, pink grapefruit and lime", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sliced fruit", "preparation": "such as pineapple, orange, pink grapefruit and lime", "optional": false}, {"position": 7, "raw": "Nutmeg, for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "nutmeg", "preparation": "for garnish", "optional": false}], "steps": [{"position": 1, "text": "Combine the rum, cane syrup, lime juice, bitters and water in a 2-quart pitcher or jar and stir well. Chill until ready to serve. (The punch will last 4 to 5 days refrigerated.)"}, {"position": 2, "text": "To serve, pour the punch into ice-filled glasses. Garnish with sliced fruit and lots of grated nutmeg."}], "nutrition": {"calories": 238.9, "protein_g": 0.5, "carbohydrates_g": 27.2, "fat_g": 0.7, "saturated_fat_g": 0.5, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 19.7, "fiber_g": 1.2, "sugar_g": 23.1, "unsaturated_fat_g": 0.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "egg-free", "peanut-free", "tree nut-free", "soy-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "vegan", "vegetarian", "pescatarian"], "course": [], "meal": [], "occasion": ["party"], "other": ["rum", "lime juice", "angostura bitters", "punches", "easy", "make-ahead", "lime (flav)", "not-shoppable-ic", "cocktails", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2026/07/30/multimedia/30FD-POUR-SUMMER-DRINKSREX-EA-Kabawa-Punch-1-qjwt/30FD-POUR-SUMMER-DRINKSREX-EA-Kabawa-Punch-1-qjwt-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 6}, "video_url": null, "comment_c
{"slug": "kabawa-rum-punch", "nyt_id": 785432641, "url": "https://cooking.nytimes.com/recipes/785432641-kabawa-rum-punch", "name": "Kabawa Rum Punch", "author": "Eric Asimov", "description": "This pleasantly tart but balanced punch, from Kathryn Stashek, bartender at Bar Kabawa in Manhattan’s East Village, resembles a daiquiri, yet it differs in an important way. Rafa García Febles, the general manager at Kabawa and Bar Kabawa, says that the essence of a daiquiri is in the frothy texture, which comes from being shaken to order. But this punch, which is not shaken, will be equally appealing to a crowd. “If somebody wants to call it a daiquiri, we’re not sticklers about it,” he said. It’s easy to make in advance, which makes entertaining a group more relaxing. Be sure to keep refrigerated.  Eric Asimov", "servings": {"text": "8-10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 10, "total_minutes": 15, "raw": {"total": "15 min, plus chilling", "prep": "PT0H5M", "cook": "PT0H10M"}}, "ingredients": [{"position": 1, "raw": "20 ounces aged Caribbean rum, such as Real McCoy 5-Year from Barbados", "group": null, "quantity": 20.0, "quantity_max": null, "unit": "oz", "item": "aged caribbean rum", "preparation": "such as Real McCoy 5-Year from Barbados", "optional": false}, {"position": 2, "raw": "10 ounces cane syrup, see Tip", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "cane syrup", "preparation": "see Tip", "optional": false}, {"position": 3, "raw": "7½ ounces lime juice, preferably fresh squeezed (from about 8 limes)", "group": null, "quantity": 7.0, "quantity_max": null, "unit": null, "item": "½ ounces lime juice", "preparation": "preferably fresh squeezed (from about 8 limes)", "optional": false}, {"position": 4, "raw": "½ ounce Angostura bitters", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "oz", "item": "angostura bitters", "preparation": null, "optional": false}, {"position": 5, "raw": "15 ounces distilled water", "group": null, "quantity": 15.0, "quantity_max": null, "unit": "oz", "item": "distilled water", "preparation": null, "optional": false}, {"position": 6, "raw": "Sliced fruit, such as pineapple, orange, pink grapefruit and lime", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sliced fruit", "preparation": "such as pineapple, orange, pink grapefruit and lime", "optional": false}, {"position": 7, "raw": "Nutmeg, for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "nutmeg", "preparation": "for garnish", "optional": false}], "steps": [{"position": 1, "text": "Combine the rum, cane syrup, lime juice, bitters and water in a 2-quart pitcher or jar and stir well. Chill until ready to serve. (The punch will last 4 to 5 days refrigerated.)"}, {"position": 2, "text": "To serve, pour the punch into ice-filled glasses. Garnish with sliced fruit and lots of grated nutmeg."}], "nutrition": {"calories": 238.9, "protein_g": 0.5, "carbohydrates_g": 27.2, "fat_g": 0.7, "saturated_fat_g": 0.5, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 19.7, "fiber_g": 1.2, "sugar_g": 23.1, "unsaturated_fat_g": 0.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "egg-free", "peanut-free", "tree nut-free", "soy-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "vegan", "vegetarian", "pescatarian"], "course": [], "meal": [], "occasion": ["party"], "other": ["rum", "lime juice", "angostura bitters", "punches", "easy", "make-ahead", "lime (flav)", "not-shoppable-ic", "cocktails", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2026/07/30/multimedia/30FD-POUR-SUMMER-DRINKSREX-EA-Kabawa-Punch-1-qjwt/30FD-POUR-SUMMER-DRINKSREX-EA-Kabawa-Punch-1-qjwt-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "2026-07-30", "scraped_at": "2026-09-06T22:27:00.811511+00:00", "scraper_version": "1.0.0"}
{"slug": "kabocha-squash-pie", "nyt_id": 411, "url": "https://cooking.nytimes.com/recipes/411-kabocha-squash-pie", "name": "Kabocha Squash Pie", "author": "Melissa Clark", "description": "Melissa Clark", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "2 hours 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 medium kabocha squash, about 3 pounds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium kabocha squash", "preparation": "about 3 pounds", "optional": false}, {"position": 2, "raw": "10 ounces (1 ⅓ cups) cream cheese, at room temperature", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "(1 ⅓ cups) cream cheese", "preparation": "at room temperature", "optional": false}, {"position": 3, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ teaspoons ground cinnamon", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon ground ginger", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground ginger", "preparation": null, "optional": false}, {"position": 6, "raw": "¾ teaspoon freshly ground nutmeg (about ¼ of a nutmeg)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "freshly ground nutmeg (about ¼ of a nutmeg)", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ tablespoons brandy", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "brandy", "preparation": null, "optional": false}, {"position": 9, "raw": "2 eggs at room temperature", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "eggs at room temperature", "preparation": null, "optional": false}, {"position": 10, "raw": "¾ cup (2 ounces) walnuts", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "(2 ounces) walnuts", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup, packed, light brown sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "cup", "preparation": "packed, light brown sugar", "optional": false}, {"position": 12, "raw": "¾ cup graham cracker crumbs (about 7 crackers)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "graham cracker crumbs (about 7 crackers)", "preparation": null, "optional": false}, {"position": 13, "raw": "Grated zest of 1 lime", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated zest of 1 lime", "preparation": null, "optional": false}, {"position": 14, "raw": "¾ teaspoon ground cinnamon", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 15, "raw": "⅛ teaspoon ground ginger", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "ground ginger", "preparation": null, "optional": false}, {"position": 16, "raw": "¾ teaspoon salt", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 17, "raw": "¼ cup (2 ounces) unsalted butter, melted", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "(2 ounces) unsalted butter", "preparation": "melted", "optional": false}, {"position": 18, "raw": "Crème fraîche, for serving (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "crème fraîche", "preparation": "for serving", "optional": true}, {"position": 19, "raw": "Ginger butterscotch sauce, for serving (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "ginger butterscotch sauce", "preparation": "for serving (see recipe)", "optional": false}], "steps": [{"position": 1, "text": "For pie filling, bring an inch of water to a boil in a large covered pot fitted with a steamer basket or rack. Put in squash, cover and steam, replenishing water as needed, until fork tender, about 1 hour. Turn squash over halfway through steaming. Set squash aside until cool enough to handle."}, {"position": 2, "text": "Heat oven to 325 degrees. For crust, place walnuts on a baking tray, and toast in oven, stirring once or twice, until fragrant, about 15 minutes. Let cool. Reduce oven temperature to 300 degrees."}, {"position": 3, "text": "In a food processor, combine walnuts with a few tablespoons brown sugar and pulse a few times, until nuts are coarsely ground. In a large bowl, whisk nuts with graham cracker crumbs, remaining brown sugar, lime zest, spices and salt. Pour melted butter over this mixture, and mix with your fingers until butter is distributed. Press evenly into a 10-inch glass pie plate. Bake crust until lightly browned, about 12 minutes, then set aside. Keep oven at 300 degrees."}, {"position": 4, "text": "When squash is cool, cut it in half and scoop out seeds and pulp. Scoop squash flesh into a measuring cup until you have 2 ½ cups."}, {"position": 5, "text": "In a food processor, process cream cheese with sugar, spices and salt until light and smooth. Scrape down bowl, add squash and process until smooth. Mix in brandy and then eggs, one at a time. Finish mixing with a rubber spatula."}, {"position": 6, "text": "Place pie plate on a baking sheet and scrape filling into crust. Bake until just set in center, about 1 hour. Let cool before serving, topped with crème fraîche and drizzled with butterscotch sauce."}], "nutrition": {"calories": 483.8, "protein_g": 6.2, "carbohydrates_g": 59.3, "fat_g": 25.9, "saturated_fat_g": 12.2, "trans_fat_g": 0.5, "cholesterol_mg": 93.2, "sodium_mg": 424.8, "fiber_g": 2.4, "sugar_g": 43.4, "unsaturated_fat_g": 11.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["thanksgiving"], "other": ["bake", "cream cheese", "fall", "graham cracker", "kabocha", "pie", "squash", "steam", "walnut", "baking"]}, "images": [{"url": "https://static01.nyt.com/images/2014/03/27/dining/squashpie/squashpie-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 79}, "video_url": null, "comment_count": null, "published_at": "2004-11-17", "scraped_at": "2026-09-07T00:29:47.557414+00:00", "scraper_version": "1.0.0"}
{"slug": "kale-and-oven-dried-tomato-lasagna", "nyt_id": 7418, "url": "https://cooking.nytimes.com/recipes/7418-kale-and-oven-dried-tomato-lasagna", "name": "Kale and Oven-Dried-Tomato Lasagna", "author": "Molly O’Neill", "description": "", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 420, "raw": {"total": "About 7 hours"}}, "ingredients": [{"position": 1, "raw": "28 medium-size plum tomatoes, core end cut off, halved lengthwise", "group": null, "quantity": 28.0, "quantity_max": null, "unit": null, "item": "medium-size plum tomatoes", "preparation": "core end cut off, halved lengthwise", "optional": false}, {"position": 2, "raw": "2 teaspoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon kosher salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 4, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "2 large baking potatoes, peeled and thinly sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large baking potatoes", "preparation": "peeled and thinly sliced", "optional": false}, {"position": 6, "raw": "1 teaspoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "2 cloves garlic, peeled and minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and minced", "optional": false}, {"position": 8, "raw": "5 teaspoons chopped fresh rosemary", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tsp", "item": "chopped fresh rosemary", "preparation": null, "optional": false}, {"position": 9, "raw": "6 heads kale, stemmed and coarsely chopped (about 24 cups)", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "head", "item": "kale", "preparation": "stemmed and coarsely chopped (about 24 cups)", "optional": false}, {"position": 10, "raw": "2 ½ teaspoons kosher salt", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ teaspoon crushed red pepper flakes", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "crushed red pepper flakes", "preparation": null, "optional": false}, {"position": 12, "raw": "1 15-ounce container skim-milk ricotta", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "15-ounce container skim-milk ricotta", "preparation": null, "optional": false}, {"position": 13, "raw": "1 egg, beaten", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": "beaten", "optional": false}, {"position": 14, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 15, "raw": "Olive oil spray", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "olive oil spray", "preparation": null, "optional": false}, {"position": 16, "raw": "9 lasagna noodles, cooked and drained well", "group": null, "quantity": 9.0, "quantity_max": null, "unit": null, "item": "lasagna noodles", "preparation": "cooked and drained well", "optional": false}, {"position": 17, "raw": "3 tablespoons grated hard ricotta salata", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "grated hard ricotta salata", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the tomatoes, preheat the oven to 200 degrees. Using a pastry brush, brush the skin side of the tomatoes with the olive oil. Place skin side down on a large baking sheet. Sprinkle with the salt and pepper to taste. Bake until they shrink to about a quarter of their original size, about 4 to 6 hours; they should remain soft and juicy. Let the tomatoes cool on the baking sheet. Quarter the tomatoes and set aside."}, {"position": 2, "text": "To make the lasagna, bring a large pot of lightly salted water to a boil. Add the potato slices and blanch for 7 minutes. Drain and set aside. Heat the olive oil in a large pot over medium heat. Add the garlic and rosemary and cook for 30 seconds. Add the kale to the pot, stir once and cover with a lid. Cook for 12 minutes. Stir in 1 ½ teaspoons of salt and the pepper flakes."}, {"position": 3, "text": "Preheat the oven to 350 degrees. Whisk together the ricotta, egg, remaining salt and pepper to taste. Spray an 11-by-7-inch baking dish with the olive oil. Line the bottom of the dish with 3 of the noodles, trimming them to fit if necessary. Spread the noodles with half of the ricotta mixture. Spread 3 cups of the kale mixture over the ricotta. Layer half of the potatoes over the kale and scatter with ¾ cup of the tomato pieces. Repeat the layers, ending with remaining noodles."}, {"position": 4, "text": "Spread the remaining kale mixture over the noodles. Sprinkle with the ricotta salata and the remaining tomato pieces. Cover with aluminum foil. Bake for 30 minutes. Cut into 6 pieces, place on a plate and serve."}], "nutrition": {"calories": 438.4, "protein_g": 18.2, "carbohydrates_g": 64.7, "fat_g": 14.2, "saturated_fat_g": 6.1, "trans_fat_g": 0.3, "cholesterol_mg": 65.2, "sodium_mg": 1263.1, "fiber_g": 10.4, "sugar_g": 10.2, "unsaturated_fat_g": 6.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["bake", "boil", "great leftovers", "kale", "lasagna", "lasagna noodle"]}, "images": [], "rating": {"average": 3.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1995-02-26", "scraped_at": "2026-09-07T01:02:23.437790+00:00", "scraper_version": "1.0.0"}
{"slug": "kale-and-pinkelwurst", "nyt_id": 694, "url": "https://cooking.nytimes.com/recipes/694-kale-and-pinkelwurst", "name": "Kale and Pinkelwurst", "author": "Robert Farrar Capon", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 70, "raw": {"total": "1 hour 10 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup chopped onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped onion", "preparation": null, "optional": false}, {"position": 2, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 3, "raw": "8 cups chopped, washed fresh kale", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "cup", "item": "chopped", "preparation": "washed fresh kale", "optional": false}, {"position": 4, "raw": "1 cup water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and white pepper, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and white pepper", "preparation": "to taste", "optional": false}, {"position": 6, "raw": "1 pinkelwurst, see note", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "pinkelwurst", "preparation": "see note", "optional": false}], "steps": [{"position": 1, "text": "In a deep pot, saute the onion in the butter until transparent. Add the kale and mix thoroughly. Add the water, salt (only a little at this point) and pepper and bring to a boil."}, {"position": 2, "text": "Pierce the pinkelwurst all over with the point of a skewer and place it on top of the kale. Cover the pot tightly and simmer 1 hour, or until the kale is quite tender. Near the end, uncover and boil away any surplus liquid."}, {"position": 3, "text": "Leaving the pinkelwurst in the pot, slit open the casing with a knife and empty its filling onto the kale. Discard the casing, mix the kale and wurst together and serve."}], "nutrition": null, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": [], "occasion": ["thanksgiving"], "other": ["boil", "fall", "five ingredient", "kale"]}, "images": [], "rating": {"average": 5.0, "count": 13}, "video_url": null, "comment_count": null, "published_at": "1983-11-16", "scraped_at": "2026-09-07T00:57:30.590837+00:00", "scraper_version": "1.0.0"}
{"slug": "kale-and-sugar-snap-pea-salad", "nyt_id": 12575, "url": "https://cooking.nytimes.com/recipes/12575-kale-and-sugar-snap-pea-salad", "name": "Kale and Sugar Snap Pea Salad", "author": "Mark Bittman", "description": "Here’s a recipe Mark Bittman picked up on a road trip with his daughter across the United States, from the Black Market restaurant in Indianapolis. Kale and sugar snap peas combine with a dressing of ginger, miso and rice vinegar, with dried apricots and feta cheese, almonds and mint — a riot of flavors, and an excellent meal. Mark Bittman", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "¾ cup canola oil", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "canola oil", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup peeled, chopped ginger", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "peeled", "preparation": "chopped ginger", "optional": false}, {"position": 3, "raw": "¼ cup miso paste", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "miso paste", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup rice vinegar, or as needed", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "rice vinegar", "preparation": "or as needed", "optional": false}, {"position": 5, "raw": "Finely grated zest and juice of 2 lemons or limes", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "finely grated zest and juice of 2 lemons or limes", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup sugar, or as needed", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": "or as needed", "optional": false}, {"position": 7, "raw": "Coarse salt and black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 9, "raw": "6 to 8 dried apricots", "group": null, "quantity": 6.0, "quantity_max": 8.0, "unit": null, "item": "dried apricots", "preparation": null, "optional": false}, {"position": 10, "raw": "1 medium bunch kale (Tuscan, red Russian, Winterbor or lacinato), coarse stems removed and discarded, roughly chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium bunch kale (tuscan", "preparation": "red Russian, Winterbor or lacinato), coarse stems removed and discarded, roughly chopped", "optional": false}, {"position": 11, "raw": "2 cups sugar snap peas, stemmed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar snap peas", "preparation": "stemmed", "optional": false}, {"position": 12, "raw": "4 ounces feta cheese, crumbled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "feta cheese", "preparation": "crumbled", "optional": false}, {"position": 13, "raw": "¼ cup almonds, toasted and coarsely chopped", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "almonds", "preparation": "toasted and coarsely chopped", "optional": false}, {"position": 14, "raw": "2 tablespoons chopped fresh mint leaves, or as needed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh mint leaves", "preparation": "or as needed", "optional": false}], "steps": [{"position": 1, "text": "Make the dressing: In a blender or food processor, combine the oil, ginger, miso, ½ cup vinegar, lemon or lime zest and juice, and sugar. Process for about 30 seconds to form a creamy emulsion. Season with salt and pepper to taste, and add vinegar if needed."}, {"position": 2, "text": "Make the salad: In a small saucepan over medium-low heat, combine the sugar with ¼ cup water. Add the dried apricots and poach just until rehydrated, 2 to 3 minutes, then remove from heat."}, {"position": 3, "text": "In a serving bowl, combine the kale, snap peas and feta. Add salad dressing to taste, and toss well. Sprinkle with almonds and garnish with poached apricots. Sprinkle with mint and serve."}], "nutrition": {"calories": 693.2, "protein_g": 12.2, "carbohydrates_g": 46.6, "fat_g": 53.6, "saturated_fat_g": 7.5, "trans_fat_g": 0.2, "cholesterol_mg": 25.2, "sodium_mg": 998.4, "fiber_g": 8.1, "sugar_g": 30.4, "unsaturated_fat_g": 44.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["ginger", "green salad", "kale", "poach", "quick", "spring", "sugar snap pea"]}, "images": [{"url": "https://static01.nyt.com/images/2017/04/27/dining/27COOKING-KALESALAD2/27COOKING-KALESALAD2-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 972}, "video_url": null, "comment_count": null, "published_at": "2012-06-27", "scraped_at": "2026-09-06T23:57:46.090045+00:00", "scraper_version": "1.0.0"}
{"slug": "kale-smothered-pork-chops", "nyt_id": 7417, "url": "https://cooking.nytimes.com/recipes/7417-kale-smothered-pork-chops", "name": "Kale-Smothered Pork Chops", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 teaspoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "2 medium onions, peeled and chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium onions", "preparation": "peeled and chopped", "optional": false}, {"position": 3, "raw": "6 medium carrots, peeled and cut into ¼-inch cubes", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "medium carrots", "preparation": "peeled and cut into ¼-inch cubes", "optional": false}, {"position": 4, "raw": "4 heads kale, stemmed and coarsely chopped (about 8 cups)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "head", "item": "kale", "preparation": "stemmed and coarsely chopped (about 8 cups)", "optional": false}, {"position": 5, "raw": "4 cloves garlic, peeled and minced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and minced", "optional": false}, {"position": 6, "raw": "2 ½ teaspoons caraway seeds, crushed", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "tsp", "item": "caraway seeds", "preparation": "crushed", "optional": false}, {"position": 7, "raw": "3 teaspoons kosher salt", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 8, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "2 cups chicken broth, homemade or low-sodium canned", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": "homemade or low-sodium canned", "optional": false}, {"position": 10, "raw": "4 pork chops, ¾ inch thick", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "pork chops", "preparation": "¾ inch thick", "optional": false}], "steps": [{"position": 1, "text": "Heat 1 teaspoon of olive oil in a large skillet, preferably cast iron, over medium heat. Add the onions and cook for 5 minutes. Add the carrots and cook for 5 minutes longer. Mix in the kale, 2 cloves of garlic, 2 teaspoons of caraway seeds, 2 teaspoons of salt and pepper to taste. Stir in the chicken broth, cover and simmer on medium-low heat for 30 minutes."}, {"position": 2, "text": "Meanwhile, season the pork chops on both sides with the remaining garlic, caraway seeds, salt and pepper. Heat the remaining olive oil in a large, heavy skillet over medium heat. Add the pork chops and sear until browned, about 2 minutes per side. Place the pork chops on top of the kale mixture. Cover and cook for 20 minutes. Divide the pork chops among 4 plates and spoon the kale mixture over them. Serve immediately."}], "nutrition": {"calories": 381.1, "protein_g": 29.3, "carbohydrates_g": 22.5, "fat_g": 19.6, "saturated_fat_g": 6.0, "trans_fat_g": 0.0, "cholesterol_mg": 77.3, "sodium_mg": 1007.8, "fiber_g": 6.1, "sugar_g": 9.0, "unsaturated_fat_g": 11.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["kale", "pork", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 79}, "video_url": null, "comment_count": null, "published_at": "1995-02-26", "scraped_at": "2026-09-07T01:02:19.813753+00:00", "scraper_version": "1.0.0"}
{"slug": "kale-soup-with-potatoes-and-sausage", "nyt_id": 7416, "url": "https://cooking.nytimes.com/recipes/7416-kale-soup-with-potatoes-and-sausage", "name": "Kale Soup With Potatoes and Sausage", "author": "Molly O’Neill", "description": "Though kale probably originated in the dry heat of the Mediterranean, it became a fixture in the kitchens of northern Europe. In Scotland, according to the author Elizabeth Schneider, \"to come to cail,\" was an invitation to come to dinner. Recent devotees extol the virtues of undercooked kale. But having spent five winters in Provincetown, Mass., where the Portuguese eat their kale with sausage or fish, I grew to like mine similar to theirs: slow-simmered in bacon or sausage fat, or braised in chicken broth until it's soft and sweet.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound linguiça or uncured Spanish chorizo, sliced into ⅛-inch-thick coins", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "linguiça or uncured spanish chorizo", "preparation": "sliced into ⅛-inch-thick coins", "optional": false}, {"position": 2, "raw": "1 large onion, peeled and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large onion", "preparation": "peeled and chopped", "optional": false}, {"position": 3, "raw": "2 large baking potatoes, peeled and cut into ¼-inch cubes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large baking potatoes", "preparation": "peeled and cut into ¼-inch cubes", "optional": false}, {"position": 4, "raw": "1 garlic clove, peeled and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "garlic clove", "preparation": "peeled and minced", "optional": false}, {"position": 5, "raw": "1 ½ bunches kale, stemmed and coarsely chopped (about 6 cups)", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "bunch", "item": "kale", "preparation": "stemmed and coarsely chopped (about 6 cups)", "optional": false}, {"position": 6, "raw": "4 cups chicken broth, homemade or low-sodium canned", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": "homemade or low-sodium canned", "optional": false}, {"position": 7, "raw": "1 tablespoon balsamic vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons kosher salt (such as Diamond Crystal)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt (such as diamond crystal)", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "3 plum tomatoes, cored and cut into ½-inch dice", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "plum tomatoes", "preparation": "cored and cut into ½-inch dice", "optional": false}], "steps": [{"position": 1, "text": "Place the sausage in a large pot over medium-low heat and cook until it begins to render its fat, about 2 minutes. Add the onion and cook for 2 minutes. Add the potatoes and garlic, and cook for 2 minutes. Add the kale and cook, stirring constantly, for 2 minutes longer."}, {"position": 2, "text": "Stir in the chicken broth, vinegar and salt. Bring to a boil, reduce heat, cover and simmer for 1 hour. Season with pepper. Stir in the tomatoes and cook, uncovered, for 15 minutes. Divide among 4 bowls and serve."}], "nutrition": {"calories": 611.8, "protein_g": 27.4, "carbohydrates_g": 55.1, "fat_g": 32.2, "saturated_fat_g": 10.7, "trans_
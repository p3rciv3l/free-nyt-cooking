{"slug": "tripe-soup", "nyt_id": 1045, "url": "https://cooking.nytimes.com/recipes/1045-tripe-soup", "name": "Tripe Soup", "author": "Moira Hodgson", "description": "", "servings": {"text": "6 - 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "4 hours"}}, "ingredients": [{"position": 1, "raw": "1 calf's foot (about 1-1 ½ pounds)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "calf's foot (about 1-1 ½ pounds)", "preparation": null, "optional": false}, {"position": 2, "raw": "2 pounds honeycomb tripe", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "honeycomb tripe", "preparation": null, "optional": false}, {"position": 3, "raw": "1 large onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large onion", "preparation": null, "optional": false}, {"position": 4, "raw": "3 cloves garlic, peeled", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "3 large chilis anchos", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large chilis anchos", "preparation": null, "optional": false}, {"position": 7, "raw": "1 large chili poblano, roasted and peeled or 2 canned, peeled green chilis", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large chili poblano", "preparation": "roasted and peeled or 2 canned, peeled green chilis", "optional": false}, {"position": 8, "raw": "1 ½ cups canned hominy (1 pound), drained", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "canned hominy (1 pound)", "preparation": "drained", "optional": false}, {"position": 9, "raw": "1 scant teaspoon oregano", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "scant teaspoon oregano", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Have the butcher cut the calf's foot into 4 pieces. Cut the tripe into small squares. Put them into a large saucepan with the onion, garlic, salt and pepper. Cover with 4 quarts water and bring to boil. Lower the flame and simmer uncovered for about 2 hours, or until the tripe and foot are just tender but not too soft."}, {"position": 2, "text": "Meanwhile, toast the chilis well. Slit them open and remove the seeds and veins. Grind them dry to a fine powder. Add it to the saucepan as the meat is cooking."}, {"position": 3, "text": "Remove the seeds and veins from the chili poblano, cut it into strips and add to the meat while it is cooking."}, {"position": 4, "text": "Remove the pieces of calf's foot from the pan, and when they are cool enough to handle strip off the fleshy parts. Chop them roughly and return them to the pan."}, {"position": 5, "text": "Add the hominy and continue cooking the soup slowly, still uncovered, for another 2 hours. Add salt as necessary. Sprinkle with oregano and serve."}], "nutrition": {"calories": 168.4, "protein_g": 15.8, "carbohydrates_g": 14.5, "fat_g": 5.3, "saturated_fat_g": 1.6, "trans_fat_g": 0.2, "cholesterol_mg": 138.3, "sodium_mg": 471.4, "fiber_g": 3.4, "sugar_g": 2.0, "unsaturated_fat_g": 2.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["mexican"], "diet": [], "course": ["main course"], "meal": [], "occasion": ["new year’s day"], "other": ["boil", "great leftovers", "soup", "winter"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1985-12-29", "scraped_at": "2026-09-06T22:23:54.645633+00:00", "scraper_version": "1.0.0"}
{"slug": "tropical-shrimp-salad", "nyt_id": 6860, "url": "https://cooking.nytimes.com/recipes/6860-tropical-shrimp-salad", "name": "Tropical Shrimp Salad", "author": "Barbara Kafka", "description": "", "servings": {"text": "6 main-course servings", "min": 6, "max": 6, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "4 large oranges", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large oranges", "preparation": null, "optional": false}, {"position": 2, "raw": "4 teaspoons olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons curry powder (Caribbean, if available)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "curry powder (caribbean", "preparation": "if available)", "optional": false}, {"position": 4, "raw": "¼ cup brown sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "brown sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "⅔ cup dark rum", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "dark rum", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup fresh lime juice", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "fresh lime juice", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons kosher salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 8, "raw": "4 teaspoons minced jalapeno", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "minced jalapeno", "preparation": null, "optional": false}, {"position": 9, "raw": "1 pound peeled, cooked shrimp", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "peeled", "preparation": "cooked shrimp", "optional": false}, {"position": 10, "raw": "2 papayas (about 1 pound each), peeled, seeded and cut into ¾-inch cubes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "papayas (about 1 pound each)", "preparation": "peeled, seeded and cut into ¾-inch cubes", "optional": false}, {"position": 11, "raw": "3 cups drained, rinsed, cooked or canned black beans (optional)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "drained", "preparation": "rinsed, cooked or canned black beans", "optional": true}, {"position": 12, "raw": "2 heads lettuce, like bibb or red leaf, washed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "head", "item": "lettuce", "preparation": "like bibb or red leaf, washed", "optional": false}, {"position": 13, "raw": "1 cup cilantro leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "cilantro leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Working with a bowl to collect the juices, peel oranges with paring knife, removing white pith. Cut out each section, leaving membrane behind. Place sections in medium bowl. Squeeze remains to extract juice, and set juice aside."}, {"position": 2, "text": "Heat oil in small saucepan over low heat. Stir in curry powder. Cook until fragrant, about 2 minutes. Stir in sugar, and cook until dissolved. Add rum. Using long kitchen match, carefully ignite rum. Remove from heat. Shake pan until flames subside. Stir in ⅔ cup reserved orange juice, along with lime juice, salt and jalapeno. Cool to room temperature."}, {"position": 3, "text": "Add shrimp and papaya to orange sections. Pour marinade over, and toss to combine, adding black beans, if using."}, {"position": 4, "text": "Divide lettuce among 6 plates. Top with shrimp. Drizzle with remaining dressing. Top with cilantro."}], "nutrition": {"calories": 448.7, "protein_g": 27.5, "carbohydrates_g": 62.1, "fat_g": 5.6, "saturated_fat_g": 1.1, "trans_fat_g": 0.0, "cholesterol_mg": 159.5, "sodium_mg": 1362.5, "fiber_g": 15.7, "sugar_g": 30.4, "unsaturated_fat_g": 4.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["caribbean"], "diet": ["low-fat"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["black bean", "cilantro", "curry powder", "lime juice", "orange", "papaya", "shellfish", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "1997-07-23", "scraped_at": "2026-09-07T00:57:01.466544+00:00", "scraper_version": "1.0.0"}
{"slug": "truffled-egg-salad", "nyt_id": 5853, "url": "https://cooking.nytimes.com/recipes/5853-truffled-egg-salad", "name": "Truffled Egg Salad", "author": "Amanda Hesser", "description": "", "servings": {"text": "Serves 4", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "8 eggs", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon mayonnaise", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "mayonnaise", "preparation": null, "optional": false}, {"position": 5, "raw": "Truffle salt, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "truffle salt", "preparation": "to taste", "optional": false}, {"position": 6, "raw": "8 slices white sandwich bread", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "slice", "item": "white sandwich bread", "preparation": null, "optional": false}, {"position": 7, "raw": "1 clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Fill a pan (large enough to fit the eggs in a single layer) with 2 inches of water. Bring to a boil. Gently lower the eggs into the water and cook for 9 ½ minutes. Drain. When cool enough to handle, peel the eggs. In a bowl, mash the eggs, then add the olive oil, mustard and mayonnaise and continue mash
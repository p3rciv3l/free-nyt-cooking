{"slug": "traditional-cold-weather-punch", "nyt_id": 1380, "url": "https://cooking.nytimes.com/recipes/1380-traditional-cold-weather-punch", "name": "Traditional Cold-Weather Punch", "author": "Frank J. Prial", "description": "Serving a hot punch is difficult unless it is placed over a heating element. Even then, hot drinks are better when served as soon as they are prepared.", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "1 fifth Barbados rum", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "fifth barbados rum", "preparation": null, "optional": false}, {"position": 2, "raw": "2 lemons", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "lemons", "preparation": null, "optional": false}, {"position": 3, "raw": "4 ounces sugar", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "3 pints boiling water", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "pint", "item": "boiling water", "preparation": null, "optional": false}, {"position": 5, "raw": "1 fifth brandy", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "fifth brandy", "preparation": null, "optional": false}, {"position": 6, "raw": "1 pint Sherry", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "sherry", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon ginger", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ginger", "preparation": null, "optional": false}, {"position": 8, "raw": "Grated nutmeg", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated nutmeg", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Macerate the lemon rinds and the sugar in a small earthenware bowl. Add the lemon juice and ginger. Mix well and place in a larger earthenware bowl. Then add, in order, the rum, brandy, Sherry and boiling water. Mix well, warm for 20 minutes, and serve it topped with nutmeg."}], "nutrition": {"calories": 363.3, "protein_g": 1.0, "carbohydrates_g": 48.9, "fat_g": 2.2, "saturated_fat_g": 1.5, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 27.0, "fiber_g": 2.3, "sugar_g": 30.8, "unsaturated_fat_g": 0.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": ["christmas"], "other": ["brandy", "quick", "winter"]}, "images": [], "rating": {"average": 3.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "1988-12-04", "scraped_at": "2026-09-07T03:30:18.077627+00:00", "scraper_version": "1.0.0"}
{"slug": "traditional-french-onion-soup", "nyt_id": 1151, "url": "https://cooking.nytimes.com/recipes/1151-traditional-french-onion-soup", "name": "Traditional French Onion Soup", "author": "Molly O’Neill", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 2, "raw": "12 large yellow onions, sliced very thin", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "large yellow onions", "preparation": "sliced very thin", "optional": false}, {"position": 3, "raw": "1 teaspoon salt, plus more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 4, "raw": "½ teaspoon black pepper, plus more to taste", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "black pepper", "preparation": "plus more to taste", "optional": false}, {"position": 5, "raw": "2 plum tomatoes, canned, seeds removed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "plum tomatoes", "preparation": "canned, seeds removed", "optional": false}, {"position": 6, "raw": "8 cups strong beef broth", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "cup", "item": "strong beef broth", "preparation": null, "optional": false}, {"position": 7, "raw": "4 branches fresh thyme", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "branches fresh thyme", "preparation": null, "optional": false}, {"position": 8, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 9, "raw": "Croutons and grated Gruyere cheese for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "croutons and grated gruyere cheese for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a sturdy soup pot over medium heat, melt the butter. Add the onions. Season with 1 teaspoon of salt and ½ teaspoon of pepper and stir well. Reduce the heat to low and cook the onions, stirring frequently until very deep brown. This will take about 20 to 40 minutes over low heat, depending on the quality of your soup pot. The onions must be minded carefully to avoid burning."}, {"position": 2, "text": "Crush the 2 tomatoes in your hands, add to the onions and stir. Add the beef broth, the thyme and bay leaf and simmer for at least 1 hour. Taste the soup and adjust seasoning with more salt and pepper to taste. Ladle into bowls and serve, or top each one with a toasted crouton and grated Gruyere cheese, pass under the broiler and then serve."}], "nutrition": {"calories": 151.6, "protein_g": 7.5, "carbohydrates_g": 25.0, "fat_g": 3.4, "saturated_fat_g": 2.0, "trans_fat_g": 0.0, "cholesterol_mg": 7.6, "sodium_mg": 776.6, "fiber_g": 4.3, "sugar_g": 11.2, "unsaturated_fat_g": 1.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["beef broth", "boil", "great leftovers", "gruyere", "onion", "saute", "soup"]}, "images": [], "rating": {"average": 4.0, "count": 138}, "video_url": null, "comment_count": null, "published_at": "1996-12-08", "scraped_at": "2026-09-07T02:22:41.159909+00:00", "scraper_version": "1.0.0"}
{"slug": "traditional-spring-rolls", "nyt_id": 11974, "url": "https://cooking.nytimes.com/recipes/11974-traditional-spring-rolls", "name": "Traditional Spring Rolls", "author": "Nina Simonds", "description": "", "servings": {"text": "16 spring rolls", "min": 16, "max": 16, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound boneless center-cut pork loin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "boneless center-cut pork loin", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon rice wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "rice wine", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon sesame oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sesame oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon cornstarch", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "water", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon rice wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "rice wine", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ teaspoon freshly ground black pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "1 teaspoon cornstarch", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 12, "raw": "¼ cup flour", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": null, "optional": false}, {"position": 13, "raw": "6 tablespoons water", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "water", "preparation": null, "optional": false}, {"position": 14, "raw": "½ cup safflower or corn oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "safflower or corn oil", "preparation": null, "optional": false}, {"position": 15, "raw": "4 cups shredded Chinese or Napa cabbage", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "shredded chinese or napa cabbage", "preparation": null, "optional": false}, {"position": 16, "raw": "3 cups Chinese chives or scallion greens, cut into 1-inch sections", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "chinese chives or scallion greens", "preparation": "cut into 1-inch sections", "optional": false}, {"position": 17, "raw": "4 cups fresh bean sprouts, rinsed lightly and drained", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "fresh bean sprouts", "preparation": "rinsed lightly and drained", "optional": false}, {"position": 18, "raw": "2 tablespoons rice wine", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "rice wine", "preparation": null, "optional": false}, {"position": 19, "raw": "6 dried Chinese black mushrooms, softened in hot water, stems removed and caps shredded", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "dried chinese black mushrooms", "preparation": "softened in hot water, stems removed and caps shredded", "optional": false}, {"position": 20, "raw": "5 ½ cups safflower or corn oil", "group": null, "quantity": 5.5, "quantity_max": null, "unit": "cup", "item": "safflower or corn oil", "preparation": null, "optional": false}, {"position": 21, "raw": "16 spring roll wrappers, or lumpia skins", "group": null, "quantity": 16.0, "quantity_max": null, "unit": null, "item": "spring roll wrappers", "preparation": "or lumpia skins", "optional": false}], "steps": [{"position": 1, "text": "Remove any fat or gristle from the pork loin. Going across the grain, make paper-thin slices and cut them into matchstick-size shreds. Place the shreds in a bowl, add the marinade, toss lightly to coat, and let stand 15 minutes. Combine the sauce ingredients."}, {"position": 2, "text": "For the paste, combine the flour and water with a whisk until smooth."}, {"position": 3, "text": "Heat a well-seasoned wok, add 3 tablespoons oil, and heat until very hot. Add the Chinese cabbage and stir until just wilted, about 1 ½ minutes. Add the Chinese chives or scallions, the bean sprouts and the two tablespoons of rice wine. Stir-fry another minute over high heat and remove with a strainer. Drain off any liquid and spread the mixture out on a tray to cool."}, {"position": 4, "text": "Reheat the wok, add 3 tablespoons of oil and heat until very hot. Add the pork shreds and fry over high heat, stirring constantly, until they separate and change color. Remove and drain."}, {"position": 5, "text": "Drain the pan, add 2 tablespoons of oil and heat until very hot. Add the shredded black mushrooms and toss lightly over high heat 30 seconds, until fragrant. Add the cooked pork and the sauce. Stir-fry briefly until sauce thickens and remove. Spread on a platter and cool. Once cool, mix with the cabbage-bean sprout mixture."}, {"position": 6, "text": "Arrange one spring roll wrapper flat on a counter. (Cover the others with a damp cloth to keep them them from drying out.) Grab a portion of filling - about ¼ cup - and squeeze out any excess liquid. Place the filling across the lower third of the skin and, using your finger, spread some paste on the opposite edge. Starting at the edge near the filling, roll up the skin a little to enclose it. Fold in the two side ends and continue rolling over so that the skin forms a tight little package. Repeat for remaining skins and filling."}, {"position": 7, "text": "Heat a wok, add remaining oil and heat to 375 degrees. Add five or six spring rolls and fry, turning constantly, until golden brown and crisp. Remove with a slotted spoon; drain until cool on absorbent paper. Fry remaining rolls. Serve with hot mustard and plum sauce."}], "nutrition": {"calories": 492.0, "protein_g": 4.2, "carbohydrates_g": 8.1, "fat_g": 49.0, "saturated_fat_g": 6.8, "trans_fat_g": 0.0, "cholesterol_mg": 10.2, "sodium_mg": 130.5, "fiber_g": 0.8, "sugar_g": 1.3, "unsaturated_fat_g": 39.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian", "chinese"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["fry", "pork", "project"]}, "images": [], "rating": {"average": 4.0, "count": 44}, "video_url": null, "comment_count": null, "published_at": "1986-05-07", "scraped_at": "2026-09-07T02:45:00.825554+00:00", "scraper_version": "1.0.0"}
{"slug": "transylvanian-goulash", "nyt_id": 11387, "url": "https://cooking.nytimes.com/recipes/11387-transylvanian-goulash", "name": "Transylvanian Goulash", "author": "Sara Dickerman", "description": "Sara Dickerman", "servings": {"text": "Serves 4", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "1 hour 45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound sauerkraut, fresh, canned or packaged (note: a 1-pound jar of sauerkraut weighs far less when drained)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "sauerkraut", "preparation": "fresh, canned or packaged (note: a 1-pound jar of sauerkraut weighs far less when drained)", "optional": false}, {"position": 2, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup finely chopped onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "finely chopped onion", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ teaspoon chopped garlic", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "chopped garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons sweet paprika", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sweet paprika", "preparation": null, "optional": false}, {"position": 7, "raw": "3 cups chicken broth", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 8, "raw": "2 ½ to 3 pounds boneless pork shoulder, trimmed of fat and cut into 1-inch cubes", "group": null, "quantity": 2.5, "quantity_max": 3.0, "unit": "lb", "item": "boneless pork shoulder", "preparation": "trimmed of fat and cut into 1-inch cubes", "optional": false}, {"position": 9, "raw": "1 ½ teaspoons caraway seeds", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "caraway seeds", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup tomato purée", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "tomato purée", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup sour cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 12, "raw": "½ cup heavy cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Wash the sauerkraut thoroughly under cold running water, then soak it in cold water for 10 to 20 minutes to reduce its sourness. Strain well, pressing out all the water."}, {"position": 2, "text": "Melt the butter in a 5-quart casserole and add the onion. Cook over medium heat, stirring occasionally, until lightly colored, 6 to 8 minutes. Add the garlic, season with salt and cook a minute or two longer. Stir in the paprika, pour in ½ cup of the broth and bring to a boil. Add the pork cubes."}, {"position": 3, "text": "Spread the sauerkraut over the pork and sprinkle it with the caraway seeds. In a small bowl, combine the tomato purée and the rest of the broth and pour the mixture over the sauerkraut. Bring the liquid to a boil once more, then reduce the heat to its lowest point. Season the cooking liquid with a pinch of salt, cover the casserole tightly and simmer for 1 hour. Check occasionally to make sure the liquid has not cooked away. Add a little stock or water if needed; the sauerkraut should be moist."}, {"position": 4, "text": "When the pork is tender, combine the creams in a mixing bowl. Beat the flour into the creams with a whisk, then carefully stir this mixture into the casserole. Simmer for 10 minutes longer. Season with salt to taste. Serve in large, wide bowls, accompanied by a side of sour cream."}], "nutrition": {"calories": 1079.9, "protein_g": 62.6, "carbohydrates_g": 23.8, "fat_g": 81.2, "saturated_fat_g": 33.5, "trans_fat_g": 0.6, "cholesterol_mg": 292.7, "sodium_mg": 1708.6, "fiber_g": 5.9, "sugar_g": 9.5, "unsaturated_fat_g": 39.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["eastern european"], "diet": ["gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["braise", "great leftovers", "pork", "sauerkraut", "stew"]}, "images": [], "rating": {"average": 4.0, "count": 119}, "video_url": null, "comment_count": null, "published_at": "2006-02-05", "scraped_at": "2026-09-07T02:16:57.612446+00:00", "scraper_version": "1.0.0"}
{"slug": "tripe-soup", "nyt_id": 1045, "url": "https://cooking.nytimes.com/recipes/1045-tripe-soup", "name": "Tripe Soup", "author": "Moira Hodgson", "description": "", "servings": {"text": "6 - 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "4 hours"}}, "ingredients": [{"position": 1, "raw": "1 calf's foot (about 1-1 ½ pounds)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "calf's foot (about 1-1 ½ pounds)", "preparation": null, "optional": false}, {"position": 2, "raw": "2 pounds honeycomb tripe", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "honeycomb tripe", "preparation": null, "optional": false}, {"position": 3, "raw": "1 large onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large onion", "preparation": null, "optional": false}, {"position": 4, "raw": "3 cloves garlic, peeled", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "3 large chilis anchos", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large chilis anchos", "preparation": null, "optional": false}, {"position": 7, "raw": "1 large chili poblano, roasted and peeled or 2 canned, peeled green chilis", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large chili poblano", "preparation": "roasted and peeled or 2 canned, peeled green chilis", "optional": false}, {"position": 8, "raw": "1 ½ cups canned hominy (1 pound), drained", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "canned hominy (1 pound)", "preparation": "drained", "optional": false}, {"position": 9, "raw": "1 scant teaspoon oregano", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "scant teaspoon oregano", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Have the butcher cut the calf's foot into 4 pieces. Cut the tripe into small squares. Put them into a large saucepan with the onion, garlic, salt and pepper. Cover with 4 quarts water and bring to boil. Lower the flame and simmer uncovered for about 2 hours, or until the tripe and foot are just tender but not too soft."}, {"position": 2, "text": "Meanwhile, toast the chilis well. Slit them open and remove the seeds and veins. Grind them dry to a fine powder. Add it to the saucepan as the meat is cooking."}, {"position": 3, "text": "Remove the seeds and veins from the chili poblano, cut it into strips and add to the meat while it is cooking."}, {"position": 4, "text": "Remove the pieces of calf's foot from the pan, and when they are cool enough to handle strip off the fleshy parts. Chop them roughly and return them to the pan."}, {"position": 5, "text": "Add the hominy and continue cooking the soup slowly, still uncovered, for another 2 hours. Add salt as necessary. Sprinkle with oregano and serve."}], "nutrition": {"calories": 168.4, "protein_g": 15.8, "carbohydrates_g": 14.5, "fat_g": 5.3, "saturated_fat_g": 1.6, "trans_fat_g": 0.2, "cholesterol_mg": 138.3, "sodium_mg": 471.4, "fiber_g": 3.4, "sugar_g": 2.0, "unsaturated_fat_g": 2.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["mexican"], "diet": [], "course": ["main course"], "meal": [], "occasion": ["new year’s day"], "other": ["boil", "great leftovers", "soup", "winter"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1985-12-29", "scraped_at": "2026-09-06T22:23:54.645633+00:00", "scraper_version": "1.0.0"}

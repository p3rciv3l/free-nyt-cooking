{"slug": "mr-october", "nyt_id": 12943, "url": "https://cooking.nytimes.com/recipes/12943-mr-october", "name": "Mr. October", "author": "Robert Simonson", "description": "The Mr. October was created as a fall cocktail, using Laird’s bonded apple brandy as a base. Cinnamon syrup, lemon juice, Galliano liqueur, a couple of dashes of allspice liqueur and freshly ground nutmeg add to the seasonality. This cocktail tastes not only like apple pie, but apple pie à la mode, thanks to Galliano’s vanilla notes. Robert Simonson", "servings": {"text": "1 drink", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": null, "raw": {}}, "ingredients": [{"position": 1, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "3 cinnamon sticks", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "cinnamon sticks", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ ounces Laird’s bonded apple brandy (be certain it’s the bonded version)", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "laird’s bonded apple brandy (be certain it’s the bonded version)", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ ounce lemon juice", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "oz", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 5, "raw": "½ ounce Galliano liqueur", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "oz", "item": "galliano liqueur", "preparation": null, "optional": false}, {"position": 6, "raw": "2 dashes St. Elizabeth Allspice Dram", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "dash", "item": "st. elizabeth allspice dram", "preparation": null, "optional": false}, {"position": 7, "raw": "Pinch ground nutmeg", "group": null, "quantity": null, "qu
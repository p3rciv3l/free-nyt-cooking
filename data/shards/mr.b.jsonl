{"slug": "mr-ds-strawberry-almond-tart", "nyt_id": 7885, "url": "https://cooking.nytimes.com/recipes/7885-mr-ds-strawberry-almond-tart", "name": "Mr. D.'s Strawberry -Almond Tart", "author": "Molly O’Neill", "description": "", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 95, "total_minutes": 95, "raw": {"cook": "1 hour 35 minutes", "total": "1 hour 35 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ¼ cups all-purpose flour", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "2 teaspoons sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup cold unsalted butter, cut in pieces", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "cold unsalted butter", "preparation": "cut in pieces", "optional": false}, {"position": 5, "raw": "¼ cup ice water", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "ice water", "preparation": null, "optional": false}, {"position": 6, "raw": "4 ounces almond paste", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "almond paste", "preparation": null, "optional": false}, {"position": 7, "raw": "4 tablespoons cold unsalted butter, cut into small pieces", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "cold unsalted butter", "preparation": "cut into small pieces", "optional": false}, {"position": 8, "raw": "¼ cup all-purpose flour", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 10, "raw": "⅛ teaspoon salt", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 11, "raw": "1 egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": null, "optional": false}, {"position": 12, "raw": "½ teaspoon vanilla extract", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 13, "raw": "2 pints fresh strawberries, hulled and halved", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "pint", "item": "fresh strawberries", "preparation": "hulled and halved", "optional": false}, {"position": 14, "raw": "Confectioners' sugar, for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "confectioners' sugar", "preparation": "for garnish", "optional": false}], "steps": [{"position": 1, "text": "Place the flour, salt and sugar in a food processor and pulse to combine. Add the butter and pulse until the mixture is the size of small peas. Add the water and pulse until the dough barely begins to come together. Press the dough together with your hands, flatten into a disk, wrap in plastic and refrigerate for 30 minutes."}, {"position": 2, "text": "Preheat the oven to 350 degrees. Roll the dough out to a ⅛-inch thickness. Fit it into a 9-inch quiche dish. Line the dish with parchment paper, fill with pie weights or raw beans and bake for 25 minutes. Remove the paper and weights and bake for 2 minutes more. Set aside."}, {"position": 3, "text": "Place the almond paste and butter in a food processor and process until smooth. Mix in the flour, sugar and salt. Add the egg and vanilla and process until smooth. Scrape the mixture into the tart shell, spread evenly and bake until set, about 15 minutes. Cool."}, {"position": 4, "text": "Make a ring of strawberries around the edge of the dish, leaning the cut side of the berries up against the edge. Repeat, making concentric circles until the tart is covered. Just before serving, sift confectioners' sugar over the top. Cut into wedges and serve."}], "nutrition": {"calories": 485.0, "protein_g": 6.9, "carbohydrates_g": 50.3, "fat_g": 29.6, "saturated_fat_g": 15.1, "unsaturated_fat_g": null, "trans_fat_g": 0.0, "cholesterol_mg": 87.7, "sodium_mg": 162.8, "fiber_g": 4.1, "sugar_g": 21.0, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["almond paste", "bake", "spring", "strawberry", "summer", "tart crust"]}, "images": [], "rating": {"average": 4.0, "count": 14}, "video_url": null, "comment_count": null, "published_at": "1997-04-13", "scraped_at": "2026-09-07T10:17:08.576126+00:00", "scraper_version": "1.0.0"}
{"slug": "mr-october", "nyt_id": 12943, "url": "https://cooking.nytimes.com/recipes/12943-mr-october", "name": "Mr. October", "author": "Robert Simonson", "description": "The Mr. October was created as a fall cocktail, using Laird’s bonded apple brandy as a base. Cinnamon syrup, lemon juice, Galliano liqueur, a couple of dashes of allspice liqueur and freshly ground nutmeg add to the seasonality. This cocktail tastes not only like apple pie, but apple pie à la mode, thanks to Galliano’s vanilla notes. Robert Simonson", "servings": {"text": "1 drink", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": null, "raw": {}}, "ingredients": [{"position": 1, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "3 cinnamon sticks", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "cinnamon sticks", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ ounces Laird’s bonded apple brandy (be certain it’s the bonded version)", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "laird’s bonded apple brandy (be certain it’s the bonded version)", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ ounce lemon juice", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "oz", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 5, "raw": "½ ounce Galliano liqueur", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "oz", "item": "galliano liqueur", "preparation": null, "optional": false}, {"position": 6, "raw": "2 dashes St. Elizabeth Allspice Dram", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "dash", "item": "st. elizabeth allspice dram", "preparation": null, "optional": false}, {"position": 7, "raw": "Pinch ground nutmeg", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch ground nutmeg", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Make the syrup: Combine the sugar, cinnamon and 1 cup water in a small pan over medium heat. Let simmer about 15 minutes. Strain. Allow syrup to cool before using. (Can be refrigerated.)"}, {"position": 2, "text": "Mix the drink: In a shaker with ice, put ¾ ounce of the cinnamon syrup with the apple brandy, lemon juice, liqueur and allspice dram. Shake. Double strain into chilled cocktail glass. Dust with nutmeg."}], "nutrition": {"calories": 945.9, "protein_g": 0.4, "carbohydrates_g": 214.8, "fat_g": 0.3, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 5.0, "fiber_g": 4.3, "sugar_g": 205.7, "unsaturated_fat_g": 0.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": ["thanksgiving"], "other": ["boil", "brandy", "cinnamon", "cocktails", "fall", "lemon juice", "not-shoppable-ic", "quick"]}, "images": [{"url": "https://static01.nyt.com/images/2014/04/11/dining/October/October-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 39}, "video_url": null, "comment_count": null, "published_at": "2012-11-14", "scraped_at": "2026-09-07T03:25:55.854986+00:00", "scraper_version": "1.0.0"}
{"slug": "mrs-hoviss-fried-chicken", "nyt_id": 3555, "url": "https://cooking.nytimes.com/recipes/3555-mrs-hoviss-fried-chicken", "name": "Mrs. Hovis's Fried Chicken", "author": "Craig Claiborne", "description": "", "servings": {"text": "8 or more servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 chickens, each about 3 pounds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "chickens", "preparation": "each about 3 pounds", "optional": false}, {"position": 2, "raw": "2 teaspoons coarse salt, such as kosher salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "coarse salt", "preparation": "such as kosher salt", "optional": false}, {"position": 3, "raw": "1 tablespoon freshly ground black pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon poultry seasoning", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "poultry seasoning", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon paprika", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "paprika", "preparation": null, "optional": false}, {"position": 6, "raw": "Pinch of cayenne pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of cayenne pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "2 cups unbleached flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "unbleached flour", "preparation": null, "optional": false}, {"position": 8, "raw": "1 pound solid white shortening", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "solid white shortening", "preparation": null, "optional": false}, {"position": 9, "raw": "1 pound pure lard (or increase the quantity of white shortening by 1 pound)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "pure lard (or increase the quantity of white shortening by 1 pound)", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup bacon fat", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "bacon fat", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Carefully cut each chicken into 8 pieces: 2 legs, 2 thighs, 2 breast pieces, 2 wings (with wing tips removed, if desired). Use the carcasses for soups and stock."}, {"position": 2, "text": "Combine the salt, black pepper, poultry seasoning, paprika and cayenne, and blend well. Coat chicken pieces with this mixture."}, {"position": 3, "text": "Coat the pieces with flour. The Southern technique calls for putting the flour in a large, heavy brown paper bag, adding the chicken pieces a few at a time and tossing. Remove and shake off excess flour."}, {"position": 4, "text": "Heat half the white shortening, half the lard and half the bacon fat in each of two large skillets, preferably black iron. Heat the fat until it is lightly smoking."}, {"position": 5, "text": "Put the chicken pieces in, skin side up, and cook until crisp and golden brown on one side, about 12 to 14 minutes. Turn the pieces and continue cooking 12 to 14 minutes on the second side, taking care not to burn the pieces."}], "nutrition": {"calories": 1920.9, "protein_g": 66.7, "carbohydrates_g": 25.0, "fat_g": 171.6, "saturated_fat_g": 53.7, "trans_fat_g": 7.8, "cholesterol_mg": 315.1, "sodium_mg": 722.4, "fiber_g": 1.4, "sugar_g": 0.2, "unsaturated_fat_g": 107.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["southern"], "diet": ["dairy-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["chicken", "fry"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1984-02-15", "scraped_at": "2026-09-07T05:18:46.442590+00:00", "scraper_version": "1.0.0"}
{"slug": "mrs-hoviss-hot-upside-down-apple-pie", "nyt_id": 3560, "url": "https://cooking.nytimes.com/recipes/3560-mrs-hoviss-hot-upside-down-apple-pie", "name": "Mrs. Hovis's Hot Upside-Down Apple Pie", "author": "Craig Claiborne", "description": "", "servings": {"text": "12 or more servings", "min": 12, "max": 12, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 100, "raw": {"total": "1 hour 40 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups unbleached flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "unbleached flour", "preparation": null, "optional": false}, {"position": 2, "raw": "½ pound chilled butter, cut into small pieces", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "chilled butter", "preparation": "cut into small pieces", "optional": false}, {"position": 3, "raw": "5 to 6 tablespoons ice water", "group": null, "quantity": 5.0, "quantity_max": 6.0, "unit": "tbsp", "item": "ice water", "preparation": null, "optional": false}, {"position": 4, "raw": "8 tablespoons melted butter", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "tbsp", "item": "melted butter", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup dark brown sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dark brown sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon grated lemon rind", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "grated lemon rind", "preparation": null, "optional": false}, {"position": 7, "raw": "2 teaspoons arrowroot", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "arrowroot", "preparation": null, "optional": false}, {"position": 8, "raw": "4 or 5 apples, such as Granny Smiths, about 2 pounds", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "or 5 apples", "preparation": "such as Granny Smiths, about 2 pounds", "optional": false}, {"position": 9, "raw": "2 tablespoons bourbon", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "bourbon", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put the flour in a mixing bowl and add the butter pieces. Work the flour and butter together with the fingers or a pastry blender until well blended."}, {"position": 2, "text": "Gradually sprinkle the mixture with ice water, using only enough so that the dough holds together and can be formed into a ball. Shape the dough into a ball and flatten slightly. Wrap closely in plastic wrap and refrigerate until ready to use."}, {"position": 3, "text": "Pour the melted butter into a dish about 1 ½ to 2 inches deep and 12 inches in diameter (the dish might also be rectangular)."}, {"position": 4, "text": "Sprinkle evenly with the brown sugar, grated lemon rind and arrowroot."}, {"position": 5, "text": "Peel the apples and cut away any blemishes. Quarter the apples and cut away the cores. Cut the quarters lengthwise in half. Arrange the apple pieces in neat concentric circles over the brown sugar mixture."}, {"position": 6, "text": "Sprinkle the bourbon over the apples."}, {"position": 7, "text": "Roll out the dough on a lightly floured surface into a circle about 13 inches in diameter. Carefully place the dough on top of the apples and gently fold over the overhanging edges toward the center, pressing down lightly all around the outer rim of dough so that the apples are totally covered with dough."}, {"position": 8, "text": "Cover closely with plastic wrap and refrigerate until ready to bake."}, {"position": 9, "text": "When ready to bake preheat the oven to 400 degrees."}, {"position": 10, "text": "Place the pie in the oven and bake one hour. Remove to a rack and let cool briefly."}, {"position": 11, "text": "Run a knife around the inside rim of the pie. Place a large dish over the pie. Quickly invert the pie onto the plate. Serve hot or at room temperature."}], "nutrition": {"calories": 369.4, "protein_g": 2.7, "carbohydrates_g": 36.8, "fat_g": 23.3, "saturated_fat_g": 14.4, "trans_fat_g": 0.0, "cholesterol_mg": 61.0, "sodium_mg": 8.0, "fiber_g": 2.5, "sugar_g": 18.1, "unsaturated_fat_g": 7.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["southern"], "diet": ["vegetarian"], "course": ["dessert"], "meal": [], "occasion": [], "other": ["all-purpose flour", "apple", "apple pie", "bake", "butter", "baking"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1984-02-15", "scraped_at": "2026-09-07T05:19:05.722784+00:00", "scraper_version": "1.0.0"}

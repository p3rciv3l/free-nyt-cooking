{"slug": "mr-bs-shrimp-and-ham-melange", "nyt_id": 2462, "url": "https://cooking.nytimes.com/recipes/2462-mr-bs-shrimp-and-ham-melange", "name": "Mr. B's Shrimp and Ham Melange", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ pounds shrimp in the shell", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "shrimp in the shell", "preparation": null, "optional": false}, {"position": 2, "raw": "2 or 3 red, ripe tomatoes, about ½ pound", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "or 3 red", "preparation": "ripe tomatoes, about ½ pound", "optional": false}, {"position": 3, "raw": "⅛ pound thinly sliced smoked cooked ham or prosciutto", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "lb", "item": "thinly sliced smoked cooked ham or prosciutto", "preparation": null, "optional": false}, {"position": 4, "raw": "⅛ teaspoon paprika", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "paprika", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt to taste if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste if desired", "preparation": null, "optional": false}, {"position": 6, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ teaspoon dried thyme", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon dried oregano", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "dried oregano", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 10, "raw": "1 teaspoon chopped white part of a green onion or scallion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped white part of a green onion or scallion", "preparation": null, "optional": false}, {"position": 11, "raw": "¾ cup chopped green part of green onions or scallions", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "chopped green part of green onions or scallions", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons finely chopped shallots", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped shallots", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ cup dry white wine", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 15, "raw": "1 tablespoon tarragon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "tarragon", "preparation": null, "optional": false}, {"position": 16, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 17, "raw": "2 tablespoons Dijon-style mustard", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "dijon-style mustard", "preparation": null, "optional": false}, {"position": 18, "raw": "Parmesan cheese hard rolls (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "parmesan cheese hard rolls (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Shell and devein the shrimp and put them in a mixing bowl. Set aside."}, {"position": 2, "text": "Drop tomatoes into boiling water and let stand 10 seconds. Drain. Pull away and discard the skin. Cut away and discard the cores. Cut tomatoes in half crosswise and squeeze away most of the seeds."}, {"position": 3, "text": "Cut tomato halves into ¼-inch dice. There should be about 1 cup."}, {"position": 4, "text": "Cut ham into very small cubes. There should be about ½ cup."}, {"position": 5, "text": "To the shrimp add the paprika, salt, pepper, thyme, oregano, garlic, all the chopped white part of a green onion or scallion and ¼ cup of the chopped green part. Blend well with the fingers."}, {"position": 6, "text": "Heat butter in a heavy skillet and add shallots and shrimp mixture. Cook, stirring, about 2 minutes or until shrimp lose their raw look. Scoop them out into a warm dish."}, {"position": 7, "text": "Add wine, tomatoes, ¼ cup green onions and tarragon. Cook, stirring, about 30 seconds and add cream, salt and pepper. Bring to the boil and stir in mustard. Cook, stirring, about 2 minutes or until thickened lightly and saucelike."}, {"position": 8, "text": "Add ham and shrimp and stir until they are coated with sauce."}, {"position": 9, "text": "Arrange hard roll halves broiled side up on serving dish and pour shrimp in sauce over all. Sprinkle with remaining ¼ cup green part of onion."}], "nutrition": {"calories": 470.0, "protein_g": 42.6, "carbohydrates_g": 9.9, "fat_g": 28.8, "saturated_fat_g": 16.8, "trans_fat_g": 0.7, "cholesterol_mg": 361.6, "sodium_mg": 885.3, "fiber_g": 2.5, "sugar_g": 5.0, "unsaturated_fat_g": 9.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["ham", "he
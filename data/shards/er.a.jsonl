{"slug": "ermine-icing", "nyt_id": 1016330, "url": "https://cooking.nytimes.com/recipes/1016330-ermine-icing", "name": "Ermine Icing", "author": "Kim Severson", "description": "This is an old-fashioned icing, also called boiled-milk frosting. The results are as light as whipped cream but with much more character. It was the original icing for red velvet cake. For best results, you may want to double it: A little extra frosting never hurts.", "servings": {"text": "1 cake with 2 or 3 layers", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "5 tablespoons/40 grams flour", "group": null, "quantity": 5.0, "unit": "tbsp", "item": "/40 grams flour", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup/235 milliliters whole milk", "group": null, "quantity": 1.0, "unit": "cup", "item": "/235 milliliters whole milk", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon/5 milliliters vanilla extract", "group": null, "quantity": 1.0, "unit": "tsp", "item": "/5 milliliters vanilla extract", "preparation": null, "optional": false}, {"position": 4, "raw": "Pinch of salt", "group": null, "quantity": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup/ 230 grams unsalted butter, softened", "group": null, "quantity": 1.0, "unit": "cup", "item": "/ 230 grams unsalted butter", "preparation": "softened", "optional": false}, {"position": 6, "raw": "1 cup/200 grams granulated sugar", "group": null, "quantity": 1.0, "unit": "cup", "item": "/200 grams granulated sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Over medium heat, whisk flour and milk in a small saucepan and heat to a simmer, stirring frequently until it becomes very thick and almost puddinglike."}, {"position": 2, "text": "Remove from heat, whisk in vanilla and salt. Pour into a bowl to allow it to cool completely. Put plastic wrap on the surface to keep a skin from forming."}, {"position": 3, "text": "Use a mixer to cream together butter and sugar until light and fluffy, scraping the sides of the bowl occasionally, about 5 minutes. With the mixer on medium, add the cooled flour mixture a little bit at a time. Continue to beat until the mixture becomes light and fluffy and resembles whipped cream."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 673.5, "protein_g": 4.0, "carbohydrates_g": 57.2, "fat_g": 49.1, "saturated_fat_g": 30.2, "unsaturated_fat_g": 2.1, "trans_fat_g": null, "cholesterol_mg": 129.7, "sodium_mg": 74.5, "fiber_g": 0.8, "sugar_g": 53.9, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert-frosting"], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://static01.nyt.com/images/2020/12/20/autossell/RV-Cake-textless/RV-Cake-textless-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2020/12/20/autossell/RV-Cake-textless/RV-Cake-textless-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2020/12/20/autossell/RV-Cake-textless/RV-Cake-textless-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2020/12/20/autossell/RV-Cake-textless/RV-Cake-textless-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 1571}, "video_url": "https://vp.nyt.com/video/2020/12/02/90341_1_Red-Velvet-Cake-YT_wg_480p.mp4", "comment_count": null, "published_at": "2014-05-14", "scraped_at": "2026-09-07T03:08:44Z", "scraper_version": "1.0.0"}

{"slug": "seafood-stew-with-vegetables", "nyt_id": 11798, "url": "https://cooking.nytimes.com/recipes/11798-seafood-stew-with-vegetables", "name": "Seafood Stew With Vegetables", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups bay or ocean scallops", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "bay or ocean scallops", "preparation": null, "optional": false}, {"position": 2, "raw": "1 pound shrimp, shelled and deveined", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "shrimp", "preparation": "shelled and deveined", "optional": false}, {"position": 3, "raw": "1 cup oysters with their liquor", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "oysters with their liquor", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste if desired", "preparation": null, "optional": false}, {"position": 5, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tomato, about ½ pound", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "tomato", "preparation": "about ½ pound", "optional": false}, {"position": 7, "raw": "2 ribs celery", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "ribs celery", "preparation": null, "optional": false}, {"position": 8, "raw": "1 small carrot, trimmed and scraped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small carrot", "preparation": "trimmed and scraped", "optional": false}, {"position": 9, "raw": "1 2-inch length of leek", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "2-inch length of leek", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 11, "raw": "⅓ cup finely chopped onion", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "finely chopped onion", "preparation": null, "optional": false}, {"position": 12, "raw": "1 teaspoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 13, "raw": "½ teaspoon turmeric", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "turmeric", "preparation": null, "optional": false}, {"position": 14, "raw": "½ cup dry white wine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 15, "raw": "1 cup fish broth or bottled clam juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fish broth or bottled clam juice", "preparation": null, "optional": false}, {"position": 16, "raw": "2 teaspoons tomato paste", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 17, "raw": "2 teaspoons grated fresh ginger", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "grated fresh ginger", "preparation": null, "optional": false}, {"position": 18, "raw": "3 tablespoons finely chopped parsley", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut ocean scallops into quarters; leave bay scallops whole. Sprinkle scallops, shrimp and oysters with a small amount of salt and pepper."}, {"position": 2, "text": "Peel tomato and remove seeds. Cut into ¼-inch cubes. There should be about ¾ cup."}, {"position": 3, "text": "Cut celery crosswise into thin pieces. There should be about ½ cup."}, {"position": 4, "text": "Cut carrot crosswise into 1 ½-inch lengths. Cut pieces lengthwise into very thin julienne strips. There should be about 1 cup."}, {"position": 5, "text": "Cut leek into very thin julienne strips. There should be about ½ cup."}, {"position": 6, "text": "Heat oil in skillet and add onion and garlic. Cook, stirring, until onion is wilted. Add celery, carrot and leek. Sprinkle with turmeric. Cook, stirring, about 2 minutes."}, {"position": 7, "text": "Add wine and fish broth. Stir in tomato paste and ginger. Cook about 5 minutes."}, {"position": 8, "text": "Add tomato and scallops and bring to boil. Cook about 1 minute and add oysters, in their liquor, and shrimp. Cook about 2 ½ minutes. Stir in parsley and serve."}], "nutrition": {"calories": 292.6, "protein_g": 34.2, "carbohydrates_g": 14.1, "fat_g": 9.3, "saturated_fat_g": 1.5, "trans_fat_g": 0.0, "cholesterol_mg": 219.7, "sodium_mg": 963.5, "fiber_g": 2.6, "sugar_g": 4.5, "unsaturated_fat_g": 6.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["main course"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["boil", "fish", "saute", "seafood", "shellfish", "stew"]}, "images": [], "rating": {"average": 4.0, "count": 14}, "video_url": null, "comment_count": null, "published_at": "1986-05-07", "scraped_at": "2026-09-06T23:49:56.221309+00:00", "scraper_version": "1.0.0"}
{"slug": "seared-green-bean-salad", "nyt_id": 10794, "url": "https://cooking.nytimes.com/recipes/10794-seared-green-bean-salad", "name": "Seared Green-Bean Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound small Yukon gold potatoes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "small yukon gold potatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup extra-virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 pounds green beans, trimmed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "green beans", "preparation": "trimmed", "optional": false}, {"position": 4, "raw": "2 tablespoons sesame seeds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sesame seeds", "preparation": null, "optional": false}, {"position": 5, "raw": "1 large shallot, peeled and sliced paper thin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large shallot", "preparation": "peeled and sliced paper thin", "optional": false}, {"position": 6, "raw": "1 large lemon, juiced (about 2 tablespoons)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large lemon", "preparation": "juiced (about 2 tablespoons)", "optional": false}, {"position": 7, "raw": "2 teaspoons sesame oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "sesame oil", "preparation": null, "optional": false}, {"position": 8, "raw": "Kosher salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon freshly ground pepper, plus more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "freshly ground pepper", "preparation": "plus more to taste", "optional": false}], "steps": [{"position": 1, "text": "Slice the potatoes into quarters, place them in a pot, cover with cold water and bring to a boil over high heat. Cook an additional 4 minutes. Drain and place them, cut sides up, on a towel to dry."}, {"position": 2, "text": "Coat a large frying pan with a thin layer of oil and place over high heat. When the oil becomes fragrant, arrange enough of the beans to cover the bottom of the pan. Sear on one side for 3 minutes. Do not turn. Place the beans in a bowl and cover. Repeat in batches with the remaining beans, adding them to the bowl and covering it."}, {"position": 3, "text": "Place the potatoes, cut sides down, in a large frying pan with a thick layer of olive oil. Fry over medium-low heat for 20 minutes. Fry only one side; do not turn."}, {"position": 4, "text": "In a dry pan, roast the sesame seeds. Slice the shallot. Add these as well as the lemon juice, sesame oil, salt and pepper and about a tablespoon of olive oil, or more to taste, to the green beans. Add the potatoes and toss. Chill before serving."}], "nutrition": {"calories": 184.2, "protein_g": 3.2, "carbohydrates_g": 16.5, "fat_g": 12.9, "saturated_fat_g": 1.8, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 374.9, "fiber_g": 4.0, "sugar_g": 4.0, "unsaturated_fat_g": 10.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["appetizer", "side dish"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["boil", "fry", "green bean", "salad", "shallot"]}, "images": [], "rating": {"average": 5.0, "count": 12}, "video_url": null, "comment_count": null, "published_at": "1998-08-23", "sc
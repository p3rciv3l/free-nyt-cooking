{"slug": "seared-zucchini-and-halloumi-in-red-wine-vinaigrette", "nyt_id": 779127092, "url": "https://cooking.nytimes.com/recipes/779127092-seared-zucchini-and-halloumi-in-red-wine-vinaigrette", "name": "Seared Zucchini and Halloumi in Red-Wine Vinaigrette", "author": "Ali Slagle", "description": "This spectacular but simple side dish pairs golden, crisp-tender rounds of zucchini with salty, molten cheese, a garlicky red-wine vinaigrette and fresh herbs. Start by searing the zucchini in a skillet, then transfer it to a platter where it can soak up the punchy vinaigrette. Meanwhile, sear craggy pieces of halloumi in the same skillet. It’s added to the zucchini just before serving so the edges stay crunchy. Eat with whole grains, pita, hummus, grilled fish, chicken kebabs or other Mediterranean dishes.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 25, "total_minutes": 30, "raw": {"total": "30 min", "prep": "PT0H5M", "cook": "PT0H25M"}}, "ingredients": [{"position": 1, "raw": "¼ cup extra-virgin olive oil, divided, plus more as needed", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": "divided, plus more as needed", "optional": false}, {"position": 2, "raw": "2 medium zucchini, sliced into ¼-inch-thick rounds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium zucchini", "preparation": "sliced into ¼-inch-thick rounds", "optional": false}, {"position": 3, "raw": "Salt and black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and black pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons red wine vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 large garlic clove, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large garlic clove", "preparation": "finely chopped", "optional": false}, {"position": 6, "raw": "1 (8- to 9- ounce) block halloumi, sliced ¼-inch thick", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(8- to 9- ounce) block halloumi", "preparation": "sliced ¼-inch thick", "optional": false}, {"position": 7, "raw": "A handful of torn mint, basil, parsley and/or dill leaves", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "a handful of torn mint", "preparation": "basil, parsley and/or dill leaves", "optional": false}], "steps": [{"position": 1, "text": "In a large skillet over medium-high, heat 1 tablespoon oil. Add a single layer of zucchini. Cook until the zucchini is golden-brown and gives slightly when pressed, 2 to 4 minutes per side. Transfer to a platter or shallow bowl, season with salt and pepper, and repeat with the remaining zucchini, adding more oil and reducing heat as needed to prevent burning."}, {"position": 2, "text": "To the platter of zucchini, add the garlic, vinegar and 2 tablespoons oil. Toss to coat."}, {"position": 3, "text": "Return the skillet to medium-high and add another tablespoon of oil. Rip the halloumi slices into two or three pieces each and add to the skillet. Cook until golden brown, 2 to 4 minutes per side. Transfer to the zucchini, stir to combine, then top with the herbs. Eat right away."}], "nutrition": {"calories": 300.4, "protein_g": 9.9, "carbohydrates_g": 6.2, "fat_g": 26.8, "saturated_fat_g": 10.0, "trans_fat_g": 0.0, "cholesterol_mg": 53.6, "sodium_mg": 696.0, "fiber_g": 1.1, "sugar_g": 2.5, "unsaturated_fat_g": 14.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "vegetarian"], "course": ["side dish", "appetizer"], "meal": ["dinner"], "occasion": [], "other": ["zucchini", "red wine vinegar", "halloumi", "mint", "basil", "parsley", "vegetables", "sear", "easy", "quick", "weeknight", "five ingredient", "summer", "dill", "one pot", "stovetop"]}, "images": [{"url": "https://static01.nyt.com/images/2026/05/22/multimedia/AS-Seared-Zucchini-and-Halloumi-in-Red-Wine-Vinaigrette-cjzl/AS-Seared-Zucchini-and-Halloumi-in-Red-Wine-Vinaigrette-cjzl-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 944}, "video_url": null, "comment_count": null, "published_at": "2026-05-21", "scraped_at": "2026-09-06T22:26:38.423285+00:00", "scraper_version": "1.0.0"}
{"slug": "sesame-braised-chicken-with-scallions-daikon-and-mushrooms", "nyt_id": 12260, "url": "https://cooking.nytimes.com/recipes/12260-sesame-braised-chicken-with-scallions-daikon-and-mushrooms", "name": "Sesame Braised Chicken With Scallions, Daikon and Mushrooms", "author": "Melissa Clark", "description": "On a search for a nontraditional take on chicken in a pot in 2012, Melissa Clark was hoping for something that avoided the flavors and “seasonings inherent in Continental cuisine” — white wine, leeks, bacon. She found an answer in this recipe, which relies on dry sherry, soy sauce and star-anise-infused sesame oil as its braising liquid. Daikon and shiitake mushrooms soak up the liquid and soften under its weight. Be sure to brown the bird, too. It won't crisp the skin, but it does add depth of flavor.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 1/2 hours"}}, "ingredients": [{"position": 1, "raw": "3 bunches scallions (about ¾ pound)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "bunch", "item": "scallions (about ¾ pound)", "preparation": null, "optional": false}, {"position": 2, "raw": "3 tablespoons peanut oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "peanut oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon sesame oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sesame oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pound daikon radish, peeled and cut into 1 ½-inch chunks", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "daikon radish", "preparation": "peeled and cut into 1 ½-inch chunks", "optional": false}, {"position": 5, "raw": "½ cup sliced shiitake mushroom caps", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sliced shiitake mushroom caps", "preparation": null, "optional": false}, {"position": 6, "raw": "6 cloves garlic, smashed and peeled", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "smashed and peeled", "optional": false}, {"position": 7, "raw": "2 inches ginger, peeled and thinly sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "inches ginger", "preparation": "peeled and thinly sliced", "optional": false}, {"position": 8, "raw": "1 (3 ½-pound) whole chicken", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(3 ½-pound) whole chicken", "preparation": null, "optional": false}, {"position": 9, "raw": "2 teaspoons coarse kosher salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "coarse kosher salt", "preparation": null, "optional": false}, {"position": 10, "raw": "2 teaspoons black pepper", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup chicken stock", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": null, "optional": false}, {"position": 12, "raw": "½ cup dry sherry", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry sherry", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 14, "raw": "4 whole star anise pods", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "whole star anise pods", "preparation": null, "optional": false}, {"position": 15, "raw": "1 ½ teaspoons rice wine vinegar, more to taste", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "rice wine vinegar", "preparation": "more to taste", "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 450 degrees. Trim the roots off the scallions. Separate the dark green tops from the bottoms."}, {"position": 2, "text": "In a 5- or 6-quart Dutch oven, heat 2 tablespoons peanut oil and 1.5 teaspoons sesame oil over medium-high heat. Add the scallion bottoms, daikon, mushrooms and garlic cloves. Cook, stirring occasionally, until golden, about 7 minutes. Add the ginger and cook 1 minute more. Use a slotted spoon to transfer vegetables to a platter."}, {"position": 3, "text": "Pat chicken dry; season inside and out with salt and pepper. Add the remaining 1 tablespoon peanut oil and 1.5 teaspoons sesame oil to the Dutch oven. Brown chicken, turning, until the skin is well browned. Turn chicken breast-side up. Scatter the vegetables around the chicken. In a small bowl, whisk together the stock, sherry and soy sauce. Pour over the chicken. Drop in the star anise pods. Tightly cover the pot and transfer to the oven. Cook until the chicken is no longer pink, 50 to 60 minutes."}, {"position": 4, "text": "Remove to a cutting board. Skim fat from the surface of the cooking liquid. Chop the scallion tops and stir in, with the vinegar. Carve chicken and serve, topped with vegetables and pot juices."}], "nutrition": {"calories": 1090.0, "protein_g": 79.0, "carbohydrates_g": 20.0, "fat_g": 75.0, "saturated_fat_g": 19.6, "trans_fat_g": 0.4, "cholesterol_mg": 299.5, "sodium_mg": 1566.6, "fiber_g": 5.2, "sugar_g": 6.3, "unsaturated_fat_g": 49.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": ["dairy-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["braise", "daikon", "poultry", "scallion", "whole chicken"]}, "images": [{"url": "https://static01.nyt.com/images/2012/01/11/dining/11APPE/11APPE-facebookJumbo-v2.jpg", "alt": "Sesame Braised Chicken in a Pot With Shiitake, Daikon and Ginger", "primary": true}], "rating": {"average": 4.0, "count": 229}, "video_url": null, "comment_count": null, "published_at": "2012-01-06", "scraped_at": "2026-09-06T23:54:30.388073+00:00", "scraper_version": "1.0.0"}
{"slug": "sesame-green-bean-salad", "nyt_id": 11092, "url": "https://cooking.nytimes.com/recipes/11092-sesame-green-bean-salad", "name": "Sesame Green-Bean Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds green beans, trimmed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "green beans", "preparation": "trimmed", "optional": false}, {"position": 2, "raw": "2 tablespoons toasted sesame seeds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "toasted sesame seeds", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons fresh lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ teaspoons vegetable oil", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon salt, plus more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 6, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring a large pot of salted water to a boil. Add the green beans and cook until tender, about 5 minutes. Drain and rinse under cold running water. Place in a bowl and toss with the sesame seeds, lemon juice, oil, salt and pepper. Divide among 4 plates and serve."}], "nutrition": {"calories": 115.1, "protein_g": 5.0, "carbohydrates_g": 17.9, "fat_g
{"slug": "quail-and-lentil-casserole", "nyt_id": 4924, "url": "https://cooking.nytimes.com/recipes/4924-quail-and-lentil-casserole", "name": "Quail and Lentil Casserole", "author": "Marian Burros", "description": "Marian Burros", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 heaping cup dried lentils, rinsed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "heaping cup dried lentils", "preparation": "rinsed", "optional": false}, {"position": 2, "raw": "6 quail, halved", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "quail", "preparation": "halved", "optional": false}, {"position": 3, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "3 or 4 tablespoons flour", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "or 4 tablespoons flour", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon unsalted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "4 slices bacon, cut into small pieces", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "slice", "item": "bacon", "preparation": "cut into small pieces", "optional": false}, {"position": 9, "raw": "1 medium onion, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "finely chopped", "optional": false}, {"position": 10, "raw": "2 large cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": "minced", "optional": false}, {"position": 11, "raw": "1 tablespoon fresh thyme leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh thyme leaves", "preparation": null, "optional": false}, {"position": 12, "raw": "1 pound ripe plum tomatoes, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "ripe plum tomatoes", "preparation": "chopped", "optional": false}, {"position": 13, "raw": "1 gallon chicken stock", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "gallon", "item": "chicken stock", "preparation": null, "optional": false}, {"position": 14, "raw": "½ cup dry red wine Additional thyme for garnish, optional", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry red wine additional thyme for garnish", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "Pour boiling water over the lentils in a bowl, and set aside for 30 minutes. Drain well."}, {"position": 2, "text": "Season the quail with salt and pepper and dredge lightly with flour."}, {"position": 3, "text": "Heat the butter and oil in a large saute pan, and brown the quail all over. Set the birds aside."}, {"position": 4, "text": "Add the bacon, and cook until it is crisp. Drain, and pat dry."}, {"position": 5, "text": "Add the onion, garlic and thyme, and cook gently until the onion has softened."}, {"position": 6, "text": "Add the tomatoes, drained lentils, stock and wine, and season with salt and pepper. Cover, and simmer for 5 minutes. Uncover, and simmer for an additional 20 minutes, until the lentils are tender."}, {"position": 7, "text": "Add the quail, and simmer, in covered pan, for 10 to 15 minutes longer or until the quail are cooked and the lentil mixture has thickened."}, {"position": 8, "text": "Serve directly from the pan, and sprinkle with additional herbs for garnish, if desired."}], "nutrition": {"calories": 740.2, "protein_g": 49.8, "carbohydrates_g": 54.4, "fat_g": 35.6, "saturated_fat_g": 10.3, "trans_fat_g": 0.1, "cholesterol_mg": 119.9, "sodium_mg": 2124.8, "fiber_g": 6.0, "sugar_g": 13.8, "unsaturated_fat_g": 22.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["african"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["boil", "casseroles", "lentil", "one pot", "saute", "tomato"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1996-01-31", "scraped_at": "2026-09-07T00:38:30.914690+00:00", "scraper_version": "1.0.0"}
{"slug": "quick-fried-green-beans-in-onion-and-garlic-sauce", "nyt_id": 10828, "url": "https://cooking.nytimes.com/recipes/10828-quick-fried-green-beans-in-onion-and-garlic-sauce", "name": "Quick-Fried Green Beans In Onion And Garlic Sauce", "author": "Marialisa Calta", "description": "Marialisa Calta", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon pale, dry Sherry or dry white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "pale", "preparation": "dry Sherry or dry white wine", "optional": false}, {"position": 4, "raw": "1 small cube chicken bouillon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small cube chicken bouillon", "preparation": null, "optional": false}, {"position": 5, "raw": "⅔ cup chicken broth", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 6, "raw": "1 pound green beans", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "green beans", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon oil, like peanut or canola", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "oil", "preparation": "like peanut or canola", "optional": false}, {"position": 8, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 9, "raw": "4 to 6 cloves garlic, minced", "group": null, "quantity": 4.0, "quantity_max": 6.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 10, "raw": "2 scallions, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "chopped", "optional": false}], "steps": [{"position": 1, "text": "Mix soy sauce, sugar and Sherry and set aside."}, {"position": 2, "text": "In a large saucepan, dissolve bouillon in the chicken broth over high heat. Add the beans, and simmer until nearly all liquid has evaporated, about 5 to 8 minutes, stirring constantly. Drain the beans and set aside."}, {"position": 3, "text": "In a wok or skillet, heat the oil and butter. Add garlic and scallions and stir-fry for about 30 seconds, or until just softened. Add the beans and toss until coated. Sprinkle soy-sugar-Sherry mix over beans and stir-fry for 1 minute. Serve hot."}], "nutrition": {"calories": 132.2, "protein_g": 4.6, "carbohydrates_g": 13.0, "fat_g": 7.7, "saturated_fat_g": 3.9, "trans_fat_g": 0.0, "cholesterol_mg": 16.6, "sodium_mg": 502.7, "fiber_g": 3.5, "sugar_g": 5.7, "unsaturated_fat_g": 3.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["chinese"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "easy", "green bean", "quick", "stir-fry", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 28}, "video_url": null, "comment_count": null, "published_at": "1991-07-21", "scraped_at": "2026-09-06T22:32:30.090764+00:00", "scraper_version": "1.0.0"}
{"slug": "quinoa-and-asparagus-salad", "nyt_id": 12506, "url": "https://cooking.nytimes.com/recipes/12506-quinoa-and-asparagus-salad", "name": "Quinoa and Asparagus Salad", "author": "Martha Rose Shulman", "description": "I had been cooking quinoa sort of like pasta, in 3 parts water, then draining it and letting it dry in a towel-covered pan. This is a good way to obtain very fluffy grains, but sometimes my quinoa is soggy when I cook it this way, even after it rests under the towel. So, I decided to change the grain-to-water ratio and followed the directions on my Alter Eco quinoa packages (Alter Eco imports red, rainbow and pearl quinoas). I cooked the pearl and the red quinoas in 1 ½ parts water and the rainbow in 2 parts water. The black quinoa in the rainbow mix takes a little longer to soften and requires a little more liquid. The grains were tighter and less moist than quinoa cooked in abundant water, and the yield was not as great because the grains don’t swell as much. But I liked the results, especially for salads like this one. For this salad, I cook 1 cup of quinoa in 1 ½ cups water to get a slightly tighter, drier grain. The dressing is a lemony buttermilk dressing.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup quinoa", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "quinoa", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ cups water", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pound asparagus, ends trimmed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "asparagus", "preparation": "ends trimmed", "optional": false}, {"position": 5, "raw": "6 radishes, sliced", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "radishes", "preparation": "sliced", "optional": false}, {"position": 6, "raw": "2 tablespoons toasted pine nuts", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "toasted pine nuts", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons finely chopped chives", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped chives", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons finely chopped tarragon", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "finely chopped tarragon", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ounce feta cheese, crumbled (about ¼ cup)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "oz", "item": "feta cheese", "preparation": "crumbled (about ¼ cup)", "optional": false}, {"position": 10, "raw": "2 tablespoons freshly squeezed lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "freshly squeezed lemon juice", "preparation": null, "optional": false}, {"position": 11, "raw": "1 small garlic clove, puréed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small garlic clove", "preparation": "puréed", "optional": false}, {"position": 12, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon extra virgin olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 14, "raw": "5 tablespoons buttermilk", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "buttermilk", "preparation": null, "optional": false}, {"position": 15, "raw": "Freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper", "preparation": null, "optional": false}, {"position": 16, "raw": "Lemon-scented olive oil for drizzling (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "lemon-scented olive oil for drizzling", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "Place the quinoa in a strainer and rinse several times with cold water. Place in a medium saucepan with 1 ½ cups water and salt to taste. Bring to a boil, cover and simmer 15 minutes, until the grains display a threadlike spiral and the water is absorbed. Remove from the heat, remove the lid and place a dish towel over the pan, then return the lid to the pan and let sit for 10 minutes or longer undisturbed. Transfer to a salad bowl and fluff with forks."}, {"position": 2, "text": "Steam the asparagus for 3 to 4 minutes, until just tender. Rinse with cold water, pat dry and cut on the diagonal into 1-inch pieces. Add to the quinoa, along with the radishes, pine nuts, chives and tarragon."}, {"position": 3, "text": "Whisk together the lemon juice, garlic, salt, olive oil, buttermilk and pepper. Shortly before serving, toss with the quinoa and asparagus mixture. Sprinkle the feta over the top and serve. If desired, drizzle a teaspoon of the lemon-scented olive oil over each serving."}], "nutrition": {"calories": 208.8, "protein_g": 7.6, "carbohydrates_g": 23.5, "fat_g": 10.2, "saturated_fat_g": 2.0, "trans_fat_g": 0.0, "cholesterol_mg": 6.1, "sodium_mg": 469.0, "fiber_g": 4.0, "sugar_g": 2.4, "unsaturated_fat_g": 7.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "healthy", "high fiber", "low-sodium", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["asparagus", "boil", "buttermilk", "grain bowl", "low cholesterol", "quinoa", "spring", "steam"]}, "images": [{"url": "https://static01.nyt.com/images/2012/06/11/health/11recipehealth/11recipehealth-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 410}, "video_url": null, "comment_count": null, "published_at": "2012-06-11", "scraped_at": "2026-09-06T23:57:06.321645+00:00", "scraper_version": "1.0.0"}
{"slug": "quinoa-and-kale-salad", "nyt_id": 786138914, "url": "https://cooking.nytimes.com/recipes/786138914-quinoa-and-kale-salad", "name": "Quinoa and Kale Salad", "author": "Ali Slagle", "description": "A version of this quinoa salad with lightly cooked kale and crunchy red onion has been served at Esalen, a holistic educational institute and retreat on the cliffs of Big Sur, California, for around two decades. It's a community favorite in part thanks to its tangy-savory dressing that’s equal parts lemon juice, liquid aminos and oil.The dish is endlessly adaptable; at Esalen, sometimes it’s made with raw  kale chard or spinach and bolstered with hemp or other seeds, soft-boiled egg and other vegetables.", "servings": {"text": "4-6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 30, "total_minutes": 35, "raw": {"total": "35 min", "prep": "PT0H5M", "cook": "PT0H30M"}}, "ingredients": [{"position": 1, "raw": "2 cups quinoa, preferably tri-color", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "quinoa", "preparation": "preferably tri-color", "optional": false}, {"position": 2, "raw": "3 cups water", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 bunch kale", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "kale", "preparation": null, "optional": false}, {"position": 4, "raw": "½ medium red onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "medium red onion", "preparation": null, "optional": false}, {"position": 5, "raw": "⅓ cup fresh lemon juice (from 2 lemons)", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "fresh lemon juice (from 2 lemons)", "preparation": null, "optional": false}, {"position": 6, "raw": "⅓ cup liquid aminos", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "liquid aminos", "preparation": null, "optional": false}, {"position": 7, "raw": "⅓ cup extra-virgin olive oil", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a medium pot, bring the quinoa and 3 cups water to a boil. Cover and reduce heat to low. Cook until the quinoa is tender and translucent and a thin white tail appears on the seeds, 15 to 17 minutes."}, {"position": 2, "text": "Meanwhile, remove the stems from the kale and thinly slice the leaves. Thinly slice the red onion and rinse under cold water. In a large bowl, stir together the lemon juice, liquid aminos and olive oil."}, {"position": 3, "text": "Add the kale to the pot so it rests on top of the quinoa, turn off the heat, cover and let rest for 5 minutes. Fluff with a fork. While still warm, add quinoa and kale to the bowl of dressing and stir with the fork to combine. Stir in the red onion. Eat warm, at room temperature or cold from the refrigerator. (It will keep for up to 2 days in an airtight container.)"}], "nutrition": {"calories": 333.0, "protein_g": 9.1, "carbohydrates_g": 39.7, "fat_g": 16.0, "saturated_fat_g": 2.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 26.1, "fiber_g": 5.5, "sugar_g": 1.1, "unsaturated_fat_g": 13.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["american"], "diet": ["dairy-free", "gluten-free", "egg-free", "peanut-free", "tree nut-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "alcohol-free", "vegan", "vegetarian", "pescatarian", "mediterranean diet", "high fiber", "low-sodium"], "course": ["main course", "side dish"], "meal": ["lunch", "dinner"], "occasion": [], "other": ["quinoa", "kale", "red onion", "lemon juice", "salad", "boil", "stovetop", "easy", "make-ahead", "weeknight", "quick", "great leftovers", "grains and rice"]}, "images": [{"url": "https://static01.nyt.com/images/2026/08/11/multimedia/AS-Kale-and-Quinoa-Salad-qzfk/AS-Kale-and-Quinoa-Salad-qzfk-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 37}, "video_url": null, "comment_count": null, "published_at": "2026-08-14", "scraped_at": "2026-09-06T22:27:42.199898+00:00", "scraper_version": "1.0.0"}
{"slug": "quinoa-pea-and-black-bean-salad-with-cumin-vinaigrette", "nyt_id": 12509, "url": "https://cooking.nytimes.com/recipes/12509-quinoa-pea-and-black-bean-salad-with-cumin-vinaigrette", "name": "Quinoa, Pea and Black Bean Salad With Cumin Vinaigrette", "author": "Martha Rose Shulman", "description": "This salad was inspired by the fresh English peas that are in markets for only a month or so at this time of year, but in a pinch you could use frozen peas.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "35 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup quinoa", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "quinoa", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ cups water", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "1 15-ounce can black beans, drained and rinsed, or 1 ½ cups cooked black beans", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "15-ounce can black beans", "preparation": "drained and rinsed, or 1 ½ cups cooked black beans", "optional": false}, {"position": 5, "raw": "¾ cup fresh English peas (1 pound in the pod), raw or steamed 5 minutes (to taste)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "fresh english peas (1 pound in the pod)", "preparation": "raw or steamed 5 minutes (to taste)", "optional": false}, {"position": 6, "raw": "1 red bell pepper, diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red bell pepper", "preparation": "diced", "optional": false}, {"position": 7, "raw": "1 serrano chili, seeded if desired and finely chopped (optional)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "serrano chili", "preparation": "seeded if desired and finely chopped", "optional": true}, {"position": 8, "raw": "½ cup chopped cilantro, plus several sprigs for garnish", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped cilantro", "preparation": "plus several sprigs for garnish", "optional": false}, {"position": 9, "raw": "2 tablespoons fresh lime juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lime juice", "preparation": null, "optional": false}, {"position": 10, "raw": "1 tablespoon red wine vinegar or sherry vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar or sherry vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "1 small garlic clove, puréed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small garlic clove", "preparation": "puréed", "optional": false}, {"position": 12, "raw": "½ teaspoon cumin seeds, lightly toasted and ground", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "cumin seeds", "preparation": "lightly toasted and ground", "optional": false}, {"position": 13, "raw": "3 tablespoons extra virgin olive oil, or a combination of olive oil and grapeseed oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": "or a combination of olive oil and grapeseed oil", "optional": false}, {"position": 14, "raw": "¼ cup buttermilk", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "buttermilk", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the quinoa in a strainer and rinse several times with cold water. Place in a medium saucepan with 1 ½ cups water and salt to taste. Brin
{"slug": "quick-fried-green-beans-in-onion-and-garlic-sauce", "nyt_id": 10828, "url": "https://cooking.nytimes.com/recipes/10828-quick-fried-green-beans-in-onion-and-garlic-sauce", "name": "Quick-Fried Green Beans In Onion And Garlic Sauce", "author": "Marialisa Calta", "description": "Marialisa Calta", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon pale, dry Sherry or dry white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "pale", "preparation": "dry Sherry or dry white wine", "optional": false}, {"position": 4, "raw": "1 small cube chicken bouillon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small cube chicken bouillon", "preparation": null, "optional": false}, {"position": 5, "raw": "⅔ cup chicken broth", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 6, "raw": "1 pound green beans", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "green beans", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon oil, like peanut or canola", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "oil", "preparation": "like peanut or canola", "optional": false}, {"position": 8, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 9, "raw": "4 to 6 cloves garlic, minced", "group": null, "quantity": 4.0, "quantity_max": 6.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 10, "raw": "2 scallions, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "chopped", "optional": false}], "steps": [{"position": 1, "text": "Mix soy sauce, sugar and Sherry and set aside."}, {"position": 2, "text": "In a large saucepan, dissolve bouillon in the chicken broth over high heat. Add the beans, and simmer until nearly all liquid has evaporated, about 5 to 8 minutes, stirring constantly. Drain the beans and set aside."}, {"position": 3, "text": "In a wok or skillet, heat the oil and butter. Add garlic and scallions and stir-fry for about 30 seconds, or until just softened. Add the beans and toss until coated. Sprinkle soy-sugar-Sherry mix over beans and stir-fry for 1 minute. Serve hot."}], "nutrition": {"calories": 132.2, "protein_g": 4.6, "carbohydrates_g": 13.0, "fat_g": 7.7, "saturated_fat_g": 3.9, "trans_fat_g": 0.0, "cholesterol_mg": 16.6, "sodium_mg": 502.7, "fiber_g": 3.5, "sugar_g": 5.7, "unsaturated_fat_g": 3.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["chinese"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "easy", "green bean", "quick", "stir-fry", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 28}, "video_url": null, "comment_count": null, "published_at": "1991-07-21", "scraped_at": "2026-09-06T22:32:30.090764+00:00", "scraper_version": "1.0.0"}
{"slug": "quinoa-and-kale-salad", "nyt_id": 786138914, "url": "https://cooking.nytimes.com/recipes/786138914-quinoa-and-kale-salad", "name": "Quinoa and Kale Salad", "author": "Ali Slagle", "description": "A version of this quinoa salad with lightly cooked kale and crunchy red onion has been served at Esalen, a holistic educational institute and retreat on the cliffs of Big Sur, California, for around two decades. It's a community favorite in part thanks to its tangy-savory dressing that’s equal parts lemon juice, liquid aminos and oil.The dish is endlessly adaptable; at Esalen, sometimes it’s made with raw  kale chard or spinach and bolstered with hemp or other seeds, soft-boiled egg and other vegetables.", "servings": {"text": "4-6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 30, "total_minutes": 35, "raw": {"total": "35 min", "prep": "PT0H5M", "cook": "PT0H30M"}}, "ingredients": [{"position": 1, "raw": "2 cups quinoa, preferably tri-color", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "quinoa", "preparation": "preferably tri-color", "optional": false}, {"position": 2, "raw": "3 cups water", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 bunch kale", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "kale", "preparation": null, "optional": false}, {"position": 4, "raw": "½ medium red onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "medium red onion", "preparation": null, "optional": false}, {"position": 5, "raw": "⅓ cup fresh lemon juice (from 2 lemons)", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "fresh lemon juice (from 2 lemons)", "preparation": null, "optional": false}, {"position": 6, "raw": "⅓ cup liquid aminos", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "liquid aminos", "preparation": null, "optional": false}, {"position": 7, "raw": "⅓ cup extra-virgin olive oil", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a medium pot, bring the quinoa and 3 cups water to a boil. Cover and reduce heat to low. Cook until the quinoa is tender and translucent and a thin white tail appears on the seeds, 15 to 17 minutes."}, {"position": 2, "text": "Meanwhile, remove the stems from the kale and thinly slice the leaves. Thinly slice the red onion and rinse under cold water. In a large bowl, stir together the lemon juice, liquid aminos and olive oil."}, {"position": 3, "text": "Add the kale to the pot so it rests on top of the quinoa, turn off the heat, cover and let rest for 5 minutes. Fluff with a fork. While still warm, add quinoa and kale to the bowl of dressing and stir with the fork to combine. Stir in the red onion. Eat warm, at room temperature or cold from the refrigerator. (It will keep for up to 2 days in an airtight container.)"}], "nutrition": {"calories": 333.0, "protein_g": 9.1, "carbohydrates_g": 39.7, "fat_g": 16.0, "saturated_fat_g": 2.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 26.1, "fiber_g": 5.5, "sugar_g": 1.1, "unsaturated_fat_g": 13.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["american"], "diet": ["dairy-free", "gluten-free", "egg-free", "peanut-free", "tree nut-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "alcohol-free", "vegan", "vegetarian", "pescatarian", "mediterranean diet", "high fiber", "low-sodium"], "course": ["main course", "side dish"], "meal": ["lunch", "dinner"], "occasion": [], "other": ["quinoa", "kale", "red onion", "lemon juice", "salad", "boil", "stovetop", "easy", "make-ahead", "weeknight", "quick", "great leftov
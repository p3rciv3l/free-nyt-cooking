ll, "optional": false}, {"position": 9, "raw": "1 sprig fresh thyme", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "fresh thyme", "preparation": null, "optional": false}, {"position": 10, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 11, "raw": "1 ½ pounds monkfish", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "monkfish", "preparation": null, "optional": false}, {"position": 12, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 13, "raw": "3 tablespoons butter", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 14, "raw": "1 teaspoon fresh lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 15, "raw": "½ teaspoon Dijon mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 16, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 17, "raw": "1 teaspoon chopped parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the lentils in a bowl, cover with water to a depth of one inch above the lentils and allow to soak for one hour. Drain, rinse twice and set aside."}, {"position": 2, "text": "Preheat the oven to 300 degrees."}, {"position": 3, "text": "Heat the bacon in a heavy saucepan. Add the onion, carrot and celery and saute until tender. Stir in the garlic. Add the lentils and chicken stock. Tie the clove, thyme and bay leaf together with a piece of string and add the bunch. Bring to a simmer. Cover and place in the oven for about 20 minutes, until the lentils are just tender. All the liquid will not have been absorbed. Remove the bundle of herbs and set the lentils aside. The recipe can be prepared in advance up until this point."}, {"position": 4, "text": "Cut the monkfish into medallions about one-inch-thick. You should have 12 to 15 medallions. Season with salt and pepper."}, {"position": 5, "text": "Shortly before serving, reheat the lentils and beat in the butter a bit at a time. Season with lemon juice, mustard and salt and pepper to taste."}, {"position": 6, "text": "Heat the olive oil in a heavy skillet. Cook the medallions over medium-low heat for about three minutes on each side, until they are just cooked through."}, {"position": 7, "text": "Spoon some of the lentils in the center of each of four or five warmed plates. Arrange the medallions of fish on them and spoon more of the sauce from the lentils around them. Garnish with parsley and serve."}], "nutrition": {"calories": 345.8, "protein_g": 28.5, "carbohydrates_g": 19.7, "fat_g": 16.9, "saturated_fat_g": 6.2, "trans_fat_g": 0.0, "cholesterol_mg": 57.1, "sodium_mg": 664.3, "fiber_g": 3.0, "sugar_g": 2.4, "unsaturated_fat_g": 9.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": ["dinner"], "occasion": [], "other": ["bake", "boil", "lentil", "monkfish", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 37}, "video_url": null, "comment_count": null, "published_at": "1988-12-11", "scraped_at": "2026-09-06T23:47:37.275908+00:00", "scraper_version": "1.0.0"}
{"slug": "medallions-of-pork-with-lentils", "nyt_id": 11855, "url": "https://cooking.nytimes.com/recipes/11855-medallions-of-pork-with-lentils", "name": "Medallions of Pork With Lentils", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "About 30 minutes"}}, "ingredients": [{"position": 1, "raw": "8 boneless loin of pork slices, about 3 ounces each, trimmed of fat", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "boneless loin of pork slices", "preparation": "about 3 ounces each, trimmed of fat", "optional": false}, {"position": 2, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon paprika", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "paprika", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon cumin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cumin", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon vegetable oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons chopped onion", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped onion", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon red-wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup fresh or canned chicken broth", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "fresh or canned chicken broth", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 10, "raw": "Cooked lentils (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "cooked lentils (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the pork slices in a flat dish and sprinkle with salt and pepper. Sprinkle with paprika and cumin."}, {"position": 2, "text": "Heat the oil in a nonstick skillet large enough to hold the slices in one layer. When the oil is very hot add the slices and cook over moderately high heat for about 5 minutes or until brown."}, {"position": 3, "text": "Turn the slices and cook for about 5 minutes more. Reduce the heat and continue cooking about 2 minutes, turning the slices occasionally."}, {"position": 4, "text": "Transfer the meat to a warm serving dish and keep warm."}, {"position": 5, "text": "Pour off most of the fat from the skillet. Add the onion and cook, stirring, until wilted and lightly browned. Add the vinegar and broth. Stir to dissolve the brown particles that cling to the bottom of the pan. Cook until reduced to about Y cup. Add the butter and blend well."}, {"position": 6, "text": "Serve the meat with the lentils and spoon the sauce over the slices of meat."}], "nutrition": {"calories": 348.6, "protein_g": 36.8, "carbohydrates_g": 1.6, "fat_g": 20.8, "saturated_fat_g": 6.8, "trans_fat_g": 0.2, "cholesterol_mg": 117.1, "sodium_mg": 521.5, "fiber_g": 0.5, "sugar_g": 0.4, "unsaturated_fat_g": 18.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["fry", "lentil", "one pot", "pork", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 16}, "
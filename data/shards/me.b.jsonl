{"slug": "mediterranean-fish-chowder-with-potatoes-and-kale", "nyt_id": 12278, "url": "https://cooking.nytimes.com/recipes/12278-mediterranean-fish-chowder-with-potatoes-and-kale", "name": "Mediterranean Fish Chowder With Potatoes and Kale", "author": "Martha Rose Shulman", "description": "This brothy fish stew gets extra body and heft from the kale and potatoes, and a hint of the Mediterranean from thyme, parsley and bay leaf. The method is straightforward. First make a mirepoix of onion, celery and carrot. Add garlic, anchovies and parsley, followed by the tomatoes and paste, and finally the potatoes and bouquet garni. Simmer for 30 minutes while the kale is cooked separately, then add the fish. Take care not to overcook the fish — it’s done as soon as it flakes easily when you nudge it with a fork.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 large onion, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large onion", "preparation": "chopped", "optional": false}, {"position": 3, "raw": "1 celery rib, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "celery rib", "preparation": "chopped", "optional": false}, {"position": 4, "raw": "1 medium carrot, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium carrot", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "2 to 4 garlic cloves, minced", "group": null, "quantity": 2.0, "quantity_max": 4.0, "unit": null, "item": "garlic cloves", "preparation": "minced", "optional": false}, {"position": 7, "raw": "4 anchovy fillets, soaked in water for 4 minutes, drained and chopped", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "anchovy fillets", "preparation": "soaked in water for 4 minutes, drained and chopped", "optional": false}, {"position": 8, "raw": "2 tablespoons chopped fresh parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "1 (28-ounce) can chopped tomatoes, with liquid", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(28-ounce) can chopped tomatoes", "preparation": "with liquid", "optional": false}, {"position": 10, "raw": "1 tablespoon tomato paste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 11, "raw": "1 quart water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "quart", "item": "water", "preparation": null, "optional": false}, {"position": 12, "raw": "1 pound fingerling or Yukon gold potatoes, scrubbed and sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fingerling or yukon gold potatoes", "preparation": "scrubbed and sliced", "optional": false}, {"position": 13, "raw": "A bouquet garni made with a bay leaf, a strip of orange zest, a couple of sprigs each thyme and parsley, and a dried red chili if desired, tied together with a string", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "a bouquet garni made with a bay leaf", "preparation": "a strip of orange zest, a couple of sprigs each thyme and parsley, and a dried red chili if desired, tied together with a string", "optional": false}, {"position": 14, "raw": "Generous pinch of saffron (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "generous pinch of saffron", "preparation": null, "optional": true}, {"position": 15, "raw": "Freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper", "preparation": null, "optional": false}, {"position": 16, "raw": "1 bunch (10 to 12 ounces) black kale, stemmed and washed thoroughly in 2 changes of water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "(10 to 12 ounces) black kale", "preparation": "stemmed and washed thoroughly in 2 changes of water", "optional": false}, {"position": 17, "raw": "1 ½ pounds firm, white-fleshed fish, like halibut, tilapia, Pacific cod or black cod, cut in 2- or 3-inch pieces", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "firm", "preparation": "white-fleshed fish, like halibut, tilapia, Pacific cod or black cod, cut in 2- or 3-inch pieces", "optional": false}], "steps": [{"position": 1, "text": "Heat the olive oil over medium heat in a large, heavy soup pot or Dutch oven and add the onion, celery and carrot. Cook, stirring, until the onion softens, about 5 minutes."}, {"position": 2, "text": "Add a generous pinch of salt and stir in the garlic, anchovies and chopped parsley. Cook, stirring, until the mixture is very fragrant, another minute or two, and add the tomatoes and tomato paste. Cook, stirring often, until the tomatoes have cooked down a bit and the mixture smells aromatic, about 10 to 15 minutes."}, {"position": 3, "text": "Add the water, potatoes, salt to taste and the bouquet garni, and bring to a simmer. Add the saffron, turn the heat to low, cover and simmer 30 minutes. Taste, adjust salt and add pepper to taste. Remove the bouquet garni."}, {"position": 4, "text": "While the soup is simmering, bring a medium pot of water to a boil, salt generously and add the kale. Cook 2 to 3 minutes, until tender but still colorful. Transfer to a bowl of cold water, then drain and squeeze out excess water. Chop coarsely and set aside."}, {"position": 5, "text": "Shortly before serving, season the fish with salt and pepper and stir into the soup, along with the kale. The soup should not be boiling vigorously. Simmer 5 minutes (depending on the thickness of the fillets), or just until the fish flakes easily when poked. Remove from the heat, taste once more and adjust seasonings, and serve."}], "nutrition": {"calories": 245.5, "protein_g": 24.5, "carbohydrates_g": 24.3, "fat_g": 6.2, "saturated_fat_g": 1.0, "trans_fat_g": 0.0, "cholesterol_mg": 51.0, "sodium_mg": 1368.3, "fiber_g": 6.0, "sugar_g": 6.0, "unsaturated_fat_g": 4.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["mediterranean"], "diet": ["dairy-free", "healthy", "high fiber"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["boil", "fish", "kale", "potato", "saute", "soup", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2014/03/07/dining/07chowder/07chowder-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 1092}, "video_url": null, "comment_count": null, "published_at": "2012-01-31", "scraped_at": "2026-09-06T23:54:52.232293+00:00", "scraper_version": "1.0.0"}

{"slug": "octopus-and-potato-salad", "nyt_id": 8505, "url": "https://cooking.nytimes.com/recipes/8505-octopus-and-potato-salad", "name": "Octopus and Potato Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 165, "raw": {"total": "2 hours 45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 2-pound octopus, cleaned", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "2-pound octopus", "preparation": "cleaned", "optional": false}, {"position": 2, "raw": "1 wine cork", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "wine cork", "preparation": null, "optional": false}, {"position": 3, "raw": "2 bay leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons kosher salt, plus more to taste", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": "plus more to taste", "optional": false}, {"position": 5, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "2 medium baking potatoes, whole", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium baking potatoes", "preparation": "whole", "optional": false}, {"position": 7, "raw": "1 Bermuda onion, peeled and thinly sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bermuda onion", "preparation": "peeled and thinly sliced", "optional": false}, {"position": 8, "raw": "10 calamata olives, pitted and halved", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "calamata olives", "preparation": "pitted and halved", "optional": false}, {"position": 9, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "3 tablespoons red-wine vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons chopped Italian parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped italian parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the octopus, wine cork, bay leaves, 2 teaspoons of salt and pepper in a large pot and cover generously with cold water. Bring to a boil over high heat. Lower the heat slightly and simmer vigorously until the octopus is tender but firm, about 1 to 1 ½ hours, skimming the liquid as necessary. Drain and let cool."}, {"position": 2, "text": "Meanwhile, place the potatoes in a pot and cover with cold water. Bring to a boil over high heat. Lower the heat, cover and simmer until just tender, about 35 minutes. Drain and let cool. Peel and cut into 1-inch cubes."}, {"position": 3, "text": "Cut the octopus tentacles from the head and slice into 1-inch pieces. Thinly slice the meat from the head. Toss the octopus and potatoes together in a bowl. Add the onion, olives, olive oil and vinegar and toss to combine. Season with salt and pepper to taste. Sprinkle with parsley and serve."}], "nutrition": {"calories": 508.7, "protein_g": 36.7, "carbohydrates_g": 29.9, "fat_g": 23.7, "saturated_fat_g": 3.6, "trans_fat_g": 0.0, "cholesterol_mg": 108.9, "sodium_mg": 1033.7, "fiber_g": 2.5, "sugar_g": 2.3, "unsaturated_fat_g": 18.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["mediterranean"], "diet": [], "course": [], "meal": ["lunch"], "occasion": [], "other": ["kalamat
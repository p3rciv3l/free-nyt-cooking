{"slug": "octopus-salad-with-crispy-vegetables", "nyt_id": 7373, "url": "https://cooking.nytimes.com/recipes/7373-octopus-salad-with-crispy-vegetables", "name": "Octopus Salad With Crispy Vegetables", "author": "Mark Bittman", "description": "Mark Bittman", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 1/2 to 2 hours (90 - 120 minutes) plus 3 to 4 hours' marinating and cooling"}}, "ingredients": [{"position": 1, "raw": "6 medium carrots, peeled", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "medium carrots", "preparation": "peeled", "optional": false}, {"position": 2, "raw": "4 small red onions, peeled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "small red onions", "preparation": "peeled", "optional": false}, {"position": 3, "raw": "2 medium celeriac, trimmed and peeled", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium celeriac", "preparation": "trimmed and peeled", "optional": false}, {"position": 4, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon black peppercorns", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "black peppercorns", "preparation": null, "optional": false}, {"position": 6, "raw": "1 cup white vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "2 pounds octopus", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "octopus", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup extra virgin olive oil, or more to taste", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "extra virgin olive oil", "preparation": "or more to taste", "optional": false}, {"position": 9, "raw": "Juice of 1 lemon, or more to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1 lemon", "preparation": "or more to taste", "optional": false}, {"position": 10, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "Hot red pepper flakes", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "hot red pepper flakes", "preparation": null, "optional": false}, {"position": 12, "raw": "1 cup chopped basil, plus more for garnish", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped basil", "preparation": "plus more for garnish", "optional": false}, {"position": 13, "raw": "5 red bliss potatoes", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "red bliss potatoes", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Roughly chop half the carrots, onions and celeriac, and combine in saucepan with bay leaf, peppercorns and white vinegar. Bring to boil, and add octopus, along with water to cover; cook at least 1 hour, or until octopus is tender (check with point of sharp knife). Let octopus cool in cooking water."}, {"position": 2, "text": "Discard cooked vegetables. Cut octopus into small pieces, and toss with olive oil, lemon juice, salt, pepper, pepper flakes and basil. Marinate, refrigerated, for 3 to 4 hours. Simmer potatoes in salted water until tender. Chop remaining raw vegetables."}, {"position": 3, "text": "Blanch carrots for about 5 minutes and onions for about 2 minutes, just to remove some of the crunch; shock in ice water to chill. Mix octopus with raw celeriac, cooked potatoes and blanched carrots and onions. Adjust seas
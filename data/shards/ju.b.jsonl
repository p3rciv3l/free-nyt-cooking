{"slug": "julia-reeds-deviled-eggs", "nyt_id": 11405, "url": "https://cooking.nytimes.com/recipes/11405-julia-reeds-deviled-eggs", "name": "Julia Reed’s Deviled Eggs", "author": "Julia Reed", "description": "", "servings": {"text": "24 deviled eggs", "min": 24, "max": 24, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 dozen medium eggs", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "dozen medium eggs", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup mayonnaise", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "mayonnaise", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup Dijon mustard", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "4 tablespoons butter, at room temperature", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": "at room temperature", "optional": false}, {"position": 5, "raw": "1 teaspoon fresh lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon cayenne pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cayenne pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "Salt and freshly ground white pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground white pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "Finely snipped chives for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "finely snipped chives for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the eggs in a pan large enough to hold them in a single layer and cover with cold water. Bring to a boil, cover, turn off the heat and let eggs sit 15 minutes. Drain and run under cold water until eggs are completely cool."}, {"position": 2, "text": "Peel eggs and cut in half lengthwise. Remove the yolks and rub through a fine-mesh strainer into a bowl. Add the mayonnaise, mustard and butter; mix until smooth. Stir in the lemon juice, cayenne, salt and white pepper to taste. Place in a pastry bag or Ziploc bag with a cut-off corner."}, {"position": 3, "text": "Fill the egg whites neatly by pressing bag. Sprinkle with chives."}], "nutrition": {"calories": 67.9, "protein_g": 3.0, "carbohydrates_g": 0.6, "fat_g": 6.0, "saturated_fat_g": 2.2, "trans_fat_g": 0.0, "cholesterol_mg": 87.9, "sodium_mg": 74.0, "fiber_g": 0.2, "sugar_g": 0.1, "unsaturated_fat_g": 3.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "egg", "mayonnaise"]}, "images": [], "rating": {"average": 4.0, "count": 182}, "video_url": null, "comment_count": null, "published_at": "2002-09-08", "scraped_at": "2026-09-07T02:17:48.376958+00:00", "scraper_version": "1.0.0"}
{"slug": "julie-sahnis-indian-chickpea-ragout-with-vegetables", "nyt_id": 9435, "url": "https://cooking.nytimes.com/recipes/9435-julie-sahnis-indian-chickpea-ragout-with-vegetables", "name": "Julie Sahni's Indian Chickpea Ragout With Vegetables", "author": "Elaine Louie", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "½ cup chopped fresh cilantro", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped fresh cilantro", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup peeled and finely chopped cucumber", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "peeled and finely chopped cucumber", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup finely chopped red onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "finely chopped red onion", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup plain yogurt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "plain yogurt", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons vegetable oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon cumin seeds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cumin seeds", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon fennel seeds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "fennel seeds", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon crushed red pepper flakes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "crushed red pepper flakes", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons ground coriander", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "ground coriander", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup chopped onions", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped onions", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon grated fresh ginger", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "grated fresh ginger", "preparation": null, "optional": false}, {"position": 12, "raw": "1 medium zucchini, cut into 1-inch pieces", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium zucchini", "preparation": "cut into 1-inch pieces", "optional": false}, {"position": 13, "raw": "1 red or green bell pepper, cored and cut into 1-inch pieces", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red or green bell pepper", "preparation": "cored and cut into 1-inch pieces", "optional": false}, {"position": 14, "raw": "3 cups cooked chickpeas or two 15 ½-ounce cans, drained", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "cooked chickpeas or two 15 ½-ounce cans", "preparation": "drained", "optional": false}, {"position": 15, "raw": "1 ½ cups peeled, chopped fresh tomatoes mixed with 2 tablespoons tomato paste or 1 ½ cups canned Italian-style plum tomatoes in puree", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "peeled", "preparation": "chopped fresh tomatoes mixed with 2 tablespoons tomato paste or 1 ½ cups canned Italian-style plum tomatoes in puree", "optional": false}, {"position": 16, "raw": "Kosher salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground black pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a medium mixing bowl, combine the cilantro, cucumber, red onion and yogurt. Mix well, transfer to a small serving bowl and refrigerate until needed."}, {"position": 2, "text": "In a large saute pan, heat the oil over medium-high heat, and add the cumin, fennel, pepper flakes, coriander and onions. Saute until the onions are lightly browned, about 8 minutes. Add ginger, zucchini and bell pepper, and mix well. Pour ⅓ cup water over the vegetables, cover and reduce heat to low. Simmer until vegetables are cooked but still firm, about 5 minutes."}, {"position": 3, "text": "Fold in the chickpeas and tomatoes. Increase heat to medium high, and cook uncovered until the ragout is heated through and the sauce is thick, about 5 minutes. Season with salt to taste, and a generous sprinkling of black pepper. Serve ragout garnished with the cilantro-yogurt mixture and accompanied by pita or nan bread."}], "nutrition": {"calories": 738.9, "protein_g": 34.2, "carbohydrates_g": 107.8, "fat_g": 22.1, "saturated_fat_g": 3.0, "trans_fat_g": 0.1, "cholesterol_mg": 8.0, "sodium_mg": 1435.6, "fiber_g": 29.7, "sugar_g": 25.0, "unsaturated_fat_g": 16.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["chickpea", "saute", "tomato"]}, "images": [], "rating": {"average": 5.0, "count": 25}, "video_url": null, "comment_count": null, "published_at": "1998-05-13", "scraped_at": "2026-09-07T01:29:45.214338+00:00", "scraper_version": "1.0.0"}
{"slug": "julienne-de-legumes-vegetables-in-julienne", "nyt_id": 5108, "url": "https://cooking.nytimes.com/recipes/5108-julienne-de-legumes-vegetables-in-julienne", "name": "Julienne de Legumes (Vegetables in julienne)", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 small zucchini, about ¾ pound", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small zucchini", "preparation": "about ¾ pound", "optional": false}, {"position": 2, "raw": "2 medium-size white turnips, about 6 ounces, peeled", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium-size white turnips", "preparation": "about 6 ounces, peeled", "optional": false}, {"position": 3, "raw": "2 carrots, about ½ pound, trimmed and scraped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "carrots", "preparation": "about ½ pound, trimmed and scraped", "optional": false}, {"position": 4, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons butter", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 6, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons finely chopped shallots", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped shallots", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut the ends off each zucchini. Cut the zucchini into quarterinch thick slices. Stack the slices and cut them into quarter-inch wide julienne strips."}, {"position": 2, "text": "Prepare the turnips in the same manner, cutting them into julienne strips."}, {"position": 3, "text": "Cut the carrots in half crosswise. Prepare them as you did the zucchini and turnips."}, {"position": 4, "text": "Put the carrots in a saucepan with water to cover and salt to taste. Bring to the boil and let simmer two minutes."}, {"position": 5, "text": "Add the turnips and let simmer one minute. Drain quickly."}, {"position": 6, "text": "Heat the butter in a heavy skillet and add the zucchini, carrots, turnips, salt, pepper and shallots. Cook, tossing and stirring the vegetables, about two to three minutes. Do not overcook."}], "nutrition": {"calories": 131.1, "protein_g": 2.2, "carbohydrates_g": 12.0, "fat_g": 9.1, "saturated_fat_g": 5.5, "trans_fat_g": 0.0, "cholesterol_mg": 22.9, "sodium_mg": 476.4, "fiber_g": 3.5, "sugar_g": 6.8, "unsaturated_fat_g": 3.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "carrot", "fall", "saute", "zucchini"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1981-03-04", "scraped_at": "2026-09-07T00:40:31.179902+00:00", "scraper_version": "1.0.0"}

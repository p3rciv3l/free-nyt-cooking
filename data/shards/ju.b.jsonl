 40.8, "fat_g": 21.0, "saturated_fat_g": 9.8, "trans_fat_g": 0.4, "cholesterol_mg": 165.8, "sodium_mg": 627.2, "fiber_g": 2.7, "sugar_g": 2.0, "unsaturated_fat_g": 9.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "boil", "chicken breast", "spinach"]}, "images": [], "rating": {"average": 4.0, "count": 41}, "video_url": null, "comment_count": null, "published_at": "1982-02-24", "scraped_at": "2026-09-07T01:36:54.014660+00:00", "scraper_version": "1.0.0"}

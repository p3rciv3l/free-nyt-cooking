{"slug": "sauteed-chicken-with-vinegar-glaze", "nyt_id": 10456, "url": "https://cooking.nytimes.com/recipes/10456-sauteed-chicken-with-vinegar-glaze", "name": "Sauteed Chicken With Vinegar Glaze", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "1 whole chicken, about 3 ½ pounds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "whole chicken", "preparation": "about 3 ½ pounds", "optional": false}, {"position": 2, "raw": "6 ripe plum tomatoes, about 1 pound", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "ripe plum tomatoes", "preparation": "about 1 pound", "optional": false}, {"position": 3, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons vegetable oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 5, "raw": "4 tablespoons finely chopped shallots", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped shallots", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons finely chopped garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "finely chopped garlic", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons red wine vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "2 sprigs fresh thyme or 1 teaspoon dried", "group": null, "quantity": 2.0, "quanti
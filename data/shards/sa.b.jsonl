{"slug": "salad-of-grilled-pepper-and-eggplant-with-chinese-glaze", "nyt_id": 10535, "url": "https://cooking.nytimes.com/recipes/10535-salad-of-grilled-pepper-and-eggplant-with-chinese-glaze", "name": "Salad of Grilled Pepper And Eggplant With Chinese Glaze", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 10, "cook_minutes": 15, "total_minutes": 25, "raw": {"total": "25 minutes", "prep": "10 minutes", "cook": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ cup Chinese sesame oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chinese sesame oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ tablespoons rice vinegar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "rice vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon grated fresh ginger", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "grated fresh ginger", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons soy sauce", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "A few drops hot chili oil", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "a few drops hot chili oil", "preparation": null, "optional": false}, {"position": 7, "raw": "2 sweet red peppers, cored, seeded and quartered", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "sweet red peppers", "preparation": "cored, seeded and quartered", "optional": false}, {"position": 8, "raw": "1 medium eggplant, about 1 ¼ pound, in ½-inch thick
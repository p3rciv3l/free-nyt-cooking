{"slug": "shaved-artichoke-salad", "nyt_id": 11216, "url": "https://cooking.nytimes.com/recipes/11216-shaved-artichoke-salad", "name": "Shaved Artichoke Salad", "author": "Mark Bittman", "description": "Prepping artichokes can take time and patience, but they are among the most delicious of nature’s gifts, so are well worth the effort. In this dish they are served raw to showcase their flavor, which is enhanced here with olive oil, lemon juice and Parmesan.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "8 baby artichokes, cleaned", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "baby artichokes", "preparation": "cleaned", "optional": false}, {"position": 2, "raw": "Vinegar for soaking (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "vinegar for soaking", "preparation": null, "optional": true}, {"position": 3, "raw": "Zest and juice of a lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "zest and juice of a lemon", "preparation": null, "optional": false}, {"position": 4, "raw": "Chunk of Parmesan", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "chunk of parmesan", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons extra-virgin olive oil, more as necessary", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": "more as necessary", "optional": false}, {"position": 6, "raw": "Salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "Chopped fresh parsley or basil leaves for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "chopped fresh parsley or basil leaves for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Prepare artichokes by trimming stem, cutting off pointed tips and removing tough leaves. Slice thinly with mandoline. As each artichoke is finished, drop slices into a bowl of cold water with about 10 percent vinegar or lemon juice."}, {"position": 2, "text": "Slice Parmesan with mandoline, creating as many pieces as you have artichoke slices, and about the same size."}, {"position": 3, "text": "Remove artichoke slices from water and dry, then toss with olive oil and 1 tablespoon lemon juice. Sprinkle with a little salt and a fair amount of pepper, then lay Parmesan on top. Taste and add more olive oil, lemon juice, salt or pepper as needed. Garnish with herbs and lemon zest and serve."}], "nutrition": {"calories": 297.0, "protein_g": 15.3, "carbohydrates_g": 34.6, "fat_g": 14.2, "saturated_fat_g": 3.6, "trans_fat_g": 0.0, "cholesterol_mg": 9.7, "sodium_mg": 829.9, "fiber_g": 17.1, "sugar_g": 3.5, "unsaturated_fat_g": 9.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["artichoke", "salad", "spring", "vegetables"]}, "images": [{"url": "https://static01.nyt.com/images/2014/04/15/dining/Shaved-Artichoke-Salad/Shaved-Artichoke-Salad-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 51}, "video_url": null, "comment_count": null, "published_at": "2006-04-19", "scraped_at": "2026-09-06T23:01:54.170861+00:00", "scraper_version": "1.0.0"}

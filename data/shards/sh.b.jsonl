l, "optional": false}, {"position": 9, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ teaspoon Tabasco sauce", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "tabasco sauce", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup plus 2 tablespoons olive oil, approximately", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "plus 2 tablespoons olive oil", "preparation": "approximately", "optional": false}, {"position": 12, "raw": "2 cups thinly sliced onions, loosely packed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "thinly sliced onions", "preparation": "loosely packed", "optional": false}, {"position": 13, "raw": "2 ¼ teaspoons finely minced garlic", "group": null, "quantity": 2.25, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 14, "raw": "1 ¼ pounds shiitake mushrooms", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "lb", "item": "shiitake mushrooms", "preparation": null, "optional": false}, {"position": 15, "raw": "¼ pound vermicelli or capellini", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "vermicelli or capellini", "preparation": null, "optional": false}, {"position": 16, "raw": "2 tablespoons finely chopped scallions or chives", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped scallions or chives", "preparation": null, "optional": false}, {"position": 17, "raw": "½ tablespoon sesame oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "sesame oil", "preparation": null, "optional": false}, {"position": 18, "raw": "1 teaspoon soy sauce", "group": null, "quantity": 1.0, "quantity_max"
ax": null, "unit": "lb", "item": "baby artichokes", "preparation": null, "optional": false}, {"position": 9, "raw": "½ lemon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemon", "preparation": null, "optional": false}, {"position": 10, "raw": "3 tablespoons olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons fresh chives, finely chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh chives", "preparation": "finely chopped", "optional": false}, {"position": 12, "raw": "2 pounds medium shrimp soaked for 1 hour in cold salted water", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "medium shrimp soaked for 1 hour in cold salted water", "preparation": null, "optional": false}, {"position": 13, "raw": "1 cup dry white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 14, "raw": "1 cup fish stock or clam juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fish stock or clam juice", "preparation": null, "optional": false}, {"position": 15, "raw": "Bouquet garni (parsley, thyme and bay leaf tied in a cheesecloth)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "bouquet garni (parsley", "preparation": "thyme and bay leaf tied in a cheesecloth)", "optional": false}, {"position": 16, "raw": "1 onion, sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "onion", "preparation": "sliced", "optional": false}], "steps": [{"position": 1, "text": "Soak the beans overnight in water to cover. Drain, cover with fresh cold water and simmer for 20 minutes. Season with salt and pepper and continue cooking until tender (about 20 minutes more)."}, {"position": 2, "text": "Combine the mustard, crushed garlic (mashing it into the mustard with a fork), vinegar and olive oil. Season to taste with salt and pepper and mix well. Remove the garlic cloves and pour the mixture over the beans while they are still warm. Add the tomatoes, toss and set aside."}, {"position": 3, "text": "Meanwhile, trim the outer leaves from the artichokes. Cut off the stalks and slice off the tops, two-thirds down horizontally. Squeeze the lemon half into a bowl of cold water large enough to hold the artichokes. Cut the artichokes into thin slices vertically. Add them to the water as you trim them, to stop them from turning brown."}, {"position": 4, "text": "Heat oil in a skillet. Dry the artichoke slices in a salad spinner or with a kitchen towel. Add the artichokes and saute, turning from time to time until golden. Drain on paper towels."}, {"position": 5, "text": "Cook the shrimp. Bring the wine, stock, bouquet garni, onion and salt and pepper to boil. Add the shrimp and cook for one to two minutes. Do not overcook them or they will be mushy. Cool, peel and chop them in half-inch pieces. Add to the beans and toss. Correct seasoning."}, {"position": 6, "text": "To serve, place the mixture in a shallow dish and arrange the artichokes in a circle around the edges. Sprinkle with chives."}], "nutrition": {"calories": 789.7, "protein_g": 55.4, "carbohydrates_g": 71.8, "fat_g": 31.9, "saturated_fat_g": 4.7, "trans_fat_g": 0.0, "cholesterol_mg": 243.8, "sodium_mg": 1309.6, "fiber_g": 23.2, "sugar_g": 5.5, "unsaturated_fat_g": 25.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["artichoke", "boil", "salad", "saute", "shrimp", "summer", "white bean"]}, "images": [], "rating": {"average": 5.0, "count": 14}, "video_url": null, "comment_count": null, "published_at": "1991-06-09", "scraped_at": "2026-09-07T00:15:56.377036+00:00", "scraper_version": "
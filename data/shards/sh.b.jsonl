{"slug": "shrimp-and-artichoke-salad", "nyt_id": 1188, "url": "https://cooking.nytimes.com/recipes/1188-shrimp-and-artichoke-salad", "name": "Shrimp and Artichoke Salad", "author": "Craig Claiborne", "description": "", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": 15, "cook_minutes": 15, "total_minutes": 30, "raw": {"total": "30 minutes", "prep": "15 minutes", "cook": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "24 medium-size shrimp, about 1 pound", "group": null, "quantity": 24.0, "quantity_max": null, "unit": null, "item": "medium-size shrimp", "preparation": "about 1 pound", "optional": false}, {"position": 2, "raw": "16 bottled artichoke bottoms, packed in oil", "group": null, "quantity": 16.0, "quantity_max": null, "unit": null, "item": "bottled artichoke bottoms", "preparation": "packed in oil", "optional": false}, {"position": 3, "raw": "2 tablespoons finely chopped Italian parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped italian parsley", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup freshly squeezed lemon juice", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "freshly squeezed lemon juice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put the shrimp in a saucepan, and add water to cover. Bring to a boil, and remove from the heat. Let stand 15 minutes and drain."}, {"position": 2, "text": "When the shrimp are cool enough to handle, peel and devein them. Cut each shrimp crosswis
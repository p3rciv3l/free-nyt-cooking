{"slug": "manouri-eggplant-and-orzo-salad", "nyt_id": 10426, "url": "https://cooking.nytimes.com/recipes/10426-manouri-eggplant-and-orzo-salad", "name": "Manouri, Eggplant and Orzo Salad", "author": "Sara Dickerman", "description": "", "servings": {"text": "Serves 6 to 8", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 50, "raw": {"total": "About 50 minutes"}}, "ingredients": [{"position": 1, "raw": "Kosher salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups dried orzo", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "dried orzo", "preparation": null, "optional": false}, {"position": 3, "raw": "6 tablespoons extra-virgin olive oil, or as needed", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": "or as needed", "optional": false}, {"position": 4, "raw": "3 cups ½-inch-diced eggplant (from a 1-pound eggplant)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "½-inch-diced eggplant (from a 1-pound eggplant)", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup canola oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "canola oil", "preparation": null, "optional": false}, {"position": 6, "raw": "3 tablespoons flour", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon, plus 1 teaspoon, fresh lemon juice, or as needed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "tablespoon", "preparation": "plus 1 teaspoon, fresh lemon juice, or as needed", "optional": false}, {"position": 9, "raw": "¼ cup Kalamata olives, pitted and sliced lengthwise into ¼-inch slivers", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "kalamata olives", "preparation": "pitted and sliced lengthwise into ¼-inch slivers", "optional": false}, {"position": 10, "raw": "¾ cup chopped roasted red peppers (jarred or homemade)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "chopped roasted red peppers (jarred or homemade)", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon finely chopped mint", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped mint", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon finely chopped dill", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped dill", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons roughly chopped basil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "roughly chopped basil", "preparation": null, "optional": false}, {"position": 14, "raw": "4 ounces manouri, cut into ½-inch cubes (about ¾ cup)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "manouri", "preparation": "cut into ½-inch cubes (about ¾ cup)", "optional": false}], "steps": [{"position": 1, "text": "Bring a large pot of salted water to a boil and cook the orzo according to the package directions. Drain, toss with 1 tablespoon of the olive oil and spread on a baking sheet. Let cool in the refrigerator."}, {"position": 2, "text": "Toss the eggplant with 1 ½ teaspoons salt and place in a colander set over a bowl or in a sink. Put several bowls or plates on top of the eggplant and let drain for at least 30 minutes."}, {"position": 3, "text": "Line a baking sheet with paper towels and set aside. In a heavy 10-inch skillet, heat 4 tablespoons of the olive oil and the canola oil over medium heat. Squeeze the excess liquid from the eggplant, blot with paper towels and toss in a bowl with the flour. In two batches, fry the eggplant until the cubes are crisp and golden brown. Using a slotted spoon, transfer to the prepared baking sheet. (Add a little extra oil to the pan for the second batch, as needed.)"}, {"position": 4, "text": "In a large bowl, toss the orzo with 1 teaspoon salt, ¼ teaspoon pepper, the lemon juice and the remaining tablespoon of olive oil. Fold in the olives, peppers, mint, dill, basil and manouri. Taste and adjust for seasoning with additional salt, pepper, lemon juice or olive oil. Just before serving, toss in the fried eggplant."}], "nutrition": {"calories": 275.5, "protein_g": 4.3, "carbohydrates_g": 25.2, "fat_g": 17.9, "saturated_fat_g": 2.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 226.6, "fiber_g": 2.3, "sugar_g": 2.4, "unsaturated_fat_g": 15.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["greek"], "diet": ["vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["boil", "eggplant", "fry", "orzo", "pasta salad"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/21/dining/Manouri-Eggplant-and-Orzo-Salad/Manouri-Eggplant-and-Orzo-Salad-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 326}, "video_url": null, "comment_count": null, "published_at": "2007-09-09", "scraped_at": "2026-09-06T22:22:17.248651+00:00", "scraper_version": "1.0.0"}
{"slug": "many-flavor-duck-salad", "nyt_id": 10493, "url": "https://cooking.nytimes.com/recipes/10493-many-flavor-duck-salad", "name": "Many-Flavor Duck Salad", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "25 servings", "min": 25, "max": 25, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 50, "raw": {"total": "50 minutes"}}, "ingredients": [{"position": 1, "raw": "3 five-to-six pound ducks, red-cooked (see recipe)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "five-to-six pound ducks", "preparation": "red-cooked (see recipe)", "optional": false}, {"position": 2, "raw": "½ cup pine nuts", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "pine nuts", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon plus three-quarter cup corn, peanut or vegetable oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "plus three-quarter cup corn", "preparation": "peanut or vegetable oil", "optional": false}, {"position": 4, "raw": "3 sweet red or green peppers, cored, seeded and cut into one-inch-wide shreds", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "sweet red or green peppers", "preparation": "cored, seeded and cut into one-inch-wide shreds", "optional": false}, {"position": 5, "raw": "12 cups Shandong (white-ribbed Chinese cabbage)", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "cup", "item": "shandong (white-ribbed chinese cabbage)", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups minced scallions, green and white parts combined", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "minced scallions", "preparation": "green and white parts combined", "optional": false}, {"position": 7, "raw": "1 ½ tablespoons minced fresh ginger", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "minced fresh ginger", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon ground roasted Sichuan peppercorns", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "ground roasted sichuan peppercorns", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "3 fresh hot chili peppers, seeded and finely chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "fresh hot chili peppers", "preparation": "seeded and finely chopped", "optional": false}, {"position": 11, "raw": "9 tablespoons dark soy sauce", "group": null, "quantity": 9.0, "quantity_max": null, "unit": "tbsp", "item": "dark soy sauce", "preparation": null, "optional": false}, {"position": 12, "raw": "4 ½ tablespoons hoisin sauce", "group": null, "quantity": 4.5, "quantity_max": null, "unit": "tbsp", "item": "hoisin sauce", "preparation": null, "optional": false}, {"position": 13, "raw": "3 tablespoons honey", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 14, "raw": "2 tablespoons finely minced garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 15, "raw": "2 teaspoons bottled chili paste with garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "bottled chili paste with garlic", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cook the ducks one at a time in the sauce. Remove and let cool. Cut the ducks into quarters and pull the bones from the meat. Cut away and discard the skin and any fat. At this point, the ducks may be prepared a day or longer in advance. If it is not to be used immediately, wrap the pieces in foil or plastic wrap and refrigerate or freeze. Cut the meat when it is at room temperature or defrosted or pull it into one-inch-wide shreds."}, {"position": 2, "text": "Meanwhile, preheat the oven to 325 degrees. Put the pine nuts in an ovenproof skillet and toss them in one-half teaspoon of the corn oil. Place in the oven and bake 10 to 15 minutes or until golden brown. Cool."}, {"position": 3, "text": "Put the nuts in a large mixing bowl and add the duck, shredded green peppers and cabbage."}, {"position": 4, "text": "Put the remaining three-quarter cup of corn oil in a saucepan and add the chopped scallions, ginger, peppercorns, pepper and chili peppers."}, {"position": 5, "text": "Combine the dark soy sauce, hoisin sauce, honey, garlic and chili paste with garlic in a small bowl."}, {"position": 6, "text": "Bring the corn-oil mixture to the simmer and let cook one minute, no longer. Add the soy-sauce mixture and stir. Remove from the heat. Pour this simmering liquid over the salad. Toss, blending well, and serve immediately."}], "nutrition": {"calories": 1517.3, "protein_g": 36.3, "carbohydrates_g": 7.0, "fat_g": 149.0, "saturated_fat_g": 41.6, "trans_fat_g": 0.2, "cholesterol_mg": 227.6, "sodium_mg": 575.5, "fiber_g": 1.4, "sugar_g": 3.9, "unsaturated_fat_g": 98.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["chinese"], "diet": [], "course": [], "meal": [], "occasion": ["new year’s day"], "other": ["bake", "boil", "cabbage", "duck", "salad"]}, "images": [], "rating": {"average": 4.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1982-10-24", "scraped_at": "2026-09-06T22:29:04.540691+00:00", "scraper_version": "1.0.0"}
{"slug": "margaret-sichels-herring-salad", "nyt_id": 2953, "url": "https://cooking.nytimes.com/recipes/2953-margaret-sichels-herring-salad", "name": "Margaret Sichel's herring salad", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "16 appetizer or eight main-course servings", "min": 16, "max": 16, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "¾ pound pickled beets (see recipe)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "lb", "item": "pickled beets (see recipe)", "preparation": null, "optional": false}, {"position": 2, "raw": "4 sour pickles, about three-quarter pound, ends trimmed", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "sour pickles", "preparation": "about three-quarter pound, ends trimmed", "optional": false}, {"position": 3, "raw": "8 matjes herring fillets, about one and one-quarter pounds", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "matjes herring fillets", "preparation": "about one and one-quarter pounds", "optional": false}, {"position": 4, "raw": "2 sour apples, about one pound, peeled, quartered and cored", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "sour apples", "preparation": "about one pound, peeled, quartered and cored", "optional": false}, {"position": 5, "raw": "4 hard-cooked eggs, peeled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "hard-cooked eggs", "preparation": "peeled", "optional": false}, {"position": 6, "raw": "¾ cup imported lingonberries", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "imported lingonberries", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup sour cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 8, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Prepare the pickled beets and set aside to cool. Chill."}, {"position": 2, "text": "Drain the beets and cut them into quarter-inch cubes. Place them in a mixing bowl. Cut the pickles into quarter-inch cubes and add them to the bowl."}, {"position": 3, "text": "Cut the herring lengthwise into one-half-inch-wide strips. Cut the strips into half-inch-long pieces or slightly smaller. Add these to the bowl."}, {"position": 4, "text": "Cut the apples into quarter-inch cubes and add them to the bowl."}, {"position": 5, "text": "Chop the eggs and add them. Add the lingonberries, sour cream and pepper. Blend well and chill. Serve with thin slices of rye bread or pumpernickel. Leftover herring salad keeps well in the refrigerator."}], "nutrition": {"calories": 212.7, "protein_g": 18.6, "carbohydrates_g": 9.6, "fat_g": 11.0, "saturated_fat_g": 3.0, "trans_fat_g": 0.1, "cholesterol_mg": 96.7, "sodium_mg": 1244.3, "fiber_g": 2.0, "sugar_g": 6.0, "unsaturated_fat_g": 6.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["nordic"], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["beet", "egg", "salad", "seafood"]}, "images": [], "rating": {"average": 4.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "1982-11-07", "scraped_at": "2026-09-07T00:16:28.761362+00:00", "scraper_version": "1.0.0"}

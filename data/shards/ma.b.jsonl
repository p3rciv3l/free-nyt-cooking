ull, "unit": "tbsp", "item": "minced fresh ginger", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon ground roasted Sichuan peppercorns", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "ground roasted sichuan peppercorns", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "3 fresh hot chili peppers, seeded and finely chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "fresh hot chili peppers", "preparation": "seeded and finely chopped", "optional": false}, {"position": 11, "raw": "9 tablespoons dark soy sauce", "group": null, "quantity": 9.0, "quantity_max": null, "unit": "tbsp", "item": "dark soy sauce", "preparation": null, "optional": false}, {"position": 12, "raw": "4 ½ tablespoons hoisin sauce", "group": null, "quantity": 4.5, "quantity_max": null, "unit": "tbsp", "item": "hoisin sauce", "preparation": null, "optional": false}, {"position": 13, "raw": "3 tablespoons honey", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 14, "raw": "2 tablespoons finely minced garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 15, "raw": "2 teaspoons bottled chili paste with garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "bottled chili paste with garlic", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cook the ducks one at a time in the sauce. Remove and let cool. Cut the ducks into quarters and pull the bones from the meat. Cut away and discard the skin and any fat. At this point, the ducks may be prepared a day or longer in advance. If it is not to be used immediately, wrap the pieces in foil or plastic wrap and refrigerate or freeze. Cut the meat when it is at room temperature or defrosted or pull it into one-inch-wide shreds."}, {"position": 2, "text": "Meanwhile, preheat the oven to 325 degrees. Put the pine nuts in an ovenproof skillet and toss them in one-half teaspoon of the corn oil. Place in the oven and bake 10 to 15 minutes or until golden brown. Cool."}, {"position": 3, "text": "Put the nuts in a large mixing bowl and add the duck, shredded green peppers and cabbage."}, {"position": 4, "text": "Put the remaining three-quarter cup of corn oil in a saucepan and add the chopped scallions, ginger, peppercorns, pepper and chili peppers."}, {"position": 5, "text": "Combine the dark soy sauce, hoisin sauce, honey, garlic and chili paste with garlic in a small bowl."}, {"position": 6, "text": "Bring the corn-oil mixture to the simmer and let cook one minute, no longer. Add the soy-sauce mixture and stir. Remove from the heat. Pour this simmering liquid over the salad. Toss, blending well, and serve immediately."}], "nutrition": {"calories": 1517.3, "protein_g": 36.3, "carbohydrates_g": 7.0, "fat_g": 149.0, "saturated_fat_g": 41.6, "trans_fat_g": 0.2, "cholesterol_mg": 227.6, "sodium_mg": 575.5, "fiber_g": 1.4, "sugar_g": 3.9, "unsaturated_fat_g": 98.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["chinese"], "diet": [], "course": [], "meal": [], "occasion": ["new year’s day"], "other": ["bake", "boil", "cabbage", "duck", "salad"]}, "images": [], "rating": {"average": 4.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1982-10-24", "scraped_at": "2026-09-06T22:29:04.540691+00:00", "scraper_version": "1.0.0"}

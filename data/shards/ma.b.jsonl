{"slug": "marinated-vegetables-dijon", "nyt_id": 10823, "url": "https://cooking.nytimes.com/recipes/10823-marinated-vegetables-dijon", "name": "Marinated Vegetables Dijon", "author": "Ann Barry", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes, plus hours' refrigeration"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons Grey Poupon Dijon mustard", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "grey poupon dijon mustard", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon red-wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "2 scallions, thinly sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "thinly sliced", "optional": false}, {"position": 5, "raw": "¼ teaspoon dried basil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "dried basil", "preparation": null, "optional": false}, {"position": 6, "raw": "⅛ teaspoon pepper", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ pound fresh mushrooms, cleaned, patted dry and sliced", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "fresh mushrooms", "preparation": "cleaned, patted dry and sliced", "optional": false}, {"position": 9, "raw": "1 pint cherry tomatoes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "cherry tomatoes", "preparation": null, "optional": false}, {"position": 10, "raw": "1 package (9 ounces) frozen artichoke hearts", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "package", "item": "(9 ounces) frozen artichoke hearts", "preparation": null, "optional": false}, {"position": 11, "raw": "1 bunch watercress", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "watercress", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large bowl, combine mustard, oil, vinegar, scallions, basil, pepper and sugar."}, {"position": 2, "text": "Mix in mushrooms, tomatoes and artichokes. Cover."}, {"position": 3, "text": "Chill several hours or overnight."}, {"position": 4, "text": "Spoon over a bed of watercress."}], "nutrition": {"calories": 194.1, "protein_g": 4.7, "carbohydrates_g": 15.5, "fat_g": 14.2, "saturated_fat_g": 2.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 163.4, "fiber_g": 5.4, "sugar_g": 6.9, "unsaturated_fat_g": 11.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["main course", "side dish"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["artichoke heart", "cherry tomato", "easy", "mushroom", "no cook", "salad", "vegetables", "weeknight"]}, "images": [], "rating": {"average": 5.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "1986-09-24", "scraped_at": "2026-09-06T22:32:26.846731+00:00", "scraper_version": "1.0.0"}
{"slug": "mark-bittmans-eggplant-parmesan", "nyt_id": 12671, "url": "https://cooking.nytimes.com/recipes/12671-mark-bittmans-eggplant-parmesan", "name": "Mark Bittman’s Eggplant Parmesan", "author": "Mark Bittman", "description": "This is the most minimalist eggplant Parmesan imaginable, really an eggplant gratin with tomatoes. You cook the eggplant in abundant oil. Yes, you can broil it or bake it, but I really think the taste of eggplant slices that have had oil boiled right through them is dreamy. Make a 15-minute tomato sauce of fresh or canned tomatoes, onion and olive oil, then grab a gratin dish and layer the eggplant, sauce and Parmesan. Do this two or three times, and that's it. Bake until it's bubbly and golden brown. It's great hot or at room temperature, so it's perfect for a potluck.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "An hour, or a little more (sadly)"}}, "ingredients": [{"position": 1, "raw": "Olive oil as needed", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "olive oil as needed", "preparation": null, "optional": false}, {"position": 2, "raw": "2 pounds eggplant, preferably small ones but in any case, firm", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "eggplant", "preparation": "preferably small ones but in any case, firm", "optional": false}, {"position": 3, "raw": "Salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 medium onion, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "2 pounds fresh plum tomatoes or one 28-ounce can, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "fresh plum tomatoes or one 28-ounce can", "preparation": "chopped", "optional": false}, {"position": 6, "raw": "Parmesan cheese, grated", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "parmesan cheese", "preparation": "grated", "optional": false}, {"position": 7, "raw": "Chopped parsley for garnish, optional", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "chopped parsley for garnish", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "Put ⅛ inch of oil in your largest skillet (the bigger the skillet, the faster you can get through sautéing the eggplant) and turn the heat to medium. Start trimming and slicing eggplant: ½-inch slices, or maybe ⅜-inch, but not as thin as ¼ inch. When the oil shimmers, add the eggplant; you can crowd them as long as they don't overlap. Season with salt and pepper and cook, turning as necessary, until nicely tender and browned on both sides; drain on paper towels. Add more oil when necessary."}, {"position": 2, "text": "Cook the onion in the remaining oil; when it's tender, add the tomatoes and some salt and pepper and cook at a lively simmer until saucy, 10 or 15 minutes. Heat the oven to 400."}, {"position": 3, "text": "Eyeball your eggplant and your baking dishes and pick a nice dish that will work. I like a big oval gratin dish for this. Add a layer of eggplant, then tomato sauce, then cheese, then eggplant, tomato sauce, cheese. That will probably do, but you can make more layers if you like. Bake until the cheese is melted and the whole thing is bubbly, about 15 minutes. Sprinkle with parsley and serve hot or at room temperature."}], "nutrition": null, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "eggplant", "saute", "summer", "tomato"]}, "images": [{"url": "https://static01.nyt.com/images/2016/12/05/dining/05COOKING-MARKEGGPLANTPARMESAN2/05COOKING-MARKEGGPLANTPARMESAN2-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 2675}, "video_url": null, "comment_count": null, "published_at": "2012-08-07", "scraped_at": "2026-09-06T23:59:02.714818+00:00", "scraper_version": "1.0.0"}
{"slug": "masala-winter-squash", "nyt_id": 11784, "url": "https://cooking.nytimes.com/recipes/11784-masala-winter-squash", "name": "Masala Winter Squash", "author": "Mark Bittman", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "1 large onion, peeled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large onion", "preparation": "peeled", "optional": false}, {"position": 2, "raw": "5 cloves garlic, peeled", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled", "optional": false}, {"position": 3, "raw": "1 dried chili, or 1 teaspoon dried red chili flakes, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "dried chili", "preparation": "or 1 teaspoon dried red chili flakes, or to taste", "optional": false}, {"position": 4, "raw": "2 tablespoons neutral oil, like grapeseed, corn or canola", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "neutral oil", "preparation": "like grapeseed, corn or canola", "optional": false}, {"position": 5, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon curry powder, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "curry powder", "preparation": "or to taste", "optional": false}, {"position": 7, "raw": "1 cup chopped tomatoes (canned are fine), optional", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped tomatoes (canned are fine)", "preparation": null, "optional": true}, {"position": 8, "raw": "1 ½ pounds peeled winter squash, like butternut or firm pumpkin, cut into 1-inch cubes", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "peeled winter squash", "preparation": "like butternut or firm pumpkin, cut into 1-inch cubes", "optional": false}, {"position": 9, "raw": "Lime wedges", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "lime wedges", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine onion, garlic and chili in container of a food processor and grind until pasty. In a large skillet or casserole that can be covered, place oil and put over medium heat. Add onion mixture, salt and pepper and curry powder. Cook, stirring occasionally, until onion mixture begins to brown, 5 to 10 minutes."}, {"position": 2, "text": "Add tomatoes or ½ cup water, along with squash. Cover and adjust heat so mixture simmers steadily. Cook, stirring occasionally and adding more water if necessary, until squash is tender, about 20 minutes. Serve with lime."}], "nutrition": {"calories": 84.5, "protein_g": 3.2, "carbohydrates_g": 19.9, "fat_g": 0.7, "saturated_fat_g": 0.2, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 600.0, "fiber_g": 3.3, "sugar_g": 7.7, "unsaturated_fat_g": 0.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["indian"], "diet": ["gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["curry powder", "easy", "fall", "great leftovers", "quick", "saute", "squash", "stew", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/30/dining/Winter-Squash/Winter-Squash-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 140}, "video_url": null, "comment_count": null, "published_at": "2006-03-15", "scraped_at": "2026-09-06T23:49:50.141248+00:00", "scraper_version": "1.0.0"}

{"slug": "manouri-eggplant-and-orzo-salad", "nyt_id": 10426, "url": "https://cooking.nytimes.com/recipes/10426-manouri-eggplant-and-orzo-salad", "name": "Manouri, Eggplant and Orzo Salad", "author": "Sara Dickerman", "description": "", "servings": {"text": "Serves 6 to 8", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 50, "raw": {"total": "About 50 minutes"}}, "ingredients": [{"position": 1, "raw": "Kosher salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups dried orzo", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "dried orzo", "preparation": null, "optional": false}, {"position": 3, "raw": "6 tablespoons extra-virgin olive oil, or as needed", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": "or as needed", "optional": false}, {"position": 4, "raw": "3 cups ½-inch-diced eggplant (from a 1-pound eggplant)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "½-inch-diced eggplant (from a 1-pound eggplant)", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup canola oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "canola oil", "preparation": null, "optional": false}, {"position": 6, "raw": "3 tablespoons flour", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon, plus 1 teaspoon, fresh lemon juice, or as needed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "tablespoon", "preparation": "plus 1 teaspoon, fresh lemon juice, or as needed", "optional": false}, {"position": 9, "raw": "¼ cup Kalamata olives, pitted and sliced lengthwise into ¼-inch slivers", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "kalamata olives", "preparation": "pitted and sliced lengthwise into ¼-inch slivers", "optional": false}, {"position": 10, "raw": "¾ cup chopped roasted red peppers (jarred or homemade)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "chopped roasted red peppers (jarred or homemade)", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon finely chopped mint", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped mint", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon finely chopped dill", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped dill", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons roughly chopped basil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "roughly chopped basil", "preparation": null, "optional": false}, {"position": 14, "raw": "4 ounces manouri, cut into ½-inch cubes (about ¾ cup)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "manouri", "preparation": "cut into ½-inch cubes (about ¾ cup)", "optional": false}], "steps": [{"position": 1, "text": "Bring a large pot of salted water to a boil and cook the orzo according to the package directions. Drain, toss with 1 tablespoon of the olive oil and spread on a baking sheet. Let cool in the refrigerator."}, {"position": 2, "text": "Toss the eggplant with 1 ½ teaspoons salt and place in a colander set over a bowl or in a sink. Put several bowls or plates on top of the eggplant and let drain for at least 30 minutes."}, {"position": 3, "text": "Line a baking sheet with paper towels and set aside. In a heavy 10-inch skillet, heat 4 tablespoons of the olive oil and the canola oil over medium heat. Squeeze the excess liquid from the eggplant, blot with paper towels and toss in a bowl with the flour. In two batches, fry the eggplant until the cubes are crisp and golden brown. Using a slotted spoon, transfer to the prepared baking sheet. (Add a little extra oil to the pan for the second batch, as needed.)"}, {"position": 4, "text": "In a large bowl, toss the orzo with 1 teaspoon salt, ¼ teaspoon pepper, the lemon juice and the remaining tablespoon of olive oil. Fold in the olives, peppers, mint, dill, basil and manouri. Taste and adjust for seasoning with additional salt, pepper, lemon juice or olive oil. Just before serving, toss in the fried eggplant."}], "nutrition": {"calories": 275.5, "protein_g": 4.3, "carbohydrates_g": 25.2, "fat_g": 17.9, "saturated_fat_g": 2.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 226.6, "fiber_g": 2.3, "sugar_g": 2.4, "unsaturated_fat_g": 15.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["greek"], "diet": ["vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["boil", "eggplant", "fry", "orzo", "pasta salad"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/21/dining/Manouri-Eggplant-and-Orzo-Salad/Manouri-Eggplant-and-Orzo-Salad-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 326}, "video_url": null, "comment_count": null, "published_at": "2007-09-09", "scraped_at": "2026-09-06T22:22:17.248651+00:00", "scraper_version": "1.0.0"}

{"slug": "maida-heatters-cuban-black-beans-and-rice", "nyt_id": 2500, "url": "https://cooking.nytimes.com/recipes/2500-maida-heatters-cuban-black-beans-and-rice", "name": "Maida Heatter's Cuban Black Beans And Rice", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "Eight servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 300, "raw": {"total": "About 5 hours, plus overnight soak"}}, "ingredients": [{"position": 1, "raw": "1 pound dried black beans, preferably turtle beans", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "dried black beans", "preparation": "preferably turtle beans", "optional": false}, {"position": 2, "raw": "6 cups cold water", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "cup", "item": "cold water", "preparation": null, "optional": false}, {"position": 3, "raw": "2 small ham hocks, about 1 ¼ pounds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small ham hocks", "preparation": "about 1 ¼ pounds", "optional": false}, {"position": 4, "raw": "½ cup olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "3 ½ cups finely chopped yellow onions", "group": null, "quantity": 3.5, "quantity_max": null, "unit": "cup", "item": "finely chopped yellow onions", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups chopped green peppers", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "chopped green peppers", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons finely minced garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 8, "raw": "2 bay leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ teaspoon dried, hot red-pepper flakes", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "dried", "preparation": "hot red-pepper flakes", "optional": false}, {"position": 10, "raw": "3 tablespoons red-wine vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 12, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ teaspoon cayenne pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cayenne pepper", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ teaspoon Tabasco sauce", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "tabasco sauce", "preparation": null, "optional": false}, {"position": 15, "raw": "3 tablespoons dark rum", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "dark rum", "preparation": null, "optional": false}, {"position": 16, "raw": "Cooked rice (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "cooked rice (see recipe)", "preparation": null, "optional": false}, {"position": 17, "raw": "Onions for black beans (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "onions for black beans (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Pick over the beans carefully to remove any foreign particles. Rinse well in several changes of cold water."}, {"position": 2, "text": "Put the beans in a bowl with the six cups of cold water. Cover and let stand overnight."}, {"position": 3, "text": "Drain the beans, reserving the water in which they soaked. Measure the water and add enough additional water to make eight cups."}, {"position": 4, "text": "Place the beans, water and ham hocks in a small kettle or large saucepan and bring to the boil. Cook slowly, uncovered, skimming the surface as necessary to remove any foam. The beans should cook until tender, four to six hours."}, {"position": 5, "text": "Meanwhile, heat the oil in a skillet and add the onions and green peppers. Cook, stirring, until the mixture is wilted. Add the garlic and cook briefly, stirring. After the beans have cooked about two hours, add the mixture to the beans. Add the bay leaves, pepper flakes, vinegar, salt and pepper."}, {"position": 6, "text": "When the beans are almost tender, uncover and continue cooking 30 minutes."}, {"position": 7, "text": "Remove the ham hocks. When they are cool enough to handle, remove and discard the skin, fat, bones and gristle. Shred the meat and return it to the beans. Remove the bay leaves. Add the cayenne pepper and Tabasco."}, {"position": 8, "text": "This dish improves if cooked one day in advance. When ready to serve, heat the bean mixture thoroughly. Just before serving, stir in the rum. Serve with rice on the side or spoon a portion of the bean mixture over individual servings of rice. Add the onions according to taste."}], "nutrition": {"calories": 493.8, "protein_g": 30.1, "carbohydrates_g": 45.5, "fat_g": 21.2, "saturated_fat_g": 4.3, "trans_fat_g": 0.1, "cholesterol_mg": 43.2, "sodium_mg": 1102.4, "fiber_g": 11.0, "sugar_g": 5.6, "unsaturated_fat_g": 15.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["cuban"], "diet": ["high fiber"], "course": ["main course"], "meal": ["lunch"], "occasion": [], "other": ["black 
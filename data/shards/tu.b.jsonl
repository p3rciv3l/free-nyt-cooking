{"slug": "tuna-salad-with-shells", "nyt_id": 2442, "url": "https://cooking.nytimes.com/recipes/2442-tuna-salad-with-shells", "name": "Tuna Salad With Shells", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes, plus chill"}}, "ingredients": [{"position": 1, "raw": "2 cups macaroni shells", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "macaroni shells", "preparation": null, "optional": false}, {"position": 2, "raw": "1 6 ½- or 7-ounce can tuna in oil, undrained", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "6 ½- or 7-ounce can tuna in oil", "preparation": "undrained", "optional": false}, {"position": 3, "raw": "1 medium tomato, peeled, seeded and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium tomato", "preparation": "peeled, seeded and chopped", "optional": false}, {"position": 4, "raw": "1 medium cucumber, peeled, seeded and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium cucumber", "preparation": "peeled, seeded and chopped", "optional": false}, {"position": 5, "raw": "1 small zucchini, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small zucchini", "preparation": "finely chopped", "optional": false}, {"position": 6, "raw": "¼ cup drained capers", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "drained capers", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons fresh lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup mayonnaise", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "mayonnaise", "preparation": null, "optional": false}, {"position": 9, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons minced parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced parsley", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon minced fresh basil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh basil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cook shells in boiling salted water until tender. Drain well."}, {"position": 2, "text": "Break tuna into chunks and combine with tomato, cucumber, zucchini and capers. Add lemon juice. Stir mayonnaise until smooth and fold in. Season to taste with salt and pepper."}, {"position": 3, "text": "Garnish with parsley and basil and chill before serving."}], "nutrition": {"calories": 705.3, "protein_g": 20.7, "carbohydrates_g": 45.2, "fat_g": 49.1, "saturated_fat_g": 7.5, "trans_fat_g": 0.0, "cholesterol_mg": 30.2, "sodium_mg": 722.7, "fiber_g": 3.2, "sugar_g": 4.2, "unsaturated_fat_g": 40.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["boil", "pasta salad", "summer", "tuna", "tuna salad"]}, "images": [], "rating": {"average": 4.0, "count": 42}, "video_url": null, "comment_count": null, "published_at": "1983-06-12", "scraped_at": "2026-09-07T00:11:53.062583+00:00", "scraper_version": "1.0.0"}
{"slug": "turkey-breast-with-capers-and-mushrooms", "nyt_id": 2323, "url": "https://cooking.nytimes.com/recipes/2323-turkey-breast-with-capers-and-mushrooms", "name": "Turkey Breast With Capers and Mushrooms", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "8 slices turkey breast tenderloin steaks, about 1 ½ pounds", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "slice", "item": "turkey breast tenderloin steaks", "preparation": "about 1 ½ pounds", "optional": false}, {"position": 2, "raw": "½ pound fresh mushrooms", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "fresh mushrooms", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons flour", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste if desired", "preparation": null, "optional": false}, {"position": 5, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "2 to 4 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": 4.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup drained capers", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "drained capers", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon finely minced garlic", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons chicken broth", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup finely chopped parsley", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place each turkey breast steak between sheets of clear plastic wrap and pound lightly with a flat mallet to make thin slices."}, {"position": 2, "text": "Cut mushrooms into thin slices. There should be about 3 cups."}, {"position": 3, "text": "Season the flour with salt and pepper. Dip the turkey slices in the flour to coat. Shake off excess."}, {"position": 4, "text": "Heat 2 tablespoons of the oil in a skillet, preferably nonstick. Add enough turkey slices to cover the bottom of the skillet without crowding. Cook until golden brown on one side, about 2 to 3 minutes, and turn. Cook until golden brown on the other side, about 2 minutes. Transfer the slices to a warm serving dish."}, {"position": 5, "text": "Add another tablespoon of oil to the skillet and repeat with a second batch of slices. Continue cooking, adding more oil as necessary, until all slices are nicely browned."}, {"position": 6, "text": "In the same skillet, heat 2 tablespoons of butter. Add mushrooms and cook, shaking the skillet and stirring, about 4 minutes. Add capers and garlic, and toss to blend. Add chicken broth and let cook about 30 seconds. Swirl in the remaining butter."}, {"position": 7, "text": "Spoon the mushroom mixture over the turkey slices and sprinkle with parsley."}], "nutrition": {"calories": 1113.1, "protein_g": 73.4, "carbohydrates_g": 9.7, "fat_g": 85.5, "saturated_fat_g": 34.2, "trans_fat_g": 0.0, "cholesterol_mg": 331.7, "sodium_mg": 1080.0, "fiber_g": 1.5, "sugar_g": 1.4, "unsaturated_fat_g": 42.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["caper", "mushroom", "saute", "turkey"]}, "images": [], "rating": {"average": 4.0, "count": 26}, "video_url": null, "comment_count": null, "published_at": "1985-04-17", "scraped_at": "2026-09-07T00:10:20.717652+00:00", "scraper_version": "1.0.0"}
{"slug": "turkish-red-lentil-soup", "nyt_id": 12070, "url": "https://cooking.nytimes.com/recipes/12070-turkish-red-lentil-soup", "name": "Turkish Red Lentil Soup", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups red lentils", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "red lentils", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup long-grain rice", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "long-grain rice", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup onions, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "onions", "preparation": "finely chopped", "optional": false}, {"position": 5, "raw": "2 tablespoons tomato paste", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup peeled, finely diced tomato", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "peeled", "preparation": "finely diced tomato", "optional": false}, {"position": 7, "raw": "2 tablespoons sweet paprika", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sweet paprika", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon cayenne pepper, or to taste", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cayenne pepper", "preparation": "or to taste", "optional": false}, {"position": 9, "raw": "9 cups chicken or vegetable stock or water", "group": null, "quantity": 9.0, "quantity_max": null, "unit": "cup", "item": "chicken or vegetable stock or water", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "½ tablespoon finely chopped mint", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "finely chopped mint", "preparation": null, "optional": false}, {"position": 12, "raw": "2 cups plain toasted bread cubes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "plain toasted bread cubes", "preparation": null, "optional": false}, {"position": 13, "raw": "Lemon wedges", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "lemon wedges", "preparation": null, "optional": false}, {"position": 14, "raw": "Plain yogurt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "plain yogurt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the lentils and rice in a sieve, rinse well and allow to drain."}, {"position": 2, "text": "Meanwhile, heat the oil in a heavy four-quart saucepan. Add the onion, and saute until soft but not brown. Stir in the tomato paste, tomato, paprika and cayenne pepper. Add the lentils, rice and stock. Stir well, and simmer, covered, 30 minutes, until the rice is cooked and the lentils have virtually dissolved into a puree. Stir from time to time."}, {"position": 3, "text": "Add salt to taste. If the soup is too thick, add a little water."}, {"position": 4, "text": "Serve each portion sprinkled with mint leaves and croutons, with lemon wedges and yogurt on the side."}], "nutrition": {"calories": 410.7, "protein_g": 21.9, "carbohydrates_g": 54.9, "fat_g": 12.2, "saturated_fat_g": 2.6, "trans_fat_g": 0.0, "cholesterol_mg": 11.8, "sodi
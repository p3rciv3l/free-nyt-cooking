{"slug": "tuna-chickpeas-and-broccoli-salad", "nyt_id": 12272, "url": "https://cooking.nytimes.com/recipes/12272-tuna-chickpeas-and-broccoli-salad", "name": "Tuna, Chickpeas and Broccoli Salad", "author": "Martha Rose Shulman", "description": "This recipe is inspired by a common Italian combination, tuna and beans. It’s a salad that keeps well in the refrigerator and one that’s great to have on hand during the week. The broccoli will not retain its pretty green color once in contact with the acid in the dressing, so for best results keep the broccoli separate, along with a tablespoon of the dressing. Just before you want to eat, toss in the broccoli and extra dressing; or eat the broccoli separately with the dressing.", "servings": {"text": "2 1/2 servings. ", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "1 can water-packed light tuna, drained", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "can", "item": "water-packed light tuna", "preparation": "drained", "optional": false}, {"position": 2, "raw": "½ can chickpeas, (⅓ cup) drained and rinsed", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "can", "item": "chickpeas", "preparation": "(⅓ cup) drained and rinsed", "optional": false}, {"position": 3, "raw": "1 stalk celery, cut in small (¼-inch) dice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "stalk", "item": "celery", "preparation": "cut in small (¼-inch) dice", "optional": false}, {"position": 4, "raw": "½ red bell pepper, cut in small (¼-inch) dice", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "red bell pepper", "preparation": "cut in small (¼-inch) dice", "optional": false}, {"position": 5, "raw": "2 tablespoons chopped fresh parsley (optional)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh parsley", "preparation": null, "optional": true}, {"position": 6, "raw": "1 tablespoon chopped fresh chives (optional)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh chives", "preparation": null, "optional": true}, {"position": 7, "raw": "1 broccoli crown, steamed for 4 to 5 minutes and broken into florets", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "broccoli crown", "preparation": "steamed for 4 to 5 minutes and broken into florets", "optional": false}, {"position": 8, "raw": "1 ½ tablespoons fresh lemon juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 9, "raw": "½ tablespoon vinegar (red wine, sherry or white wine)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "vinegar (red wine", "preparation": "sherry or white wine)", "optional": false}, {"position": 10, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "1 teaspoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon extra virgin olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ cup plain low-fat yogurt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "plain low-fat yogurt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a medium bowl, mix together the tuna, chickpeas, celery, bell pepper, parsley and chives. Keep the broccoli separate."}, {"position": 2, "text": "In a small bowl or measuring cup, mix together the lemon juice, vinegar, salt, and Dijon mustard. Whisk in the olive oil and yogurt, and toss with the tuna and chickpea mixture. Refrigerate in a bowl or in containers until ready to take to work or eat. Add the broccoli just before serving."}], "nutrition": {"calories": 323.4, "protein_g": 33.6, "carbohydrates_g": 27.2, "fat_g": 10.6, "saturated_fat_g": 1.5, "trans_fat_g": 0.0, "cholesterol_mg": 48.5, "sodium_mg": 836.1, "fiber_g": 8.0, "sugar_g": 7.1, "unsaturated_fat_g": 6.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://static01.nyt.com/images/2012/01/24/science/23recipehealth/23recipehealth-facebookJumbo-v2.jpg", "alt": "Tuna, Chickpeas and Broccoli Salad With Yogurt Dressing", "primary": true}], "rating": {"average": 5.0, "count": 179}, "video_url": null, "comment_count": null, "published_at": "2012-01-23", "scraped_at": "2026-09-06T23:54:36.704136+00:00", "scraper_version": "1.0.0"}
{"slug": "tuna-salad-composee", "nyt_id": 11682, "url": "https://cooking.nytimes.com/recipes/11682-tuna-salad-composee", "name": "Tuna Salad Composée", "author": "Toby Cecchini", "description": "This recipe is a far departure from the mayonnaise-based tuna concoctions that Americans expect. Tuna (packed in olive oil, please) is mixed with peppers, fresh herbs and nuts and dressed in olive oil, balsamic vinegar, lemon juice and two types of mustard. It can sit in the fridge for up to three days, making it excellent picnic food or just a departure from the usual sad desk sandwich.", "servings": {"text": "About 2 cups", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "5 minutes"}}, "ingredients": [{"position": 1, "raw": "10 to 12 ounces good-quality solid tuna packed in olive oil, well drained", "group": null, "quantity": 10.0, "quantity_max": 12.0, "unit": "oz", "item": "good-quality solid tuna packed in olive oil", "preparation": "well drained", "optional": false}, {"position": 2, "raw": "2 scallions washed, trimmed and chopped fine", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "scallions washed", "preparation": "trimmed and chopped fine", "optional": false}, {"position": 3, "raw": "6 pepperoncini peppers, destemmed and julienned", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "pepperoncini peppers", "preparation": "destemmed and julienned", "optional": false}, {"position": 4, "raw": "3 tablespoons chopped fresh dill", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh dill", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup roasted or smoked almonds, chopped roughly, or a small handful toasted pine nuts", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "roasted or smoked almonds", "preparation": "chopped roughly, or a small handful toasted pine nuts", "optional": false}, {"position": 6, "raw": "¼ cup good-quality olive oil (or the oil the tuna was packed in)", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "good-quality olive oil (or the oil the tuna was packed in)", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon smooth Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "smooth dijon mustard", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon whole-grain mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "whole-grain mustard", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon balsamic vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 10, "raw": "1 teaspoon fresh lemon juice or more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "fresh lemon juice or more to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ to ½ teaspoon freshly ground black pepper", "group": null, "quantity": 0.25, "quantity_max": 0.5, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Mix all the ingredients well with a fork in a medium-size, nonreactive bowl. Taste and adjust the lemon juice and pepper. The salad can be made up to 3 days in advance and refrigerated."}], "nutrition": {"calories": 227.8, "protein_g": 16.3, "carbohydrates_g": 2.0, "fat_g": 17.3, "saturated_fat_g": 2.3, "trans_fat_g": 0.0, "cholesterol_mg": 9.4, "sodium_mg": 384.3, "fiber_g": 0.7, "sugar_g": 0.5, "unsaturated_fat_g": 13.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["side dish"], "meal": ["lunch"], "occasion": ["picn
{"slug": "turkish-shepherds-salad", "nyt_id": 12609, "url": "https://cooking.nytimes.com/recipes/12609-turkish-shepherds-salad", "name": "Turkish Shepherd’s Salad", "author": "Martha Rose Shulman", "description": "What distinguishes this summer salad are all the fresh herbs and the sumac and red pepper used to season it. You can buy these spices at Middle Eastern markets or from online retailers like Penzey’s. The recipe is adapted from one in “The Little Foods of the Mediterranean,” by Clifford A. Wright.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "5 minutes, plus 30 minutes' refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 pound tomatoes, diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "tomatoes", "preparation": "diced", "optional": false}, {"position": 2, "raw": "¾ pound cucumbers (1 European or 4 Persian), diced", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "lb", "item": "cucumbers (1 european or 4 persian)", "preparation": "diced", "optional": false}, {"position": 3, "raw": "1 green pepper, preferably a long green Italian frying pepper, seeded and diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "green pepper", "preparation": "preferably a long green Italian frying pepper, seeded and diced", "optional": false}, {"position": 4, "raw": "½ small red onion, sliced, soaked in cold water for 5 minutes, drained and rinsed", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "small red onion", "preparation": "sliced, soaked in cold water for 5 minutes, drained and rinsed", "optional": false}, {"position": 5, "raw": "¼ cup (loosely packed) coarsely chopped flat-leaf parsley", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "(loosely packed) coarsely chopped flat-leaf parsley", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon chopped dill", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped dill", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons chopped mint", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped mint", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon sumac", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sumac", "preparation": null, "optional": false}, {"position": 9, "raw": "½ to 1 teaspoon Turkish or Aleppo pepper", "group": null, "quantity": 0.5, "quantity_max": 1.0, "unit": "tsp", "item": "turkish or aleppo pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 11, "raw": "3 tablespoons fresh lemon juice", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 12, "raw": "3 tablespoons extra virgin olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 13, "raw": "1 to 2 ounces feta, crumbled (¼ to ½ cup) (optional)", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "oz", "item": "feta", "preparation": "crumbled (¼ to ½ cup)", "optional": true}, {"position": 14, "raw": "Black olives as desired (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "black olives as desired", "preparation": null, "optional": true}, {"position": 15, "raw": "Romaine lettuce leaves and pita bread for serving (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "romaine lettuce leaves and pita br
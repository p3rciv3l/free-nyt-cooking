{"slug": "tuscan-bean-soup", "nyt_id": 1462, "url": "https://cooking.nytimes.com/recipes/1462-tuscan-bean-soup", "name": "Tuscan Bean Soup", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 135, "raw": {"total": "2 hours 15 minutes, plus overnight soaking"}}, "ingredients": [{"position": 1, "raw": "2 pounds white navy beans", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "white navy beans", "preparation": null, "optional": false}, {"position": 2, "raw": "2 large onions, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large onions", "preparation": "chopped", "optional": false}, {"position": 3, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 4, "raw": "Coarse salt and freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "1 ½ cups pureed Italian tomatoes, canned or fresh", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "pureed italian tomatoes", "preparation": "canned or fresh", "optional": false}, {"position": 6, "raw": "4 cloves garlic", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 7, "raw": "2 ounces pancetta (Italian-style bacon)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "oz", "item": "pancetta (italian-style bacon)", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup parsley, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "parsley", "preparation": "chopped", "optional": false}, {"position": 9, "raw": "⅓ cup extra-virgin olive oil", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak the beans in water to cover overnight. Drain and put in a kettle and add water to cover. Add the onions, bay leaf, salt and pepper. Simmer one to two hours or until cooked."}, {"position": 2, "text": "With a slotted spoon, remove half the beans and set aside. Puree the remaining mixture, a portion at a time, in a blender. Put into a large saucepan and add the beans you set aside."}, {"position": 3, "text": "Add the pureed tomatoes. Bring the soup to simmer, turn down heat and cook for 10 minutes."}, {"position": 4, "text": "Meanwhile fry the garlic, pancetta and parsley in the olive oil until lightly golden. Stir into the soup. Remove from heat and let stand, covered for five minutes before serving."}], "nutrition": {"calories": 516.3, "protein_g": 27.3, "carbohydrates_g": 75.0, "fat_g": 13.5, "saturated_fat_g": 2.4, "trans_fat_g": 0.0, "cholesterol_mg": 4.7, "sodium_mg": 475.8, "fiber_g": 18.8, "sugar_g": 6.8, "unsaturated_fat_g": 10.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["appetizer"], "meal": ["brunch"], "occasion": ["new year’s day"], "other": ["great leftovers", "navy bean", "pancetta", "soup", "tomato", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 105}, "video_url": null, "comment_count": null, "published_at": "1982-12-26", "scraped_at": "2026-09-07T00:04:46.090279+00:00", "scraper_version": "1.0.0"}
{"slug": "tuscan-kale-salad", "nyt_id": 11746, "url": "https://cooking.nytimes.com/recipes/11746-tuscan-kale-salad", "name": "Tuscan Kale Salad", "author": "Melissa Clark", "description": "Kale salad may someday go the way of other clichéd salads of yore — the bean salad, the chef’s salad, the beet salad with goat cheese. But like all those other venerable mixtures, its ubiquity is due in large part to how good it can be. Take a bunch of raw Tuscan kale (also called lacinato or black kale), which is more delicate than other varieties, and slice it into ribbons. Toss those ribbons with a thick bright dressing of garlic paste, pecorino, lemon juice, olive oil and a pinch of red pepper flakes. Top with freshly toasted bread crumbs and a flurry of pecorino. The leaves are sturdy enough to stand up to the bold flavors and varying textures, but tender when you take a bite.", "servings": {"text": "2 to 4 servings", "min": 2, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 bunch Tuscan kale (also known as black or lacinato kale)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "tuscan kale (also known as black or lacinato kale)", "preparation": null, "optional": false}, {"position": 2, "raw": "1 thin slice country bread (part whole-wheat or rye is nice), or ¼ cup homemade bread crumbs (coarse)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "thin slice country bread (part whole-wheat or rye is nice)", "preparation": "or ¼ cup homemade bread crumbs (coarse)", "optional": false}, {"position": 3, "raw": "½ garlic clove, finely chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "garlic clove", "preparation": "finely chopped", "optional": false}, {"position": 4, "raw": "¼ cup finely grated pecorino cheese, more for garnish", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely grated pecorino cheese", "preparation": "more for garnish", "optional": false}, {"position": 5, "raw": "3 tablespoons extra virgin olive oil, more for garnish", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": "more for garnish", "optional": false}, {"position": 6, "raw": "Freshly squeezed juice of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly squeezed juice of 1 lemon", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ teaspoon kosher salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 8, "raw": "⅛ teaspoon red pepper flakes", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "red pepper flakes", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly ground black pepper, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": "to taste", "optional": false}], "steps": [{"position": 1, "text": "Trim bottom 2 inches off kale stems and discard. Slice kale, including ribs, into ¾-inch-wide ribbons. You should have 4 to 5 cups. Place kale in a large bowl."}, {"position": 2, "text": "If using bread, toast it until golden on both sides. Tear it into small pieces and grind in a food processor until mixture forms coarse crumbs."}, {"position": 3, "text": "Using a mortar and pestle, or with the back of a knife, pound garlic into a paste. Transfer garlic to a small bowl. Add ¼ cup cheese, 3 tablespoons oil, lemon juice, salt, pepper flakes and black pepper, and whisk to combine. Pour dressing over kale and toss very well to thoroughly combine (dressing will be thick and need lots of tossing to coat leaves)."}, {"position": 4, "text": "Let salad sit for 5 minutes, then serve topped with bread crumbs, additional cheese and a drizzle of oil."}], "nutrition": {"calories": 156.4, "protein_g": 4.8, "carbohydrates_g": 6.5, "fat_g": 13.3, "saturated_fat_g": 2.9, "trans_fat_g": 0.0, "cholesterol_mg": 8.6, "sodium_mg": 218.4, "fiber_g": 2.9, "sugar_g": 1.3, "unsaturated_fat_g": 9.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["low-carb", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["easy", "green salad", "kale", "quick"]}, "images": [{"url": "https://static01.nyt.com/images/2014/02/20/dining/recipes-kalewithpecorino/recipes-kalewithpecorino-facebookJumbo-v2.jpg", "alt": "Raw Tuscan kale salad with pecorino.", "primary": true}], "rating": {"average": 5.0, "count": 2316}, "video_url": null, "comment_count": null, "published_at": "2007-10-24", "scraped_at": "2026-09-06T23:49:28.797033+00:00", "scraper_version": "1.0.0"}

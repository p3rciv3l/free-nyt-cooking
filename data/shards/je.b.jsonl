{"slug": "jerusalem-artichoke-soup", "nyt_id": 1202, "url": "https://cooking.nytimes.com/recipes/1202-jerusalem-artichoke-soup", "name": "Jerusalem Artichoke Soup", "author": "Joan Nathan", "description": "", "servings": {"text": "6 - 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "2 medium onions, peeled and diced in ½-inch pieces", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium onions", "preparation": "peeled and diced in ½-inch pieces", "optional": false}, {"position": 2, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "1 ½ pounds Jerusalem artichokes (also known as California sunchokes), peeled", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "jerusalem artichokes (also known as california sunchokes)", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "4 cups chicken broth", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 6, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "10 to 12 blanched almonds", "group": null, "quantity": 10.0, "quantity_max": 12.0, "unit": null, "item": "blanched almonds", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons water", "group": null, "quantit
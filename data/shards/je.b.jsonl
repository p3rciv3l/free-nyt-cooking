{"slug": "jefs-shortcut-chicken-mole", "nyt_id": 11064, "url": "https://cooking.nytimes.com/recipes/11064-jefs-shortcut-chicken-mole", "name": "Jef's Shortcut Chicken Mole", "author": "Deborah Vankin", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon peanut oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "peanut oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 8 ¼-ounce jar mole negro (available at Latin American grocery stores and specialty markets)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "8 ¼-ounce jar mole negro (available at latin american grocery stores and specialty markets)", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups chicken stock", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cups canned, puréed tomatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "canned", "preparation": "puréed tomatoes", "optional": false}, {"position": 5, "raw": "6 boneless, skinless chicken breast halves, boiled until cooked through", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "boneless", "preparation": "skinless chicken breast halves, boiled until cooked through", "optional": false}, {"position": 6, "raw": "1 ½ tablespoons toasted sesame seeds", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "toasted sesame seeds", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place a large sauté pan over medium heat, and add the oil. When the oil is hot, add the mole, and stir with a wooden spoon until the mole is softened."}, {"position": 2, "text": "Add the chicken stock and tomatoes, and stir until smooth. Halve the chicken pieces and add to the mole. Simmer until reheated, about five minutes. To serve, place equal portions on four plates, and sprinkle each serving with sesame seeds. If desired, serve with white rice."}], "nutrition": null, "tags": {"cuisine": ["mexican"], "diet": ["dairy-free", "gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["chicken", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 56}, "video_url": null, "comment_count": null, "published_at": "2002-06-16", "scraped_at": "2026-09-07T02:02:04.111439+00:00", "scraper_version": "1.0.0"}
{"slug": "jeremiah-towers-duck-with-endive-salad", "nyt_id": 7504, "url": "https://cooking.nytimes.com/recipes/7504-jeremiah-towers-duck-with-endive-salad", "name": "Jeremiah Tower's Duck With Endive Salad", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 20, "cook_minutes": 20, "total_minutes": 40, "raw": {"total": "40 minutes", "prep": "20 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "4 duck legs", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "duck legs", "preparation": null, "optional": false}, {"position": 2, "raw": "2 duck livers", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "duck livers", "preparation": null, "optional": false}, {"position": 3, "raw": "Coarse salt and freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablespoons Madeira or dry sherry", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "madeira or dry sherry", "preparation": null, "optional": false}, {"position": 6, "raw": "16 small slices bread for croutons", "group": null, "quantity": 16.0, "quantity_max": null, "unit": null, "item": "small slices bread for croutons", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons chopped tomatoes", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chopped tomatoes", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon chopped fresh parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons fresh lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup hazelnut or walnut oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "hazelnut or walnut oil", "preparation": null, "optional": false}, {"position": 11, "raw": "1 large head curly endive, washed and spin-dried", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large head curly endive", "preparation": "washed and spin-dried", "optional": false}, {"position": 12, "raw": "½ cup hazelnuts, toasted and skinned", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "hazelnuts", "preparation": "toasted and skinned", "optional": false}], "steps": [{"position": 1, "text": "Turn the legs skin side down. Cut along each thigh bone and remove them."}, {"position": 2, "text": "Heat the oven to 325 degrees."}, {"position": 3, "text": "Remove the sinews from the duck livers. Season and then saute over high heat in the butter for three minutes. Pour in the Madeira or sherry and cook for another minute. Puree the liver and juices in a food processor or through a food mill until smooth; then set aside."}, {"position": 4, "text": "Bake the bread for 10 minutes and then let cool."}, {"position": 5, "text": "Heat grill or broiler. Season the duck legs and grill or broil for five minutes on the flesh side and eight minutes on the skin side. Spread the liver puree on the croutons and put half a teaspoon of the chopped tomatoe on each crouton and sprinkle with chopped parsley."}, {"position": 6, "text": "Dissolve salt and pepper in the lemon juice and whisk in the oil. Toss the endive and hazelnuts in the dressing. Put the salad on warm plates, a duck leg on top of each salad, the liver croutons around the salads."}], "nutrition": {"calories": 1258.5, "protein_g": 33.7, "carbohydrates_g": 9.9, "fat_g": 119.9, "saturated_fat_g": 35.8, "trans_fat_g": 0.0, "cholesterol_mg": 300.3, "sodium_mg": 772.7, "fiber_g": 3.0, "sugar_g": 1.8, "unsaturated_fat_g": 76.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["bake", "broil", "duck", "grill", "poultry"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1988-07-10", "scraped_at": "2026-09-07T01:02:53.966097+00:00", "scraper_version": "1.0.0"}
{"slug": "jerilyns-blackberry-cobbler", "nyt_id": 11301, "url": "https://cooking.nytimes.com/recipes/11301-jerilyns-blackberry-cobbler", "name": "Jerilyn's Blackberry Cobbler", "author": "Susan Herrmann Loomis", "description": "", "servings": {"text": "Twelve servings", "min": 12, "max": 12, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "About 1 hour"}}, "ingredients": [{"position": 1, "raw": "6 cups blackberries", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "cup", "item": "blackberries", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ¼ cups sugar", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup cornstarch", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cups all-purpose flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup plus 1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "plus 1 tablespoon sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon baking powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon salt, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "or to taste", "optional": false}, {"position": 8, "raw": "1 cup milk", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup unsalted butter, melted", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "unsalted butter", "preparation": "melted", "optional": false}, {"position": 10, "raw": "¼ teaspoon nutmeg", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "nutmeg", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 350 degrees."}, {"position": 2, "text": "Rinse the berries very gently and place them in a bowl. Sprinkle with one cup of the sugar and let stand one hour at room temperature. Drain, reserving the juice."}, {"position": 3, "text": "In a saucepan, combine one-quarter cup of the sugar with the cornstarch and reserved berry juice, and cook, stirring, over medium heat until the mixture is thick, about four minutes. Cool slightly and stir into the berries."}, {"position": 4, "text": "Pour the berries into an oven-proof dish that measures 9 inches by 9 inches."}, {"position": 5, "text": "To make the topping, in a large bowl, combine the flour, one cup of sugar, the baking powder and salt. Add the milk and butter, and beat the mixture until smooth."}, {"position": 6, "text": "Spoon the topping over the berries, making sure to spread it to the edges of the dish to prevent any excess juice from boiling over. Sprinkle the topping lightly with nutmeg and the remaining sugar."}, {"position": 7, "text": "Bake the cobbler for 35 to 40 minutes, or until the topping is golden brown and the filling is bubbly. Remove the cobbler from the oven, cool slightly, and spoon it into serving dishes. Top with the heavy cream."}], "nutrition": {"calories": 418.0, "protein_g": 4.4, "carbohydrates_g": 66.4, "fat_g": 16.1, "saturated_fat_g": 9.8, "trans_fat_g": 0.2, "cholesterol_mg": 44.8, "sodium_mg": 301.7, "fiber_g": 4.4, "sugar_g": 43.6, "unsaturated_fat_g": 5.2, "source": "nyt", 
{"slug": "jean-georges-vongerichtens-crab-salad", "nyt_id": 11175, "url": "https://cooking.nytimes.com/recipes/11175-jean-georges-vongerichtens-crab-salad", "name": "Jean-Georges Vongerichten's Crab Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "About 30 minutes, plus refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 cup minus 2 tablespoons all-purpose flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "minus 2 tablespoons all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ tablespoons sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ tablespoons cumin seeds", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "cumin seeds", "preparation": null, "optional": false}, {"position": 4, "raw": "⅔ cup white-wine vinegar", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "white-wine vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 ½ tablespoons melted butter", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "melted butter", "preparation": null, "optional": false}, {"position": 6, "raw": "3 tablespoons water", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "water", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ pounds crab meat", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "crab meat", "preparation": null, "optional": false}, {"position": 8, "raw": "2 small ripe tomatoes, cored and quartered", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small ripe tomatoes", "preparation": "cored and quartered", "optional": false}, {"position": 9, "raw": "1 ½ shallots, peeled and coarsely chopped", "group": null, "quantity": 1.5, "quantity_max": null, "unit": null, "item": "shallots", "preparation": "peeled and coarsely chopped", "optional": false}, {"position": 10, "raw": "1 large clove garlic, peeled and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large clove garlic", "preparation": "peeled and chopped", "optional": false}, {"position": 11, "raw": "1 ½ tablespoons lemon juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 12, "raw": "3 tablespoons olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 13, "raw": "1 ½ tablespoons sherry vinegar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 14, "raw": "3 fresh basil leaves", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "fresh basil leaves", "preparation": null, "optional": false}, {"position": 15, "raw": "Kosher salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 16, "raw": "2 bunches of mache, about 2 cups, rinsed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "bunch", "item": "of mache", "preparation": "about 2 cups, rinsed", "optional": false}, {"position": 17, "raw": "1 ½ mangoes, peeled and cut into -inch dice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": null, "item": "mangoes", "preparation": "peeled and cut into -inch dice", "optional": false}], "steps": [{"position": 1, "text": "To make the crisps, preheat the oven to 425 degrees. In a small bowl, mix together the flour, sugar and cumin seeds. Add the vinegar, butter and water and mix thoroughly, but do not overmix."}, {"position": 2, "text": "Working in batches and using a pastry brush, dab very thin 2-inch discs of batter onto a nonstick baking sheet. Bake until golden, 3 to 5 minutes. Cool on wire racks."}, {"position": 3, "text": "To make the crab salad, break up the lumps with your fingers, removing any shell or cartilage but leaving the crab as intact as possible. Refrigerate. In a blender, combine the tomatoes, shallots, garlic, lemon juice, oil, vinegar and basil and blend until smooth. Season to taste."}, {"position": 4, "text": "Slowly stir the tomato sauce into the crab meat. Coat the crab, but do not soak it. Place 3 scoops of crab salad on each of 6 plates. Place a cumin crisp between each scoop. Garnish with the mache and the mangoes."}], "nutrition": {"calories": 285.7, "protein_g": 23.0, "carbohydrates_g": 23.5, "fat_g": 11.4, "saturated_fat_g": 3.1, "trans_fat_g": 0.0, "cholesterol_mg": 117.6, "sodium_mg": 831.8, "fiber_g": 3.3, "sugar_g": 17.3, "unsaturated_fat_g": 7.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["bake", "crab", "salad", "seafood"]}, "images": [], "rating": {"average": 4.0, "count": 41}, "video_url": null, "comment_count": null, "published_at": "1997-10-19", "scraped_at": "2026-09-06T23:01:26.126578+00:00", "scraper_version": "1.0.0"}

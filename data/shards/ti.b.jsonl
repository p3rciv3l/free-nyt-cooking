aw": "1 cup tomato sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "tomato sauce", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup ketchup", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "ketchup", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup strong brewed coffee", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "strong brewed coffee", "preparation": null, "optional": false}, {"position": 12, "raw": "½ cup molasses", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "molasses", "preparation": null, "optional": false}, {"position": 13, "raw": "½ cup apple-cider vinegar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "apple-cider vinegar", "preparation": null, "optional": false}, {"position": 14, "raw": "½ cup Worcestershire sauce", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "worcestershire sauce", "preparation": null, "optional": false}, {"position": 15, "raw": "1 tablespoon hot sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "hot sauce", "preparation": null, "optional": false}, {"position": 16, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 17, "raw": "1 teaspoon garlic powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "garlic powder", "preparation": null, "optional": false}, {"position": 18, "raw": "1 teaspoon chili powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chili powder", "preparation": null, "optional": false}, {"position": 19, "raw": "1 teaspoon ground black pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground black pepper", "preparation": null, "optional": false}, {"position": 20, "raw": "1 teaspoon liquid smoke (optional)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "liquid smoke", "preparation": null, "optional": true}, {"position": 21, "raw": "½ teaspoon onion powder", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "onion powder", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place powdered hickory in a Camerons smoker according to the manufacturer's directions. Tuck into the pan a cooking thermometer that has a low enough register to read 160 degrees."}, {"position": 2, "text": "To make the dry rub, combine the ingredients in a medium bowl and mix well, pressing with the back of a spoon to remove any lumps."}, {"position": 3, "text": "Rub the brisket with the dry rub. Place the brisket into the smoker and slide the cover almost completely closed. Place over low heat until wisps of smoke appear, close the cover tightly and smoke for 6 hours, making sure the temperature never exceeds 160 degrees. (Check the thermometer every half-hour.) Drain off liquid from the drip pan after the first, third and fifth hours."}, {"position": 4, "text": "Preheat oven to 275 degrees. Remove brisket from the smoker and wrap in a double thickness of heavy-duty foil, sealing it tightly. Place the packet fat side down on a baking sheet and bake until fork tender, 3 to 4 hours, turning packet over halfway through cooking."}, {"position": 5, "text": "Make the barbecue sauce by combining the ingredients in a pan and mixing well. Heat to boiling, reduce heat and simmer for 30 minutes."}, {"position": 6, "text": "To serve, remove brisket from the foil and place on a cutting board. Cut across the grain into thin slices. Liberally baste with sauce and serve with extra sauce."}], "nutrition": {"calories": 932.0, "protein_g": 49.9, "carbohydrates_g": 48.5, "fat_g": 60.0, "saturated_fat_g": 23.9, "trans_fat_g": 0.0, "cholesterol_mg": 248.7, "sodium_mg": 1195.4, "fiber_g": 3.4, "sugar_g": 36.0, "unsaturated_fat_g": 28.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["bake", "beef", "brisket", "project", "smoke"]}, "images": [], "rating": {"average": 4.0, "count": 31}, "video_url": null, "comment_count": null, "published_at": "2003-11-09", "scraped_at": "2026-09-07T02:49:52.808497+00:00", "scraper_version": "1.0.0"}
{"slug": "tim-boyds-barbecued-spareribs", "nyt_id": 12078, "url": "https://cooking.nytimes.com/recipes/12078-tim-boyds-barbecued-spareribs", "name": "Tim Boyd's Barbecued Spareribs", "author": "Jason Epstein", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "About 4 hours"}}, "ingredients": [{"position": 1, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "3 tablespoons paprika", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "paprika", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons granulated garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "granulated garlic", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon chili powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chili powder", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon onion powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "onion powder", "preparation": null, "optional": false}, {"position": 6, "raw": "8 pounds pork spareribs", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "lb", "item": "pork spareribs", "preparation": null, "optional": false}, {"position": 7, "raw": "1 32-ounce bottle of ketchup", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "32-ounce bottle of ketchup", "preparation": null, "optional": false}, {"position": 8, "raw": "2 cups dark brown sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "dark brown sugar", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup strong brewed coffee", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "strong brewed coffee", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup Worcestershire sauce", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "worcestershire sauce", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup frozen orange juice concentrate, undiluted", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "frozen orange juice concentrate", "preparation": "undiluted", "optional": false}, {"position": 12, "raw": "2 tablespoons coarse ground black pepper", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "coarse ground black pepper", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon granulated garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "granulated garlic", "preparation": null, "optional": false}, {"position": 14, "raw": "1 tablespoon celery salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "celery salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the dry rub, combine the ingredients in a medium bowl and mix well, pressing with the back of a spoon to remove any lumps."}, {"position": 2, "text": "Line a large roasting pan with heavy-duty foil. Rinse the ribs with cold water, pat dry and place in the pan. Rub ribs on all sides and under the flaps on the back with the dry rub. Let stand at room temperature 30 minutes."}, {"position": 3, "text": "Prepare an outdoor grill or preheat the broiler, placing rack in center of oven. Barbecue ribs over medium coals or broil until browned and heated through, about 30 minutes, turning every 6 to 8 minutes and keeping close watch so they don't burn."}, {"position": 4, "text": "Preheat oven to 300 degrees. Return barbecued ribs to the foil-lined pan and wrap tightly with foil or tightly cover broiled ribs in pan. Bake until tender, 1 ½ to 2 hours."}, {"position": 5, "text": "Meanwhile, make the sparerib sauce by combining the ingredients and mixing well. Heat to boiling, reduce heat and simmer for 30 minutes."}, {"position": 6, "text": "Uncover ribs and baste with sauce. Place ribs, basted side down, on barbecue grill or uncover, baste and place under broiler. Cook until browned and sizzling, baste and turn, keeping a close watch. Cook until browned on second side."}, {"position": 7, "text": "To serve: Cut ribs between bones. Liberally baste with sauce and serve with extra sauce."}], "nutrition": {"calories": 1758.7, "protein_g": 73.2, "carbohydrates_g": 129.4, "fat_g": 106.9, "saturated_fat_g": 34.3, "trans_fat_g": 1.0, "cholesterol_mg": 362.9, "sodium_mg": 1664.6, "fiber_g": 2.6, "sugar_g": 113.9, "unsaturated_fat_g": 57.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "broil", "pork", "spare rib"]}, "images": [], "rating": {"average": 5.0, "count": 69}, "video_url": null, "comment_count": null, "published_at": "2003-11-09", "scraped_at": "2026-09-07T02:49:55.588525+00:00", "scraper_version": "1.0.0"}

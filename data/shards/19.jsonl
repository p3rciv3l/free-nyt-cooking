{"slug": "1958-eggnog", "nyt_id": 1877, "url": "https://cooking.nytimes.com/recipes/1877-1958-eggnog", "name": "1958: Eggnog", "author": "Amanda Hesser", "description": "This recipe appeared in The Times in an article by Craig Claiborne. As Freeman pointed out, ''It's important to get good farm-fresh eggs, with really orange yolks and really thick cream; these are the main constituents of the drink.'' Halve the recipe for a smaller gathering.", "servings": {"text": "Makes about 40 punch-cup servings", "min": 40, "max": 40, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "12 eggs, separated", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "separated", "optional": false}, {"position": 2, "raw": "1 cup granulated sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup bourbon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "bourbon", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup Cognac", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "cognac", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "3 pints heavy cream", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "pint", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 7, "raw": "Grated nutmeg", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated nutmeg", "preparation": null, "optional": false}, {"position": 8, "raw": "1 to 2 cups milk (optional)", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "cup", "item": "milk", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "In an electric mixer, beat the egg yolks with the sugar until thick."}, {"position": 2, "text": "Slowly add the bourbon and Cognac while beating at slow speed. Chill for several hours."}, {"position": 3, "text": "Add the salt to the egg whites. Beat until almost stiff."}, {"position": 4, "text": "Whip the cream until stiff."}, {"position": 5, "text": "Fold the whipped cream into the yolk mixture, then fold in the beaten egg whites. Chill 1 hour."}, {"position": 6, "text": "When ready to serve, sprinkle the top with freshly grated nutmeg. Serve in punch cups with a spoon."}, {"position": 7, "text": "If desired, add 1 to 2 cups of milk to the yolk mixture for a thinner eggnog."}], "nutrition": {"calories": 195.8, "protein_g": 3.0, "carbohydrates_g": 6.9, "fat_g": 14.7, "saturated_fat_g": 9.0, "trans_fat_g": 0.4, "cholesterol_mg": 89.3, "sodium_mg": 61.2, "fiber_g": 0.2, "sugar_g": 6.6, "unsaturated_fat_g": 4.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": [], "meal": [], "occasion": ["christmas"], "other": ["bourbon", "cocktails", "cream", "egg", "not-shoppable-ic", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2014/06/03/dining/Eggnog/Eggnog-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 330}, "video_url": null, "comment_count": null, "published_at": "2007-12-23", "scraped_at": "2026-09-07T03:56:06.164284+00:00", "scraper_version": "1.0.0"}

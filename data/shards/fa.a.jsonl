{"slug": "fagiano-tartufato-pheasant-with-truffles", "nyt_id": 10013, "url": "https://cooking.nytimes.com/recipes/10013-fagiano-tartufato-pheasant-with-truffles", "name": "Fagiano Tartufato (Pheasant with Truffles)", "author": "Moira Hodgson", "description": "", "servings": {"text": "2 generous servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "PT1H15M"}}, "ingredients": [{"position": 1, "raw": "1 2-2 ½ pound pheasant", "group": null, "quantity": 3.0, "unit": null, "item": "½ pound pheasant", "preparation": null, "optional": false, "quantity_max": 2.0}, {"position": 2, "raw": "3 tablespoons prosciutto fat, at room temperature", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "prosciutto fat", "preparation": "at room temperature", "optional": false}, {"position": 3, "raw": "1 white truffle, thinly sliced", "group": null, "quantity": 1.0, "unit": null, "item": "white truffle", "preparation": "thinly sliced", "optional": false}, {"position": 4, "raw": "1 tablespoon olive oil", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "4 slices fatty bacon", "group": null, "quantity": 4.0, "unit": "slice", "item": "fatty bacon", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup cream", "group": null, "quantity": 0.25, "unit": "cup", "item": "cream", "preparation": null, "optional": false}, {"position": 7, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "The day before, wipe the pheasant dry with paper towels. Chop the prosciutto fat finely until it is the consistency of thick cream. Smear it over the cavity of the bird. Fill the cavity with truffle slices. Truss the legs and wings with string."}, {"position": 2, "text": "Put the pheasant into a glass or china bowl, cover tightly with plastic or foil and keep in a cool place - not the refrigerator - overnight. The aroma of the truffle with permeate the pheasant. If refrigerated, the pheasant will be too cold for this."}, {"position": 3, "text": "The following day, preheat the oven to 425 degrees. Rub the pheasant with olive oil, place on a rack in a roasting pan, sprinkle with salt, if used, and cover the breast and legs with bacon slices."}, {"position": 4, "text": "Roast the pheasant for 25 minutes, basting frequently."}, {"position": 5, "text": "Turn down the oven to 375 degrees, cover the pheasant loosely with foil and cook a further 20 minutes, or until the pheasant is cooked. Cool on a rack."}, {"position": 6, "text": "Add the cream to the cooking juices and mix thoroughly."}, {"position": 7, "text": "Cut the pheasant into four pieces using poultry shears and arrange on a heated serving platter. Heat the juices through and pour over the pheasant. Serve immediately."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 1219.5, "protein_g": 128.7, "carbohydrates_g": 3.7, "fat_g": 87.6, "saturated_fat_g": 29.3, "unsaturated_fat_g": 10.7, "trans_fat_g": 0.5, "cholesterol_mg": 443.4, "sodium_mg": 1475.1, "fiber_g": 2.0, "sugar_g": 1.1, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["bacon", "project", "white-truffle"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": null, "video_url": null, "comment_count": null, "published_at": "1981-11-08", "scraped_at": "2026-09-06T2
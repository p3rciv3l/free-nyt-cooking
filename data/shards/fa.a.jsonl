{"slug": "fall-vegetable-salad-with-oven-dried-tomatoes-and-grapes", "nyt_id": 10123, "url": "https://cooking.nytimes.com/recipes/10123-fall-vegetable-salad-with-oven-dried-tomatoes-and-grapes", "name": "Fall Vegetable Salad With Oven-Dried Tomatoes and Grapes", "author": "Molly O’Neill", "description": "", "servings": {"text": "4 first-course servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "PT20M"}}, "ingredients": [{"position": 1, "raw": "¼ cup basil dried tomatoes (see recipe)", "group": null, "quantity": 0.25, "unit": "cup", "item": "basil dried tomatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup strained tomato juice or water", "group": null, "quantity": 0.75, "unit": "cup", "item": "strained tomato juice or water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon balsamic vinegar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon olive oil", "group": null, "quantity": 1.0, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "4 cups mixed shiitake and portobello mushrooms, stemmed and cut into 1 ½-inch pieces", "group": null, "quantity": 4.0, "unit": "cup", "item": "mixed shiitake and portobello mushrooms", "preparation": "stemmed and cut into 1 ½-inch pieces", "optional": false}, {"position": 8, "raw": "2 teaspoons salt", "group": null, "quantity": 2.0, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 9, "raw": "4 cups cleaned radicchio, torn into bite-size pieces", "group": null, "quantity": 4.0, "unit": "cup", "item": "cleaned radicchio", "preparation": "torn into bite-size pieces", "optional": false}, {"position": 10, "raw": "4 cups cleaned chicory, torn into bite-size pieces", "group": null, "quantity": 4.0, "unit": "cup", "item": "cleaned chicory", "preparation": "torn into bite-size pieces", "optional": false}, {"position": 11, "raw": "1 cup basil dried tomatoes (see recipe), halved", "group": null, "quantity": 1.0, "unit": "cup", "item": "basil dried tomatoes", "preparation": "halved", "optional": false}, {"position": 12, "raw": "1 cup oven-dried grapes (see recipe)", "group": null, "quantity": 1.0, "unit": "cup", "item": "oven-dried grapes", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the vinaigrette, place the tomatoes, the tomato juice or water, the vinegar, the salt and the pepper in a blender and blend until smooth. Scrape into a small saucepan and set aside."}, {"position": 2, "text": "To make the salad, heat the olive oil in a large, nonstick skillet over medium heat. Add the mushrooms and saute until softened. Season with ½ teaspoon of salt. Add the radicchio and chicory and toss until wilted slightly, about 2 minutes. Place in a large bowl and toss in the dried tomatoes and grapes."}, {"position": 3, "text": "Warm the vinaigrette, pour over the salad, add the remaining salt and toss well. Divide among plates and serve immediately."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 150.5, "protein_g": 7.5, "carbohydrates_g": 30.1, "fat_g": 2.7, "saturated_fat_g": 0.3, "unsaturated_fat_g": 0.7, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 761.1, "fiber_g": 7.1, "sugar_g": 18.1, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dinner-salad-vegetables"], "meal": [], "occasion": [], "other": ["fall", "labor-day", "radicchio", "shiitake", "
{"slug": "farfalle-with-oven-dried-tomatoes-and-eggplant", "nyt_id": 10124, "url": "https://cooking.nytimes.com/recipes/10124-farfalle-with-oven-dried-tomatoes-and-eggplant", "name": "Farfalle With Oven-Dried Tomatoes And Eggplant", "author": "Molly O’Neill", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "PT2H"}}, "ingredients": [{"position": 1, "raw": "4 cups eggplant, cut into ⅓-inch cubes", "group": null, "quantity": 4.0, "unit": "cup", "item": "eggplant", "preparation": "cut into ⅓-inch cubes", "optional": false}, {"position": 2, "raw": "1 ½ teaspoons salt, plus more to taste", "group": null, "quantity": 1.5, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 3, "raw": "Olive oil spray", "group": null, "quantity": null, "unit": null, "item": "olive oil spray", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pound farfalle", "group": null, "quantity": 1.0, "unit": "lb", "item": "farfalle", "preparation": null, "optional": false}, {"position": 5, "raw": "2 cups oven-dried tomatoes (see recipe) (replace rosemary and orange oils with 2 ½ teaspoons extra-virgin olive oil and follow directions), cut lengthwise into th", "group": null, "quantity": 2.0, "unit": "cup", "item": "oven-dried tomatoes", "preparation": "cut lengthwise into th", "optional": false}, {"position": 6, "raw": "1 cup fresh basil leaves, cut across into thin strips", "group": null, "quantity": 1.0, "unit": "cup", "item": "fresh basil leaves", "preparation": "cut across into thin strips", "optional": false}, {"position": 7, "raw": "⅓ cup crumbled ricotta salata or feta cheese", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "crumbled ricotta salata or feta cheese", "preparation": null, "optional": false}, {"position": 8, "raw": "3 teaspoons olive oil", "group": null, "quantity": 3.0, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 9, "raw": "2 teaspoons dried thyme", "group": null, "quantity": 2.0, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 10, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the eggplant on a layer of paper towels. Sprinkle with 1 ½ teaspoons salt. Cover with paper towels and let stand for 1 ½ hours. Pat the eggplant dry."}, {"position": 2, "text": "Spray a large, nonstick skillet lightly with the olive oil spray and place over medium heat. Add the eggplant, in batches if necessary, and cook until brown and tender, about 5 minutes."}, {"position": 3, "text": "Bring a large pot of lightly salted water to a boil. Add the farfalle and cook until al dente. Drain well. Place in a large bowl. Add the eggplant, tomatoes, basil and cheese and toss. Add the olive oil, thyme and pepper and toss. Taste and season with salt if needed. Divide among 4 plates and serve immediately."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 532.5, "protein_g": 18.3, "carbohydrates_g": 94.0, "fat_g": 9.3, "saturated_fat_g": 2.7, "unsaturated_fat_g": 1.3, "trans_fat_g": null, "cholesterol_mg": 11.1, "sodium_mg": 684.4, "fiber_g": 7.5, "sugar_g": 7.9, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dinner-main-course-pastas"], "meal": [], "occasion": [], "other": ["eggplant", "fall", "farfalle", "super-bowl", "tomato", "weeknight"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wal
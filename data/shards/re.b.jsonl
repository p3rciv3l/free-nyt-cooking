{"slug": "red-vanilla-beans", "nyt_id": 11736, "url": "https://cooking.nytimes.com/recipes/11736-red-vanilla-beans", "name": "Red Vanilla Beans", "author": "Leslie Land", "description": "Leslie Land", "servings": {"text": "Four to six servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "2 hours 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 4-inch-by- ½-inch strip of orange zest", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "4-inch-by- ½-inch strip of orange zest", "preparation": null, "optional": false}, {"position": 2, "raw": "1 Tahitian vanilla bean, split, scraped and cut into 4 pieces", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "tahitian vanilla bean", "preparation": "split, scraped and cut into 4 pieces", "optional": false}, {"position": 3, "raw": "3 cloves, lightly bruised", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "cloves", "preparation": "lightly bruised", "optional": false}, {"position": 4, "raw": "Cheesecloth", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "cheesecloth", "preparation": null, "optional": false}, {"position": 5, "raw": "½ pound red kidney beans", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "red kidney beans", "preparation": null, "optional": false}, {"position": 6, "raw": "3 ½ cups chicken stock", "group": null, "quantity": 3.5, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon salt (omit if stock is salty)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt (omit if stock is salty)", "preparation": null, "optional": false}, {"position": 8, "raw": "4 tablespoons corn oil or other light vegetable oil (see note)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "corn oil or other light vegetable oil (see note)", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons hazelnut oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "hazelnut oil", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons sherry vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons minced fresh parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh parsley", "preparation": null, "optional": false}, {"position": 12, "raw": "2 or 3 twists of the pepper mill", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "or 3 twists of the pepper mill", "preparation": null, "optional": false}, {"position": 13, "raw": "Pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Tie the orange zest, vanilla seeds and pods and cloves in a small square of cheesecloth. Put the kidney beans in a large saucepan, bury the spice bag in the middle and add the chicken stock and salt."}, {"position": 2, "text": "Bring the liquid to a boil, then lower the heat and simmer gently until beans are cooked, about two hours."}, {"position": 3, "text": "Prepare the dressing by whisking together all the ingredients."}, {"position": 4, "text": "When the beans are tender, drain them, reserving the liquid for soup, if desired. Discard the spice bag. Mix the hot beans with the dressing and allow to cool to room temperature, stirring from time to time."}, {"position": 5, "text": "Chill the beans until about 10 minutes before wanted and serve at cool room temperature."}], "nutrition": {"calories": 314.3, "protein_g": 12.5, "carbohydrates_g": 30.7, "fa
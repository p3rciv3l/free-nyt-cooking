{"slug": "red-wine-port-ice-cream", "nyt_id": 10424, "url": "https://cooking.nytimes.com/recipes/10424-red-wine-port-ice-cream", "name": "Red Wine-Port Ice Cream", "author": "William Grimes", "description": "William Grimes", "servings": {"text": "1 quart", "min": 1, "max": 1, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 bottle French Burgundy, Bordeaux or California pinot noir", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bottle", "item": "french burgundy", "preparation": "Bordeaux or California pinot noir", "optional": false}, {"position": 2, "raw": "1 bottle vintage port", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bottle", "item": "vintage port", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons creme de cassis", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "creme de cassis", "preparation": null, "optional": false}, {"position": 4, "raw": "3 tablespoons Chambord liqueur", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chambord liqueur", "preparation": null, "optional": false}, {"position": 5, "raw": "Zest of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "zest of 1 lemon", "preparation": null, "optional": false}, {"position": 6, "raw": "Zest of 1 orange", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "zest of 1 orange", "preparation": null, "optional": false}, {"position": 7, "raw": "1 stick cinnamon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "stick", "item": "cinnamon", "preparation": null, "optional": false}, {"position": 8, "raw": "5 whole cloves", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "whole cloves", "preparation": null, "optional": false}, {"position": 9, "raw": "5 whole black peppercorns, crushed", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "whole black peppercorns", "preparation": "crushed", "optional": false}, {"position": 10, "raw": "1 ¾ cups milk", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "cream", "preparation": null, "optional": false}, {"position": 12, "raw": "1 vanilla bean, split", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "vanilla bean", "preparation": "split", "optional": false}, {"position": 13, "raw": "6 egg yolks", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 14, "raw": "1 cup plus 2 tablespoons sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "plus 2 tablespoons sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large heavy-bottomed saucepan over high heat, combine the Burgundy and port. Bring to a boil, then reduce heat to medium. Simmer until the mixture has reduced to 1 cup, about 30 minutes. Remove from heat, and add the creme de cassis, Chambord, lemon zest, orange zest, cinnamon, cloves and peppercorns. Add the milk and cream. Scrape the pulp from the vanilla bean into the mixture, and add the bean as well. Set aside."}, {"position": 2, "text": "In a large mixing bowl, combine the egg yolks and sugar. Mix until blended. Return the saucepan containing the wine mixture to medium heat, and bring back to a boil. Slowly whisk the hot wine mixture into the eggs, then return the contents of the bowl to the saucepan. Place the saucepan over low heat, and stir constantly with a wooden spoon until the mixture is thick enough to coat the back of the spoon."}, {"position": 3, "text": "Strain the mixture into a mixing bowl, and place the bowl in a container of ice water to cool. When the mixture has chilled, freeze in an ice cream maker, according to manufacturer's instructions."}], "nutrition": {"calories": 154.8, "protein_g": 1.5, "carbohydrates_g": 17.9, "fat_g": 3.6, "saturated_fat_g": 2.0, "trans_fat_g": 0.1, "cholesterol_mg": 47.7, "sodium_mg": 13.7, "fiber_g": 0.4, "sugar_g": 15.0, "unsaturated_fat_g": 1.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["boil", "ice creams and sorbets", "port", "red wine"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1998-08-05", "scraped_at": "2026-09-06T22:22:10.756586+00:00", "scraper_version": "1.0.0"}
{"slug": "reole-pralines", "nyt_id": 1042, "url": "https://cooking.nytimes.com/recipes/1042-reole-pralines", "name": "Reole Pralines", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "30 pralines", "min": 30, "max": 30, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "About 40 minutes"}}, "ingredients": [{"position": 1, "raw": "Melted butter for greasing the pans", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "melted butter for greasing the pans", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ cups brown sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ cups granulated sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "8 tablespoons butter", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup heavy cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup milk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons dark Karo syrup", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "dark karo syrup", "preparation": null, "optional": false}, {"position": 8, "raw": "½ pound shelled, coarsely broken pecan halves, about 2 cups, toasted (see note)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "shelled", "preparation": "coarsely broken pecan halves, about 2 cups, toasted (see note)", "optional": false}], "steps": [{"position": 1, "text": "Brush the inside of two baking sheets all over with a little melted butter."}, {"position": 2, "text": "It is not imperative that you use a candy thermometer to prepare these pralines, but a thermometer is very much of an asset. It is also preferable that you cook the candy on a metal heat-control pad, the best-known brand of which is Flame-Tamer. This distributes the heat evenly and discourages burning."}, {"position": 3, "text": "Combine the brown sugar, granulated sugar, butter, cream, milk and syrup in a saucepan and bring to the boil, stirring. Cook about 20 minutes, stirring constantly and checking the temperature often if a thermometer is used. When the candy achieves the soft-ball stage, the syrup will form a soft ball when a small portion is dropped into a basin of cold water and registers 235 degrees on the thermometer. Do not exceed that temperature at this point. Add the pecans and continue cooking, stirring constantly, until a temperature of 240 degrees - no more - is achieved. When ready, the syrup will have a non-glossy, lusterless look. Work quickly at this point."}, {"position": 4, "text": "Remove the saucepan from the heat while beating. Take care that the candy does not harden. Use two spoons and spoon about four teaspoons of the mixture at a time onto the buttered baking sheets, spacing the mounds about three inches apart to allow the rounds to spread to about two and one-half inches in diameter. Let cool and transfer the pralines to a dessert plate, using a wide metal spatula. The pralines should be crumbly and not chewy."}], "nutrition": {"calories": 168.8, "protein_g": 1.0, "carbohydrates_g": 19.4, "fat_g": 10.5, "saturated_fat_g": 3.6, "trans_fat_g": 0.0, "cholesterol_mg": 14.1, "sodium_mg": 5.6, "fiber_g": 0.7, "sugar_g": 18.4, "unsaturated_fat_g": 6.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "boil", "pecan"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1985-12-22", "scraped_at": "2026-09-06T22:21:53.696414+00:00", "scraper_version": "1.0.0"}
{"slug": "reubens-apple-pancake", "nyt_id": 10467, "url": "https://cooking.nytimes.com/recipes/10467-reubens-apple-pancake", "name": "Reuben's Apple Pancake", "author": "Marian Burros", "description": "", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 1480, "raw": {"total": "40 minutes, plus 24 hours' marination"}}, "ingredients": [{"position": 1, "raw": "1 large green apple", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large green apple", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons raisins", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "raisins", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ tablespoons sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon cinnamon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "cinnamon", "preparation": null, "optional": false}, {"position": 5, "raw": "3 eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup milk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup flour", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": null, "optional": false}, {"position": 8, "raw": "⅛ teaspoon vanilla", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "vanilla", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ pound butter", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "butter", "preparation": null, "optional": false}, {"position": 10, "raw": "Scant ½ cup sugar", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "scant ½ cup sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel, quarter and core apple and slice into ¼-inch thick, quarter-moon-shaped slices. Place in bowl with raisins, 1 ½ tablespoons sugar and cinnamon. Mix well; cover and allow to marinate for at least 24 hours; longer if possible. Stir occasionally."}, {"position": 2, "text": "Beat eggs with milk and beat in flour and vanilla to make smooth batter."}, {"position": 3, "text": "In a well-seasoned 8-inch French steel skillet with sloping sides and long handle heat 2 tablespoons butter until it sizzles. Add drained apples and raisins and cook over medium heat, stirring, for about 5 minutes, until apples soften."}, {"position": 4, "text": "Add another 2 tablespoons of butter and melt. Pour in batter evenly and cook over medium-high heat, pulling sides of pancake away from edges and allowing batter to flow under and cook. Keep lifting with spatula to keep from sticking. When pancake begins to firm up, sprinkle ¼ to ⅓ of the sugar evenly over the top."}, {"position": 5, "text": "Add another few tablespoons of butter, slipping it underneath the pancake. Then flip the pancake and cook, allowing the sugar to caramelize. When it begins to brown, sprinkle top with another ¼ to ⅓ of sugar. Add more butter if needed. Flip pancake again and allow sugar to caramelize on the bottom."}, {"position": 6, "text": "Sprinkle ¼ to ⅓ of sugar on top. Add more butter to pan if needed. Flip pancake once again and continue caramelzing."}, {"position": 7, "text": "Sprinkle top lightly with sugar and place in 400 degree oven for 20 minutes, to caramelize further."}], "nutrition": {"calories": 968.7, "protein_g": 14.5, "carbohydrates_g": 108.4, "fat_g": 54.6, "saturated_fat_g": 31.8, "trans_fat_g": 0.0, "cholesterol_mg": 367.9, "sodium_mg": 128.8, "fiber_g": 4.5, "sugar_g": 78.5, "unsaturated_fat
ax": null, "unit": "tbsp", "item": "champagne vinegar", "preparation": null, "optional": false}, {"position": 9, "raw": "2 ⅔ cups julienned jicama, placed in a bowl of cold water and refrigerated", "group": null, "quantity": 2.6666666666666665, "quantity_max": null, "unit": "cup", "item": "julienned jicama", "preparation": "placed in a bowl of cold water and refrigerated", "optional": false}, {"position": 10, "raw": "1 cup finely shredded radicchio", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "finely shredded radicchio", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon lime zest", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "lime zest", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a small bowl combine tomatoes, cilantro, pepper, chives, lime and lemon juice, olive oil and vinegar. Refrigerate at least 1 hour. Drain jicama and toss with tomato mixture. Place ¼ cup of the radicchio on each of 4 plates. Arrange a heaping ½ cup of the salad over the radicchio. Garnish with lime zest and serve."}], "nutrition": {"calories": 65.6, "protein_g": 1.7, "carbohydrates_g": 12.3, "fat_g": 1.4, "saturated_fat_g": 0.2, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 12.7, "fiber_g": 5.3, "sugar_g": 4.1, "unsaturated_fat_g": 1.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["high fiber", "low-fat", "vegan", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["champagne vinegar", "chive", "cilantro", "easy", "lime", "low calorie", "radicchio", "salad", "sun-dried tomato", "weeknight"]}, "images": [], "rating": {"average": 3.0, "count": 11}, "video_url": null, "comment_count": null, "published_at": "1993-03-07", "scraped_at": "2026-09-07T00:54:18.212898+00:00", "scraper_version": "1.0.0"}
{"slug": "jimmy-bradleys-salad-with-gruyere", "nyt_id": 10584, "url": "https://cooking.nytimes.com/recipes/10584-jimmy-bradleys-salad-with-gruyere", "name": "Jimmy Bradley’s Salad With Gruyère", "author": "Sam Sifton", "description": "“I’m a big proponent of what you might call stoner food,” the chef and restaurateur Jimmy Bradley told me in 2003, when he gave me this recipe for what amounts to fondue topped with a potato salad topped with a green one. “I think there should always be something on the menu at my restaurants, where someone can come in and see it and say, ‘Yeah, man, I want some of that right now, and then we’ll figure out the rest of the meal.” Well, yeah, man: a pool of warm Gruyère, topped with batons of bacon, wedges of potato, a bitter salad of greens, the cold against the warm, the salty against the faintly sweet and acidic? Pair that with a slightly chilled red wine and someone special and you can figure out the rest later.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "4 Yukon Gold potatoes, about 5 ounces each, peeled and quartered lengthwise", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "yukon gold potatoes", "preparation": "about 5 ounces each, peeled and quartered lengthwise", "optional": false}, {"position": 2, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt and freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "10 ounces bacon, cut into 1-inch pieces", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "bacon", "preparation": "cut into 1-inch pieces", "optional": false}, {"position": 5, "raw": "1 tablespoon unsalted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon all-purpose flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 7, "raw": "2 shallots, finely chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "shallots", "preparation": "finely chopped", "optional": false}, {"position": 8, "raw": "1 cup white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "white wine", "preparation": null, "optional": false}, {"position": 9, "raw": "1 cup heavy cream, or more if needed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": "or more if needed", "optional": false}, {"position": 10, "raw": "2 cups shredded Gruyère cheese", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "shredded gruyère cheese", "preparation": null, "optional": false}, {"position": 11, "raw": "1 ½ teaspoons sherry vinegar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 12, "raw": "½ teaspoon Dijon mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 13, "raw": "1 head Belgian endive, leaves separated", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "belgian endive", "preparation": "leaves separated", "optional": false}, {"position": 14, "raw": "4 to 6 cups cleaned, torn arugula or dandelion greens", "group": null, "quantity": 4.0, "quantity_max": 6.0, "unit": "cup", "item": "cleaned", "preparation": "torn arugula or dandelion greens", "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 400 degrees. Place potatoes in a shallow foil-lined roasting pan; drizzle with ½ tablespoon olive oil and toss to coat. Sprinkle lightly with salt and pepper and toss. Bake 40 minutes, until tender and crisped, stirring after 20 minutes. Loosely cover with foil; keep warm in low oven."}, {"position": 2, "text": "Meanwhile, fry bacon until crisp. Drain on paper towels."}, {"position": 3, "text": "Make the roux. Melt butter over medium heat. Stir in flour and cook, stirring, for about 10 minutes until the mixture is golden. Reserve."}, {"position": 4, "text": "Combine shallots and wine in a nonreactive saucepan; boil until reduced to ⅓ cup. Reduce heat to medium. Stir in the reserved roux and heavy cream, simmer and stir in cheese, a little at a time, until melted and mixture is smooth. Taste; season with pepper. If necessary, thin with more cream. Keep warm."}, {"position": 5, "text": "Combine remaining oil, the vinegar and mustard in a large bowl. Whisk until blended. Season lightly with salt and pepper. Add warm potatoes, bacon, endive and arugula or dandelion greens; toss to coat."}, {"position": 6, "text": "Ladle fondue into a large bowl and place the salad atop or serve in individual shallow bowls."}], "nutrition": {"calories": 675.0, "protein_g": 22.4, "carbohydrates_g": 28.4, "fat_g": 50.4, "saturated_fat_g": 23.8, "trans_fat_g": 0.6, "cholesterol_mg": 120.7, "sodium_mg": 796.4, "fiber_g": 4.8, "sugar_g": 4.5, "unsaturated_fat_g": 23.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["arugula", "bake", "belgian endive", "boil", "fry", "gruyere", "salad"]}, "images": [{"url": "https://static01.nyt.com/images/2018/12/11/dining/ss-salad-with-gruyere/merlin_147141453_907e7742-b596-4def-bbce-c35ff1eb0f4a-facebookJumbo.jpg
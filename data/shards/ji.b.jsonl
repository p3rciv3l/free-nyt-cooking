{"slug": "jicama-relish-in-chilpotle-marinade", "nyt_id": 3631, "url": "https://cooking.nytimes.com/recipes/3631-jicama-relish-in-chilpotle-marinade", "name": "Jicama Relish In Chilpotle Marinade", "author": "Regina Schrambling", "description": "Regina Schrambling", "servings": {"text": "About six cups", "min": 6, "max": 6, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 medium jicama, about 1 pound (see note)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium jicama", "preparation": "about 1 pound (see note)", "optional": false}, {"position": 2, "raw": "1 large carrot", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large carrot", "preparation": null, "optional": false}, {"position": 3, "raw": "1 medium zucchini", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium zucchini", "preparation": null, "optional": false}, {"position": 4, "raw": "1 to 3 pickled chilpotle peppers in an adobo sauce with their liquid (see note)", "group": null, "quantity": 1.0, "quantity_max": 3.0, "unit": null, "item": "pickled chilpotle peppers in an adobo sauce with their liquid (see note)", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup finely chopped onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "finely chopped onion", "preparation": null, "optional": false}, {"position": 6, "raw": "4 garlic cloves, peeled and minced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "garlic cloves", "preparation": "peeled and minced", "optional": false}, {"position": 7, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 8, "raw": "6 whole black peppercorns", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "whole black peppercorns", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup white vinegar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup water", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 11, "raw": "⅓ cup olive oil", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons chopped cilantro", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped cilantro", "preparation": null, "optional": false}, {"position": 13, "raw": "1 teaspoon good-quality dried oregano", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "good-quality dried oregano", "preparation": null, "optional": false}, {"position": 14, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Using a knife, remove the skin from the jicama. Cut the flesh into half-inch dice. Place in a glass or earthenware bowl."}, {"position": 2, "text": "Peel the carrot. Bring a pot of water to a rolling boil and drop the carrot in. Let the water return to the boil, then remove the carrot and discard the water. When the carrot is cool enough to handle, cut it into half-inch dice. Add to the bowl with the jicama."}, {"position": 3, "text": "Scrub the zucchini well but do not peel it. Trim, then cut it into half-inch dice and add it to the bowl."}, {"position": 4, "text": "Drain the chilpotles, reserving the pickling sauce (use one chili for a relatively mild marinade; three will be stinging hot). Cut the chilies open lengthwise and scrape out the seeds (if your fingers are sensitive, you may want to wear rubber gloves). Finely chop the chilies and place them in a separate, medium-sized bowl."}, {"position": 5, "text": "Add the onion, garlic, bay leaf, peppercorns, vinegar, water, olive oil and cilantro to the chilpotle in the bowl. Blend in the reserved chilpotle sauce. Crumble the oregano between your fingers into the bowl. Whisk all the ingredients together, then pour the marinade over the jicama mixture. Toss the vegetables with the marinade to coat them completely. Add salt to taste."}, {"position": 6, "text": "Cover the relish and refrigerate for at least four hours, preferably overnight. Serve as an accompaniment to grilled meats or fish."}], "nutrition": {"calories": 259.3, "protein_g": 2.9, "carbohydrates_g": 21.7, "fat_g": 18.5, "saturated_fat_g": 2.6, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 839.5, "fiber_g": 8.7, "sugar_g": 7.3, "unsaturated_fat_g": 15.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["mexican"], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "chipotle chile", "condiments", "marinate"]}, "images": [], "rating": {"average": 3.0, "count": 7}, "video_url": null, "comment_count": null, "published_at": "1988-10-09", "scraped_at": "2026-09-07T05:22:11.448656+00:00", "scraper_version": "1.0.0"}

{"slug": "apple-and-bitter-lettuces-salad", "nyt_id": 1016048, "url": "https://cooking.nytimes.com/recipes/1016048-apple-and-bitter-lettuces-salad", "name": "Apple and Bitter Lettuces Salad", "author": "Martha Rose Shulman", "description": "You can use a mix of lettuces for this salad, and you can also add some milder lettuce. My favorite combination is endive, radicchio and arugula. It is a simple salad with wonderful contrasts. Dice the apples small.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "PT10M"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon fresh lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon sherry vinegar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon balsamic vinegar", "group": null, "quantity": 1.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste", "group": null, "quantity": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "1 scant teaspoon Dijon mustard", "group": null, "quantity": 1.0, "unit": null, "item": "scant teaspoon dijon mustard", "preparation": null, "optional": false}, {"position": 6, "raw": "1 small garlic clove, puréed", "group": null, "quantity": 1.0, "unit": null, "item": "small garlic clove", "preparation": "puréed", "optional": false}, {"position": 7, "raw": "¼ cup extra virgin olive oil or grapeseed oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "extra virgin olive oil or grapeseed oil", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons walnut oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "walnut oil", "preparation": null, "optional": false}, {"position": 9, "raw": "4 to 5 cups mixed bitter and pungent lettuces, such as endive, radicchio, arugula, frisee, or 3 to 4 cups bitter lettuces and 1 to 2 cups torn up milder lettuce such as bibb or romaine", "group": null, "quantity": 4.0, "unit": "cup", "item": "mixed bitter and pungent lettuces", "preparation": "such as endive, radicchio, arugula, frisee, or 3 to 4 cups bitter lettuces and 1 to 2 cups torn up milder lettuce such as bibb or romaine", "optional": false, "quantity_max": 5.0}, {"position": 10, "raw": "1 large or 2 smaller tart apples, such as a Braeburn or Pink Lady, cored and cut into very small dice (½ to ¼ inch)", "group": null, "quantity": 1.0, "unit": null, "item": "large or 2 smaller tart apples", "preparation": "such as a Braeburn or Pink Lady, cored and cut into very small dice (½ to ¼ inch)", "optional": false}, {"position": 11, "raw": "1 tablespoon chopped fresh tarragon", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "chopped fresh tarragon", "preparation": null, "optional": false}, {"position": 12, "raw": "¼ cup toasted cashews or broken walnuts or pecans (lightly toasted if desired)", "group": null, "quantity": 0.25, "unit": "cup", "item": "toasted cashews or broken walnuts or pecans", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a small measuring cup or bowl, whisk together lemon juice, vinegars, salt, Dijon mustard and garlic. Whisk in oils. Taste and adjust salt."}, {"position": 2, "text": "Combine lettuces, apples, tarragon and nuts in a salad bowl. Toss with the dressing and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 178.16666666666666, "protein_g": 1.4, "carbohydrates_g": 6.4, "fat_g": 17.0, "saturated_fat_g": 2.0, "unsaturated_fat_g": 6.2, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 178.9, "fiber_g": 2.1, "sugar_g": 3.3, "computed_with": null}, "tags": {"cuisine": [], "die
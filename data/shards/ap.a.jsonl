{"slug": "apple-and-broccoli-salad", "nyt_id": 1026135, "url": "https://cooking.nytimes.com/recipes/1026135-apple-and-broccoli-salad", "name": "Apple and Broccoli Salad", "author": "Eric Kim", "description": "This vibrant, gutsy raw broccoli salad has fresh flavors that play on bitterness, fruitiness and texture. Ordinarily tough to eat, stringy broccoli stalks become magically crisp and tender if you peel the woody outside, then thinly slice the peeled spears crosswise against the fiber grains that run along its length. The sweetness of red apple works seamlessly to balance the bite of the raw green vegetable, but for sour seekers, a Granny Smith apple can be divine (and intensely puckery). This salad makes a nice, light lunch with crusty bread and extra shards of Parmesan or is great as a side dish to chicken.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 20, "total_minutes": 25, "raw": {"prep": "PT5M", "cook": "PT20M", "total": "PT25M"}}, "ingredients": [{"position": 1, "raw": "1 pound broccoli with stalks", "group": null, "quantity": 1.0, "unit": "lb", "item": "broccoli with stalks", "preparation": null, "optional": false}, {"position": 2, "raw": "1 crisp sweet-tart red apple, such as Pink Lady or Honeycrisp", "group": null, "quantity": 1.0, "unit": null, "item": "crisp sweet-tart red apple", "preparation": "such as Pink Lady or Honeycrisp", "optional": false}, {"position": 3, "raw": "2 tablespoons apple cider vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "apple cider vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon fresh lemon juice, plus more to taste", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": "plus more to taste", "optional": false}, {"position": 5, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ teaspoons dried oregano", "group": null, "quantity": 1.5, "unit": "tsp", "item": "dried oregano", "preparation": null, "optional": false}, {"position": 7, "raw": "½ to 1 teaspoon crushed red pepper (depending on heat preference), plus more to taste", "group": null, "quantity": 0.5, "unit": "tsp", "item": "crushed red pepper", "preparation": "plus more to taste", "optional": false, "quantity_max": 1.0}, {"position": 8, "raw": "Salt and black pepper", "group": null, "quantity": null, "unit": null, "item": "salt and black pepper", "preparation": null, "optional": false}, {"position": 9, "raw": "1 (1 ounce) chunk Parmesan, plus more to taste", "group": null, "quantity": 1.0, "unit": null, "item": "chunk parmesan", "preparation": "plus more to taste", "optional": false}], "steps": [{"position": 1, "text": "Cut off the broccoli’s stalks, then peel off and discard the tough outsides. Thinly slice the stalks crosswise at an angle, so you end up with long planks. Thinly slice the broccoli’s florets lengthwise. Add the broccoli to a large bowl."}, {"position": 2, "text": "Quarter, core and thinly slice the apple, then add to the bowl. Splash the vinegar and lemon juice over the apples to prevent browning."}, {"position": 3, "text": "Add the olive oil, oregano, red pepper, ¾ teaspoon salt and ½ teaspoon black pepper. Using a Microplane or the fine holes of a box grater, finely grate the cheese over the salad. Toss to combine, then taste for seasoning, adding more salt, lemon juice and red pepper as desired. Garnish with a final dusting of cheese, if desired."}, {"position": 4, "text": "Serve immediately or store in a sealed container in the refrigerator for up to 3 days. (The longer it sits, the more the flavors will balance and the broccoli will tenderize.)"}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 274.75, "protein_g": 6.0, "carbohydrates_g": 15.2, "fat_g": 22.6, "saturated_fat_g": 4.0, "unsaturated_fat_g": 2.4, "trans_fat_g": null, "cholesterol_mg": 4.8, "sodium_mg": 462.3, "fiber_g": 4.5, "sugar_g": 6.8, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-lunch-salad-side-dish-vegetables"], "meal": [], "occasion": [], "other": ["apple", "broccoli", "budget", "easy", "fall", "make-ahead", "parmesan", "quick", "vegetarian-thanksgiving"]}, "images": [{"url": "https://static01.nyt.com/images/2024/10/11/multimedia/ek-apple-broccoli-salad-gwkj/ek-apple-broccoli-salad-gwkj-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2024/10/11/multimedia/ek-apple-broccoli-salad-gwkj/ek-apple-broccoli-salad-gwkj-googleFourByThree.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2024/10/11/multimedia/ek-apple-broccoli-salad-gwkj/ek-apple-broccoli-salad-gwkj-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2024/10/11/multimedia/ek-apple-broccoli-salad-gwkj/ek-apple-broccoli-salad-gwkj-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 330}, "video_url": null, "comment_count": null, "published_at": "2024-10-11", "scraped_at": "2026-09-07T01:06:49Z", "scraper_version": "1.0.0"}
{"slug": "apple-fennel-and-endive-salad-with-feta", "nyt_id": 1013406, "url": "https://cooking.nytimes.com/recipes/1013406-apple-fennel-and-endive-salad-with-feta", "name": "Apple, Fennel and Endive Salad With Feta", "author": "Martha Rose Shulman", "description": "The sweet juice from the grated apple permeates this crunchy salad, which could be a side dish, but would also make a good light lunch or dinner.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "1 Fuji apple", "group": null, "quantity": 1.0, "unit": null, "item": "fuji apple", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon fresh lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 3, "raw": "2 small or 1 medium fennel bulb, trimmed, quartered, cored and very thinly sliced", "group": null, "quantity": 2.0, "unit": null, "item": "small or 1 medium fennel bulb", "preparation": "trimmed, quartered, cored and very thinly sliced", "optional": false}, {"position": 4, "raw": "2 Belgian endives, very thinly sliced crosswise", "group": null, "quantity": 2.0, "unit": null, "item": "belgian endives", "preparation": "very thinly sliced crosswise", "optional": false}, {"position": 5, "raw": "2 teaspoons chopped fresh tarragon", "group": null, "quantity": 2.0, "unit": "tsp", "item": "chopped fresh tarragon", "preparation": null, "optional": false}, {"position": 6, "raw": "2 ounces feta, crumbled (about ½ cup)", "group": null, "quantity": 2.0, "unit": "oz", "item": "feta", "preparation": "crumbled (about ½ cup)", "optional": false}, {"position": 7, "raw": "1 tablespoon sherry vinegar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 9, "raw": "freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "3 tablespoons extra virgin olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel the apple, and grate into a wide bowl on the large holes of a box grater. Add the lemon juice, and toss together. Add the fennel, endives, tarragon and feta."}, {"position": 2, "text": "Stir together the vinegar, olive oil, salt and pepper. Add to the salad mixture, toss together and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 215.25, "protein_g": 4.6, "carbohydrates_g": 18.7, "fat_g": 14.6, "saturated_fat_g": 4.0, "unsaturated_fat_g": 1.4, "trans_fat_g": null, "cholesterol_mg": 16.7, "sodium_mg": 535.6, "fiber_g": 5.7, "sugar_g": 10.5, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["salad"], "meal": [], "occasion": [], "other": ["apple", "belgian-endive", "easy", "fall", "feta", "quick", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2010/12/28/science/28recipehealth/28recipehealth-superJumbo-v2.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2010/12/28/science/28recipehealth/28recipehealth-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 133}, "video_url": null, "comment_count": null, "published_at": "2010-12-28", "scraped_at": "2026-09-06T22:37:12Z", "scraper_version": "1.0.0"}
{"slug": "apple-salad-with-walnuts-and-brussels-sprouts", "nyt_id": 1018374, "url": "https://cooking.nytimes.com/recipes/1018374-apple-salad-with-walnuts-and-brussels-sprouts", "name": "Apple Salad With Walnuts and Brussels Sprouts", "author": "Florence Fabricant", "description": "Waldorf salad is definitely in the DNA of this starter from the Publican restaurant in Chicago. Apples and walnuts provide the base, and raw brussels sprouts and kohlrabi take the place of the celery. The dressing, a honeyed vinaigrette made with walnut oil, is lighter than mayonnaise, although the ricotta contributes creaminess. The cured ham on top elevates this to a sophisticated first course, but eliminate it to make the salad vegetarian. Best of all, the salad can be prepared in advance and holds up nicely on a buffet. Florence Fabricant", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon minced shallot", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "minced shallot", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup apple cider vinegar", "group": null, "quantity": 0.25, "unit": "cup", "item": "apple cider vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon toasted chile flakes, pulverized in a mortar", "group": null, "quantity": 1.0, "unit": "tsp", "item": "toasted chile flakes", "preparation": "pulverized in a mortar", "optional": false}, {"position": 4, "raw": "2 tablespoons whole grain mustard", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "whole grain mustard", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon honey", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup walnut oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "walnut oil", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon extra-virgin olive oil", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "3 Honeycrisp or other crisp tart apples, peeled, cored and in ½-inch dice", "group": null, "quantity": 3.0, "unit": null, "item": "honeycrisp or other crisp tart apples", "preparation": "peeled, cored and in ½-inch dice", "optional": false}, {"position": 9, "raw": "½ medium-size kohlrabi bulb, peeled, in ¼-inch dice", "group": null, "quantity": 0.5, "unit": null, "item": "medium-size kohlrabi bulb", "preparation": "peeled, in ¼-inch dice", "optional": false}, {"position": 10, "raw": "12 brussels sprouts, bases trimmed, sliced thin vertically", "group": null, "quantity": 12.0, "unit": null, "item": "brussels sprouts", "preparation": "bases trimmed, sliced thin vertically", "optional": false}, {"position": 11, "raw": "⅓ cup shaved Parmigiano-Reggiano", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "shaved parmigiano-reggiano", "preparation": null, "optional": false}, {"position": 12, "raw": "½ cup toasted walnuts", "group": null, "quantity": 0.5, "unit": "cup", "item": "toasted walnuts", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 14, "raw": "Salt and ground black pepper", "group": null, "quantity": null, "unit": null, "item": "salt and ground black pepper", "preparation": null, "optional": false}, {"position": 15, "raw": "6 ounces fresh ricotta", "group": null, "quantity": 6.0, "unit": "oz", "item": "fresh ricotta", "preparation": null, "optional": false}, {"position": 16, "raw": "6 slices serrano ham (about 3 ounces), optional", "group": null, "quantity": 6.0, "unit": "slice", "item": "serrano ham", "preparation": "optional", "optional": true}], "steps": [{"position": 1, "text": "Make the dressing: Combine shallot and vinegar in a small bowl, add chile flakes and beat in mustard and honey. Beat in the walnut and olive oils. Set aside."}, {"position": 2, "text": "Make the salad: In a large bowl, combine apples and kohlrabi and mix with half the dressing. Fold in brussels sprouts, Parmigiano-Reggiano, walnuts and lemon juice. Add remaining dressing and mix. Season to taste with salt and pepper."}, {"position": 3, "text": "Drop a spoonful of the ricotta on each of six plates. Top with salad, then drape a slice of ham over each portion. Alternatively, salad can be piled into a shallow bowl with spoonfuls of ricotta placed here and there and slices of ham draped over the top for guests to help themselves."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 358.6666666666667, "protein_g": 12.8, "carbohydrates_g": 24.1, "fat_g": 24.5, "saturated_fat_g": 5.2, "unsaturated_fat_g": 11.2, "trans_fat_g": 0.1, "cholesterol_mg": 29.4, "sodium_mg": 582.7, "fiber_g": 5.5, "sugar_g": 13.1, "computed_with": null}, "tags": {"cuisine": ["american"], "diet": [], "course": ["appetizer-salad"], "meal": [], "occasion": [], "other": ["brussels-sprout", "easy", "kohlrabi", "ricotta", "thanksgiving", "walnut"]}, "images": [{"url": "https://static01.nyt.com/images/2016/11/09/dining/09PAIR/09PAIR-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2016/11/09/dining/09PAIR/09PAIR-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2016/11/09/dining/09PAIR/09PAIR-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 202}, "video_url": null, "comment_count": null, "published_at": "2016-11-09", "scraped_at": "2026-09-07T00:19:23Z", "scraper_version": "1.0.0"}
{"slug": "apricot-mousse", "nyt_id": 10007, "url": "https://cooking.nytimes.com/recipes/10007-apricot-mousse", "name": "Apricot Mousse", "author": "Colette Rossant", "description": "", "servings": {"text": "8 to 10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "1 cup dried apricots", "group": null, "quantity": 1.0, "unit": "cup", "item": "dried apricots", "preparation": null, "optional": false}, {"position": 2, "raw": "1 soft bean-curd cake (see note)", "group": null, "quantity": 1.0, "unit": null, "item": "soft bean-curd cake", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ tablespoons brandy or apricot liqueur", "group": null, "quantity": 1.5, "unit": "tbsp", "item": "brandy or apricot liqueur", "preparation": null, "optional": false}, {"position": 4, "raw": "3 egg whites", "group": null, "quantity": 3.0, "unit": null, "item": "egg whites", "preparation": null, "optional": false}, {"position": 5, "raw": "24 melon balls (cantaloupe or honeydew Fresh mint for garnish)", "group": null, "quantity": 24.0, "unit": null, "item": "melon balls", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak the apricots in one cup of hot water for half an hour and drain. Drain the bean curd."}, {"position": 2, "text": "Place the bean curd, apricots and brandy in a food processor. Process until all the ingredients are pureed. Pour the mixture into a bowl and set aside."}, {"position": 3, "text": "In another bowl, beat the egg whites until they are stiff but not dry. Fold the egg whites into the bean-curd batter."}, {"position": 4, "text": "Spoon the batter into eight wine glasses or glass bowls."}, {"position": 5, "text": "Garnish with three melon balls and two fresh mint leaves. Refrigerate until ready to serve."}], "nutrition": null, "tags": {"cuisine": ["jewish"], "diet": [], "co
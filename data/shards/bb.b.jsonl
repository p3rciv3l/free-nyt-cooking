{"slug": "bbulgur-wheat-salad-tabbouleh", "nyt_id": 2016, "url": "https://cooking.nytimes.com/recipes/2016-bbulgur-wheat-salad-tabbouleh", "name": "Bbulgur Wheat Salad (Tabbouleh)", "author": "Robert Farrar Capon", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "2 hours' refrigeration"}}, "ingredients": [{"position": 1, "raw": "2 cups bulgur wheat", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "bulgur wheat", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup cold water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "cold water", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups coarse-chopped parsley leaves (without stems)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "coarse-chopped parsley leaves (without stems)", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup chopped scallions", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped scallions", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons chopped fresh mint", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh mint", "preparation": null, "optional": false}, {"position": 6, "raw": "4 medium-size fresh tomatoes, chopped", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "medium-size fresh tomatoes", "preparation": "chopped", "optional": false}, {"position": 7, "raw": "¾ cup lemon juice", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon salt, or as desired", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "or as desired", "optional": false}, {"position": 10, "raw": "½ teaspoon black pepper", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "1 teaspoon paprika", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "paprika", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Mix wheat and water in a bowl and refrigerate 1 hour."}, {"position": 2, "text": "Add all remaining ingredients except ¼ cup of the olive oil. Mix well. Refrigerate at least 1 hour."}, {"position": 3, "text": "Before serving, mix again, check seasonings and sprinkle with remaining olive oil."}], "nutrition": {"calories": 772.2, "protein_g": 11.5, "carbohydrates_g": 65.7, "fat_g": 55.7, "saturated_fat_g": 7.7, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 626.5, "fiber_g": 12.6, "sugar_g": 5.6, "unsaturated_fat_g": 46.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["middle eastern"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["mint", "summer", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 24}, "video_url": null, "comment_count": null, "published_at": "1985-06-12", "scraped_at": "2026-09-07T00:07:40.184034+00:00", "scraper_version": "1.0.0"}

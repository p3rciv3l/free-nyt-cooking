{"slug": "white-beans-polenta-roasted-tomatoes-and-garlic", "nyt_id": 11984, "url": "https://cooking.nytimes.com/recipes/11984-white-beans-polenta-roasted-tomatoes-and-garlic", "name": "White Beans, Polenta, Roasted Tomatoes and Garlic", "author": "Marian Burros", "description": "Marian Burros", "servings": {"text": "2 servings as main course", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "8 cloves garlic, peeled", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled", "optional": false}, {"position": 2, "raw": "Canola oil for greasing pan", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "canola oil for greasing pan", "preparation": null, "optional": false}, {"position": 3, "raw": "4 plum tomatoes, halved and seeded", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "plum tomatoes", "preparation": "halved and seeded", "optional": false}, {"position": 4, "raw": "6 sage leaves, chopped", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "sage leaves", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "1 cup chicken or beef stock", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chicken or beef stock", "preparation": null, "optional": false}, {"position": 6, "raw": "1 15 ½-ounce can white beans, rinsed and drained", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "15 ½-ounce can white beans", "preparation": "rinsed and drained", "optional": false}, {"position": 7, "raw": "¼ teaspoon salt (optional)", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": true}, {"position": 8, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "2 cups water", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 10, "raw": "1 tablespoon butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon milk", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "milk", "preparation": null, "optional": false}, {"position": 12, "raw": "⅛ teaspoon salt", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 13, "raw": "½ cup instant polenta", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "instant polenta", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the beans, preheat oven to 400 degrees."}, {"position": 2, "text": "Fill a small saucepan with enough water to cover the garlic. When water boils add garlic and cook one minute. Drain and repeat this procedure three times -- it will eliminate the harshness and leave the flavor. Mash the garlic with garlic press; set aside."}, {"position": 3, "text": "Lightly oil a roasting pan and place tomatoes in pan. Roast 10 to 15 minutes, turning once, until juice is released and skins have puckered. When tomatoes are ready, peel and add to pot large enough to hold all the ingredients for the beans."}, {"position": 4, "text": "Add the garlic, sage, stock and beans. Simmer until mixture is thick and most of the liquid has evaporated. Season with salt if desired and pepper."}, {"position": 5, "text": "To make the polenta meanwhile, boil water in small pot with the butter, milk and salt."}, {"position": 6, "text": "When water boils, reduce heat slightly and slowly whisk in polenta. Reduce heat to very low and cook the polenta 3 to 5 minutes, stirring frequently."}, {"position": 7, "text": "To serve, spoon polenta into a shallow bowl or plate and spoon bean sauce over top."}], "nutrition": {"calories": 642.4, "protein_g": 24.5, "carbohydrates_g": 94.4, "fat_g": 20.0, "saturated_fat_g": 5.4, "trans_fat_g": 0.0, "cholesterol_mg": 19.6, "sodium_mg": 1380.4, "fiber_g": 15.6, "sugar_g": 7.0, "unsaturated_fat_g": 13.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["beans", "braise", "for two", "garlic", "plum tomato", "polenta", "white bean"]}, "images": [], "rating": {"average": 4.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "1991-02-06", "scraped_at": "2026-09-06T23:52:11.058668+00:00", "scraper_version": "1.0.0"}

{"slug": "wheat-berry-and-orzo-salad-with-orange-vinaigrette", "nyt_id": 10837, "url": "https://cooking.nytimes.com/recipes/10837-wheat-berry-and-orzo-salad-with-orange-vinaigrette", "name": "Wheat Berry and Orzo Salad With Orange Vinaigrette", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 cup orzo", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "orzo", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup wheat berries", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "wheat berries", "preparation": null, "optional": false}, {"position": 3, "raw": "2 oranges", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "oranges", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup freshly squeezed orange juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "freshly squeezed orange juice", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup extra-virgin olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons champagne vinegar (or more to taste)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "champagne vinegar (or more to taste)", "preparation": null, "optional": false}, {"position": 7, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons toasted pine nuts", "group": null, "quantity": 3.0, "quantity_max": null, "u
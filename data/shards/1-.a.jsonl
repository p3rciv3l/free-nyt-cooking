{"slug": "1-2-3-4-cake", "nyt_id": 1015491, "url": "https://cooking.nytimes.com/recipes/1015491-1-2-3-4-cake", "name": "1-2-3-4 Cake", "author": "Emily Weinstein", "description": "Emily Weinstein", "servings": {"text": "1 nine-inch, two-layer cake", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "4 eggs, separated", "group": null, "quantity": 4.0, "unit": null, "item": "eggs", "preparation": "separated", "optional": false}, {"position": 2, "raw": "1 cup milk", "group": null, "quantity": 1.0, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 3, "raw": "3 cups cake flour (sift and then measure)", "group": null, "quantity": 3.0, "unit": "cup", "item": "cake flour", "preparation": null, "optional": false}, {"position": 4, "raw": "4 teaspoons baking powder", "group": null, "quantity": 4.0, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 cup (2 sticks) unsweetened butter, softened", "group": null, "quantity": 1.0, "unit": "cup", "item": "unsweetened butter", "preparation": "softened", "optional": false}, {"position": 7, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon vanilla", "group": null, "quantity": 1.0, "unit": "tsp", "item": "vanilla", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Butter two 9-inch baking pans and line the bottom of each with parchment paper. Butter the paper and dust the pans with flour, tapping out the excess."}, {"position": 2, "text": "Stir baking powder and salt into cake flour."}, {"position": 3, "text": "In another bowl, beat butter and sugar until light and fluffy. Beat in the four egg yolks one at a time. Add the vanilla to the mixture."}, {"position": 4, "text": "Add the flour mixture and milk alternately, starting and ending with one third of the flour. Stir just until the flour is incorporated."}, {"position": 5, "text": "In another bowl, whisk egg whites to soft peaks. Stir one third of the egg whites into the batter, then gently fold in the rest. Pour the batter into the prepared pans and bake until a toothpick inserted into the center comes out clean, 30 to 40 minutes."}, {"position": 6, "text": "Hint: Whisk the egg whites first in the mixer and put the stiff egg whites on a plate. Then beat the sugar and butter in the same bowl."}], "nutrition": null, "tags": {"cuisine": [], "diet": [], "course": ["dessert-dinner-lunch"], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://static01.nyt.com/images/2014/06/01/dining/1-2-3-4-Cake/1-2-3-4-Cake-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/06/01/dining/1-2-3-4-Cake/1-2-3-4-Cake-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 544}, "video_url": null, "comment_count": null, "published_at": "2009-05-22", "scraped_at": "2026-09-07T02:47:24Z", "scraper_version": "1.0.0"}

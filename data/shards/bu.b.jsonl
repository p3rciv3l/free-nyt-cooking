{"slug": "buche-de-noel-christmas-yule-log", "nyt_id": 10478, "url": "https://cooking.nytimes.com/recipes/10478-buche-de-noel-christmas-yule-log", "name": "Bûche de Noël (Christmas yule log)", "author": "Moira Hodgson", "description": "", "servings": {"text": "Eight servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes, plus at least 1 hour's refrigeration"}}, "ingredients": [{"position": 1, "raw": "3 whole eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "whole eggs", "preparation": null, "optional": false}, {"position": 2, "raw": "2 egg yolks", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup flour", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup corn syrup", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "corn syrup", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup Grand Marnier", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "grand marnier", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup water", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 8, "raw": "¾ cup sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 9, "raw": "¾ cup water", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 10, "raw": "16 egg yolks", "group": null, "quantity": 16.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 11, "raw": "4 sticks of unsalted butter, or one pound", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "stick", "item": "of unsalted butter", "preparation": "or one pound", "optional": false}, {"position": 12, "raw": "⅓ cup Grand Marnier", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "grand marnier", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 375 degrees."}, {"position": 2, "text": "Put the eggs, egg yolks and sugar in a mixing bowl. Set the bowl over a pot of boiling water. Beat the eggs and sugar together until the sugar dissolves. This will result in a cake with a finer texture. Remove the bowl from the heat."}, {"position": 3, "text": "With a mixer at high speed, beat for 15 minutes until the mixture is very pale."}, {"position": 4, "text": "Sift the flour, and fold into the egg mixture. Stop mixing as soon as all ingredients are well blended."}, {"position": 5, "text": "Line an 11-inch-by-16-inch jellyroll pan with wax paper, and butter and flour the paper. Spread the mixture over the wax paper. Place on a baking sheet and bake for 10 to 12 minutes, or until the cake shrinks slightly from the sides of the pan."}, {"position": 6, "text": "When it is done, remove the cake from the baking sheet and turn it upside down onto a flat surface that has been covered with wax paper or parchment. Cover the cake with a damp cloth and let it cool. This will keep it flexible enough to roll."}, {"position": 7, "text": "To make the dessert syrup, combine the corn syrup, Grand Marnier and water. Mix thoroughly."}, {"position": 8, "text": "To make the butter cream, simmer the sugar with the water in a small saucepan until it reaches 250 degrees on a kitchen thermometer."}, {"position": 9, "text": "Meanwhile, beat the egg yolks at medium speed in a mixing bowl. Then add the boiling sugar little by little. Continue beating until the mixture is cool, about three to five minutes."}, {"position": 10, "text": "Add the butter and continue to whip the mixture at low speed for seven minutes. Then add Grand Marnier."}, {"position": 11, "text": "With a pastry brush, brush the dessert syrup on the side of the cake to which the paper was attached. Spread three-quarter of the butter cream over the surface of the cake. Roll the cake very tightly and refrigerate for one hour."}, {"position": 12, "text": "To decorate, cut two one-inch slices off one end of the cake. Place them on the log to simulate two sawed-off branches. With a pastry bag fitted with a star-shaped nozzle, cover the top of the log with the reserved butter cream. Refrigerate until ready to serve."}], "nutrition": {"calories": 847.7, "protein_g": 8.5, "carbohydrates_g": 74.2, "fat_g": 55.6, "saturated_fat_g": 31.9, "trans_fat_g": 0.0, "cholesterol_mg": 508.7, "sodium_mg": 72.0, "fiber_g": 0.3, "sugar_g": 64.2, "unsaturated_fat_g": 20.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["bake", "boil", "egg", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 365}, "video_url": null, "comment_count": null, "published_at": "1982-10-24", "scraped_at": "2026-09-06T22:25:30.286598+00:00", "scraper_version": "1.0.0"}

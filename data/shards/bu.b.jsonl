on": null, "optional": false}, {"position": 9, "raw": "1 ½ cups fine bulgur", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "fine bulgur", "preparation": null, "optional": false}, {"position": 10, "raw": "½ pound feta (preferably French), drained and crumbled", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "feta (preferably french)", "preparation": "drained and crumbled", "optional": false}, {"position": 11, "raw": "¼ teaspoon ground sumac", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "ground sumac", "preparation": null, "optional": false}, {"position": 12, "raw": "½ teaspoon Aleppo chilies", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "aleppo chilies", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons finely chopped flat-leaf parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped flat-leaf parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 375 degrees. Cut the squash in half lengthwise, scrape out the seeds and bake, flesh side down, on a cookie sheet until tender, about 45 minutes. Let cool slightly, scrape out the flesh, then purée in a food processor until smooth. Season with salt and pepper."}, {"position": 2, "text": "Simmer the butter in a small saucepan over medium-low heat until nut brown, about 10 minutes. Strain through a fine-mesh sieve and set aside."}, {"position": 3, "text": "Heat the olive oil in a large saucepan over medium-high heat and sauté the onion and pepper until tender, stirring occasionally, about 5 minutes. Stir in the paprika and 1 teaspoon of baharat, followed by 2 cups of the squash. Bring to a simmer. Stir in the bulgur and remove from the heat. Cover tightly for 15 minutes. Season to taste with salt and pepper and stir in the brown butter."}, {"position": 4, "text": "Stir together the feta, the remaining baharat, sumac, chilies and parsley, making the mixture as creamy as possible. Season with salt and pepper."}, {"position": 5, "text": "Fill 8 ½-cup ramekins each with a scant ½ cup of the bulgur mixture. With your fingers, compress the bulgur to form a large well in the center of each (the bulgur will creep up the sides). Fill each well with 2 heaping teaspoons of feta and use the displaced bulgur to seal in the cheese. Set the ramekins on a cookie sheet and bake until hot, about 15 minutes. Run a sharp knife around the inside of the ramekins, unmold the kibbeh and serve immediately."}], "nutrition": {"calories": 367.6, "protein_g": 9.6, "carbohydrates_g": 44.6, "fat_g": 19.2, "saturated_fat_g": 9.0, "trans_fat_g": 0.2, "cholesterol_mg": 40.5, "sodium_mg": 652.0, "fiber_g": 7.8, "sugar_g": 6.4, "unsaturated_fat_g": 9.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["middle eastern"], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["butternut squash", "fall", "feta", "roast", "saute"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/30/dining/Butternut-Squash-Kibbeh/Butternut-Squash-Kibbeh-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 70}, "video_url": null, "comment_count": null, "published_at": "2006-11-05", "scraped_at": "2026-09-06T23:02:14.847070+00:00", "scraper_version": "1.0.0"}

 "bulgur", "easy", "prosciutto", "salad", "spring"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1993-07-18", "scraped_at": "2026-09-06T22:30:14.465396+00:00", "scraper_version": "1.0.0"}
{"slug": "bulgur-wheat-and-lentil-pilaf", "nyt_id": 11805, "url": "https://cooking.nytimes.com/recipes/11805-bulgur-wheat-and-lentil-pilaf", "name": "Bulgur Wheat And Lentil Pilaf", "author": "Robert Farrar Capon", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 cup brown lentils", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "brown lentils", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups water", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups chicken stock, preferably homemade", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": "preferably homemade", "optional": false}, {"position": 4, "raw": "1 cup bulgur wheat", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "bulgur wheat", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "1 large Spanish onion, coarsely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large spanish onion", "preparation": "coarsely chopped", "optional": false}, {"position": 8, "raw": "Black pepper and additional salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "black pepper and additional salt to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Wash and pick over the lentils. Place them in a saucepan with the water, bring to a boil, lower the heat and simmer for 10 minutes. Drain the lentils immediately and set them aside."}, {"position": 2, "text": "Put the chicken stock in the saucepan, bring to a boil, add the bulgur wheat, salt and drained lentils and bring to a boil again. Lower the heat and simmer, covered, for 20 minutes, or until the liquid is absorbed."}, {"position": 3, "text": "Meanwhile, heat the olive oil over low heat in a large, preheated skillet. Add the chopped onion and cook, stirring often, for about 20 minutes, or until golden brown. Add the bulgur-lentil mixture to the skillet and toss gently to combine. Season to taste with salt and pepper. Serve with a green salad."}], "nutrition": {"calories": 312.7, "protein_g": 13.1, "carbohydrates_g": 43.6, "fat_g": 10.7, "saturated_fat_g": 1.6, "trans_fat_g": 0.0, "cholesterol_mg": 2.4, "sodium_mg": 512.8, "fiber_g": 7.0, "sugar_g": 3.1, "unsaturated_fat_g": 8.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "easy", "five ingredient", "lentil"]}, "images": [], "rating": {"average": 4.0, "count": 31}, "video_url": null, "comment_count": null, "published_at": "1992-10-04", "scraped_at": "2026-09-06T23:50:06.373411+00:00", "scraper_version": "1.0.0"}
{"slug": "butternut-squash-and-cider-soup", "nyt_id": 11060, "url": "https://cooking.nytimes.com/recipes/11060-butternut-squash-and-cider-soup", "name": "Butternut Squash And Cider Soup", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "1 shallot, peeled and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "shallot", "preparation": "peeled and minced", "optional": false}, {"position": 2, "raw": "1 clove garlic, peeled and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and minced", "optional": false}, {"position": 3, "raw": "¼ cup water", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 4, "raw": "3 cups peeled, seeded and cubed butternut squash", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "peeled", "preparation": "seeded and cubed butternut squash", "optional": false}, {"position": 5, "raw": "½ cup chicken broth, homemade or low-sodium canned", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": "homemade or low-sodium canned", "optional": false}, {"position": 6, "raw": "¾ cup apple cider", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "apple cider", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup light sour cream", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "light sour cream", "preparation": null, "optional": false}, {"position": 8, "raw": "½ teaspoon salt, plus more to taste", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 9, "raw": "½ unpeeled red Rome or Delicious apple, cored and finely diced", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "unpeeled red rome or delicious apple", "preparation": "cored and finely diced", "optional": false}, {"position": 10, "raw": "Cracked black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "cracked black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat a medium-size saucepan over low heat. Add the shallot, garlic and water. Cook until the shallot and garlic are softened, being careful not to let them burn, about 2 minutes. Add the squash and the chicken broth and bring to a boil. Reduce the heat, cover and simmer until the squash is soft, about 20 minutes."}, {"position": 2, "text": "Carefully pour the mixture into a blender jar. Holding the top down with a towel, blend until smooth. Add the cider, light sour cream and salt. Continue blending until well combined. Soup can be made ahead up to this point. Place in a clean saucepan over low heat until heated through. Season with additional salt if needed."}, {"position": 3, "text": "Ladle the soup among 4 bowls. Garnish with the diced red apple and cracked black pepper. Serve immediately."}], "nutrition": {"calories": 124.5, "protein_g": 2.9, "carbohydrates_g": 26.0, "fat_g": 2.1, "saturated_fat_g": 1.1, "trans_fat_g": 0.0, "cholesterol_mg": 5.9, "sodium_mg": 354.8, "fiber_g": 3.4, "sugar_g": 10.8, "unsaturated_fat_g": 0.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["appetizer", "main course"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["apple cider", "boil", "butternut squash", "fall", "great leftovers", "soup"]}, "images": [], "rating": {"average": 4.0, "count": 84}, "video_url": null, "comment_count": null, "published_at": "1993-08-29", "scraped_at": "2026-09-06T22:35:41.928699+00:00", "scraper_version": "1.0.0"}

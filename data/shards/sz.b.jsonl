{"slug": "szekelygulyas-sauerkraut-goulash", "nyt_id": 7451, "url": "https://cooking.nytimes.com/recipes/7451-szekelygulyas-sauerkraut-goulash", "name": "Szekelygulyas (Sauerkraut Goulash)", "author": "R. W. Apple Jr.", "description": "R. W. Apple Jr.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 165, "total_minutes": 165, "raw": {"cook": "2 hours 45 minutes", "total": "2 hours 45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons vegetable oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 2, "raw": "⅓ cup finely chopped onion", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "finely chopped onion", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup sweet Hungarian paprika", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "sweet hungarian paprika", "preparation": null, "optional": false}, {"position": 4, "raw": "Pinch of hot Hungarian paprika, or cayenne", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of hot hungarian paprika", "preparation": "or cayenne", "optional": false}, {"position": 5, "raw": "1 ½ pounds boneless pork shoulder, cut into ½-inch cubes", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "boneless pork shoulder", "preparation": "cut into ½-inch cubes", "optional": false}, {"position": 6, "raw": "1 clove garlic, peeled and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and minced", "optional": false}, {"position": 7, "raw": "½ teaspoon caraway seeds", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "caraway seeds", "preparation": null, "optional": false}, {"position": 8, "raw": "½ teaspoon minced fresh dill", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "minced fresh dill", "preparation": null, "optional": false}, {"position": 9, "raw": "½ Italian frying pepper, finely chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "italian frying pepper", "preparation": "finely chopped", "optional": false}, {"position": 10, "raw": "½ ripe tomato, finely chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "ripe tomato", "preparation": "finely chopped", "optional": false}, {"position": 11, "raw": "3 pounds packaged (refrigerated, not canned) sauerkraut, rinsed and well drained", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "packaged (refrigerated", "preparation": "not canned) sauerkraut, rinsed and well drained", "optional": false}, {"position": 12, "raw": "1 ½ cups sour cream", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 13, "raw": "1 ½ cups heavy cream", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 14, "raw": "1 ½ tablespoons all-purpose flour", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "all-purpose flour", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oil in a 4- to 6-quart saucepan or casserole over medium heat. Add onion and saute until translucent, about 3 minutes. Remove pan from heat, and add 2 tablespoons water and the sweet paprika and hot paprika. Place pan over low heat, and saute 3 minutes. Add pork, garlic, caraway seeds, dill and 2 more tablespoons water. Cover, and cook until pork is tender, about 1 hour, stirring occasionally and adding a tablespoon or two of water if it seems too dry."}, {"position": 2, "text": "Add chopped pepper and tomato to pan. Cover, and cook over low heat for 10 minutes. Uncover and cook, stirring occasionally, until most of the liquid has evaporated. Add sauerkraut and toss gently to combine. Cover and cook over low heat, stirring occasionally, for an additional hour."}, {"position": 3, "text": "Combine sour cream and heavy cream and mix well. Transfer half the mixture to a serving bowl, and refrigerate until needed. Add flour to the remainder, and stir until smooth. Add to pan. Cover and continue to cooking, stirring occasionally, for 15 to 20 minutes. Garnish with a dollop of the reserved sour cream mixture, and pass the remainder separately."}], "nutrition": {"calories": 695.8, "protein_g": 25.8, "carbohydrates_g": 19.7, "fat_g": 58.7, "saturated_fat_g": 27.1, "unsaturated_fat_g": null, "trans_fat_g": 1.2, "cholesterol_mg": 181.7, "sodium_mg": 1611.0, "fiber_g": 8.7, "sugar_g": 9.0, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": ["eastern european"], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["braise", "great leftovers", "pork", "sauerkraut", "saute", "stew"]}, "images": [], "rating": {"average": 5.0, "count": 102}, "video_url": null, "comment_count": null, "published_at": "1999-04-28", "scraped_at": "2026-09-07T09:58:43.704248+00:00", "scraper_version": "1.0.0"}

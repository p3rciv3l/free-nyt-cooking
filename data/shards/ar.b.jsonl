{"slug": "artichoke-salad-with-mushrooms", "nyt_id": 11681, "url": "https://cooking.nytimes.com/recipes/11681-artichoke-salad-with-mushrooms", "name": "Artichoke Salad With Mushrooms", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 40, "cook_minutes": 20, "total_minutes": 60, "raw": {"total": "1 hour", "prep": "40 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 lemons", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "lemons", "preparation": null, "optional": false}, {"position": 2, "raw": "4 large artichokes", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large artichokes", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup extra virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons shallots", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "shallots", "preparation": null, "optional": false}, {"position": 5, "raw": "1 bunch arugula", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "arugula", "preparation": null, "optional": false}, {"position": 6, "raw": "1 head bibb lettuce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "bibb lettuce", "preparation": null, "optional": false}, {"position": 7, "raw": "½ pound shiitake mushrooms (or cultivated mushrooms) sliced", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "shiitake mushrooms (or cultivated mushrooms) sliced", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup white wine vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "white wine vinegar", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup shaved Parmesan cheese", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "shaved parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Squeeze the lemons into a bowl and add 2 cups of water."}, {"position": 2, "text": "Trim the artichokes down to the fleshy bottoms by slicing off the stem, pulling off all the leaves and cutting away the fuzzy choke. Trim the artichoke bottom. Slice the bottom's vertically about ¼ inch thick and place them in a bowl of lemon-water."}, {"position": 3, "text": "Heat 2 tablespoons of the oil in a large skillet, add the shallots and saute until they become translucent. Drain the artichokes and add them along with a few tablespoons of the lemon water. Cover and cook until the artichokes are tender, about 15 minutes. Remove from the pan."}, {"position": 4, "text": "While the artichokes are cooking, thoroughly rinse the arugula and lettuce. Dry them. Remove stems from the arugula and tear the lettuce into bite-size pieces. Place in a bowl."}, {"position": 5, "text": "After the artichokes have been removed from the pan add another tablespoon of the oil and increase the heat in the pan and cook until any water has evaporated. Add the mushrooms and saute over high heat until they have wilted, about 5 minutes. Remove from heat and return the artichokes to the pan. Set aside."}, {"position": 6, "text": "Beat the vinegar with the mustard. Beat in the remaining oil. Season with salt and pepper. Toss the arugula and lettuce with about ⅓ of t
{"slug": "arugula-and-watercress-salad", "nyt_id": 10503, "url": "https://cooking.nytimes.com/recipes/10503-arugula-and-watercress-salad", "name": "Arugula and Watercress Salad", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "4 cups fresh arugula leaves, loosely packed", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "fresh arugula leaves", "preparation": "loosely packed", "optional": false}, {"position": 2, "raw": "2 cups fresh watercress leaves, loosely packed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "fresh watercress leaves", "preparation": "loosely packed", "optional": false}, {"position": 3, "raw": "1 tablespoon imported mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "imported mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon red wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "5 tablespoons corn, peanut or vegetable oil", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "corn", "preparation": "peanut or vegetable oil", "optional": false}, {"position": 6, "raw": "½ teaspoon finely minced garlic", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons finely chopped parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped parsley", "preparation": null, "optional": false}, {"position": 8, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max":
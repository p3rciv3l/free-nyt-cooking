ation": null, "optional": false}, {"position": 9, "raw": "1 sprig thyme", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "thyme", "preparation": null, "optional": false}, {"position": 10, "raw": "10 black peppercorns", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "black peppercorns", "preparation": null, "optional": false}, {"position": 11, "raw": "1 quart chicken stock, homemade or low-sodium", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "quart", "item": "chicken stock", "preparation": "homemade or low-sodium", "optional": false}, {"position": 12, "raw": "2 cups water", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ cup grapeseed oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "grapeseed oil", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ cup extra-virgin olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 15, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper to taste", "preparation": null, "optional": false}, {"position": 16, "raw": "1 bunch arugula, rinsed, stems removed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "arugula", "preparation": "rinsed, stems removed", "optional": false}, {"position": 17, "raw": "1 head frisee, rinsed, stems removed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "frisee", "preparation": "rinsed, stems removed", "optional": false}, {"position": 18, "raw": "¼ pound ricotta salata cheese, thinly sliced or shaved", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "ricotta salata cheese", "preparation": "thinly sliced or shaved", "optional": false}, {"position": 19, "raw": "¼ cup toasted green pumpkin seeds", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "toasted green pumpkin seeds", "preparation": null, "optional": false}, {"position": 20, "raw": "¼ cup pumpkin-seed oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "pumpkin-seed oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Slice the top ⅓ off each artichoke. Remove the outer leaves and rub the artichoke with lemon."}, {"position": 2, "text": "Heat the oil in a pot, and saute the garlic for 5 minutes or until golden. Add the wine and vinegar and bring to a low boil for 10 minutes, until it is reduced by half. Add the herbs, peppercorns, stock and water. Add the artichokes, bring them to a boil and simmer until tender, about 30 minutes. Remove the artichokes and cool."}, {"position": 3, "text": "Strain the braising liquid, discarding the garlic and herbs, and measure 2 cups. Pour the liquid in a small saucepan and simmer until reduced to ½ cup, about 15 minutes. Set aside to cool."}, {"position": 4, "text": "Remove the cooked artichokes' leaves, scoop out the chokes and slice each heart into 8 pieces."}, {"position": 5, "text": "Put the reduced braising liquid in a blender on low, and drizzle in the oils. Season to taste."}, {"position": 6, "text": "Toss the arugula, frisee and artichoke hearts with the vinaigrette. Divide among 6 plates. Arrange the cheese on top and sprinkle with the pumpkin seeds. Drizzle the pumpkin-seed oil around the perimeter and serve."}], "nutrition": {"calories": 594.3, "protein_g": 16.2, "carbohydrates_g": 29.9, "fat_g": 43.4, "saturated_fat_g": 8.2, "trans_fat_g": 0.0, "cholesterol_mg": 23.5, "sodium_mg": 1266.2, "fiber_g": 7.8, "sugar_g": 5.5, "unsaturated_fat_g": 33.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "cour
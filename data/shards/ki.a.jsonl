{"slug": "kidney-bean-red-onion-and-tomato-salad", "nyt_id": 10076, "url": "https://cooking.nytimes.com/recipes/10076-kidney-bean-red-onion-and-tomato-salad", "name": "Kidney Bean, Red Onion And Tomato Salad", "author": "Nigella Lawson", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "PT10M"}}, "ingredients": [{"position": 1, "raw": "½ red onion, thinly sliced", "group": null, "quantity": 0.5, "unit": null, "item": "red onion", "preparation": "thinly sliced", "optional": false}, {"position": 2, "raw": "2 tablespoons high-quality red wine vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "high-quality red wine vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups small, sweet cherry tomatoes", "group": null, "quantity": 2.0, "unit": "cup", "item": "small", "preparation": "sweet cherry tomatoes", "optional": false}, {"position": 4, "raw": "1 teaspoon fine sea salt, more as needed", "group": null, "quantity": 1.0, "unit": "tsp", "item": "fine sea salt", "preparation": "more as needed", "optional": false}, {"position": 5, "raw": "3 14-ounce cans red kidney beans, rinsed and drained", "group": null, "quantity": 17.0, "unit": null, "item": "ounce cans red kidney beans", "preparation": "rinsed and drained", "optional": false}, {"position": 6, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a small bowl, combine onions and vinegar. Set aside to macerate while preparing rest of salad, or up to three hours."}, {"position": 2, "text": "Halve cherry tomatoes and place in a serving bowl. Sprinkle with 1 teaspoon salt. Add kidney beans, onion mixture and olive oil. Toss gently to mix, adjust salt to taste, and serve."}], "nutrition": {"
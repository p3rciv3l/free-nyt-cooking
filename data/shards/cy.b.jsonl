{"slug": "cyruss-express-bread-and-butter-pudding", "nyt_id": 6888, "url": "https://cooking.nytimes.com/recipes/6888-cyruss-express-bread-and-butter-pudding", "name": "Cyrus's Express Bread-And-Butter Pudding", "author": "Jonathan Reynolds", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "11 slices white bread", "group": null, "quantity": 11.0, "quantity_max": null, "unit": "slice", "item": "white bread", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup melted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "melted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "¾ cup diced mixed fruit", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "diced mixed fruit", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ tablespoons whole charoli nuts or finely chopped pistachios", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "whole charoli nuts or finely chopped pistachios", "preparation": null, "optional": false}, {"position": 5, "raw": "15 almonds, skins on, very finely chopped", "group": null, "quantity": 15.0, "quantity_max": null, "unit": null, "item": "almonds", "preparation": "skins on, very finely chopped", "optional": false}, {"position": 6, "raw": "2 12-ounce cans evaporated milk", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "12-ounce cans evaporated milk", "preparation": null, "optional": false}, {"position": 7, "raw": "1 14-ounce can sweetened condensed milk", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "14-ounce can sweetened condensed milk", "preparation": null, "optional": false}, {"position": 8, "raw": "6 large eggs", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 9, "raw": "7 tablespoons sugar", "group": null, "quantity": 7.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 10, "raw": "1 teaspoon cardamom powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cardamom powder", "preparation": null, "optional": false}, {"position": 11, "raw": "¾ teaspoon grated nutmeg", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "grated nutmeg", "preparation": null, "optional": false}, {"position": 12, "raw": "1 teaspoon rose water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "rose water", "preparation": null, "optional": false}, {"position": 13, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 375 degrees. Generously brush each slice of bread on both sides with butter. Cut each slice into two triangles. Brush a 13-by-9-inch baking dish with butter and lay the bread in, overlapping the slices. Sprinkle with fruit, working a little between slices, and sprinkle with nuts."}, {"position": 2, "text": "Combine milks and whisk in the eggs until very smooth. Whisk in sugar, cardamom, nutmeg, rose water and vanilla. Pour over the bread, up to ½ inch from the rim."}, {"position": 3, "text": "Place the dish in a bain-marie and pour in ⅓-inch of boiling water. Bake for 1 hour (add more water if necessary) or until a knife inserted comes out clean. If the pudding is not golden and crisp on top, place under the broiler to brown. Serve warm or cold."}], "nutrition": {"calories": 714.5, "protein_g": 19.8, "carbohydrates_g": 68.6, "fat_g": 41.2, "saturated_fat_g": 22.7, "trans_fat_g": 0.0, "cholesterol
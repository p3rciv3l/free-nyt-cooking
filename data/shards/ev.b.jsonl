{"slug": "eves-pudding", "nyt_id": 8313, "url": "https://cooking.nytimes.com/recipes/8313-eves-pudding", "name": "Eve's Pudding", "author": "William Norwich", "description": "", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 90, "total_minutes": 90, "raw": {"cook": "1 hour 30 minutes", "total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "12 tablespoons unsalted butter", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup brown sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "6 firm, ripe plums (or pears, nectarines or peaches)", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "firm", "preparation": "ripe plums (or pears, nectarines or peaches)", "optional": false}, {"position": 4, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 6, "raw": "2 eggs, separated", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "separated", "optional": false}, {"position": 7, "raw": "1 ¾ cups all-purpose flour", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons baking powder", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup milk", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 350 degrees."}, {"position": 2, "text": "Melt 4 tablespoons of butter with the brown sugar, and pour into a 10-inch round cake pan. Coat the bottom of the pan evenly with the mixture. Quarter the plums and arrange them neatly to cover the bottom of the pan."}, {"position": 3, "text": "Cream the remaining butter with the sugar until pale and fluffy. Add the vanilla extract, and beat in the egg yolks one at a time."}, {"position": 4, "text": "Sift together the flour, baking powder and salt, and add them to the batter alternately with the milk, beginning and ending with the dry ingredients. Whisk the egg whites until they hold a slight shape. Fold the egg whites into the batter a third at a time until incorporated. Pour the batter into the prepared pan, and spread it evenly over the plums. Bake for 45 to 55 minutes, until the top is browned and a cake tester inserted in the center comes out clean. Let the cake cool for 20 minutes, and then turn over onto a cake plate. Serve with whipped cream."}], "nutrition": {"calories": 297.0, "protein_g": 3.3, "carbohydrates_g": 43.8, "fat_g": 12.6, "saturated_fat_g": 7.5, "unsaturated_fat_g": null, "trans_fat_g": 0.0, "cholesterol_mg": 57.7, "sodium_mg": 174.5, "fiber_g": 1.0, "sugar_g": 29.1, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": [], "diet": [], "course": ["dessert", "side dish"], "meal": [], "occasion": ["valentine’s day"], "other": ["bake", "butter", "fall", "plum", "sugar"]}, "images": [], "rating": {"average": 4.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "2000-08-20", "scraped_at": "2026-09-07T10:36:41.326580+00:00", "scraper_version": "1.0.0"}

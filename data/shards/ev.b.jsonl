{"slug": "eva-bones-sour-cream-pound-cake-with-strawberries", "nyt_id": 8693, "url": "https://cooking.nytimes.com/recipes/8693-eva-bones-sour-cream-pound-cake-with-strawberries", "name": "Eva Bone's Sour-Cream Pound Cake With Strawberries", "author": "Molly O’Neill", "description": "", "servings": {"text": "16 servings", "min": 16, "max": 16, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 120, "total_minutes": 120, "raw": {"cook": "2 hours", "total": "2 hours"}}, "ingredients": [{"position": 1, "raw": "1 cup unsalted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 2, "raw": "3 cups sugar, plus more for sweetening the strawberries", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": "plus more for sweetening the strawberries", "optional": false}, {"position": 3, "raw": "6 large eggs, separated", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "separated", "optional": false}, {"position": 4, "raw": "3 cups all-purpose flour", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon baking soda", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup sour cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon almond extract", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "almond extract", "preparation": null, "optional": false}, {"position": 10, "raw": "2 quarts strawberries, hulled and thinly sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "quart", "item": "strawberries", "preparation": "hulled and thinly sliced", "optional": false}, {"position": 11, "raw": "Sweetened whipped cream for serving", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sweetened whipped cream for serving", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 325 degrees. In the bowl of an electric mixer, cream the butter and 2 cups of the sugar. Add the egg yolks 1 at a time, beating well after each addition. Sift together the flour, soda and salt. Sift again. Stir the flour mixture into the bowl in 3 additions, alternating with additions of sour cream. Stir in the vanilla and almond extracts."}, {"position": 2, "text": "In another bowl, beat the egg whites and last cup of sugar until the mixture holds stiff peaks. Gently fold the egg whites into the batter. Grease and flour an angel-food cake pan and scrape the batter into it. Bake until the cake is golden and a cake tester or wooden skewer inserted into the cake comes out clean, 1 to 1 ½ hours. Cool the cake in the pan for 10 minutes. Run a thin-bladed knife around the edge of the pan and invert onto a rack to cool."}, {"position": 3, "text": "Meanwhile, combine the strawberries and sugar to taste in a bowl and refrigerate for at least an hour. When ready to serve, slice the cake and top each serving with strawberries and whipped cream."}], "nutrition": {"calories": 284.8, "protein_g": 6.1, "carbohydrates_g": 28.0, "fat_g": 17.0, "saturated_fat_g": 9.5, "unsaturated_fat_g": null, "trans_fat_g": 0.1, "cholesterol_mg": 109.8, "sodium_mg": 90.5, "fiber_g": 3.0, "sugar_g": 6.6, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "sour cream", "spring", "strawberry", "sugar"]}, "images": [], "rating": {"average": 4.0, "count": 34}, "video_url": null, "comment_count": null, "published_at": "1999-05-23", "scraped_at": "2026-09-07T10:52:27.252841+00:00", "scraper_version": "1.0.0"}
{"slug": "evelyn-patouts-preserved-kumquats", "nyt_id": 1745, "url": "https://cooking.nytimes.com/recipes/1745-evelyn-patouts-preserved-kumquats", "name": "Evelyn Patout's Preserved Kumquats", "author": "Julia Reed", "description": "", "servings": {"text": "2 1/2 quarts", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes, plus 4 day's sitting"}}, "ingredients": [{"position": 1, "raw": "1 quart kumquats", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "quart", "item": "kumquats", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ cups light corn syrup", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "light corn syrup", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Scrub kumquats thoroughly. Prick each several times with a large needle or poultry pin. Put them in a large saucepan, add water to cover, bring to a boil, lower heat and simmer uncovered for 10 minutes. Drain."}, {"position": 2, "text": "Combine the sugar and 3 cups of water in a large saucepan. Boil for 5 minutes. Add kumquats and boil again. Remove from heat and set aside, covered, overnight. The next morning, add ½ cup corn syrup. Bring to a boil, remove from heat, cover and let stand overnight again. Repeat the process twice more."}, {"position": 3, "text": "On the fourth morning, after the kumquats have been brought to boil, spoon them into hot, sterilized, Mason-type jars. Pour in hot syrup to within ¼ inch of the top of each jar and seal. Refrigerate until ready to give or seal in a hot-water bath according to jar manufacturer's directions and store."}], "nutrition": {"calories": 201.8, "protein_g": 0.9, "carbohydrates_g": 52.0, "fat_g": 0.5, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 22.8, "fiber_g": 3.2, "sugar_g": 48.7, "unsaturated_fat_g": 0.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegan", "vegetarian"], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["boil", "corn syrup", "project", "sugar", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 23}, "video_url": null, "comment_count": null, "published_at": "2002-12-15", "scraped_at": "2026-09-07T03:48:48.743876+00:00", "scraper_version": "1.0.0"}
{"slug": "evelyn-trapidos-gefilte-fish-goes-hawaiian", "nyt_id": 12054, "url": "https://cooking.nytimes.com/recipes/12054-evelyn-trapidos-gefilte-fish-goes-hawaiian", "name": "Evelyn Trapido's Gefilte Fish Goes Hawaiian", "author": "Horacio Silva", "description": "", "servings": {"text": "Makes about 30 pieces", "min": 30, "max": 30, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "3 medium onions, peeled", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "medium onions", "preparation": "peeled", "optional": false}, {"position": 2, "raw": "2 carrots, peeled and sliced into ¼-inch rounds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "carrots", "preparation": "peeled and sliced into ¼-inch rounds", "optional": false}, {"position": 3, "raw": "2 ½ pounds red snapper, black sea bass, scaled (reserve the head, bones and skin for the broth)", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "lb", "item": "red snapper", "preparation": "black sea bass, scaled (reserve the head, bones and skin for the broth)", "optional": false}, {"position": 4, "raw": "12 ounces mahi-mahi fillet", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "mahi-mahi fillet", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon salt, plus ½ teaspoon", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "salt", "preparation": "plus ½ teaspoon", "optional": false}, {"position": 6, "raw": "2 ¼ teaspoons pepper", "group": null, "quantity": 2.25, "quantity_max": null, "unit": "tsp", "item": "pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon cinnamon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "cinnamon", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ teaspoons vegetable oil", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 9, "raw": "1 egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ teaspoons matzo meal", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "matzo meal", "preparation": null, "optional": false}, {"position": 11, "raw": "1 teaspoon sugar (optional)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": true}, {"position": 12, "raw": "Beet horseradish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "beet horseradish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring a pot with 3 quarts water to a boil. Slice two onions and add with the carrots and fish head, bones and skin. Add 1 tablespoon salt, 2 teaspoons pepper and cinnamon. Cook for 5 minutes."}, {"position": 2, "text": "Chop third onion and sauté in a skillet in oil until almost golden. Cut fillets into 2-inch cubes. Place in a food processor. Add sautéed onion, remaining salt and pepper, egg, matzo, sugar and ¼ cup cold water. Purée until smooth."}, {"position": 3, "text": "Dip hands into a bowl of cold water and form fish mixture into 11/2-inch balls."}, {"position": 4, "text": "Drop the balls into the simmering stock. Bring to a boil again; cover and simmer 1 hour. Using a slotted spoon, lift the fish, onion and carrots into a bowl. Strain the broth into bowl with fish balls. Serve hot, or cold when broth has gelled. Arrange with onions, carrots and the broth. Serve with beet horseradish."}], "nutrition": {"calories": 59.1, "protein_g": 9.5, "carbohydrates_g": 2.1, "fat_g": 1.2, "saturated_fat_g": 0.3, "trans_fat_g": 0.0, "cholesterol_mg": 29.1, "sodium_mg": 160.6, "fiber_g": 0.5, "sugar_g": 1.0, "unsaturated_fat_g": 0.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["jewish"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": ["passover"], "other": ["boil", "fish", "red snapper", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "2002-03-24", "scraped_at": "2026-09-07T02:48:44.899812+00:00", "scraper_version": "1.0.0"}
{"slug": "evelyn-websters-lemon-meringue-pie", "nyt_id": 8790, "url": "https://cooking.nytimes.com/recipes/8790-evelyn-websters-lemon-meringue-pie", "name": "Evelyn Webster's Lemon Meringue Pie", "author": "Patricia Leigh Brown", "description": "", "servings": {"text": "1 pie", "min": 1, "max": 1, "yield_type": "other"}, "time": {"prep_minutes": null, "cook_minutes": 20, "total_minutes": 20, "raw": {"cook": "20 minutes", "total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 9-inch pie shell", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "-inch pie shell", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ cups sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup cornstarch", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ cups boiling water", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "boiling water", "preparation": null, "optional": false}, {"position": 5, "raw": "3 egg yolks, slightly beaten", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": "slightly beaten", "optional": false}, {"position": 6, "raw": "4 tablespoons lemon juice", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ tablespoons grated lemon rind", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "grated lemon rind", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons butter", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 9, "raw": "3 egg whites", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "egg whites", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ teaspoon cream of tartar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cream of tartar", "preparation": null, "optional": false}, {"position": 11, "raw": "6 tablespoons sugar", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 12, "raw": "½ teaspoon vanilla", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "vanilla", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Prepare any basic pie shell; preheat conventional oven to 350 degrees for browning meringue."}, {"position": 2, "text": "To make filling, mix sugar, cornstarch and water in a 1-quart casserole. Cook in microwave oven at 100 percent power 1 ½ minutes. Stir; turn microwave to 100 percent power and cook 2 minutes, stirring every 30 seconds until thick."}, {"position": 3, "text": "Beat a little of the hot mixture into the egg yolks; then stir egg mixture into remaining hot cornstarch and sugar mixture. Cook 45 seconds in microwave oven at 100 percent power. Blend in lemon juice, rind and butter. Pour into shell."}, {"position": 4, "text": "To make meringue, beat egg whites and cream of tartar in a mixing bowl until frothy. Beat in sugar, a little at a time. Continue beating until stiff. Beat in vanilla."}, {"position": 5, "text": "Place meringue onto filling, being careful to seal meringue to edge of crust. Put pie in conventional oven; brown lightly at 350 degrees."}], "nutrition": {"calories": 522.5, "protein_g": 3.8, "carbohydrates_g": 89.9, "fat_g": 17.3, "saturated_fat_g": 7.9, "unsaturated_fat_g": null, "trans_fat_g": 0.0, "cholesterol_mg": 88.0, "sodium_mg": 185.9, "fiber_g": 0.9, "sugar_g": 62.9, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": ["french"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "egg", "lemon juice", "pie", "pie dough", "spring", "sugar", "baking"]}, "images": [], "rating": {"average": 4.0, "count": 20}, "video_url": null, "comment_count": null, "published_at": "1988-04-21", "scraped_at": "2026-09-07T10:56:31.760430+00:00", "scraper_version": "1.0.0"}
{"slug": "everyday-pancakes", "nyt_id": 1893, "url": "https://cooking.nytimes.com/recipes/1893-everyday-pancakes", "name": "Everyday Pancakes", "author": "Mark Bittman", "description": "The basic pancake is made from a simple batter of eggs, flour, milk and baking powder for leavening. You can use different types of flour if you want to experiment with whole wheat or buckwheat. And you can also add fruit to the mixture. You might also enjoy this video of the recipe, which walks through a few variations. The batter can be made from scratch in about the same time it takes to make toast. The most time-consuming part of making pancakes, of course, is cooking them. But that time is so short you should consider these an everyday convenience food, not a special-occasion feast. Cook this recipe a few times and it may become part of your weekly routine.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 15, "total_minutes": 20, "raw": {"total": "20 minutes", "prep": "5 minutes", "cook": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups all-purpose flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "2 teaspoons baking powder", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon sugar, optional", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": true}, {"position": 5, "raw": "2 eggs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ to 2 cups milk", "group": null, "quantity": 1.5, "quantity_max": 2.0, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons melted and cooled butter (optional), plus unmelted butter for cooking, or use neutral oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "melted and cooled butter (optional)", "preparation": "plus unmelted butter for cooking, or use neutral oil", "optional": true}], "steps": [{"position": 1, "text": "Heat a griddle or large skillet over medium-low heat. In a bowl, mix together dry ingredients. Beat eggs into 1 ½ cups milk, then stir in 2 tablespoons melted cooled butter, if using it. Gently stir this mixture into dry ingredients, mixing only enough to moisten flour; don't worry about a few lumps. If batter seems thick, add a little more milk."}, {"position": 2, "text": "Place a teaspoon or 2 of butter or oil on griddle or skillet. When butter foam subsides or oil shimmers, ladle batter onto griddle or skillet, making pancakes of any size you like. Adjust heat as necessary; usually, first batch will require higher heat than subsequent batches. Flip pancakes after bubbles rise to surface and bottoms brown, after 2 to 4 minutes."}, {"position": 3, "text": "Cook until second side is lightly browned. Serve, or hold on an ovenproof plate in a 200-degree oven for up to 15 minutes."}], "nutrition": {"calories": 258.4, "protein_g": 8.4, "carbohydrates_g": 37.8, "fat_g": 7.9, "saturated_fat_g": 4.2, "trans_fat_g": 0.0, "cholesterol_mg": 70.6, "sodium_mg": 270.3, "fiber_g": 1.1, "sugar_g": 5.8, "unsaturated_fat_g": 3.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["breakfast"], "occasion": [], "other": ["all-purpose flour", "easy", "egg", "kid-friendly", "milk", "pancakes", "pan-fry", "quick", "step by step", "baking", "most popular"]}, "images": [{"url": "https://static01.nyt.com/images/2021/02/22/dining/24COOKING-CLASSICPANCAKES-copy2/24COOKING-CLASSICPANCAKES-facebookJumbo.jpg", "alt": "Everyday pancakes.", "primary": true}], "rating": {"average": 4.0, "count": 14836}, "video_url": "https://www.nytimes.com/video/embedded/dining/100000009047680/everyday-pancakes.html", "comment_count": null, "published_at": "2006-12-20", "scraped_at": "2026-09-07T03:56:57.368800+00:00", "scraper_version": "1.0.0"}
{"slug": "everything-bagel-cottage-cheese-dip", "nyt_id": 760134628, "url": "https://cooking.nytimes.com/recipes/760134628-everything-bagel-cottage-cheese-dip", "name": "Everything Bagel Cottage-Cheese Dip", "author": "Ali Slagle", "description": "Creamy, tangy and full of pep, this quick snack brings new life to your cottage cheese. Scallions, capers and everything bagel seasoning are stirred into cottage cheese, then torn arugula is scattered on top for a peppery crunch. Scoop into it with any combination of crackers, pretzels, toast and raw vegetables like cucumbers or celery — or eat it on a toasted bagel or English muffin. A batch, minus the arugula, keeps for up to two days in the fridge, so keep it on hand for anytime you need a pick-me-up.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": null, "raw": {}}, "ingredients": [{"position": 1, "raw": "16 ounces cottage cheese", "group": null, "quantity": 16.0, "quantity_max": null, "unit": "oz", "item": "cottage cheese", "preparation": null, "optional": false}, {"position": 2, "raw": "3 scallions, thinly sliced", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "thinly sliced", "optional": false}, {"position": 3, "raw": "2 tablespoons drained capers", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "drained capers", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons everything bagel seasoning, regular or no-salt, plus more for serving (see Tip)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "everything bagel seasoning", "preparation": "regular or no-salt, plus more for serving (see Tip)", "optional": false}, {"position": 5, "raw": "Salt and black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "1 packed cup baby arugula", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "packed cup baby arugula", "preparation": null, "optional": false}, {"position": 7, "raw": "Crackers, toast, pretzels, bagel chips or raw sliced vegetables, or a combination, for serving", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "crackers", "preparation": "toast, pretzels, bagel chips or raw sliced vegetables, or a combination, for serving", "optional": false}], "steps": [{"position": 1, "text": "In a medium bowl, stir together the cottage cheese, scallions, capers and everything bagel seasoning. Season to taste with salt and pepper. (You can refrigerate this mixture for up to two days.)"}, {"position": 2, "text": "When ready to eat, rip the arugula into bite-size pieces and sprinkle on top of the cottage cheese, along with more everything bagel seasoning. Eat with crackers, toast, pretzels, bagel chips and/or vegetables."}], "nutrition": {"calories": 161.3, "protein_g": 13.6, "carbohydrates_g": 10.7, "fat_g": 7.2, "saturated_fat_g": 2.5, "unsaturated_fat_g": null, "trans_fat_g": 0.1, "cholesterol_mg": 19.3, "sodium_mg": 520.6, "fiber_g": 0.8, "sugar_g": 4.0, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": [], "diet": ["vegetarian", "healthy"], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["cottage cheese", "arugula", "dips and spreads", "snack", "breakfast", "no cook", "easy", "quick", "make-ahead", "caper"]}, "images": [{"url": "https://static01.nyt.com/images/2025/10/14/multimedia/AS-Everything-Bagel-Cottage-Cheese-Dip-pgbc/AS-Everything-Bagel-Cottage-Cheese-Dip-pgbc-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 184}, "video_url": null, "comment_count": null, "published_at": "2025-10-14", "scraped_at": "2026-09-07T11:53:12.798072+00:00", "scraper_version": "1.0.0"}

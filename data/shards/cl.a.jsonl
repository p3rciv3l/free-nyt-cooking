, "item": "kosher salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "Sliced sandwich bread of choice", "group": null, "quantity": null, "unit": null, "item": "sliced sandwich bread of choice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "None"}], "nutrition": null, "tags": {"cuisine": ["american"], "diet": [], "course": ["lunch-main-course-sandwiches-school-lunch-snack-tuna-salad"], "meal": [], "occasion": [], "other": ["budget", "caper", "celery", "easy", "mayonnaise", "quick", "tuna", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2015/04/06/dining/tuna-salad-sandwich/tuna-salad-sandwich-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2015/04/06/dining/tuna-salad-sandwich/tuna-salad-sandwich-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 3403}, "video_url": null, "comment_count": null, "published_at": "2015-04-06", "scraped_at": "2026-09-07T00:14:19Z", "scraper_version": "1.0.0"}

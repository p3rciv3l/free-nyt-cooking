quantity": null, "unit": null, "item": "beef from stock", "preparation": null, "optional": false}, {"position": 11, "raw": "1 large onion, quartered", "group": null, "quantity": 1.0, "unit": null, "item": "large onion", "preparation": "quartered", "optional": false}, {"position": 12, "raw": "8 celery stalks, diced", "group": null, "quantity": 8.0, "unit": null, "item": "celery stalks", "preparation": "diced", "optional": false}, {"position": 13, "raw": "2 parsnips, diced", "group": null, "quantity": 2.0, "unit": null, "item": "parsnips", "preparation": "diced", "optional": false}, {"position": 14, "raw": "8 carrots, cut into rounds", "group": null, "quantity": 8.0, "unit": null, "item": "carrots", "preparation": "cut into rounds", "optional": false}, {"position": 15, "raw": "1 bunch of parsley, finely chopped", "group": null, "quantity": 1.0, "unit": "bunch", "item": "of parsley", "preparation": "finely chopped", "optional": false}, {"position": 16, "raw": "1 cup pearl barley", "group": null, "quantity": 1.0, "unit": "cup", "item": "pearl barley", "preparation": null, "optional": false}, {"position": 17, "raw": "1 pound fresh white button mushrooms, sliced", "group": null, "quantity": 1.0, "unit": "lb", "item": "fresh white button mushrooms", "preparation": "sliced", "optional": false}, {"position": 18, "raw": "2 tablespoons tomato paste", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 19, "raw": "2 large bay leaves", "group": null, "quantity": 2.0, "unit": null, "item": "large bay leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a very large soup pot, combine all the stock ingredients. Bring to a boil and then simmer for two hours. Strain the broth into another large pot. Save the meat, but discard the rest of the solids. If the stock in your new pot is greasy, let it cool for about 15 minutes and then place 6 ice cubes in the pot. The grease will immediately congeal and you can spoon out the ice cubes and grease in one fell swoop. Your homemade beef stock is ready."}, {"position": 2, "text": "Now it is time to make the soup. First, taste the stock and add salt and pepper to taste. Then add the onion, celery, parsnips, carrots, pearl barley, and sliced mushrooms. Bring to a boil and then add the tomato paste, bay leaves, and parsley. Simmer 30 minutes, until the barley is soft. Then add the saved beef and cook for another 45 minutes You might need to add a little water if too much liquid has evaporated."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 312.64285714285717, "protein_g": 29.7, "carbohydrates_g": 25.3, "fat_g": 10.4, "saturated_fat_g": 4.2, "unsaturated_fat_g": 0.5, "trans_fat_g": 0.1, "cholesterol_mg": 66.8, "sodium_mg": 1085.9, "fiber_g": 6.5, "sugar_g": 6.5, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course-soup"], "meal": [], "occasion": [], "other": ["beef-stew-meat", "great-leftovers", "pearl-barley", "white-mushroom", "winter"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 39}, "video_url": null, "comment_count": null, "published_at": "2015-12-22", "scraped_at": "2026-09-07T00:17:10Z", "scraper_version": "1.0.0"}

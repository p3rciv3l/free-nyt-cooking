{"slug": "emilys-purloined-beet-and-lentil-salad", "nyt_id": 1015552, "url": "https://cooking.nytimes.com/recipes/1015552-emilys-purloined-beet-and-lentil-salad", "name": "Emily's Purloined Beet and Lentil Salad", "author": "Mark Bittman", "description": "Mark Bittman", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 180, "raw": {"total": "PT3H"}}, "ingredients": [{"position": 1, "raw": "6 medium beets, unpeeled, scrubbed, trimmed", "group": null, "quantity": 6.0, "unit": null, "item": "medium beets", "preparation": "unpeeled, scrubbed, trimmed", "optional": false}, {"position": 2, "raw": "1 medium onion (red or yellow), quartered lengthwise, sliced into ⅓ inch slices", "group": null, "quantity": 1.0, "unit": null, "item": "medium onion", "preparation": "quartered lengthwise, sliced into ⅓ inch slices", "optional": false}, {"position": 3, "raw": "20 basil leaves, torn", "group": null, "quantity": 20.0, "unit": null, "item": "basil leaves", "preparation": "torn", "optional": false}, {"position": 4, "raw": "4 cloves garlic, crushed", "group": null, "quantity": 4.0, "unit": "clove", "item": "garlic", "preparation": "crushed", "optional": false}, {"position": 5, "raw": "⅓ cup olive oil", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup water", "group": null, "quantity": 0.5, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 8, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 9, "raw": "3 cups lentils, picked over and rinsed", "group": null, "quantity": 3.0, "unit": "cup", "item": "lentils", "preparation": "picked over and rinsed", "optional": false}, {"position": 10, "raw": "4 to 5 cups chicken stock", "group": null, "quantity": 4.0, "unit": "cup", "item": "chicken stock", "preparation": null, "optional": false, "quantity_max": 5.0}, {"position": 11, "raw": "Simple mustard vinaigrette (below)", "group": null, "quantity": null, "unit": null, "item": "simple mustard vinaigrette", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 425 degrees. Place whole beets into a 13 x 9 x 2-inch baking dish; strew with onion slices, basil leaves, crushed garlic. Drizzle with olive oil; salt, pepper. Add water to pan."}, {"position": 2, "text": "Cover pan tightly with foil, bake without uncovering, for 1 hour and 15 minutes."}, {"position": 3, "text": "While beets are roasting, place lentils in another 13 x 9 x 2-inch pan with 4 cups of the stock, tightly covered with foil. After the beets have cooked for 45 minutes, place lentils in oven. Check lentils after 30 minutes. If stock has been absorbed and lentils are tender, remove with beets. Otherwise, continue to cook another 15 minutes or so, adding more broth if necessary to prevent lentils from burning."}, {"position": 4, "text": "Allow beets and lentils to cool, uncovered. (Drain any excess broth from lentils if necessary) Remove beets from pan, reserving remaining beet-juice-onion-basil mixture. Peel, cut into 1-inch chunks; combine with lentils and juice-onion-basil mixture in a large bowl. Toss with about half jar of Simple mustard Vinaigrette, more or less to taste. Adjust salt and pepper. Serve at room temperature."}, {"position": 5, "text": "To make vinaigrette: In a jar, stir together 8 tablespoons olive oil, 1 tablespoon Dijon mustard, 3 tablespoons of red wine vinegar, ½ teaspoon salt, freshly ground black pepper. Place the lid on the jar, and shake vigorously, until emulsified."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 421.125, "protein_g": 22.7, "carbohydrates_g": 59.0, "fat_g": 11.7, "saturated_fat_g": 1.8, "unsaturated_fat_g": 1.7, "trans_fat_g": null, "cholesterol_mg": 4.1, "sodium_mg": 443.7, "fiber_g": 10.1, "sugar_g": 8.4, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["brunch-dinner-lunch-salad"], "meal": [], "occasion": [], "other": ["beet"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 14}, "video_url": null, "comment_count": null, "published_at": "2009-04-22", "scraped_at": "2026-09-07T00:01:25Z", "scraper_version": "1.0.0"}
{"slug": "empadinhas-de-palmito", "nyt_id": 1015553, "url": "https://cooking.nytimes.com/recipes/1015553-empadinhas-de-palmito", "name": "Empadinhas de Palmito", "author": "Elaine Louie", "description": "Elaine Louie", "servings": {"text": "20 2-inch tartlets", "min": 20, "max": 20, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "PT1H15M"}}, "ingredients": [{"position": 1, "raw": "1 ¼ cups all-purpose flour", "group": null, "quantity": 1.25, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup vegetable oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ large egg yolks", "group": null, "quantity": 1.5, "unit": null, "item": "large egg yolks", "preparation": null, "optional": false}, {"position": 4, "raw": "6 tablespoons butter, at room temperature", "group": null, "quantity": 6.0, "unit": "tbsp", "item": "butter", "preparation": "at room temperature", "optional": false}, {"position": 5, "raw": "20 2-inch diameter tartlet pans", "group": null, "quantity": 22.0, "unit": null, "item": "inch diameter tartlet pans", "preparation": null, "optional": false}, {"position": 6, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 7, "raw": "⅓ cup finely minced onion", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "finely minced onion", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup all-purpose flour", "group": null, "quantity": 0.25, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ½ cups milk", "group": null, "quantity": 1.5, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ cups thinly sliced (¼ inch thick) hearts of palm, rinsed and drained", "group": null, "quantity": 1.5, "unit": "cup", "item": "thinly sliced hearts of palm", "preparation": "rinsed and drained", "optional": false}, {"position": 11, "raw": "salt and freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon finely grated Parmesan cheese", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "finely grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "For the tartlet crusts: In a large mixing bowl combine the flour, oil, egg yolks and butter. Using a spoon or by hand, mix until the dough is no longer sticky. Take a nub of dough about the size of a large marble, place it in a tartlet pan, and press very thinly to cover the inside (thick enough to cover but not so thin that the pan shows through). Pinch off the dough for a clean edge; set aside. Repeat with remaining dough to make twenty tartlet crusts."}, {"position": 2, "text": "For the filling: In a saucepan over medium heat, combine butter and onions, and sauté until onions are translucent, about 5 minutes. In a small bowl, combine flour with 1 cup of the milk and whisk until smooth and blended. Add to saucepan, and stir until beginning to thicken."}, {"position": 3, "text": "Add remaining ½ cup milk, reduce heat to medium-low, and continue stirring until thickened, about 5 minutes. Add hearts of palm, and season with salt and pepper to taste. Reduce heat to low and simmer gently for 3 more minutes. Remove from heat, and set aside."}, {"position": 4, "text": "Preheat oven to 300 degrees. Divide the mixture among the crust-filled pans, and sprinkle with cheese. Place on a baking sheet and bake until tops are lightly golden, about 30 to 40 minutes. Cool to room temperature. Turn each pan upside down, and the tartlet should fall into your hands upside down and all in one piece. Turn right side up, and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 131.4, "protein_g": 2.3, "carbohydrates_g": 9.0, "fat_g": 9.8, "saturated_fat_g": 4.3, "unsaturated_fat_g": 0.8, "trans_fat_g": null, "cholesterol_mg": 31.2, "sodium_mg": 123.5, "fiber_g": 0.6, "sugar_g": 1.1, "computed_with": null}, "tags": {"cuisine": ["latin-american"], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 3.0, "count": 7}, "video_url": null, "comment_count": null, "published_at": "2010-06-07", "scraped_at": "2026-09-07T02:49:10Z", "scraper_version": "1.0.0"}
{"slug": "empanada-dough", "nyt_id": 1012490, "url": "https://cooking.nytimes.com/recipes/1012490-empanada-dough", "name": "Empanada Dough", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "10 6-inch empanadas", "min": 10, "max": 10, "yield_type": "other"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "3 ½ ounces lard", "group": null, "quantity": 3.5, "unit": "oz", "item": "lard", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ teaspoons salt", "group": null, "quantity": 1.5, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "3 cups flour, more for work surface", "group": null, "quantity": 3.0, "unit": "cup", "item": "flour", "preparation": "more for work surface", "optional": false}], "steps": [{"position": 1, "text": "Melt lard in a small saucepan over low heat. Immediately mix with salt and ⅔ cup very warm water. Place flour in a food processor. Turn machine on and pour half the liquid through feed tube. Stop machine, turn it to pulse and add half the remaining liquid. Keep pulsing and add rest of liquid."}, {"position": 2, "text": "Turn dough out onto a lightly floured surface, knead briefly until smooth, form into a disk, wrap in plastic and refrigerate until cool, at least 30 minutes."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 225.9, "protein_g": 3.9, "carbohydrates_g": 28.6, "fat_g": 10.3, "saturated_fat_g": 3.9, "unsaturated_fat_g": 1.3, "trans_fat_g": null, "cholesterol_mg": 9.4, "sodium_mg": 110.3, "fiber_g": 1.0, "sugar_g": 0.1, "computed_with": null}, "tags": {"cuisine": ["latin-american"], "diet": [], "course": ["appetizer-side-dish-dough-empanada"], "meal": [], "occasion": [], "other": ["all-purpose-flour", "lard", "quick"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "al
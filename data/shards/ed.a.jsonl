{"slug": "edamame-tofu-dip", "nyt_id": 1016782, "url": "https://cooking.nytimes.com/recipes/1016782-edamame-tofu-dip", "name": "Edamame Tofu Dip", "author": "Melissa Clark", "description": "Dairy-free, tahini-free, and rich in protein, this zesty, kid-pleasing dip is a lively, pale green alternative to hummus. Serve it with rice crackers, sliced daikon and/or carrot sticks as a dip, but it’s also thick enough to spread on bread or a pita as a sandwich filling. It will keep for three days in the fridge.", "servings": {"text": "1 cups", "min": 1, "max": 1, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "½ cup shelled edamame, defrosted if frozen", "group": null, "quantity": 0.5, "unit": "cup", "item": "shelled edamame", "preparation": "defrosted if frozen", "optional": false}, {"position": 2, "raw": "½ teaspoon grated fresh ginger root", "group": null, "quantity": 0.5, "unit": "tsp", "item": "grated fresh ginger root", "preparation": null, "optional": false}, {"position": 3, "raw": "1 scallion, thinly sliced", "group": null, "quantity": 1.0, "unit": null, "item": "scallion", "preparation": "thinly sliced", "optional": false}, {"position": 4, "raw": "¼ teaspoon toasted sesame oil, more to taste", "group": null, "quantity": 0.25, "unit": "tsp", "item": "toasted sesame oil", "preparation": "more to taste", "optional": false}, {"position": 5, "raw": "1 teaspoon soy sauce, more as needed", "group": null, "quantity": 1.0, "unit": "tsp", "item": "soy sauce", "preparation": "more as needed", "optional": false}, {"position": 6, "raw": "½ of a 14-ounce block firm tofu (7 ounces), patted dry and cubed", "group": null, "quantity": 0.5, "unit": null, "item": "of a 14-ounce block firm tofu", "preparation": "patted dry and cubed", "optional": false}, {"position": 7, "raw": "½ teaspoon fine sea salt", "group": null, "quantity": 0.5, "unit": "tsp", "item": "fine sea sal
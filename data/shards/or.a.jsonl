{"slug": "orange-pork-ragout-with-beans", "nyt_id": 10035, "url": "https://cooking.nytimes.com/recipes/10035-orange-pork-ragout-with-beans", "name": "Orange Pork Ragout with Beans", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 180, "raw": {"total": "PT3H"}}, "ingredients": [{"position": 1, "raw": "1 cup dried cannellini beans, rinsed", "group": null, "quantity": 1.0, "unit": "cup", "item": "dried cannellini beans", "preparation": "rinsed", "optional": false}, {"position": 2, "raw": "3 tablespoons extra virgin olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 pounds boneless pork shoulder, in 2-inch chunks", "group": null, "quantity": 2.0, "unit": "lb", "item": "boneless pork shoulder", "preparation": "in 2-inch chunks", "optional": false}, {"position": 4, "raw": "1 medium-size onion, finely chopped", "group": null, "quantity": 1.0, "unit": null, "item": "medium-size onion", "preparation": "finely chopped", "optional": false}, {"position": 5, "raw": "3 cloves garlic, minced", "group": null, "quantity": 3.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 6, "raw": "1 red bell pepper, cored, seeded and finely chopped", "group": null, "quantity": 1.0, "unit": null, "item": "red bell pepper", "preparation": "cored, seeded and finely chopped", "optional": false}, {"position": 7, "raw": "1 ½ teaspoons smoked Spanish paprika", "group": null, "quantity": 1.5, "unit": "tsp", "item": "smoked spanish paprika", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon ground cloves", "group": null, "quantity": 0.25, "unit": "tsp", "item": "ground cloves", "preparation": null, "optional": false}, {"position": 9, "raw": "Grated zest and juice of 2 oranges", "group": null, "quantity": null, "unit": null, "item": "grated zest and juice of 2 oranges", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ cups dry red wine", "group": null, "quantity": 1.5, "unit": "cup", "item": "dry red wine", "preparation": null, "optional": false}, {"position": 11, "raw": "3 branches fresh rosemary", "group": null, "quantity": 3.0, "unit": null, "item": "branches fresh rosemary", "preparation": null, "optional": false}, {"position": 12, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 13, "raw": "Small pinch red chili flakes", "group": null, "quantity": null, "unit": null, "item": "small pinch red chili flakes", "preparation": null, "optional": false}, {"position": 14, "raw": "1 tablespoon finely chopped flat-leaf parsley", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "finely chopped flat-leaf parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place beans in a saucepan, cover with water by 2 inches, bring to a boil, cook 2 minutes, cover and set aside to soak 1 hour."}, {"position": 2, "text": "Meanwhile, heat 2 tablespoons oil in a 4-quart casserole and lightly brown pork without crowding over medium-high heat. Remove. Add onion, garlic and bell pepper. Sauté over low heat until soft. Stir in paprika, cloves and zest. Stir in orange juice and wine, scraping bottom of pan. Return pork to pan. Set aside until beans have finished soaking, then drain beans and add. Add rosemary, black pepper and chili. Bring to a simmer."}, {"position": 3, "text": "Cover and simmer 2 hours, until beans are tender. Season with salt. Leave in casserole for serving or transfer to a serving dish. Drizzle over remaining oil and scatter parsley on top before serving."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 932.5, "protein
{"slug": "artichoke-mushroom-and-potato-ragout", "nyt_id": 1012485, "url": "https://cooking.nytimes.com/recipes/1012485-artichoke-mushroom-and-potato-ragout", "name": "Artichoke, Mushroom and Potato Ragoût", "author": "Martha Rose Shulman", "description": "This robust Provençal ragout is more of a cool weather recipe than Tuesday’s ragout with peppers and tomatoes.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "PT1H30M"}}, "ingredients": [{"position": 1, "raw": "1 ounce (about 1 cup) dried porcini mushrooms", "group": null, "quantity": 1.0, "unit": "oz", "item": "dried porcini mushrooms", "preparation": null, "optional": false}, {"position": 2, "raw": "1 lemon, for trimming the artichokes, plus fresh lemon juice for seasoning", "group": null, "quantity": 1.0, "unit": null, "item": "lemon", "preparation": "for trimming the artichokes, plus fresh lemon juice for seasoning", "optional": false}, {"position": 3, "raw": "12 baby artichokes, or 6 medium or large artichokes", "group": null, "quantity": 12.0, "unit": null, "item": "baby artichokes", "preparation": "or 6 medium or large artichokes", "optional": false}, {"position": 4, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 large onion, thinly sliced", "group": null, "quantity": 1.0, "unit": null, "item": "large onion", "preparation": "thinly sliced", "optional": false}, {"position": 6, "raw": "4 to 5 large garlic cloves, sliced", "group": null, "quantity": 4.0, "unit": null, "item": "large garlic cloves", "preparation": "sliced", "optional": false, "quantity_max": 5.0}, {"position": 7, "raw": "1 tablespoon tomato paste", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup dry white wine", "group": null, "quantity": 0.5, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 9, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 10, "raw": "A generous sprig of thyme", "group": null, "quantity": null, "unit": null, "item": "a generous sprig of thyme", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 12, "raw": "freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper", "preparation": null, "optional": false}, {"position": 13, "raw": "1 pound small potatoes, scrubbed and quartered", "group": null, "quantity": 1.0, "unit": "lb", "item": "small potatoes", "preparation": "scrubbed and quartered", "optional": false}, {"position": 14, "raw": "¼ cup chopped fresh parsley", "group": null, "quantity": 0.25, "unit": "cup", "item": "chopped fresh parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the mushrooms in a bowl or large Pyrex measuring cup. Bring 2 cups water to a boil, and pour over the mushrooms. Let sit 30 minutes."}, {"position": 2, "text": "Meanwhile, prepare the artichokes. If small, cut in half; quarter if large."}, {"position": 3, "text": "Place a strainer lined with cheesecloth or paper towels over a bowl, and drain the mushrooms. Squeeze the mushrooms over the strainer to extract liquid, then rinse in several changes of water to rid them of grit. Set aside. Add enough water to the bowl to make 3 cups of soaking liquid."}, {"position": 4, "text": "Heat the olive oil over medium heat in a large, heavy casserole or lidded nonstick skillet. Add the onion, and cook, stirring, until tender, about five minutes. Stir in the garlic and mushrooms, and cook together, stirring, until fragrant, about one minute. Add the tomato paste and cook, stirring, until it darkens and begins to caramelize in three to five minutes."}, {"position": 5, "text": "Drain the artichokes, and add with the potatoes. Stir together for another minute, then stir in the wine. Bring to a boil, and cook until most of the liquid is gone. Add the soaking liquid from the mushrooms, the bay leaf, thyme, salt and pepper. Bring to a simmer, reduce the heat, cover and simmer 40 minutes, until the potatoes and artichokes are tender. Uncover, turn up the heat, and reduce the liquid in the pan to thicken. Remove from the heat, taste and adjust salt and pepper. Stir in a teaspoon or more of fresh lemon juice, if desired, and the parsley. Serve hot or at room temperature."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 294.6666666666667, "protein_g": 12.7, "carbohydrates_g": 55.0, "fat_g": 5.2, "saturated_fat_g": 0.8, "unsaturated_fat_g": 0.7, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 1054.4, "fiber_g": 19.5, "sugar_g": 5.7, "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["main-course"], "meal": [], "occasion": [], "other": ["artichoke", "dried-porcini", "fall", "potato", "spring", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2009/04/08/health/08recipehealth_600/08recipehealth_600-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2009/04/08/health/08recipehealth_600/08recipehealth_600-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 54}, "video_url": null, "comment_count": null, "published_at": "2009-04-08", "scraped_at": "2026-09-06T22:30:21Z", "scraper_version": "1.0.0"}
{"slug": "arugula-and-avocado-salad-with-bagna-cauda-dressing", "nyt_id": 1014544, "url": "https://cooking.nytimes.com/recipes/1014544-arugula-and-avocado-salad-with-bagna-cauda-dressing", "name": "Arugula and Avocado Salad with Bagna Cauda Dressing", "author": "Melissa Clark", "description": "", "servings": {"text": "2 to 4 servings", "min": 2, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "PT20M"}}, "ingredients": [{"position": 1, "raw": "3 tablespoons extra-virgin olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "4 anchovies, finely chopped", "group": null, "quantity": 4.0, "unit": null, "item": "anchovies", "preparation": "finely chopped", "optional": false}, {"position": 3, "raw": "1 very large garlic clove, minced", "group": null, "quantity": 1.0, "unit": null, "item": "very large garlic clove", "preparation": "minced", "optional": false}, {"position": 4, "raw": "Large pinch kosher salt", "group": null, "quantity": null, "unit": null, "item": "large pinch kosher salt", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon red wine vinegar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "Black pepper", "group": null, "quantity": null, "unit": null, "item": "black pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "1 small bunch arugula, cleaned and torn into pieces (about 3 cups)", "group": null, "quantity": 1.0, "unit": null, "item": "small bunch arugula", "preparation": "cleaned and torn into pieces (about 3 cups)", "optional": false}, {"position": 8, "raw": "1 avocado, peeled, pitted and diced", "group": null, "quantity": 1.0, "unit": null, "item": "avocado", "preparation": "peeled, pitted and diced", "optional": false}], "steps": [{"position": 1, "text": "In a small skillet over medium heat, warm the oil. Add anchovies and cook over medium-low heat, stirring, until anchovies melt into the oil, 2 to 3 minutes. Stir in garlic and cook until fragrant, about 1 minute. Remove from heat and whisk in salt, vinegar and pepper. Let cool to room temperature."}, {"position": 2, "text": "In a serving bowl, toss arugula with just enough dressing to coat. Season well with black pepper. In a smaller bowl, very gently toss avocado with more of the dressing (you may not need it all). Add avocado to arugula and very gently combine. Serve immediately."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 190.0, "protein_g": 3.5, "carbohydrates_g": 5.4, "fat_g": 18.1, "saturated_fat_g": 2.6, "unsaturated_fat_g": 2.2, "trans_fat_g": null, "cholesterol_mg": 6.0, "sodium_mg": 55.5, "fiber_g": 3.7, "sugar_g": 0.7, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["green-salad"], "meal": [], "occasion": [], "other": ["anchovy", "arugula", "avocado", "quick", "valentine-s-day", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2013/02/13/dining/13APPE4/13APPE4-superJumbo.jpg", "alt": "Arugula and avocado salad with bagna cauda dressing.", "primary": true}, {"url": "https://static01.nyt.com/images/2013/02/13/dining/13APPE4/13APPE4-facebookJumbo-v2.jpg", "alt": "Arugula and avocado salad with bagna cauda dressing.", "primary": false}], "rating": {"average": 5.0, "count": 303}, "video_url": null, "comment_count": null, "published_at": "2013-02-13", "scraped_at": "2026-09-06T23:52:55Z", "scraper_version": "1.0.0"}
{"slug": "arugula-and-carrot-salad-with-walnuts-and-cheese", "nyt_id": 1014107, "url": "https://cooking.nytimes.com/recipes/1014107-arugula-and-carrot-salad-with-walnuts-and-cheese", "name": "Arugula and Carrot Salad With Walnuts and Cheese", "author": "Martha Rose Shulman", "description": "The best type of arugula for this salad is the feathery type called wild arugula. I love the contrast of flavors here — peppery arugula alongside sweet carrots and a nutty dressing.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "PT10M"}}, "ingredients": [{"position": 1, "raw": "4 cups wild or baby arugula", "group": null, "quantity": 4.0, "unit": "cup", "item": "wild or baby arugula", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups grated carrots", "group": null, "quantity": 2.0, "unit": "cup", "item": "grated carrots", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons broken walnuts (½ ounce)", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "broken walnuts", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup grated Parmesan or crumbled blue cheese (1 ounce)", "group": null, "quantity": 0.25, "unit": "cup", "item": "grated parmesan or crumbled blue cheese", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon finely chopped fresh tarragon", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "finely chopped fresh tarragon", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon fresh lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon sherry vinegar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon bal
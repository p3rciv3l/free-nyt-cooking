{"slug": "arugula-cherry-and-goat-cheese-salad", "nyt_id": 1014833, "url": "https://cooking.nytimes.com/recipes/1014833-arugula-cherry-and-goat-cheese-salad", "name": "Arugula, Cherry and Goat Cheese Salad", "author": "Martha Rose Shulman", "description": "This salad was inspired by a dish billed as Cherries and Goat Cheese on the menu at Westside Tavern in Los Angeles. Even if you’re not inclined to add fruits like blueberries and cranberries to salads, this combination could change your mind. Even sweet cherries have a tart edge to them, and the combination of their sweet/tart flavor and juicy but firm texture with the pungent arugula, creamy goat cheese and crunchy nuts works very well.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "1 6-ounce bag baby arugula", "group": null, "quantity": 7.0, "unit": null, "item": "ounce bag baby arugula", "preparation": null, "optional": false}, {"position": 2, "raw": "16 cherries, halved and pitted", "group": null, "quantity": 16.0, "unit": null, "item": "cherries", "preparation": "halved and pitted", "optional": false}, {"position": 3, "raw": "Scant ¼ cup pistachios or almonds, (about 1 ounce), lightly toasted and chopped", "group": null, "quantity": null, "unit": null, "item": "scant ¼ cup pistachios or almonds", "preparation": "(about 1 ounce), lightly toasted and chopped", "optional": false}, {"position": 4, "raw": "1 tablespoon chopped fresh tarragon", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "chopped fresh tarragon", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon sherry vinegar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon balsamic vinegar", "group": null, "quantity": 1.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "Salt and freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons extra virgin olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 9, "raw": "2 ounces goat cheese, crumbled", "group": null, "quantity": 2.0, "unit": "oz", "item": "goat cheese", "preparation": "crumbled", "optional": false}], "steps": [{"position": 1, "text": "Combine the arugula, cherries, half the nuts and the tarragon in a large bowl."}, {"position": 2, "text": "Whisk together the vinegars, salt and pepper and olive oil. Toss with the salad. Arrange on a platter, sprinkle the goat cheese and remaining pistachios over the top, and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 202.25, "protein_g": 5.7, "carbohydrates_g": 9.5, "fat_g": 16.7, "saturated_fat_g": 4.0, "unsaturated_fat_g": 2.3, "trans_fat_g": null, "cholesterol_mg": 6.5, "sodium_mg": 262.1, "fiber_g": 2.3, "sugar_g": 5.8, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["green-salad"], "meal": [], "occasion": [], "other": ["easy", "quick", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2013/06/24/science/sub24recipehealth/sub24recipehealth-superJumbo-v2.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2013/06/24/science/sub24recipehealth/sub24recipehealth-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 272}, "video_url": null, "comment_count": null, "published_at": "2013-06-24", "scraped_at": "2026-09-06T23:55:20Z", "scraper_version": "1.0.0"}
{"slug": "arugula-salad-with-lime-vinaigrette", "nyt_id": 1013377, "url": "https://cooking.nytimes.com/recipes/1013377-arugula-salad-with-lime-vinaigrette", "name": "Arugula Salad With Lime Vinaigrette", "author": "Sam Sifton", "description": "This tart, refreshing salad was originally proposed as a pairing for asado negro, a Venezuelan holiday roast beef that is simmered in dark caramel. However, go ahead and pair this with any hearty main course and you’ll enjoy a wonderfully balanced meal.", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "PT10M"}}, "ingredients": [{"position": 1, "raw": "Juice of 2 limes, roughly ¼ cup", "group": null, "quantity": null, "unit": null, "item": "juice of 2 limes", "preparation": "roughly ¼ cup", "optional": false}, {"position": 2, "raw": "2 cloves garlic, minced", "group": null, "quantity": 2.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 3, "raw": "2 tablespoons cilantro, finely chopped", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "cilantro", "preparation": "finely chopped", "optional": false}, {"position": 4, "raw": "⅓ cup extra-virgin olive oil", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "Kosher salt", "group": null, "quantity": null, "unit": null, "item": "kosher salt", "preparation": null, "optional": false}, {"position": 6, "raw": "freshly ground black pepper", "group": null, "quantity": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "2 bunches arugula, washed and dried well", "group": null, "quantity": 2.0, "unit": "bunch", "item": "arugula", "preparation": "washed and dried well", "optional": false}], "steps": [{"position": 1, "text": "In a smal
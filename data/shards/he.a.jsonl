{"slug": "hearty-quinoa-and-white-bean-soup", "nyt_id": 1014726, "url": "https://cooking.nytimes.com/recipes/1014726-hearty-quinoa-and-white-bean-soup", "name": "Hearty Quinoa and White Bean Soup", "author": "Jeff Gordinier", "description": "Soup doesn't have to be loaded with meat to be deeply satisfying. This one from Mary McCartney, devoted vegetarian, cookbook author and a daughter of Paul, is proof of that fact. Quinoa adds a lovely bit of texture, and beans – practically any variety will do – add heft and a wonderful creaminess as they break down in the broth. This recipe begs to be tampered with, so feel free to add more beans, vegetables, quinoa or fresh herbs. One reader even added a few cups of cooked pasta. It's almost impossible to mess up, so don't hold back. Jeff Gordinier", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "¼ cup light olive oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "light olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "2 medium onions, finely chopped", "group": null, "quantity": 2.0, "unit": null, "item": "medium onions", "preparation": "finely chopped", "optional": false}, {"position": 3, "raw": "2 medium carrots, peeled and finely chopped", "group": null, "quantity": 2.0, "unit": null, "item": "medium carrots", "preparation": "peeled and finely chopped", "optional": false}, {"position": 4, "raw": "2 stalks celery, trimmed and finely diced", "group": null, "quantity": 2.0, "unit": "stalk", "item": "celery", "preparation": "trimmed and finely diced", "optional": false}, {"position": 5, "raw": "1 can (14 ½ ounces) cannellini or other white beans, drained", "group": null, "quantity": 1.0, "unit": "can", "item": "cannellini or other white beans", "preparation": "drained", "optional": false}, {"position": 6, "raw": "2 cloves garlic, finely chopped", "group": null, "quantity": 2.0, "unit": "clove", "item": "garlic", "preparation": "finely chopped", "optional": false}, {"position": 7, "raw": "1 can (14 ½ ounces) chopped tomatoes, with their juices", "group": null, "quantity": 1.0, "unit": "can", "item": "chopped tomatoes", "preparation": "with their juices", "optional": false}, {"position": 8, "raw": "7 cups vegetable stock", "group": null, "quantity": 7.0, "unit": "cup", "item": "vegetable stock", "preparation": null, "optional": false}, {"position": 9, "raw": "⅓ cup quinoa", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "quinoa", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup chopped parsley", "group": null, "quantity": 0.25, "unit": "cup", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon chopped fresh oregano, rosemary or thyme", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "chopped fresh oregano", "preparation": "rosemary or thyme", "optional": false}, {"position": 12, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 13, "raw": "Sea salt and ground black pepper", "group": null, "quantity": null, "unit": null, "item": "sea salt and ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oil in a large, heavy-bottomed saucepan over medium heat. Add onions, carrots and celery, and sauté until barely tender, about 5 minutes. Add beans and garlic and stir for 2 minutes."}, {"position": 2, "text": "Stir in tomatoes and their juices, and vegetable stock. Simmer for 20 minutes."}, {"position": 3, "text": "Add quinoa, parsley, oregano or other herb, and bay leaf. Cover and simmer until quinoa is cooked, 12 to 15 minutes. Season with salt and pepper to taste. Remove bay leaf and serve."}], "nutrition": {"source": "nyt", "basis": "per_se
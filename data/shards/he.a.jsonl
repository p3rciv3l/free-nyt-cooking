{"slug": "herbed-white-bean-and-sausage-stew", "nyt_id": 1013327, "url": "https://cooking.nytimes.com/recipes/1013327-herbed-white-bean-and-sausage-stew", "name": "Herbed White Bean and Sausage Stew", "author": "Melissa Clark", "description": "Here’s a meaty, cold-weather stew laden with white beans, sweet Italian sausage, rosemary, thyme, cumin and garlic. It is deeply flavored and complex, but quite easy to make. Pan-fry the sausages in a bit of olive oil, then sauté the vegetables with cumin and tomato paste in the drippings. Add plenty of water and the dried beans that, wait for it, you did not have to soak. Simmer until the house is fragrant and the windows fog up (about 2 hours).", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "PT2H30M"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons extra-virgin olive oil, plus more for serving", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": "plus more for serving", "optional": false}, {"position": 2, "raw": "1 pound sweet Italian sausage, sliced ¾-inch thick", "group": null, "quantity": 1.0, "unit": "lb", "item": "sweet italian sausage", "preparation": "sliced ¾-inch thick", "optional": false}, {"position": 3, "raw": "1 tablespoon tomato paste", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon ground cumin", "group": null, "quantity": 0.5, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 5, "raw": "2 medium carrots, finely diced", "group": null, "quantity": 2.0, "unit": null, "item": "medium carrots", "preparation": "finely diced", "optional": false}, {"position": 6, "raw": "2 celery stalks, finely diced", "group": null, "quantity": 2.0, "unit": null, "item": "celery stalks", "preparation": "finely diced", "optional": false}, {"position": 7, "raw": "1 onion, chopped", "group": null, "quantity": 1.0, "unit": null, "item": "onion", "preparation": "chopped", "optional": false}, {"position": 8, "raw": "2 garlic cloves, finely chopped", "group": null, "quantity": 2.0, "unit": null, "item": "garlic cloves", "preparation": "finely chopped", "optional": false}, {"position": 9, "raw": "1 pound dried great Northern beans, rinsed and picked through", "group": null, "quantity": 1.0, "unit": "lb", "item": "dried great northern beans", "preparation": "rinsed and picked through", "optional": false}, {"position": 10, "raw": "2 teaspoons kosher salt, or to taste", "group": null, "quantity": 2.0, "unit": "tsp", "item": "kosher salt", "preparation": "or to taste", "optional": false}, {"position": 11, "raw": "2 thyme sprigs", "group": null, "quantity": 2.0, "unit": null, "item": "thyme sprigs", "preparation": null, "optional": false}, {"position": 12, "raw": "1 large rosemary sprig", "group": null, "quantity": 1.0, "unit": null, "item": "large rosemary sprig", "preparation": null, "optional": false}, {"position": 13, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 14, "raw": "2 teaspoons balsamic vinegar, plus more for serving", "group": null, "quantity": 2.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": "plus more for serving", "optional": false}, {"position": 15, "raw": "½ teaspoon black pepper, plus more to taste", "group": null, "quantity": 0.5, "unit": "tsp", "item": "black pepper", "preparation": "plus more to taste", "optional": false}], "steps": [{"position": 1, "text": "Heat oil in a large stockpot over medium-high. Add the sausage and brown until cooked through, about 7 minutes. Using a slotted spoon, transfer to a plate lined with a paper towel."}, {"position": 2, "text": "Add the tomato paste and cumin to the pot. Cook, stirring, until dark golden, about 2 minutes. Add the carrots, celery, onion and garlic. Cook, stirring, until the vegetables have softened, about 5 minutes. Stir in the beans, 8 cups water, salt, thyme, rosemary and bay leaf. Turn the heat up to high and bring to a boil. Then reduce heat to low and simmer gently until the beans are tender, about 2 hours, adding more water if needed to make sure the beans remain submerged."}, {"position": 3, "text": "When beans are tender, return the sausage to the pot. Simmer for 5 minutes. Stir in the vinegar and pepper. Taste and adjust seasoning. Ladle into warm bowls and serve drizzled with more vinegar and olive oil."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 199.625, "protein_g": 13.9, "carbohydrates_g": 17.7, "fat_g": 8.6, "saturated_fat_g": 2.4, "unsaturated_fat_g": 0.8, "trans_fat_g": null, "cholesterol_mg": 17.0, "sodium_mg": 569.0, "fiber_g": 4.0, "sugar_g": 2.8, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course-stew"], "meal": [], "occasion": [], "other": ["easy", "fall", "great-leftovers", "great-northern-bean", "italian-sausage", "one-pot", "rosemary", "thyme", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2020/02/10/dining/mc-white-bean-stew/mc-white-bean-stew-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2020/02/10/dining/mc-white-bean-stew/mc-white-bean-stew-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2020/02/10/dining/mc-white-bean-stew/mc-white-bean-stew-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 6091}, "video_url": null, "comment_count": null, "published_at": "2010-11-03", "scraped_at": "2026-09-06T22:36:38Z", "scraper_version": "1.0.0"}
{"slug": "herring-and-potato-salad-with-brown-butter", "nyt_id": 1013176, "url": "https://cooking.nytimes.com/recipes/1013176-herring-and-potato-salad-with-brown-butter", "name": "Herring-and-Potato Salad With Brown Butter", "author": "Melissa Clark", "description": "", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "PT40M"}}, "ingredients": [{"position": 1, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 2, "raw": "2 pounds Yukon Gold potatoes", "group": null, "quantity": 2.0, "unit": "lb", "item": "yukon gold potatoes", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 4, "raw": "1 spring onion", "group": null, "quantity": 1.0, "unit": null, "item": "spring onion", "preparation": null, "optional": false}, {"position": 5, "raw": "6 tablespoons crème fraîche", "group": null, "quantity": 6.0, "unit": "tbsp", "item": "crème fraîche", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons horseradish sauce", "group": null, "quantity": 2.0, "unit": "tsp", "item": "horseradish sauce", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon finely grated lemon zest", "group": null, "quantity": 1.0, "unit": "tsp", "item": "finely grated lemon zest", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon fresh lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 9, "raw": "¾ teaspoon kosher salt, more to taste", "group": null, "quantity": 0.75, "unit": "tsp", "item": "kosher salt", "preparation": "more to taste", "optional": false}, {"position": 10, "raw": "½ teaspoon black pepper", "group": null, "quantity": 0.5, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ pound pickled herring, sliced ¼-inch thick", "group": null, "quantity": 0.25, "unit": "lb", "item": "pickled herring", "preparation": "sliced ¼-inch thick", "optional": false}, {"position": 12, "raw": "¼ cup finely chopped chives", "group": null, "quantity": 0.25, "unit": "cup", "item": "finely chopped chives", "preparation": null, "optional": false}, {"position": 13, "raw": "Potato chips, crumbled, for serving", "group": null, "quantity": null, "unit": null, "item": "potato chips", "preparation": "crumbled, for serving", "optional": false}], "steps": [{"position": 1, "text": "Bring a large saucepan of salted water to boil. Drop in potatoes, turn down heat to medium and cook until tender, about 25 minutes. Drain, allow to cool and cut into 1-inch chunks. Place in a large bowl."}, {"position": 2, "text": "Melt butter in a small skillet over medium-low heat. Cook until butter turns golden brown, 2 to 3 minutes. Let cool."}, {"position": 3, "text": "Slice dark greens from onion and cut some into slivers for garnish. Trim roots and discard. Cut bulb in half lengthwise and slice into slivers (about ¼ cup)."}, {"position": 4, "text": "In a bowl, whisk together crème fraîche, horseradish, lemon zest and juice, kosher salt and pepper."}, {"position": 5, "text": "Add the onion, herring and chives to the potatoes. Toss the crème fraîche dressing with the potato mixture and combine well. Pour the butter over the mixture and toss gently. Garnish with potato chips and onion greens."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 174.125, "protein_g": 4.8, "carbohydrates_g": 22.4, "fat_g": 7.7, "saturated_fat_g": 3.2, "unsaturated_fat_g": 0.5, "trans_fat_g": 0.1, "cholesterol_mg": 15.7, "sodium_mg": 345.6, "fiber_g": 2.6, "sugar_g": 2.6, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["potato-salad-seafood-side-dish"], "meal": [], "occasion": [], "other": ["brown-butter", "easy", "yukon-gold-potato"]}, "images": [{"url": "https://static01.nyt.com/images/2014/04/02/dining/herring-potato-salad/herring-potato-salad-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/04/02/dining/herring-potato-salad/herring-potato-salad-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 41}, "video_url": null, "comment_count": null, "published_at": "2010-06-16", "scraped_at": "2026-09-06T22:35:24Z", "scraper_version": "1.0.0"}

ration": null, "optional": false}, {"position": 9, "raw": "¼ cup extra-virgin olive oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup extra-virgin olive oil, plus more for drizzling", "group": null, "quantity": 0.25, "unit": "cup", "item": "extra-virgin olive oil", "preparation": "plus more for drizzling", "optional": false}, {"position": 11, "raw": "3 large carrots, peeled and diced", "group": null, "quantity": 3.0, "unit": null, "item": "large carrots", "preparation": "peeled and diced", "optional": false}, {"position": 12, "raw": "5 ribs celery, diced", "group": null, "quantity": 5.0, "unit": "rib", "item": "celery", "preparation": "diced", "optional": false}, {"position": 13, "raw": "2 leeks, white and light green parts only, diced", "group": null, "quantity": 2.0, "unit": null, "item": "leeks", "preparation": "white and light green parts only, diced", "optional": false}, {"position": 14, "raw": "1 head garlic, cloves peeled and finely grated", "group": null, "quantity": 1.0, "unit": "head", "item": "garlic", "preparation": "cloves peeled and finely grated", "optional": false}, {"position": 15, "raw": "1 ½ teaspoons red chili flakes, plus more to taste", "group": null, "quantity": 1.5, "unit": "tsp", "item": "red chili flakes", "preparation": "plus more to taste", "optional": false}, {"position": 16, "raw": "2 tablespoons chopped fresh rosemary", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped fresh rosemary", "preparation": null, "optional": false}, {"position": 17, "raw": "1 cup canned whole San Marzano tomatoes, drained and chopped", "group": null, "quantity": 1.0, "unit": "cup", "item": "canned whole san marzano tomatoes", "preparation": "drained and chopped", "optional": false}, {"position": 18, "raw": "½ cup chopped Italian parsley", "group": null, "quantity": 0.5, "unit": "cup", "item": "chopped italian parsley", "preparation": null, "optional": false}, {"position": 19, "raw": "Rustic bread, sliced", "group": null, "quantity": null, "unit": null, "item": "rustic bread", "preparation": "sliced", "optional": false}, {"position": 20, "raw": "1 clove garlic, halved", "group": null, "quantity": 1.0, "unit": "clove", "item": "garlic", "preparation": "halved", "optional": false}], "steps": [{"position": 1, "text": "Prepare the beans: Drain the beans and place them in a large pot. Add 3 quarts cold water, the carrot, celery, onion, garlic and parsley stem sachet. Bring to a boil, skimming off any foam that rises to the top. Reduce the heat to a gentle simmer and cook until the beans are soft and creamy, but not falling apart. (Start checking after 25 minutes; the fresher the beans, the shorter the cooking time.) Add the salt, pepper and olive oil. Discard the sachet and vegetables. Let the beans cool in the liquid."}, {"position": 2, "text": "Prepare the soup: Pour the olive oil into a large pot set over medium heat. Add the carrots, celery, leeks, garlic, chili and rosemary. Cook until the rawness of the vegetables is just gone, 3 to 4 minutes. Add the tomatoes and cook until slightly caramelized, about 3 minutes more. Add the beans and their cooking liquid, bring to a boil and simmer until the vegetables are tender, 5 to 10 minutes. Season to taste with salt and pepper. Just before serving, add the parsley. Toast the bread slices. While still hot, rub them with the garlic halves, then tear into large pieces. Ladle the soup into bowls and top each with a few toasts, then drizzle with olive oil."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 569.75, "protein_g": 25.2, "carbohydrates_g": 83.5, "fat_g": 16.8, "saturated_fat_g": 2.5, "unsaturated_fat_g": 2.7, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 655.5, "fiber_g": 16.6, "sugar_g": 8.7, "computed_with": null}, "tags": {"cuisine": ["american"], "diet": [], "course": ["dinner-main-course-soup"], "meal": [], "occ
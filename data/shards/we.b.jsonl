1, "text": "Preheat the broiler to high."}, {"position": 2, "text": "Grate the cheese coarsely. There should be about two cups."}, {"position": 3, "text": "Melt the butter in a heavy saucepan and add the cheese. Stir briefly and add the ale. Continue cooking over low heat, stirring, until the cheese is thoroughly melted and smooth. Add the mustard, Worcestershire sauce, salt and pepper."}, {"position": 4, "text": "Arrange the toast slices in four fairly shallow ramekins. Spoon an equal amount of the rabbit on top of each. Place under the broiler, and broil until bubbling and lightly browned. Serve immediately."}], "nutrition": {"calories": 588.7, "protein_g": 29.3, "carbohydrates_g": 18.0, "fat_g": 44.6, "saturated_fat_g": 25.3, "trans_fat_g": 0.0, "cholesterol_mg": 127.5, "sodium_mg": 909.0, "fiber_g": 1.3, "sugar_g": 2.2, "unsaturated_fat_g": 14.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["british"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["broil", "cheese", "easy", "quick"]}, "images": [], "rating": {"average": 4.0, "count": 16}, "video_url": null, "comment_count": null, "published_at": "1983-06-26", "scraped_at": "2026-09-07T04:31:39.481328+00:00", "scraper_version": "1.0.0"}
{"slug": "welsh-rarebit", "nyt_id": 1908, "url": "https://cooking.nytimes.com/recipes/1908-welsh-rarebit", "name": "Welsh Rarebit", "author": "Mark Bittman", "description": "Anyone can lay a few slices of cheese on toast and melt them, but creating a thick sauce of cheese, beer and spices and then spreading it on toast creates one of the best late-night snacks I know. This is Welsh rarebit, or rabbit, a traditional British dish whose name has a long and complicated history, one we will not go into here.", "servings": {"text": "4 or more servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon mustard powder, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "mustard powder", "preparation": "or to taste", "optional": false}, {"position": 4, "raw": "½ teaspoon cayenne, or to taste", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "cayenne", "preparation": "or to taste", "optional": false}, {"position": 5, "raw": "¾ cup strong dark beer, like Guinness", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "strong dark beer", "preparation": "like Guinness", "optional": false}, {"position": 6, "raw": "2 tablespoons Worcestershire sauce, or to taste", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "worcestershire sauce", "preparation": "or to taste", "optional": false}, {"position": 7, "raw": "1 pound Cheddar, Double Gloucester or other English cheese (or other good semi-hard cheese, like Comté or Gruyère, or a mixture), grated", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "cheddar", "preparation": "Double Gloucester or other English cheese (or other good semi-hard cheese, like Comté or Gruyère, or a mixture), grated", "optional": false}, {"position": 8, "raw": "4 to 8 pieces lightly toasted bread", "group": null, "quantity": 4.0, "quantity_max": 8.0, "unit": "piece", "item": "lightly toasted bread", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put butter in a saucepan over medium heat and, as it melts, stir in flour. Continue to cook, stirring occasionally, until golden brown and very fragrant, 3 to 5 minutes. Stir in mustard and cayenne, then whisk in beer and Worcestershire sauce."}, {"position": 2, "text": "When mixture is uniform, turn heat to low and stir in cheese, again stirring until smooth. Remove from heat and pour into a broad container to set (you can refrigerate for up to a day at this point)."}, {"position": 3, "text": "Spread mixture thickly on toast and put under broiler until bubbly and edges of toast are crisp. Serve immediately."}], "nutrition": {"calories": 675.7, "protein_g": 31.7, "carbohydrates_g": 31.3, "fat_g": 46.1, "saturated_fat_g": 25.4, "trans_fat_g": 0.0, "cholesterol_mg": 127.5, "sodium_mg": 1059.7, "fiber_g": 2.1, "sugar_g": 4.0, "unsaturated_fat_g": 15.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["british"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["cheddar", "easy"]}, "images": [{"url": "https://static01.nyt.com/images/2016/12/20/dining/20COOKING-WELSHRAREBIT1/20COOKING-WELSHRAREBIT1-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 584}, "video_url": null, "comment_count": null, "published_at": "2006-12-27", "scraped_at": "2026-09-07T03:57:42.977260+00:00", "scraper_version": "1.0.0"}
{"slug": "wendy-gaynors-perfect-chocolate-chunk-cookies", "nyt_id": 10965, "url": "https://cooking.nytimes.com/recipes/10965-wendy-gaynors-perfect-chocolate-chunk-cookies", "name": "Wendy Gaynor's 'Perfect' Chocolate Chunk Cookies", "author": "Jonathan Reynolds", "description": "", "servings": {"text": "36 to 72 cookies, depending on size", "min": 36, "max": 72, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "8 ounces (2 sticks) unsalted butter, at room temperature", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "(2 sticks) unsalted butter", "preparation": "at room temperature", "optional": false}, {"position": 2, "raw": "1 cup packed dark brown sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "packed dark brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup granulated sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "2 large eggs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 5, "raw": "2 cups all-purpose flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ teaspoon baking soda", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon pure vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "pure vanilla extract", "preparation": null, "optional": false}, {"position": 9, "raw": "4 cups semisweet chunks (preferably imported)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "semisweet chunks (preferably imported)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the butter in a large bowl and cream at high speed until fluffy. Add the sugars and beat until light and fluffy, about 4 minutes, scraping down sides of bowl occasionally. Beat in eggs, one at a time, until completely mixed."}, {"position": 2, "text": "In a separate bowl, mix flour, salt and baking soda. Add to the butter mixture at low speed until just combined and add vanilla extract. Beat on medium speed, scraping bowl down, until blended. Do not overmix."}, {"position": 3, "text": "Add chocolate chunks and mix till thoroughly combined. Refrigerate batter until cold, preferably overnight."}, {"position": 4, "text": "Preheat a conventional oven to 350 degrees or a convection oven to 300 degrees, and line several baking sheets with parchment paper. Drop heaping spoonfuls of batter 2 inches apart on the lined baking sheets and bake, turning tray once, until golden brown around edges and soft (but not bubbly), about 9 minutes in a convection oven or 12 in a conventional one. Cool on a wire rack."}], "nutrition": {"calories": 72.5, "protein_g": 0.8, "carbohydrates_g": 9.4, "fat_g": 3.6, "saturated_fat_g": 2.2, "trans_fat_g": 0.0, "cholesterol_mg": 15.9, "sodium_mg": 38.9, "fiber_g": 0.1, "sugar_g": 5.8, "unsaturated_fat_g": 1.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "chocolate chip cookie", "baking"]}, "images": [], "rating": {"average": 5.0, "count": 51}, "video_url": null, "comment_count": null, "published_at": "2002-10-27", "scraped_at": "2026-09-07T01:57:30.104677+00:00", "scrap
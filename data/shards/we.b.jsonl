{"slug": "wedge-salad-with-buttermilk-blue-cheese-dressing", "nyt_id": 7775, "url": "https://cooking.nytimes.com/recipes/7775-wedge-salad-with-buttermilk-blue-cheese-dressing", "name": "Wedge Salad With Buttermilk-Blue Cheese Dressing", "author": "Amanda Hesser", "description": "Amanda Hesser", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ pound smoked slab bacon, cut into ¼-inch cubes", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "smoked slab bacon", "preparation": "cut into ¼-inch cubes", "optional": false}, {"position": 2, "raw": "6 slices white bread, crusts removed and cut in half", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "slice", "item": "white bread", "preparation": "crusts removed and cut in half", "optional": false}, {"position": 3, "raw": "1 cup buttermilk", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "buttermilk", "preparation": null, "optional": false}, {"position": 4, "raw": "4 ounces Roquefort cheese, crumbled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "roquefort cheese", "preparation": "crumbled", "optional": false}, {"position": 5, "raw": "2 tablespoons lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon red wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ tablespoons minced shallots", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "minced shallots", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon chopped parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "Pinch cayenne", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch cayenne", "preparation": null, "optional": false}, {"position": 10, "raw": "Kosher salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "1 ½ heads iceberg lettuce, trimmed and cut through the core into 12 wedges", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "head", "item": "iceberg lettuce", "preparation": "trimmed and cut through the core into 12 wedges", "optional": false}, {"position": 12, "raw": "3 scallions, green part only, cut in thin slices on a sharp bias", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "green part only, cut in thin slices on a sharp bias", "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. In a medium skillet over medium heat, cook bacon until crisp. Remove with a slotted spoon and drain on paper towels, reserving the skillet with bacon fat. Brush bread slices on both sides with bacon fat. Place bread on a baking sheet, and bake until golden brown, turning once, about 5 minutes a side. Remove from oven, and reserve."}, {"position": 2, "text": "In a small bowl, combine buttermilk, cheese, lemon juice, vinegar, shallots, parsley and cayenne. Whisk to blend. Season to taste with salt and pepper."}, {"position": 3, "text": "On each of 6 plates, place 2 slices of bread. Arrange a lettuce wedge on top of each bread slice."}, {"position": 4, "text": "Pour dressing over the wedges. Sprinkle with bacon and scallions. Serve."}], "nutrition": {"calories": 266.0, "protein_g": 12.6, "carbohydrates_g": 21.8, "fat_g": 14.8, "satur
, "item": "flaked leftover cooked fish such as salmon", "preparation": "cod or red snapper", "optional": false}, {"position": 18, "raw": "2 tablespoons lime juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "lime juice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat a large nonstick pan over medium heat. Add mustard seeds and cook, shaking pan, for 40 seconds, until seeds start to pop. Add butter and let it melt. Lower heat to medium-low. Stir in the curry powder and cumin. Cook, stirring, for 40 seconds."}, {"position": 2, "text": "Stir in the onion and cook, stirring occasionally, for 5 minutes. Stir in the garlic, ginger and anise seed. Cook, stirring, for 5 minutes."}, {"position": 3, "text": "Add potatoes, raise heat to medium and cook, turning occasionally, for 9 minutes or until potatoes begin to brown. Stir in the celery, red pepper and jalapeno pepper. Cook, stirring occasionally, for 5 minutes."}, {"position": 4, "text": "Meanwhile whisk together the egg, milk, salt and mint. Pour this over the potato mixture. Stir in the fish and lime juice. Press the mixture into the pan with the back of a spoon to make a cake. Cook, over medium heat, for 15 minutes, until the cake is set and the bottom has formed a crust."}, {"position": 5, "text": "Invert onto a large round serving platter so the crusty side is up."}], "nutrition": null, "tags": {"cuisine": ["caribbean"], "diet": [], "course": ["main course"], "meal": ["breakfast"], "occasion": [], "other": ["boil", "fish", "saute", "white potato"]}, "images": [], "rating": {"average": 4.0, "count": 25}, "video_url": null, "comment_count": null, "published_at": "1997-12-31", "scraped_at": "2026-09-07T03:28:01.128248+00:00", "scraper_version": "1.0.0"}

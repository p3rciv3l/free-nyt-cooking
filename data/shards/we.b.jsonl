l, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "Pinch cayenne", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch cayenne", "preparation": null, "optional": false}, {"position": 10, "raw": "Kosher salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "1 ½ heads iceberg lettuce, trimmed and cut through the core into 12 wedges", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "head", "item": "iceberg lettuce", "preparation": "trimmed and cut through the core into 12 wedges", "optional": false}, {"position": 12, "raw": "3 scallions, green part only, cut in thin slices on a sharp bias", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "green part only, cut in thin slices on a sharp bias", "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. In a medium skillet over medium heat, cook bacon until crisp. Remove with a slotted spoon and drain on paper towels, reserving the skillet with bacon fat. Brush bread slices on both sides with bacon fat. Place bread on a baking sheet, and bake until golden brown, turning once, about 5 minutes a side. Remove from oven, and reserve."}, {"position": 2, "text": "In a small bowl, combine buttermilk, cheese, lemon juice, vinegar, shallots, parsley and cayenne. Whisk to blend. Season to taste with salt and pepper."}, {"position": 3, "text": "On each of 6 plates, place 2 slices of bread. Arrange a lettuce wedge on top of each bread slice."}, {"position": 4, "text": "Pour dressing over the wedges. Sprinkle with bacon and scallions. Serve."}], "nutrition": {"calories": 266.0, "protein_g": 12.6, "carbohydrates_g": 21.8, "fat_g": 14.8, "satur
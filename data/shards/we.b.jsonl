null, "unit": "tsp", "item": "anise seed", "preparation": null, "optional": false}, {"position": 9, "raw": "1 pound mashing potatoes, cooked, peeled, cooled and cut into ½ inch cubes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "mashing potatoes", "preparation": "cooked, peeled, cooled and cut into ½ inch cubes", "optional": false}, {"position": 10, "raw": "2 medium ribs celery, peeled and cut in ¼-inch dice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium ribs celery", "preparation": "peeled and cut in ¼-inch dice", "optional": false}, {"position": 11, "raw": "1 medium red pepper, seeded and cut in ¼-inch dice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium red pepper", "preparation": "seeded and cut in ¼-inch dice", "optional": false}, {"position": 12, "raw": "1 medium jalapeno pepper, seeded and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium jalapeno pepper", "preparation": "seeded and minced", "optional": false}, {"position": 13, "raw": "1 egg, lightly beaten", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": "lightly beaten", "optional": false}, {"position": 14, "raw": "⅔ cup milk", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 15, "raw": "1 tablespoon kosher salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 16, "raw": "2 tablespoons minced mint leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced mint leaves", "preparation": null, "optional": false}, {"position": 17, "raw": "2 cups flaked leftover cooked fish such as salmon, cod or red snapper", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "flaked leftover cooked fish such as salmon", "preparation": "cod or red snapper", "optional": false}, {"position": 18, "raw": "2 tablespoons lime juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "lime juice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat a large nonstick pan over medium heat. Add mustard seeds and cook, shaking pan, for 40 seconds, until seeds start to pop. Add butter and let it melt. Lower heat to medium-low. Stir in the curry powder and cumin. Cook, stirring, for 40 seconds."}, {"position": 2, "text": "Stir in the onion and cook, stirring occasionally, for 5 minutes. Stir in the garlic, ginger and anise seed. Cook, stirring, for 5 minutes."}, {"position": 3, "text": "Add potatoes, raise heat to medium and cook, turning occasionally, for 9 minutes or until potatoes begin to brown. Stir in the celery, red pepper and jalapeno pepper. Cook, stirring occasionally, for 5 minutes."}, {"position": 4, "text": "Meanwhile whisk together the egg, milk, salt and mint. Pour this over the potato mixture. Stir in the fish and lime juice. Press the mixture into the pan with the back of a spoon to make a cake. Cook, over medium heat, for 15 minutes, until the cake is set and the bottom has formed a crust."}, {"position": 5, "text": "Invert onto a large round serving platter so the crusty side is up."}], "nutrition": null, "tags": {"cuisine": ["caribbean"], "diet": [], "course": ["main course"], "meal": ["breakfast"], "occasion": [], "other": ["boil", "fish", "saute", "white potato"]}, "images": [], "rating": {"average": 4.0, "count": 25}, "video_url": null, "comment_count": null, "published_at": "1997-12-31", "scraped_at": "2026-09-07T03:28:01.128248+00:00", "scraper_version": "1.0.0"}

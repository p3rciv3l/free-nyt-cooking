{"slug": "endive-and-apple-salad-with-spiced-walnuts", "nyt_id": 1014609, "url": "https://cooking.nytimes.com/recipes/1014609-endive-and-apple-salad-with-spiced-walnuts", "name": "Endive and Apple Salad With Spiced Walnuts", "author": "Melissa Clark", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "1 egg white", "group": null, "quantity": 1.0, "unit": null, "item": "egg white", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon fine sea salt, more to taste", "group": null, "quantity": 1.0, "unit": "tsp", "item": "fine sea salt", "preparation": "more to taste", "optional": false}, {"position": 3, "raw": "⅔ cup light brown sugar", "group": null, "quantity": 0.6666666666666666, "unit": "cup", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ tablespoons Passover wine, ruby port or grape juice", "group": null, "quantity": 1.5, "unit": "tbsp", "item": "passover wine", "preparation": "ruby port or grape juice", "optional": false}, {"position": 5, "raw": "1 teaspoon ground cinnamon", "group": null, "quantity": 1.0, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 6, "raw": "Pinch cayenne (optional)", "group": null, "quantity": null, "unit": null, "item": "pinch cayenne", "preparation": null, "optional": true}, {"position": 7, "raw": "1 pound walnut halves", "group": null, "quantity": 1.0, "unit": "lb", "item": "walnut halves", "preparation": null, "optional": false}, {"position": 8, "raw": "1 small shallot, thinly sliced", "group": null, "quantity": 1.0, "unit": null, "item": "small shallot", "preparation": "thinly sliced", "optional": false}, {"position": 9, "raw": "1 ½ tablespoons red wine vinegar", "group": null, "quantity": 1.5, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 10, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 11, "raw": "2 apples, cored and thinly sliced", "group": null, "quantity": 2.0, "unit": null, "item": "apples", "preparation": "cored and thinly sliced", "optional": false}, {"position": 12, "raw": "2 large or 3 small endive heads, thinly sliced crosswise into rounds", "group": null, "quantity": 2.0, "unit": null, "item": "large or 3 small endive heads", "preparation": "thinly sliced crosswise into rounds", "optional": false}, {"position": 13, "raw": "3 cups arugula, packed", "group": null, "quantity": 3.0, "unit": "cup", "item": "arugula", "preparation": "packed", "optional": false}, {"position": 14, "raw": "Black pepper and flaky sea salt", "group": null, "quantity": null, "unit": null, "item": "black pepper and flaky sea salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 300 degrees. Cover a rimmed baking sheet with a nonstick liner or parchment paper. In a large bowl, whisk together egg white and ½ teaspoon salt until frothy. Whisk in sugar, wine, cinnamon and cayenne (if desired) until smooth. Add nuts and toss until they are well coated with egg mixture."}, {"position": 2, "text": "Spread nuts on baking sheet and bake for 30 minutes, stirring halfway through. The nuts should be glazed and golden at the edges. Let cool. Coarsely chop 1 cup of the nuts (save the rest for noshing)."}, {"position": 3, "text": "Prepare the salad: In a large bowl, combine shallot, vinegar and remaining ½ teaspoon salt, and toss well. Let sit for 10 minutes, then whisk in olive oil. Add apples, and toss to coat."}, {"position": 4, "text": "Put endive and arugula in a salad bowl. Add apple mixture and chopped nuts, and toss well. Season to taste with more salt and black pepper, and serve at once."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 724.8333333333334, "protein_g": 12.8, "carbohydrates_g": 37.5, "fat_g": 63.0, "saturated_fat_g": 6.5, "unsaturated_fat_g": 37.2, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 406.6, "fiber_g": 7.7, "sugar_g": 24.7, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["salad"], "meal": [], "occasion": [], "other": ["apple", "passover", "spring"]}, "images": [{"url": "https://static01.nyt.com/images/2013/03/20/dining/20APPE_SPAN/20APPE-superJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 146}, "video_url": null, "comment_count": null, "published_at": "2013-03-20", "scraped_at": "2026-09-06T23:53:31Z", "scraper_version": "1.0.0"}
{"slug": "endive-and-quinoa-salad-with-poached-egg", "nyt_id": 1013890, "url": "https://cooking.nytimes.com/recipes/1013890-endive-and-quinoa-salad-with-poached-egg", "name": "Endive and Quinoa Salad With Poached Egg", "author": "Martha Rose Shulman", "description": "If you hesitate to buy salad greens that could wilt before you have a chance to use them, endive is a perfect solution. The tight bulbs will keep in your crisper for about a week without deteriorating. Make the dressing and keep what you don’t use in the refrigerator. It will keep until you use it up.", "servings": {"text": "1 main-dish serving", "min": 1, "max": 1, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "PT30M"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons red wine vinegar, Champagne vinegar or sherry vinegar (sherry vinegar is my preference)", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "red wine vinegar", "preparation": "Champagne vinegar or sherry vinegar (sherry vinegar is my preference)", "optional": false}, {"position": 2, "raw": "1 teaspoon balsamic vinegar (optional)", "group": null, "quantity": 1.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": true}, {"position": 3, "raw": "Salt, preferably coarse sea salt or fleur de sel, to taste", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": "preferably coarse sea salt or fleur de sel, to taste", "optional": false}, {"position": 4, "raw": "1 teaspoon Dijon mustard", "group": null, "quantity": 1.0, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 5, "raw": "6 tablespoons extra virgin olive oil, or 4 tablespoons olive oil", "group": null, "quantity": 6.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": "or 4 tablespoons olive oil", "optional": false}, {"position": 6, "raw": "2 tablespoons walnut oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "walnut oil", "preparation": null, "optional": false}, {"position": 7, "raw": "1 garlic clove, crushed", "group": null, "quantity": 1.0, "unit": null, "item": "garlic clove", "preparation": "crushed", "optional": false}, {"position": 8, "raw": "½ cup cooked quinoa", "group": null, "quantity": 0.5, "unit": "cup", "item": "cooked quinoa", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ½ endives, preferably a mix of red and green, cut crosswise into ¾-inch slices", "group": null, "quantity": 1.5, "unit": null, "item": "endives", "preparation": "preferably a mix of red and green, cut crosswise into ¾-inch slices", "optional": false}, {"position": 10, "raw": "2 white or cremini mushrooms, thinly sliced", "group": null, "quantity": 2.0, "unit": null, "item": "white or cremini mushrooms", "preparation": "thinly sliced", "optional": false}, {"position": 11, "raw": "¼ yellow bell pepper, cut crosswise in thin slices", "group": null, "quantity": 0.25, "unit": null, "item": "yellow bell pepper", "preparation": "cut crosswise in thin slices", "optional": false}, {"position": 12, "raw": "1 teaspoon chopped fresh herbs, like tarragon and chives", "group": null, "quantity": 1.0, "unit": "tsp", "item": "chopped fresh herbs", "preparation": "like tarragon and chives", "optional": false}, {"position": 13, "raw": "¼ ounce (1 tablespoon) slivered Parmesan", "group": null, "quantity": 0.25, "unit": "oz", "item": "slivered parmesan", "preparation": null, "optional": false}, {"position": 14, "raw": "1 egg, poached", "group": null, "quantity": 1.0, "unit": null, "item": "egg", "preparation": "poached", "optional": false}], "steps": [{"position": 1, "text": "Make the dressing first so that the garlic, which you’ll pull out before tossing the salad, can marinate. In a bowl or a glass measuring cup, whisk together the vinegars, salt, pepper and mustard. Whisk in the oils and add the garlic, which should be crushed so that it infuses the dressing. Let sit for 15 minutes. Remove the garlic, whisk the dressing and measure out 1 ½ tablespoons. Transfer the remaining dressing to a jar or a squeeze bottle and refrigerate."}, {"position": 2, "text": "Combine the quinoa, endives, mushrooms, yellow pepper, herbs and Parmesan in a salad bowl. Add the 1 ½ tablespoons dressing and toss together."}, {"position": 3, "text": "Poach the egg, if you have not done so already. Top the salad with the poached egg and enjoy."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 1209.0, "protein_g": 14.5, "carbohydrates_g": 30.1, "fat_g": 116.4, "saturated_fat_g": 16.3, "unsaturated_fat_g": 27.7, "trans_fat_g": null, "cholesterol_mg": 164.8, "sodium_mg": 1036.5, "fiber_g": 6.2, "sugar_g": 2.3, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-salad"], "meal": [], "occasion": [], "other": ["egg", "for-one", "quinoa"]}, "images": [{"url": "https://static01.nyt.com/images/2011/10/25/science/26recipehealth/26recipehealth-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2011/10/25/science/26recipehealth/26recipehealth-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "2011-10-26", "scraped_at": "2026-09-06T23:47:10Z", "scraper_version": "1.0.0"}
{"slug": "endive-and-radicchio-salad-with-caramelized-pear", "nyt_id": 1015027, "url": "https://cooking.nytimes.com/recipes/1015027-endive-and-radicchio-salad-with-caramelized-pear", "name": "Endive and Radicchio Salad With Caramelized Pear", "author": "Tara Parker-Pope", "description": "This recipe came to The Times from Bruno Davaillon, the executive chef of the celebrated Rosewood Mansion on Turtle Creek restaurant in Dallas. It is an elegant twist on the ubiquitous blue cheese-pear salad combination. Grilling the radicchio removes the bitterness from the leafy green, helping it to better complement the pears and endive.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "3 Comice pears", "group": null, "quantity": 3.0, "unit": null, "item": "comice pears", "preparation": null, "optional": false}, {"position": 2, "raw": "Olive oil, for drizzle", "group": null, "quantity": null, "unit": null, "item": "olive oil", "preparation": "for drizzle", "optional": false}, {"position": 3, "raw": "Honey, for drizzle", "group": null, "quantity": null, "unit": null, "item": "honey", "preparation": "for drizzle", "optional": false}, {"position": 4, "raw": "1 tablespoon allspice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "allspice", "preparation": null, "optional": false}, {"position": 5, "raw": "Butter, one pat", "group": null, "quantity": null, "unit": null, "item": "butter", "preparation": "one pat", "optional": false}, {"position": 6, "raw": "3 ounces Roquefort style blue cheese", "group": null, "quantity": 3.0, "unit": "oz", "item": "roquefort style blue cheese", "preparation": null, "optional": false}, {"position": 7, "raw": "5 ounces butter, softened", "group": null, "quantity": 5.0, "unit": "oz", "item": "butter", "preparation": "softened", "optional": false}, {"position": 8, "raw": "1 teaspoon Worcestershire sauce", "group": null, "quantity": 1.0, "unit": "tsp", "item": "worcestershire sauce", "preparation": null, "optional": false}, {"position": 9, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 10, "raw": "Pepper", "group": null, "quantity": null, "unit": null, "item": "pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "3 tablespoons flour", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 12, "raw": "2 eggs, beaten", "group": null, "quantity": 2.0, "unit": null, "item": "eggs", "preparation": "beaten", "optional": false}, {"position": 13, "raw": "3 tablespoons Panko style bread crumbs", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "panko style bread crumbs", "preparation": null, "optional": false}, {"position": 14, "raw": "Cooking oil for deep frying (such as olive or peanut oil)", "group": null, "quantity": null, "unit": null, "item": "cooking oil for deep frying", "preparation": null, "optional": false}, {"position": 15, "raw": "2 ounces walnuts, chopped", "group": null, "quantity": 2.0, "unit": "oz", "item": "walnuts", "preparation": "chopped", "optional": false}, {"position": 16, "raw": "1 shallot, minced", "group": null, "quantity": 1.0, "unit": null, "item": "shallot", "preparation": "minced", "optional": false}, {"position": 17, "raw": "2 tablespoons walnut oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "walnut oil", "preparation": null, "optional": false}, {"position": 18, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 19, "raw": "Pepper", "group": null, "quantity": null, "unit": null, "item": "pepper", "preparation": null, "optional": false}, {"position": 20, "raw": "3 endives", "group": null, "quantity": 3.0, "unit": null, "item": "endives", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel the pears, cut them in half and trim to remove the seeds. Reserve one uncooked pear to finish the salad, and roast the remaining two. Preheat oven to 400 degrees Fahrenheit. Place the two pears cut side down on a baking sheet lined with parchment paper. Drizzle pears with olive oil, honey and allspice and top with a small pat of butter. Cover with aluminum foil and bake for 20 minutes. Set aside."}, {"position": 2, "text": "Make the blue cheese fritters. Combine cheese and butter in a mixing bowl until soft and fully incorporated. Add Worcestershire sauce and salt and pepper to taste. Form into small balls and refrigerate for 15 minutes, or until firm. Once firm, roll the balls between your palms to obtain a perfectly round shape. Dredge balls in flour, then beaten egg, then bread crumbs. The uncooked fritters can be reserved in the refrigerator until ready to fry. To fry, heat enough oil to cover the fritters in a fryer to 375 degrees. Add fritters to the pan and fry until golden brown."}, {"position": 3, "text": "Make the walnut dressing. Toast walnuts in sauté pan for five minutes. Allow to cool, then chop. In a separate bowl, combine honey and ice wine vinegar and mix well. Add minced shallot and walnut oil. Mix with chopped walnuts and salt and pepper to taste."}, {"position": 4, "text": "Make the salad. Cut radicchio in half and drizzle with olive oil and season with salt and pepper. Cook on hot grill for a couple of minutes on each side. Slice washed and dried endive into long strips."}, {"position": 5, "text": "To assemble the salad, lay roasted radicchio on large plate. Season endive with walnut dressing and arrange around the radicchio. Top with roasted pear and freshly fried fritters. Finish with raw pear shavings."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 859.5, "protein_g": 14.3, "carbohydrates_g": 49.0, "fat_g": 71.1, "saturated_fat_g": 27.7, "unsaturated_fat_g": 16.1, "trans_fat_g": null, "cholesterol_mg": 180.1, "sodium_mg": 889.5, "fiber_g": 9.7, "sugar_g": 23.3, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["salad"], "meal": [], "occasion": [], "other": ["fall", "pear", "radicchio", "thanksgiving"]}, "images": [{"url": "https://static01.nyt.com/images/2010/11/19/science/18welldallas/18welldallas-superJumbo.jpg", "alt": "Endive and Radicchio Salad With Caramelized Pear, Walnut-Ice Wine Vinegar Dressing and Blue Cheese Fritters", "primary": true}, {"url": "https://static01.nyt.com/images/2010/11/19/science/18welldallas/18welldallas-facebookJumbo-v2.jpg", "alt": "Endive and Radicchio Salad With Caramelized Pear, Walnut-Ice Wine Vinegar Dressing and Blue Cheese Fritters", "primary": false}], "rating": {"average": 4.0, "count": 18}, "video_url": null, "comment_count": null, "published_at": "2010-11-09", "scraped_at": "2026-09-06T23:56:44Z", "scraper_version": "1.0.0"}
{"slug": "endive-apple-and-walnut-salad", "nyt_id": 1014025, "url": "https://cooking.nytimes.com/recipes/1014025-endive-apple-and-walnut-salad", "name": "Endive, Apple and Walnut Salad", "author": "Martha Rose Shulman", "description": "This classic French combination makes a great autumn and winter salad. Walnuts and apples are always a good mix, and their flavors contrast nicely with the bitter endive. Gruyère cheese has a nutty flavor and adds a bit of protein, as well.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "1 pound (about 6) Belgian endives", "group": null, "quantity": 1.0, "unit": "lb", "item": "belgian endives", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tart apple", "group": null, "quantity": 1.0, "unit": null, "item": "tart apple", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon freshly squeezed lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "freshly squeezed lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "Scant ½ cup broken walnut pieces", "group": null, "quantity": null, "unit": null, "item": "scant ½ cup broken walnut pieces", "preparation": null, "optional": false}, {"position": 5, "raw": "1 ½ ounces Gruyère cheese, cut in thin slivers about ⅓ heaped cup", "group": null, "quantity": 1.5, "unit": "oz", "item": "gruyère cheese", "preparation": "cut in thin slivers about ⅓ heaped cup", "optional": false}, {"position": 6, "raw": "2 tablespoons chopped fresh parsley, or a mix of chopped fresh parsley and chives", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped fresh parsley", "preparation": "or a mix of chopped fresh parsley and chives", "optional": false}, {"position": 7, "raw": "1 tablespoon chopped fresh tarragon", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "chopped fresh tarragon", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon sherry vinegar or champagne vinegar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "sherry vinegar or champagne vinegar", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon freshly squeezed lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "freshly squeezed lemon juice", "preparation": null, "optional": false}, {"position": 10, "raw": "1 teaspoon balsamic vinegar", "group": null, "quantity": 1.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "1 teaspoon Dijon mustard", "group": null, "quantity": 1.0, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 12, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 13, "raw": "freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 14, "raw": "3 tablespoons walnut oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "walnut oil", "preparation": null, "optional": false}, {"position": 15, "raw": "4 tablespoons extra virgin olive oil", "group": null, "quantity": 4.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Remove any damaged outer leaves of the endives and rinse with cold water. Dry with paper towels, then separate the leaves, or slice crosswise, about ½ inch thick. Place in a wide salad bowl. Add the walnuts, gruyère, parsley and tarragon."}, {"position": 2, "text": "Quarter the apple and cut away the core, then slice very thin (you should have at least 16 slices). Place in a bowl of water acidulated with 1 tablespoon lemon juice."}, {"position": 3, "text": "Whisk together the vinegars, lemon juice, mustard, salt, and pepper. Whisk in the oils. Taste and adjust seasonings."}, {"position": 4, "text": "Drain the apple slices, dry on paper towels, then add to the salad bowl. Toss with the dressing and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 270.3333333333333, "protein_g": 4.7, "carbohydrates_g": 9.6, "fat_g": 24.9, "saturated_fat_g": 3.9, "unsaturated_fat_g": 10.2, "trans_fat_g": null, "cholesterol_mg": 7.8, "sodium_mg": 351.8, "fiber_g": 4.1, "sugar_g": 3.4, "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["dinner-salad"], "meal": [], "occasion": [], "other": ["easy", "fall", "quick"]}, "images": [{"url": "https://static01.nyt.com/images/2009/09/30/health/30recipehealth_600/30recipehealth_600-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2009/09/30/health/30recipehealth_600/30recipehealth_600-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 121}, "video_url": null, "comment_count": null, "published_at": "2009-09-30", "scraped_at": "2026-09-06T23:48:36Z", "scraper_version": "1.0.0"}

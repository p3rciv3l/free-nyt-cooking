{"slug": "black-bean-burgers", "nyt_id": 12221, "url": "https://cooking.nytimes.com/recipes/12221-black-bean-burgers", "name": "Black Bean Burgers", "author": "Mark Bittman", "description": "Also known as McBitty's Bean Burgers, these veggie burgers from Mark Bittman are loaded with black beans, porcini mushrooms, garlic, smoked paprika (or chili powder) and soy sauce, for a satisfying patty you can serve with all the usual burger fixings.", "servings": {"text": "8 small burgers, 4 supersize", "min": 8, "max": 8, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "35 to 45 minutes with cooked beans"}}, "ingredients": [{"position": 1, "raw": "¼ cup dried, stemless porcini mushrooms", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dried", "preparation": "stemless porcini mushrooms", "optional": false}, {"position": 2, "raw": "2 cups cooked or drained canned black beans", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "cooked or drained canned black beans", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon roughly chopped garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "roughly chopped garlic", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup rolled oats, or more if needed", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "rolled oats", "preparation": "or more if needed", "optional": false}, {"position": 5, "raw": "2 teaspoons smoked paprika or chili powder", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "smoked paprika or chili powder", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon cumin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cumin", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 8, "raw": "Salt and black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and black pepper", "preparation": null, "optional": false}, {"position": 9, "raw": "Bean-cooking liquid, porcini soaking liquid or water", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "bean-cooking liquid", "preparation": "porcini soaking liquid or water", "optional": false}, {"position": 10, "raw": "¼ cup chopped cilantro", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped cilantro", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak the mushrooms in hot water for 5 to 10 minutes; roughly chop."}, {"position": 2, "text": "Put the mushrooms, beans, garlic, oats, spices and soy sauce in a food processor with a sprinkle of salt and pepper. Let the machine run until the mixture is combined, not puréed, about 30 seconds. (Or use a potato masher.) Add oats to thicken, or liquid to thin, as needed."}, {"position": 3, "text": "Stir in the cilantro, and let sit for 5 minutes."}, {"position": 4, "text": "Shape into 4 large or 8 small patties; let them sit for 5 minutes."}, {"position": 5, "text": "Put the oil in a large skillet over medium-low heat. Cook until crisp on one side, about 5 minutes. Flip and cook until the burgers are crisp on the other side, another 5 minutes or so. Serve with the usual fixings."}], "nutrition": {"calories": 118.6, "protein_g": 5.1, "carbohydrates_g": 16.2, "fat_g": 4.2, "saturated_fat_g": 0.6, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 194.3, "fiber_g": 5.2, "sugar_g": 0.4, "unsaturated_fat_g": 3.3, "s
{"slug": "blueberry-crumble", "nyt_id": 10453, "url": "https://cooking.nytimes.com/recipes/10453-blueberry-crumble", "name": "Blueberry Crumble", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": 20, "cook_minutes": 40, "total_minutes": 55, "raw": {"total": "55 minutes", "prep": "20 minutes", "cook": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pints blueberries", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "pint", "item": "blueberries", "preparation": null, "optional": false}, {"position": 2, "raw": "Juice of ½ lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of ½ lemon", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon instant tapioca", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "instant tapioca", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup plus 2 tablespoons sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "plus 2 tablespoons sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "6 tablespoons cold unsalted butter", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "cold unsalted butter", "preparation": null, "optional": false}, {"position": 6, "raw": "1 cup all-purpose flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 7, "raw": "Pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon grated lemon peel", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "grated lemon peel", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preh
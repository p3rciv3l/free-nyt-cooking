tional": false}, {"position": 9, "raw": "¼ teaspoon Cayenne pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cayenne pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ teaspoon cumin", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cumin", "preparation": null, "optional": false}, {"position": 11, "raw": "3 cloves garlic, minced", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 12, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ cup of dark rum", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "of dark rum", "preparation": null, "optional": false}, {"position": 14, "raw": "½ cup sour cream", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Pick over the beans. Put them in a large saucepan and add water to cover. Bring to boil, drain and add fresh water to cover."}, {"position": 2, "text": "Add the remaining ingredients except the rum and sour cream and simmer, covered, for about two hours, or until the beans are tender. Add more water as necessary and stir frequently."}, {"position": 3, "text": "When the beans are cooked, puree them in a food processor until smooth. Serve the soup in heated bowls garnished with a teaspoon of rum and a dollop of sour cream."}], "nutrition": {"calories": 267.9, "protein_g": 13.6, "carbohydrates_g": 43.0, "fat_g": 4.1, "saturated_fat_g": 1.8, "trans_fat_g": 0.1, "cholesterol_mg": 8.5, "sodium_mg": 981.3, "fiber_g": 11.5, "sugar_g": 3.1, "unsaturated_fat_g": 1.3, "source": "nyt", "basis": "per_servi
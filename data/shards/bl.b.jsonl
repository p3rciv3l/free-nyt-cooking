ped fresh pineapple", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "finely chopped fresh pineapple", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon hot red-pepper flakes", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "hot red-pepper flakes", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ teaspoons salt", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup chopped cilantro", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped cilantro", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak beans overnight in cold water."}, {"position": 2, "text": "Drain and rinse the beans and place in a saucepan with the onion and chopped garlic. Cover with 6 cups of cold water and simmer over medium heat until tender but firm, 30 to 40 minutes. Drain. Rinse in cold water until chilled. (You should have about 8 cups.)"}, {"position": 3, "text": "In a large mixing bowl, combine the cooked beans with all the remaining ingredients and toss well. Set aside until ready to serve."}], "nutrition": {"calories": 243.5, "protein_g": 11.7, "carbohydrates_g": 49.9, "fat_g": 1.1, "saturated_fat_g": 0.3, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 296.3, "fiber_g": 9.8, "sugar_g": 16.4, "unsaturated_fat_g": 0.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["southwestern"], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": [], "meal": [], "occasion": ["father’s day", "memorial day"], "other": ["black bean", "condiments", "mango", "pineapple", "spring"]}, "images": [], "rating": {"average": 4.0, "count": 20}, "video_url": null, "comment_count": null, "published_at": "1993-06-06", "scraped_at": "2026-09-06T22:33:02.175088+00:00", "scraper_version":
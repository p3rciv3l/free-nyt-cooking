{"slug": "black-rice-and-red-lentil-salad", "nyt_id": 12274, "url": "https://cooking.nytimes.com/recipes/12274-black-rice-and-red-lentil-salad", "name": "Black Rice and Red Lentil Salad", "author": "Martha Rose Shulman", "description": "This colorful mixture is hard to resist, with its contrasting chewy and crunchy textures and the nutty Asian dressing. Black rice, high in antioxidant-rich anthocyanins, is now a staple in my pantry.", "servings": {"text": "3 to 4 generous servings.", "min": 3, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "½ cup black rice, like Forbidden Rice or Lundberg Black Japonica", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "black rice", "preparation": "like Forbidden Rice or Lundberg Black Japonica", "optional": false}, {"position": 2, "raw": "1 ¼ cups water", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup fresh or frozen edamame", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "fresh or frozen edamame", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup red lentils, soaked in cold water to cover for 2 or 3 hours and drained", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "red lentils", "preparation": "soaked in cold water to cover for 2 or 3 hours and drained", "optional": false}, {"position": 6, "raw": "¼ cup broken walnuts", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "broken walnuts", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon seasoned rice vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "seasoned rice vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon fresh lime juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lime juice", "preparation": null, "optional": false}, {"position": 9, "raw": "Pinch of cayenne (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of cayenne", "preparation": null, "optional": true}, {"position": 10, "raw": "1 teaspoon finely chopped or grated fresh ginger", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely chopped or grated fresh ginger", "preparation": null, "optional": false}, {"position": 11, "raw": "Soy sauce to taste (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "soy sauce to taste", "preparation": null, "optional": true}, {"position": 12, "raw": "1 tablespoon dark sesame oil or walnut oil (substitute olive oil or grapeseed oil if you are allergic to tree nuts or sesame seeds)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dark sesame oil or walnut oil (substitute olive oil or grapeseed oil if you are allergic to tree nuts or sesame seeds)", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons grapeseed oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "grapeseed oil", "preparation": null, "optional": false}, {"position": 14, "raw": "2 tablespoons chopped cilantro", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped cilantro", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine the rice, water and salt to taste in a small saucepan and bring to a boil. Cover, reduce the heat and simmer 40 to 50 minutes, until all of the liquid in the pan has been absorbed by the rice. Remove from the heat. Remove the lid, place a clean dish towel over the pan and return the lid. Let sit for 10 to 15 minutes."}, {"position": 2, "text": "Meanwhile, if using frozen edamame, cook it, following the directions on the package."}, {"position": 3, "text": "In a medium bowl, toss together the rice, edamame, lentils, walnuts and cilantro. In a small bowl or measuring cup, whisk together the rice vinegar, lime juice, ginger, soy sauce, cayenne, sesame or walnut oil and grapeseed oil. Toss with the salad. Refrigerate in a bowl or in containers until ready to take to work or eat."}], "nutrition": {"calories": 330.7, "protein_g": 10.9, "carbohydrates_g": 36.2, "fat_g": 16.7, "saturated_fat_g": 1.8, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 389.8, "fiber_g": 4.7, "sugar_g": 1.2, "unsaturated_fat_g": 13.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "healthy", "high fiber", "low-sodium", "vegan", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["boil", "edamame", "lentil", "low cholesterol", "salad", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2012/01/24/science/24recipehealth/24recipehealth-facebookJumbo-v2.jpg", "alt": "Black Rice and Red Lentil Salad", "primary": true}], "rating": {"average": 5.0, "count": 415}, "video_url": null, "comment_count": null, "published_at": "2012-01-24", "scraped_at": "2026-09-06T23:54:43.172202+00:00", "scraper_version": "1.0.0"}
{"slug": "blackberry-and-vanilla-bean-custard-parfait", "nyt_id": 10579, "url": "https://cooking.nytimes.com/recipes/10579-blackberry-and-vanilla-bean-custard-parfait", "name": "Blackberry And Vanilla Bean Custard Parfait", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes plus soaking overnight"}}, "ingredients": [{"position": 1, "raw": "1 cup raw cashews, soaked overnight in water and drained", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "raw cashews", "preparation": "soaked overnight in water and drained", "optional": false}, {"position": 2, "raw": "1 cup meat from fresh young (green) coconut; if not available increase soaked cashews to 2 cups", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "meat from fresh young (green) coconut; if not available increase soaked cashews to 2 cups", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ teaspoon seeds from vanilla bean, preferably Tahitian", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "seeds from vanilla bean", "preparation": "preferably Tahitian", "optional": false}, {"position": 4, "raw": "⅓ cup pure maple syrup", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "pure maple syrup", "preparation": null, "optional": false}, {"position": 5, "raw": "1 sprig fresh lavender or thyme", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "fresh lavender or thyme", "preparation": null, "optional": false}, {"position": 6, "raw": "1 pint fresh blackberries", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "fresh blackberries", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons honey, preferably thistle", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "honey", "preparation": "preferably thistle", "optional": false}, {"position": 8, "raw": "2 tablespoons chopped unsalted nuts", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped unsalted nuts", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "For the custard, place half the cashews and coconut in blender with ¼ to ½ cup water, as needed, to blend until smooth. Add remaining cashews and coconut and vanilla and maple syrup. Blend. Refrigerate until cold."}, {"position": 2, "text": "Crush lavender or thyme in a mortar. Place in a large bowl, and add blackberries and honey. Gently crush together with back of a spoon, leaving some berries whole."}, {"position": 3, "text": "Layer custard and berries in 4 martini glasses or goblets, top with nuts and serve."}], "nutrition": {"calories": 412.5, "protein_g": 15.8, "carbohydrates_g": 49.2, "fat_g": 19.6, "saturated_fat_g": 3.8, "trans_fat_g": 0.1, "cholesterol_mg": 22.1, "sodium_mg": 36.6, "fiber_g": 5.4, "sugar_g": 34.6, "unsaturated_fat_g": 14.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["blackberry", "vanilla bean"]}, "images": [], "rating": {"average": 3.0, "count": 7}, "video_url": null, "comment_count": null, "published_at": "2002-08-07", "scraped_at": "2026-09-06T22:29:43.249081+00:00", "scraper_version": "1.0.0"}
{"slug": "blackberry-napoleon-with-lemon-cream", "nyt_id": 787251800, "url": "https://cooking.nytimes.com/recipes/787251800-blackberry-napoleon-with-lemon-cream", "name": "Blackberry Napoleon With Lemon Cream", "author": "David Tanis", "description": "Blackberries, lemon and cream are a winning combination, and, if you’re up for it, blackberry Napoleon is a relatively easy and fun dessert to assemble using store-bought puff pastry. Once the various components are ready — the pastry, the lemon curd, the whipped cream and the berries — it takes only a few minutes to put together. It’s basically a dessert sandwich: You mix whipped cream and lemon curd together and spread it over a sheet of pre-baked crisp flaky puff pastry. Scattered with juicy berries and topped with another pastry layer, it’s a dreamy finale for a fine cold supper.", "servings": {"text": "8-10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 60, "total_minutes": 65, "raw": {"total": "1 hr 5 min", "prep": "PT0H5M", "cook": "PT1H0M"}}, "ingredients": [{"position": 1, "raw": "3 large eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup/50 grams sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": null, "item": "cup/50 grams sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "Pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon lemon zest", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "lemon zest", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup/120 milliliters lemon juice (from 3 lemons)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "cup/120 milliliters lemon juice (from 3 lemons)", "preparation": null, "optional": false}, {"position": 6, "raw": "4 tablespoons/57 grams unsalted butter, cut into pieces", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "tablespoons/57 grams unsalted butter", "preparation": "cut into pieces", "optional": false}, {"position": 7, "raw": "Ice", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "ice", "preparation": null, "optional": false}, {"position": 8, "raw": "1 (12-ounce/340-gram) package frozen puff pastry, thawed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(12-ounce/340-gram) package frozen puff pastry", "preparation": "thawed", "optional": false}, {"position": 9, "raw": "1 cup/240 milliliters heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "cup/240 milliliters heavy cream", "preparation": null, "optional": false}, {"position": 10, "raw": "½ teaspoon vanilla extract", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 11, "raw": "Powdered sugar, for cream, berries and garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "powdered sugar", "preparation": "for cream, berries and garnish", "optional": false}, {"position": 12, "raw": "2 pints/680 grams blackberries, rinsed and blotted", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "pints/680 grams blackberries", "preparation": "rinsed and blotted", "optional": false}], "steps": [{"position": 1, "text": "Make the lemon curd: In a large bowl, whisk together eggs, sugar, salt and lemon zest."}, {"position": 2, "text": "Put lemon juice in a medium heavy-bottomed saucepan and bring to a boil over high heat, keeping a close eye on it so it doesn’t boil away. Slowly whisk hot lemon juice into egg mixture, then pour it all back into the saucepan."}, {"position": 3, "text": "Cook over medium-high heat, whisking constantly until mixture begins to thicken, about 2 minutes. Continue cooking until the mixture is quite thick, another 2 minutes, then remove from heat. Whisk in the butter until the mixture looks shiny. Set bowl over ice, whisking occasionally until mixture is smooth and cool, then refrigerate. This should yield about 1 ¼ cups. Lemon curd may be prepared a day or two in advance."}, {"position": 4, "text": "Heat oven to 375 degrees."}, {"position": 5, "text": "Open the puff pastry sheet and lay it flat. Cut the sheet into two strips lengthwise (each about 4 ½ by 12 inches). Set strips side-by-side on a parchment lined baking sheet. Bake on the top rack of the oven until puffed and golden, 20 to 25 minutes, taking care not to overcook. If necessary, tent with foil to keep from getting too brown"}, {"position": 6, "text": "Let cool on a rack. Once cool, use a serrated knife to cut through the equator of the puff pastry, dividing both strips into 2 thinner pieces. If the interior of the pastry looks pale or undercooked, return to oven for a few minutes, cut-side-up."}, {"position": 7, "text": "Whip the heavy cream in a chilled bowl with the vanilla and 2 teaspoons powdered sugar until it holds soft peaks. Fold in the chilled lemon curd with a spatula — it’s OK if the mixture is a little streaky."}, {"position": 8, "text": "Assemble: No more than 1 hour before serving, place one of the bottom pieces of baked pastry on a cutting board or a platter. Spread half the lemon-cream mixture across the length."}, {"position": 9, "text": "Quickly toss the berries in a bowl with 1 tablespoon powdered sugar. Scatter half the berries in a layer over the lemon cream."}, {"position": 10, "text": "Carefully place a top piece of pastry strip on top and press it into place. Keep cool but not refrigerated. Dust top with powdered sugar."}, {"position": 11, "text": "Repeat with the other pair of pastry strips, remaining lemon cream and berries.Cut crosswise into wide slices using the serrated knife and serve immediately."}], "nutrition": {"calories": 391.7, "protein_g": 6.1, "carbohydrates_g": 30.6, "fat_g": 28.1, "saturated_fat_g": 12.2, "trans_fat_g": 0.3, "cholesterol_mg": 95.4, "sodium_mg": 128.9, "fiber_g": 4.2, "sugar_g": 11.6, "unsaturated_fat_g": 14.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["peanut-free", "tree nut-free", "soy-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "alcohol-free", "vegetarian", "pescatarian", "low-sodium"], "course": ["dessert"], "meal": [], "occasion": ["party"], "other": ["egg", "lemon zest", "lemon juice", "puff pastry", "heavy cream", "blackberry", "pastries", "bake", "make-ahead", "lemon (flav)", "baking", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2026/08/21/multimedia/21FD-TANIS-COLD-DINNERSREX4-DT-Blackberry-Lemon-Napoleon-ltwz/21FD-TANIS-COLD-DINNERSREX4-DT-Blackberry-Lemon-Napoleon-ltwz-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "2026-08-20", "scraped_at": "2026-09-06T22:28:15.456208+00:00", "scraper_version": "1.0.0"}

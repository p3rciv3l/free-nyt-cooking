{"slug": "blood-orange-salad", "nyt_id": 11341, "url": "https://cooking.nytimes.com/recipes/11341-blood-orange-salad", "name": "Blood-Orange Salad", "author": "Oliver Schwaner-Albright", "description": "Oliver Schwaner-Albright", "servings": {"text": "Serves 6", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 70, "raw": {"total": "About 10 minutes, plus 1 hour's refrigeration"}}, "ingredients": [{"position": 1, "raw": "12 blood oranges, peel and pith removed", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "blood oranges", "preparation": "peel and pith removed", "optional": false}, {"position": 2, "raw": "Pinch red pepper flakes", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch red pepper flakes", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup fruity olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "fruity olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Halve the oranges crosswise and break apart the sections into a bowl, trying not to press out too much juice. Cover and refrigerate for at least 1 hour."}, {"position": 2, "text": "Just before serving, toss the oranges with red pepper flakes and a pinch of salt, enough for both seasonings to be tasted. Divide among six plates and drizzle with olive oil."}], "nutrition": {"calories": 282.3, "protein_g": 2.5, "carbohydrates_g": 30.9, "fat_g": 18.3, "saturated_fat_g": 2.5, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 651.2, "fiber_g": 6.3, "sugar_g": 24.5, "unsaturated_fat_g": 15.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "vegan", "vegetarian"], "c
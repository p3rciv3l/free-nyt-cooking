{"slug": "autumnal-spiced-plums", "nyt_id": 10032, "url": "https://cooking.nytimes.com/recipes/10032-autumnal-spiced-plums", "name": "Autumnal Spiced Plums", "author": "Nigella Lawson", "description": "", "servings": {"text": "4 servings, with leftovers", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 70, "raw": {"total": "PT1H10M"}}, "ingredients": [{"position": 1, "raw": "2 pounds plums, halved and pitted", "group": null, "quantity": 2.0, "unit": "lb", "item": "plums", "preparation": "halved and pitted", "optional": false}, {"position": 2, "raw": "½ cup honey", "group": null, "quantity": 0.5, "unit": "cup", "item": "honey", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup maple syrup", "group": null, "quantity": 0.25, "unit": "cup", "item": "maple syrup", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cinnamon stick, broken in half", "group": null, "quantity": 1.0, "unit": null, "item": "cinnamon stick", "preparation": "broken in half", "optional": false}, {"position": 5, "raw": "2 star anise", "group": null, "quantity": 2.0, "unit": null, "item": "star anise", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons balsamic vinegar", "group": null, "quantity": 2.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 325 degrees. Arrange plums cut side down in an ovenproof dish that holds them in 1 layer."}, {"position": 2, "text": "In a medium saucepan, combine honey, syrup, cinnamon, star anise, vinegar and 1 ½ cups water. Place on medium-high heat. As soon as mixture begins to boil, pour evenly over plums. Cover dish tightly with foil."}, {"position": 3, "text": "Bake plums until tender, 45 minutes to 1 hour. Remove foil, and let cool slightly. To serve, place 4 portions of plums in 4 shallow bowls, and top with syrup. Plums may be refrigerated and se
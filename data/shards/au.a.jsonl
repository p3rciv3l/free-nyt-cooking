{"slug": "aunt-gens-biscotti", "nyt_id": 1012940, "url": "https://cooking.nytimes.com/recipes/1012940-aunt-gens-biscotti", "name": "Aunt Gen’s Biscotti", "author": "Ron Lieber", "description": "Ron Lieber", "servings": {"text": "48 cookies", "min": 48, "max": 48, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 65, "raw": {"total": "PT1H5M"}}, "ingredients": [{"position": 1, "raw": "½ cup solid vegetable shortening", "group": null, "quantity": 0.5, "unit": "cup", "item": "solid vegetable shortening", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "6 large eggs", "group": null, "quantity": 6.0, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons anise extract", "group": null, "quantity": 2.0, "unit": "tsp", "item": "anise extract", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 6, "raw": "4 ½ cups all-purpose flour, or as needed", "group": null, "quantity": 4.5, "unit": "cup", "item": "all-purpose flour", "preparation": "or as needed", "optional": false}, {"position": 7, "raw": "¼ teaspoon cream of tartar", "group": null, "quantity": 0.25, "unit": "tsp", "item": "cream of tartar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon baking powder", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon anise seeds", "group": null, "quantity": 1.0, "unit": "tsp", "item": "anise seeds", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup shelled, skinned hazelnuts, coarsely chopped", "group": null, "quantity": 1.0, "unit": "cup", "item": "shelled", "preparation": "skinned hazelnuts, coarsely chopped", "optional": false}, {"position": 11, "raw": "Nonstick vegetable oil spray", "group": null, "quantity": null, "unit": null, "item": "nonstick vegetable oil spray", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Using an electric mixer, cream together shortening and sugar until smooth. Add eggs one at a time, mixing well after each addition. Add anise extract and vanilla extract, and mix well."}, {"position": 2, "text": "In a separate bowl, sift together 4 cups of flour, cream of tartar and baking powder. Stir in anise seeds and hazelnuts. Gradually add to shortening mixture, mixing well; dough will be soft and sticky."}, {"position": 3, "text": "Turn dough onto a lightly floured work surface. Using floured hands, lightly knead the dough, sprinkling with flour as needed until dough is soft but no longer sticky. Pat dough into four loaves a scant ½ inch high (they will rise when baked), about 3 inches wide, and 6 to 8 inches long."}, {"position": 4, "text": "Spray two baking sheets with oil, and place loaves on them. Bake until lightly browned, about 25 minutes. Remove from oven, and cut diagonally into slices about 1 inch wide. Place slices cut-side down and return to oven to bake until undersides are light golden brown, 8 to 10 minutes. Turn cookies and bake again 8 to 10 minutes until cookies are hard and golden brown on both sides."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 108.45833333333333, "protein_g": 2.4, "carbohydrates_g": 13.8, "fat_g": 5.0, "saturated_fat_g": 0.9, "unsaturated_fat_g": 1.1, "trans_fat_g": 0.3, "cholesterol_mg": 23.3, "sodium_mg": 32.0, "fiber_g": 0.6, "sugar_g": 4.3, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["hazelnut"]}, "images": [{"url": "https://cooking.nytimes.
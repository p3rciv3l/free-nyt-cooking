{"slug": "aunt-gens-biscotti", "nyt_id": 1012940, "url": "https://cooking.nytimes.com/recipes/1012940-aunt-gens-biscotti", "name": "Aunt Gen’s Biscotti", "author": "Ron Lieber", "description": "Ron Lieber", "servings": {"text": "48 cookies", "min": 48, "max": 48, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 65, "raw": {"total": "PT1H5M"}}, "ingredients": [{"position": 1, "raw": "½ cup solid vegetable shortening", "group": null, "quantity": 0.5, "unit": "cup", "item": "solid vegetable shortening", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "6 large eggs", "group": null, "quantity": 6.0, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons anise extract", "group": null, "quantity": 2.0, "unit": "tsp", "item": "anise extract", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 6, "raw": "4 ½ cups all-purpose flour, or as needed", "group": null, "quantity": 4.5, "unit": "cup", "item": "all-purpose flour", "preparation": "or as needed", "optional": false}, {"position": 7, "raw": "¼ teaspoon cream of tartar", "group": null, "quantity": 0.25, "unit": "tsp", "item": "cream of tartar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon baking powder", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon anise seeds", "group": null, "quantity": 1.0, "unit": "tsp", "item": "anise seeds", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup shelled, skinned hazelnuts, coarsely chopped", "group": null, "quantity": 1.0, "unit": "cup", "item": "shelled", "preparation": "skinned hazelnuts, coarsely chopped", "optional": false}, {"position": 11, "raw": "Nonstick vegetable oil spray", "group": null, "quantity": null, "unit": null, "item": "nonstick vegetable oil spray", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Using an electric mixer, cream together shortening and sugar until smooth. Add eggs one at a time, mixing well after each addition. Add anise extract and vanilla extract, and mix well."}, {"position": 2, "text": "In a separate bowl, sift together 4 cups of flour, cream of tartar and baking powder. Stir in anise seeds and hazelnuts. Gradually add to shortening mixture, mixing well; dough will be soft and sticky."}, {"position": 3, "text": "Turn dough onto a lightly floured work surface. Using floured hands, lightly knead the dough, sprinkling with flour as needed until dough is soft but no longer sticky. Pat dough into four loaves a scant ½ inch high (they will rise when baked), about 3 inches wide, and 6 to 8 inches long."}, {"position": 4, "text": "Spray two baking sheets with oil, and place loaves on them. Bake until lightly browned, about 25 minutes. Remove from oven, and cut diagonally into slices about 1 inch wide. Place slices cut-side down and return to oven to bake until undersides are light golden brown, 8 to 10 minutes. Turn cookies and bake again 8 to 10 minutes until cookies are hard and golden brown on both sides."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 108.45833333333333, "protein_g": 2.4, "carbohydrates_g": 13.8, "fat_g": 5.0, "saturated_fat_g": 0.9, "unsaturated_fat_g": 1.1, "trans_fat_g": 0.3, "cholesterol_mg": 23.3, "sodium_mg": 32.0, "fiber_g": 0.6, "sugar_g": 4.3, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["hazelnut"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 32}, "video_url": null, "comment_count": null, "published_at": "2009-12-16", "scraped_at": "2026-09-07T01:37:53Z", "scraper_version": "1.0.0"}
{"slug": "aunt-phillomenas-pizzelle", "nyt_id": 1017035, "url": "https://cooking.nytimes.com/recipes/1017035-aunt-phillomenas-pizzelle", "name": "Aunt Phillomena’s Pizzelle", "author": "Kim Severson", "description": "At the holidays, these crisp, simple cookies are stacked everywhere in Italian kitchens. My family was from Abruzzi, and my mother always used the recipe from her older sister. You can scent these cookies with orange, almond or lemon or just vanilla, but we always made plenty with anise at Christmas. You can use a simple stove-top pizzelle maker or an electric one. I prefer the kind without a non-stick coating. A little shot of cooking spray or a wipe with some cooking oil helps prime the press. Like pancakes, you will probably throw away the first one.", "servings": {"text": "48 servings", "min": 48, "max": 48, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "1 ¾ cups/210 grams flour, plus a little more if batter is too thin", "group": null, "quantity": 1.75, "unit": "cup", "item": "/210 grams flour", "preparation": "plus a little more if batter is too thin", "optional": false}, {"position": 2, "raw": "2 teaspoons/15 grams baking powder", "group": null, "quantity": 2.0, "unit": "tsp", "item": "/15 grams baking powder", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon/6 grams salt", "group": null, "quantity": 0.5, "unit": "tsp", "item": "/6 grams salt", "preparation": null, "optional": false}, {"position": 4, "raw": "3 eggs", "group": null, "quantity": 3.0, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 5, "raw": "¾ cup/150 grams sugar", "group": null, "quantity": 0.75, "unit": "cup", "item": "/150 grams sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ pound/113 grams butter, melted", "group": null, "quantity": 0.25, "unit": "lb", "item": "/113 grams butter", "preparation": "melted", "optional": false}, {"position": 7, "raw": "1 teaspoon/5 milliliters vanilla", "group": null, "quantity": 1.0, "unit": "tsp", "item": "/5 milliliters vanilla", "preparation": null, "optional": false}, {"position": 8, "raw": "½ teaspoon/2.5 milliliters anise extract", "group": null, "quantity": 0.5, "unit": "tsp", "item": "/2.5 milliliters anise extract", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Whisk together flour, baking powder and salt in a small bowl. In a larger bowl, beat eggs and sugar until blended and slightly fluffy, 3 to 5 minutes. Slowly add cooled, melted butter, vanilla and anise and mix until incorporated well. Mix in dry ingredients a cup or so at a time, until batter is smooth but thick."}, {"position": 2, "text": "Using 2 spoons, one to scoop up the batter and the other to ease it onto the iron, drop batter onto the center of a well-heated pizzelle maker. For smaller, 3-inch pizzelles, use a generous teaspoon of batter. For the 5-inch, use about a tablespoon."}, {"position": 3, "text": "Cook for 30 to 40 seconds, or until just lightly brown. Gently remove to a rack or plate to cool."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 46.354166666666664, "protein_g": 1.1, "carbohydrates_g": 5.2, "fat_g": 2.4, "saturated_fat_g": 1.3, "unsaturated_fat_g": 0.2, "trans_fat_g": null, "cholesterol_mg": 15.1, "sodium_mg": 30.9, "fiber_g": 0.4, "sugar_g": 3.5, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["christmas-cookie-dinner-lunch-side-dish"], "meal": [], "occasion": [], "other": ["christmas", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2014/12/03/dining/03COOKFIGHT7/03COOKFIGHT7-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/12/03/dining/03COOKFIGHT7/03COOKFIGHT7-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 348}, "video_url": null, "comment_count": null, "published_at": "2014-12-03", "scraped_at": "2026-09-07T03:28:24Z", "scraper_version": "1.0.0"}
{"slug": "auntie-khar-imms-chile-sauce", "nyt_id": 1018377, "url": "https://cooking.nytimes.com/recipes/1018377-auntie-khar-imms-chile-sauce", "name": "Auntie Khar Imm’s Chile Sauce", "author": "Francis Lam", "description": "The author Cheryl Lu-Lien Tan’s family serves this simple chile sauce with everything; its heat and tartness complement this Singaporean braised duck nicely. It’s very hot, though, so feel free to add more citrus and sugar to suit your taste. It can keep for weeks, refrigerated. Francis Lam", "servings": {"text": "cup", "min": null, "max": null, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "1 ounce red Thai bird chiles (10-15 small ones), stemmed", "group": null, "quantity": 1.0, "unit": "oz", "item": "red thai bird chiles", "preparation": "stemmed", "optional": false}, {"position": 2, "raw": "1 clove garlic", "group": null, "quantity": 1.0, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 3, "raw": "11/2 tablespoons Kalamansi lime juice (or a mix of lime and orange), or to taste", "group": null, "quantity": 5.5, "unit": "tbsp", "item": "kalamansi lime juice", "preparation": "or to taste", "optional": false}, {"position": 4, "raw": "1 teaspoon sugar, or to taste", "group": null, "quantity": 1.0, "unit": "tsp", "item": "sugar", "preparation": "or to taste", "optional": false}, {"position": 5, "raw": "Pinch salt, or to taste", "group": null, "quantity": null, "unit": null, "item": "pinch salt", "preparation": "or to taste", "optional": false}], "steps": [{"position": 1, "text": "None"}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 106.0, "protein_g": 2.2, "carbohydrates_g": 29.6, "fat_g": 0.4, "saturated_fat_g": null, "unsaturated_fat_g": 0.2, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 304.6, "fiber_g": 1.7, "sugar_g": 14.3, "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": [], "course": ["dips-and-spreads"], "meal": [], "occasion": [], "other": ["easy", "quick"]}, "images": [{"url": "https://static01.nyt.com/images/2016/10/30/magazine/30chile-sauce/30chile-sauce-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2016/10/30/magazine/30chile-sauce/30chile-sauce-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2016/10/30/magazine/30chile-sauce/30chile-sauce-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 34}, "video_url": null, "comment_count": null, "published_at": "2016-10-30", "scraped_at": "2026-09-07T04:08:06Z", "scraper_version": "1.0.0"}
{"slug": "autumn-quinoa", "nyt_id": 1016997, "url": "https://cooking.nytimes.com/recipes/1016997-autumn-quinoa", "name": "Autumn Quinoa", "author": "Johanna Bond", "description": "Apples and cheddar make this quinoa creation a perfect dish for fall.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "PT30M"}}, "ingredients": [{"position": 1, "raw": "3 tablespoons olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup quinoa", "group": null, "quantity": 1.0, "unit": "cup", "item": "quinoa", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups water", "group": null, "quantity": 2.0, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon white cooking wine", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "white cooking wine", "preparation": null, "optional": false}, {"position": 5, "raw": "½ sweet onion, diced", "group": null, "quantity": 0.5, "unit": null, "item": "sweet onion", "preparation": "diced", "optional": false}, {"position": 6, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 7, "raw": "pinch rosemary", "group": null, "quantity": null, "unit": null, "item": "pinch rosemary", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon lemon juice", "group": null, "quantity": 1.0, "unit": "tsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons balsamic vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup sharp cheddar, cubed", "group": null, "quantity": 1.0, "unit": "cup", "item": "sharp cheddar", "preparation": "cubed", "optional": false}, {"position": 11, "raw": "1 cup baby spinach, raw", "group": null, "quantity": 1.0, "unit": "cup", "item": "baby spinach", "preparation": "raw", "optional": false}, {"position": 12, "raw": "1 crisp, sweet apple, cored and diced", "group": null, "quantity": 1.0, "unit": null, "item": "crisp", "preparation": "sweet apple, cored and diced", "optional": false}], "steps": [{"position": 1, "text": "Heat the olive oil in a medium-sized saucepan. Sauté the garlic and onions with the olive oil and rosemary, until tender. About 3 minutes. Add quinoa and lemon juice to the pan. Sauté the quinoa for 2-3 minutes, stirring occasionally to evenly toast the quinoa. Pour on the white wine and allow it to cook off, continuing to cook the quinoa for another minute. Add two cups of water and bring the quinoa to a boil, then simmer on low with the pan covered for 20 minutes or until the quinoa looks fluffy and there is no extra water."}, {"position": 2, "text": "Add chopped apple, baby spinach, cubes of cheddar and balsamic vinegar and mix together until cheddar has melted and the greens wilted. Remove from heat and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 322.25, "protein_g": 8.3, "carbohydrates_g": 38.9, "fat_g": 15.2, "saturated_fat_g": 3.1, "unsaturated_fat_g": 2.6, "trans_fat_g": 0.1, "cholesterol_mg": 6.9, "sodium_mg": 82.6, "fiber_g": 4.5, "sugar_g": 8.1, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://static01.nyt.com/images/2014/11/18/science/17VEGGIETHNX7/17VEGGIETHNX7-superJumbo.jpg", "alt": "Autumn Quinoa", "primary": true}, {"url": "https://static01.nyt.com/images/2014/11/18/science/17VEGGIETHNX7/17VEGGIETHNX7-facebookJumbo-v2.jpg", "alt": "Autumn Quinoa", "primary": false}], "rating": {"average": 4.0, "count": 351}, "video_url": null, "comment_count": null, "published_at": "2014-11-14",
{"slug": "big-batch-grilled-vegetables", "nyt_id": 10865, "url": "https://cooking.nytimes.com/recipes/10865-big-batch-grilled-vegetables", "name": "Big-Batch Grilled Vegetables", "author": "Marian Burros", "description": "", "servings": {"text": "Fourteen servings", "min": 14, "max": 14, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "2 cups white wine", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "white wine", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "4 cloves garlic, minced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "6 large pieces lemon rind, about ½ cup", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "large pieces lemon rind", "preparation": "about ½ cup", "optional": false}, {"position": 5, "raw": "6 large pieces orange rind, about ½ cup", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "large pieces orange rind", "preparation": "about ½ cup", "optional": false}, {"position": 6, "raw": "½ cup minced rosemary, plus additional sprigs for garnish", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "minced rosemary", "preparation": "plus additional sprigs for garnish", "optional": false}, {"position": 7, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "7 Japanese eggplants, halved lengthwise", "group": null, "quantity": 7.0, "quantity_max": null, "unit": null, "item": "japanese eggplants", "preparation": "halved lengthwise", "optional": false}, {"position": 9, "raw": "7 medium zucchini, halved lengthwise", "group": null, "quantity": 7.0, "quantity_max": null, "unit": null, "item": "medium zucchini", "preparation": "halved lengthwise", "optional": false}, {"position": 10, "raw": "14 large red, yellow or orange bell peppers (any combination), quartered", "group": null, "quantity": 14.0, "quantity_max": null, "unit": null, "item": "large red", "preparation": "yellow or orange bell peppers (any combination), quartered", "optional": false}, {"position": 11, "raw": "Thyme sprigs for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "thyme sprigs for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine the wine, oil, garlic, lemon and orange rinds, rosemary and pepper, and divide between 2 large nonaluminum roasting pans."}, {"position": 2, "text": "Arrange the vegetables in the pans and toss with the marinade. Refrigerate overnight. Stir the vegetables occasionally so that all of them are coated."}, {"position": 3, "text": "Grill the vegetables at a distance of 6 to 8 inches from the hot coals until tender, turning often and brushing with the marinade. The eggplant will cook in about 20 minutes, the peppers and zucchini in 10 minutes. As the vegetables are cooked, arrange them on serving platters. Cut the eggplant and zucchini in quarters crosswise. Decorate with the sprigs of rosemary and thyme."}], "nutrition": {"calories": 432.0, "protein_g": 5.7, "carbohydrates_g": 31.1, "fat_g": 32.2, "saturated_fat_g": 4.6, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 21.9, "fiber_g": 13.6, "sugar_g": 17.6, "unsaturated_fat_g": 26.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["side dis
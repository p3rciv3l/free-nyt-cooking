{"slug": "acai-bowl", "nyt_id": 1024738, "url": "https://cooking.nytimes.com/recipes/1024738-acai-bowl", "name": "Açaí Bowl", "author": "Naz Deravian", "description": "The star of this refreshing and vibrant bowl is the açaí berry, a small, round fruit native to the Amazon rainforest. When picked from the palm on which it grows, the fruit is bitter with hints of chocolate, and slightly tangy; by the time the berries reach supermarkets (açaí is widely available nowadays), they have been pitted and turned into a frozen purée. Simply thaw the packets for a couple minutes and combine with milk and a handful of other frozen fruits in a high-powered blender for a quick breakfast or dessert. Be mindful not to thin it out too much — the consistency should be thicker than a smoothie so you can eat it with a spoon. Top açaí bowls as you like, with a variety of fruits, nuts, granola and honey.", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 10, "total_minutes": 15, "raw": {"prep": "PT5M", "cook": "PT10M", "total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "2 (3 ½-ounce) frozen açaí purée packets (7 ounces total), sweetened or unsweetened", "group": null, "quantity": 2.0, "unit": null, "item": "frozen açaí purée packets", "preparation": "sweetened or unsweetened", "optional": false}, {"position": 2, "raw": "⅔ cup dairy or nondairy milk, or orange juice", "group": null, "quantity": 0.6666666666666666, "unit": "cup", "item": "dairy or nondairy milk", "preparation": "or orange juice", "optional": false}, {"position": 3, "raw": "1 large frozen or fresh banana, sliced", "group": null, "quantity": 1.0, "unit": null, "item": "large frozen or fresh banana", "preparation": "sliced", "optional": false}, {"position": 4, "raw": "½ cup frozen mixed fruit, such as strawberries and blueberries", "group": null, "quantity": 0.5, "unit": "cup", "item": "frozen mixed fruit", "preparation": "such as strawberries and blueberries", "optional": false}, {"position": 5, "raw": "Fresh fruits, such as berries, mango, kiwi or banana; chopped nuts of choice; sweetened or unsweetened coconut flakes; granola; bee pollen; and honey, for topping (optional)", "group": null, "quantity": null, "unit": null, "item": "fresh fruits", "preparation": "such as berries, mango, kiwi or banana; chopped nuts of choice; sweetened or unsweetened coconut flakes; granola; bee pollen; and honey, for topping (optional)", "optional": true}], "steps": [{"position": 1, "text": "Slightly thaw the frozen açaí packets at room temperature for 2 minutes, then break them into pieces in the packet by hand or with a rolling pin."}, {"position": 2, "text": "To a blender, add milk, açaí, banana slices and frozen fruit. Blend until thick and smooth. If you have one, use a blender tamper to incorporate the frozen fruits, or scrape down the sides with a spatula. Add more liquid, 1 tablespoon at a time, if necessary, until it reaches the desired consistency. Be mindful not to thin out the mixture too much since it will be eaten with a spoon."}, {"position": 3, "text": "Transfer the açaí mixture to a bowl, add toppings of your choice and serve immediately."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 293.0, "protein_g": 5.7, "carbohydrates_g": 50.4, "fat_g": 9.7, "saturated_fat_g": 4.2, "unsaturated_fat_g": 0.2, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 76.0, "fiber_g": 7.9, "sugar_g": 32.0, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["breakfast-dessert-lunch-main-course-shakes-and-smoothies"], "meal": [], "occasion": [], "other": ["banana", "easy", "for-two", "fruit", "milk", "non-dairy-milk", "quick"]}, "images": [{"url": "https://static01.nyt.com/images/2023/12/20/multimedia/ND-Acai-Bowl-wbkv/ND-Acai-Bowl-wbkv-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2023/12/20/multimedia/ND-Acai-Bowl-wbkv/ND-Acai-Bowl-wbkv-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2023/12/20/multimedia/ND-Acai-Bowl-wbkv/ND-Acai-Bowl-wbkv-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2023/12/20/multimedia/ND-Acai-Bowl-wbkv/ND-Acai-Bowl-wbkv-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 477}, "video_url": null, "comment_count": null, "published_at": "2023-12-20", "scraped_at": "2026-09-07T08:05:53Z", "scraper_version": "1.0.0"}
{"slug": "acar-cucumber-pickles", "nyt_id": 2800, "url": "https://cooking.nytimes.com/recipes/2800-acar-cucumber-pickles", "name": "Acar (Cucumber Pickles)", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "About two quarts, liquid included", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "2 ½ cups water", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup white vinegar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "5 tablespoons sugar", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 5, "raw": "3 dried hot red peppers", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "dried hot red peppers", "preparation": null, "optional": false}, {"position": 6, "raw": "2 large whole cloves garlic, peeled", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large whole cloves garlic", "preparation": "peeled", "optional": false}, {"position": 7, "raw": "2 whole pieces dried turmeric, or ¼ teaspoon powdered turmeric", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "whole pieces dried turmeric", "preparation": "or ¼ teaspoon powdered turmeric", "optional": false}, {"position": 8, "raw": "6 thin slices fresh ginger", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "thin slices fresh ginger", "preparation": null, "optional": false}, {"position": 9, "raw": "¾ pound fresh cucumbers, trimmed and cut into ½-inch-thick rounds", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "lb", "item": "fresh cucumbers", "preparation": "trimmed and cut into ½-inch-thick rounds", "optional": false}, {"position": 10, "raw": "1 medium-size sweet red pepper, about 6 ounces, cored and deveined", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size sweet red pepper", "preparation": "about 6 ounces, cored and deveined", "optional": false}, {"position": 11, "raw": "1 medium-size sweet yellow pepper, about 6 ounces, cored and deveined", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size sweet yellow pepper", "preparation": "about 6 ounces, cored and deveined", "optional": false}, {"position": 12, "raw": "1 small red onion, about ¼ pound, peeled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small red onion", "preparation": "about ¼ pound, peeled", "optional": false}], "steps": [{"position": 1, "text": "Combine the water, vinegar, sugar, salt, hot red peppers, garlic, turmeric and ginger. Bring to the boil and let simmer 10 minutes."}, {"position": 2, "text": "Meanwhile, prepare the cucumber rounds and put them in a bowl with a tight-fitting lid. Cut the red and yellow peppers and onion into one-inch squares and add them to the bowl. Pour the vinegar mixture over all. Seal tightly. Let stand until cool and refrigerate overnight or longer. These pickles must be made 24 hours in advance."}], "nutrition": {"calories": 31.8, "protein_g": 0.7, "carbohydrates_g": 7.3, "fat_g": 0.2, "saturated_fat_g": 0.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 236.7, "fiber_g": 1.0, "sugar_g": 4.8, "unsaturated_fat_g": 0.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["indonesian"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "cucumber", "summer", "white vinegar"]}, "images": [], "rating": {"average": 4.0, "count": 13}, "video_url": null, "comment_count": null, "published_at": "1987-03-15", "scraped_at": "2026-09-07T04:43:35.600572+00:00", "scraper_version": "1.0.0"}

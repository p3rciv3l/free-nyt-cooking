softly poached (2-minute) extra-large eggs", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "softly poached (2-minute) extra-large eggs", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "With a large mortar and pestle, pound the coriander, garlic and salt to paste. Spread over the bottom of a shallow 3-quart terra cotta casserole and drizzle with olive oil."}, {"position": 2, "text": "Pour in the boiling water, add the bread and pepper, toss well and let stand 2 minutes. Taste for salt and add more if needed."}, {"position": 3, "text": "Slide the poached eggs on top and serve, making sure each person gets an egg."}], "nutrition": {"calories": 353.6, "protein_g": 12.9, "carbohydrates_g": 29.1, "fat_g": 20.5, "saturated_fat_g": 3.9, "trans_fat_g": 0.0, "cholesterol_mg": 208.3, "sodium_mg": 1153.5, "fiber_g": 1.6, "sugar_g": 3.0, "unsaturated_fat_g": 15.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["portuguese"], "diet": [], "course": ["appetizer"], "meal": ["dinner"], "occasion": [], "other": ["boil", "coriander", "egg", "five ingredient", "great leftovers", "soup"]}, "images": [], "rating": {"average": 3.0, "count": 11}, "video_url": null, "comment_count": null, "published_at": "1987-03-04", "scraped_at": "2026-09-07T04:35:29.095643+00:00", "scraper_version": "1.0.0"}
{"slug": "acorn-squash-soup", "nyt_id": 485, "url": "https://cooking.nytimes.com/recipes/485-acorn-squash-soup", "name": "Acorn Squash Soup", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "3 acorn squash, halved and seeded", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "acorn squash", "preparation": "halved and seeded", "optional": false}, {"position": 2, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ cups diced onions", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "diced onions", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup applejack, Calvados or other brandy", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "applejack", "preparation": "Calvados or other brandy", "optional": false}, {"position": 5, "raw": "2 ½ cups apple cider", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "apple cider", "preparation": null, "optional": false}, {"position": 6, "raw": "4 cups chicken stock", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon ground cardamom", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground cardamom", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon cinnamon", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "cinnamon", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ teaspoon nutmeg", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "nutmeg", "preparation": null, "optional": false}, {"position": 10, "raw": "1 tablespoon cider vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "cider vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 12, "raw": "1 ½ cups unsalted, unbuttered popcorn, optional", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "unsalted", "preparation": "unbuttered popcorn", "optional": true}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees. Place the squash halves cut side down on a foil-lined baking sheet, and bake until tender, about 40 minutes."}, {"position": 2, "text": "Meanwhile, melt the butter in a large saucepan. Add the onion, saute until tender and then add the applejack. Scoop out the flesh of the squash, and add it to the saucepan along with the cider and chicken stock. Cook for 20 minutes."}, {"position": 3, "text": "Puree the mixture in a blender, in batches if necessary, until very smooth. Return to the saucepan, reheat and season with cardamom, cinnamon and nutmeg. Stir in the vinegar, and season to taste with salt and pepper. Garnish each serving with popcorn, if desired."}], "nutrition": {"calories": 225.6, "protein_g": 5.1, "carbohydrates_g": 34.6, "fat_g": 5.1, "saturated_fat_g": 2.4, "trans_fat_g": 0.0, "cholesterol_mg": 11.2, "sodium_mg": 957.3, "fiber_g": 3.7, "sugar_g": 10.7, "unsaturated_fat_g": 2.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": [], "occasion": ["thanksgiving"], "other": ["acorn squash", "bake", "fall", "great leftovers", "saute", "soup"]}, "ima
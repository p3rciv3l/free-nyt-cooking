{"slug": "tigua-indian-bowl-of-red", "nyt_id": 1016038, "url": "https://cooking.nytimes.com/recipes/1016038-tigua-indian-bowl-of-red", "name": "Tigua Indian ‘Bowl of Red’", "author": "Jennifer Steinhauer", "description": "This chili is renowned for its hotter versions; heavy on the cayenne and chili powder. The masa harina thickens the stew and adds a subtle corn undernote. Jennifer Steinhauer", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 85, "raw": {"total": "PT1H25M"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons vegetable oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup chopped onion", "group": null, "quantity": 1.0, "unit": "cup", "item": "chopped onion", "preparation": null, "optional": false}, {"position": 3, "raw": "2 garlic cloves, minced", "group": null, "quantity": 2.0, "unit": null, "item": "garlic cloves", "preparation": "minced", "optional": false}, {"position": 4, "raw": "2 pounds beef round steak, cut into ½-inch cubes", "group": null, "quantity": 2.0, "unit": "lb", "item": "beef round steak", "preparation": "cut into ½-inch cubes", "optional": false}, {"position": 5, "raw": "5 tablespoons chile powder", "group": null, "quantity": 5.0, "unit": "tbsp", "item": "chile powder", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon ground cumin", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ teaspoons salt", "group": null, "quantity": 1.5, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ½ teaspoons freshly ground black pepper", "group": null, "quantity": 1.5, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "1 ½ teaspoons dried Mexican oregano", "group": null, "quantity": 1.5, "unit": "tsp", "item": "dried mexican oregano", "preparation": null, "optional": false}, {"position": 11, "raw": "1 ½ teaspoons cayenne pepper", "group": null, "quantity": 1.5, "unit": "tsp", "item": "cayenne pepper", "preparation": null, "optional": false}, {"position": 12, "raw": "1 15-ounce can tomato sauce", "group": null, "quantity": 16.0, "unit": null, "item": "ounce can tomato sauce", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon masa harina dissolved in ½ cup water", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "masa harina dissolved in ½ cup water", "preparation": null, "optional": false}, {"position": 14, "raw": "Cooked rice, for serving (optional)", "group": null, "quantity": null, "unit": null, "item": "cooked rice", "preparation": "for serving (optional)", "optional": true}, {"position": 15, "raw": "Bread, for serving (optional)", "group": null, "quantity": null, "unit": null, "item": "bread", "preparation": "for serving (optional)", "optional": true}, {"position": 16, "raw": "Sour cream (optional)", "group": null, "quantity": null, "unit": null, "item": "sour cream", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "In a large pot, heat oil over medium-low heat and sauté onion and garlic until softened, about 5 minutes. Add the beef, raise heat to medium-high and sauté until browned."}, {"position": 2, "text": "Add chile powder, cumin, sugar, salt, pepper, oregano and cayenne pepper. Stir in the tomato sauce and 1 ½ cups water. Bring to a boil, then reduce heat to low. Simmer, partly covered, for 1 hour 10 minutes."}, {"position": 3, "text": "Remove from heat and stir in masa harina mixture. Return to low heat and simmer, stirring occasionally, for 5 minutes. If desired, serve with rice or bread, and sour cream."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 650.25, "protein_g": 56.4, "carbohydrates_g": 42.4, "fat_g": 28.8, "saturated_fat_g": 8.3, "unsaturated_fat_g": 3.3, "trans_fat_g": 0.1, "cholesterol_mg": 156.5, "sodium_mg": 1081.2, "fiber_g": 7.4, "sugar_g": 10.3, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course-stew"], "meal": [], "occasion": [], "other": ["beef", "fall", "great-leftovers", "tomato", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2014/02/12/dining/12JPCHILI3/12JPCHILI3-superJumbo.jpg", "alt": "Tigua Indian ‘Bowl of Red.’", "primary": true}, {"url": "https://static01.nyt.com/images/2014/02/12/dining/12JPCHILI3/12JPCHILI3-facebookJumbo-v2.jpg", "alt": "Tigua Indian ‘Bowl of Red.’", "primary": false}], "rating": {"average": 5.0, "count": 166}, "video_url": null, "comment_count": null, "published_at": "2014-02-12", "scraped_at": "2026-09-07T03:00:23Z", "scraper_version": "1.0.0"}
{"slug": "tita-ems-chicken-wings-adobo", "nyt_id": 1016873, "url": "https://cooking.nytimes.com/recipes/1016873-tita-ems-chicken-wings-adobo", "name": "Tita Em’s Chicken Wings Adobo", "author": "Jeff Gordinier", "description": "Tita Em is a nickname for Zosima Arceo Phojanakong, also known as Emma, who happens to be the mother of King Phojanakong, the chef at Kuma Inn on the Lower East Side of Manhattan. Her background is Filipino, and Mr. Phojanakong’s recipe for chicken wings is a spin on something that his mother used to cook every week for her family when the chef was a boy: a whole chicken simmered in a silky, peppery adobo gravy. In Mr. Phojanakong’s version, that sauce gets extra creaminess from coconut milk. At Kuma Inn, the wings have become a signature dish. Jeff Gordinier", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "PT1H30M"}}, "ingredients": [{"position": 1, "raw": "¾ cup rice vinegar", "group": null, "quantity": 0.75, "unit": "cup", "item": "rice vinegar", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup soy sauce", "group": null, "quantity": 0.75, "unit": "cup", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 3, "raw": "6 to 8 cloves garlic, crushed", "group": null, "quantity": 6.0, "unit": "clove", "item": "garlic", "preparation": "crushed", "optional": false, "quantity_max": 8.0}, {"position": 4, "raw": "¾ teaspoon whole black peppercorns", "group": null, "quantity": 0.75, "unit": "tsp", "item": "whole black peppercorns", "preparation": null, "optional": false}, {"position": 5, "raw": "2 bay leaves", "group": null, "quantity": 2.0, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 6, "raw": "2 ½ pounds chicken wings, tips removed and sectioned", "group": null, "quantity": 2.5, "unit": "lb", "item": "chicken wings", "preparation": "tips removed and sectioned", "optional": false}, {"position": 7, "raw": "¼ cup vegetable oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 8, "raw": "⅓ cup coconut milk", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "coconut milk", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large saucepan, combine the vinegar, soy sauce, garlic, peppercorns and bay leaves. Add 1 ¼ cups water and mix well. Add the chicken wings and marinate at room temperature for 30 minutes."}, {"position": 2, "text": "Cover pan, place over high heat and bring to a boil. Reduce heat to low and simmer, covered, until tender, 30 to 40 minutes. Remove chicken from braising liquid and set aside on a rack to drain and dry."}, {"position": 3, "text": "In a large skillet, heat the oil, add the wings and fry until golden brown."}, {"position": 4, "text": "Return braising liquid to a boil. Add coconut milk and bring to a simmer. Add chicken wings, coat with sauce and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 745.75, "protein_g": 54.3, "carbohydrates_g": 5.2, "fat_g": 54.6, "saturated_fat_g": 14.6, "unsaturated_fat_g": 9.7, "trans_fat_g": 0.3, "cholesterol_mg": 314.7, "sodium_mg": 2867.5, "fiber_g": 0.7, "sugar_g": 0.3, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-finger-foods-lunch-main-course"], "meal": [], "occasion": [], "other": ["chicken-wing", "garlic"]}, "images": [{"url": "https://static01.nyt.com/images/2014/10/15/dining/15WINGSKUMA/15WINGSKUMA-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/10/15/dining/15WINGSKUMA/15WINGSKUMA-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 253}, "video_url": null, "comment_count": null, "published_at": "2014-10-15", "scraped_at": "2026-09-07T03:23:56Z", "scraper_version
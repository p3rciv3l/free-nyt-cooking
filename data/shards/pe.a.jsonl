{"slug": "pecorino-and-pear-salad", "nyt_id": 1012486, "url": "https://cooking.nytimes.com/recipes/1012486-pecorino-and-pear-salad", "name": "Pecorino and Pear Salad", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "2 pounds fresh fava beans, shelled", "group": null, "quantity": 2.0, "unit": "lb", "item": "fresh fava beans", "preparation": "shelled", "optional": false}, {"position": 2, "raw": "1 fennel bulb", "group": null, "quantity": 1.0, "unit": null, "item": "fennel bulb", "preparation": null, "optional": false}, {"position": 3, "raw": "6 ½ ounces aged Italian pecorino", "group": null, "quantity": 6.5, "unit": "oz", "item": "aged italian pecorino", "preparation": null, "optional": false}, {"position": 4, "raw": "4 tablespoons pear vinegar or balsamic vinegar", "group": null, "quantity": 4.0, "unit": "tbsp", "item": "pear vinegar or balsamic vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "6 tablespoons extra virgin olive oil", "group": null, "quantity": 6.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "3 firm but ripe Bartlett or Anjou pears", "group": null, "quantity": 3.0, "unit": null, "item": "firm but ripe bartlett or anjou pears", "preparation": null, "optional": false}, {"position": 7, "raw": "Juice of ½ lemon", "group": null, "quantity": null, "unit": null, "item": "juice of ½ lemon", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons toasted pine nuts", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "toasted pine nuts", "preparation": null, "optional": false}, {"position": 9, "raw": "Coarse sea salt", "group": null, "quantity": null, "unit": null, "item": "coarse sea salt", "preparation": null, "optional": false}, {"position": 10, "raw": "4 small sprigs tarragon", "group": null, "quantity": 4.0, "unit": null, "item": "small sprigs tarragon", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place fava beans in a saucepan, cover with water and simmer 3 minutes. Drain, allow to cool and peel outer skins."}, {"position": 2, "text": "Trim fennel bulb, quarter and remove core. Slice paper-thin on a mandoline. Place in a bowl with fava beans."}, {"position": 3, "text": "Finely grate ½ ounce cheese. Cut the rest in paper-thin slices and set aside. Combine vinegar and oil in a small bowl, stir in grated cheese and pour over fennel and favas. Toss. Set aside. Cut pears in half vertically. Remove cores. Slice paper-thin, vertically. Place in another bowl and toss with lemon juice."}, {"position": 4, "text": "To assemble, divide fennel and fava beans among four salad plates. On top, make three alternating layers of pecorino and pear slices, ending with pears. Scatter pine nuts, sprinkle with sea salt and garnish each plate with a sprig of tarragon. Serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 741.75, "protein_g": 35.4, "carbohydrates_g": 75.7, "fat_g": 39.0, "saturated_fat_g": 11.3, "unsaturated_fat_g": 5.5, "trans_fat_g": null, "cholesterol_mg": 47.9, "sodium_mg": 1260.5, "fiber_g": 24.3, "sugar_g": 41.6, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["salad-side-dish"], "meal": [], "occasion": [], "other": ["fall", "fava-bean", "pear"]}, "images": [{"url": "https://static01.nyt.com/images/2014/03/31/dining/pecorino-pear-salad/pecorino-pear-salad-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/03/31/dining/pecorino-pear-salad/pecorino-pear-salad-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 53}, "video_url": null, "comment_count": null, "published_at": "2009-04-15", "scraped_at": "2026-09-06T22
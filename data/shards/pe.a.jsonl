{"slug": "penne-with-heirloom-tomatoes-basil-green-beans-and-feta", "nyt_id": 1012716, "url": "https://cooking.nytimes.com/recipes/1012716-penne-with-heirloom-tomatoes-basil-green-beans-and-feta", "name": "Penne With Heirloom Tomatoes, Basil, Green Beans and Feta", "author": "Martha Rose Shulman", "description": "Sweet, juicy heirloom tomatoes lend themselves well to uncooked tomato sauces. In summer, I make quick meals out of chopped ripe tomatoes, pasta and green vegetables.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 50, "raw": {"total": "PT50M"}}, "ingredients": [{"position": 1, "raw": "6 to 8 ounces fresh green beans, trimmed, strings removed if necessary, and broken in half if very long", "group": null, "quantity": 6.0, "unit": "oz", "item": "fresh green beans", "preparation": "trimmed, strings removed if necessary, and broken in half if very long", "optional": false, "quantity_max": 8.0}, {"position": 2, "raw": "2 cups chopped fresh ripe tomatoes", "group": null, "quantity": 2.0, "unit": "cup", "item": "chopped fresh ripe tomatoes", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 plump garlic clove, minced (more to taste)", "group": null, "quantity": 1.0, "unit": null, "item": "plump garlic clove", "preparation": "minced (more to taste)", "optional": false}, {"position": 5, "raw": "Salt (I like to use a very good coarse sea salt or fleur de sel for this)", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon balsamic vinegar (optional)", "group": null, "quantity": 1.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": true}, {"position": 8, "raw": "2 tablespoons slivered basil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "slivered basil", "preparation": null, "optional": false}, {"position": 9, "raw": "2 ounces crumbled feta (about ½ cup)", "group": null, "quantity": 2.0, "unit": "oz", "item": "crumbled feta", "preparation": null, "optional": false}, {"position": 10, "raw": "¾ pound pasta (penne or fusilli are good choices)", "group": null, "quantity": 0.75, "unit": "lb", "item": "pasta", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine the olive oil, tomatoes, garlic, basil, salt and pepper in a large bowl, and let sit for 15 to 30 minutes (or longer)."}, {"position": 2, "text": "Bring a large pot of generously salted water to a boil. Fill a bowl with ice water. Add the green beans to the boiling water, and boil four to five minutes, depending on how crunchy you like them. Remove with a strainer or skimmer, and transfer to the ice water. Allow to cool for a few minutes, then drain and set aside."}, {"position": 3, "text": "Bring the water back to a boil, and add the pasta. Cook until al dente, about eight minutes. When the pasta is ready, drop the green beans back into the water to heat, then drain the pasta and beans and toss at once with the tomato mixture and the feta. Serve hot or room temperature."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 458.0, "protein_g": 15.5, "carbohydrates_g": 71.6, "fat_g": 12.4, "saturated_fat_g": 3.7, "unsaturated_fat_g": 1.4, "trans_fat_g": null, "cholesterol_mg": 16.7, "sodium_mg": 555.3, "fiber_g": 5.2, "sugar_g": 6.1, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer-dinner-lunch-main-course-pastas-side-dish"], "meal": [], "occasion": [], "other": ["green-bean", "one-pot", "
{"slug": "new-potato-red-pepper-and-chive-salad", "nyt_id": 4497, "url": "https://cooking.nytimes.com/recipes/4497-new-potato-red-pepper-and-chive-salad", "name": "New Potato, Red Pepper and Chive Salad", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds new potatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "new potatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "1 red pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "1 clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "2 to 3 tablespoons Balsamic vinegar (or to taste)", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": "tbsp", "item": "balsamic vinegar (or to taste)", "preparation": null, "optional": false}, {"position": 6, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup extra-virgin olive oil", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "1 bunch fresh chives, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "fresh chives", "preparation": "minced", "optional": false}], "steps": [{"position": 1, "text": "Steam the potatoes until tender (about 20 minutes)."}, {"position": 2, "text": "While the potatoes are cooking, cut the pepper into quarters, remove the stem and seeds and place the pepper face down on a broiling rack. Broil until skin is charred. Place in a paper bag a few minutes, then peel off the skin. Cut the pepper into dice."}, {"position": 3, "text": "Make the dressing. Place the mustard in a bowl large enough to hold the potatoes. Peel the garlic and crush it into the mustard with a fork. Add the vinegar, salt and pepper. Gradually beat in the olive oil, creating an emulsion."}, {"position": 4, "text": "When the potatoes are cooked, remove the garlic from the dressing. Add the potatoes and diced pepper and toss thoroughly. Add the chives and serve the salad at room temperature. Correct seasoning just before serving."}], "nutrition": {"calories": 555.9, "protein_g": 5.4, "carbohydrates_g": 44.4, "fat_g": 41.0, "saturated_fat_g": 5.7, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 734.0, "fiber_g": 5.9, "sugar_g": 4.7, "unsaturated_fat_g": 34.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["broil", "chive", "new potato", "potato salad", "red bell pepper", "steam"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1991-05-26", "scraped_at": "2026-09-07T00:33:34.219699+00:00", "scraper_version": "1.0.0"}
{"slug": "new-potato-salad-with-dill", "nyt_id": 3794, "url": "https://cooking.nytimes.com/recipes/3794-new-potato-salad-with-dill", "name": "New Potato Salad With Dill", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "2 hours"}}, "ingredients": [{"position": 1, "raw": "2 pounds new potatoes of uniform size, scrubbed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "new potatoes of uniform size", "preparation": "scrubbed", "optional": false}, {"position": 2, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup white wine vinegar", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "white wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "⅔ cup extra-virgin olive oil", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "½ tablespoon Dijon mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup finely chopped scallions", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely chopped scallions", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons minced fresh dill", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh dill", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the potatoes in a saucepan, cover with cold water, bring to a boil, cover and reduce the heat to low. Cook until the potatoes are just tender, about 20 minutes. Drain and quarter the potatoes, taking care to keep the skins on."}, {"position": 2, "text": "Place the potatoes in a bowl, season lightly with salt and pepper and gently toss with two tablespoons of the vinegar and one tablespoon of the oil. Set aside until cool."}, {"position": 3, "text": "Mix the remaining vinegar with the mustard until well blended. Beat in the oil. Pour over the cooled potatoes and gently mix. Add the scallions and dill, season to taste with salt and pepper and serve."}], "nutrition": {"calories": 334.6, "protein_g": 3.3, "carbohydrates_g": 27.2, "fat_g": 24.2, "saturated_fat_g": 3.4, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 452.7, "fiber_g": 3.5, "sugar_g": 1.4, "unsaturated_fat_g": 20.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "dill", "new potato", "potato salad", "spring", "summer"]}, "images": [], "rating": {"average": 5.0, "count": 147}, "video_url": null, "comment_count": null, "published_at": "1991-06-16", "scraped_at": "2026-09-07T00:25:23.754755+00:00", "scraper_version": "1.0.0"}
{"slug": "new-potato-salad-with-sun-dried-tomatoes", "nyt_id": 2494, "url": "https://cooking.nytimes.com/recipes/2494-new-potato-salad-with-sun-dried-tomatoes", "name": "New Potato Salad With Sun-Dried Tomatoes", "author": "Florence Fabricant", "description": "", "servings": {"text": "3 to 4 servings", "min": 3, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ pounds small new potatoes, well scrubbed", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "small new potatoes", "preparation": "well scrubbed", "optional": false}, {"position": 2, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons white wine vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "white wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "6 sun-dried tomatoes, slivered", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "sun-dried tomatoes", "preparation": "slivered", "optional": false}, {"position": 5, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons minced scallions", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced scallions", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons minced fresh parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh parsley", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons minced fresh basil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh basil", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons minced fresh chervil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh chervil", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup mayonnaise, preferably homemade", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "mayonnaise", "preparation": "preferably homemade", "optional": false}], "steps": [{"position": 1, "text": "Boil the potatoes until just tender. Quarter them and place in a bowl. Sprinkle with oil, vinegar and slivered sun-dried tomatoes."}, {"position": 2, "text": "Season potatoes to taste with salt and pepper (taste carefully because the tomatoes are salty). Add the herbs."}, {"position": 3, "text": "Carefully fold in the mayonnaise. Check seasonings and serve slightly warm or chilled."}], "nutrition": {"calories": 404.6, "protein_g": 4.2, "carbohydrates_g": 32.4, "fat_g": 29.3, "saturated_fat_g": 4.3, "trans_fat_g": 0.0, "cholesterol_mg": 11.3, "sodium_mg": 531.9, "fiber_g": 4.3, "sugar_g": 2.6, "unsaturated_fat_g": 24.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "new potato", "summer", "sun-dried tomato"]}, "images": [], "rating": {"average": 4.0, "count": 26}, "video_url": null, "comment_count": null, "published_at": "1985-05-12", "scraped_at": "2026-09-07T00:12:21.826873+00:00", "scraper_version": "1.0.0"}
{"slug": "new-potatoes-with-artichokes-and-fava-beans", "nyt_id": 4496, "url": "https://cooking.nytimes.com/recipes/4496-new-potatoes-with-artichokes-and-fava-beans", "name": "New Potatoes With Artichokes and Fava Beans", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "½ lemon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemon", "preparation": null, "optional": false}, {"position": 2, "raw": "2 pounds baby artichokes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "baby artichokes", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ pounds new potatoes", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "new potatoes", "preparation": null, "optional": false}, {"position": 4, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 clove garlic, crushed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "crushed", "optional": false}, {"position": 6, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "2 pounds fresh fava beans", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "fresh fava beans", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon fresh tarragon leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh tarragon leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Squeeze the lemon half into a bowl of cold water large enough to hold the artichokes. Trim the outer leaves from the artichokes and cut off the tops, two-thirds down horizontally, and the stalks. Cut the artichokes in half. As you trim each artichoke, add it to the water to prevent it from turning brown. Quarter the potatoes."}, {"position": 2, "text": "Heat the oil in a large cast-iron skillet (you may need two or to work in two batches) and sautee the potatoes with the garlic for 10 minutes. Dry the artichokes in a salad spinner and add them to the pan. If necessary, add more oil. Season to taste with salt and pepper and cook, stirring from time to time, until the potatoes and artichokes are golden (about 15 minutes)."}, {"position": 3, "text": "Meanwhile, peel the fava beans and steam them until cooked (about five minutes). Add them to the potato-artichoke mixture and cook, stirring, for one minute so that they are coated with the oil. Remove the garlic and discard. Correct seasoning, sprinkle the dish with tarragon and serve."}], "nutrition": {"calories": 418.1, "protein_g": 19.6, "carbohydrates_g": 64.2, "fat_g": 15.0, "saturated_fat_g": 2.2, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 1019.8, "fiber_g": 22.5, "sugar_g": 16.5, "unsaturated_fat_g": 12.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["baby artichoke", "fava bean", "new potato", "saute", "steam"]}, "images": [], "rating": {"average": 4.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1991-05-26", "scraped_at": "2026-09-07T00:33:30.847665+00:00", "scraper_version": "1.0.0"}

{"slug": "negroni", "nyt_id": 12519, "url": "https://cooking.nytimes.com/recipes/12519-negroni", "name": "Negroni", "author": "Jim Meehan", "description": "This is the classic Italian way to open a meal: the Negroni, a bittersweet palate cleanser that makes way for the evening’s delights. Adding a bottle of Campari to the liquor cabinet opens up a world of cocktail possibilities. In any case, drink this cocktail cold. This recipe came to us from Jim Meehan, a bartender and an owner of Please Don't Tell, a speakeasy in the East Village.", "servings": {"text": "1 drink", "min": 1, "max": 1, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "5 minutes"}}, "ingredients": [{"position": 1, "raw": "1¼ ounces gin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "¼ ounces gin", "preparation": null, "optional": false}, {"position": 2, "raw": "1¼ ounces Campari", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "¼ ounces campari", "preparation": null, "optional": false}, {"position": 3, "raw": "1¼ ounces sweet vermouth", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "¼ ounces sweet vermouth", "preparation": null, "optional": false}, {"position": 4, "raw": "Orange twist, for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "orange twist", "preparation": "for garnish", "optional": false}], "steps": [{"position": 1, "text": "Stir all liquid ingredients with ice. Strain into chilled rocks glass filled with ice. Garnish with an orange twist."}], "nutrition": {"calories": 207.6, "protein_g": 0.1, "carbohydrates_g": 1.8, "fat_g": 0.0, "saturated_fat_g": 0.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 2.9, "fiber_g": 0.3, "sugar_g": 0.3, "unsaturated_fat_g": 0.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": ["thanksgiving"], "other": ["cocktails", "for one", "gin", "not-shoppable-ic", "summer", "vermouth"]}, "images": [{"url": "https://static01.nyt.com/images/2023/08/07/multimedia/JM-Negroni-mhwb/JM-Negroni-mhwb-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 1538}, "video_url": "https://www.nytimes.com/video/embedded/dining/100000009145429/negroni.html", "comment_count": null, "published_at": "2012-06-12", "scraped_at": "2026-09-07T03:09:48.693244+00:00", "scraper_version": "1.0.0"}
{"slug": "new-age-plum-torte", "nyt_id": 10755, "url": "https://cooking.nytimes.com/recipes/10755-new-age-plum-torte", "name": "New Age Plum Torte", "author": "Marian Burros", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ cup unsalted butter", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup plus 2 teaspoons sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "plus 2 teaspoons sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ ripe medium bananas broken into large chunks", "group": null, "quantity": 1.5, "quantity_max": null, "unit": null, "item": "ripe medium bananas broken into large chunks", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup unbleached flour, sifted", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "unbleached flour", "preparation": "sifted", "optional": false}, {"position": 5, "raw": "1 teaspoon baking powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup egg substitute", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "egg substitute", "preparation": null, "optional": false}, {"position": 7, "raw": "24 halves ripe pitted prune plums", "group": null, "quantity": 24.0, "quantity_max": null, "unit": null, "item": "halves ripe pitted prune plums", "preparation": null, "optional": false}, {"position": 8, "raw": "½ lemon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemon", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon cinnamon, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cinnamon", "preparation": "or to taste", "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees."}, {"position": 2, "text": "Beat the butter, ¾ cup of the sugar and bananas with electric mixer until well blended. Beat in flour, baking powder and egg substitute until well blended."}, {"position": 3, "text": "Spoon batter in 8- , 9- or 10-inch ungreased spring form. Arrange plum halves skin side down; sprinkle with 2 teaspoons of sugar -- more if plums are very tart -- a few squeezes of lemon juice and about 1 teaspoon cinnamon -- more if you like cinnamon."}, {"position": 4, "text": "Bake one hour, approximately. Remove and cool; refrigerate or freeze, if desired. Or cool to lukewarm and serve."}, {"position": 5, "text": "To serve torte that was frozen, defrost and reheat briefly at 300 degrees."}], "nutrition": {"calories": 327.4, "protein_g": 3.4, "carbohydrates_g": 68.1, "fat_g": 6.6, "saturated_fat_g": 3.7, "trans_fat_g": 0.0, "cholesterol_mg": 15.3, "sodium_mg": 57.0, "fiber_g": 4.1, "sugar_g": 42.2, "unsaturated_fat_g": 2.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["low-fat", "low-sodium", "vegetarian"], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "banana", "low cholesterol", "plum"]}, "images": [], "rating": {"average": 4.0, "count": 47}, "video_url": null, "comment_count": null, "published_at": "1991-09-04", "scraped_at": "2026-09-07T01:48:05.761431+00:00", "scraper_version": "1.0.0"}
{"slug": "new-crawfish-etouffee", "nyt_id": 11509, "url": "https://cooking.nytimes.com/recipes/11509-new-crawfish-etouffee", "name": "New Crawfish Etouffee", "author": "The New York Times", "description": "Paul Prudhomme was 390 pounds in 1993 when Marian Burros caught up with him in New York to talk about his efforts to lose weight. He was, he said, trying to develop new versions of his old recipes, with less fat and just as much flavor. This etouffee was one of them. \"Rich and full flavored,\" Ms. Burros declared. True indeed. And worth cooking. The New York Times", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ¼ teaspoon salt", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 2, "raw": "1 teaspoon sweet paprika", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sweet paprika", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ teaspoon onion powder", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "onion powder", "preparation": null, "optional": false}, {"position": 4, "raw": "½ teaspoon garlic powder", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "garlic powder", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon dry mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "dry mustard", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon black pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ teaspoon white pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "white pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "⅛ teaspoon cayenne", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "cayenne", "preparation": null, "optional": false}, {"position": 9, "raw": "1 cup chopped onions", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped onions", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup chopped green bell peppers", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped green bell peppers", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup chopped celery", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped celery", "preparation": null, "optional": false}, {"position": 12, "raw": "½ cup apple juice", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "apple juice", "preparation": null, "optional": false}, {"position": 13, "raw": "5 tablespoons all-purpose flour, browned (see note)", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "all-purpose flour", "preparation": "browned (see note)", "optional": false}, {"position": 14, "raw": "2 cups fish stock", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "fish stock", "preparation": null, "optional": false}, {"position": 15, "raw": "1 pound cooked crawfish tails (about 4 pounds whole crawfish, or buy the frozen tails already cleaned, cooked and shelled)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "cooked crawfish tails (about 4 pounds whole crawfish", "preparation": "or buy the frozen tails already cleaned, cooked and shelled)", "optional": false}, {"position": 16, "raw": "2 cups cooked long-grain white rice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "cooked long-grain white rice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the seasoning mix, combine the salt, paprika, onion powder, garlic powder, mustard, black pepper, white pepper and cayenne in a small bowl, and set aside. Preheat a 10-inch skillet, preferably nonstick, over high heat for about 4 minutes."}, {"position": 2, "text": "Place the onions, peppers, celery and two teaspoons of the seasoning mix in the hot skillet. Stir and cook, scraping the bottom of the skillet, about 2 minutes. Stir in the apple juice, scraping bottom of skillet, and cook until the liquid evaporates and a glaze forms, about 7 or 8 minutes."}, {"position": 3, "text": "Add the browned flour and remaining seasoning mix, and stir until a paste forms. If necessary, add small amounts of stock to moisten the flour. Spread the mixture across the bottom of the skillet and cook until the mixture sticks to the pan, 1 to 3 minutes."}, {"position": 4, "text": "Stir in the stock and bring to a boil, stirring constantly. Cook for two minutes, add the crawfish tails, mix well, and return to a full boil, and remove immediately. Serve over rice."}], "nutrition": {"calories": 279.3, "protein_g": 25.0, "carbohydrates_g": 37.3, "fat_g": 2.7, "saturated_fat_g": 0.6, "trans_fat_g": 0.0, "cholesterol_mg": 130.4, "sodium_mg": 968.2, "fiber_g": 2.5, "sugar_g": 5.4, "unsaturated_fat_g": 1.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["southern"], "diet": [], "course": ["main course"], "meal": [], "occasion": ["mardi gras"], "other": ["boil", "rice", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 50}, "video_url": null, "comment_count": null, "published_at": "1993-10-13", "scraped_at": "2026-09-07T02:22:37.555873+00:00", "scraper_version": "1.0.0"}
{"slug": "new-potato-red-pepper-and-chive-salad", "nyt_id": 4497, "url": "https://cooking.nytimes.com/recipes/4497-new-potato-red-pepper-and-chive-salad", "name": "New Potato, Red Pepper and Chive Salad", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds new potatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "new potatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "1 red pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "red pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "1 clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "2 to 3 tablespoons Balsamic vinegar (or to taste)", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": "tbsp", "item": "balsamic vinegar (or to taste)", "preparation": null, "optional": false}, {"position": 6, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup extra-virgin olive oil", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "1 bunch fresh chives, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "fresh chives", "preparation": "minced", "optional": false}], "steps": [{"position": 1, "text": "Steam the potatoes until tender (about 20 minutes)."}, {"position": 2, "text": "While the potatoes are cooking, cut the pepper into quarters, remove the stem and seeds and place the pepper face down on a broiling rack. Broil until skin is charred. Place in a paper bag a few minutes, then peel off the skin. Cut the pepper into dice."}, {"position": 3, "text": "Make the dressing. Place the mustard in a bowl large enough to hold the potatoes. Peel the garlic and crush it into the mustard with a fork. Add the vinegar, salt and pepper. Gradually beat in the olive oil, creating an emulsion."}, {"position": 4, "text": "When the potatoes are cooked, remove the garlic from the dressing. Add the potatoes and diced pepper and toss thoroughly. Add the chives and serve the salad at room temperature. Correct seasoning just before serving."}], "nutrition": {"calories": 555.9, "protein_g": 5.4, "carbohydrates_g": 44.4, "fat_g": 41.0, "saturated_fat_g": 5.7, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 734.0, "fiber_g": 5.9, "sugar_g": 4.7, "unsaturated_fat_g": 34.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["broil", "chive", "new potato", "potato salad", "red bell pepper", "steam"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1991-05-26", "scraped_at": "2026-09-07T00:33:34.219699+00:00", "scraper_version": "1.0.0"}
{"slug": "new-potato-salad-with-dill", "nyt_id": 3794, "url": "https://cooking.nytimes.com/recipes/3794-new-potato-salad-with-dill", "name": "New Potato Salad With Dill", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "2 hours"}}, "ingredients": [{"position": 1, "raw": "2 pounds new potatoes of uniform size, scrubbed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "new potatoes of uniform size", "preparation": "scrubbed", "optional": false}, {"position": 2, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup white wine vinegar", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "white wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "⅔ cup extra-virgin olive oil", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "½ tablespoon Dijon mustard", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup finely chopped scallions", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely chopped scallions", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons minced fresh dill", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh dill", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the potatoes in a saucepan, cover with cold water, bring to a boil, cover and reduce the heat to low. Cook until the potatoes are just tender, about 20 minutes. Drain and quarter the potatoes, taking care to keep the skins on."}, {"position": 2, "text": "Place the potatoes in a bowl, season lightly with salt and pepper and gently toss with two tablespoons of the vinegar and one tablespoon of the oil. Set aside until cool."}, {"position": 3, "text": "Mix the remaining vinegar with the mustard until well blended. Beat in the oil. Pour over the cooled potatoes and gently mix. Add the scallions and dill, season to taste with salt and pepper and serve."}], "nutrition": {"calories": 334.6, "protein_g": 3.3, "carbohydrates_g": 27.2, "fat_g": 24.2, "saturated_fat_g": 3.4, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 452.7, "fiber_g": 3.5, "sugar_g": 1.4, "unsaturated_fat_g": 20.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "dill", "new potato", "potato salad", "spring", "summer"]}, "images": [], "rating": {"average": 5.0, "count": 147}, "video_url": null, "comment_count": null, "published_at": "1991-06-16", "scraped_at": "2026-09-07T00:25:23.754755+00:00", "scraper_version": "1.0.0"}
{"slug": "new-potato-salad-with-sun-dried-tomatoes", "nyt_id": 2494, "url": "https://cooking.nytimes.com/recipes/2494-new-potato-salad-with-sun-dried-tomatoes", "name": "New Potato Salad With Sun-Dried Tomatoes", "author": "Florence Fabricant", "description": "", "servings": {"text": "3 to 4 servings", "min": 3, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ pounds small new potatoes, well scrubbed", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "small new potatoes", "preparation": "well scrubbed", "optional": false}, {"position": 2, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons white wine vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "white wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "6 sun-dried tomatoes, slivered", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "sun-dried tomatoes", "preparation": "slivered", "optional": false}, {"position": 5, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons minced scallions", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced scallions", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons minced fresh parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh parsley", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons minced fresh basil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh basil", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons minced fresh chervil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced fresh chervil", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup mayonnaise, preferably homemade", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "mayonnaise", "preparation": "preferably homemade", "optional": false}], "steps": [{"position": 1, "text": "Boil the potatoes until just tender. Quarter them and place in a bowl. Sprinkle with oil, vinegar and slivered sun-dried tomatoes."}, {"position": 2, "text": "Season potatoes to taste with salt and pepper (taste carefully because the tomatoes are salty). Add the herbs."}, {"position": 3, "text": "Carefully fold in the mayonnaise. Check seasonings and serve slightly warm or chilled."}], "nutrition": {"calories": 404.6, "protein_g": 4.2, "carbohydrates_g": 32.4, "fat_g": 29.3, "saturated_fat_g": 4.3, "trans_fat_g": 0.0, "cholesterol_mg": 11.3, "sodium_mg": 531.9, "fiber_g": 4.3, "sugar_g": 2.6, "unsaturated_fat_g": 24.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "new potato", "summer", "sun-dried tomato"]}, "images": [], "rating": {"average": 4.0, "count": 26}, "video_url": null, "comment_count": null, "published_at": "1985-05-12", "scraped_at": "2026-09-07T00:12:21.826873+00:00", "scraper_version": "1.0.0"}
{"slug": "new-potatoes-with-artichokes-and-fava-beans", "nyt_id": 4496, "url": "https://cooking.nytimes.com/recipes/4496-new-potatoes-with-artichokes-and-fava-beans", "name": "New Potatoes With Artichokes and Fava Beans", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "½ lemon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemon", "preparation": null, "optional": false}, {"position": 2, "raw": "2 pounds baby artichokes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "baby artichokes", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ pounds new potatoes", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "new potatoes", "preparation": null, "optional": false}, {"position": 4, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 clove garlic, crushed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "crushed", "optional": false}, {"position": 6, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "2 pounds fresh fava beans", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "fresh fava beans", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon fresh tarragon leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh tarragon leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Squeeze the lemon half into a bowl of cold water large enough to hold the artichokes. Trim the outer leaves from the artichokes and cut off the tops, two-thirds down horizontally, and the stalks. Cut the artichokes in half. As you trim each artichoke, add it to the water to prevent it from turning brown. Quarter the potatoes."}, {"position": 2, "text": "Heat the oil in a large cast-iron skillet (you may need two or to work in two batches) and sautee the potatoes with the garlic for 10 minutes. Dry the artichokes in a salad spinner and add them to the pan. If necessary, add more oil. Season to taste with salt and pepper and cook, stirring from time to time, until the potatoes and artichokes are golden (about 15 minutes)."}, {"position": 3, "text": "Meanwhile, peel the fava beans and steam them until cooked (about five minutes). Add them to the potato-artichoke mixture and cook, stirring, for one minute so that they are coated with the oil. Remove the garlic and discard. Correct seasoning, sprinkle the dish with tarragon and serve."}], "nutrition": {"calories": 418.1, "protein_g": 19.6, "carbohydrates_g": 64.2, "fat_g": 15.0, "saturated_fat_g": 2.2, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 1019.8, "fiber_g": 22.5, "sugar_g": 16.5, "unsaturated_fat_g": 12.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["baby artichoke", "fava bean", "new potato", "saute", "steam"]}, "images": [], "rating": {"average": 4.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1991-05-26", "scraped_at": "2026-09-07T00:33:30.847665+00:00", "scraper_version": "1.0.0"}
{"slug": "new-wave-piccalilli", "nyt_id": 10885, "url": "https://cooking.nytimes.com/recipes/10885-new-wave-piccalilli", "name": "New-Wave Piccalilli", "author": "Molly O’Neill", "description": "This New England staple, originally brought over from India, is best used as a topping after grilling meat or fish. It also adds zip to sandwiches.", "servings": {"text": "Two cups", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "3 red and 3 yellow bell peppers, roasted, skinned, stemmed, cored and cut into ½-inch dice", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "red and 3 yellow bell peppers", "preparation": "roasted, skinned, stemmed, cored and cut into ½-inch dice", "optional": false}, {"position": 2, "raw": "2 poblano peppers, roasted, skinned, stemmed, cored and cut into ½-inch dice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "poblano peppers", "preparation": "roasted, skinned, stemmed, cored and cut into ½-inch dice", "optional": false}, {"position": 3, "raw": "½ cup diced red onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "diced red onion", "preparation": null, "optional": false}, {"position": 4, "raw": "2 jalapenos, stemmed, seeded and minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "jalapenos", "preparation": "stemmed, seeded and minced", "optional": false}, {"position": 5, "raw": "1 clove garlic, peeled and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and minced", "optional": false}, {"position": 6, "raw": "¼ cup light brown sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup plus 1 teaspoon balsamic vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "plus 1 teaspoon balsamic vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon mustard seeds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "mustard seeds", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a medium bowl, combine the roasted peppers, red onion, jalapenos and garlic. Combine the brown sugar and vinegar in a small saucepan over low heat. Cook until sugar is melted. Pour over the pepper mixture and toss with the salt and mustard seeds. Store in an airtight container."}], "nutrition": {"calories": 220.0, "protein_g": 4.8, "carbohydrates_g": 51.0, "fat_g": 1.1, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 1007.3, "fiber_g": 4.4, "sugar_g": 27.4, "unsaturated_fat_g": 0.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["british"], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["balsamic vinegar", "bell pepper", "condiments", "dips and spreads", "poblano", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 12}, "video_url": null, "comment_count": null, "published_at": "1993-08-01", "scraped_at": "2026-09-07T01:54:17.056935+00:00", "scraper_version": "1.0.0"}
{"slug": "new-years-eve-fruit-compote", "nyt_id": 10498, "url": "https://cooking.nytimes.com/recipes/10498-new-years-eve-fruit-compote", "name": "New Year's Eve fruit compote", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "30 servings", "min": 30, "max": 30, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 1485, "raw": {"total": "45 minutes, plus 24 hours' refrigeration"}}, "ingredients": [{"position": 1, "raw": "4 pounds mixed dried fruit including, preferably, equal amounts of prunes, pears, peaches and apples", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "lb", "item": "mixed dried fruit including", "preparation": "preferably, equal amounts of prunes, pears, peaches and apples", "optional": false}, {"position": 2, "raw": "3 17-ounce jars Kadota figs in syrup", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "17-ounce jars kadota figs in syrup", "preparation": null, "optional": false}, {"position": 3, "raw": "2 pounds (drained weight) fresh or canned dark sweet pitted cherries, about four cups", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "(drained weight) fresh or canned dark sweet pitted cherries", "preparation": "about four cups", "optional": false}, {"position": 4, "raw": "Sugar to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sugar to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup or more Armagnac or Cognac", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "or more armagnac or cognac", "preparation": null, "optional": false}, {"position": 6, "raw": "4 to 6 bananas, peeled and sliced", "group": null, "quantity": 4.0, "quantity_max": 6.0, "unit": null, "item": "bananas", "preparation": "peeled and sliced", "optional": false}, {"position": 7, "raw": "2 cups fresh berries such as blueberries, strawberries or raspberries", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "fresh berries such as blueberries", "preparation": "strawberries or raspberries", "optional": false}], "steps": [{"position": 1, "text": "If the fruit has pits, cut away and remove them. Cut all the fruit in half and add to a kettle or casserole. Add water to cover and bring to the boil. Let simmer 20 minutes. Let cool."}, {"position": 2, "text": "Pour the fruit and the cooking liquid into a mixing bowl. Cut the figs in half and add them along with their syrup to the fruit in the bowl. Add the cherries and sugar to taste. Add the Armagnac or Cognac to taste."}, {"position": 3, "text": "Cover closely and refrigerate at least 24 hours to ripen. When ready to serve, add the sliced bananas and berries. Add more sugar and Armagnac or Cognac if desired."}], "nutrition": {"calories": 219.6, "protein_g": 1.2, "carbohydrates_g": 51.7, "fat_g": 0.3, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 6.2, "fiber_g": 2.4, "sugar_g": 44.2, "unsaturated_fat_g": 0.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["new year’s day"], "other": ["boil", "cherry", "dried fruit", "fig"]}, "images": [], "rating": {"average": 4.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "1982-10-24", "scraped_at": "2026-09-07T01:35:56.450079+00:00", "scraper_version": "1.0.0"}

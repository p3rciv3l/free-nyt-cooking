{"slug": "nutmeg-maple-cream-pie", "nyt_id": 452, "url": "https://cooking.nytimes.com/recipes/452-nutmeg-maple-cream-pie", "name": "Nutmeg-Maple Cream Pie", "author": "Melissa Clark", "description": "This pie is a delicious twist on a custard standby, and it is exceedingly easy, a humble yet grandly flavored addition to any celebration. Don't let making your own pie crust intimidate you: our pie guide has everything you need to know.", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "1 hour 45 minutes"}}, "ingredients": [{"position": 1, "raw": "¾ cup maple syrup", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "maple syrup", "preparation": null, "optional": false}, {"position": 2, "raw": "2 ¼ cups heavy cream", "group": null, "quantity": 2.25, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 3, "raw": "4 egg yolks", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "egg yolks", "preparation": null, "optional": false}, {"position": 4, "raw": "1 whole egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "whole egg", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon freshly grated nutmeg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "freshly grated nutmeg", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 8, "raw": "1 pre-baked 9-inch pie crust (see recipe)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "pre-baked 9-inch pie crust (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 300 degrees. In a medium saucepan over medium-high heat, reduce maple syrup by a quarter, 5 to 7 minutes. Stir in cream and bring to a simmer. Remove from heat."}, {"position": 2, "text": "In a medium bowl, whisk together egg yolks and egg. Whisking constantly, slowly add cream mixture to eggs. Strain mixture through a fine-mesh sieve into a cup or bowl with pouring spout. Stir in salt, nutmeg and vanilla."}, {"position": 3, "text": "Pour filling into crust and transfer to a rimmed baking sheet. Bake until pie is firm to touch but jiggles slightly when moved, about 1 hour. Let cool to room temperature before serving."}], "nutrition": {"calories": 464.1, "protein_g": 4.5, "carbohydrates_g": 36.8, "fat_g": 33.9, "saturated_fat_g": 19.0, "trans_fat_g": 0.8, "cholesterol_mg": 168.4, "sodium_mg": 222.4, "fiber_g": 0.6, "sugar_g": 20.0, "unsaturated_fat_g": 12.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["christmas", "new year’s day", "thanksgiving"], "other": ["bake", "fall", "heavy cream", "maple syrup", "nutmeg", "pie", "winter", "baking"]}, "images": [{"url": "https://static01.nyt.com/images/2018/10/03/dining/nutmeg-cream-pie-horizontal/nutmeg-cream-pie-horizontal-facebookJumbo.jpg", "alt": "Melissa Clark's nutmeg maple cream pie.", "primary": true}], "rating": {"average": 5.0, "count": 1358}, "video_url": null, "comment_count": null, "published_at": "2006-11-15", "scraped_at": "2026-09-07T06:04:03.774566+00:00", "scraper_version": "1.0.0"}
{"slug": "nutmeg-scented-onion-gratin", "nyt_id": 365, "url": "https://cooking.nytimes.com/recipes/365-nutmeg-scented-onion-gratin", "name": "Nutmeg-Scented Onion Gratin", "author": "Patricia Wells", "description": "", "servings": {"text": "Six to eight servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "6 medium white or yellow onions (about 2 pounds), peeled and cut horizontally into 3 thick slices", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "medium white or yellow onions (about 2 pounds)", "preparation": "peeled and cut horizontally into 3 thick slices", "optional": false}, {"position": 2, "raw": "3 tablespoons heavy cream", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 3, "raw": "Freshly grated nutmeg to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly grated nutmeg to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup freshly grated imported Gruyere cheese", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "freshly grated imported gruyere cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring a large pot of water to a boil. Salt the water and add the onions. Cook until tender, about 10 minutes. (The slices will separate.) Drain."}, {"position": 2, "text": "In a large bowl, toss the onions with the cream and season generously with nutmeg and salt. Spoon into a shallow gratin dish. (The gratin can be prepared several hours in advance, up to this point. Reserve at room tempe
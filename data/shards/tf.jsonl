{"slug": "tfaya-baked-chicken", "nyt_id": 1023261, "url": "https://cooking.nytimes.com/recipes/1023261-tfaya-baked-chicken", "name": "Tfaya Baked Chicken", "author": "Nargisse Benkabbou", "description": "This one-pan chicken dish is a practically effortless meal packed with the flavors of Morocco. Tfaya is a sweet and savory Moroccan sauce made of caramelized onions, raisins and spices, and here those ingredients are used to create a comforting meal that requires only 10 minutes of preparation time.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "2 cups raisins", "group": null, "quantity": 2.0, "unit": "cup", "item": "raisins", "preparation": null, "optional": false}, {"position": 2, "raw": "3 large red onions (about 1 pound), halved and sliced", "group": null, "quantity": 3.0, "unit": null, "item": "large red onions", "preparation": "halved and sliced", "optional": false}, {"position": 3, "raw": "4 chicken leg quarters (about 2 ½ pounds total)", "group": null, "quantity": 4.0, "unit": null, "item": "chicken leg quarters", "preparation": null, "optional": false}, {"position": 4, "raw": "Generous ¼ cup sliced almonds", "group": null, "quantity": null, "unit": null, "item": "generous ¼ cup sliced almonds", "preparation": null, "optional": false}, {"position": 5, "raw": "Couscous or bread, for serving", "group": null, "quantity": null, "unit": null, "item": "couscous or bread", "preparation": "for serving", "optional": false}, {"position": 6, "raw": "½ cup vegetable stock", "group": null, "quantity": 0.5, "unit": "cup", "item": "vegetable stock", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons honey", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 9, "raw": "4 garlic cloves, pressed or finely chopped", "group": null, "quantity": 4.0, "unit": null, "item": "garlic cloves", "preparation": "pressed or finely chopped", "optional": false}, {"position": 10, "raw": "¾ teaspoon ground turmeric", "group": null, "quantity": 0.75, "unit": "tsp", "item": "ground turmeric", "preparation": null, "optional": false}, {"position": 11, "raw": "¾ teaspoon ground ginger", "group": null, "quantity": 0.75, "unit": "tsp", "item": "ground ginger", "preparation": null, "optional": false}, {"position": 12, "raw": "¾ teaspoon fine sea salt", "group": null, "quantity": 0.75, "unit": "tsp", "item": "fine sea salt", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ teaspoon black pepper", "group": null, "quantity": 0.25, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ teaspoon ground cinnamon", "group": null, "quantity": 0.25, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oven to 400 degrees. Soak the raisins in hot water for 5 minutes or until softened; drain and transfer to a deep roasting pan."}, {"position": 2, "text": "Make the marinade: Transfer the stock, olive oil, honey, garlic, turmeric, ginger, salt, black pepper and cinnamon to a large bowl; mix until smooth and well combined."}, {"position": 3, "text": "Add the onions to the roasting pan and pour approximately half of the marinade over the onions and raisins. Use your hands or tongs to combine."}, {"position": 4, "text": "Transfer the chicken legs to the large bowl with the remaining marinade and use your hands or tongs to make sure that the chicken is thoroughly coated. Place the chicken legs on top of the onion mixture, skin-side up, and pour any remaining marinade over the chicken."}, {"position": 5, "text": "Bake in the oven for 35 minutes. Remove the roasting pan from the oven and scatter the almonds on top. Return to the oven for another 10 to 15 minutes, until the chicken is cooked through and golden and the almonds are nicely toasted. Serve immediately, with a side of couscous or bread."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 1173.0, "protein_g": 62.2, "carbohydrates_g": 83.8, "fat_g": 68.4, "saturated_fat_g": 16.8, "unsaturated_fat_g": 13.4, "trans_fat_g": 0.2, "cholesterol_mg": 319.9, "sodium_mg": 755.3, "fiber_g": 6.5, "sugar_g": 61.0, "computed_with": null}, "tags": {"cuisine": ["moroccan"], "diet": [], "course": ["dinner-lunch-main-course-poultry"], "meal": [], "occasion": [], "other": ["almond", "chicken-leg", "raisin"]}, "images": [{"url": "https://static01.nyt.com/images/2022/06/06/dining/nb-baked-tfaya-chicken/merlin_207648018_779c1fb3-46d7-4de4-97dc-333d40dcd098-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2022/06/06/dining/nb-baked-tfaya-chicken/merlin_207648018_779c1fb3-46d7-4de4-97dc-333d40dcd098-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2022/06/06/dining/nb-baked-tfaya-chicken/nb-baked-tfaya-chicken-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2022/06/06/dining/nb-baked-tfaya-chicken/merlin_207648018_779c1fb3-46d7-4de4-97dc-333d40dcd098-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 561}, "video_url": null, "comment_count": null, "published_at": "2022-06-08", "scraped_at": "2026-09-07T06:59:40Z", "scraper_version": "1.0.0"}

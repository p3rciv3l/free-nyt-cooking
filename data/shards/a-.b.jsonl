{"slug": "a-smooth-and-creamy-pate", "nyt_id": 10990, "url": "https://cooking.nytimes.com/recipes/10990-a-smooth-and-creamy-pate", "name": "A Smooth And Creamy Pâté", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "6 servings, about 2 cups", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "16 ounces chicken livers", "group": null, "quantity": 16.0, "quantity_max": null, "unit": "oz", "item": "chicken livers", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup milk, approximately", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": "approximately", "optional": false}, {"position": 3, "raw": "½ cup (8 tablespoons) unsalted butter, softened", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "(8 tablespoons) unsalted butter", "preparation": "softened", "optional": false}, {"position": 4, "raw": "6 tablespoons heavy cream", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "2 to 3 tablespoons brandy", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": "tbsp", "item": "brandy", "preparation": null, "optional": false}, {"position": 7, "raw": "2 to 3 tablespoons green peppercorns, optional", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": "tbsp", "item": "green peppercorns", "preparation": null, "optional": true}, {"position": 8, "raw": "¼ cup (4 tablespoons) cold unsalted butter, cubed", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "(4 tablespoons) cold unsalted butter", "preparation": "cubed", "optional": false}], "steps": [{"position": 1, "text": "Trim livers of little sinews or dark spots. Place in a bowl and add milk to cover. Set aside 30 minutes."}, {"position": 2, "text": "Melt one-third of the softened butter, about 2 ½ tablespoons, in a shallow skillet over medium-high heat. Drain livers. When butter starts to foam, slip livers into pan (they will spit) and sauté quickly, turning once, until lightly crusted and golden outside and cooked but still pink in the center."}, {"position": 3, "text": "Place contents of pan, remaining softened butter, cream and salt and pepper into a blender or food processor and purée."}, {"position": 4, "text": "Bring brandy to a boil in the skillet, add to the blender or food processor and briefly process again. Taste and add salt and pepper as needed, remembering that the pâté will be served chilled so the seasoning will not be as strong."}, {"position": 5, "text": "Pass pâté through a fine sieve into a bowl, fold in green peppercorns if desired, then transfer to a ceramic terrine or serving bowl. Smooth top and refrigerate for 30 minutes, uncovered. Meanwhile, melt remaining butter and skim off solids."}, {"position": 6, "text": "Pour clarified butter over pâté to seal top, cover with plastic wrap, and return to refrigerator at least 3 hours or overnight."}], "nutrition": {"calories": 372.2, "protein_g": 14.2, "carbohydrates_g": 2.4, "fat_g": 32.8, "saturated_fat_g": 19.3, "trans_fat_g": 0.2, "cholesterol_mg": 340.8, "sodium_mg": 347.6, "fiber_g": 0.2, "sugar_g": 1.6, "unsaturated_fat_g": 11.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": ["dinner"], "occasion": [], "other": ["broil", "chicken liver"]}, "images": [], "rating": {"average": 4.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "2002-10-23",
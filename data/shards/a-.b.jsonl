ntity_max": null, "unit": "cup", "item": "(4 tablespoons) cold unsalted butter", "preparation": "cubed", "optional": false}], "steps": [{"position": 1, "text": "Trim livers of little sinews or dark spots. Place in a bowl and add milk to cover. Set aside 30 minutes."}, {"position": 2, "text": "Melt one-third of the softened butter, about 2 ½ tablespoons, in a shallow skillet over medium-high heat. Drain livers. When butter starts to foam, slip livers into pan (they will spit) and sauté quickly, turning once, until lightly crusted and golden outside and cooked but still pink in the center."}, {"position": 3, "text": "Place contents of pan, remaining softened butter, cream and salt and pepper into a blender or food processor and purée."}, {"position": 4, "text": "Bring brandy to a boil in the skillet, add to the blender or food processor and briefly process again. Taste and add salt and pepper as needed, remembering that the pâté will be served chilled so the seasoning will not be as strong."}, {"position": 5, "text": "Pass pâté through a fine sieve into a bowl, fold in green peppercorns if desired, then transfer to a ceramic terrine or serving bowl. Smooth top and refrigerate for 30 minutes, uncovered. Meanwhile, melt remaining butter and skim off solids."}, {"position": 6, "text": "Pour clarified butter over pâté to seal top, cover with plastic wrap, and return to refrigerator at least 3 hours or overnight."}], "nutrition": {"calories": 372.2, "protein_g": 14.2, "carbohydrates_g": 2.4, "fat_g": 32.8, "saturated_fat_g": 19.3, "trans_fat_g": 0.2, "cholesterol_mg": 340.8, "sodium_mg": 347.6, "fiber_g": 0.2, "sugar_g": 1.6, "unsaturated_fat_g": 11.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": ["dinner"], "occasion": [], "other": ["broil", "chicken liver"]}, "images": [], "rating": {"average": 4.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "2002-10-23",
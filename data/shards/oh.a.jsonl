{"slug": "oh-my-word", "nyt_id": 1018433, "url": "https://cooking.nytimes.com/recipes/1018433-oh-my-word", "name": "Oh, My Word!", "author": "Sother Teague", "description": "Sother Teague, of the Amaro-centric New York City bar Amor y Amargo, devised this riff on the classic cocktail, the Last Word. Teague uses Old Tom gin (a style of the spirit that’s sweeter than London dry gin), and amaro Montenegro, with its pronounced notes of orange, replaces the fresh lime juice in the original. If you haven’t made cocktails with amaro before, this is a good place to start: elegant, straightforward and easy to make.", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": null, "raw": {}}, "ingredients": [{"position": 1, "raw": "¾ oz. Old Tom gin", "group": null, "quantity": 0.75, "unit": "oz", "item": "old tom gin", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ oz. Amaro Montenegro", "group": null, "quantity": 0.75, "unit": "oz", "item": "amaro montenegro", "preparation": null, "optional": false}, {"position": 3, "raw": "¾ oz. Chartreuse", "group": null, "quantity": 0.75, "unit": "oz", "item": "chartreuse", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ oz. maraschino liqueur", "group": null, "quantity": 0.75, "unit": "oz", "item": "maraschino liqueur", "preparation": null, "optional": false}, {"position": 5, "raw": "2 dashes lime bitters", "group": null, "quantity": 2.0, "unit": "dash", "item": "lime bitters", "preparation": null, "optional": false}, {"position": 6, "raw": "Lemon twist", "group": null, "quantity": null, "unit": null, "item": "lemon twist", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "None"}], "nutrition": null, "tags": {"cuisine": [], "diet": [], "course": ["cocktails"], "meal": [], "occasion": [], "other": ["gin"]}, "images": [{"url": "https://static01.nyt.com/images/2016/11/27/magazine/27drin
 "cumin", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon coarse salt, plus additional to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "coarse salt", "preparation": "plus additional to taste", "optional": false}, {"position": 9, "raw": "1 teaspoon cayenne", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cayenne", "preparation": null, "optional": false}, {"position": 10, "raw": "3 tablespoons red-wine vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "8 sheets gelatin", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "sheet", "item": "gelatin", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons finely diced cucumber", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely diced cucumber", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon finely diced red pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely diced red pepper", "preparation": null, "optional": false}, {"position": 14, "raw": "1 tablespoon finely diced green pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely diced green pepper", "preparation": null, "optional": false}, {"position": 15, "raw": "1 teaspoon finely diced chives", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely diced chives", "preparation": null, "optional": false}, {"position": 16, "raw": "4 pieces baby cilantro", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "piece", "item": "baby cilantro", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Process vegetables in three batches, each with a third of the cumin, salt, cayenne and vinegar, until finely chopped, placing each batch in a sieve or colander lined with a double thickness of cheesecloth over a bowl. Gather the cheesecloth edges together and tie with string. Gently press (not squeeze) to extract the gazpacho water. Refrigerate overnight and allow water to release, weighing down the vegetables with cans or weights and turning frequently."}, {"position": 2, "text": "Taste the gazpacho water and adjust seasoning. Soften the gelatin in a bowl of cold water. Warm 1 cup of the gazpacho water over medium heat and add the softened gelatin sheets. Cook slowly until melted and then stir into the remaining gazpacho liquid. Place in a shallow pan and refrigerate until firm, about 30 minutes."}, {"position": 3, "text": "To serve, finely chop the gelee and spoon into martini glasses. Garnish with finely diced vegetables and a sprig of the cilantro."}], "nutrition": {"calories": 91.3, "protein_g": 9.1, "carbohydrates_g": 14.5, "fat_g": 0.8, "saturated_fat_g": 0.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 751.0, "fiber_g": 3.5, "sugar_g": 7.7, "unsaturated_fat_g": 0.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course", "side dish"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["bell pepper", "cucumber", "gazpacho", "summer", "tomato"]}, "images": [], "rating": {"average": 3.0, "count": 25}, "video_url": null, "comment_count": null, "published_at": "2002-08-04", "scraped_at": "2026-09-06T22:22:50.784989+00:00", "scraper_version": "1.0.0"}

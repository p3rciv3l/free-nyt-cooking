roup": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the olive oil in a heavy saucepan. Add the onions, the garlic and the eggplant. Cook briefly, stirring, until wilted."}, {"position": 2, "text": "Add the rice and stir to blend. Add the bay leaf, the water and the pepper flakes, salt and pepper to taste. Bring to a boil, stirring, cover tightly and simmer for 17 minutes."}, {"position": 3, "text": "Uncover, remove the bay leaf and stir with a fork to fluff."}], "nutrition": {"calories": 253.9, "protein_g": 3.9, "carbohydrates_g": 43.1, "fat_g": 7.1, "saturated_fat_g": 1.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 456.8, "fiber_g": 1.5, "sugar_g": 2.0, "unsaturated_fat_g": 5.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "easy", "eggplant", "quick", "rice", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "1993-06-16", "scraped_at": "2026-09-06T22:24:20.377893+00:00", "scraper_version": "1.0.0"}
{"slug": "risotto-with-mushrooms-and-chicken-livers", "nyt_id": 1204, "url": "https://cooking.nytimes.com/recipes/1204-risotto-with-mushrooms-and-chicken-livers", "name": "Risotto With Mushrooms And Chicken Livers", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "½ pound chicken livers", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "chicken livers", "preparation": null, "optional": false}, {"position": 2, "raw": "3 tablespoons extra-virgin olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "3 ½ to 4 cups well-seasoned chicken stock", "group": null, "quantity": 3.5, "quantity_max": 4.0, "unit": "cup", "item": "well-seasoned chicken stock", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup finely chopped onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "finely chopped onion", "preparation": null, "optional": false}, {"position": 5, "raw": "10 ounces coarsely chopped cremini mushrooms", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "coarsely chopped cremini mushrooms", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ⅓ cups arborio rice", "group": null, "quantity": 1.3333333333333333, "quantity_max": null, "unit": "cup", "item": "arborio rice", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup dry white wine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon finely minced fresh thyme", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely minced fresh thyme", "preparation": null, "optional": false}, {"position": 9, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "Freshly grated Parmesan cheese", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Rinse the chicken livers. Cut them in small pieces, about half-inch squares, removing any sinew or membrane. Dry them on paper towels."}, {"position": 2, "text": "Heat two tablespoons of the oil in a heavy four-quart saucepan. Add the chicken livers and saute, stirring, until they are lightly browned."}, {"position": 3, "text": "While the chicken livers are cooking, bring the stock to a simmer in another saucepan."}, {"position": 4, "text": "When the livers are done, remove them from the pan and set them aside. Add the remaining oil to the pan, along with the onion and mushrooms. Saute over medium heat until the onion is tender. Stir in the rice and cook for a minute or so; then stir in the wine. Cook over medium heat until the wine has been absorbed. Stir in the thyme."}, {"position": 5, "text": "Begin to add the stock half a cup at a time, stirring constantly. As the stock is absorbed, add more. After about 20 minutes the rice should be tender. Season to taste with salt and pepper."}, {"position": 6, "text": "Fold in the chicken livers, and cook another minute or so, until they are heated through. Serve at once with Parmesan cheese on the side."}], "nutrition": {"calories": 370.7, "protein_g": 16.2, "carbohydrates_g": 45.4, "fat_g": 11.9, "saturated_fat_g": 2.8, "trans_fat_g": 0.0, "cholesterol_mg": 138.1, "sodium_mg": 755.8, "fiber_g": 2.0, "sugar_g": 3.9, "unsaturated_fat_g": 8.4, "source": "nyt", "basis": "per_se
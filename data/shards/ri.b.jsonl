{"slug": "rice-cucumber-and-crab-meat-salad-with-lemon-and-parsley-oil", "nyt_id": 10893, "url": "https://cooking.nytimes.com/recipes/10893-rice-cucumber-and-crab-meat-salad-with-lemon-and-parsley-oil", "name": "Rice, Cucumber And Crab-Meat Salad With Lemon-And-Parsley Oil", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 70, "raw": {"total": "10 minutes, plus 1 hour's draining"}}, "ingredients": [{"position": 1, "raw": "4 cucumbers, peeled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "cucumbers", "preparation": "peeled", "optional": false}, {"position": 2, "raw": "1 teaspoon salt, plus more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 3, "raw": "2 cups cooked white rice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "cooked white rice", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup lump crab meat, picked over to remove any shell", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "lump crab meat", "preparation": "picked over to remove any shell", "optional": false}, {"position": 5, "raw": "1 teaspoon lemon-and-parsley oil (recipe above)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "lemon-and-parsley oil (recipe above)", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons chopped chives", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped chives", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut the cucumbers in half lengthwise and scrape out the seeds. Sprinkle with 1 teaspoon of the salt and place on paper towels to drain for 1 hour. Press out any excess water, rinse to remove salt, pat dry and cut into medium dice."}, {"position": 2, "text": "Place the rice in a bowl and toss with the cucumbers, crab meat, lemon-and-parsley oil, chives and salt and pepper to taste. Can be served cold or at room temperature."}], "nutrition": {"calories": 207.7, "protein_g": 10.4, "carbohydrates_g": 38.4, "fat_g": 2.0, "saturated_fat_g": 0.3, "trans_fat_g": 0.0, "cholesterol_mg": 32.7, "sodium_mg": 778.3, "fiber_g": 2.1, "sugar_g": 5.1, "unsaturated_fat_g": 1.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["cucumber", "salad", "summer"]}, "images": [], "rating": {"average": 3.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "1993-05-30", "scraped_at": "2026-09-06T22:33:29.659365+00:00", "scraper_version": "1.0.0"}
{"slug": "rice-salad-with-chorizo", "nyt_id": 11671, "url": "https://cooking.nytimes.com/recipes/11671-rice-salad-with-chorizo", "name": "Rice Salad With Chorizo", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 30, "cook_minutes": 20, "total_minutes": 50, "raw": {"total": "50 minutes", "prep": "30 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "2 ½ cups water", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 2, "raw": "1 pound chorizo sausages", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "chorizo sausages", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup short-grain rice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "short-grain rice", "preparation": null, "optional": false}, {"position": 4, "raw": "2 small tomatoes, peeled if desired, and chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small tomatoes", "preparation": "peeled if desired, and chopped", "optional": false}, {"position": 5, "raw": "1 cucumber, peeled, seeded and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "cucumber", "preparation": "peeled, seeded and chopped", "optional": false}, {"position": 6, "raw": "2 tablespoons chopped scallions", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped scallions", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons chopped fresh coriander or Italian parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh coriander or italian parsley", "preparation": null, "optional": false}, {"position": 8, "raw": "4 tablespoons extra-virgin olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons white wine vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "white wine vinegar", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt and Cayenne pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and cayenne pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring one cup water to a simmer in a skillet, add the sausage and cook over medium heat until the water evaporates. Prick the sausages in several places as they cook. After the water has evaporated, continue cooking the sausages until they are lightly browned on all sides. Set aside to cool."}, {"position": 2, "text": "Bring two-and-a-half cups water to a boil in a saucepan, stir in the rice, cover and simmer over very low heat for 17 minutes, until the water is absorbed. Remove from heat and allow to sit covered for another five minutes."}, {"position": 3, "text": "Meanwhile, slice the sausages. Place them in a bowl and toss with the tomatoes, cucumber, scallions and coriander."}, {"position": 4, "text": "When the rice is done, allow it to cool, then fold in the oil and vinegar. Season with salt and Cayenne pepper. Fold the seasoned rice into the sausage mixture. Refrigerate."}], "nutrition": {"calories": 643.4, "protein_g": 21.6, "carbohydrates_g": 44.5, "fat_g": 42.1, "saturated_fat_g": 10.6, "trans_fat_g": 0.1, "cholesterol_mg": 79.4, "sodium_mg": 1060.0, "fiber_g": 1.0, "sugar_g": 3.6, "unsaturated_fat_g": 27.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["side dish"], "meal": [], "occasion": ["picnic"], "other": ["boil", "chorizo", "fry", "rice", "salad"]}, "images": [], "rating": {"average": 4.0, "count": 11}, "video_url": null, "comment_count":
{"slug": "germaines-scallop-salad", "nyt_id": 10864, "url": "https://cooking.nytimes.com/recipes/10864-germaines-scallop-salad", "name": "Germaine's Scallop Salad", "author": "Marian Burros", "description": "", "servings": {"text": "Twelve servings", "min": 12, "max": 12, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 135, "raw": {"total": "15 minutes, plus 2 hours marination"}}, "ingredients": [{"position": 1, "raw": "2 ½ pounds bay scallops, cleaned and rinsed", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "lb", "item": "bay scallops", "preparation": "cleaned and rinsed", "optional": false}, {"position": 2, "raw": "1 ½ cups lemon juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 3, "raw": "Freshly ground white pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground white pepper to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup vegetable oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 5, "raw": "6 tablespoons distilled white vinegar", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "distilled white vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cloves garlic, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "chopped", "optional": false}, {"position": 7, "raw": "1 large white onion, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large white onion", "preparation": "chopped", "optional": false}, {"position": 8, "raw": "1 ½ teaspoons sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "op
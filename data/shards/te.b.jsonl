{"slug": "tennessee-corn-and-truffle-flan", "nyt_id": 11591, "url": "https://cooking.nytimes.com/recipes/11591-tennessee-corn-and-truffle-flan", "name": "Tennessee Corn and Truffle Flan", "author": "Molly O’Neill", "description": "Molly O'Neill", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ cup flour", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup fine cornmeal", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "fine cornmeal", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ teaspoon baking soda", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 5, "raw": "⅛ teaspoon sea salt", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "sea salt", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups fresh or frozen corn kernels", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "fresh or frozen corn kernels", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup unsalted butter, melted", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "unsalted butter", "preparation": "melted", "optional": false}, {"position": 8, "raw": "2 large eggs, beaten well", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "beaten well", "optional": false}, {"position": 9, "raw": "Dash of cayenne pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "dash of cayenne pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "2 cups sour cream", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup grated Parmesan cheese", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "grated parmesan cheese", "preparation": null, "optional": false}, {"position": 12, "raw": "1 to 2 ounces finely shaved fresh black winter truffle", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "oz", "item": "finely shaved fresh black winter truffle", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 325 degrees. In a bowl, combine flour, cornmeal, sugar, baking soda and sea salt. Set aside. If using frozen corn, make sure it is well-defrosted and drained."}, {"position": 2, "text": "Warm a nonstick skillet over high heat and toss corn in to dry and toast slightly. In a bowl, combine cooked corn with 7 tablespoons melted butter, the eggs, cayenne and sour cream. Using a few swift strokes, add dry ingredients. Stir in cheese and shaved truffle, reserving just enough truffle to garnish flan before serving."}, {"position": 3, "text": "Use remaining tablespoon butter to grease 8 6-ounce ramekins. Spoon mixture into ramekins, cover each with foil and place in a baking pan. Add boiling water to pan until it reaches halfway up ramekins. Bake for 25 minutes. Remove from oven and allow to rest, covered, for 10 minutes before serving. Flan can be served, garnished with additional truffle slices, in ramekin or loosened and turned out on a plate."}], "nutrition": {"calories": 417.9, "protein_g": 12.6, "carbohydrates_g": 28.7, "fat_g": 29.3, "saturated_fat_g": 16.2, "trans_fat_g": 0.5, "cholesterol_mg": 123.6, "sodium_mg": 329.4, "fiber_g": 5.1, "sugar_g": 5.0, "unsaturated_fat_g": 9.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["bake", "corn", "truffle"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2007-02-28", "scraped_at": "2026-09-07T02:28:04.439308+00:00", "scraper_version": "1.0.0"}
{"slug": "tequila-el-diablo", "nyt_id": 12440, "url": "https://cooking.nytimes.com/recipes/12440-tequila-el-diablo", "name": "Tequila: El Diablo", "author": "Mark Bittman", "description": "Crème de cassis is a deep red liqueur made from black currants, and it gives this drink its reddish color. The ginger beer makes this drink bubbly and refreshing, the perfect sip on a warm evening.", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 2, "raw": {"total": "2 minutes"}}, "ingredients": [{"position": 1, "raw": "Ice", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "ice", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup tequila", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "tequila", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ tablespoon triple Sec", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "triple sec", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ tablespoon lime juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "lime juice", "preparation": null, "optional": false}, {"position": 5, "raw": "1 ½ tablespoons crème de cassis", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "crème de cassis", "preparation": null, "optional": false}, {"position": 6, "raw": "Ginger beer", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "ginger beer", "preparation": null, "optional": false}, {"position": 7, "raw": "Garnish: lemon wedge", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "garnish: lemon wedge", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine lots of ice, the tequila, triple sec and lime juice in a mixing glass and shake. Add 1 ½ tablespoons crème de cassis.
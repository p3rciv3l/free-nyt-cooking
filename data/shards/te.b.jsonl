{"slug": "tea-smoked-chicken-thighs-with-pomegranate-glaze", "nyt_id": 12139, "url": "https://cooking.nytimes.com/recipes/12139-tea-smoked-chicken-thighs-with-pomegranate-glaze", "name": "Tea-Smoked Chicken Thighs With Pomegranate Glaze", "author": "Dana Bowen", "description": "", "servings": {"text": "4 entrée portions", "min": 4, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 small oranges or tangerines", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small oranges or tangerines", "preparation": null, "optional": false}, {"position": 2, "raw": "2 heaping teaspoons loose leaf tea (both Earl Grey and jasmine work well)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "heaping teaspoons loose leaf tea (both earl grey and jasmine work well)", "preparation": null, "optional": false}, {"position": 3, "raw": "4 to 6 star anise pods", "group": null, "quantity": 4.0, "quantity_max": 6.0, "unit": null, "item": "star anise pods", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cinnamon stick (optional)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "cinnamon stick", "preparation": null, "optional": true}, {"position": 5, "raw": "2 to 2 ½ pounds skin-on chicken thighs", "group": null, "quantity": 2.0, "quantity_max": 2.5, "unit": "lb", "item": "skin-on chicken thighs", "preparation": null, "optional": false}, {"position": 6, "raw": "Freshly ground black pepper and salt, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper and salt", "preparation": "to taste", "optional": false}, {"position": 7, "raw": "¼ cup hoisin sauce", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "hoisin sauce", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ tablespoons pomegranate molasses", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "pomegranate molasses", "preparation": null, "optional": false}, {"position": 9, "raw": "Sriracha chili sauce, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sriracha chili sauce", "preparation": "to taste", "optional": false}, {"position": 10, "raw": "2 tablespoons canola oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "canola oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Zest one orange and peel other; set zest and peels aside. Cut oranges in half and squeeze juice through wire mesh strainer into a bowl. Reserve juice."}, {"position": 2, "text": "Scatter orange peels, tea, star anise and cinnamon around center of bottom of smoker. Cover with drip tray and wire rack. Arrange thighs on rack and season generously with pepper and salt. Place on stove over medium heat and after first wisp of smoke appears, cover tightly with lid. Smoke for 20 to 25 minutes. Shut off heat and rest for 5 minutes with lid on."}, {"position": 3, "text": "While chicken is smoking, combine zest, hoisin, pomegranate molasses and sriracha in a small bowl. Add about half reserved juice, more if sauce is too thick. Set glaze aside."}, {"position": 4, "text": "Pour oil in a nonstick or well-seasoned cast-iron pan over medium high heat. When hot, add chicken, and cook about three minutes per side. Reduce heat to medium low, brush both sides of chicken with glaze, and cook for another few minutes until crisp. Serve immediately, with extra sauce on the side."}], "nutrition": {"calories": 703.8, "protein_g": 43.3, "carbohydrates_g": 17.9, "fat_g": 50.4, "saturated_fat_g": 12.2, "trans_fat_g": 0.2, "cholesterol_mg": 250.5, "sodium_mg": 715.0, "fiber_g": 1.6, "sugar_g": 11.8, "unsaturated_fat_g": 33.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, 
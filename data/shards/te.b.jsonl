{"slug": "tequila-paloma", "nyt_id": 12439, "url": "https://cooking.nytimes.com/recipes/12439-tequila-paloma", "name": "Tequila: Paloma", "author": "Mark Bittman", "description": "The paloma gives a starring role to the grapefruit, using its juice and garnishing with a beautiful wedge. It can be made with regular old grapefruit, but it also be made more festive by using a ruby-red grapefruit.", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 2, "raw": {"total": "2 minutes"}}, "ingredients": [{"position": 1, "raw": "Ice", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "ice", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup of tequila", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "of tequila", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ tablespoon of lime juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "of lime juice", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon grapefruit juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "grapefruit juice", "preparation": null, "optional": false}, {"position": 5, "raw": "Garnish: Grapefruit wedge", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "garnish: grapefruit wedge", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine lots of ice, the tequila, lime juice and grapefruit juice in a mixing glass and shake. Top with soda. Salt the rim of another glass and strain in the mixture. Garnish: Grapefruit wedge."}], "nutrition": {"calories": 109.5, "protein_g": 0.9, "carbohydrates_g": 11.6, "fat_g": 0.1, "saturated_fat_g": 0.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 0.7, "fiber_g": 1.4, "sugar_g": 9.5, "unsaturated_fat_g": 0.1, "source": "nyt", "ba
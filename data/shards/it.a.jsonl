{"slug": "italian-mushroom-and-celery-salad", "nyt_id": 1016496, "url": "https://cooking.nytimes.com/recipes/1016496-italian-mushroom-and-celery-salad", "name": "Italian Mushroom and Celery Salad", "author": "Martha Rose Shulman", "description": "Whenever I teach this Italian salad in a cooking class the students always tell me how skeptical they were before tasting it. It may seem plain, but there’s something about the combination of textures and the tart and savory flavors of the lemon juice and Parmesan that really works here.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "½ pound cremini or white button mushrooms, very thinly sliced", "group": null, "quantity": 0.5, "unit": "lb", "item": "cremini or white button mushrooms", "preparation": "very thinly sliced", "optional": false}, {"position": 2, "raw": "4 celery stalks, from the heart of the celery, very thinly sliced", "group": null, "quantity": 4.0, "unit": null, "item": "celery stalks", "preparation": "from the heart of the celery, very thinly sliced", "optional": false}, {"position": 3, "raw": "2 tablespoons chopped fresh flat-leaf parsley", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped fresh flat-leaf parsley", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon minced chives", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "minced chives", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ tablespoons lemon juice, or 1 tablespoon lemon juice and ½ tablespoon (1 ½ teaspoons) white wine vinegar or sherry vinegar", "group": null, "quantity": 1.5, "unit": "tbsp", "item": "lemon juic
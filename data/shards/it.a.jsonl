{"slug": "italian-mushroom-and-celery-salad", "nyt_id": 1016496, "url": "https://cooking.nytimes.com/recipes/1016496-italian-mushroom-and-celery-salad", "name": "Italian Mushroom and Celery Salad", "author": "Martha Rose Shulman", "description": "Whenever I teach this Italian salad in a cooking class the students always tell me how skeptical they were before tasting it. It may seem plain, but there’s something about the combination of textures and the tart and savory flavors of the lemon juice and Parmesan that really works here.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "½ pound cremini or white button mushrooms, very thinly sliced", "group": null, "quantity": 0.5, "unit": "lb", "item": "cremini or white button mushrooms", "preparation": "very thinly sliced", "optional": false}, {"position": 2, "raw": "4 celery stalks, from the heart of the celery, very thinly sliced", "group": null, "quantity": 4.0, "unit": null, "item": "celery stalks", "preparation": "from the heart of the celery, very thinly sliced", "optional": false}, {"position": 3, "raw": "2 tablespoons chopped fresh flat-leaf parsley", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped fresh flat-leaf parsley", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon minced chives", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "minced chives", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ tablespoons lemon juice, or 1 tablespoon lemon juice and ½ tablespoon (1 ½ teaspoons) white wine vinegar or sherry vinegar", "group": null, "quantity": 1.5, "unit": "tbsp", "item": "lemon juice", "preparation": "or 1 tablespoon lemon juice and ½ tablespoon (1 ½ teaspoons) white wine vinegar or sherry vinegar", "optional": false}, {"position": 7, "raw": "¼ cup extra-virgin olive oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "2 ounces shaved Parmesan", "group": null, "quantity": 2.0, "unit": "oz", "item": "shaved parmesan", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "None"}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 197.5, "protein_g": 7.2, "carbohydrates_g": 4.3, "fat_g": 17.4, "saturated_fat_g": 4.0, "unsaturated_fat_g": 1.6, "trans_fat_g": null, "cholesterol_mg": 9.6, "sodium_mg": 313.9, "fiber_g": 1.4, "sugar_g": 1.9, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://static01.nyt.com/images/2008/11/10/health/nutrition/10recipehelth.span.ready/10recipehelth.span.ready-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2008/11/10/health/nutrition/10recipehelth.span.ready/10recipehelth.span.ready-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 188}, "video_url": null, "comment_count": null, "published_at": "2008-11-10", "scraped_at": "2026-09-07T00:07:53Z", "scraper_version": "1.0.0"}
{"slug": "italian-red-wine-braised-duck-with-olive-gremolata", "nyt_id": 1014424, "url": "https://cooking.nytimes.com/recipes/1014424-italian-red-wine-braised-duck-with-olive-gremolata", "name": "Italian Red-Wine Braised Duck with Olive Gremolata", "author": "David Tanis", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "PT2H30M"}}, "ingredients": [{"position": 1, "raw": "4 Muscovy duck legs (about 4 pounds), untrimmed", "group": null, "quantity": 4.0, "unit": null, "item": "muscovy duck legs", "preparation": "untrimmed", "optional": false}, {"position": 2, "raw": "Salt and pepper", "group": null, "quantity": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon coriander seed, toasted and coarsely ground", "group": null, "quantity": 0.5, "unit": "tsp", "item": "coriander seed", "preparation": "toasted and coarsely ground", "optional": false}, {"position": 4, "raw": "½ teaspoon fennel seed, toasted and coarsely ground", "group": null, "quantity": 0.5, "unit": "tsp", "item": "fennel seed", "preparation": "toasted and coarsely ground", "optional": false}, {"position": 5, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups finely diced onion", "group": null, "quantity": 2.0, "unit": "cup", "item": "finely diced onion", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup finely diced carrot", "group": null, "quantity": 0.75, "unit": "cup", "item": "finely diced carrot", "preparation": null, "optional": false}, {"position": 8, "raw": "¾ cup finely diced celery", "group": null, "quantity": 0.75, "unit": "cup", "item": "finely diced celery", "preparation": null, "optional": false}, {"position": 9, "raw": "1 large thyme sprig", "group": null, "quantity": 1.0, "unit": null, "item": "large thyme sprig", "preparation": null, "optional": false}, {"position": 10, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 11, "raw": "1 4-inch strip of orange peel, pith removed", "group": null, "quantity": 5.0, "unit": null, "item": "inch strip of orange peel", "preparation": "pith removed", "optional": false}, {"position": 12, "raw": "4 garlic cloves, minced", "group": null, "quantity": 4.0, "unit": null, "item": "garlic cloves", "preparation": "minced", "optional": false}, {"position": 13, "raw": "2 tablespoons tomato paste", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 14, "raw": "1 cup chopped canned or fresh tomatoes", "group": null, "quantity": 1.0, "unit": "cup", "item": "chopped canned or fresh tomatoes", "preparation": null, "optional": false}, {"position": 15, "raw": "1 cup dry red wine", "group": null, "quantity": 1.0, "unit": "cup", "item": "dry red wine", "preparation": null, "optional": false}, {"position": 16, "raw": "3 cups chicken broth", "group": null, "quantity": 3.0, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 17, "raw": "Pinch cayenne or red pepper, optional", "group": null, "quantity": null, "unit": null, "item": "pinch cayenne or red pepper", "preparation": "optional", "optional": true}, {"position": 18, "raw": "Olive gremolata for garnish (recipe here)", "group": null, "quantity": null, "unit": null, "item": "olive gremolata for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Trim duck legs of extraneous fat with a sharp knife, leaving a thin layer on top. (It is best to do this straight from the fridge, while fat is still firm.) Save duck fat for rendering. If you don’t wish to render fat immediately, freeze for up to 2 months"}, {"position": 2, "text": "Season each leg generously with salt and pepper, then sprinkle with ground coriander and fennel. Massage seasoning into meat and leave at room temperature for 30 minutes, or wrap and refrigerate overnight."}, {"position": 3, "text": "Roast duck legs in a 400-degree oven for about 45 minutes, until nicely browned. Pour off fat accumulated in roasting pan and reserve for another purpose."}, {"position": 4, "text": "Meanwhile, make the sauce: Pour olive oil into a wide heavy-bottomed pot over medium-high heat. Add onions and let them cook for about 5 minutes, stirring occasionally, until softened and beginning to color. Add carrot, celery, thyme, bay leaf and orange peel. Season with salt and pepper and continue cooking until the carrot and celery are softened. Add garlic and tomato paste and stir to coat. Add chopped tomato and red wine and bring to a brisk simmer. Cook for 5 minutes, until slightly thickened. Add chicken broth and return to a simmer. Taste sauce for salt and adjust seasoning, adding a pinch of cayenne or red pepper flakes if desired. Finally, add duck legs, put on the lid, reduce heat to a gentle simmer and cook for about 45 minutes, until meat is tender when probed with a paring knife."}, {"position": 5, "text": "Transfer the duck legs to a low baking dish, all in one layer. Skim any fat from surface of sauce. Ladle sauce over duck legs and bake, uncovered, at 375 degrees for about 30 minutes, until sauce is bubbling and legs have browned a bit on top. (Duck may be prepared up to 3 days in advance, then reheated.) Sprinkle olive gremolata evenly over dish. Serve with wide ribbons of buttered egg pasta or polenta, if desired."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 2079.5, "protein_g": 59.2, "carbohydrates_g": 24.5, "fat_g": 187.7, "saturated_fat_g": 61.5, "unsaturated_fat_g": 24.3, "trans_fat_g": null, "cholesterol_mg": 350.1, "sodium_mg": 2034.3, "fiber_g": 4.2, "sugar_g": 9.9, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["dry-red-wine", "duck-leg"]}, "images": [{"url": "https://static01.nyt.com/images/2012/12/19/dining/19KITCH_SPAN/19KITCH_SPAN-superJumbo-v2.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2012/12/19/dining/19KITCH_SPAN/19KITCH_SPAN-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 102}, "video_url": null, "comment_count": null, "published_at": "2012-12-19", "scraped_at": "2026-09-07T02:17:08Z", "scraper_version": "1.0.0"}
{"slug": "italian-ricotta-cookies", "nyt_id": 1014420, "url": "https://cooking.nytimes.com/recipes/1014420-italian-ricotta-cookies", "name": "Italian Ricotta Cookies", "author": "Melissa Clark", "description": "Jessica Hulett’s tender, cakey ricotta cookies taste like the white part of the best black and white cookie you've ever had. The recipe comes from Ms. Hulett’s grandmother Dorie, who used to flavor the cookies with anise, if she used flavoring at all. Adding lemon zest gives the cookies a fragrant brightness. We approve. Melissa Clark", "servings": {"text": "72 servings", "min": 72, "max": 72, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "2 sticks (1 cup) plus 1 tablespoon unsalted butter, softened", "group": null, "quantity": 2.0, "unit": "stick", "item": "plus 1 tablespoon unsalted butter", "preparation": "softened", "optional": false}, {"position": 2, "raw": "425 grams sugar (about 2 cups)", "group": null, "quantity": 425.0, "unit": "g", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ¾ cups ricotta cheese (15 ounces), preferably fresh", "group": null, "quantity": 1.75, "unit": "cup", "item": "ricotta cheese", "preparation": "preferably fresh", "optional": false}, {"position": 4, "raw": "Finely grated zest of ½ lemon", "group": null, "quantity": null, "unit": null, "item": "finely grated zest of ½ lemon", "preparation": null, "optional": false}, {"position": 5, "raw": "4 teaspoons vanilla extract", "group": null, "quantity": 4.0, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 6, "raw": "2 large eggs", "group": null, "quantity": 2.0, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 7, "raw": "480 grams all-purpose flour (about 4 cups)", "group": null, "quantity": 480.0, "unit": "g", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 8, "raw": "10 grams baking soda (2 teaspoons)", "group": null, "quantity": 10.0, "unit": "g", "item": "baking soda", "preparation": null, "optional": false}, {"position": 9, "raw": "4 grams fine sea salt (about ¾ teaspoon)", "group": null, "quantity": 4.0, "unit": "g", "item": "fine sea salt", "preparation": null, "optional": false}, {"position": 10, "raw": "450 grams confectioners’ sugar (about 4 cups)", "group": null, "quantity": 450.0, "unit": "g", "item": "confectioners’ sugar", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons fresh lemon juice", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 12, "raw": "¼ cup to ½ cup milk, as needed", "group": null, "quantity": 0.25, "unit": "cup", "item": "to ½ cup milk", "preparation": "as needed", "optional": false}, {"position": 13, "raw": "Colored sprinkles or sanding sugar, optional", "group": null, "quantity": null, "unit": null, "item": "colored sprinkles or sanding sugar", "preparation": "optional", "optional": true}], "steps": [{"position": 1, "text": "Using an electric mixer, cream 2 sticks butter with sugar until fluffy, about 2 minutes. Add ricotta, lemon zest and 2 ½ teaspoons vanilla and beat well. Beat in the eggs one at a time. Scrape the sides of the bowl down with a rubber spatula, then beat in flour, baking soda and salt. Cover dough and chill for at least 2 hours and up to a week."}, {"position": 2, "text": "Heat oven to 350 degrees and line several cookie sheets with parchment paper or nonstick liners. Shape tablespoons of dough into balls. Place 2 inches apart on baking sheets and bake until pale golden on the bottom, about 15 minutes. Let cool on wire racks."}, {"position": 3, "text": "Melt remaining tablespoon butter. Whisk confectioners’ sugar to break up any large lumps, then whisk in melted butter, lemon juice, remaining 1 ½ teaspoons vanilla and enough milk to make a spreadable icing. Spread icing on cooled cookies, decorate with sprinkles or sanding sugar, if desired, then let set for at least 20 minutes before serving."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 110.51388888888889, "protein_g": 1.4, "carbohydrates_g": 18.5, "fat_g": 3.5, "saturated_fat_g": 2.1, "unsaturated_fat_g": 0.2, "trans_fat_g": null, "cholesterol_mg": 15.3, "sodium_mg": 68.8, "fiber_g": 0.2, "sugar_g": 12.6, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["christmas-cookie-dessert"], "meal": [], "occasion": [], "other": ["christmas", "easter", "lemon", "ricotta", "valentine-s-day", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2024/10/29/multimedia/italian-ricotta-cookies-mtfb/italian-ricotta-cookies-mtfb-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2024/10/29/multimedia/italian-ricotta-cookies-mtfb/italian-ricotta-cookies-mtfb-googleFourByThree.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2024/10/29/multimedia/italian-ricotta-cookies-mtfb/italian-ricotta-cookies-mtfb-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2024/10/29/multimedia/italian-ricotta-cookies-mtfb/italian-ricotta-cookies-mtfb-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 4192}, "video_url": null, "comment_count": null, "published_at": "2012-12-19", "scraped_at": "2026-09-07T02:16:59Z", "scraper_version": "1.0.0"}
{"slug": "italian-sausage-sandwiches", "nyt_id": 1013191, "url": "https://cooking.nytimes.com/recipes/1013191-italian-sausage-sandwiches", "name": "Italian Sausage Sandwiches", "author": "Melissa Clark", "description": "These tasty sausage and melted provolone sandwiches are a snap to put together and can be made with grilled, roasted or pan-fried sausages. A quick slaw of cabbage, carrots, mayonnaise and pickled peppers adds a moist and spicy crunch.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 2, "total_minutes": 15, "raw": {"cook": "PT2M", "total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "4 cups shredded cabbage", "group": null, "quantity": 4.0, "unit": "cup", "item": "shredded cabbage", "preparation": null, "optional": false}, {"position": 2, "raw": "2 medium carrots, peeled and grated", "group": null, "quantity": 2.0, "unit": null, "item": "medium carrots", "preparation": "peeled and grated", "optional": false}, {"position": 3, "raw": "3 tablespoons mayonnaise", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "mayonnaise", "preparation": null, "optional": false}, {"position": 4, "raw": "3 pickled peppers, finely chopped, plus more for garnish", "group": null, "quantity": 3.0, "unit": null, "item": "pickled peppers", "preparation": "finely chopped, plus more for garnish", "optional": false}, {"position": 5, "raw": "1 tablespoon pickled-pepper juice, or more to taste", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "pickled-pepper juice", "preparation": "or more to taste", "optional": false}, {"position": 6, "raw": "¼ teaspoon kosher salt", "group": null, "quantity": 0.25, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 7, "raw": "⅛ teaspoon black pepper", "group": null, "quantity": 0.125, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "4 hero or ciabatta rolls, each about 8 to 10 inches long, split", "group": null, "quantity": 4.0, "unit": null, "item": "hero or ciabatta rolls", "preparation": "each about 8 to 10 inches long, split", "optional": false}, {"position": 9, "raw": "½ pound sliced provolone", "group": null, "quantity": 0.5, "unit": "lb", "item": "sliced provolone", "preparation": null, "optional": false}, {"position": 10, "raw": "4 cooked Italian sausages, at room temperature", "group": null, "quantity": 4.0, "unit": null, "item": "cooked italian sausages", "preparation": "at room temperature", "optional": false}], "steps": [{"position": 1, "text": "In large bowl, toss together the cabbage, carrots, mayonnaise, the 3 chopped pickled peppers, pepper juice, salt and pepper. Let the mixture stand for 10 minutes."}, {"position": 2, "text": "Meanwhile, heat the broiler. Arrange the rolls, split side up, on a baking sheet. Line the inside of each roll with provolone. Arrange the sausages on the baking sheet next to the rolls. Put the sheet under the broiler. Cook until the cheese is bubbling and the sausages are warm, 1 to 2 minutes (make sure the rolls do not burn)."}, {"position": 3, "text": "Place a sausage inside each roll. Top generously with coleslaw and sprinkle with additional pickled peppers. Serve any additional coleslaw on the side."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 978.0, "protein_g": 41.6, "carbohydrates_g": 72.3, "fat_g": 51.2, "saturated_fat_g": 20.8, "unsaturated_fat_g": 10.5, "trans_fat_g": 0.1, "cholesterol_mg": 121.3, "sodium_mg": 1681.4, "fiber_g": 9.1, "sugar_g": 12.1, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["cabbage", "italian-sausage", "quick", "summer", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2020/08/02/dining/17COOKING-SAUSAGESANDWICH1/17COOKING-SAUSAGESANDWICH1-videoSixteenByNineJumbo1600.jpg", "alt": "Italian sausage sandwiches.", "primary": true}, {"url": "https://static01.nyt.com/images/2020/08/02/dining/17COOKING-SAUSAGESANDWICH1/17COOKING-SAUSAGESANDWICH1-superJumbo.jpg", "alt": "Italian sausage sandwiches.", "primary": false}, {"url": "https://static01.nyt.com/images/2020/08/02/dining/17COOKING-SAUSAGESANDWICH1/17COOKING-SAUSAGESANDWICH1-facebookJumbo.jpg", "alt": "Italian sausage sandwiches.", "primary": false}], "rating": {"average": 4.0, "count": 625}, "video_url": null, "comment_count": null, "published_at": "2010-07-07", "scraped_at": "2026-09-07T01:44:54Z", "scraper_version": "1.0.0"}
{"slug": "italianate-sunday-salad-dressing", "nyt_id": 1013114, "url": "https://cooking.nytimes.com/recipes/1013114-italianate-sunday-salad-dressing", "name": "Italianate Sunday-Salad Dressing", "author": "Sam Sifton", "description": "All vinaigrettes are based on a simple formula that uses roughly three parts oil to one part acid, a rule that achieves balance between the vivid sparkle of vinegar or lemon juice and the slick heaviness of olive oil. You can adjust for taste from there, adding a splash of oil if the dressing tastes too acidic, or a splash of acid if it’s overwhelmed.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons good-quality balsamic vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "good-quality balsamic vinegar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "Scant handful basil leaves, chopped", "group": null, "quantity": null, "unit": null, "item": "scant handful basil leaves", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "⅓ cup extra-virgin olive oil", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup grated Parmesan", "group": null, "quantity": 0.25, "unit": "cup", "item": "grated parmesan", "preparation": null, "optional": false}, {"position": 7, "raw": "Kosher salt", "group": null, "quantity": null, "unit": null, "item": "kosher salt", "preparation": null, "optional
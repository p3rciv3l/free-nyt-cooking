{"slug": "italian-bread-salad-panzanella", "nyt_id": 1016452, "url": "https://cooking.nytimes.com/recipes/1016452-italian-bread-salad-panzanella", "name": "Italian Bread Salad (Panzanella)", "author": "Martha Rose Shulman", "description": "Like so many Mediterranean bread salads, stale bread is combined here with red onion and tomato and dressed with vinegar and olive oil. It’s like a bread salad version of gazpacho.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "PT1H30M"}}, "ingredients": [{"position": 1, "raw": "1 pound stale country bread or baguette, cut in thick slices", "group": null, "quantity": 1.0, "unit": "lb", "item": "stale country bread or baguette", "preparation": "cut in thick slices", "optional": false}, {"position": 2, "raw": "1 small red onion, sliced very thin", "group": null, "quantity": 1.0, "unit": null, "item": "small red onion", "preparation": "sliced very thin", "optional": false}, {"position": 3, "raw": "Cold water", "group": null, "quantity": null, "unit": null, "item": "cold water", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pound ripe tomatoes, chopped", "group": null, "quantity": 1.0, "unit": "lb", "item": "ripe tomatoes", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "2 tablespoons chopped fresh basil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped fresh basil", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons chopped flat-leaf parsley", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped flat-leaf parsley", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons red wine vinegar or sherry vinegar (more to taste)", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "red wine vinegar or sherry vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 large garlic clove, minced or crushed in a mortar and pestle", "group": null, "quantity": 1.0, "unit": null, "item": "large garlic clove", "preparation": "minced or crushed in a mortar and pestle", "optional": false}, {"position": 9, "raw": "Salt and freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup extra virgin olive oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "extra virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "If your bread is very hard, douse it with water first and saw it into a few pieces that will fit into a medium bowl. Cover with the onions. Pour on cold water to cover and let sit for 20 minutes. Lift the onions off the bread and rinse in a strainer. Drain the bread, squeeze out excess water and crumble the bread into a salad bowl."}, {"position": 2, "text": "Add the tomatoes, basil, and parsley to the bowl. Mix together the vinegar, garlic, salt, pepper, and olive oil, and toss with the bread mixture. Cover and refrigerate for 1 hour or longer before serving."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 309.1666666666667, "protein_g": 9.1, "carbohydrates_g": 40.7, "fat_g": 12.6, "saturated_fat_g": 1.8, "unsaturated_fat_g": 2.2, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 423.6, "fiber_g": 4.3, "sugar_g": 6.8, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://static01.nyt.com/images/2008/09/12/health/nutrition/12breadsalad.jpg/12breadsalad.jpg-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2008/09/12/health/nutrition/12breadsalad.jpg/12breadsalad.jpg-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 283}, "video_url": null, "comment_count": null, "published_at": "2008-09-12", "scraped_at": "2026-09-07T00:07:19Z", "scraper_version": "1.0.0"}
{"slug": "italian-broccoli-salad", "nyt_id": 1023076, "url": "https://cooking.nytimes.com/recipes/1023076-italian-broccoli-salad", "name": "Italian Broccoli Salad", "author": "Ali Slagle", "description": "This adaptable make-ahead salad is a great instant lunch or side dish. It starts with raw broccoli florets and stems, thinly sliced into irregular shapes to create many textures. As the broccoli sits with salt and vinegar, it softens and becomes slaw. Its mellow flavor is contrasted by the loud ingredients typically found in an Italian sub or chopped salad, like shallots, pickled peppers, olives and provolone. Feel free to add more protein in the form of cured meats, chickpeas, lentils or mozzarella; vegetables like sweet tomatoes or iceberg lettuce; or basil.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "PT20M"}}, "ingredients": [{"position": 1, "raw": "1 small shallot, thinly sliced", "group": null, "quantity": 1.0, "unit": null, "item": "small shallot", "preparation": "thinly sliced", "optional": false}, {"position": 2, "raw": "1 ½ pounds broccoli (about 2 medium heads)", "group": null, "quantity": 1.5, "unit": "lb", "item": "broccoli", "preparation": null, "optional": false}, {"position": 3, "raw": "Kosher salt (Diamond Crystal) and black pepper", "group": null, "quantity": null, "unit": null, "item": "kosher salt and black pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup roasted, salted almonds, coarsely chopped", "group": null, "quantity": 0.5, "unit": "cup", "item": "roasted", "preparation": "salted almonds, coarsely chopped", "optional": false}, {"position": 5, "raw": "¼ cup drained, sliced pickled peppers, such as peperoncini", "group": null, "quantity": 0.25, "unit": "cup", "item": "drained", "preparation": "sliced pickled peppers, such as peperoncini", "optional": false}, {"position": 6, "raw": "¼ cup pitted, torn olives, such as kalamata or Castelvetrano", "group": null, "quantity": 0.25, "unit": "cup", "item": "pitted", "preparation": "torn olives, such as kalamata or Castelvetrano", "optional": false}, {"position": 7, "raw": "⅓ cup extra-virgin olive oil, plus more as needed", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "extra-virgin olive oil", "preparation": "plus more as needed", "optional": false}, {"position": 8, "raw": "⅓ cup red wine vinegar, plus more as needed", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "red wine vinegar", "preparation": "plus more as needed", "optional": false}, {"position": 9, "raw": "3 slices provolone (about 3 ounces), torn or cut into bite-size pieces (or use 1 ½ ounces aged provolone)", "group": null, "quantity": 3.0, "unit": "slice", "item": "provolone", "preparation": "torn or cut into bite-size pieces (or use 1 ½ ounces aged provolone)", "optional": false}], "steps": [{"position": 1, "text": "Rinse the sliced shallot under cold water and transfer to a large bowl."}, {"position": 2, "text": "Cut the stalks away from the broccoli heads. Using a knife or vegetable peeler, remove the fibrous outer layer of the stalks so its light green insides emerge; compost or discard the outer layer. Thinly slice the stalks crosswise, then thinly slice the heads into bite-size pieces. (A mix of shapes and sizes adds texture to the salad, so chop up the broccoli a few ways; there’s no one right way to go about it.) Transfer to the large bowl as you go, then transfer any loose bits from the cutting board to the bowl."}, {"position": 3, "text": "Season the broccoli generously with salt and pepper, then add the almonds, pickled peppers, olives, oil, vinegar and provolone. Toss vigorously with a spoon until everything is combined and the broccoli is shiny with oil."}, {"position": 4, "text": "Taste and adjust seasonings with salt, pepper, oil and vinegar as needed. Let sit at least 10 minutes before serving. The salad improves with age as its flavors meld, and it can be refrigerated for up to 4 days. Before serving, bring to room temperature and adjust salt, pepper, oil and vinegar to taste, as flavors change in the fridge."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 310.0, "protein_g": 12.2, "carbohydrates_g": 18.6, "fat_g": 23.1, "saturated_fat_g": 4.9, "unsaturated_fat_g": 3.1, "trans_fat_g": null, "cholesterol_mg": 9.7, "sodium_mg": 634.3, "fiber_g": 7.3, "sugar_g": 4.6, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dinner-lunch-main-course-salad-side-dish-vegetables"], "meal": [], "occasion": [], "other": ["almond", "broccoli", "easy", "make-ahead", "olive", "provolone"]}, "images": [{"url": "https://static01.nyt.com/images/2022/03/28/dining/as-broccoli-salad/as-broccoli-salad-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2022/03/28/dining/as-broccoli-salad/as-broccoli-salad-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2022/03/28/dining/as-broccoli-salad/as-broccoli-salad-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2022/03/28/dining/as-broccoli-salad/as-broccoli-salad-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 2019}, "video_url": "https://vp.nyt.com/video/2024/09/11/123418_1_Italian-Broccoli-Salad-Video_wg_480p.mp4", "comment_count": null, "published_at": "2022-03-29", "scraped_at": "2026-09-07T00:46:27Z", "scraper_version": "1.0.0"}

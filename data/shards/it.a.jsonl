{"slug": "italian-bread-salad-panzanella", "nyt_id": 1016452, "url": "https://cooking.nytimes.com/recipes/1016452-italian-bread-salad-panzanella", "name": "Italian Bread Salad (Panzanella)", "author": "Martha Rose Shulman", "description": "Like so many Mediterranean bread salads, stale bread is combined here with red onion and tomato and dressed with vinegar and olive oil. It’s like a bread salad version of gazpacho.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "PT1H30M"}}, "ingredients": [{"position": 1, "raw": "1 pound stale country bread or baguette, cut in thick slices", "group": null, "quantity": 1.0, "unit": "lb", "item": "stale country bread or baguette", "preparation": "cut in thick slices", "optional": false}, {"position": 2, "raw": "1 small red onion, sliced very thin", "group": null, "quantity": 1.0, "unit": null, "item": "small red onion", "preparation": "sliced very thin", "optional": false}, {"position": 3, "raw": "Cold water", "group": null, "quantity": null, "unit": null, "item": "cold water", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pound ripe tomatoes, chopped", "group": null, "quantity": 1.0, "unit": "lb", "item": "ripe tomatoes", "preparation": "chopped", "optional": false}, {"position": 5, "raw": "2 tablespoons chopped fresh basil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped fresh basil", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons chopped flat-leaf parsley", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped flat-leaf parsley", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons red wine vinegar or sherry vinegar (more to taste)", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "red wine vinegar or sherry vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 large 
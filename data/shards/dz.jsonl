x": null, "unit": "cup", "item": "rosewater", "preparation": null, "optional": false}, {"position": 10, "raw": "3 cups (12 ounces) slivered almonds", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "(12 ounces) slivered almonds", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup confectioners' sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "confectioners' sugar", "preparation": null, "optional": false}, {"position": 12, "raw": "1 large egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg", "preparation": null, "optional": false}, {"position": 13, "raw": "1 egg yolk", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg yolk", "preparation": null, "optional": false}, {"position": 14, "raw": "½ teaspoon finely grated lemon zest", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "finely grated lemon zest", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 325 degrees. Grease 2 baking sheets."}, {"position": 2, "text": "To make the pastry: Place flour and salt in electric mixer. Then, with mixer running, pour in melted butter, egg yolk, rosewater and vanilla extract. Add 1 to 3 tablespoons cold water, as needed, until dough just comes together. Continue to mix dough until it is smooth, about 1 minute. Cover bowl with a damp cloth or plastic wrap until needed."}, {"position": 3, "text": "For the syrup: In a small saucepan over medium-high heat, bring honey and rosewater to a boil, stirring occasionally. Remove from heat and let cool."}, {"position": 4, "text": "For the filling: In a food processor, pulse together almonds and confectioners' sugar until powdery. Add remaining ingredients and pulse to combine. Transfer to a bowl."}, {"position": 5, "text": "On a lightly floured surface, roll out pastry dough as thin as possible ( between 1/16 and ⅛ i
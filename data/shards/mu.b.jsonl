{"slug": "multigrain-seed-bread", "nyt_id": 10804, "url": "https://cooking.nytimes.com/recipes/10804-multigrain-seed-bread", "name": "Multigrain Seed Bread", "author": "Leslie Land", "description": "Leslie Land", "servings": {"text": "Two loaves", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "About 2 hours"}}, "ingredients": [{"position": 1, "raw": "2 ½ cups water at room temperature", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "water at room temperature", "preparation": null, "optional": false}, {"position": 2, "raw": "1 6/10-ounce cake fresh yeast or 1 tablespoon granular yeast", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "6/10-ounce cake fresh yeast or 1 tablespoon granular yeast", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup sourdough (see recipe)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sourdough (see recipe)", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "⅓ cup mild honey", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "mild honey", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup sunflower seeds", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "sunflower seeds", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup, plus 1 tablespoon, sesame seeds", "group": null, "quantity": 0.25, "quantity_max": null, "unit": null, "item": "cup", "preparation": "plus 1 tablespoon, sesame seeds", "optional": false}, {"position": 8, "raw": "3 tablespoons flax seed", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "flax seed", "preparation": null, "optional": false}, {"position": 9, "raw": "4 ⅓ cups whole-wheat bread flour, plus flour to sprinkle surface", "group": null, "quantity": 4.333333333333333, "quantity_max": null, "unit": "cup", "item": "whole-wheat bread flour", "preparation": "plus flour to sprinkle surface", "optional": false}, {"position": 10, "raw": "Corn oil for bread pans", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "corn oil for bread pans", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the water in a large mixing bowl, crumble in the yeast (if using dry yeast, let dissolve), then stir in the sourdough, salt, honey, seeds and flour."}, {"position": 2, "text": "Stir the dough until it is elastic and cohesive but still very wet and sticky, about 15 minutes by hand or 10 minutes with the paddle attachment of a heavy-duty electric mixer set at medium speed. Sprinkle the surface of the dough with flour, cover the bowl with plastic wrap and allow to rest in a warm place for one hour."}, {"position": 3, "text": "Oil a pair of metal loaf pans, 2 ½ by 4 by 8 inches. Stir down the dough and divide it between them, cover with plastic wrap and let rise only until one-and-a-half times the original height, about 45 minutes. The dough will not fill the pans completely."}, {"position": 4, "text": "Heat the oven to 450 degrees and make the loaves for 20 minutes. Reduce the heat to 375 and bake 20 to 30 minutes more, or until the loaves sound hollow when tapped on the bottom. Remove the loaves from the pans and cool on their sides on wire racks."}], "nutrition": {"calories": 373.8, "protein_g": 2.8, "carbohydrates_g": 83.7, "fat_g": 5.0, "saturated_fat_g": 0.5, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 334.4, "fiber_g": 2.0, "sugar_g": 80.0, "unsaturated_fat_g": 4.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "vegetarian"], "course": ["si
{"slug": "mushroom-barley-soup", "nyt_id": 11499, "url": "https://cooking.nytimes.com/recipes/11499-mushroom-barley-soup", "name": "Mushroom-Barley Soup", "author": "Jason Epstein", "description": "", "servings": {"text": "12 to 16 servings", "min": 12, "max": 16, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 130, "raw": {"total": "2 hours 10 minutes"}}, "ingredients": [{"position": 1, "raw": "½ cup dried porcini mushrooms", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dried porcini mushrooms", "preparation": null, "optional": false}, {"position": 2, "raw": "8 ounces butter or margarine", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "butter or margarine", "preparation": null, "optional": false}, {"position": 3, "raw": "1 very large onion or 2 medium onions, peeled and chopped (about 1 pound)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "very large onion or 2 medium onions", "preparation": "peeled and chopped (about 1 pound)", "optional": false}, {"position": 4, "raw": "6 cloves garlic, peeled and finely chopped", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and finely chopped", "optional": false}, {"position": 5, "raw": "1 ½ pounds fresh mushrooms, trimmed and thinly sliced", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "fresh mushrooms", "preparation": "trimmed and thinly sliced", "optional": false}, {"position": 6, "raw": "4 stalks of celery with leaves,diced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "stalk", "item": "of celery with leaves", "preparation": "diced", "optional": false}, {"position": 7, "raw": "3 big carrots, peeled and coarsely chopped (about 1 ½ pounds)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "big carrots", "preparation": "peeled and coarsely chopped (about 1 ½ pounds)", "optional": false}, {"position": 8, "raw": "½ cup chopped parsley", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 10, "raw": "2 quarts beef broth", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "quart", "item": "beef broth", "preparation": null, "optional": false}, {"position": 11, "raw": "2 ½ cups barley, rinsed", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "barley", "preparation": "rinsed", "optional": false}, {"position": 12, "raw": "2 tablespoons kosher salt or more to taste", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "kosher salt or more to taste", "preparation": null, "optional": false}, {"position": 13, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak the dried mushrooms in 1 quart hot water for 1 hour. Strain through a filter or cheesecloth. Reserve the water. Coarsely chop the dried mushrooms and set aside."}, {"position": 2, "text": "Melt the butter in a large stockpot over medium-high heat and sauté onions and garlic until soft, about 10 minutes. Add the fresh mushrooms, celery, carrots and 4 tablespoons parsley. Cook until the carrots are tender, about 10 minutes. Add the flour and stir until blended. Stir in the mushroom soaking liquid until blended, then stir in the beef broth and 6 cups water. Stir in the barley, soaked mushrooms, 2 tablespoons salt and pepper to taste."}, {"position": 3, "text": "Heat the soup to boiling, stirring frequently, then lower the heat, cover the pot and simmer for about 45 minutes or until the barley is tender."}, {"position": 4, "text": "Add the remaining parsley, mix thoroughly and add more water if the soup is too thick. Adjust seasonings if necessary."}], "nutrition": {"calories": 320.6, "protein_g": 10.2, "carbohydrates_g": 41.5, "fat_g": 14.5, "saturated_fat_g": 8.5, "trans_fat_g": 0.0, "cholesterol_mg": 34.8, "sodium_mg": 790.0, "fiber_g": 9.3, "sugar_g": 6.0, "unsaturated_fat_g": 5.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["barley", "great leftovers", "mushroom", "saute", "soup"]}, "images": [], "rating": {"average": 4.0, "count": 69}, "video_url": null, "comment_count": null, "published_at": "2003-01-12", "scraped_at": "2026-09-06T23:47:21.919754+00:00", "scraper_version": "1.0.0"}

", "item": "olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Boil the potatoes in their skins until soft. Drain, cool, peel and mash the potatoes with a fork. Add the butter, milk, salt, pepper, eggs and 6 tablespoons of the grated cheese. Beat until well blended."}, {"position": 2, "text": "Preheat the oven to 400 degrees. Wash and drain the spinach and press dry. Cook over low heat in a covered, nonstick skillet for 1 to 3 minutes. Season with salt and pepper to taste. Add the nutmeg and mix well."}, {"position": 3, "text": "Use 1 tablespoon of the olive oil to grease a 9-by-12-inch baking dish. Use a spatula to press half the mashed potatoes into the bottom of the dish, layer in the spinach, top with the remaining potatoes, sprinkle with the remaining cheese and oil and bake for 50 minutes."}], "nutrition": {"calories": 396.1, "protein_g": 18.6, "carbohydrates_g": 39.9, "fat_g": 19.2, "saturated_fat_g": 8.9, "trans_fat_g": 0.0, "cholesterol_mg": 87.5, "sodium_mg": 871.5, "fiber_g": 6.8, "sugar_g": 3.2, "unsaturated_fat_g": 8.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["jewish", "middle eastern"], "diet": ["vegetarian"], "course": ["main course", "side dish"], "meal": ["dinner"], "occasion": [], "other": ["bake", "boil", "casseroles", "egg", "great leftovers", "parmesan", "potato", "spinach", "weeknight"]}, "images": [], "rating": {"average": 5.0, "count": 13}, "video_url": null, "comment_count": null, "published_at": "1997-03-30", "scraped_at": "2026-09-07T08:55:51.076423+00:00", "scraper_version": "1.0.0"}
{"slug": "sformata-di-ricotta", "nyt_id": 6969, "url": "https://cooking.nytimes.com/recipes/6969-sformata-di-ricotta", "name": "Sformata di Ricotta", "author": "Julia Reed", "description": "Julia Reed", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons butter, softened", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": "softened", "optional": false}, {"position": 2, "raw": "2 ounces freshly grated Parmigiano-Reggiano cheese", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "oz", "item": "freshly grated parmigiano-reggiano cheese", "preparation": null, "optional": false}, {"position": 3, "raw": "10 ounces cherry tomatoes", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "cherry tomatoes", "preparation": null, "optional": false}, {"position": 4, "raw": "1 large garlic clove, peeled and halved lengthwise", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large garlic clove", "preparation": "peeled and halved lengthwise", "optional": false}, {"position": 5, "raw": "1 tablespoon extra-virgin olive oil, plus extra for drizzling", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": "plus extra for drizzling", "optional": false}, {"position": 6, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "6 eggs", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 8, "raw": "2 ¼ cups fresh ricotta", "group": null, "quantity": 2.25, "qu
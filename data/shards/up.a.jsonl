{"slug": "updated-whiskey-ginger-highball", "nyt_id": 1016337, "url": "https://cooking.nytimes.com/recipes/1016337-updated-whiskey-ginger-highball", "name": "Updated Whiskey-Ginger  Highball", "author": "Rosie Schaap", "description": "A dressed up version of an easy favorite, galvanized by fresh ginger and orange.", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "2 slices raw, peeled ginger (about the size of a quarter)", "group": null, "quantity": 2.0, "unit": "slice", "item": "raw", "preparation": "peeled ginger (about the size of a quarter)", "optional": false}, {"position": 2, "raw": "1 bar spoon Morris Kitchen ginger syrup", "group": null, "quantity": 1.0, "unit": null, "item": "bar spoon morris kitchen ginger syrup", "preparation": null, "optional": false}, {"position": 3, "raw": "Ginger beer (I like Gosling’s)", "group": null, "quantity": null, "unit": null, "item": "ginger beer", "preparation": null, "optional": false}, {"position": 4, "raw": "3 ounces rye", "group": null, "quantity": 3.0, "unit": "oz", "item": "rye", "preparation": null, "optional": false}, {"position": 5, "raw": "Orange peel twist to garnish", "group": null, "quantity": null, "unit": null, "item": "orange peel twist to garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Muddle one slice of ginger with syrup and a bit of ginger beer in the bottom of a highball glass. Fill glass with ice cubes."}, {"position": 2, "text": "Add rye and stir with a bar spoon. Add ginger beer to fill."}, {"position": 3, "text": "Run the other slice of ginger around the rim of the glass, then discard. Twist orange peel over drink to release oils, then drop into glass."}], "nutrition": null, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [{"url": "https://static01.nyt.com/images/2014/05/18/magazine/18drink2/18drink2-superJumbo.jpg", "alt": "Updated Whiskey-Ginger Highball", "primary": true}, {"url": "https://static01.nyt.com/images/2014/05/18/magazine/18drink2/18drink2-facebookJumbo-v2.jpg", "alt": "Updated Whiskey-Ginger Highball", "primary": false}], "rating": {"average": 4.0, "count": 24}, "video_url": null, "comment_count": null, "published_at": "2014-05-13", "scraped_at": "2026-09-07T03:09:00Z", "scraper_version": "1.0.0"}
{"slug": "upside-down-blood-orange-cake", "nyt_id": 1014488, "url": "https://cooking.nytimes.com/recipes/1014488-upside-down-blood-orange-cake", "name": "Upside-Down Blood Orange Cake", "author": "Melissa Clark", "description": "In the cold days of a long winter, our tables are brightened by citrus season, and nothing has more flair than a blood orange. Here is a one-pan cake of cornmeal and flour that lets the orange’s ruby flesh shine. It takes just a little time to assemble and less than an hour to bake. The result is a festive fruit dessert guaranteed to lift even the worst winter doldrums.", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "PT1H30M"}}, "ingredients": [{"position": 1, "raw": "270 grams unsalted butter (2 sticks plus 3 tablespoons), at room temperature", "group": null, "quantity": 270.0, "unit": "g", "item": "unsalted butter", "preparation": "at room temperature", "optional": false}, {"position": 2, "raw": "130 grams light brown sugar (about ⅔ cup)", "group": null, "quantity": 130.0, "unit": "g", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 teaspoons fresh lemon juice", "group": null, "quantity": 2.0, "unit": "tsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "2 medium-sized blood oranges", "group": null, "quantity": 2.0, "unit": null, "item": "medium-sized blood oranges", "preparation": null, "optional": false}, {"position": 5, "raw": "122 grams fine cornmeal (about 1 cup)", "group": null, "quantity": 122.0, "unit": "g", "item": "fine cornmeal", "preparation": null, "optional": false}, {"position": 6, "raw": "65 grams all-purpose flour (about ½ cup)", "group": null, "quantity": 65.0, "unit": "g", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 7, "raw": "8 grams baking powder (about 1 ½ teaspoons)", "group": null, "quantity": 8.0, "unit": "g", "item": "baking powder", "preparation": null, "optional": false}, {"position": 8, "raw": "2 grams fine sea salt (about ½ teaspoon)", "group": null, "quantity": 2.0, "unit": "g", "item": "fine sea salt", "preparation": null, "optional": false}, {"position": 9, "raw": "200 grams granulated sugar (about 1 cup)", "group": null, "quantity": 200.0, "unit": "g", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 10, "raw": "4 large eggs, at room temperature", "group": null, "quantity": 4.0, "unit": null, "item": "large eggs", "preparation": "at room temperature", "optional": false}, {"position": 11, "raw": "⅓ cup sour cream", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 12, "raw": "2 teaspoons vanilla extract", "group": null, "quantity": 2.0, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 350 degrees. Grease a 9-inch round cake pan."}, {"position": 2, "text": "In a small saucepan over medium heat, melt 3 tablespoons (45 grams) butter. Add the brown sugar and lemon juice; stir until sugar melts, about 3 minutes. Scrape mixture into bottom of prepared pan."}, {"position": 3, "text": "Grate ½ teaspoon zest from one of the oranges, then slice off the tops and bottoms of both oranges. Place oranges on a clean, flat surface, and slice away the rind and pith, top to bottom, following the curve of the fruit. Slice each orange crosswise into ¼-inch-thick wheels; discard any seeds. Arrange orange wheels on top of brown sugar mixture in a single, tight layer."}, {"position": 4, "text": "In a large bowl, whisk together orange zest, cornmeal, flour, baking powder and salt. In a separate bowl, cream together remaining 2 sticks (225 grams) butter with granulated sugar. Beat in eggs, one a time, then beat in sour cream and vanilla. Fold in the dry mixture by hand."}, {"position": 5, "text": "Scrape batter into pan over oranges. Transfer to oven and bake until cake is golden brown and a toothpick inserted in the center emerges clean, 40 to 50 minutes. Cool cake in pan 10 minutes, then run a knife along pan’s edges to loosen it; invert onto a platter and cool completely before serving."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 558.25, "protein_g": 6.2, "carbohydrates_g": 63.3, "fat_g": 31.9, "saturated_fat_g": 18.8, "unsaturated_fat_g": 1.8, "trans_fat_g": 0.1, "cholesterol_mg": 170.8, "sodium_mg": 261.0, "fiber_g": 1.8, "sugar_g": 40.7, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert-sauces-and-gravies"], "meal": [], "occasion": [], "other": ["blood-orange", "butter", "cornmeal", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2013/01/16/dining/16APPE2/16APPE2-superJumbo-v3.jpg", "alt": "Upside-down blood orange cake.", "primary": true}, {"url": "https://static01.nyt.com/images/2013/01/16/dining/16APPE2/16APPE2-facebookJumbo.jpg", "alt": "Upside-down blood orange cake.", "primary": false}], "rating": {"average": 5.0, "count": 1510}, "video_url": null, "comment_count": null, "published_at": "2013-01-16", "scraped_at": "2026-09-07T02:18:46Z", "scraper_version": "1.0.0"}
{"slug": "upside-down-caramel-apple-muffins", "nyt_id": 1014091, "url": "https://cooking.nytimes.com/recipes/1014091-upside-down-caramel-apple-muffins", "name": "Upside-Down Caramel-Apple Muffins", "author": "Melissa Clark", "description": "I’ve never been much of a muffin maker. If I’m going to bake, I’d prefer to make a whole cake. But there is one kind of muffin that I heartily embrace — an upside-down fruit muffin. Its small, individual size encourages the fruit to condense and caramelize as it bakes. Then, when you unmold the muffin, the fruit transforms into a glistening crown of an irresistible sticky topping.", "servings": {"text": "12 muffins", "min": 12, "max": 12, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 55, "raw": {"total": "PT55M"}}, "ingredients": [{"position": 1, "raw": "3 apples about 1 ½ pounds, peeled, cored and sliced ¼-inch thick", "group": null, "quantity": 3.0, "unit": null, "item": "apples about 1 ½ pounds", "preparation": "peeled, cored and sliced ¼-inch thick", "optional": false}, {"position": 2, "raw": "½ cup dark brown sugar", "group": null, "quantity": 0.5, "unit": "cup", "item": "dark brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "8 tablespoons (1 stick) unsalted butter", "group": null, "quantity": 8.0, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 4, "raw": "Pinch kosher salt", "group": null, "quantity": null, "unit": null, "item": "pinch kosher salt", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup chopped walnuts, toasted optional", "group": null, "quantity": 0.5, "unit": "cup", "item": "chopped walnuts", "preparation": "toasted optional", "optional": true}, {"position": 6, "raw": "2 cups all-purpose flour", "group": null, "quantity": 2.0, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup dark brown sugar", "group": null, "quantity": 0.75, "unit": "cup", "item": "dark brown sugar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon baking powder", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon ground cinnamon", "group": null, "quantity": 0.5, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ teaspoon kosher salt", "group": null, "quantity": 0.25, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 11, "raw": "8 tablespoons (1 stick) unsalted butter, melted", "group": null, "quantity": 8.0, "unit": "tbsp", "item": "unsalted butter", "preparation": "melted", "optional": false}, {"position": 12, "raw": "2 large eggs, lightly beaten", "group": null, "quantity": 2.0, "unit": null, "item": "large eggs", "preparation": "lightly beaten", "optional": false}, {"position": 13, "raw": "¾ cup sour cream", "group": null, "quantity": 0.75, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 14, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oven to 375 degrees. Generously grease a 12-cup muffin tin."}, {"position": 2, "text": "In a large skillet over medium-high heat, stir together the apples, ½ cup brown sugar, 8 tablespoons butter and pinch salt. Cook, stirring occasionally, until the apples are tender, about 15 minutes. Distribute the apple slices among the muffin cups. Add walnuts, if using, on top of the apple slices."}, {"position": 3, "text": "To make the muffins, in a large bowl, whisk together flour, ¾ cup brown sugar, baking powder, cinnamon and ¼ teaspoon salt."}, {"position": 4, "text": "In a separate bowl, whisk together 8 tablespoons butter, eggs, sour cream and vanilla. Pour the wet ingredients into the dry and fold together until smooth. Distribute the batter on top of the apples. Bake until the muffins are slightly puffed, about 20 to 22 minutes."}, {"position": 5, "text": "Allow the muffins to cool partly in the pan; turn onto a platter and serve warm or at room temperature."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 366.75, "protein_g": 4.6, "carbohydrates_g": 38.8, "fat_g": 22.4, "saturated_fat_g": 11.6, "unsaturated_fat_g": 3.3, "trans_fat_g": 0.1, "cholesterol_mg": 80.2, "sodium_mg": 163.4, "fiber_g": 2.0, "sugar_g": 20.1, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert-muffin"], "meal": [], "occasion": [], "other": ["all-purpose-flour", "apple", "fall", "great-leftovers", "walnut"]}, "images": [{"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-googleFourByThree.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 821}, "video_url": null, "comment_count": null, "published_at": "2010-10-06", "scraped_at": "2026-09-07T02:08:48Z", "scraper_version": "1.0.0"}
{"slug": "upside-down-martini", "nyt_id": 1012730, "url": "https://cooking.nytimes.com/recipes/1012730-upside-down-martini", "name": "Upside-Down Martini", "author": "Jonathan Miles", "description": "This is a martini that’s about as wet as it gets, and it happened to be Julia Child’s favorite cocktail. It’s one part gin to five parts vermouth. “It’s a great, crisp summer drink,” said Ben Ward, the head bartender at Libation. It’s also much closer in spirit to the way dry vermouth is consumed in Europe — as a solo aperitif, rather than a meek cocktail modifier. Jonathan Miles", "servings": {"text": "1 servings", "min": 1, "max": 1, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": null, "raw": {}}, "ingredients": [{"position": 1, "raw": "¾ ounce gin", "group": null, "quantity": 0.75, "unit": "oz", "item": "gin", "preparation": null, "optional": false}, {"position": 2, "raw": "3 ¾ ounces Noilly Prat vermouth", "group": null, "quantity": 3.75, "unit": "oz", "item": "noilly prat vermouth", "preparation": null, "optional": false}, {"position": 3, "raw": "Lemon twist, for garnish", "group": null, "quantity": null, "unit": null, "item": "lemon twist", "preparation": "for garnish", "optional": false}], "steps": [{"position": 1, "text": "None"}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 145.0, "protein_g": 0.1, "carbohydrates_g": 3.5, "fat_g": null, "saturated_fat_g": null, "unsaturated_fat_g": null, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 6.0, "fiber_g": 0.4, "sugar_g": 1.0, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["cocktails"], "meal": [], "occasion": [], "other": ["gin", "vermouth"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/30/dining/1012730/1012730-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/05/30/dining/1012730/1012730-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {
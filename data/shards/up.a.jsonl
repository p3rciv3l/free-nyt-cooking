{"slug": "upside-down-caramel-apple-muffins", "nyt_id": 1014091, "url": "https://cooking.nytimes.com/recipes/1014091-upside-down-caramel-apple-muffins", "name": "Upside-Down Caramel-Apple Muffins", "author": "Melissa Clark", "description": "I’ve never been much of a muffin maker. If I’m going to bake, I’d prefer to make a whole cake. But there is one kind of muffin that I heartily embrace — an upside-down fruit muffin. Its small, individual size encourages the fruit to condense and caramelize as it bakes. Then, when you unmold the muffin, the fruit transforms into a glistening crown of an irresistible sticky topping.", "servings": {"text": "12 muffins", "min": 12, "max": 12, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 55, "raw": {"total": "PT55M"}}, "ingredients": [{"position": 1, "raw": "3 apples about 1 ½ pounds, peeled, cored and sliced ¼-inch thick", "group": null, "quantity": 3.0, "unit": null, "item": "apples about 1 ½ pounds", "preparation": "peeled, cored and sliced ¼-inch thick", "optional": false}, {"position": 2, "raw": "½ cup dark brown sugar", "group": null, "quantity": 0.5, "unit": "cup", "item": "dark brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "8 tablespoons (1 stick) unsalted butter", "group": null, "quantity": 8.0, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 4, "raw": "Pinch kosher salt", "group": null, "quantity": null, "unit": null, "item": "pinch kosher salt", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup chopped walnuts, toasted optional", "group": null, "quantity": 0.5, "unit": "cup", "item": "chopped walnuts", "preparation": "toasted optional", "optional": true}, {"position": 6, "raw": "2 cups all-purpose flour", "group": null, "quantity": 2.0, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup dark brown sugar", "group": null, "quantity": 0.75, "unit": "cup", "item": "dark brown sugar", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon baking powder", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 9, "raw": "½ teaspoon ground cinnamon", "group": null, "quantity": 0.5, "unit": "tsp", "item": "ground cinnamon", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ teaspoon kosher salt", "group": null, "quantity": 0.25, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 11, "raw": "8 tablespoons (1 stick) unsalted butter, melted", "group": null, "quantity": 8.0, "unit": "tbsp", "item": "unsalted butter", "preparation": "melted", "optional": false}, {"position": 12, "raw": "2 large eggs, lightly beaten", "group": null, "quantity": 2.0, "unit": null, "item": "large eggs", "preparation": "lightly beaten", "optional": false}, {"position": 13, "raw": "¾ cup sour cream", "group": null, "quantity": 0.75, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 14, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oven to 375 degrees. Generously grease a 12-cup muffin tin."}, {"position": 2, "text": "In a large skillet over medium-high heat, stir together the apples, ½ cup brown sugar, 8 tablespoons butter and pinch salt. Cook, stirring occasionally, until the apples are tender, about 15 minutes. Distribute the apple slices among the muffin cups. Add walnuts, if using, on top of the apple slices."}, {"position": 3, "text": "To make the muffins, in a large bowl, whisk together flour, ¾ cup brown sugar, baking powder, cinnamon and ¼ teaspoon salt."}, {"position": 4, "text": "In a separate bowl, whisk together 8 tablespoons butter, eggs, sour cream and vanilla. Pour the wet ingredients into the dry and fold together until smooth. Distribute the batter on top of the apples. Bake until the muffins are slightly puffed, about 20 to 22 minutes."}, {"position": 5, "text": "Allow the muffins to cool partly in the pan; turn onto a platter and serve warm or at room temperature."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 366.75, "protein_g": 4.6, "carbohydrates_g": 38.8, "fat_g": 22.4, "saturated_fat_g": 11.6, "unsaturated_fat_g": 3.3, "trans_fat_g": 0.1, "cholesterol_mg": 80.2, "sodium_mg": 163.4, "fiber_g": 2.0, "sugar_g": 20.1, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert-muffin"], "meal": [], "occasion": [], "other": ["all-purpose-flour", "apple", "fall", "great-leftovers", "walnut"]}, "images": [{"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-googleFourByThree.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-mediumSquareAt3X.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2025/09/02/multimedia/Upside-Down-Caramel-Apple-Muffins-tqwz/Upside-Down-Caramel-Apple-Muffins-tqwz-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 821}, "video_url": null, "comment_count": null, "published_at": "2010-10-06", "scraped_at": "2026-09-07T02:08:48Z", "scraper_version": "1.0.0"}

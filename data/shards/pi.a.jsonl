{"slug": "pizza-with-mushrooms-goat-cheese-arugula-and-walnuts", "nyt_id": 1012552, "url": "https://cooking.nytimes.com/recipes/1012552-pizza-with-mushrooms-goat-cheese-arugula-and-walnuts", "name": "Pizza With Mushrooms, Goat Cheese, Arugula and Walnuts", "author": "Martha Rose Shulman", "description": "Eating this dish is like eating a salad and a pizza at the same time.", "servings": {"text": "1 12 to 14-inch pizza", "min": 12, "max": 14, "yield_type": "other"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "½ recipe whole wheat pizza dough (see recipe)", "group": null, "quantity": 0.5, "unit": null, "item": "recipe whole wheat pizza dough", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "½ pound mushrooms, trimmed, cleaned and sliced", "group": null, "quantity": 0.5, "unit": "lb", "item": "mushrooms", "preparation": "trimmed, cleaned and sliced", "optional": false}, {"position": 4, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon fresh thyme leaves", "group": null, "quantity": 1.0, "unit": "tsp", "item": "fresh thyme leaves", "preparation": null, "optional": false}, {"position": 7, "raw": "4 ounces goat cheese", "group": null, "quantity": 4.0, "unit": "oz", "item": "goat cheese", "preparation": null, "optional": false}, {"position": 8, "raw": "4 walnuts, shelled and chopped", "group": null, "quantity": 4.0, "unit": null, "item": "walnuts", "preparation": "shelled and chopped", "optio
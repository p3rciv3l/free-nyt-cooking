l": false}, {"position": 14, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 15, "raw": "1 teaspoon honey", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "honey", "preparation": null, "optional": false}, {"position": 16, "raw": "¾ teaspoon kosher salt (such as Diamond Crystal)", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "kosher salt (such as diamond crystal)", "preparation": null, "optional": false}, {"position": 17, "raw": "3 large heirloom tomatoes, cut into pieces", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large heirloom tomatoes", "preparation": "cut into pieces", "optional": false}, {"position": 18, "raw": "2 large pluots, cut into pieces", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large pluots", "preparation": "cut into pieces", "optional": false}, {"position": 19, "raw": "Extra-virgin olive oil, for drizzling", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "extra-virgin olive oil", "preparation": "for drizzling", "optional": false}, {"position": 20, "raw": "Balsamic vinegar, for drizzling", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "balsamic vinegar", "preparation": "for drizzling", "optional": false}, {"position": 21, "raw": "Fresh basil or mint leaves or a combination, torn if large", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "fresh basil or mint leaves or a combination", "preparation": "torn if large", "optional": false}, {"position": 22, "raw": "Flaky salt, for sprinkling", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "flaky salt", "preparation": "for sprinkling", "optional": false}], "steps": [{"position": 1, "text": "Make the suya pistachio crunch: Heat the oven to 300 degrees. Line a small rimmed baking sheet with parchment paper."}, {"position": 2, "text": "Mix the ginger, brown sugar, cayenne, grains of paradise, onion powder, garlic powder and salt in a small bowl. Add the pistachios and oil, and toss to evenly coat. Spread in a single layer on the prepared pan."}, {"position": 3, "text": "Bake until browned and fragrant, 15 to 17 minutes. Cool completely on the pan, then coarsely chop. The crunch can be kept in an airtight container for up to 1 week."}, {"position": 4, "text": "Make the pistachio cream: Using a spice grinder or blender, grind the pistachios until very finely ground. Transfer to a bowl and stir in the cream, yogurt, oil, lemon juice, honey and salt until very well-blended. The cream can be covered and refrigerated for up to 2 days."}, {"position": 5, "text": "Assemble the salad: Spread the pistachio cream on smaller plates or a large platter. Arrange the tomatoes and pluots on top, drizzle lightly with oil and vinegar, then sprinkle with the herbs and salt. Scatter the suya pistachio crunch on top. Serve immediately."}], "nutrition": {"calories": 251.6, "protein_g": 6.4, "carbohydrates_g": 15.7, "fat_g": 19.7, "saturated_fat_g": 4.6, "trans_fat_g": 0.1, "cholesterol_mg": 12.0, "sodium_mg": 377.0, "fiber_g": 3.9, "sugar_g": 9.0, "unsaturated_fat_g": 14.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["west african inspired"], "diet": ["gluten-free", "egg-free", "peanut-free", "soy-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "alcohol-free", "vegetarian", "pescatarian", "low-carb"], "course": ["appetizer", "side dish"], "meal": ["dinner"], "occasion": ["party"], "other": ["pistachio", "heirloom tomato", "greek yogurt", "ground ginger", "cayenne pepper", "salad", "bake", "make-ahead", "summer", "heavy cream", "what to cook"]}, "images": [{"url": "https://static01.nyt.com/images/2026/08/04/multimedia/04FD-KOREX3-SALAD-GK-Pluot-Tomato-Salad-
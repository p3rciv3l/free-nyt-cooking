{"slug": "pluot-tomato-salad-with-suya-pistachio-crunch", "nyt_id": 785874251, "url": "https://cooking.nytimes.com/recipes/785874251-pluot-tomato-salad-with-suya-pistachio-crunch", "name": "Pluot-Tomato Salad With Suya Pistachio Crunch", "author": "Genevieve Ko", "description": "This spectacular summer dish layers tangy, juicy pluots and ripe tomatoes with a creamy pistachio yogurt sauce and crunchy, spicy pistachios, making each bite thrilling. The chef Keith Corbin created it for his Los Angeles restaurant Alta Adams to celebrate the best of local summer fruits. He decided to season them with West African suya but took apart the traditional blend of ground spices and peanuts, swapping in whole California-grown pistachios and coating them with suya’s ginger, garlic and onion powders. He then tossed in a bit of sugar to lightly candy the nuts into a crunchy sprinkle that’s great on, frankly, anything. At the restaurant, Mr. Corbin sometimes makes this with lightly grilled peaches, plums, nectarines and other stone fruits, but good fruit will still taste great uncooked. Genevieve Ko", "servings": {"text": "4-6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 10, "cook_minutes": 20, "total_minutes": 30, "raw": {"total": "30 min", "prep": "PT0H10M", "cook": "PT0H20M"}}, "ingredients": [{"position": 1, "raw": "2 teaspoons ground ginger", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "ground ginger", "preparation": null, "optional": false}, {"position": 2, "raw": "½ teaspoon brown sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon ground cayenne", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "ground cayenne", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ teaspoon ground grains of paradise (see Tip) or black pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "ground grains of paradise (see tip) or black pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon onion powder", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "onion powder", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon garlic powder", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "garlic powder", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon kosher salt (such as Diamond Crystal)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt (such as diamond crystal)", "preparation": null, "optional": false}, {"position": 8, "raw": "¾ cup shelled unsalted pistachios", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "shelled unsalted pistachios", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ½ teaspoons extra-virgin olive oil", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "⅓ cup shelled unsalted pistachios", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "shelled unsalted pistachios", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup heavy cream", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons plain full-fat Greek yogurt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "plain full-fat greek yogurt", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon extra-virgin olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optiona
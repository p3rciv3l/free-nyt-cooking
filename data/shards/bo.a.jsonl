{"slug": "borscht-salad", "nyt_id": 1015268, "url": "https://cooking.nytimes.com/recipes/1015268-borscht-salad", "name": "Borscht Salad", "author": "Mark Bittman", "description": "There are loads of ways to prepare beets beyond just pairing them with goat cheese, and in 2013, Mark Bittman looked at about a dozen or so of them. Here, they’re grated, not roasted whole, and paired with shredded cabbage and dill, some of the dominant ingredients in borscht. It’s a nontraditional approach to beets and borscht alike, ready in minutes.", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "1 pound beets", "group": null, "quantity": 1.0, "unit": "lb", "item": "beets", "preparation": null, "optional": false}, {"position": 2, "raw": "1 shallot, minced", "group": null, "quantity": 1.0, "unit": null, "item": "shallot", "preparation": "minced", "optional": false}, {"position": 3, "raw": "2 teaspoons Dijon mustard", "group": null, "quantity": 2.0, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup sour cream", "group": null, "quantity": 0.25, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 5, "raw": "lemon juice to taste", "group": null, "quantity": null, "unit": null, "item": "lemon juice to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "chopped dill", "group": null, "quantity": null, "unit": null, "item": "chopped dill", "preparation": null, "optional": false}, {"position": 7, "raw": "shredded cabbage", "group": null, "quantity": null, "unit": null, "item": "shredded cabbage", "preparation": null, "optional": false}, {"position": 8, "raw": "a chopped hard-boiled egg", "group": null, "quantity": null, "unit": null, "item": "a chopped hard-boiled egg", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel and grate 1 pound beets."}, {"position": 2, "text": "Make a dressing with minced shallot, Dijon mustard, sour cream, lemon juice to taste and chopped dill."}, {"position": 3, "text": "Add shredded cabbage and a chopped hard-boiled egg."}, {"position": 4, "text": "Garnish: Parsley."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 107.5, "protein_g": 4.0, "carbohydrates_g": 14.9, "fat_g": 4.2, "saturated_fat_g": 1.8, "unsaturated_fat_g": 0.4, "trans_fat_g": 0.1, "cholesterol_mg": 45.8, "sodium_mg": 136.3, "fiber_g": 3.9, "sugar_g": 9.7, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side-dish"], "meal": [], "occasion": [], "other": ["beet", "cabbage", "egg", "shallot"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/15/dining/Borscht-Salad/Borscht-Salad-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/05/15/dining/Borscht-Salad/Borscht-Salad-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 202}, "video_url": null, "comment_count": null, "published_at": "2013-10-27", "scraped_at": "2026-09-06T23:58:50Z", "scraper_version": "1.0.0"}
{"slug": "boston-baked-beans", "nyt_id": 1017614, "url": "https://cooking.nytimes.com/recipes/1017614-boston-baked-beans", "name": "Boston Baked Beans", "author": "Pete Wells", "description": "Squat, glazed ceramic bean pots lurk in cabinets all over New England. They're traditional for Boston baked beans, but enameled cast iron is faster. Beans in cast iron can be brought to a boil over a burner before the dish goes into the oven; this saves about an hour. Pete Wells", "servings": {"text": "8 to 10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "PT4H"}}, "ingredients": [{"position": 1, "raw": "1 pound dried navy or Great Northern beans", "group": null, "quantity": 1.0, "unit": "lb", "item": "dried navy or great northern beans", "preparation": null, "optional": false}, {"position": 2, "raw": "½ pound salt pork or bacon, rind removed, cut into ¼-inch dice", "group": null, "quantity": 0.5, "unit": "lb", "item": "salt pork or bacon", "preparation": "rind removed, cut into ¼-inch dice", "optional": false}, {"position": 3, "raw": "1 onion, chopped", "group": null, "quantity": 1.0, "unit": null, "item": "onion", "preparation": "chopped", "optional": false}, {"position": 4, "raw": "4 garlic cloves, peeled", "group": null, "quantity": 4.0, "unit": null, "item": "garlic cloves", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "½ cup dark molasses or maple syrup, preferably Grade B", "group": null, "quantity": 0.5, "unit": "cup", "item": "dark molasses or maple syrup", "preparation": "preferably Grade B", "optional": false}, {"position": 6, "raw": "¼ cup ketchup", "group": null, "quantity": 0.25, "unit": "cup", "item": "ketchup", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons mustard powder", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "mustard powder", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon Worcestershire sauce", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "worcestershire sauce", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon pepper, plus more to taste", "group": null, "quantity": 1.0, "unit": "tsp", "item": "pepper", "preparation": "plus more to taste", "optional": false}, {"position": 10, "raw": "1 thyme branch (optional)", "group": null, "quantity": 1.0, "unit": null, "item": "thyme branch", "preparation": null, "optional": true}, {"position": 11, "raw": "1 bay leaf (optional)", "group": null, "quantity": 1.0, "unit": null, "item": "bay leaf", "preparation": null, "optional": true}, {"position": 12, "raw": "1 teaspoon salt, plus more to taste", "group": null, "quantity": 1.0, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 13, "raw": "1 tablespoon cider vinegar, plus more to taste", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "cider vinegar", "preparation": "plus more to taste", "optional": false}], "steps": [{"position": 1, "text": "Pick through the beans for stones, rinse them thoroughly and soak in water overnight. (Leave soaking until ready to cook; you'll need the water.)"}, {"position": 2, "text": "Heat oven to 300 degrees. Place a Dutch oven, 5-quart size or larger, over low heat. Add the salt pork or bacon and fry until crisp, 12 to 15 minutes. Raise heat to medium and stir in the onion. Cook until onion is translucent, stirring occasionally, 5 to 8 minutes."}, {"position": 3, "text": "Add the beans to the pan along with enough of the soaking liquid to cover them by ½ inch, adding fresh water if needed. Add the garlic cloves, molasses or maple syrup, ketchup, mustard powder, Worcestershire sauce, 1 teaspoon pepper and the thyme branch and bay leaf, if using. Stir well and bring to a boil. Cover the pot and put in oven."}, {"position": 4, "text": "Check the liquid level in the pot every hour or so, and add hot water as needed to barely cover the beans. Cook until beans are very soft but not falling apart, 2 to 3 hours. Remove from oven. Stir in 1 teaspoon salt and 1 tablespoon vinegar; let sit at room temperature for 30 minutes, then taste a bean and some liquid, adding more salt, pepper or vinegar, if you like. Serve, or cool completely and reheat."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 287.5, "protein_g": 5.3, "carbohydrates_g": 24.5, "fat_g": 19.2, "saturated_fat_g": 6.8, "unsaturated_fat_g": 2.4, "trans_fat_g": null, "cholesterol_mg": 19.5, "sodium_mg": 855.2, "fiber_g": 2.8, "sugar_g": 12.3, "computed_with": null}, "tags": {"cuisine": ["american"], "diet": [], "course": ["dinner-side-dish-snack"], "meal": [], "occasion": [], "other": ["molasses", "navy-bean", "one-pot"]}, "images": [{"url": "https://static01.nyt.com/images/2015/08/19/dining/19JPVACATION/19JPVACATION-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2015/08/19/dining/19JPVACATION/19JPVACATION-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 579}, "video_url": null, "comment_count": null, "published_at": "2015-08-19", "scraped_at": "2026-09-07T00:15:30Z", "scraper_version": "1.0.0"}
{"slug": "bouillon-of-wild-mushrooms-and-coriander", "nyt_id": 10082, "url": "https://cooking.nytimes.com/recipes/10082-bouillon-of-wild-mushrooms-and-coriander", "name": "Bouillon Of Wild Mushrooms And Coriander", "author": "Molly O’Neill", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "PT2H"}}, "ingredients": [{"position": 1, "raw": "1 pound shiitake mushrooms, coarsely chopped", "group": null, "quantity": 1.0, "unit": "lb", "item": "shiitake mushrooms", "preparation": "coarsely chopped", "optional": false}, {"position": 2, "raw": "½ head garlic, peeled and crushed", "group": null, "quantity": 0.5, "unit": "head", "item": "garlic", "preparation": "peeled and crushed", "optional": false}, {"position": 3, "raw": "1 medium onion, quartered", "group": null, "quantity": 1.0, "unit": null, "item": "medium onion", "preparation": "quartered", "optional": false}, {"position": 4, "raw": "1 pound fresh ripe tomatoes, quartered", "group": null, "quantity": 1.0, "unit": "lb", "item": "fresh ripe tomatoes", "preparation": "quartered", "optional": false}, {"position": 5, "raw": "8 stems fresh coriander", "group": null, "quantity": 8.0, "unit": null, "item": "stems fresh coriander", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ quarts water", "group": null, "quantity": 1.5, "unit": "quart", "item": "water", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ teaspoons salt", "group": null, "quantity": 1.5, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 8, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup Madeira", "group": null, "quantity": 0.25, "unit": "cup", "item": "madeira", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup mixed wild mushrooms, stemmed and thinly sliced", "group": null, "quantity": 1.0, "unit": "cup", "item": "mixed wild mushrooms", "preparation": "stemmed and thinly sliced", "optional": false}, {"position": 11, "raw": "8 coriander leaves", "group": null, "quantity": 8.0, "unit": null, "item": "coriander leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the shiitakes, garlic, onion, tomatoes, coriander stems and water in a large pot. Bring to a boil. Reduce heat and simmer for 1 hour. Strain the broth through a fine sieve lined with cheesecloth. Cleanthe pot, add the broth and place over medium-high heat. Simmer rapidly until reduced to 2 cups, about 20 minutes. Strain again. Return the broth to the pot, season with 1 teaspoon salt and pepper and keep hot."}, {"position": 2, "text": "Heat the Madeira in a medium skillet over medium heat. Add the wild mushrooms and cook until softened, about 3 minutes. Season with the remaining ½ teaspoon salt and pepper. Divide the mushrooms and the coriander leaves among 4 bowls. Ladle in the broth and serve immediately."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 102.0, "protein_g": 5.0, "carbohydrates_g": 20.3, "fat_g": 1.1, "saturated_fat_g": 0.1, "unsaturated_fat_g": 0.1, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 914.1, "fiber_g": 6.2, "sugar_g": 7.7, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer-soup"], "meal": [], "occasion": [], "other": ["coriander", "great-leftovers", "project", "shiitake"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": null, "vid
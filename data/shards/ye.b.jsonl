{"slug": "yeast-raised-waffles", "nyt_id": 11408, "url": "https://cooking.nytimes.com/recipes/11408-yeast-raised-waffles", "name": "Yeast-Raised Waffles", "author": "Dorie Greenspan", "description": "Dorie Greenspan", "servings": {"text": "About 14 waffles", "min": 14, "max": 14, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup milk, warmed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": "warmed", "optional": false}, {"position": 2, "raw": "1 packet dry yeast", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "packet dry yeast", "preparation": null, "optional": false}, {"position": 3, "raw": "3 large eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "¾ teaspoon salt", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "2 teaspoons pure vanilla extract", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "pure vanilla extract", "preparation": null, "optional": false}, {"position": 7, "raw": "2 ⅔ cups all-purpose flour", "group": null, "quantity": 2.6666666666666665, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 8, "raw": "⅔ cup créme fraîche or heavy cream", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "créme fraîche or heavy cream", "preparation": null, "optional": false}, {"position": 9, "raw": "1 stick unsalted butter, melted", "group": null, "qu
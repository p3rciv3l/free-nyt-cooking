{"slug": "yellow-tomato-marmalade", "nyt_id": 2793, "url": "https://cooking.nytimes.com/recipes/2793-yellow-tomato-marmalade", "name": "Yellow Tomato Marmalade", "author": "Florence Fabricant", "description": "", "servings": {"text": "7 eight-ounce jars", "min": 7, "max": 7, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "2 lemons, seeded and chopped, including the skins", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "lemons", "preparation": "seeded and chopped, including the skins", "optional": false}, {"position": 2, "raw": "1 cup fresh orange juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh orange juice", "preparation": null, "optional": false}, {"position": 3, "raw": "2 pounds yellow tomatoes, peeled, seeded and chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "yellow tomatoes", "preparation": "peeled, seeded and chopped", "optional": false}, {"position": 4, "raw": "2 Granny Smith apples, peeled, cored and chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "granny smith apples", "preparation": "peeled, cored and chopped", "optional": false}, {"position": 5, "raw": "2 cups sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "8 whole allspice", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "whole allspice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine the lemons and orange juice in a blender or food processor and process until the lemon is finely chopped. Transfer to a large, heavy saucepan, bring to a simmer and cook over medium-high heat until the lemon becomes transparent."}, {"position": 2, "text": "Add the remaining ingredien
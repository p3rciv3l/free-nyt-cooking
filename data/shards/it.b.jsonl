{"slug": "italian-bread-and-tomato-salad", "nyt_id": 7254, "url": "https://cooking.nytimes.com/recipes/7254-italian-bread-and-tomato-salad", "name": "Italian Bread And Tomato Salad", "author": "Marian Burros", "description": "", "servings": {"text": "3 servings", "min": 3, "max": 3, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "½ pound coarse white bread like ciabatta", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "coarse white bread like ciabatta", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ pounds ripe local tomatoes", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "ripe local tomatoes", "preparation": null, "optional": false}, {"position": 3, "raw": "1 small Kirby cucumber", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small kirby cucumber", "preparation": null, "optional": false}, {"position": 4, "raw": "8 ounces red onion", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "red onion", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons extra-virgin olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons red-wine vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 8, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut bread into ½-inch thick slices, then break up or cut up into ½-inch cubes. Place into large serving bowl."}, {"position": 2, "text": "Wash and trim tomatoes, and cut in quarters. Squeeze juice from tomatoes over the bread; then, dice the tomatoes in ½-inch cubes and stir into bread."}, {"position": 3, "text": "Scrub and trim cucumber, and slice thinly. Cut slices into match-sticks, and add to bowl."}, {"position": 4, "text": "Finely mince onion, and add. Drizzle oil and vinegar over ingredients, and mix well to moisten bread and meld ingredients. Season with salt and pepper."}], "nutrition": {"calories": 406.9, "protein_g": 10.8, "carbohydrates_g": 56.9, "fat_g": 16.3, "saturated_fat_g": 2.4, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 678.9, "fiber_g": 6.5, "sugar_g": 14.4, "unsaturated_fat_g": 13.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["vegetarian"], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["ciabatta", "cucumber", "easy", "five ingredient", "quick", "salad", "summer", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 8}, "video_url": null, "comment_count": null, "published_at": "1997-07-30", "scraped_at": "2026-09-07T01:00:31.548662+00:00", "scraper_version": "1.0.0"}
{"slug": "italian-meatballs-with-capers-polpettine-ai-capperi", "nyt_id": 1956, "url": "https://cooking.nytimes.com/recipes/1956-italian-meatballs-with-capers-polpettine-ai-capperi", "name": "Italian Meatballs With Capers (Polpettine Ai Capperi)", "author": "Frank J. Prial", "description": "", "servings": {"text": "Fourteen meatballs", "min": 14, "max": 14, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound finely ground lean veal", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "finely ground lean veal", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup finely minced onions", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "finely minced onions", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup fine fresh bread crumbs", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fine fresh bread crumbs", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablespoons milk", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "milk", "preparation": null, "optional": false}, {"position": 6, "raw": "1 small egg, lightly beaten", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small egg", "preparation": "lightly beaten", "optional": false}, {"position": 7, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 8, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon dried marjoram, crushed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dried marjoram", "preparation": "crushed", "optional": false}, {"position": 10, "raw": "2 tablespoons finely chopped parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped parsley", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ cup drained capers", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "drained capers", "preparation": null, "optional": false}, {"position": 12, "raw": "¼ cup flour", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon corn, peanut or vegetable oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "corn", "preparation": "peanut or vegetable oil", "optional": false}, {"position": 14, "raw": "¼ cup dry white wine", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put the meat in a mixing bowl."}, {"position": 2, "text": "Heat the butter in a saucepan and add the onions. Cook, stirring, until the onions are wilted. Set aside and let cool briefly."}, {"position": 3, "text": "Soak the bread crumbs in the milk and add this to the meat. Add the egg, cooked onions, salt and pepper. Add the marjoram and parsley and blend well."}, {"position": 4, "text": "Divide the mixture into 14 portions and flatten each. Make a slight depression in the center of each meatball. Add an equal portion of the capers in the center of each. Bring up the edges and shape into balls, enclosing the capers in the center."}, {"position": 5, "text": "Dredge each ball in flour and shake off excess."}, {"position": 6, "text": "Heat the oil in a heavy, nonstick skillet and add the meatballs without crowding. Cook, turning carefully, until the meatballs are browned on all sides, about 8 to 10 minutes. Add the wine and cover closely. Let simmer 12 minutes. Serve with a little of the hot pan liquid spooned over."}], "nutrition": {"calories": 73.6, "protein_g": 7.4, "carbohydrates_g": 2.9, "fat_g": 3.2, "saturated_fat_g": 1.0, "trans_fat_g": 0.0, "cholesterol_mg": 39.4, "sodium_mg": 124.0, "fiber_g": 0.3, "sugar_g": 0.4, "unsaturated_fat_g": 1.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["appetizer"], "meal": ["dinner"], "occasion": [], "other": ["caper", "fry", "ground veal", "onion"]}, "images": [], "rating": {"average": 4.0, "count": 30}, "video_url": null, "comment_count": null, "published_at": "1985-02-10", "scraped_at": "2026-09-07T04:00:22.426867+00:00", "scraper_version": "1.0.0"}
{"slug": "italian-or-cooked-meringue", "nyt_id": 10872, "url": "https://cooking.nytimes.com/recipes/10872-italian-or-cooked-meringue", "name": "Italian or Cooked Meringue", "author": "Marian Burros", "description": "This recipe, adapted from “Mastering the Art of French Cooking” by Julia Child, was featured in The New York Times in 1990 in an article on eggs. It is for a cooked meringue that can be used with chocolate mousse or lemon soufflé. When done correctly, the meringue should have a soft white sheen and hold its shape. A candy thermometer is a helpful tool in this regard. Marian Burros", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": 30, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes", "prep": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 2, "raw": "⅓ cup water", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "3 egg whites", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "egg whites", "preparation": null, "optional": false}, {"position": 4, "raw": "⅛ teaspoon cream of tartar", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "cream of tartar", "preparation": null, "optional": false}, {"position": 5, "raw": "Pinch salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine the sugar and water in saucepan and stir well. Cook over medium-high heat but do not stir. Instead swirl pan by the handle."}, {"position": 2, "text": "Continue swirling pan and bring mixture to boil. Let it boil until the liquid becomes completely clear."}, {"position": 3, "text": "Reduce heat; cover pan and continue to simmer while beating whites."}, {"position": 4, "text": "Beat whites slowly until they become foamy. Then beat in cream of tartar and salt. Increase speed and beat whites until stiff peaks form."}, {"position": 5, "text": "Uncover sugar syrup; insert candy thermometer and boil until the temperature reaches 238 degrees, the soft-ball stage."}, {"position": 6, "text": "Remove from heat; start to beat whites at medium speed and slowly pour boiling syrup into whites, beating all the time. Continue to beat until the mixture forms stiff peaks, about 8 minutes. The meringue is the proper consistency if it does not move when a spatula is run through it."}], "nutrition": {"calories": 204.0, "protein_g": 2.2, "carbohydrates_g": 50.2, "fat_g": 0.0, "saturated_fat_g": 0.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 71.1, "fiber_g": 0.0, "sugar_g": 50.0, "unsaturated_fat_g": 0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["boil", "quick"]}, "images": [], "rating": {"average": 4.0, "count": 37}, "video_url": null, "comment_count": null, "published_at": "1990-06-27", "scraped_at": "2026-09-07T01:53:12.196519+00:00", "scraper_version": "1.0.0"}
{"slug": "italian-pot-roast-stracotto", "nyt_id": 1650, "url": "https://cooking.nytimes.com/recipes/1650-italian-pot-roast-stracotto", "name": "Italian Pot Roast (Stracotto)", "author": "Florence Fabricant", "description": "Pot roasts exist in many cuisines, of course, and the Italians have stracotto, which means \"overcooked.\" Like many other roasts, this one cooks low and slow after it’s seared. But here, red wine adds depth to the tomatoes, and a smattering of fresh basil contributes to its complexity. Make this for your next Sunday supper, or on a cold winter evening.", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "4 hours"}}, "ingredients": [{"position": 1, "raw": "3 large cloves garlic, peeled", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": "peeled", "optional": false}, {"position": 2, "raw": "1 (3-pound) rump or boneless chuck roast", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(3-pound) rump or boneless chuck roast", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 pound onions, peeled and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "onions", "preparation": "peeled and chopped", "optional": false}, {"position": 5, "raw": "2 carrots, peeled and chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "carrots", "preparation": "peeled and chopped", "optional": false}, {"position": 6, "raw": "2 ribs celery, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "ribs celery", "preparation": "chopped", "optional": false}, {"position": 7, "raw": "½ cup robust dry red wine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "robust dry red wine", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup seeded, chopped plum tomatoes or well-drained canned plum tomatoes, seeded and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "seeded", "preparation": "chopped plum tomatoes or well-drained canned plum tomatoes, seeded and chopped", "optional": false}, {"position": 9, "raw": "1 tablespoon tomato paste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup finely chopped fresh basil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely chopped fresh basil", "preparation": null, "optional": false}, {"position": 11, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut the garlic into thin slivers. Pierce the meat in many places with the point of a knife and insert the garlic slivers into the holes."}, {"position": 2, "text": "Heat 2 tablespoons of the oil in a heavy 3- to 4-quart heatproof casserole. Add the meat and brown it well over medium heat. Remove it from the casserole. Add the remaining oil and the onions, carrots and celery. Saute them until moderately brown."}, {"position": 3, "text": "Stir in the wine and cook for a few minutes, scraping the casserole. Add the tomatoes, tomato paste and basil. Season the mixture with salt and pepper and return the meat to the casserole."}, {"position": 4, "text": "Cover tightly and cook over very low heat for at least three hours, until the meat is very tender. Turn the meat a few times during cooking."}, {"position": 5, "text": "Remove the meat from the casserole. To serve immediately, skim the fat from the surface of the sauce, then puree the sauce in a food processor and reheat. Otherwise, refrigerate the meat and sauce overnight. Remove any congealed fat from the sauce and puree the sauce in a food processor. Reheat the meat in the sauce before serving."}], "nutrition": {"calories": 456.3, "protein_g": 34.0, "carbohydrates_g": 9.8, "fat_g": 30.6, "saturated_fat_g": 11.0, "trans_fat_g": 1.4, "cholesterol_mg": 112.3, "sodium_mg": 692.1, "fiber_g": 2.1, "sugar_g": 4.1, "unsaturated_fat_g": 18.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["beef roast", "dry red wine", "saute", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2016/12/30/dining/30COOKING-ITALIAN-POTROAST2/30COOKING-ITALIAN-POTROAST2-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 1062}, "video_url": null, "comment_count": null, "published_at": "1990-12-05", "scraped_at": "2026-09-07T03:44:25.389221+00:00", "scraper_version": "1.0.0"}

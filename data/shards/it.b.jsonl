: false}], "steps": [{"position": 1, "text": "Chop the onions and saute them until translucent, adding garlic clove, minced or put through garlic press, toward the end."}, {"position": 2, "text": "Put the meat in a big bowl. Add the onions, garlic, ketchup, pepper and garlic salt. Knead by hand. Add the water and the bread crumbs and mix well by hand."}, {"position": 3, "text": "Shape into 2 loaves in baking tins. Cook 30 to 40 minutes in a preheated 350-degree oven. (''Stick a knife in,'' Mr. Perlman says. ''If it comes out cold, it's not ready; if it's warm, it is.'')"}], "nutrition": {"calories": 422.0, "protein_g": 34.5, "carbohydrates_g": 16.5, "fat_g": 23.3, "saturated_fat_g": 8.9, "trans_fat_g": 1.2, "cholesterol_mg": 83.3, "sodium_mg": 322.3, "fiber_g": 1.4, "sugar_g": 2.3, "unsaturated_fat_g": 12.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "bread crumb", "onion", "veal", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 32}, "video_url": null, "comment_count": null, "published_at": "1987-02-18", "scraped_at": "2026-09-07T04:42:56.648179+00:00", "scraper_version": "1.0.0"}

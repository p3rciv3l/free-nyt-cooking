capers", "preparation": null, "optional": false}, {"position": 9, "raw": "⅓ cup chopped fresh parsley", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "chopped fresh parsley", "preparation": null, "optional": false}, {"position": 10, "raw": "⅓ cup chopped fresh dill", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "chopped fresh dill", "preparation": null, "optional": false}, {"position": 11, "raw": "10 tablespoons olive oil", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 12, "raw": "6 or 7 tablespoons red wine vinegar", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "or 7 tablespoons red wine vinegar", "preparation": null, "optional": false}, {"position": 13, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 14, "raw": "2 large cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": "minced", "optional": false}, {"position": 15, "raw": "2 tablespoons chopped fresh basil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh basil", "preparation": null, "optional": false}, {"position": 16, "raw": "½ teaspoon dried oregano", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "dried oregano", "preparation": null, "optional": false}, {"position": 17, "raw": "2 tablespoons minced parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Saute scallops in hot butter for about 3 minutes, just enough to cook
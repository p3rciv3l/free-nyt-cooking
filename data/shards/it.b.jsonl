{"slug": "italian-style-braised-rabbit-with-rosemary-and-mushrooms", "nyt_id": 12254, "url": "https://cooking.nytimes.com/recipes/12254-italian-style-braised-rabbit-with-rosemary-and-mushrooms", "name": "Italian-Style Braised Rabbit With Rosemary and Mushrooms", "author": "David Tanis", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "About 1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 whole rabbit (2 ½ to 3 pounds)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "whole rabbit (2 ½ to 3 pounds)", "preparation": null, "optional": false}, {"position": 2, "raw": "Olive oil", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "Flour, for dusting", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "flour", "preparation": "for dusting", "optional": false}, {"position": 5, "raw": "2 cups onions, finely diced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "onions", "preparation": "finely diced", "optional": false}, {"position": 6, "raw": "2 cups leeks, finely diced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "leeks", "preparation": "finely diced", "optional": false}, {"position": 7, "raw": "6 garlic cloves, minced", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "garlic cloves", "preparation": "minced", "optional": false}, {"position": 8, "raw": "2 tablespoons rosemary, roughly chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "rosemary", "preparation": "roughly chopped", "optional": false}, {"position": 9, "raw": "1 tablespoon crumbled dry porcini mushrooms, soaked in warm water to soften, drained and finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "crumbled dry porcini mushrooms", "preparation": "soaked in warm water to soften, drained and finely chopped", "optional": false}, {"position": 10, "raw": "8 ounces cremini or portobello mushrooms, thickly sliced", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "cremini or portobello mushrooms", "preparation": "thickly sliced", "optional": false}, {"position": 11, "raw": "Pinch of red pepper flakes", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of red pepper flakes", "preparation": null, "optional": false}, {"position": 12, "raw": "1 cup chopped canned tomatoes, or home-preserved, if possible", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped canned tomatoes", "preparation": "or home-preserved, if possible", "optional": false}, {"position": 13, "raw": "½ cup dry white wine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 14, "raw": "1 cup unsalted chicken broth", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "unsalted chicken broth", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut the rabbit into 9 pieces (or ask your butcher to) as follows: with a sharp cleaver, cut the saddle (center portion) into 3 pieces, leaving the kidneys attached. Cut the front portion (front legs) in half through the backbone. Chop each hind leg into 2 pieces. Reserve the liver and heart to sauté as a snack."}, {"position": 2, "text": "Heat .25 inch of olive oil in a Dutch oven or deep, wide heavy skillet over medium heat. Season the rabbit pieces with salt and pepper, then dust lightly with flour. Lightly brown the rabbit for about 3 minutes on both sides, working in batches. Drain on kitchen towels, then transfer to a baking dish in one layer. Heat oven to 375 degrees."}, {"position": 3, "text": "Pour off the used oil, wipe out the pan and add 2 tablespoons fresh oil. Heat to medium-high, add the onions and cook till soft, about 5 minutes. Add the leek, garlic, rosemary and mushrooms. Season generously with salt and pepper, and add red pepper flakes to taste. Cook for 2 minutes more, stirring."}, {"position": 4, "text": "Add the chopped tomatoes and wine, and let the mixture reduce for 1 minute. Add the broth, bring to a simmer, taste and adjust seasonings."}, {"position": 5, "text": "Ladle the mixture evenly over the rabbit. Cover the dish, and bake for 1 hour. Let rest 10 minutes before serving."}], "nutrition": {"calories": 651.4, "protein_g": 68.0, "carbohydrates_g": 27.0, "fat_g": 27.3, "saturated_fat_g": 6.6, "trans_fat_g": 0.0, "cholesterol_mg": 177.8, "sodium_mg": 1548.3, "fiber_g": 4.9, "sugar_g": 8.5, "unsaturated_fat_g": 16.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "leek", "mushroom", "saute", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2012/01/04/dining/04KITCH_SPAN/04KITCH_SPAN-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 188}, "video_url": null, "comment_count": null, "published_at": "2011-12-30", "scraped_at": "2026-09-06T23:54:23.880007+00:00", "scraper_version": "1.0.0"}

t": "cup", "item": "white wine", "preparation": null, "optional": false}, {"position": 20, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 21, "raw": "Pinch of saffron", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of saffron", "preparation": null, "optional": false}, {"position": 22, "raw": "2 tablespoons Worcestershire sauce", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "worcestershire sauce", "preparation": null, "optional": false}, {"position": 23, "raw": "2 teaspoons Tabasco", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "tabasco", "preparation": null, "optional": false}, {"position": 24, "raw": "1 tablespoon gumbo file", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "gumbo file", "preparation": null, "optional": false}, {"position": 25, "raw": "½ teaspoon cayenne", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "cayenne", "preparation": null, "optional": false}, {"position": 26, "raw": "Juice of 2 lemons", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 2 lemons", "preparation": null, "optional": false}, {"position": 27, "raw": "2 cups okra (frozen is O.K.)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "okra (frozen is o.k.)", "preparation": null, "optional": false}, {"position": 28, "raw": "1 pint clams (canned is O.K.)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "clams (canned is o.k.)", "preparation": null, "optional": false}, {"position": 29, "raw": "½ pound crabmeat, picked over and cartilage removed", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "crabmeat", "preparation": "picked over and cartilage removed", "optional": false}], "steps": [{"position": 1, "text": "Put the lobsters in 2 quarts of cold salted water in a large stockpot and bring to a boil for about 5 minutes. (The whole procedure should take 15 minutes.) Add the shrimp and cook for 4 minutes more. Take pot off burner. Remove the shrimp shells and lobster shells and heads and put them back into the pot with the water they were boiled in. Save the shellfish for later."}, {"position": 2, "text": "Add the rest of the stock ingredients to the pot with the shells. Simmer uncovered for 40 minutes. Strain the liquid through a sieve into a large bowl; then put stock back into the pot. Discard the shells and vegetables."}, {"position": 3, "text": "To make the gumbo, fry the bacon. When done, crumble and leave it in the skillet with the fat. Add the remaining ingredients listed in gumbo Part 1 and saute until brown, about 7 minutes."}, {"position": 4, "text": "Add the halibut and olive oil to the skillet and cook, stirring occasionally, for 2 minutes, or until the fish is done. Add this mixture to the pot with the stock. Add the remaining ingredients from gumbo Part 2. Cover and simmer over low heat until well blended, about 1 hour. Can be served with rice."}], "nutrition": null, "tags": {"cuisine": ["creole"], "diet": ["dairy-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["lobster", "shrimp", "stew"]}, "images": [], "rating": {"average": 3.0, "count": 19}, "video_url": null, "comment_count": null, "published_at": "2000-01-30", "scraped_at": "2026-09-07T02:01:17.898974+00:00", "scraper_version": "1.0.0"}
{"slug": "joan-nathans-matzo-ball-soup", "nyt_id": 12348, "url": "https://cooking.nytimes.com/recipes/12348-joan-nathans-matzo-ball-soup", "name": "Joan Nathan’s Matzo Ball Soup", "author": "Joan Nathan", "description": "For children (and arguably most adults), the most welcome Passover dish is chicken soup with matzo balls. My matzo balls, neither heavy as lead nor light as a feather, are al dente, infused with fresh ginger and nutmeg. I like to freeze them, and the soup, in advance.", "servings": {"text": "About 15 matzo balls", "min": 15, "max": 15, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 255, "raw": {"total": "1 1/4 hours, plus 3 hours’ or overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "4 large eggs", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup schmaltz (rendered chicken fat), coconut oil or vegetable oil (kosher for Passover)", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "schmaltz (rendered chicken fat)", "preparation": "coconut oil or vegetable oil (kosher for Passover)", "optional": false}, {"position": 3, "raw": "¼ cup chicken stock or vegetable stock", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chicken stock or vegetable stock", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup matzo meal", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "matzo meal", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon ground nutmeg", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "ground nutmeg", "preparation": null, "optional": false}, {"position": 6, "raw": "1 to 2 tablespoons freshly grated ginger", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "tbsp", "item": "freshly grated ginger", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons finely chopped parsley, dill or cilantro", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped parsley", "preparation": "dill or cilantro", "optional": false}, {"position": 8, "raw": "1 teaspoon salt, more for cooking", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "more for cooking", "optional": false}, {"position": 9, "raw": "Black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large bowl, combine the eggs, schmaltz, stock, matzo meal, nutmeg, ginger and parsley. Season with 1 teaspoon salt and a few grinds of pepper. Gently mix with a whisk or spoon. Cover and refrigerate until chilled, about 3 hours or overnight."}, {"position": 2, "text": "To shape and cook the matzo balls, fill a wide, deep pan with lightly salted water and bring to a boil. With wet hands, take some of the mix and mold it into the size and shape of a Ping-Pong ball. Gently drop it into the boiling water, repeating until all the mix is used."}, {"position": 3, "text": "Cover the pan, reduce heat to a lively simmer and cook matzo balls about 30 to 40 minutes for al dente, longer for light. If desired, the cooked matzo balls can be transferred to chicken or vegetable soup and served immediately. Alternatively, they may be placed on a baking sheet and frozen, then transferred to a freezer bag and kept frozen until a few hours before serving; reheat in chicken or vegetable soup or broth."}], "nutrition": {"calories": 68.5, "protein_g": 2.2, "carbohydrates_g": 3.5, "fat_g": 5.0, "saturated_fat_g": 3.4, "trans_fat_g": 0.0, "cholesterol_mg": 49.7, "sodium_mg": 60.1, "fiber_g": 0.2, "sugar_g": 0.1, "unsaturated_fat_g": 1.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["jewish"], "diet": ["dairy-free", "vegetarian"], "course": ["appetizer"], "meal": [], "occasion": ["passover"], "other": ["egg", "freezer friendly", "matzo meal", "plan-ahead", "soup"]}, "images": [{"url": "https://static01.nyt.com/images/2025/10/21/multimedia/JN-Joan-Nathans-Matzo-Ball-Soup-cvkq/JN-Joan-Nathans-Matzo-Ball-Soup-cvkq-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 2360}, "video_url": null, "comment_count": null, "published_at": "2012-03-28", "scraped_at": "2026-09-07T03:01:55.744480+00:00", "scraper_version": "1.0.0"}

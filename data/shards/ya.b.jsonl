{"slug": "yankee-pot-roast", "nyt_id": 1651, "url": "https://cooking.nytimes.com/recipes/1651-yankee-pot-roast", "name": "Yankee Pot Roast", "author": "Florence Fabricant", "description": "Despite the hours it requires, pot roast is extremely easy to prepare because it needs little tending while it cooks, and it produces satisfying food for a crowd or for several meals, often both. That it calls for relatively inexpensive cuts of beef is also in its favor. Florence Fabricant", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "4 hours"}}, "ingredients": [{"position": 1, "raw": "4 pounds boneless chuck in one thick piece with a thin layer of fat on one side", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "lb", "item": "boneless chuck in one thick piece with a thin layer of fat on one side", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "3 tablespoons vegetable oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 4, "raw": "6 cloves garlic, finely chopped", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "finely chopped", "optional": false}, {"position": 5, "raw": "1 medium-size onion, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size onion", "preparation": "finely chopped", "optional": false}, {"position": 6, "raw": "1 medium-size carrot, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size carrot", "preparation": "finely chopped", "optional": false}, {"position": 7, "raw": "2 tablespoons flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 8, "raw": "2 cups water or 1 cup each water and rich veal or beef stock", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "water or 1 cup each water and rich veal or beef stock", "preparation": null, "optional": false}, {"position": 9, "raw": "1 cup dry red wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry red wine", "preparation": null, "optional": false}, {"position": 10, "raw": "Leaves from four sprigs fresh thyme", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "leaves from four sprigs fresh thyme", "preparation": null, "optional": false}, {"position": 11, "raw": "2 bay leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 12, "raw": "1 1-pint basket pearl onions, blanched and peeled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "1-pint basket pearl onions", "preparation": "blanched and peeled", "optional": false}, {"position": 13, "raw": "4 carrots, peeled and cut in 2-inch sticks ½-inch thick", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "carrots", "preparation": "peeled and cut in 2-inch sticks ½-inch thick", "optional": false}, {"position": 14, "raw": "1 small rutabaga, peeled and cut in 2-inch sticks ½-inch thick", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small rutabaga", "preparation": "peeled and cut in 2-inch sticks ½-inch thick", "optional": false}, {"position": 15, "raw": "4 parsnips, peeled and cut in 2-inch sticks ½-inch thick", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "parsnips", "preparation": "peeled a
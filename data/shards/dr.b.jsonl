roup": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "brown bean sauce (available in oriental groceries)", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup chicken stock or water", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chicken stock or water", "preparation": null, "optional": false}, {"position": 11, "raw": "½ teaspoon chili paste with garlic (available in oriental groceries)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "chili paste with garlic (available in oriental groceries)", "preparation": null, "optional": false}, {"position": 12, "raw": "Sesame oil for garnishing", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sesame oil for garnishing", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Trim the ends off the green beans and cut them in two, if large."}, {"position": 2, "text": "Mix the ground lamb with the cornstarch, soy sauce, sake, sugar, pepper and ½ teaspoon peanut oil."}, {"position": 3, "text": "Heat a wok or large skillet very hot, add 2 tablespoons peanut oil and stir-fry the beans for 3 or 4 minutes, or until they are dotted with browned spots. Add the bean sauce and stock, stir-fry for 1 minute, remove the mixture from the wok and reserve."}, {"position": 4, "text": "Heat the wok very hot again, add the remaining 2 tablespoons of oil and the lamb and stir-fry until it begins to brown lightly (1 to 2 minutes). Add the chili paste and stir-fry 30 seconds. Return the bean mixture to the wok and stir-fry 1 minute, or until the free juices have evaporated. Sprinkle lightly with sesame oil, mix well and serve over rice."}], "nutrition": {"calories": 565.6, "protein_g": 12.3, "carbohydrates_g": 9.9, "fat_g": 54.1, "saturated_fat_g": 12.0, "trans_fat_g": 0.0, "cholesterol_mg": 41.8, "sodium_mg": 134.9, "fiber_g": 3.3, "sugar_g": 4.2, "unsaturated_fat_g": 39.1, "source": "nyt", "ba
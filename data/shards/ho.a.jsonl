{"slug": "honey-cake", "nyt_id": 10005, "url": "https://cooking.nytimes.com/recipes/10005-honey-cake", "name": "Honey Cake", "author": "Colette Rossant", "description": "", "servings": {"text": "14 to 16 servings", "min": 14, "max": 16, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "PT2H"}}, "ingredients": [{"position": 1, "raw": "3 cups sifted all-purpose flour", "group": null, "quantity": 3.0, "unit": "cup", "item": "sifted all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "½ teasoon salt", "group": null, "quantity": 0.5, "unit": null, "item": "teasoon salt", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon cinnamon", "group": null, "quantity": 1.0, "unit": "tsp", "item": "cinnamon", "preparation": null, "optional": false}, {"position": 4, "raw": "⅛ teaspoon ground cloves", "group": null, "quantity": 0.125, "unit": "tsp", "item": "ground cloves", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon nutmeg", "group": null, "quantity": 0.5, "unit": "tsp", "item": "nutmeg", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon baking soda", "group": null, "quantity": 1.0, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 7, "raw": "2 cups honey", "group": null, "quantity": 2.0, "unit": "cup", "item": "honey", "preparation": null, "optional": false}, {"position": 8, "raw": "1 ½ cups orange juice", "group": null, "quantity": 1.5, "unit": "cup", "item": "orange juice", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup shelled white pistachio nuts", "group": null, "quantity": 0.5, "unit": "cup", "item": "shelled white pistachio nuts", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup shelled walnuts", "group": null, "quantity": 0.5, "unit": "cup", "item": "shelled walnuts", "preparation": null, "optional": false}, {"position": 11, "raw": "½ cup raisins", "group": null, "quantity": 0.5, "unit": "cup", "item": "raisins", "preparation": null, "optional": false}, {"position": 12, "raw": "½ cup dried apricots, cut in bite-size pieces", "group": null, "quantity": 0.5, "unit": "cup", "item": "dried apricots", "preparation": "cut in bite-size pieces", "optional": false}, {"position": 13, "raw": "1 teaspoon unsalted margarine for greasing the baking pans", "group": null, "quantity": 1.0, "unit": "tsp", "item": "unsalted margarine for greasing the baking pans", "preparation": null, "optional": false}, {"position": 14, "raw": "¼ cup slivered almonds", "group": null, "quantity": 0.25, "unit": "cup", "item": "slivered almonds", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 350 degrees."}, {"position": 2, "text": "In a large bowl, mix together all the dry ingredients. Set aside."}, {"position": 3, "text": "In another bowl, mix together the honey, orange juice, the nuts except the almonds and the dried fruits."}, {"position": 4, "text": "Add the orange juice-honey mixture to the flour. Mix well with a wooden spoon."}, {"position": 5, "text": "Grease two 9-by-5-inch loaf pans with the margarine. Divide the batter evenly between the two pans."}, {"position": 6, "text": "Sprinkle the almonds on top of the batter."}, {"position": 7, "text": "Reduce the oven temperature to 325 degrees and bake for one hour and 45 minutes. Test to see if the cake is done by inserting a skewer in the center. If it comes out dry, the cake is done."}, {"position": 8, "text": "Cool the cakes on a rack. Loosen the sides before unmolding."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 302.5625, "protein_g": 4.6, "carbohydrates_g": 63.4, "fat_g": 5.2, "saturated_fat_g": 0.6, "unsaturated_fat_g": 2.4, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 249.2, "fiber_g": 2.2, "sugar_g": 42.4, "computed_with": null}, "tags": {"cuisine": ["j
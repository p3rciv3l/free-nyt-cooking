alse}, {"position": 9, "raw": "2 teaspoons fresh rosemary leaves (or 1 teaspoon dried)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "fresh rosemary leaves (or 1 teaspoon dried)", "preparation": null, "optional": false}, {"position": 10, "raw": "1 cup dry white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup canned Italian plum tomatoes, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "canned italian plum tomatoes", "preparation": "chopped", "optional": false}, {"position": 12, "raw": "2 cups strong veal or chicken stock, preferably home made", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "strong veal or chicken stock", "preparation": "preferably home made", "optional": false}, {"position": 13, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Wipe veal shanks dry with paper towels and dredge lightly in flour. Heat olive oil in heavy skillet large enough to hold shanks in one layer. Brown on all sides and remove them."}, {"position": 2, "text": "Add garlic, orange peel, carrots, onions, coriander and rosemary to skillet. Saute, stirring frequently, until lightly browned. Deglaze with wine."}, {"position": 3, "text": "Return the shanks to the pan with tomatoes and chicken stock. Season with salt and pepper, then cover and simmer gently for an hour to an hour and a half. Serve with the risotta Milanese."}], "nutrition": null, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["fall", "saute", "veal"]}, "images": [], "rating": {"average": 4.0, "count": 61}, "video_url": null, "comment_count": null, "published_at": "1995-10-15", "scraped_at": "2026-09-07T07:39:40.148911+00:00", "scraper_version": "1.0.0"}
{"slug": "osso-buco-with-orange-herb-gremolata", "nyt_id": 1019008, "url": "https://cooking.nytimes.com/recipes/1019008-osso-buco-with-orange-herb-gremolata", "name": "Osso Buco With Orange-Herb Gremolata", "author": "Dorie Greenspan", "description": "Cross-cut veal shanks are the cut for osso buco, a braised dish. The sauce for my rendition is tomato-based, bolstered (subtly) by anchovies as well as white wine and broth. But it’s the addition of orange zest and oil-cured black olives that makes this a standout. Like most slow-cooked dishes, you can make this a few days ahead and it will only be better for the wait. The tradition is to serve the veal (you can use pork, if you prefer) with a last-minute dusting of gremolata, a mix, in this case, of basil, orange zest and garlic. Osso buco is good over rice, noodles or other grains; I like it over mashed potatoes or a smooth squash purée.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "PT2H"}}, "ingredients": [{"position": 1, "raw": "1 28-ounce can whole, peeled tomatoes, preferably imported", "group": null, "quantity": 29.0, "unit": null, "item": "ounce can whole", "preparation": "peeled tomatoes, preferably imported", "optional": false}, {"position": 2, "raw": "3 tablespoons canola oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "canola oil", "preparation": null, "optional": false}, {"position": 3, "raw": "6 cross-cut veal shanks or 12 pork ones, patted dry", "group": null, "quantity": 6.0, "unit": null, "item": "cross-cut veal shanks or 12 pork ones", "preparation": "patted dry", "optional": false}, {"position": 4, "raw": "Salt and freshly ground pepper", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "4 cloves garlic, finely chopped", "group": null, "quantity": 4.0, "unit": "clove", "item": "garlic", "preparation": "finely chopped", "optional": false}, {"position": 7, "raw": "2 carrots, thinly sliced", "group": null, "quantity": 2.0, "unit": null, "item": "carrots", "preparation": "thinly sliced", "optional": false}, {"position": 8, "raw": "1 large onion, finely chopped", "group": null, "quantity": 1.0, "unit": null, "item": "large onion", "preparation": "finely chopped", "optional": false}, {"position": 9, "raw": "3 sprigs thyme, leaves only", "group": null, "quantity": 3.0, "unit": "sprig", "item": "thyme", "preparation": "leaves only", "optional": false}, {"position": 10, "raw": "1 bay leaf", "group": null, "quantity": 1.0, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 11, "raw": "6 anchovy fillets", "group": null, "quantity": 6.0, "unit": null, "item": "anchovy fillets", "preparation": null, "optional": false}, {"position": 12, "raw": "1 cup dry white wine", "group": null, "quantity": 1.0, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 13, "raw": "1 cup chicken broth", "group": null, "quantity": 1.0, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 14, "raw": "¾ cup oil-cured black olives, pitted", "group": null, "quantity": 0.75, "unit": "cup", "item": "oil-cured black olives", "preparation": "pitted", "optional": false}, {"position": 15, "raw": "4 wide strips orange (or lemon) zest", "group": null, "quantity": 4.0, "unit": null, "item": "wide strips orange zest", "preparation": null, "optional": false}, {"position": 16, "raw": "Pinch red-pepper flakes", "group": null, "quantity": null, "unit": null, "item": "pinch red-pepper flakes", "preparation": null, "optional": false}, {"position": 17, "raw": "Rind of 1 orange (or lemon), finely chopped", "group": null, "quantity": null, "unit": null, "item": "rind of 1 orange", "preparation": "finely chopped", "optional": false}, {"position": 18, "raw": "¼ cup basil leaves, finely chopped", "group": null, "quantity": 0.25, "unit": "cup", "item": "basil leaves", "preparation": "finely chopped", "optional": false}, {"position": 19, "raw": "1 clove garlic, finely chopped", "group": null, "quantity": 1.0, "unit": "clove", "item": "garlic", "preparation": "finely chopped", "optional": false}, {"position": 20, "raw": "Coarse salt and freshly ground black pepper", "group": null, "quantity": null, "unit": null, "item": "coarse salt and freshly ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Center a rack in the oven, and heat it to 350 degrees. Cut the tomatoes into pieces, and reserve the juice; set aside."}, {"position": 2, "text": "Heat the canola oil in a Dutch oven (or other large pot) over medium heat, and working in batches, brown the meat on all sides, about 10 minutes. Season with salt and pepper and transfer to a bowl as the pieces are browned. Discard the oil."}, {"position": 3, "text": "Add the olive oil, garlic, carrots, onion and herbs to the pot. Season with salt, and cook over low heat, stirring, until the vegetables are soft but not colored, 10 to 15 minutes. Stir in the anchovies, and cook a minute or two, until they dissolve. Increase the heat, add the wine and boil until almost evaporated. Stir in the broth, tomatoes with their liquid, olives, zest and pepper flakes. Return the meat, submerging as much of it as possible. Seal the pot with foil, and cover with the lid. Slide the pot into the oven."}, {"position": 4, "text": "Braise for 1 ½ hours — if the meat is falling off the bone, it’s done; if it’s not, give it another 30 minutes or so."}, {"position": 5, "text": "@type"}, {"position": 6, "text": "text"}, {"position": 7, "text": "url"}, {"position": 8, "text": "@type"}, {"position": 9, "text": "text"}, {"position": 10, "text": "url"}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 809.5, "protein_g": 100.9, "carbohydrates_g": 19.5, "fat_g": 32.2, "saturated_fat_g": 7.2, "unsaturated_fat_g": 4.8, "trans_fat_g": null, "cholesterol_mg": 379.6, "sodium_mg": 1912.3, "fiber_g": 6.0, "sugar_g": 8.6, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course-meat"], "meal": [], "occasion": [], "other": ["dry-white-wine", "orange", "tomato", "veal"]}, "images": [{"url": "https://static01.nyt.com/images/2017/10/29/magazine/29Paris-recipes3/29Paris-recipes3-videoSixteenByNineJumbo1600.jpg", "alt": "Osso buco with orange-herb gremolata", "primary": true}, {"url": "https://static01.nyt.com/images/2017/10/29/magazine/29Paris-recipes3/29Paris-recipes3-superJumbo-v3.jpg", "alt": "Osso buco with orange-herb gremolata", "primary": false}, {"url": "https://static01.nyt.com/images/2017/10/29/magazine/29Paris-recipes3/29Paris-recipes3-facebookJumbo.jpg", "alt": "Osso buco with orange-herb gremolata", "primary": false}], "rating": {"average": 4.0, "count": 274}, "video_url": null, "comment_count": null, "published_at": "2017-10-29", "scraped_at": "2026-09-07T04:26:15Z", "scraper_version": "1.0.0"}
{"slug": "osso-buco-with-peas-and-gremolada", "nyt_id": 6977, "url": "https://cooking.nytimes.com/recipes/6977-osso-buco-with-peas-and-gremolada", "name": "Osso Buco With Peas and Gremolada", "author": "Molly O’Neill", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 180, "raw": {"total": "About 3 hours"}}, "ingredients": [{"position": 1, "raw": "6 tablespoons butter", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 2, "raw": "3 carrots, peeled and finely chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "carrots", "preparation": "peeled and finely chopped", "optional": false}, {"position": 3, "raw": "2 stalks celery, finely chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "stalk", "item": "celery", "preparation": "finely chopped", "optional": false}, {"position": 4, "raw": "1 large red onion, peeled and finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large red onion", "preparation": "peeled and finely chopped", "optional": false}, {"position": 5, "raw": "1 teaspoon minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ pound pancetta or prosciutto, diced", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "pancetta or prosciutto", "preparation": "diced", "optional": false}, {"position": 7, "raw": "1 28-ounce can tomatoes, drained and chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "28-ounce can tomatoes", "preparation": "drained and chopped", "optional": false}, {"position": 8, "raw": "6 veal shanks, each about 2 ½ inches thick and tied with string", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "veal shanks", "preparation": "each about 2 ½ inches thick and tied with string", "optional": false}, {"position": 9, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "All-purpose flour for dusting meat", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "all-purpose flour for dusting meat", "preparation": null, "optional": false}, {"position": 11, "raw": "6 tablespoons olive oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 12, "raw": "1 cup dry white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 13, "raw": "2 cups beef stock", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "beef stock", "preparation": null, "optional": false}, {"position": 14, "raw": "1 cup fresh shelled peas", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh shelled peas", "preparation": null, "optional": false}, {"position": 15, "raw": "3 tablespoons finely chopped parsley", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped parsley", "preparation": null, "optional": false}, {"position": 16, "raw": "1 tablespoon grated lemon zest", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "grated lemon zest", "preparation": null, "optional": false}, {"position": 17, "raw": "1 teaspoon minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "minced garlic", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large casserole or Dutch oven with a tightly fitting lid, melt the butter over medium heat. Add the carrots, celery, onion, garlic and pancetta or prosciutto and cook, stirring frequently until the vegetables are tender, about 10 minutes. Add the tomatoes, raise the heat to high and cook, stirring constantly, until most of the liquid has evaporated, about 3 to 4 minutes. Remove from the heat."}, {"position": 2, "text": "Season the veal generously with salt and pepper and dust it with flour, shaking off any excess. Place a large skillet over medium-high heat and add the oil. When very hot, add the veal and brown it on all sides. (You may need to work in two batches.)"}, {"position": 3, "text": "Place the browned veal on top of the vegetables in the casserole. Pour out any excess oil from the skillet and add the wine. Return the skillet to the heat and simmer the wine until it is reduced to ⅓ cup. Add the stock to the skillet and pour the mixture into the casserole."}, {"position": 4, "text": "Cover the casserole and bring to a simmer over medium-high heat. Adjust the heat and simmer gently until the veal is very tender, about 2 hours."}, {"position": 5, "text": "Remove the meat from the casserole and let rest on a platter. Pass the sauce remaining in the casserole through a food mill, discarding the solids. Wipe out the casserole, return the meat to it and pour the sauce over the meat. Simmer, uncovered, for an additional 15 minutes. Season to taste with salt and pepper."}, {"position": 6, "text": "Meanwhile, cook the peas in salted, boiling water until just tender, about 3 minutes. Drain and set aside. Make the gremolada by combining the parsley, zest and garlic. Set aside."}, {"position": 7, "text": "Remove the meat from the casserole, transfer to a deep serving platter and remove the strings. Pour the sauce over the meat and garnish it with the peas and gremolada. Serve immediately with rice on the side."}], "nutrition": {"calories": 1006.7, "protein_g": 104.6, "carbohydrates_g": 24.2, "fat_g": 50.2, "saturated_fat_g": 16.9, "trans_fat_g": 0.0, "cholesterol_mg": 418.0, "sodium_mg": 2106.1, "fiber_g": 6.5, "sugar_g": 8.4, "unsaturated_fat_g": 27.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [], "rating": {"average": 4.0, "count": 19}, "video_url": null, "comment_count": null, "published_at": "1998-10-18", "scraped_at": "2026-09-07T08:47:03.035820+00:00", "scraper_version": "1.0.0"}

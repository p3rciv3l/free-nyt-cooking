{"slug": "osso-buco-with-lemon-and-sage", "nyt_id": 9406, "url": "https://cooking.nytimes.com/recipes/9406-osso-buco-with-lemon-and-sage", "name": "Osso Buco With Lemon and Sage", "author": "Moira Hodgson", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 150, "total_minutes": 150, "raw": {"cook": "2 hours 30 minutes", "total": "2 hours 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 onion, sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "onion", "preparation": "sliced", "optional": false}, {"position": 2, "raw": "4 tablespoons of vegetable oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "of vegetable oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "2 strips lemon peel", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "strips lemon peel", "preparation": null, "optional": false}, {"position": 5, "raw": "2 veal shanks, sawed into eight pieces 1 ½ inches thick", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "veal shanks", "preparation": "sawed into eight pieces 1 ½ inches thick", "optional": false}, {"position": 6, "raw": "Flour for dredging", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "flour for dredging", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup dry white wine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 8, "raw": "2 cups beef stock", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "beef stock", "preparation": null, "optional": false}, {"position": 9, "raw": "2 cups canned Italian plum tomatoes, with their juice, chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "canned italian plum tomatoes", "preparation": "with their juice, chopped", "optional": false}, {"position": 10, "raw": "1 tablespoon fresh sage leaves (or 1 teaspoon dried)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh sage leaves (or 1 teaspoon dried)", "preparation": null, "optional": false}, {"position": 11, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon parsley, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "parsley", "preparation": "minced", "optional": false}], "steps": [{"position": 1, "text": "In a heavy casserole, soften the onion in two tablespoons of vegetable oil. Add the garlic and lemon peel and cook for two to three minutes."}, {"position": 2, "text": "Meanwhile, dredge the veal shanks in flour, heat the remaining oil in a frying pan and saute the shanks a few at a time until they are lightly browned on all sides. Add them to the casserole."}, {"position": 3, "text": "Pour the fat from the skillet. Add the white wine and scrape up the coagulated cooking juices. Add the stock, tomatoes, sage, salt and pepper. The liquid should cover the veal. If it does not, add more stock."}, {"position": 4, "text": "Cover the casserole and simmer over low heat for two hours, or until the veal is very tender. If there is too little liquid during cooking time, add more. If there is too much, when the shanks are done remove them to a heated serving dish. Bring the liquid to boil over high heat until it has reduced and thickened. Pour it over the shanks. Sprinkle with parsley."}], "nutrition": {"calories": 352.4, "protein_g": 35.0, "carbohydrates_g": 10.6, "fat_g": 15.6, "saturated_fat_g": 2.5, "unsaturated_fat_g": null, "trans_fat_g": 0.1, "cholesterol_mg": 125.0, "sodium_mg": 872.3, "fiber_g": 2.1, "sugar_g": 3.1, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["dinner", "lemon", "sage", "saute", "veal"]}, "images": [], "rating": {"average": 4.0, "count": 51}, "video_url": null, "comment_count": null, "published_at": "1995-02-26", "scraped_at": "2026-09-07T11:25:35.410608+00:00", "scraper_version": "1.0.0"}

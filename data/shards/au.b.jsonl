{"slug": "auberge-de-la-madones-beef-stew-with-wild-mushrooms-and-orange", "nyt_id": 5571, "url": "https://cooking.nytimes.com/recipes/5571-auberge-de-la-madones-beef-stew-with-wild-mushrooms-and-orange", "name": "Auberge de la Madone's Beef Stew With Wild Mushrooms and Orange", "author": "Molly O’Neill", "description": "Molly O'Neill", "servings": {"text": "Eight servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 255, "raw": {"total": "4 hours 15 minutes, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "4 ½ pounds stewing beef, preferably a combination of beef round and beef chuck, cut into very large pieces, about 4 ounces each", "group": null, "quantity": 4.5, "quantity_max": null, "unit": "lb", "item": "stewing beef", "preparation": "preferably a combination of beef round and beef chuck, cut into very large pieces, about 4 ounces each", "optional": false}, {"position": 2, "raw": "4 carrots, peeled and cut into rounds", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "carrots", "preparation": "peeled and cut into rounds", "optional": false}, {"position": 3, "raw": "3 medium onions, peeled and coarsely chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "medium onions", "preparation": "peeled and coarsely chopped", "optional": false}, {"position": 4, "raw": "2 cloves garlic, peeled", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "1 sprig fresh parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "fresh parsley", "preparation": null, "optional": false}, {"position": 6, "raw": "1 rib celery, thickly sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "rib celery", "preparation": "thickly sliced", "optional": false}, {"position": 7, "raw": "3 imported bay leaves", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "imported bay leaves", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon fresh thyme or 1 teaspoonteaspoon dried", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh thyme or 1 teaspoonteaspoon dried", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup marc de Provence or Cognac", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "marc de provence or cognac", "preparation": null, "optional": false}, {"position": 10, "raw": "5 ½ cups sturdy red wine, like Cotes de Provence", "group": null, "quantity": 5.5, "quantity_max": null, "unit": "cup", "item": "sturdy red wine", "preparation": "like Cotes de Provence", "optional": false}, {"position": 11, "raw": "5 tablespoons extra-virgin olive oil", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 12, "raw": "1 teaspoon whole black peppercorns", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "whole black peppercorns", "preparation": null, "optional": false}, {"position": 13, "raw": "3 whole cloves", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "whole cloves", "preparation": null, "optional": false}, {"position": 14, "raw": "1 tablespoon tomato paste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 15, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 16, "raw": "1 pound fresh wild cepe mushrooms or cultivated mushrooms, trimmed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fresh wild cepe mushrooms or cultivated mushrooms", "preparation": "trimmed", "optional": false}, {"position": 17, "raw": "Kosher salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 18, "raw": "Grated zest and juice of 1 orange", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated zest and juice of 1 orange", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "The day before serving the stew, combine the meat, carrots, onions, garlic, parsley, celery, bay leaves, thyme, marc, 3 ½ cups of red wine and 1 tablespoon of olive oil in a large nonreactive bowl. Tie the peppercorns and cloves in a piece of cheesecloth, add to the bowl and toss the ingredients well. Cover and refrigerate for 24 hours, stirring once or twice."}, {"position": 2, "text": "Let meat and vegetables return to room temperature. With a slotted spoon, remove the meat from the marinade. Drain well and pat dry on paper towels. Set aside. Strain the liquid into a large nonreactive heatproof casserole and add the cheesecloth bag. Set the vegetables aside."}, {"position": 3, "text": "Add the remaining 2 cups of wine to the pot and bring the liquid to a boil. Boil for 5 minutes to reduce slightly. Remove from the heat, stir in the tomato paste and set aside."}, {"position": 4, "text": "In a large skillet, melt 1 tablespoon of butter in 2 tablespoons of the olive oil over high heat. When hot, add the beef in batches, sauteing until browned all over, about 5 minutes per batch. Transfer when browned to the liquid in the casserole."}, {"position": 5, "text": "Add the remaining butter and olive oil to the skillet. Add the reserved vegetables and saute until browned, about 7 minutes. Transfer the vegetables to the casserole. Add the mushrooms to the skillet and saute until lightly browned, about 5 minutes. Set aside."}, {"position": 6, "text": "Bring the liquid in the casserole to a simmer over medium-low heat. Reduce the heat to very low and simmer, skimming occasionally, until the meat is very tender, about 3 ½ to 4 hours. Stir in salt and pepper to taste, the mushrooms and the orange zest and juice. Discard the cheesecloth bag with the peppercorns and cloves and the bay leaves. (The recipe can be prepared 2 to 3 days ahead and refrigerated. Reheat before serving.) Serve with potatoes, rice or pasta."}], "nutrition": {"calories": 797.1, "protein_g": 68.3, "carbohydrates_g": 17.3, "fat_g": 34.7, "saturated_fat_g": 12.1, "trans_fat_g": 0.1, "cholesterol_mg": 210.5, "sodium_mg": 1474.1, "fiber_g": 3.4, "sugar_g": 7.2, "unsaturated_fat_g": 19.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["beef stew meat", "braise", "great leftovers", "saute", "stew"]}, "images": [], "rating": {"average": 4.0, "count": 63}, "video_url": null, "comment_count": null, "published_at": "1996-01-14", "scraped_at": "2026-09-07T00:45:14.438757+00:00", "scraper_version": "1.0.0"}
{"slug": "aushak-scallion-dumplings", "nyt_id": 11364, "url": "https://cooking.nytimes.com/recipes/11364-aushak-scallion-dumplings", "name": "Aushak (Scallion dumplings)", "author": "Craig Claiborne", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "About 30 minutes"}}, "ingredients": [{"position": 1, "raw": "20 scallions or green onions, about ⅓ pound", "group": null, "quantity": 20.0, "quantity_max": null, "unit": null, "item": "scallions or green onions", "preparation": "about ⅓ pound", "optional": false}, {"position": 2, "raw": "Salt to taste if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste if desired", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ teaspoon ground black pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "ground black pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ teaspoon garlic powder", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "garlic powder", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablepoons corn, peanut or vegetable oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "tablepoons corn", "preparation": "peanut or vegetable oil", "optional": false}, {"position": 6, "raw": "32 prepared round, raw dumpling (gyoza) skins, each about 3 ½ inches in diameter, available in Chinese markets and specialty shops", "group": null, "quantity": 32.0, "quantity_max": null, "unit": null, "item": "prepared round", "preparation": "raw dumpling (gyoza) skins, each about 3 ½ inches in diameter, available in Chinese markets and specialty shops", "optional": false}, {"position": 7, "raw": "1 cup yogurt and garlic sauce (see recipe)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "yogurt and garlic sauce (see recipe)", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons finely crumbled dried mint", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "finely crumbled dried mint", "preparation": null, "optional": false}, {"position": 9, "raw": "2 cups meat sauce (see recipe)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "meat sauce (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Cut off white portion of onions and put to another use, such as in salads, if desired. Chop green tops finely; there should be about 2 cups. Put in a bowl."}, {"position": 2, "text": "Add salt, pepper, garlic powder and oil. Blend well."}, {"position": 3, "text": "Lay out dumpling skins, one at a time, on a flat surface. Rub perimeter of each with water. Spoon equal portions of scallion mixture in center of each and fold over skins in a half-moon shape. Press to seal."}, {"position": 4, "text": "Bring about three quarts water to a boil in a kettle and add salt to taste. Add filled dumplings and cook until tender, about 5 minutes. Drain thoroughly."}, {"position": 5, "text": "Spoon about ¼ cup of yogurt and garlic sauce over bottom of a serving dish. Cover with a layer of hot dumplings. Spoon remaining yogurt sauce over dumplings. Sprinkle with mint. Spoon hot meat sauce over all and serve immediately."}], "nutrition": {"calories": 288.1, "protein_g": 21.6, "carbohydrates_g": 24.3, "fat_g": 12.8, "saturated_fat_g": 3.2, "trans_fat_g": 0.2, "cholesterol_mg": 52.8, "sodium_mg": 582.0, "fiber_g": 2.8, "sugar_g": 4.8, "unsaturated_fat_g": 9.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["middle eastern"], "diet": [], "course": ["appetizer", "side dish"], "meal": [], "occasion": [], "other": ["boil", "project", "scallion"]}, "images": [], "rating": {"average": 4.0, "count": 20}, "video_url": null, "comment_count": null, "published_at": "1986-02-26", "scraped_at": "2026-09-07T02:15:53.875803+00:00", "scraper_version": "1.0.0"}

{"slug": "snapper-with-seville-orange-juice-pine-nuts-and-olives", "nyt_id": 11502, "url": "https://cooking.nytimes.com/recipes/11502-snapper-with-seville-orange-juice-pine-nuts-and-olives", "name": "Snapper With Seville Orange Juice, Pine Nuts And Olives", "author": "Nigella Lawson", "description": "", "servings": {"text": "2 to 3 servings", "min": 2, "max": 3, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 50, "raw": {"total": "50 minutes"}}, "ingredients": [{"position": 1, "raw": "1 teaspoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 2 ½- to 3-pound whole snapper, cleaned and scaled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "2 ½- to 3-pound whole snapper", "preparation": "cleaned and scaled", "optional": false}, {"position": 3, "raw": "1 teaspoon black peppercorns", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "black peppercorns", "preparation": null, "optional": false}, {"position": 4, "raw": "5 bay leaves", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 5, "raw": "1 large strip Seville orange zest or 1 strip orange zest and 1 strip lime zest", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large strip seville orange zest or 1 strip orange zest and 1 strip lime zest", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup Seville orange juice or ¾ cup orange juice and ¼ cup lime juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "seville orange juice or ¾ cup orange juice and ¼ cup lime juice", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup pitted calamata olives, halved lengthwise", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "pitted calamata olives", "preparation": "halved lengthwise", "optional": false}, {"position": 9, "raw": "¼ cup pine nuts", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "pine nuts", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup chopped parsley leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped parsley leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 400 degrees. Oil a piece of foil large enough to wrap fish in. Place fish in middle of foil, and fill its cavity with peppercorns, 4 bay leaves and Seville orange zest (or orange and lime zest)."}, {"position": 2, "text": "Sprinkle fish with salt and fold two sides of foil together, sealing with a pleat. Fold other two sides in to enclose fish; place on a baking sheet with folds up. Bake 45 minutes."}, {"position": 3, "text": "About 15 minutes before fish is ready, place Seville orange juice (or orange and lime juice) in a small saucepan. Add remaining bay leaf, olives and pine nuts. Place over high heat to bring to a boil, then reduce heat to low. Simmer uncovered for 5 minutes. Remove from heat, cover and keep warm."}, {"position": 4, "text": "To serve, open foil and peel away skin from top of fish. Carefully remove top fillets and place on warm serving plates. Lift bone from tail end, and place bottom fillets on plates, leaving skin behind. Top each serving with a spoonful of orange sauce and a sprinkling of parsley. Pass remaining sauce at table."}], "nutrition": {"calories": 581.5, "protein_g": 88.0, "carbohydrates_g": 15.1, "fat_g": 17.5, "saturated_fat_g": 2.5, "trans_fat_g": 0.0, "cholesterol_mg": 153.8, "sodium_mg": 823.5, "fiber_g": 1.9, "sugar_g": 7.8, "unsatu
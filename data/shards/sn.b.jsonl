n": null, "optional": false}, {"position": 9, "raw": "1 small (about ¾ pound) jicama, peeled and cut into 2-inch matchsticks", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small (about ¾ pound) jicama", "preparation": "peeled and cut into 2-inch matchsticks", "optional": false}, {"position": 10, "raw": "1 ½ cups mung-bean sprouts", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "mung-bean sprouts", "preparation": null, "optional": false}, {"position": 11, "raw": "18 large sea scallops (about 1 ½ pounds), sliced in half and patted dry", "group": null, "quantity": 18.0, "quantity_max": null, "unit": null, "item": "large sea scallops (about 1 ½ pounds)", "preparation": "sliced in half and patted dry", "optional": false}, {"position": 12, "raw": "1 teaspoon kosher salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 14, "raw": "Thinly sliced basil leaves for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "thinly sliced basil leaves for garnish", "preparation": null, "optional": false}, {"position": 15, "raw": "Thinly sliced mint leaves for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "thinly sliced mint leaves for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the vinaigrette, combine the basil, mint and lime juice in a blender and process, stopping twice to scrape down the sides, until combined. With the blender running, slowly pour in the olive oil. Add the sugar, salt and pepper."}, {"position": 2, "text": "To make the salad, bring a large saucepan that is ⅔ full of salted water to a boil.
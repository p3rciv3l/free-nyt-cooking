{"slug": "snapper-with-sage-marie", "nyt_id": 1738, "url": "https://cooking.nytimes.com/recipes/1738-snapper-with-sage-marie", "name": "Snapper With Sage Marie", "author": "Jonathan Reynolds", "description": "Jonathan Reynolds", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "¼ cup chopped fresh sage leaves plus extra for garnish", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped fresh sage leaves plus extra for garnish", "preparation": null, "optional": false}, {"position": 2, "raw": "3 tablespoons fresh lemon juice plus extra to taste", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice plus extra to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon Vietnamese or Thai fish sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "vietnamese or thai fish sauce", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup fresh morels (2 ounces)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh morels (2 ounces)", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons butter", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups half-and-half", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "half-and-half", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "4 red snapper fillets, with skin on", "group": null, "quantity": 4.0, "quantity_max": nu
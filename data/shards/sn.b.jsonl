n": null, "optional": false}, {"position": 9, "raw": "1 small (about ¾ pound) jicama, peeled and cut into 2-inch matchsticks", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small (about ¾ pound) jicama", "preparation": "peeled and cut into 2-inch matchsticks", "optional": false}, {"position": 10, "raw": "1 ½ cups mung-bean sprouts", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "mung-bean sprouts", "preparation": null, "optional": false}, {"position": 11, "raw": "18 large sea scallops (about 1 ½ pounds), sliced in half and patted dry", "group": null, "quantity": 18.0, "quantity_max": null, "unit": null, "item": "large sea scallops (about 1 ½ pounds)", "preparation": "sliced in half and patted dry", "optional": false}, {"position": 12, "raw": "1 teaspoon kosher salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 14, "raw": "Thinly sliced basil leaves for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "thinly sliced basil leaves for garnish", "preparation": null, "optional": false}, {"position": 15, "raw": "Thinly sliced mint leaves for garnish", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "thinly sliced mint leaves for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the vinaigrette, combine the basil, mint and lime juice in a blender and process, stopping twice to scrape down the sides, until combined. With the blender running, slowly pour in the olive oil. Add the sugar, salt and pepper."}, {"position": 2, "text": "To make the salad, bring a large saucepan that is ⅔ full of salted water to a boil. Add the snap peas and cook until they just begin to soften, about 2 minutes. Drain and immediately plunge the peas into cold water to stop the cooking. When cool, drain again and combine with the jicama and mung-bean sprouts."}, {"position": 3, "text": "Sprinkle the scallops with 1 teaspoon salt. Melt the butter in a heavy skillet over high heat. Sear the scallops until they are browned and just cooked through, about 1 ½ minutes per side."}, {"position": 4, "text": "Toss the salad with half of the dressing and transfer it to a serving platter or individual serving plates. Top the salad with the scallops, then drizzle both the scallops and the salad with the remaining vinaigrette and sprinkle with the mint and basil."}], "nutrition": {"calories": 359.3, "protein_g": 17.7, "carbohydrates_g": 22.4, "fat_g": 22.8, "saturated_fat_g": 5.1, "trans_fat_g": 0.0, "cholesterol_mg": 37.4, "sodium_mg": 847.1, "fiber_g": 9.0, "sugar_g": 5.9, "unsaturated_fat_g": 16.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["saute", "scallop", "summer", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 15}, "video_url": null, "comment_count": null, "published_at": "1999-07-11", "scraped_at": "2026-09-07T01:05:00.399372+00:00", "scraper_version": "1.0.0"}
{"slug": "snap-peas-and-shiitake-mushrooms-in-scallion-crepes-with-lemon-zest", "nyt_id": 7612, "url": "https://cooking.nytimes.com/recipes/7612-snap-peas-and-shiitake-mushrooms-in-scallion-crepes-with-lemon-zest", "name": "Snap Peas and Shiitake Mushrooms In Scallion Crepes With Lemon Zest", "author": "Molly O’Neill", "description": "", "servings": {"text": "About 4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 165, "raw": {"total": "2 hours 45 minutes"}}, "ingredients": [{"position": 1, "raw": "8 whole scallions, plus 1 scallion sliced as thinly as possible", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "whole scallions", "preparation": "plus 1 scallion sliced as thinly as possible", "optional": false}, {"position": 2, "raw": "½ cup milk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 3, "raw": "2 large eggs, lightly beaten", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "lightly beaten", "optional": false}, {"position": 4, "raw": "1 cup sifted all-purpose flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sifted all-purpose flour", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons melted unsalted butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "melted unsalted butter", "preparation": null, "optional": false}, {"position": 7, "raw": "Grated zest of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "grated zest of 1 lemon", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup extra-virgin olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 9, "raw": "½ pound sugar snap peas, trimmed and strings removed, cut on bias into ½-inch pieces (about 2 cups)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "sugar snap peas", "preparation": "trimmed and strings removed, cut on bias into ½-inch pieces (about 2 cups)", "optional": false}, {"position": 10, "raw": "½ pound shiitake mushrooms, stems discarded, tops cut into ¼-inch slices", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "shiitake mushrooms", "preparation": "stems discarded, tops cut into ¼-inch slices", "optional": false}, {"position": 11, "raw": "Juice of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1 lemon", "preparation": null, "optional": false}, {"position": 12, "raw": "Zest of ½ lemon, cut into very thin strips", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "zest of ½ lemon", "preparation": "cut into very thin strips", "optional": false}, {"position": 13, "raw": "Kosher salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the crepes, pass the 8 whole scallions one at a time through a juicer, then run the milk through the juicer to extract all the juice. Whisk the eggs into the mixture. Combine the flour and salt in a medium bowl. Pouring in a thin, steady stream, slowly whisk the scallion-and-milk mixture into the flour, and keep on whisking until the batter is very smooth. Whisk in the butter, the lemon zest, the thinly sliced scallion and 5 tablespoons of water. Allow the batter to rest at room temperature for at least half an hour and preferably for 2 hours."}, {"position": 2, "text": "To make the filling, heat the olive oil in a medium skillet set over high heat until it just starts to smoke. Add the peas and quickly saute them until lightly browned, 1 to 2 minutes. With a slotted spoon, transfer the peas to a bowl. Add the mushrooms to the skillet, reduce the heat to medium and cook, stirring occasionally, until they are soft and lightly browned, about 8 minutes. Transfer to the bowl with the peas."}, {"position": 3, "text": "Return the skillet to high heat and then add ¼cup water, the lemon juice and lemon zest to the pan. Cook, scraping the bottom of the pan, until the liquid is reduced to about 2 tablespoons. Pour the liquid over the mushrooms and peas, toss them and season to taste with salt."}, {"position": 4, "text": "When ready to serve, heat an 8-inch crepe or omelet pan over medium high heat. Brush the bottom of the pan with a little olive oil and coat it with crepe batter (tilt the pan to make the crepes as thin as possible). Turn the crepe almost immediately and cook the other side until lightly browned. Then transfer to a plate and repeat until all the batter is used, placing the cooked crepes between layers of wax paper."}, {"position": 5, "text": "Place about ¼ cup of the mushroom-pea mixture (rewarm it if necessary) on each crepe and carefully roll them up. Serve immediately."}], "nutrition": {"calories": 403.4, "protein_g": 11.2, "carbohydrates_g": 40.2, "fat_g": 23.5, "saturated_fat_g": 6.9, "trans_fat_g": 0.0, "cholesterol_mg": 111.3, "sodium_mg": 690.2, "fiber_g": 5.8, "sugar_g": 7.1, "unsaturated_fat_g": 15.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["mushroom", "project", "saute", "spring"]}, "images": [], "rating": {"average": 4.0, "count": 7}, "video_url": null, "comment_count": null, "published_at": "1999-07-11", "scraped_at": "2026-09-07T01:05:03.715405+00:00", "scraper_version": "1.0.0"}

{"slug": "caprese-salad-with-blueberry-croutons", "nyt_id": 11302, "url": "https://cooking.nytimes.com/recipes/11302-caprese-salad-with-blueberry-croutons", "name": "Caprese Salad With Blueberry Croutons", "author": "Jonathan Reynolds", "description": "Jonathan Reynolds", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ cups blueberries", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "blueberries", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup all-purpose flour", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 3, "raw": "2 large eggs, lightly beaten", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "lightly beaten", "optional": false}, {"position": 4, "raw": "1 ½ cups crushed cornflakes (done gently in a coffee grinder or food processor)", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "crushed cornflakes (done gently in a coffee grinder or food processor)", "preparation": null, "optional": false}, {"position": 5, "raw": "2 ½ tablespoons canola oil", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "tbsp", "item": "canola oil", "preparation": null, "optional": false}, {"position": 6, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons balsamic vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "2 large ripe heirloom tomatoes, sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large ripe heirloom tomatoes", "preparation": "sliced", "optional": false}, {"position": 9, "raw": "12 ounces fresh mozzarella, sliced", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "fresh mozzarella", "preparation": "sliced", "optional": false}, {"position": 10, "raw": "6 basil leaves, cut into thin strips", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "basil leaves", "preparation": "cut into thin strips", "optional": false}], "steps": [{"position": 1, "text": "Rinse the blueberries, shaking off excess water but keeping them slightly wet. Dip them in the flour and shake off excess. Using a slotted spoon, dip the berries in the egg and drain. Roll them in the cornflakes, coating them completely."}, {"position": 2, "text": "Heat the canola oil in a very large skillet over medium heat. Add the berries and sauté until brown and crisp, gently shaking the pan to brown them evenly."}, {"position": 3, "text": "While the berries are sautéing, whisk the olive oil and balsamic vinegar together. On a platter, alternate slices of tomato and mozzarella. Drizzle with the vinaigrette. Place hot blueberries around the platter. Garnish with basil leaves and serve immediately."}], "nutrition": {"calories": 750.3, "protein_g": 27.2, "carbohydrates_g": 47.3, "fat_g": 50.9, "saturated_fat_g": 16.1, "trans_fat_g": 0.0, "cholesterol_mg": 160.2, "sodium_mg": 532.7, "fiber_g": 3.5, "sugar_g": 9.9, "unsaturated_fat_g": 32.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["blueberry", "easy", "quick", "salad", "saute", "summer", "tomato"]}, "images": [], "rating": {"average": 3.0, "count": 22}, "video_url": null, "comment_count": null, "published_at": "2004-08-22", "scraped_at": "2026-09-06T23:02:33.159254+00:00", "scraper_version": "1.0.0"}
{"slug": "cardamom-ice-cream", "nyt_id": 10423, "url": "https://cooking.nytimes.com/recipes/10423-cardamom-ice-cream", "name": "Cardamom Ice Cream", "author": "William Grimes", "description": "William Grimes", "servings": {"text": "2 quarts", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes, plus 1/2 hour for freezing"}}, "ingredients": [{"position": 1, "raw": "3 ½ cups heavy cream", "group": null, "quantity": 3.5, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ cups milk", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "4 tablespoons cardamom pods, lightly crushed", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "cardamom pods", "preparation": "lightly crushed", "optional": false}, {"position": 5, "raw": "12 large egg yolks", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "large egg yolks", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large heavy-bottomed saucepan, combine the heavy cream, milk and ½ cup of the sugar. Bring to a boil, and immediately remove from heat. Add crushed cardamom pods, cover and allow to steep for 20 minutes. Pour through a fine strainer into a clean saucepan, and discard the contents of the strainer."}, {"position": 2, "text": "In a large mixing bowl, combine yolks with remaining ½ cup of sugar. Whisk until blended. Place milk mixture over medium heat, and bring to a boil. Gradually mix 2 cups of the hot liquid into eggs, then pour egg mixture into saucepan of boiling milk. Whip constantly until thick and creamy, about 3 to 4 minutes."}, {"position": 3, "text": "Remove saucepan from heat, and strain contents into a mixing bowl. Place bowl in a container of ice water to cool. When ice cream base has chilled, freeze in an ice cream maker, according to manufacturer's instructions."}], "nutrition": {"calories": 284.9, "protein_g": 4.4, "carbohydrates_g": 16.5, "fat_g": 23.0, "saturated_fat_g": 13.6, "trans_fat_g": 0.6, "cholesterol_mg": 198.8, "sodium_mg": 30.4, "fiber_g": 0.4, "sugar_g": 15.2, "unsaturated_fat_g": 7.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["boil", "cardamom", "five ingredient", "ice creams and sorbets"]}, "images": [], "rating": {"average": 4.0, "count": 78}, "video_url": null, "comment_count": null, "published_at": "1998-08-05", "scraped_at": "2026-09-06T22:22:07.300551+00:00", "scraper_version": "1.0.0"}

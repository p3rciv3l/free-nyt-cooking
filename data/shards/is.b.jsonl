{"slug": "israeli-couscous-and-chickpea-salad", "nyt_id": 12275, "url": "https://cooking.nytimes.com/recipes/12275-israeli-couscous-and-chickpea-salad", "name": "Israeli Couscous and Chickpea Salad", "author": "Martha Rose Shulman", "description": "You can find a whole-wheat version of the spherical couscous marketed as Israeli couscous in some whole foods and Middle Eastern markets.", "servings": {"text": "3 to 4 generous servings.", "min": 3, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup Israeli couscous, preferably whole-wheat", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "israeli couscous", "preparation": "preferably whole-wheat", "optional": false}, {"position": 2, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup finely chopped cilantro", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "finely chopped cilantro", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons chopped chives", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped chives", "preparation": null, "optional": false}, {"position": 5, "raw": "1 ounce feta, diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "oz", "item": "feta", "preparation": "diced", "optional": false}, {"position": 6, "raw": "2 tablespoons pine nuts, lightly toasted", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "pine nuts", "preparation": "lightly toasted", "optional": false}, {"position": 7, "raw": "1 can chickpeas, drained and rinsed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "can", "item": "chickpeas", "preparation": "drained
", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped fresh thyme", "preparation": null, "optional": false}, {"position": 9, "raw": "4 teaspoons chopped fresh basil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "chopped fresh basil", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup crumbled goat cheese", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "crumbled goat cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 275 degrees. Combine 2 teaspoons olive oil and the orange oil in a small bowl. Brush the tomatoes with the oil mixture lightly on all sides and place, cut side down on 2 baking sheets. Bake until reduced to one-third of their original size, about 3 hours; tomatoes should still be plump."}, {"position": 2, "text": "Heat 1 teaspoon olive oil in a large, nonstick skillet over medium heat. Add the zucchini and saute until crisp-tender, about 5 minutes. Place in a large bowl and toss in the tomatoes. In another bowl, whisk together the vinegar, remaining olive oil, salt, pepper, thyme and basil. Add to the vegetables and toss."}, {"position": 3, "text": "Preheat the broiler. Place the mixture in a shallow gratin dish or pie plate. Sprinkle with the goat cheese and broil until melted. Divide among 4 plates and serve."}], "nutrition": {"calories": 218.1, "protein_g": 10.1, "carbohydrates_g": 20.9, "fat_g": 12.4, "saturated_fat_g": 4.4, "trans_fat_g": 0.0, "cholesterol_mg": 10.3, "sodium_mg": 1082.6, "fiber_g": 6.4, "sugar_g": 14.7, "unsaturated_fat_g": 7.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["appetizer", "side dish"], "meal": [], "occasion": [], "other": ["bake", "broil", "casseroles", "fresh herb", "goat cheese", "great leftovers", "plum tomato", "saute", "summer", "weeknight", "zucchini"]}, "images":
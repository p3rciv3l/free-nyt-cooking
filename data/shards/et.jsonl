{"slug": "ethel-m-kings-glazed-ham", "nyt_id": 12049, "url": "https://cooking.nytimes.com/recipes/12049-ethel-m-kings-glazed-ham", "name": "Ethel M. King's Glazed Ham", "author": "Horacio Silva", "description": "", "servings": {"text": "12 to 16 servings", "min": 12, "max": 16, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "4 hours, plus overnight sitting"}}, "ingredients": [{"position": 1, "raw": "1 8-to 12-pound, fully cooked boneless ham", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "8-to 12-pound", "preparation": "fully cooked boneless ham", "optional": false}, {"position": 2, "raw": "1 cup red currant jelly", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "red currant jelly", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup hot mustard (see below)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "hot mustard (see below)", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup dry mustard powder", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry mustard powder", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup white vinegar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "white vinegar", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 large egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "To make the mustard: mix the mustard powder and vinegar in a noncorroding saucepan. Cover and let stand overnight. Whisk in the sugar and the egg. Place over boiling water and cook for 1 hour, stirring occasionally."}, {"position": 2, "text": "To make the ham: slice the ham into ¼-inch slices and tie it back together. Preheat the oven to 350 degrees. Place the ham in a roasting pan. Mix the jelly and the mustard together. Pour over the ham to coat thoroughly. Place the ham in the oven and baste every 20 minutes, baking it about 15 minutes a pound."}, {"position": 3, "text": "When finished, untie it and serve."}], "nutrition": {"calories": 1408.6, "protein_g": 97.9, "carbohydrates_g": 24.5, "fat_g": 99.2, "saturated_fat_g": 35.7, "trans_fat_g": 0.0, "cholesterol_mg": 356.9, "sodium_mg": 7041.8, "fiber_g": 1.0, "sugar_g": 47.7, "unsaturated_fat_g": 61.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": ["easter"], "other": ["bake", "ham"]}, "images": [], "rating": {"average": 4.0, "count": 18}, "video_url": null, "comment_count": null, "published_at": "2002-03-24", "scraped_at": "2026-09-07T02:48:31.403677+00:00", "scraper_version": "1.0.0"}

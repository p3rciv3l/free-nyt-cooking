": false}, {"position": 10, "raw": "⅔ cup dry white wine", "group": null, "quantity": 0.6666666666666666, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 11, "raw": "1 cup chicken broth", "group": null, "quantity": 1.0, "unit": "cup", "item": "chicken broth", "preparation": null, "optional": false}, {"position": 12, "raw": "1 large rosemary sprig", "group": null, "quantity": 1.0, "unit": null, "item": "large rosemary sprig", "preparation": null, "optional": false}, {"position": 13, "raw": "2 sage sprigs", "group": null, "quantity": 2.0, "unit": null, "item": "sage sprigs", "preparation": null, "optional": false}, {"position": 14, "raw": "2 thyme sprigs", "group": null, "quantity": 2.0, "unit": null, "item": "thyme sprigs", "preparation": null, "optional": false}, {"position": 15, "raw": "¼ cup finely chopped fresh parsley", "group": null, "quantity": 0.25, "unit": "cup", "item": "finely chopped fresh parsley", "preparation": null, "optional": false}, {"position": 16, "raw": "½ teaspoon finely grated lemon zest", "group": null, "quantity": 0.5, "unit": "tsp", "item": "finely grated lemon zest", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oven to 325 degrees. Season the necks with 1 teaspoon each salt and pepper."}, {"position": 2, "text": "Heat the oil in a large skillet or Dutch oven over medium-high heat. Cook the necks, turning occasionally, until dark golden, about 10 minutes, then transfer to a plate."}, {"position": 3, "text": "Add the carrots, celery, onion and 2 of the garlic cloves to the skillet. Cook until the vegetables are soft and golden, about 5 minutes. Season with ¼ teaspoon each salt and pepper. Stir in the tomato paste and cook until darkened, 1 to 2 minutes. Pour in the wine and simmer, scraping up any browned bits at the bottom of the skillet, 2 minutes. Add the broth, rosemary, sage and thyme (tie herbs together with kitchen twine if desired). Return necks t
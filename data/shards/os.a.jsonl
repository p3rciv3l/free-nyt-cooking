{"slug": "osso-buco-portobello", "nyt_id": 1012982, "url": "https://cooking.nytimes.com/recipes/1012982-osso-buco-portobello", "name": "Osso Buco Portobello", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "PT1H45M"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons flour", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "flour", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "freshly ground black pepper", "group": null, "quantity": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "4 pieces veal shank, 2 inches thick", "group": null, "quantity": 4.0, "unit": "piece", "item": "veal shank", "preparation": "2 inches thick", "optional": false}, {"position": 5, "raw": "4 tablespoons extra virgin olive oil", "group": null, "quantity": 4.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "4 large portobello mushrooms, stemmed, in slices ½ -inch wide", "group": null, "quantity": 4.0, "unit": null, "item": "large portobello mushrooms", "preparation": "stemmed, in slices ½ -inch wide", "optional": false}, {"position": 7, "raw": "½ cup finely chopped shallots", "group": null, "quantity": 0.5, "unit": "cup", "item": "finely chopped shallots", "preparation": null, "optional": false}, {"position": 8, "raw": "4 cloves garlic, sliced", "group": null, "quantity": 4.0, "unit": "clove", "item": "garlic", "preparation": "sliced", "optional": false}, {"position": 9, "raw": "1 cup dry red wine", "group": null, "quantity": 1.0, "unit": "cup", "item": "dry red wine", "preparation": null, "optional": false}, {"position": 10, "raw": "⅓ cup beef stock", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "beef stock", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons red wine vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 12, "raw": "6 sprigs fresh thyme, more for garnish", "group": null, "quantity": 6.0, "unit": "sprig", "item": "fresh thyme", "preparation": "more for garnish", "optional": false}], "steps": [{"position": 1, "text": "Season flour with salt and pepper. Spread on a plate and dust osso buco with it. In a 4- to 5-quart casserole, heat 3 tablespoons oil on medium high. Add meat and brown on both sides. Remove. Add mushrooms and cook, stirring, about 5 minutes, until they start to wilt and no longer look dry. Remove."}, {"position": 2, "text": "Add remaining tablespoon oil to pot, reduce heat to low and sauté shallots and garlic until just starting to brown. Deglaze with wine and stock. Season generously with pepper. Stir in vinegar. Return meat and mushrooms to pot, add thyme, cover and cook on very low about 1 hour 15 minutes, basting meat a few times, until meat is tender."}, {"position": 3, "text": "Season sauce with salt as needed. Transfer meat, mushrooms and sauce to a warm platter, garnish with thyme sprigs and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 580.5, "protein_g": 62.1, "carbohydrates_g": 15.9, "fat_g": 24.6, "saturated_fat_g": 5.1, "unsaturated_fat_g": 2.9, "trans_fat_g": null, "cholesterol_mg": 225.0, "sodium_mg": 1285.5, "fiber_g": 3.4, "sugar_g": 5.1, "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["one-pot", "portobello", "veal"]}, "images": [{"url": "https://static01.nyt.com/images/2014/04/01/dining/osso-buco-portobello/osso-buco-portobello-superJumbo-v2.jpg", "alt": "", "primary":
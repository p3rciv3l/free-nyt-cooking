{"slug": "linguine-with-mushrooms", "nyt_id": 11138, "url": "https://cooking.nytimes.com/recipes/11138-linguine-with-mushrooms", "name": "Linguine With Mushrooms", "author": "Florence Fabricant", "description": "", "servings": {"text": "3 main dish servings, 4 or more first-course servings", "min": 3, "max": 3, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "6 tablespoons extra-virgin olive oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "12 ounces fresh mushrooms, thinly sliced", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "fresh mushrooms", "preparation": "thinly sliced", "optional": false}, {"position": 3, "raw": "2 cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "⅓ cup finely chopped Italian parsley", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "finely chopped italian parsley", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "½ pound linguine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "linguine", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly grated Parmesan cheese", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Set three quarts of salted water over high heat in a large covered pot."}, {"position": 2, "text": "While the water is heating, place a large skillet over high heat and add the olive oil. Add the mushrooms and cook, stirring, about six minutes, until they begin to brown. Stir in the garlic and parsley and remove from heat."}, {"position": 3, "text": "When the water boils, add the linguine and cook, uncovered, until it is al dente, about seven minutes. Drain thoroughly. Season to taste with salt if desired."}, {"position": 4, "text": "Place mushroom mixture over medium heat, add the linguine and toss. Re-season with salt and pepper if necessary. Serve with Parmesan cheese on the side."}], "nutrition": {"calories": 588.3, "protein_g": 17.1, "carbohydrates_g": 62.0, "fat_g": 31.0, "saturated_fat_g": 5.4, "trans_fat_g": 0.0, "cholesterol_mg": 6.4, "sodium_mg": 546.1, "fiber_g": 4.0, "sugar_g": 4.4, "unsaturated_fat_g": 24.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": [], "meal": ["dinner"], "occasion": [], "other": ["linguine", "mushroom", "pastas", "saute", "weeknight"]}, "images": [], "rating": {"average": 5.0, "count": 85}, "video_url": null, "comment_count": null, "published_at": "1986-06-22", "scraped_at": "2026-09-06T23:01:03.094346+00:00", "scraper_version": "1.0.0"}
{"slug": "linguine-with-string-beans-boiled-potatoes-and-pesto", "nyt_id": 3004, "url": "https://cooking.nytimes.com/recipes/3004-linguine-with-string-beans-boiled-potatoes-and-pesto", "name": "Linguine With String Beans, Boiled Potatoes and Pesto", "author": "Moira Hodgson", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups fresh basil leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "fresh basil leaves", "preparation": null, "optional": false}, {"position": 2, "raw": "3 tablespoons lightly toasted pine nuts", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "lightly toasted pine nuts", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cloves garlic, green part removed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "green part removed", "optional": false}, {"position": 4, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 5, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup extra-virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup freshly grated Parmesan cheese plus some to serve at the table", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "freshly grated parmesan cheese plus some to serve at the table", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tabl
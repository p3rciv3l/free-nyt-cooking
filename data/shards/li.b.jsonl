{"slug": "linguine-with-dried-porcini-and-green-peppercorns", "nyt_id": 10472, "url": "https://cooking.nytimes.com/recipes/10472-linguine-with-dried-porcini-and-green-peppercorns", "name": "Linguine With Dried Porcini And Green Peppercorns", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 first-course servings or 4 main-course servings", "min": 8, "max": 8, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": 20, "total_minutes": 20, "raw": {"total": "20 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ ounces dried porcini", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "dried porcini", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups chicken broth, preferably homemade", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": "preferably homemade", "optional": false}, {"position": 3, "raw": "1 pound linguine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "linguine", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cloves garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups sour cream", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ teaspoons green peppercorns, drained", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "green peppercorns", "preparation": "drained", "optional": false}, {"position": 8, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly grated Parmesan cheese", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak the mushrooms in the chicken broth for 30 minutes. Remove with a slotted spoon and rinse quickly under running water. Drain the broth through a cheesecloth, paper towels or coffee filter paper and reserve. Place the mushrooms in a small saucepan with the broth. Simmer gently for 15 to 20 minutes."}, {"position": 2, "text": "Meanwhile bring six quarts water to boil for the linquine."}, {"position": 3, "text": "Add the linquine and while it is cooking, saute the garlic lightly in the olive oil in a small frying pan until golden. Turn up the heat and add the sour cream. Drain the porcini, reserving the broth and add with the peppercorns, salt and pepper. Mr. Lang adds the porcini broth to the linguine for extra flavor. Heat the sauce through very gently."}, {"position": 4, "text": "Drain the linguine and place in a heated bowl. Add the porcini peppercorn sauce and toss thoroughly. Pass the Parmesan cheese separately at the table."}], "nutrition": {"calories": 379.3, "protein_g": 11.8, "carbohydrates_g": 51.2, "fat_g": 14.3, "saturated_fat_g": 5.7, "trans_fat_g": 0.3, "cholesterol_mg": 29.7, "sodium_mg": 404.4, "fiber_g": 2.6, "sugar_g": 4.1, "unsaturated_fat_g": 6.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["appetizer", "main course"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["boil", "dried porcini", "linguine", "pastas", "saute"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1990-02-04", "scraped_at": "2026-09-06T22:25:12.110415+00:00", "scraper_version": "1.0.0"}

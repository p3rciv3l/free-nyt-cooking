{"slug": "linguine-with-dried-porcini-and-green-peppercorns", "nyt_id": 10472, "url": "https://cooking.nytimes.com/recipes/10472-linguine-with-dried-porcini-and-green-peppercorns", "name": "Linguine With Dried Porcini And Green Peppercorns", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 first-course servings or 4 main-course servings", "min": 8, "max": 8, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": 20, "total_minutes": 20, "raw": {"total": "20 minutes", "cook": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ ounces dried porcini", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "dried porcini", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups chicken broth, preferably homemade", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "chicken broth", "preparation": "preferably homemade", "optional": false}, {"position": 3, "raw": "1 pound linguine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "linguine", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cloves garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 ½ cups sour cream", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ teaspoons green peppercorns, drained", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "green peppercorns", "preparation": "drained", "optional": false}, {"position": 8, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "u
{"slug": "linguine-with-tomatoes-and-tofu", "nyt_id": 6883, "url": "https://cooking.nytimes.com/recipes/6883-linguine-with-tomatoes-and-tofu", "name": "Linguine With Tomatoes And Tofu", "author": "Florence Fabricant", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "35 minutes"}}, "ingredients": [{"position": 1, "raw": "12 ounces linguine", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "linguine", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "3 to 4 medium-large ripe tomatoes, about 2 pounds", "group": null, "quantity": 3.0, "quantity_max": 4.0, "unit": null, "item": "medium-large ripe tomatoes", "preparation": "about 2 pounds", "optional": false}, {"position": 4, "raw": "3 tablespoons extra-virgin olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "3 large cloves garlic, sliced very thin", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": "sliced very thin", "optional": false}, {"position": 6, "raw": "2 tablespoons drained capers", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "drained capers", "preparation": null, "optional": false}, {"position": 7, "raw": "8 ounces firm tofu, in ½-inch dice", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "firm tofu", "preparation": "in ½-inch dice", "optional": false}, {"position": 8, "raw": "1 teaspoon hot red pepper flakes, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "hot red pepper flakes", "preparation": "or to taste", "optional": false}, {"position": 9, "raw": "¼ cup finely slivered fresh basil leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely slivered fresh basil leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring a large pot of water to a boil for the linguine. Toss in a teaspoon of salt."}, {"position": 2, "text": "While water is coming to a boil, core tomatoes, cut in eighths and pulse in a food processor until finely chopped. Transfer the chopped tomatoes to a colander suspended over a bowl so excess liquid can drain."}, {"position": 3, "text": "When the water is boiling, add the linguine and stir."}, {"position": 4, "text": "Heat two tablespoons of the oil in a saucepan, add the garlic and cook over medium-low heat until lightly browned. Remove from the heat and put in a large bowl. Stir in the drained tomatoes and capers and fold in the tofu. Season to taste with salt and hot red pepper flakes. The seasonings should be fairly assertive so they will not fade once the pasta is mixed in. Set aside."}, {"position": 5, "text": "When the linguine has cooked about seven minutes and is al dente, drain it in a colander, toss it with the remaining tablespoon of oil and add it to the bowl with the tomatoes. Add the basil and fold all the ingredients together. Check seasonings and serve while still warm."}], "nutrition": {"calories": 513.6, "protein_g": 22.2, "carbohydrates_g": 70.9, "fat_g": 16.6, "saturated_fat_g": 2.4, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 626.1, "fiber_g": 5.6, "sugar_g": 5.2, "unsaturated_fat_g": 13.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["vegan", "vegetarian"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["basil", "boil", "caper", "easy", "extra virgin olive oil", "linguine", "pasta", "pastas", "saute", "summer", "tofu", "tomato",
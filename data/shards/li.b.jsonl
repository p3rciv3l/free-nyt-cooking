{"slug": "lidias-veal-and-eggplant-gratinate-for-one", "nyt_id": 11878, "url": "https://cooking.nytimes.com/recipes/11878-lidias-veal-and-eggplant-gratinate-for-one", "name": "Lidia's Veal and Eggplant Gratinate (for One)", "author": "Lidia Bastianich", "description": "Lidia Bastianich", "servings": {"text": "1 serving", "min": 1, "max": 1, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 small eggplant or zucchini, about 6 inches long", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small eggplant or zucchini", "preparation": "about 6 inches long", "optional": false}, {"position": 2, "raw": "Salt and ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and ground black pepper", "preparation": null, "optional": false}, {"position": 3, "raw": "Flour for dredging", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "flour for dredging", "preparation": null, "optional": false}, {"position": 4, "raw": "Light olive oil (not extra virgin) or vegetable oil for browning", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "light olive oil (not extra virgin) or vegetable oil for browning", "preparation": null, "optional": false}, {"position": 5, "raw": "4 ounces thinly sliced veal scaloppine or chicken breast", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "thinly sliced veal scaloppine or chicken breast", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 7, "raw": "1 shallot, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "shallot", "preparation": "minced", "optional": false}, {"position": 8, "raw": "Splash of white wine or dry vermouth", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "splash of white wine or dry vermouth", "preparation": null, "optional": false}, {"position": 9, "raw": "6 basil leaves, or 1 tablespoon freshly chopped parsley, more for garnish", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "basil leaves", "preparation": "or 1 tablespoon freshly chopped parsley, more for garnish", "optional": false}, {"position": 10, "raw": "¼ cup good quality tomato sauce, preferably homemade", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "good quality tomato sauce", "preparation": "preferably homemade", "optional": false}, {"position": 11, "raw": "3 tablespoons freshly grated Parmesan cheese", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 400 degrees. If using eggplant, cut off ends and slice off two long strips of skin, one on each side. With 1 skin side up, so that each slice will have skin on both sides, slice eggplant lengthwise, ¼inch thick. Sprinkle with salt and pepper, and dredge lightly in flour. If using zucchini, slice on diagonal, ¼ inch thick."}, {"position": 2, "text": "In a 6- to 8-inch ovenproof skillet (see Note), heat 1 tablespoon oil. Brown vegetable slices lightly on both sides, working in batches if necessary to avoid crowding pan. Add more oil as needed to keep pan lightly oiled. Remove and drain on paper towels."}, {"position": 3, "text": "Sprinkle veal or chicken with salt and pepper, and dredge lightly in flour. Melt butter in same pan until it bubbles, then brown meat lightly on both sides. Remove and drain on paper towels. Add shallot to pan and cook, stirring, until slightly softened, about 2 minutes. Pour in wine and simmer until syrupy."}, {"position": 4, "text": "Turn off heat and place pieces of meat in skillet. Lay basil leaves or parsley over them, then arrange vegetable slices on top. Spoon tomato sauce over, sprinkle cheese on top, and pour about 2 tablespoons water (more or less, depending on thickness of tomato sauce) around edges of pan. Bake 8 to 10 minutes, until meat is cooked through and liquid in bottom of pan is thickened. Sprinkle with torn basil or chopped parsley; serve with crusty bread."}], "nutrition": {"calories": 701.1, "protein_g": 42.9, "carbohydrates_g": 47.4, "fat_g": 33.1, "saturated_fat_g": 13.6, "trans_fat_g": 0.0, "cholesterol_mg": 132.3, "sodium_mg": 1844.2, "fiber_g": 16.0, "sugar_g": 22.2, "unsaturated_fat_g": 16.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["eggplant", "for one", "roast", "veal"]}, "images": [], "rating": {"average": 4.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "2007-10-24", "scraped_at": "2026-09-06T23:50:57.525927+00:00", "scraper_version": "1.0.0"}
{"slug": "light-lentil-soup-with-smoked-trout", "nyt_id": 12188, "url": "https://cooking.nytimes.com/recipes/12188-light-lentil-soup-with-smoked-trout", "name": "Light Lentil Soup With Smoked Trout", "author": "Martha Rose Shulman", "description": "This is inspired by a traditional French combination of lentils and fresh salmon. I decided to make something a little simpler: a very basic lentil soup garnished with smoked trout, either canned or packaged. I use the Parmesan rind in the bouquet garni to add some umami flavor to the lentils, which would traditionally be paired with sausage or cured pork.", "servings": {"text": "4 servings.", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "About 1 hour"}}, "ingredients": [{"position": 1, "raw": "1 cup (6 ounces) lentils, rinsed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "(6 ounces) lentils", "preparation": "rinsed", "optional": false}, {"position": 2, "raw": "1 onion, cut in half", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "onion", "preparation": "cut in half", "optional": false}, {"position": 3, "raw": "2 garlic cloves, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "garlic cloves", "preparation": "minced", "optional": false}, {"position": 4, "raw": "A bouquet garni made with a Parmesan rind, a bay leaf and a sprig of parsley", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "a bouquet garni made with a parmesan rind", "preparation": "a bay leaf and a sprig of parsley", "optional": false}, {"position": 5, "raw": "7 cups water", "group": null, "quantity": 7.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 6, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "4 ounces smoked trout, drained and rinsed if canned", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "smoked trout", "preparation": "drained and rinsed if canned", "optional": false}, {"position": 9, "raw": "2 tablespoons chopped fresh parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine the lentils, onion, garlic, bouquet garni, water, and salt to taste in a soup pot or a large saucepan and bring to a boil. Reduce the heat, cover and simmer 45 minutes, or until the lentils are tender. Add pepper, taste and adjust salt. Remove the onion halves and bouquet garni and discard. Stir in the parsley."}, {"position": 2, "text": "Divide the smoked trout among 4 bowls. Ladle in the soup and serve."}], "nutrition": {"calories": 207.2, "protein_g": 16.5, "carbohydrates_g": 32.6, "fat_g": 1.9, "saturated_fat_g": 0.4, "trans_fat_g": 0.0, "cholesterol_mg": 6.5, "sodium_mg": 1216.0, "fiber_g": 6.2, "sugar_g": 2.3, "unsaturated_fat_g": 1.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "healthy", "high fiber", "low-fat"], "course": ["appetizer", "main course"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["great leftovers", "lentil", "low cholesterol", "one pot", "smoked trout", "soup"]}, "images": [{"url": "https://static01.nyt.com/images/2011/12/27/science/27recipehealth/27recipehealth-facebookJumbo-v2.jpg", "alt": "Light Lentil Soup With Smoked Trout", "primary": true}], "rating": {"average": 5.0, "count": 128}, "video_url": null, "comment_count": null, "published_at": "2011-12-27", "scraped_a
{"slug": "georgian-bean-salad-with-cilantro-sauce", "nyt_id": 1012762, "url": "https://cooking.nytimes.com/recipes/1012762-georgian-bean-salad-with-cilantro-sauce", "name": "Georgian Bean Salad With Cilantro Sauce", "author": "Martha Rose Shulman", "description": "This is one of my favorite versions of a signature dish of the Republic of Georgia.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 120, "raw": {"total": "PT2H"}}, "ingredients": [{"position": 1, "raw": "¾ pound small red kidney beans(about 1 ⅔ cups), rinsed and picked over for stones", "group": null, "quantity": 0.75, "unit": "lb", "item": "small red kidney beans", "preparation": "rinsed and picked over for stones", "optional": false}, {"position": 2, "raw": "1 small red or yellow onion, chopped", "group": null, "quantity": 1.0, "unit": null, "item": "small red or yellow onion", "preparation": "chopped", "optional": false}, {"position": 3, "raw": "4 garlic cloves, green shoots removed, minced", "group": null, "quantity": 4.0, "unit": null, "item": "garlic cloves", "preparation": "green shoots removed, minced", "optional": false}, {"position": 4, "raw": "Salt to taste", "group": null, "quantity": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup cilantro sauce", "group": null, "quantity": 0.5, "unit": "cup", "item": "cilantro sauce", "preparation": null, "optional": false}, {"position": 6, "raw": "4 scallions, chopped or thinly sliced", "group": null, "quantity": 4.0, "unit": null, "item": "scallions", "preparation": "chopped or thinly sliced", "optional": false}, {"position": 7, "raw": "Chopped fresh cilantro for garnish", "group": null, "quantity": null, "unit": null, "item": "chopped fresh cilantro for garnish", "preparation": null, "optional": false}, {"position": 8, "raw": "Optional: 1 or 2 chopped fresh ripe tomatoes", "group": null, "quantity": null, "unit": null, "item": "optional: 1 or 2 chopped fresh ripe tomatoes", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "Soak the beans overnight or for six hours in just enough water to cover the beans. Transfer with the soaking water to a soup pot or Dutch oven. Add enough water to cover by 2 inches, and bring to a simmer. Skim off any foam, then add the onion and two of the garlic cloves. Reduce the heat, cover and simmer one hour or until the beans are just about tender. Add salt to taste (about 1 rounded teaspoon) and the remaining garlic, and simmer another 30 minutes or until the beans are tender but intact. Drain, retaining the liquid."}, {"position": 2, "text": "Toss the beans with the cilantro sauce and the scallions. If you wish, moisten with some of the bean liquid. Transfer to a serving dish, and allow to cool to room temperature. Moisten with more liquid if desired, and adjust seasonings before serving. Add chopped tomatoes if desired. Sprinkle with cilantro and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 149.5, "protein_g": 9.5, "carbohydrates_g": 28.1, "fat_g": 0.5, "saturated_fat_g": 0.1, "unsaturated_fat_g": 0.3, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 240.8, "fiber_g": 6.9, "sugar_g": 2.8, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side-dish"], "meal": [], "occasion": [], "other": ["kidney-bean", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2009/09/04/health/04recipehealth_600/04recipehealth_600-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2009/09/04/health/04recipehealth_600/04recipehealth_600-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 22}, "video_url": null, "comment_count": null, "published_at": "2009-09-04", "scraped_at": "2026-09-06T22:32:00Z", "scraper_version": "1.0.0"}

{"slug": "15-minute-chocolate-cake", "nyt_id": 6971, "url": "https://cooking.nytimes.com/recipes/6971-15-minute-chocolate-cake", "name": "15-Minute Chocolate Cake", "author": "Julia Reed", "description": "Julia Reed", "servings": {"text": "", "min": null, "max": null, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound chocolate with a cocoa-solids content of at least 70 percent", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "chocolate with a cocoa-solids content of at least 70 percent", "preparation": null, "optional": false}, {"position": 2, "raw": "2 ½ sticks unsalted butter", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "stick", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "6 eggs, preferably organic", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "preferably organic", "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 425. Generously grease a 10-inch springform cake pan and line with baking parchment."}, {"position": 2, "text": "Break the chocolate into pieces and melt with the butter in a bowl over simmering water."}, {"position": 3, "text": "In a separate bowl over simmering water, beat the eggs until they start to thicken. Remove from heat and beat about 4 or 5 more minutes. Fold half the eggs into the melted chocolate, then fold in the remainder. Pour the batter into the pan and cover with buttered foil."}, {"position": 4, "text": "Place in a bain-marie of very hot water. It is essential, if the cake is to cook evenly, that the water comes halfway up the side of the cake pan."}, {"position": 5, "text": "Bake for five minutes, remove the foil and bake for 10 minutes longer until just set. Remove from the water and cool in the pan. Unmold when completely cool."}], "nutrition": {"calories": 326.6, "protein_g": 3.9, "carbohydrates_g": 20.8, "fat_g": 27.8, "saturated_fat_g": 16.5, "trans_fat_g": 0.0, "cholesterol_mg": 111.9, "sodium_mg": 32.0, "fiber_g": 1.9, "sugar_g": 17.7, "unsaturated_fat_g": 9.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "butter", "chocolate", "egg", "five ingredient"]}, "images": [], "rating": {"average": 4.0, "count": 34}, "video_url": null, "comment_count": null, "published_at": "2004-07-18", "scraped_at": "2026-09-07T08:46:48.007669+00:00", "scraper_version": "1.0.0"}
{"slug": "15-minute-fried-herbed-chicken", "nyt_id": 1012644, "url": "https://cooking.nytimes.com/recipes/1012644-15-minute-fried-herbed-chicken", "name": "15-Minute Fried Herbed Chicken", "author": "Mark Bittman", "description": "This chicken takes so little time but tastes so good that it raises the bar for weeknight cooking. Chicken pieces are smothered in an herb and onion paste, dredged in flour and fried in the amount of time needed to make a salad. The amount of oil you need to crisp up the chicken is minimal, and the flavor is terrific.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 4, "total_minutes": 15, "raw": {"cook": "PT4M", "total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "2 to 3 cloves garlic", "group": null, "quantity": 2.0, "unit": "clove", "item": "garlic", "preparation": null, "optional": false, "quantity_max": 3.0}, {"position": 2, "raw": "1 medium onion, roughly chopped", "group": null, "quantity": 1.0, "unit": null, "item": "medium onion", "preparation": "roughly chopped", "optional": false}, {"position": 3, "raw": "1 to 2 tablespoons mixed fresh herbs, like tarragon and sage", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "mixed fresh herbs", "preparation": "like tarragon and sage", "optional": false, "quantity_max": 2.0}, {"position": 4, "raw": "2 tablespoons tahini or peanut butter", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "tahini or peanut butter", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup olive oil, more for frying", "group": null, "quantity": 0.25, "unit": "cup", "item": "olive oil", "preparation": "more for frying", "optional": false}, {"position": 6, "raw": "Flour for dredging", "group": null, "quantity": null, "unit": null, "item": "flour for dredging", "preparation": null, "optional": false}, {"position": 7, "raw": "6 boneless, skinless chicken thighs or 4 half-breasts", "group": null, "quantity": 6.0, "unit": null, "item": "boneless", "preparation": "skinless chicken thighs or 4 half-breasts", "optional": false}, {"position": 8, "raw": "Chopped fresh parsley leaves for garnish", "group": null, "quantity": null, "unit": null, "item": "chopped fresh parsley leaves for garnish", "preparation": null, "optional": false}, {"position": 9, "raw": "Lemon wedges for serving", "group": null, "quantity": null, "unit": null, "item": "lemon wedges for serving", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt to taste", "group": null, "quantity": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a blender or the container of a food processor, combine garlic, onion, herbs and tahini. As you purée the mixture, slowly add just enough olive oil through the feed tube to make a thick, smooth paste; do not let it get too thin."}, {"position": 2, "text": "Put flour in a shallow bowl. Place chicken in another bowl. Rub puréed mixture over chicken, then dredge each piece in flour. Gently shake off any excess flour, coat again with paste and dredge once more in flour."}, {"position": 3, "text": "Heat ¼ inch olive oil in a skillet; when it is hot, fry chicken for about 4 minutes each side, until well browned and cooked through; it will take longer if you use chicken with the bone in. Garnish with parsley and serve hot or warm, with lemon wedges."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 477.75, "protein_g": 45.8, "carbohydrates_g": 12.3, "fat_g": 27.6, "saturated_fat_g": 5.6, "unsaturated_fat_g": 4.6, "trans_fat_g": null, "cholesterol_mg": 201.6, "sodium_mg": 647.9, "fiber_g": 4.3, "sugar_g": 2.2, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["chicken", "easy", "quick", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2016/06/06/dining/06COOKING-HERB-FRIED-CHICKEN2/06COOKING-HERB-FRIED-CHICKEN2-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2016/06/06/dining/06COOKING-HERB-FRIED-CHICKEN2/06COOKING-HERB-FRIED-CHICKEN2-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2016/06/06/dining/06COOKING-HERB-FRIED-CHICKEN2/06COOKING-HERB-FRIED-CHICKEN2-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 1238}, "video_url": "https://vp.nyt.com/video/2026/07/14/4054_1_friedchick_wg_480p.mp4", "comment_count": null, "published_at": "2009-01-21", "scraped_at": "2026-09-07T01:26:16Z", "scraper_version": "1.0.0"}
{"slug": "15-minute-shrimp-toast", "nyt_id": 2588, "url": "https://cooking.nytimes.com/recipes/2588-15-minute-shrimp-toast", "name": "15-Minute Shrimp Toast", "author": "Robert Farrar Capon", "description": "", "servings": {"text": "40 pieces", "min": 40, "max": 40, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "About 15 minutes"}}, "ingredients": [{"position": 1, "raw": "1 pound fresh shrimp", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "fresh shrimp", "preparation": null, "optional": false}, {"position": 2, "raw": "1 acorn-size piece fresh ginger, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "acorn-size piece fresh ginger", "preparation": "minced", "optional": false}, {"position": 3, "raw": "1 small onion, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small onion", "preparation": "minced", "optional": false}, {"position": 4, "raw": "½ teaspoon sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 egg, beaten", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": "beaten", "optional": false}, {"position": 6, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon cornstarch", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon dry Sherry", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dry sherry", "preparation": null, "optional": false}, {"position": 9, "raw": "Black pepper as desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "black pepper as desired", "preparation": null, "optional": false}, {"position": 10, "raw": "10 slices slightly stale bread", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "slice", "item": "slightly stale bread", "preparation": null, "optional": false}, {"position": 11, "raw": "Oil for deep-frying", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "oil for deep-frying", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel and devein shrimp. Place on a chopping board, add ginger and onion and chop until very fine using a Chinese cleaver or a large chef's knife. Transfer the mixture to a bowl."}, {"position": 2, "text": "Add sugar, egg, salt, cornstarch, sherry and black pepper and mix well. Spread mixture thickly on one side of the bread slices."}, {"position": 3, "text": "Heat oil to 375 degrees. Working with a few slices of bread at a time, fry them, shrimp side down, for about 1 ½ minutes or until golden brown. Turn and fry the other side until golden brown. Remove, drain, cut into quarters and serve as an appetizer with soy sauce, Chinese mustard, rice vinegar, oyster sauce, hoisin sauce or plum sauce."}], "nutrition": {"calories": 63.2, "protein_g": 3.1, "carbohydrates_g": 4.1, "fat_g": 3.8, "saturated_fat_g": 0.3, "trans_fat_g": 0.0, "cholesterol_mg": 22.3, "sodium_mg": 60.2, "fiber_g": 0.3, "sugar_g": 0.6, "unsaturated_fat_g": 3.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["chinese"], "diet": ["dairy-free"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["fry", "ginger", "shrimp", "stale bread"]}, "images": [], "rating": {"average": 4.0, "count": 22}, "video_url": null, "comment_count": null, "published_at": "1984-10-10", "scraped_at": "2026-09-07T04:32:57.726117+00:00", "scraper_version": "1.0.0"}

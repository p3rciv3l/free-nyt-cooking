{"slug": "kale-salad-with-butternut-squash-cranberries-and-pepitas", "nyt_id": 1014355, "url": "https://cooking.nytimes.com/recipes/1014355-kale-salad-with-butternut-squash-cranberries-and-pepitas", "name": "Kale Salad With Butternut Squash, Cranberries and Pepitas", "author": "Tara Parker-Pope", "description": "This satisfying autumnal salad from Kathryn Anible, a personal chef in New York, is dressed with a sweet-tart apple cider vinaigrette. Tara Parker-Pope", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "1 pound butternut squash", "group": null, "quantity": 1.0, "unit": "lb", "item": "butternut squash", "preparation": null, "optional": false}, {"position": 2, "raw": "5 tablespoons olive oil", "group": null, "quantity": 5.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt and pepper", "group": null, "quantity": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 bunch of kale, de-stemmed", "group": null, "quantity": 1.0, "unit": "bunch", "item": "of kale", "preparation": "de-stemmed", "optional": false}, {"position": 5, "raw": "¼ cup apple cider", "group": null, "quantity": 0.25, "unit": "cup", "item": "apple cider", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons cider vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "cider vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon maple syrup", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "maple syrup", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup dried cranberries", "group": null, "quantity": 0.5, "unit": "cup", "item": "dried cranberries", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup pepitas", "group": null, "quantity": 0.5, "unit": "cup", "item": "pepitas", "preparation": null, "optional": false}, {"position": 10, "raw": "⅛ teaspoon cinnamon", "group": null, "quantity": 0.125, "unit": "tsp", "item": "cinnamon", "preparation": null, "optional": false}, {"position": 11, "raw": "1 teaspoon brown sugar", "group": null, "quantity": 1.0, "unit": "tsp", "item": "brown sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 400 degrees."}, {"position": 2, "text": "Peel the squash, cut in half and scoop out the seeds. Cut the squash into ½-inch slices. Toss the squash with 2 tablespoons olive oil and salt and pepper to taste. Place in a single layer onto a baking sheet and roast for 20 minutes, or until the squash can be pierced by a knife. Remove from the oven and allow to cool."}, {"position": 3, "text": "Slice the kale into bite-size pieces. In a small bowl, mix together the apple cider, cider vinegar, 2 tablespoons oil and maple syrup and season with salt and pepper. Drizzle a little of the dressing over the kale and gently rub the dressing over the leaves, by hand, to coat. Toss the kale with cranberries."}, {"position": 4, "text": "In a separate bowl, mix together the remaining 1 tablespoon olive oil, pepitas, cinnamon, brown sugar and a dash of salt. Toast the pepitas in a shallow pan, just until they start to get tan and fragrant. Set aside to cool."}, {"position": 5, "text": "Divide the squash and kale onto plates and top with the toasted pepitas."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 396.0, "protein_g": 7.6, "carbohydrates_g": 40.2, "fat_g": 25.9, "saturated_fat_g": 3.9, "unsaturated_fat_g": 5.6, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 572.5, "fiber_g": 6.6, "sugar_g": 23.0, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["lunch-salad"], "meal": [], "occasion": [], "other": ["butternut-squash", "dried-cranberry", "easy", 
{"slug": "kale-salad-with-butternut-squash-cranberries-and-pepitas", "nyt_id": 1014355, "url": "https://cooking.nytimes.com/recipes/1014355-kale-salad-with-butternut-squash-cranberries-and-pepitas", "name": "Kale Salad With Butternut Squash, Cranberries and Pepitas", "author": "Tara Parker-Pope", "description": "This satisfying autumnal salad from Kathryn Anible, a personal chef in New York, is dressed with a sweet-tart apple cider vinaigrette. Tara Parker-Pope", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "1 pound butternut squash", "group": null, "quantity": 1.0, "unit": "lb", "item": "butternut squash", "preparation": null, "optional": false}, {"position": 2, "raw": "5 tablespoons olive oil", "group": null, "quantity": 5.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt and pepper", "group": null, "quantity": null, "unit": null, "item": "salt and pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 bunch of kale, de-stemmed", "group": null, "quantity": 1.0, "unit": "bunch", "item": "of kale", "preparation": "de-stemmed", "optional": false}, {"position": 5, "raw": "¼ cup apple cider", "group": null, "quantity": 0.25, "unit": "cup", "item": "apple cider", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons cider vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "cider vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon maple syrup", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "maple syrup", "preparation": null, "optional": false}, {"position": 8, "raw": "½ cup dried cranberries", "group": null, "quantity": 0.5, "unit": "cup", "item": "dried cranberries", "preparation": null, "optional": false}, {"position": 9, "raw": "½
{"slug": "kale-and-quinoa-salad-with-plums-and-herbs", "nyt_id": 1014991, "url": "https://cooking.nytimes.com/recipes/1014991-kale-and-quinoa-salad-with-plums-and-herbs", "name": "Kale and Quinoa Salad With Plums and Herbs", "author": "Martha Rose Shulman", "description": "I was so taken with the spicy, sweet and savory mix of flavors in the soba salad with eggplant and pluots that I made a few weeks ago that I decided to use the same formula for a kale and quinoa salad. The kale is the main ingredient here, with quinoa adding texture and bulk.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "½ cup quinoa", "group": null, "quantity": 0.5, "unit": "cup", "item": "quinoa", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt to taste", "group": null, "quantity": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "3 cups stemmed, slivered kale", "group": null, "quantity": 3.0, "unit": "cup", "item": "stemmed", "preparation": "slivered kale", "optional": false}, {"position": 4, "raw": "1 serrano or Thai chiles, minced (optional)", "group": null, "quantity": 1.0, "unit": null, "item": "serrano or thai chiles", "preparation": "minced (optional)", "optional": true}, {"position": 5, "raw": "1 to 2 ripe but firm plums or pluots, cut in thin slices", "group": null, "quantity": 1.0, "unit": null, "item": "ripe but firm plums or pluots", "preparation": "cut in thin slices", "optional": false, "quantity_max": 2.0}, {"position": 6, "raw": "½ cup basil leaves, chopped, torn or cut in slivers", "group": null, "quantity": 0.5, "unit": "cup", "item": "basil leaves", "preparation": "chopped, torn or cut in slivers", "optional": false}, {"position": 7, "raw": "2 to 4 tablespoons chopped chives", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped chives", "preparation": null, "optional": false, "quantity_max": 4.0}, {"position": 8, "raw": "1 tablespoon chopped cilantro (optional)", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "chopped cilantro", "preparation": null, "optional": true}, {"position": 9, "raw": "2 tablespoons seasoned rice vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "seasoned rice vinegar", "preparation": null, "optional": false}, {"position": 10, "raw": "Grated zest of 1 lime", "group": null, "quantity": null, "unit": null, "item": "grated zest of 1 lime", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons fresh lime juice", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "fresh lime juice", "preparation": null, "optional": false}, {"position": 12, "raw": "1 garlic clove, minced or puréed", "group": null, "quantity": 1.0, "unit": null, "item": "garlic clove", "preparation": "minced or puréed", "optional": false}, {"position": 13, "raw": "3 tablespoons sunflower or grapeseed oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "sunflower or grapeseed oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Rinse the quinoa and cook in a pot of rapidly boiling, generously salted water for 15 minutes. Drain, return to pot, place a towel across the top and replace the lid. Let sit for 15 minutes. Transfer to a sheet pan lined with paper towels and allow to cool completely."}, {"position": 2, "text": "To cut the kale, stem, wash and spin dry the leaves, then stack several at a time and cut crosswise into thin slivers. Toss in a large bowl with the quinoa, chile, herbs, and half the plums."}, {"position": 3, "text": "Whisk together the vinegar, lime zest and juice, salt to taste, garlic and sunflower or grapeseed oil. Toss with the salad. Garnish with the remaining plums and serve."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 133.83333333333334, "protein_g": 2.8, "carbohydrates_g": 14.0, "fat_g": 7.9, "saturated_fat_g": 0.8, "unsaturated_fat_g": 5.3, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 188.1, "fiber_g": 2.2, "sugar_g": 2.5, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["salad"], "meal": [], "occasion": [], "other": ["easy", "kale", "plum", "quinoa", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2013/08/23/science/26recipehealth/26recipehealth-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2013/08/23/science/26recipehealth/26recipehealth-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 131}, "video_url": null, "comment_count": null, "published_at": "2013-08-26", "scraped_at": "2026-09-06T23:56:15Z", "scraper_version": "1.0.0"}
{"slug": "kale-and-red-cabbage-slaw-with-walnuts", "nyt_id": 1015779, "url": "https://cooking.nytimes.com/recipes/1015779-kale-and-red-cabbage-slaw-with-walnuts", "name": "Kale and Red Cabbage Slaw With Walnuts", "author": "Martha Rose Shulman", "description": "I can’t remember where I heard or read about massaging raw kale with olive oil and a little salt, but it is a very effective way to soften the leaves just a bit if you are not cooking the kale. This briny slaw gets its crunch from red cabbage and walnuts.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 70, "raw": {"total": "PT1H10M"}}, "ingredients": [{"position": 1, "raw": "4 cups stemmed, slivered curly kale", "group": null, "quantity": 4.0, "unit": "cup", "item": "stemmed", "preparation": "slivered curly kale", "optional": false}, {"position": 2, "raw": "Salt to taste", "group": null, "quantity": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon extra virgin olive oil", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "3 cups finely sliced or shredded red cabbage", "group": null, "quantity": 3.0, "unit": "cup", "item": "finely sliced or shredded red cabbage", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup finely chopped walnuts", "group": null, "quantity": 0.25, "unit": "cup", "item": "finely chopped walnuts", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons seasoned rice vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "seasoned rice vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "2 teaspoons sherry vinegar", "group": null, "quantity": 2.0, "unit": "tsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 8, "
{"slug": "flounder-saute-with-mushrooms-and-wilted-spinach", "nyt_id": 6777, "url": "https://cooking.nytimes.com/recipes/6777-flounder-saute-with-mushrooms-and-wilted-spinach", "name": "Flounder Saute With Mushrooms And Wilted Spinach", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons all-purpose flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "4 3-to-4-ounce flounder fillets or 2 8-ounce fillets, split down the center", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "3-to-4-ounce flounder fillets or 2 8-ounce fillets", "preparation": "split down the center", "optional": false}, {"position": 4, "raw": "3 teaspoons olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "½ lemon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemon", "preparation": null, "optional": false}, {"position": 6, "raw": "1 scallion, trimmed and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "scallion", "preparation": "trimmed and minced", "optional": false}, {"position": 7, "raw": "2 cups sliced mushrooms", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sliced mushrooms", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup dry white wine", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 9, "raw": "4 cups torn spinach leaves, cleaned and dried", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "torn spinach leaves", "preparation": "cleaned and dried", "optional": false}], "steps": [{"position": 1, "text": "Place the flour on a plate and season with salt and pepper. Lightly dust the flounder on both sides with the seasoned flour. Heat 2 teaspoons of the olive oil in a large, heavy nonstick skillet over medium-high heat. Place the flounder in the pan and saute on one side for about 90 seconds. Turn the fish over. Squeeze the lemon juice on the fish and sprinkle the scallions evenly over the fillets. Cook for 30 seconds and divide among 4 warm plates."}, {"position": 2, "text": "Place the remaining teaspoon of olive oil in the skillet. Add the mushrooms and season them lightly with salt and pepper. Saute until soft, shaking the pan constantly, about 3 to 4 minutes. Add the wine, increase the heat to high and continue to cook for about 1 minute, until the smell of alcohol disappears. Remove the pan from the heat, add the spinach and toss quickly until it barely wilts. Taste and season again with salt and pepper. Divide the spinach over each flounder fillet and serve immediately."}], "nutrition": {"calories": 236.1, "protein_g": 30.8, "carbohydrates_g": 7.5, "fat_g": 8.1, "saturated_fat_g": 1.5, "trans_fat_g": 0.0, "cholesterol_mg": 102.1, "sodium_mg": 764.5, "fiber_g": 1.7, "sugar_g": 1.3, "unsaturated_fat_g": 5.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["low-fat"], "course": ["main course"], "meal": [], "occasion": [], "other": ["dry white wine", "easy", "fish", "flounder", "low calorie", "low cholesterol", "mushroom", "quick", "saute", "spinach", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 86}, "video_u
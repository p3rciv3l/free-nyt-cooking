{"slug": "flank-steak-with-sauteed-mushrooms", "nyt_id": 8454, "url": "https://cooking.nytimes.com/recipes/8454-flank-steak-with-sauteed-mushrooms", "name": "Flank Steak With Sauteed Mushrooms", "author": "Marian Burros", "description": "", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "8 ounces flank steak", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "oz", "item": "flank steak", "preparation": null, "optional": false}, {"position": 2, "raw": "1 pound mushrooms", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "mushrooms", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 large clove garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large clove garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon fresh oregano or 1 teaspoon dried", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh oregano or 1 teaspoon dried", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Turn on broiler,if using,and cover broiler pan with double thickness of aluminum foil.Wash and dry steak,then score on diagonal."}, {"position": 2, "text": "Wash and trim mushrooms, and slice thickly."}, {"position": 3, "text": "Heat a small nonstick pan until it is very hot. Add oil, and reduce the heat to medium-high. Add mushrooms, and saute until they brown."}, {"position": 4, "text": "Prepare the stove-top grill if using. Broil or grill steak until browned ;turn, and continue to cook 7 to 10 minutes."}, {"position": 5, "text": "Mince garlic; add to mushrooms."}
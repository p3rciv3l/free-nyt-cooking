, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ teaspoon dried thyme", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 11, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 13, "raw": "1 teaspoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 14, "raw": "1 tablespoon finely chopped shallots", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped shallots", "preparation": null, "optional": false}, {"position": 15, "raw": "½ cup finely chopped parsley", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "finely chopped parsley", "preparation": null, "optional": false}, {"position": 16, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put the flageolets in a mixing bowl and add cold water to cover about two inches above the top of the beans. Let stand overnight."}, {"position": 2, "text": "Drain the beans and put them in a kettle. Add the eight cups of water, the carrot and the onion stuck with cloves. Tie the celery, parsley sprigs and bay leaf into a bundle and add it. Add the thyme, salt and pepper. Bring to the boil. Cover and let simmer two hours or slightly less until the flageolets are tender."}, {"position": 3, "text": "Remove and discard the onion, celery, parsley and bay leaf."}, {"position": 4, "text": "Remove the carrot and cut it into small cubes. Set aside."}, {"position": 5, "text": "Drain the beans but reserve one- half cup of the cooking liquid. Set aside."}, {"position": 6, "text": "Heat the butter in a large skillet and add the garlic and shallots. Cook briefly, stirring, and add the beans, chopped parsley, carrot and cream. Let simmer five minutes and serve."}], "nutrition": {"calories": 367.6, "protein_g": 15.5, "carbohydrates_g": 47.4, "fat_g": 16.1, "saturated_fat_g": 9.4, "trans_fat_g": 0.4, "cholesterol_mg": 41.3, "sodium_mg": 866.0, "fiber_g": 14.5, "sugar_g": 3.4, "unsaturated_fat_g": 5.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "flageolet bean", "heavy cream", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 79}, "video_url": null, "comment_count": null, "published_at": "1985-03-31", "scraped_at": "2026-09-07T00:09:10.812948+00:00", "scraper_version": "1.0.0"}
{"slug": "flash-marinated-tuna-on-fennel-salad-and-tangerine-tomato-coulis", "nyt_id": 5454, "url": "https://cooking.nytimes.com/recipes/5454-flash-marinated-tuna-on-fennel-salad-and-tangerine-tomato-coulis", "name": "Flash-Marinated Tuna on Fennel Salad and Tangerine Tomato Coulis", "author": "Suzanne Hamlin", "description": "Suzanne Hamlin", "servings": {"text": "6 appetizer servings or 4 entrees", "min": 6, "max": 6, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "10 ounces tuna belly or fluke, sliced diagonally with the grain as thinly as possible", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "tuna belly or fluke", "preparation": "sliced diagonally with the grain as thinly as possible", "optional": false}, {"position": 2, "raw": "¾ pound fennel bulb", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "lb", "item": "fennel bulb", "preparation": null, "optional": false}, {"position": 3, "raw": "3 scallions, trimmed and thinly sliced, including a bit of green ( ¼ packed cup)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "trimmed and thinly sliced, including a bit of green ( ¼ packed cup)", "optional": false}, {"position": 4, "raw": "3 tablespoons plus ⅓ cup extra-virgin olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "plus ⅓ cup extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon chopped spearmint", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped spearmint", "preparation": null, "optional": false}, {"position": 7, "raw": "Fine sea salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "fine sea salt to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "1 pint wild or cultivated currant tomatoes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "pint", "item": "wild or cultivated currant tomatoes", "preparation": null, "optional": false}, {"position": 10, "raw": "13 ounces Tangerine or yellow tomatoes", "group": null, "quantity": 13.0, "quantity_max": null, "unit": "oz", "item": "tangerine or yellow tomatoes", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon sherry vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}, {"position": 12, "raw": "⅛ to ¼ teaspoon ground cumin", "group": null, "quantity": 0.125, "quantity_max": 0.25, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ teaspoon minced garlic", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 14, "raw": "3 ounces mesclun, washed and dried", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "oz", "item": "mesclun", "preparation": "washed and dried", "optional": false}, {"position": 15, "raw": "3 tablespoons sherry vinegar", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "sherry vinegar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put the fish slices in a large bowl. Pull off and discard the two tough outer layers of the fennel bulb. Cut off and discard the stalks. Cut out the tough core; cut the bulb in half and then across in paper-thin slices. Add the fennel and the scallion slices to the fish. In a small bowl, mix together 3 tablespoons olive oil with the lemon juice, the chopped mint and a pinch of salt and pepper. Mix gently with the fish. Cover and set in a chilled place for 10 minutes, no longer."}, {"position": 2, "text": "Set aside 36 of the tiny currant tomatoes. Put the rest, along with the pieces of Tangerine tomatoes, through a food mill set over a 2-quart stainless-steel bowl. In a small bowl, mix the sherry vinegar, ⅛ teaspoon of cumin and minced garlic. Slowly whisk in ⅓ cup olive oil until emulsified. Whisk into the liquefied tomatoes. Add more cumin if needed and sea salt to taste."}, {"position": 3, "text": "To assemble, divide the Tangerine tomato coulis among six 10-inch dinner plates, making a neat pool on the bottom of each plate. Mix the mesclun with the marinated tuna, adding 3 tablespoons of the sherry vinegar or to taste."}, {"position": 4, "text": "Divide the tuna salad among the plates, putting a mound in the center of each. Near the edge of each plate, make a border of 6 evenly spaced currant tomatoes."}], "nutrition": {"calories": 243.2, "protein_g": 8.0, "carbohydrates_g": 9.5, "fat_g": 20.1, "saturated_fat_g": 2.9, "trans_fat_g": 0.0, "cholesterol_mg": 21.3, "sodium_mg": 619.8, "fiber_g": 3.4, "sugar_g": 3.8, "unsaturated_fat_g": 16.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["appetizer", "main course"], "meal": ["dinner"], "occasion": [], "other": ["fennel", "marinate", "summer", "tomato", "tuna fillet"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1996-08-28", "scraped_at": "2026-09-07T00:44:04.334051+00:00", "scraper_version": "1.0.0"}
{"slug": "flounder-saute-with-mushrooms-and-wilted-spinach", "nyt_id": 6777, "url": "https://cooking.nytimes.com/recipes/6777-flounder-saute-with-mushrooms-and-wilted-spinach", "name": "Flounder Saute With Mushrooms And Wilted Spinach", "author": "Molly O’Neill", "description": "", "servings": {"text": "Four servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons all-purpose flour", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "4 3-to-4-ounce flounder fillets or 2 8-ounce fillets, split down the center", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "3-to-4-ounce flounder fillets or 2 8-ounce fillets", "preparation": "split down the center", "optional": false}, {"position": 4, "raw": "3 teaspoons olive oil", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "½ lemon", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemon", "preparation": null, "optional": false}, {"position": 6, "raw": "1 scallion, trimmed and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "scallion", "preparation": "trimmed and minced", "optional": false}, {"position": 7, "raw": "2 cups sliced mushrooms", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sliced mushrooms", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup dry white wine", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 9, "raw": "4 cups torn spinach leaves, cleaned and dried", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "torn spinach leaves", "preparation": "cleaned and dried", "optional": false}], "steps": [{"position": 1, "text": "Place the flour on a plate and season with salt and pepper. Lightly dust the flounder on both sides with the seasoned flour. Heat 2 teaspoons of the olive oil in a large, heavy nonstick skillet over medium-high heat. Place the flounder in the pan and saute on one side for about 90 seconds. Turn the fish over. Squeeze the lemon juice on the fish and sprinkle the scallions evenly over the fillets. Cook for 30 seconds and divide among 4 warm plates."}, {"position": 2, "text": "Place the remaining teaspoon of olive oil in the skillet. Add the mushrooms and season them lightly with salt and pepper. Saute until soft, shaking the pan constantly, about 3 to 4 minutes. Add the wine, increase the heat to high and continue to cook for about 1 minute, until the smell of alcohol disappears. Remove the pan from the heat, add the spinach and toss quickly until it barely wilts. Taste and season again with salt and pepper. Divide the spinach over each flounder fillet and serve immediately."}], "nutrition": {"calories": 236.1, "protein_g": 30.8, "carbohydrates_g": 7.5, "fat_g": 8.1, "saturated_fat_g": 1.5, "trans_fat_g": 0.0, "cholesterol_mg": 102.1, "sodium_mg": 764.5, "fiber_g": 1.7, "sugar_g": 1.3, "unsaturated_fat_g": 5.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["low-fat"], "course": ["main course"], "meal": [], "occasion": [], "other": ["dry white wine", "easy", "fish", "flounder", "low calorie", "low cholesterol", "mushroom", "quick", "saute", "spinach", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 86}, "video_u
, "unit": null, "item": "bay leaf", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ teaspoon dried thyme", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 10, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 11, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 13, "raw": "1 teaspoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 14, "raw": "1 tablespoon finely chopped shallots", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped shallots", "preparation": null, "optional": false}, {"position": 15, "raw": "½ cup finely chopped parsley", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "finely chopped parsley", "preparation": null, "optional": false}, {"position": 16, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Put the flageolets in a mixing bowl and add cold water to cover about two inches above the top of the beans. Let stand overnight."}, {"position": 2, "text": "Drain the beans and put them in a kettle. Add the eight cups of water, the carrot and the onion stuck with cloves. Tie the celery, parsley sprigs and bay leaf into a bundle a
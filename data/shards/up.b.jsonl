{"slug": "upside-down-pear-cake", "nyt_id": 1135, "url": "https://cooking.nytimes.com/recipes/1135-upside-down-pear-cake", "name": "Upside-Down Pear Cake", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 stick unsalted butter, allowed to reach room temperature, plus butter for pan", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "stick", "item": "unsalted butter", "preparation": "allowed to reach room temperature, plus butter for pan", "optional": false}, {"position": 2, "raw": "5 ripe pears, peeled, cored and sliced", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "ripe pears", "preparation": "peeled, cored and sliced", "optional": false}, {"position": 3, "raw": "Juice of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1 lemon", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ¾ cups sugar", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "⅓ cup water", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 6, "raw": "⅔ cup all-purpose flour", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ teaspoon baking powder", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "tsp", "item": "baking powder", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon grated nutmeg", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "grated nutmeg", "preparation": null, "optional": false}, {"position": 9, "raw": "⅓ cup finely ground toasted walnuts", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "finely ground toasted walnuts", "preparation": null, "optional": false}, {"position": 10, "raw": "3 large eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 350 degrees and then heavily butter a nine-inch pie pan."}, {"position": 2, "text": "Toss the pears with the lemon juice and arrange them in an attractive pattern in the bottom of the pan."}, {"position": 3, "text": "Combine one cup of the sugar with the water in a skillet or saucepan, preferably nonstick. Cook over medium heat without stirring until the mixture turns amber. Pour this caramel evenly over the pears. Set aside."}, {"position": 4, "text": "Sift the flour, baking powder and nutmeg together. Stir in the walnuts and set aside. Cream the stick of butter and the remaining sugar together. Beat in the eggs, one at a time, then stir in the flour mixture. Spread this batter evenly over the pears."}, {"position": 5, "text": "Bake 30 minutes, until the cake is nicely browned."}, {"position": 6, "text": "Allow the cake to cool at least 40 minutes, then run a knife around the sides and invert the pan onto a serving platter. Any slices of pear that cling to the pan after the cake has been turned out can be replaced on the top of the cake. Serve warm or at room temperature."}], "nutrition": {"calories": 427.2, "protein_g": 4.6, "carbohydrates_g": 71.1, "fat_g": 15.7, "saturated_fat_g": 8.0, "trans_fat_g": 0.0, "cholesterol_mg": 100.1, "sodium_mg": 64.7, "fiber_g": 4.4, "sugar_g": 55.5, "unsaturated_fat_g": 6.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["bake", "pear", "winter"]}, "images": [], "rating": {"average": 4.0, "count": 27}, "video_url": null, "comment_count": null, "published_at": "1992-12-13", "scraped_at": "2026-09-07T02:15:22.195484+00:00", "scraper_version": "1.0.0"}

{"slug": "updated-funeral-potatoes", "nyt_id": 12288, "url": "https://cooking.nytimes.com/recipes/12288-updated-funeral-potatoes", "name": "Updated Funeral Potatoes", "author": "Julia Moskin", "description": "Julia Moskin", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "2.5 hours, plus overnight refrigeration"}}, "ingredients": [{"position": 1, "raw": "3 baking potatoes (about 2 pounds)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "baking potatoes (about 2 pounds)", "preparation": null, "optional": false}, {"position": 2, "raw": "canola oil", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "canola oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ cups sour cream", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "sour cream", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup finely chopped chives, plus extra for garnish", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely chopped chives", "preparation": "plus extra for garnish", "optional": false}, {"position": 5, "raw": "3 cloves garlic, pressed or minced", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "pressed or minced", "optional": false}, {"position": 6, "raw": "2 tablespoons grated onion (about ½ an onion)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "grated onion (about ½ an onion)", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ teaspoons kosher salt", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ teaspoon black pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 9, "raw": "1 ¼ cups grated sharp Cheddar cheese, about 4 ounces", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "grated sharp cheddar cheese", "preparation": "about 4 ounces", "optional": false}, {"position": 10, "raw": "1 ¼ cups grated Gruyère cheese, or more Cheddar, about 4 ounces", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "grated gruyère cheese", "preparation": "or more Cheddar, about 4 ounces", "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 375 degrees. Rub potatoes lightly with oil, place on a baking sheet and bake 60 to 80 minutes, until just tender all the way through. Let cool and refrigerate overnight or up to 3 days. (Refrigeration gives the potatoes the right texture.)"}, {"position": 2, "text": "Heat oven to 350 degrees. In a large bowl, combine sour cream, chives, garlic, onion, salt and pepper. Using a box grater, coarsely grate potatoes with skins on. (Most of the skin will peel off; discard it.) Add grated potatoes to sour cream mixture, and gently toss to combine. Add 1 cup Cheddar and 1 cup Gruyère and mix gently. Transfer to an 8-by-8-inch-square baking dish. Sprinkle remaining cheese on top."}, {"position": 3, "text": "Bake until hot, bubbly and lightly browned around the edges, 30 to 40 minutes. Let cool 10 minutes before serving, sprinkled with chives."}], "nutrition": {"calories": 498.5, "protein_g": 19.4, "carbohydrates_g": 32.7, "fat_g": 33.1, "saturated_fat_g": 16.5, "trans_fat_g": 0.5, "cholesterol_mg": 91.4, "sodium_mg": 656.6, "fiber_g": 2.3, "sugar_g": 3.6, "unsaturated_fat_g": 12.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["american"], "diet": [], "course": ["side dish"], "meal": ["lunch"], "occasion": [], "other": ["bake", "cheese", "potato", "sour cream"]}, "images": [{"url": "https://static01.nyt.com/images/2012/01/25/dini
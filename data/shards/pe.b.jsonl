{"slug": "pepper-and-snow-pea-salad", "nyt_id": 2595, "url": "https://cooking.nytimes.com/recipes/2595-pepper-and-snow-pea-salad", "name": "Pepper and Snow Pea Salad", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "Approximately 10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 sweet red peppers, about ¾ pound", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "sweet red peppers", "preparation": "about ¾ pound", "optional": false}, {"position": 2, "raw": "Salt to taste if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste if desired", "preparation": null, "optional": false}, {"position": 3, "raw": "¾ pound snow peas", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "lb", "item": "snow peas", "preparation": null, "optional": false}, {"position": 4, "raw": "1 small red onion, peeled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small red onion", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "1 tablespoon imported mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "imported mustard", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons red-wine vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup finely chopped parsley", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "finely chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat broiler to high or heat charcoal grill. Place peppers under broiler or on grill and cook on all sides until skin is well charred. When cool enough to handle split in half, core and discard charred skin."}, {"position": 2, "text": "Cut peppers lengthwise into thin strips. There should be about 1 cup. Put strips in salad bowl."}, {"position": 3, "text": "Bring enough water to a boil to cover peas when added. Add salt to taste. Add peas and let boil 2 minutes. Drain in sieve. Run cold water briefly over peas and drain. Add to salad bowl."}, {"position": 4, "text": "Cut onion in half, cut each half crosswise into thin slice and add to bowl."}, {"position": 5, "text": "Put mustard and vinegar in separate bowl and add salt and pepper. Start beating vigorously with whisk while adding oil. Stir in parsley."}, {"position": 6, "text": "Pour sauce over the vegetables and toss."}], "nutrition": {"calories": 190.9, "protein_g": 3.7, "carbohydrates_g": 14.1, "fat_g": 14.1, "saturated_fat_g": 2.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 504.9, "fiber_g": 4.7, "sugar_g": 7.8, "unsaturated_fat_g": 11.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["dairy-free"], "course": [], "meal": [], "occasion": [], "other": ["boil", "broil", "quick", "red pepper", "salad", "snow pea", "vegetables"]}, "images": [], "rating": {"average": 4.0, "count": 15}, "video_url": null, "comment_count": null, "published_at": "1984-10-10", "scraped_at": "2026-09-07T00:13:22.303483+00:00", "scraper_version": "1.0.0"}
{"slug": "perfect-white-rice-spanish-caribbean-style", "nyt_id": 3474, "url": "https://cooking.nytimes.com/recipes/3474-perfect-white-rice-spanish-caribbean-style", "name": "Perfect White Rice, Spanish Caribbean Style", "author": "Daisann McLane", "description": "", "servings": {"text": "Four to six servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "35 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cups white rice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "white rice", "preparation": null, "optional": false}, {"position": 2, "raw": "About 2 ½ tablespoons freshly squeezed lime juice", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "about 2 ½ tablespoons freshly squeezed lime juice", "preparation": null, "optional": false}, {"position": 3, "raw": "3 cups water", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the rice in a colander and rinse it thoroughly, adding a few drops of fresh lime juice to the rinsing water (the lime juice helps take away the musty smell that rice gets from sitting in the package)."}, {"position": 2, "text": "In a saucepan, bring the water, 1 tablespoon of the lime juice, 1 tablespoon of the olive oil and salt to a boil. (To make the con conor delicately flavored crusts of rice, use a very light pan; do not use a pot with an enamel or Teflon surface.)"}, {"position": 3, "text": "Stir in the rice. Return to a boil, cover tightly and simmer over low heat for 15 to 20 minutes, or until the rice is tender and dry."}, {"position": 4, "text": "Turn off the heat and let stand for a few minutes. Gently stir in 1 tablespoon olive oil. The sides and bottom of the pan will be covered with a crust of browned rice, the con con Scrape off the browned bits and serve separately."}], "nutrition": {"calories": 275.4, "protein_g": 4.3, "carbohydrates_g": 52.1, "fat_g": 4.9, "saturated_fat_g": 0.7, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 451.6, "fiber_g": 0.0, "sugar_g": 0.1, "unsaturated_fat_g": 4.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["caribbean", "spanish"], "diet": ["dairy-free", "gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "easy", "five ingredient"]}, "images": [], "rating": {"average": 4.0, "count": 34}, "video_url": null, "comment_count": null, "published_at": "1991-08-25", "scraped_at": "2026-09-07T00:22:11.368816+00:00", "scraper_version": "1.0.0"}

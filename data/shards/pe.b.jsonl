{"slug": "penne-with-dried-porcini-and-italian-sausage", "nyt_id": 10473, "url": "https://cooking.nytimes.com/recipes/10473-penne-with-dried-porcini-and-italian-sausage", "name": "Penne With Dried Porcini And Italian Sausage", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 first-course servings, 4 main-course servings", "min": 8, "max": 8, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": 30, "total_minutes": 30, "raw": {"total": "30 minutes", "cook": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ ounces dried porcini mushrooms", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "dried porcini mushrooms", "preparation": null, "optional": false}, {"position": 2, "raw": "1 medium onion, chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "chopped", "optional": false}, {"position": 3, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 pound Italian sweet sausage sliced into 1-inch pieces", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "italian sweet sausage sliced into 1-inch pieces", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon tomato paste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "tomato paste", "preparation": null, "optional": false}, {"position": 7, "raw": "2 cups chicken stock", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "chicken stock", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon fresh rosemary, oregano or thyme leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "fresh rosemary", "preparation": "oregano or thyme leaves", "optional": false}, {"position": 9, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "1 pound penne", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "penne", "preparation": null, "optional": false}, {"position": 11, "raw": "Freshly grated Parmesan cheese", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak the mushrooms in one-and-a-half cups hot water for 30 minutes."}, {"position": 2, "text": "Meanwhile saute the onion and the garlic in the olive oil until soft. Add the sausage and brown lightly. Drain off any fat."}, {"position": 3, "text": "Drain the mushroom through a coffee filter or cheesecloth, reserving the soaking liquid. Quickly rinse the mushrooms under the running water."}, {"position": 4, "text": "Add the mushrooms with their soaking liquid to the onion, along with the tomato paste, chicken stock and herbs. Season lightly with salt and pepper and simmer gently for half an hour. If the sauce gets too thick add more stock. If it is too thin, turn up the heat."}, {"position": 5, "text": "Meanwhile, bring six quarts water to boil for the penne. Cook the penne, drain and place in a heated bowl. Pour the sauce on top, toss thoroughly and serve immediately. Pass the cheese separately."}], "nutrition": {"calories": 464.0, "protein_g": 19.7, "carbohydrates_g": 51.3, "fat_g": 20.0, "saturated_fat_g": 5.7, "trans_fat_g": 0.1, "cholesterol_mg": 43.9, "sodium_mg": 567.3, "fiber_g": 2.9, "sugar_g": 3.9, "unsaturated_fat_g": 12.1, "source": "nyt", "basis":
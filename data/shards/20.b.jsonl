{"slug": "2007-paccheri-with-caprese-lobster-salad", "nyt_id": 11719, "url": "https://cooking.nytimes.com/recipes/11719-2007-paccheri-with-caprese-lobster-salad", "name": "2007: Paccheri With Caprese Lobster Salad", "author": "Amanda Hesser", "description": "", "servings": {"text": "Serves 4 as a main course, 6 as an appetizer", "min": 4, "max": 4, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "Sea salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sea salt", "preparation": null, "optional": false}, {"position": 2, "raw": "1 -1 ½ -pound lobster", "group": null, "quantity": 1.0, "quantity_max": 1.5, "unit": null, "item": "-pound lobster", "preparation": null, "optional": false}, {"position": 3, "raw": "3 ½ ounces buffalo mozzarella", "group": null, "quantity": 3.5, "quantity_max": null, "unit": "oz", "item": "buffalo mozzarella", "preparation": null, "optional": false}, {"position": 4, "raw": "bocconcini, cut into ½ -inch wedges", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "bocconcini", "preparation": "cut into ½ -inch wedges", "optional": false}, {"position": 5, "raw": "1 ½ cups assorted cherry tomatoes, halved (or, if in season, small heirloom tomatoes, cut into wedges)", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "assorted cherry tomatoes", "preparation": "halved (or, if in season, small heirloom tomatoes, cut into wedges)", "optional": false}, {"position": 6, "raw": "8 large basil leaves, torn", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "large basil leaves", "preparation": "torn", "optional": false}, {"position": 7, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "¾ pound paccheri", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "lb", "item": "paccheri", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup extra-virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "2 cloves garlic, thinly sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "thinly sliced", "optional": false}, {"position": 11, "raw": "1 tablespoon chopped parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Prepare the salad: bring a large pot of generously salted water to a boil. Add the lobster and cook for 11 minutes. Remove the lobster and reserve the cooking water. When the lobster is cool enough to handle, remove the meat from the shell and cut it into ½ -inch pieces."}, {"position": 2, "text": "In a medium bowl, fold together the mozzarella, tomatoes, lobster, basil and olive oil. Season to taste with sea salt."}, {"position": 3, "text": "Return the lobster water to a boil. Stir in the pasta and cook for 7 minutes (it should still be firm)."}, {"position": 4, "text": "Meanwhile, set a 10-inch sauté pan over medium heat and pour in the olive oil. When it starts to shimmer, add the garlic and sauté until golden around the edges. Add a ladleful (about ½ cup) of the pasta water to the sauté pan."}, {"position": 5, "text": "Using a slotted spoon, transfer the paccheri to the sauté pan. Cook over medium-high heat for about 2 minutes, or until the pasta is al dente. Stir in the parsley."}, {"position": 6, "text": "Divide the pasta among 4 plates (or 6 if serving as an appetizer). Top each with the lobster salad."}], "nutrition": {"calories": 804.5, "protein_g": 40.4, "carbohydrates_g": 65.5, "fat_g": 41.7, "saturated_fat_g": 8.4, "trans_fat_g": 0.0, "cholesterol_mg": 199.6, "sodium_mg": 762.9, "fiber_g": 3.1, "sugar_g": 3.2, "unsaturated_fat_g": 31.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": ["appetizer", "main course"], "meal": ["dinner"], "occasion": [], "other": ["boil", "lobster", "pasta", "pastas", "saute", "summer", "tomato"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/21/dining/Paccheri/Paccheri-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 38}, "video_url": null, "comment_count": null, "published_at": "2007-07-29", "scraped_at": "2026-09-06T23:49:13.356877+00:00", "scraper_version": "1.0.0"}

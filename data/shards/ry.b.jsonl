{"slug": "rye-toasts-with-smoked-trout-and-scrambled-eggs", "nyt_id": 12647, "url": "https://cooking.nytimes.com/recipes/12647-rye-toasts-with-smoked-trout-and-scrambled-eggs", "name": "Rye Toasts With Smoked Trout and Scrambled Eggs", "author": "Julia Moskin", "description": "Julia Moskin", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "12 ounces smoked trout or salmon fillet, cut into ¼-inch dice", "group": null, "quantity": 12.0, "quantity_max": null, "unit": "oz", "item": "smoked trout or salmon fillet", "preparation": "cut into ¼-inch dice", "optional": false}, {"position": 2, "raw": "⅓ cup creme fraiche", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "creme fraiche", "preparation": null, "optional": false}, {"position": 3, "raw": "Juice of ¼ lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of ¼ lemon", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon capers", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "capers", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon finely diced red onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely diced red onion", "preparation": null, "optional": false}, {"position": 6, "raw": "2 sprigs parsley, leaves picked, finely chopped", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "sprig", "item": "parsley", "preparation": "leaves picked, finely chopped", "optional": false}, {"position": 7, "raw": "Kosher salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt", "preparation": null, "optional": false}, {"position": 8, "raw": "4 thin slices bread, either a sour Nordic-style rye or soft white like brioche or challah", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "thin slices bread", "preparation": "either a sour Nordic-style rye or soft white like brioche or challah", "optional": false}, {"position": 9, "raw": "2 tablespoons butter, melted", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": "melted", "optional": false}, {"position": 10, "raw": "4 eggs, lightly beaten", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "lightly beaten", "optional": false}, {"position": 11, "raw": "1 tablespoon plus 1 teaspoon heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "plus 1 teaspoon heavy cream", "preparation": null, "optional": false}, {"position": 12, "raw": "8 chives, minced", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "chives", "preparation": "minced", "optional": false}, {"position": 13, "raw": "2 tablespoons trout roe or red or black caviar (optional)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "trout roe or red or black caviar", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "Cut the fish into ¼-inch dice. In a bowl, combine the trout, creme fraiche, lemon juice, capers, red onion and parsley. Season with salt and lemon to taste. Refrigerate until ready to serve, up to 4 hours."}, {"position": 2, "text": "Heat oven to 180 degrees. Cut the crusts off the bread and brush both sides with melted butter. Heat a heavy skillet over medium heat. Working in two batches, brown the bread on both sides, about one minute per side. Remove and keep warm in oven."}, {"position": 3, "text": "In a bowl, whisk eggs, remaining melted butter, cream and ½ teaspoon salt. Heat a nonstick skillet over low heat. Add eggs and cook, stirring continuously with a spatula, until just set and no longer runny. Remove from heat, add chives and transfer the skillet to oven to keep warm."}, {"position": 4, "text": "Place a slice of toast on each plate. Divide trout mixture among toasts, spreading it to make an even platform for the scrambled eggs. Spoon the eggs in the center and top with a small spoonful of roe. Serve immediately."}], "nutrition": {"calories": 348.8, "protein_g": 25.8, "carbohydrates_g": 12.2, "fat_g": 21.6, "saturated_fat_g": 9.4, "trans_fat_g": 0.2, "cholesterol_mg": 268.7, "sodium_mg": 887.6, "fiber_g": 0.8, "sugar_g": 1.6, "unsaturated_fat_g": 10.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["nordic"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["bake", "easy", "quick", "saute"]}, "images": [], "rating": {"average": 5.0, "count": 22}, "video_url": null, "comment_count": null, "published_at": "2012-08-01", "scraped_at": "2026-09-07T03:15:02.292403+00:00", "scraper_version": "1.0.0"}

{"slug": "dhanshak-parsi-cornish-hens-braised-in-spiced-pumpkin-lentil-puree", "nyt_id": 6363, "url": "https://cooking.nytimes.com/recipes/6363-dhanshak-parsi-cornish-hens-braised-in-spiced-pumpkin-lentil-puree", "name": "Dhanshak (Parsi Cornish Hens Braised In Spiced Pumpkin-Lentil Puree)", "author": "Julie Sahni", "description": "", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "¾ cup masar dal (red lentils), picked clean and rinsed", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "masar dal (red lentils)", "preparation": "picked clean and rinsed", "optional": false}, {"position": 2, "raw": "2 ½ cups water", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon ground coriander", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground coriander", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon ground cumin", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon ground fennel", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "ground fennel", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon cayenne, or more to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "cayenne", "preparation": "or more to taste", "optional": false}, {"position": 7, "raw": "1 ½ teaspoons turmeric", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "turmeric", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons coarse salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "coarse salt", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup fresh mint leaves, loosely packed", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fresh mint leaves", "preparation": "loosely packed", "optional": false}, {"position": 10, "raw": "¼ cup fresh cilantro, loosely packed, or 2 tablespoons dried coriander leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fresh cilantro", "preparation": "loosely packed, or 2 tablespoons dried coriander leaves", "optional": false}, {"position": 11, "raw": "1 1-inch cube fresh ginger, peeled and chopped coarse", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "1-inch cube fresh ginger", "preparation": "peeled and chopped coarse", "optional": false}, {"position": 12, "raw": "4 large cloves garlic, peeled and chopped coarse", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": "peeled and chopped coarse", "optional": false}, {"position": 13, "raw": "3 Cornish hens, skinned, trimmed of excess fat and halved, or 1 3 ½-pound chicken, cut into 6 to 8 pieces", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "cornish hens", "preparation": "skinned, trimmed of excess fat and halved, or 1 3 ½-pound chicken, cut into 6 to 8 pieces", "optional": false}, {"position": 14, "raw": "1 ½ cups chopped eggplant, skin on", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "chopped eggplant", "preparation": "skin on", "optional": false}, {"position": 15, "raw": "1 ½ cups peeled, seeded pumpkin or butternut squash, cut into 1-inch pieces", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "peeled", "preparation": "seeded pumpkin or butternut squash, cut into 1-inch pieces", "optional": false}, {"position": 16, "raw": "1 cup chopped onion", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped onion", "preparation": null, "optional": false}, {"position": 17, "raw": "3 tablespoons chopped fresh cilantro for garnish", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh cilantro for garnish", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Layer all of the above ingredients, in the order listed, in a 5-quart microwave-proof casserole dish. Cover and cook at 100 percent power in a 650- to 700-watt microwave carousel oven for 35 minutes, or until the Cornish hens are tender and the lentils soft. Remove from the oven."}, {"position": 2, "text": "Remove the hens and arrange them in a heated deep serving dish. Cover with aluminum foil to keep them warm."}, {"position": 3, "text": "Meanwhile, transfer the vegetables and their liquid to a food processor and puree. You may have to work in batches. Do not overprocess: a little texture adds to the character of the sauce. Pour the sauce over the hens. Garnish with the fresh cilantro and serve."}], "nutrition": {"calories": 469.7, "protein_g": 36.5, "carbohydrates_g": 26.5, "fat_g": 24.2, "saturated_fat_g": 6.6, "trans_fat_g": 0.0, "cholesterol_mg": 169.7, "sodium_mg": 744.5, "fiber_g": 5.3, "sugar_g": 3.4, "unsaturated_fat_g": 15.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["indian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["casseroles", "cilantro", "cornish hen", "garlic", "ginger", "microwave", "onion", "red lentil"]}, "images": [], "rating": {"average": 4.0, "count": 11}, "video_url": null, "comment_count": null, "published_at": "1990-10-21", "scraped_at": "2026-09-07T00:52:38.827896+00:00", "scraper_version": "1.0.0"}

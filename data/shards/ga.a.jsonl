{"slug": "garden-vegetable-gratin", "nyt_id": 1015160, "url": "https://cooking.nytimes.com/recipes/1015160-garden-vegetable-gratin", "name": "Garden Vegetable Gratin", "author": "Tara Parker-Pope", "description": "A layered potato casserole, a gratin is a French dish named for both the technique and the dish it’s baked in: a fairly shallow, oval, oven-safe baking dish. Nonetheless, you can make it in a standard 9-by-13-inch baking dish, more in keeping with standard American cookware. Here's a vegetable-rich version, from cookbook authors Bruce Weinstein and Mark Scarbrough, made with potatoes, carrots, zucchini and peas. Tara Parker-Pope", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 150, "raw": {"total": "PT2H30M"}}, "ingredients": [{"position": 1, "raw": "3 pounds russet potatoes, peeled", "group": null, "quantity": 3.0, "unit": "lb", "item": "russet potatoes", "preparation": "peeled", "optional": false}, {"position": 2, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "4 ounces shallots, diced", "group": null, "quantity": 4.0, "unit": "oz", "item": "shallots", "preparation": "diced", "optional": false}, {"position": 4, "raw": "1 medium carrot, diced", "group": null, "quantity": 1.0, "unit": null, "item": "medium carrot", "preparation": "diced", "optional": false}, {"position": 5, "raw": "1 small zucchini, diced", "group": null, "quantity": 1.0, "unit": null, "item": "small zucchini", "preparation": "diced", "optional": false}, {"position": 6, "raw": "1 cup frozen peas, thawed", "group": null, "quantity": 1.0, "unit": "cup", "item": "frozen peas", "preparation": "thawed", "optional": false}, {"position": 7, "raw": "2 cloves garlic, minced", "group": null, "quantity": 2.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 8, "raw": "2 tablespoons stemmed thyme", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "stemmed thyme", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 10, "raw": "½ teaspoon freshly ground black pepper", "group": null, "quantity": 0.5, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ teaspoon grated or ground mace", "group": null, "quantity": 0.25, "unit": "tsp", "item": "grated or ground mace", "preparation": null, "optional": false}, {"position": 12, "raw": "3 cups reduced-sodium vegetable broth", "group": null, "quantity": 3.0, "unit": "cup", "item": "reduced-sodium vegetable broth", "preparation": null, "optional": false}, {"position": 13, "raw": "1 cup low-fat or fat-free cream", "group": null, "quantity": 1.0, "unit": "cup", "item": "low-fat or fat-free cream", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Position the rack in the center of the oven and preheat the oven to 350 degrees Fahrenheit. Peel and thinly slice the potatoes. Place the slices in a bowl, cover with cool water and set aside."}, {"position": 2, "text": "Melt the butter in a large skillet over medium heat."}, {"position": 3, "text": "Add the shallots, carrot, zucchini and peas. Cook, stirring often, until softened, about 3 minutes."}, {"position": 4, "text": "Add the garlic, thyme, salt, pepper and mace. Stir well to warm through. Remove from the heat."}, {"position": 5, "text": "Layer the potatoes and vegetable mixture in a 10-cup gratin or 9-by-13-inch baking dish by first blotting some potato slices on a paper towel, then layering them across the bottom of the dish. Add some of the vegetable mixture, spread it over the slices, then blot dry more slices and add them as another layer. Keep layering the casserole, like a lasagna, ending with a layer of potato slices."}, {"position": 6, "text": "Whisk the broth and cream in a large bowl. Pour it over the contents of the baking dish."}, {"position": 7, "text": "Bake, uncovered, basting occasionally, until it is golden and most of the liquid has been absorbed, about 2 hours."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 292.75, "protein_g": 6.1, "carbohydrates_g": 38.1, "fat_g": 14.0, "saturated_fat_g": 8.7, "unsaturated_fat_g": 0.7, "trans_fat_g": 0.4, "cholesterol_mg": 41.3, "sodium_mg": 347.9, "fiber_g": 4.0, "sugar_g": 4.7, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["casseroles-side-dish"], "meal": [], "occasion": [], "other": ["christmas", "easter", "thanksgiving"]}, "images": [{"url": "https://static01.nyt.com/images/2010/11/01/health/01well_comfort/01well_comfort-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2010/11/01/health/01well_comfort/01well_comfort-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 88}, "video_url": null, "comment_count": null, "published_at": "2010-11-09", "scraped_at": "2026-09-06T23:58:05Z", "scraper_version": "1.0.0"}

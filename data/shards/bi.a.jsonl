{"slug": "big-country-salad", "nyt_id": 1013112, "url": "https://cooking.nytimes.com/recipes/1013112-big-country-salad", "name": "Big Country Salad", "author": "Sam Sifton", "description": "Here is a salad to evoke late-night meals at the restaurant Odeon, in downtown Manhattan, in the era of “Bright Lights, Big City.” There the country salad is somewhat smaller, and serves as a fine introduction to a plate of steak frites. But made larger, and piled high on a plate, it makes for a delicious dinner best accompanied by a glass of slightly chilled red wine. Need more protein? Put an egg on it!", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "¼ pound slab bacon, cut into 1-inch-long lardons", "group": null, "quantity": 0.25, "unit": "lb", "item": "slab bacon", "preparation": "cut into 1-inch-long lardons", "optional": false}, {"position": 2, "raw": "½ cup fresh bread crumbs", "group": null, "quantity": 0.5, "unit": "cup", "item": "fresh bread crumbs", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons red-wine vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 6, "raw": "2 teaspoons Dijon mustard", "group": null, "quantity": 2.0, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 7, "raw": "⅓ cup extra-virgin olive oil", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup good-quality blue cheese, crumbled", "group": null, "quantity": 0.25, "unit": "cup", "item": "good-quality blue cheese", "preparation": "crumbled", "optional": false}, {"position": 9, "raw": "Kosher salt", "group": null, "quantity": null, "unit": null, "item": "kosher salt", "preparation": null, "optional": false}, {"position": 10, "raw": "freshly ground black pepper", "group": null, "quantity": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 11, "raw": "1 head romaine lettuce", "group": null, "quantity": 1.0, "unit": "head", "item": "romaine lettuce", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Fry the bacon over medium heat until almost crisp. Remove with a slotted spoon and set aside. Reserve a splash of bacon fat."}, {"position": 2, "text": "Return bacon pan to heat and add the bread crumbs, tossing until just golden. Remove from pan and reserve."}, {"position": 3, "text": "Combine the lemon juice, vinegar, garlic and mustard in a small bowl. Slowly whisk in the olive oil and reserved bacon fat until dressing emulsifies. Add a tablespoon of blue cheese and whisk again. Season to taste."}, {"position": 4, "text": "Roughly chop the lettuce and put in a salad bowl. Add bread crumbs and remaining cheese, then the dressing. Toss to mix. Serve immediately."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 345.0, "protein_g": 8.2, "carbohydrates_g": 8.6, "fat_g": 31.7, "saturated_fat_g": 7.7, "unsaturated_fat_g": 3.9, "trans_fat_g": null, "cholesterol_mg": 25.0, "sodium_mg": 536.9, "fiber_g": 3.7, "sugar_g": 2.4, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["salad"], "meal": [], "occasion": [], "other": ["easy", "quick"]}, "images": [{"url": "https://static01.nyt.com/images/2014/04/04/dining/Big-Country-Salad/Big-Country-Salad-superJumbo.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2014/04/04/dining/Big-Country-Salad/Big-Country-Salad-facebookJumbo-v2.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 313}, "video_url": null, "comment_count": null, "published_at": "2010-04-18", "scraped_at": "2026-09-06T22:35:12Z", "scraper_version": "1.0.0"}
{"slug": "bindaetteok-mung-bean-pancakes", "nyt_id": 1014483, "url": "https://cooking.nytimes.com/recipes/1014483-bindaetteok-mung-bean-pancakes", "name": "Bindaetteok (Mung Bean Pancakes)", "author": "Elaine Louie", "description": "Elaine Louie", "servings": {"text": "20 4-inch pancakes", "min": 20, "max": 20, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "PT40M"}}, "ingredients": [{"position": 1, "raw": "2 cups dried mung beans", "group": null, "quantity": 2.0, "unit": "cup", "item": "dried mung beans", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup sweet rice", "group": null, "quantity": 0.25, "unit": "cup", "item": "sweet rice", "preparation": null, "optional": false}, {"position": 3, "raw": "⅔ cup kimchi liquid (from a large jar of kimchi; if necessary, squeeze kimchi lightly to extract some of its liquid)", "group": null, "quantity": 0.6666666666666666, "unit": "cup", "item": "kimchi liquid (from a large jar of kimchi; if necessary", "preparation": "squeeze kimchi lightly to extract some of its liquid)", "optional": false}, {"position": 4, "raw": "1 teaspoon fish sauce, optional", "group": null, "quantity": 1.0, "unit": "tsp", "item": "fish sauce", "preparation": "optional", "optional": true}, {"position": 5, "raw": "1 teaspoon toasted sesame oil", "group": null, "quantity": 1.0, "unit": "tsp", "item": "toasted sesame oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon soy sauce", "group": null, "quantity": 1.0, "unit": "tsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 7, "raw": "Pinch of salt", "group": null, "quantity": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup kimchi", "group": null, "quantity": 1.0, "unit": "cup", "item": "kimchi", "preparation": null, "optional": false}, {"position": 9, "raw": "½ cup vegetable oil, or as needed", "group": null, "quantity": 0.5, "unit": "cup", "item": "vegetable oil", "preparation": "or as needed", "optional": false}, {"position": 10, "raw": "½ cup soy sauce", "group": null, "quantity": 0.5, "unit": "cup", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons toasted sesame oil", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "toasted sesame oil", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons rice vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "rice vinegar", "preparation": null, "optional": false}, {"position": 13, "raw": "2 teaspoons Korean ground red pepper", "group": null, "quantity": 2.0, "unit": "tsp", "item": "korean ground red pepper", "preparation": null, "optional": false}, {"position": 14, "raw": "6 scallions, trimmed", "group": null, "quantity": 6.0, "unit": null, "item": "scallions", "preparation": "trimmed", "optional": false}], "steps": [{"position": 1, "text": "The child can combine the mung beans and rice in a fine-meshed colander. Rinse well with cold water, then drain. Transfer to a bowl and add 8 cups of lukewarm water. Cover the bowl and soak at room temperature for at least 6 hours and up to 24 hours, changing the water once or twice."}, {"position": 2, "text": "Make the dipping sauce. The child can combine the soy sauce, sesame oil, rice vinegar and ground red pepper in a small bowl and mix until blended. The adult can mince the scallions and add to the sauce. Set aside at room temperature."}, {"position": 3, "text": "Make the pancakes. The child can combine the kimchi liquid, fish sauce (if using), sesame oil, soy sauce, salt, and ½ cup water in a small mixing bowl and pour into a food processor. The adult can drain the beans and rice and add to the food processor. Process until the batter is coarse and chunky, not perfectly smooth. Do not overmix. Transfer to a large bowl, finely chop the kimchi and stir into the batter."}, {"position": 4, "text": "Fry the pancakes. The child can line a plate with paper towels and set aside. The adult can place a large nonstick skillet over medium heat and add 1 to 2 tablespoons of the vegetable oil. Heat until the oil shimmers. Using a ¼ cup measure, ladle in the pancake batter, flattening each pancake to ⅓-inch thickness. Cook until crisp and browned on one side, 2 to 4 minutes. Flip the pancakes and cook until browned on the other side, another 2 to 4 minutes. Transfer to the paper towel-lined plate, then to a warmed serving platter and serve with the dipping sauce."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 153.15, "protein_g": 5.9, "carbohydrates_g": 16.3, "fat_g": 7.5, "saturated_fat_g": 0.7, "unsaturated_fat_g": 1.7, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 426.5, "fiber_g": 3.9, "sugar_g": 1.7, "computed_with": null}, "tags": {"cuisine": ["korean"], "diet": [], "course": ["appetizer-vegetable-pancake"], "meal": [], "occasion": [], "other": ["kimchi", "mung-bean", "plan-ahead"]}, "images": [{"url": "https://static01.nyt.com/images/2013/01/09/dining/09SPROUTS2/09SPROUTS2-superJumbo-v2.jpg", "alt": "Mung bean pancakes.", "primary": true}, {"url": "https://static01.nyt.com/images/2013/01/09/dining/09SPROUTS2/09SPROUTS2-facebookJumbo-v2.jpg", "alt": "Mung bean pancakes.", "primary": false}], "rating": {"average": 4.0, "count": 89}, "video_url": null, "comment_count": null, "published_at": "2013-01-16", "scraped_at": "2026-09-06T23:52:18Z", "scraper_version": "1.0.0"}
{"slug": "bitter-greens-salad-with-lemon-mustard-dressing", "nyt_id": 1013401, "url": "https://cooking.nytimes.com/recipes/1013401-bitter-greens-salad-with-lemon-mustard-dressing", "name": "Bitter Greens Salad With Lemon-Mustard Dressing", "author": "Adam Nagourney", "description": "This recipe, adapted from the Los Angeles restaurant Mozza, dresses mixed frisée lightly, with a simple dressing of two kinds of mustard, lemon juice and olive oil. It's done in minutes, and serves as a light, tart side for pretty much any occasion, whether a holiday feast or a weeknight meal. Adam Nagourney", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "PT5M"}}, "ingredients": [{"position": 1, "raw": "1 ½ teaspoons whole-grain mustard", "group": null, "quantity": 1.5, "unit": "tsp", "item": "whole-grain mustard", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ teaspoons Dijon mustard", "group": null, "quantity": 1.5, "unit": "tsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 3, "raw": "3 to 6 tablespoons freshly squeezed lemon juice", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "freshly squeezed lemon juice", "preparation": null, "optional": false, "quantity_max": 6.0}, {"position": 4, "raw": "½ cup extra-virgin olive oil", "group": null, "quantity": 0.5, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt", "group": null, "quantity": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "black pepper", "group": null, "quantity": null, "unit": null, "item": "black pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "14 ounces mixed frisée, radicchio and dandelion greens, washed, dried and torn into pieces", "group": null, "quantity": 14.0, "unit": "oz", "item": "mixed frisée", "preparation": "radicchio and dandelion greens, washed, dried and torn into pieces", "optional": false}], "steps": [{"position": 1, "text": "In a small mixing bowl, whisk together the mustards and 3 tablespoons of the lemon juice."}, {"position": 2, "text": "While whisking vigorously, drizzle in the olive oil until thickened. Adjust lemon juice to taste, and season with salt and pepper."}, {"position": 3, "text": "Place greens in a serving bowl and toss with just enough dressing to lightly coat them. Reserve any remaining dressing for another use."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 135.0, "protein_g": 2.4, "carbohydrates_g": 8.1, "fat_g": 11.4, "saturated_fat_g": 1.6, "unsaturated_fat_g": 1.4, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 322.4, "fiber_g": 3.5, "sugar_g": 1.0, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["green-salad"], "meal": [], "occasion": [], "other": ["dandelion-greens", "easy", "quick", "radicchio", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2017/05/09/dining/09SALADGUIDE7/09SALADGUIDE7-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2017/05/09/dining/09SALADGUIDE7/09SALADGUIDE7-superJumbo.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/images/2017/05/09/dining/09SALADGUIDE7/09SALADGUIDE7-facebookJumbo.jpg", "alt": "", "primary": false}], "rating": {"average": 4.0, "count": 643}, "video_url": null, "comment_count": null, "published_at": "2010-12-22", "scraped_at": "2026-09-06T22:37:10Z", "scraper_version": "1.0.0"}

{"slug": "rhubarb-butterscotch-sauce", "nyt_id": 1012570, "url": "https://cooking.nytimes.com/recipes/1012570-rhubarb-butterscotch-sauce", "name": "Rhubarb Butterscotch Sauce", "author": "Melissa Clark", "description": "", "servings": {"text": "2 cups, to serve 6 to 8", "min": 6, "max": 8, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": 20, "total_minutes": 20, "raw": {"cook": "PT20M", "total": "PT20M"}}, "ingredients": [{"position": 1, "raw": "1 pound rhubarb, trimmed and sliced ½-inch thick (about 4 cups)", "group": null, "quantity": 1.0, "unit": "lb", "item": "rhubarb", "preparation": "trimmed and sliced ½-inch thick (about 4 cups)", "optional": false}, {"position": 2, "raw": "½ cup dark brown sugar", "group": null, "quantity": 0.5, "unit": "cup", "item": "dark brown sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons unsalted butter", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 4, "raw": "Pinch kosher salt", "group": null, "quantity": null, "unit": null, "item": "pinch kosher salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "None"}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 145.25, "protein_g": 1.2, "carbohydrates_g": 23.3, "fat_g": 6.0, "saturated_fat_g": 3.7, "unsaturated_fat_g": 0.3, "trans_fat_g": null, "cholesterol_mg": 15.3, "sodium_mg": 40.2, "fiber_g": 2.2, "sugar_g": 18.9, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["brown-sugar", "quick", "rhubarb", "spring", "summer"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpape
{"slug": "lamb-patties-with-mushroom-sauce", "nyt_id": 10070, "url": "https://cooking.nytimes.com/recipes/10070-lamb-patties-with-mushroom-sauce", "name": "Lamb Patties With Mushroom Sauce", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "PT45M"}}, "ingredients": [{"position": 1, "raw": "1 ¼ pounds ground lean lamb", "group": null, "quantity": 1.25, "unit": "lb", "item": "ground lean lamb", "preparation": null, "optional": false}, {"position": 2, "raw": "3 tablespoons olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ cups finely chopped onions", "group": null, "quantity": 1.5, "unit": "cup", "item": "finely chopped onions", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon finely chopped garlic", "group": null, "quantity": 1.0, "unit": "tsp", "item": "finely chopped garlic", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon ground cumin", "group": null, "quantity": 1.0, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup finely chopped coriander or parsley", "group": null, "quantity": 0.5, "unit": "cup", "item": "finely chopped coriander or parsley", "preparation": null, "optional": false}, {"position": 7, "raw": "½ cup fine fresh bread crumbs", "group": null, "quantity": 0.5, "unit": "cup", "item": "fine fresh bread crumbs", "preparation": null, "optional": false}, {"position": 8, "raw": "1 egg, lightly beaten", "group": null, "quantity": 1.0, "unit": null, "item": "egg", "preparation": "lightly beaten", "optional": false}, {"position": 9, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 10, "raw": "1 tablespoon butter", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 11, "raw": "pound fresh mushrooms, thinly sliced, about 2 cups", "group": null, "quantity": null, "unit": null, "item": "pound fresh mushrooms", "preparation": "thinly sliced, about 2 cups", "optional": false}, {"position": 12, "raw": "2 tablespoons finely chopped shallots", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "finely chopped shallots", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ cup dry white wine", "group": null, "quantity": 0.25, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 14, "raw": "½ cup chopped peeled fresh tomatoes or canned crushed tomatoes", "group": null, "quantity": 0.5, "unit": "cup", "item": "chopped peeled fresh tomatoes or canned crushed tomatoes", "preparation": null, "optional": false}, {"position": 15, "raw": "¾ cup fresh or canned chicken broth", "group": null, "quantity": 0.75, "unit": "cup", "item": "fresh or canned chicken broth", "preparation": null, "optional": false}, {"position": 16, "raw": "1 teaspoon chopped fresh tarragon or ½ teaspoon dried", "group": null, "quantity": 1.0, "unit": "tsp", "item": "chopped fresh tarragon or ½ teaspoon dried", "preparation": null, "optional": false}, {"position": 17, "raw": "2 teaspoons arrowroot or cornstarch", "group": null, "quantity": 2.0, "unit": "tsp", "item": "arrowroot or cornstarch", "preparation": null, "optional": false}, {"position": 18, "raw": "1 tablespoon water", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "water", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the lamb in a mixing bowl."}, {"position": 2, "text": "Heat two tablespoons of the oil in a small skillet and add the onions and garlic. Cook briefly, stirring, until wilted. Sprinkle with cumin and stir, blending well. Cool briefly."}, {"position": 3, "text": "Scrape the onion mixture into the lamb. Add the coriander, bread crumbs, egg, salt and pepper. Blend well with fingers and shape the mixture into 20 patties. Set aside."}, {"position": 4, "text": "For the mushroom sauce, heat the butter in a saucepan and add the mushrooms, shallots, salt and pepper. Cook over medium-high heat until all the moisture from the mushrooms has evaporated."}, {"position": 5, "text": "Add the wine and simmer briefly over high heat. Add the tomatoes, broth and tarragon. Cook about 5 minutes, stirring occasionally."}, {"position": 6, "text": "Blend the arrowroot with the water. Stir into the sauce and cook briefly."}, {"position": 7, "text": "Meanwhile, heat the remaining olive oil in a nonstick skillet large enough to hold the patties in one layer. Add the patties and turn them so they brown evenly, about 5 minutes. Drain the fat."}, {"position": 8, "text": "Add the patties to the sauce, cover and simmer about 10 minutes."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 1175.25, "protein_g": 17.4, "carbohydrates_g": 22.3, "fat_g": 114.4, "saturated_fat_g": 54.0, "unsaturated_fat_g": 5.9, "trans_fat_g": null, "cholesterol_mg": 157.7, "sodium_mg": 1065.8, "fiber_g": 7.6, "sugar_g": 7.2, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-main-course"], "meal": [], "occasion": [], "other": ["ground-lamb", "mushroom", "onion", "weeknight"]}, "images": [{"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x675.png", "alt": "", "primary": true}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x900.png", "alt": "", "primary": false}, {"url": "https://cooking.nytimes.com/assets/recipe-wallpaper/wallpaper-1200x1200.png", "alt": "", "primary": false}], "rating": {"average": 5.0, "count": 29}, "video_url": null, "comment_count": null, "published_at": "1990-04-04", "scraped_at": "2026-09-
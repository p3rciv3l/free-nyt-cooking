{"slug": "oat-and-leek-soup", "nyt_id": 94, "url": "https://cooking.nytimes.com/recipes/94-oat-and-leek-soup", "name": "Oat-and-Leek Soup", "author": "Molly O’Neill", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 195, "total_minutes": 195, "raw": {"cook": "3 hours 15 minutes", "total": "3 hours 15 minutes"}}, "ingredients": [{"position": 1, "raw": "4 pounds beef, cut into ½-inch chunks", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "lb", "item": "beef", "preparation": "cut into ½-inch chunks", "optional": false}, {"position": 2, "raw": "6 tablespoons vegetable oil", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon kosher salt, plus more to taste", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": "plus more to taste", "optional": false}, {"position": 4, "raw": "Freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "4 pounds leeks, trimmed of roots and green parts", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "lb", "item": "leeks", "preparation": "trimmed of roots and green parts", "optional": false}, {"position": 6, "raw": "2 cups rolled oats", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "rolled oats", "preparation": null, "optional": false}, {"position": 7, "raw": "⅔ cup parsley", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a large pot, brown the beef in 2 tablespoons of the vegetable oil over medium heat. Add 3 quarts of water, 1 teaspoon of the salt and a few grinds of pepper. Bring to a boil, cover and simmer until meat is tender, about 2 ½ hours."}, {"position": 2, "text": "Meanwhile, split the leeks in half, rinse them well and slice them thinly. Saute half the leeks in 2 tablespoons vegetable oil over medium heat until softened, about 7 minutes. Transfer to a plate. Repeat with the remaining leeks."}, {"position": 3, "text": "When meat is done, remove the pot from the heat, remove the meat and let cool. Skim the fat from the pot. Over high heat, bring the broth to a boil and stir in the oats. Return to a boil, reduce heat and simmer 30 minutes."}, {"position": 4, "text": "When the oats are done, stir in the meat and warm thoroughly. Serve garnished with the parsley."}], "nutrition": {"calories": 605.7, "protein_g": 55.4, "carbohydrates_g": 47.4, "fat_g": 23.6, "saturated_fat_g": 5.5, "unsaturated_fat_g": null, "trans_fat_g": 0.6, "cholesterol_mg": 142.9, "sodium_mg": 345.9, "fiber_g": 6.5, "sugar_g": 9.2, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["beef", "boil", "dinner", "fall", "great leftovers", "leek", "one pot", "rolled oat", "soup"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1998-10-04", "scraped_at": "2026-09-07T09:47:16.363747+00:00", "scraper_version": "1.0.0"}

{"slug": "oatmeal-cookies", "nyt_id": 1518, "url": "https://cooking.nytimes.com/recipes/1518-oatmeal-cookies", "name": "Oatmeal Cookies", "author": "Mimi Sheraton", "description": "", "servings": {"text": "5 dozen", "min": 60, "max": 60, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "35 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ cups (¾ pound) unsalted butter", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "(¾ pound) unsalted butter", "preparation": null, "optional": false}, {"position": 2, "raw": "1 cup granulated sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 4, "raw": "2 teaspoons sifted baking soda", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "sifted baking soda", "preparation": null, "optional": false}, {"position": 5, "raw": "2 ¾ cups Quaker's old-fashioned oatmeal", "group": null, "quantity": 2.75, "quantity_max": null, "unit": "cup", "item": "quaker's old-fashioned oatmeal", "preparation": null, "optional": false}, {"position": 6, "raw": "2 ⅔ cups all-purpose flour", "group": null, "quantity": 2.6666666666666665, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ cups raisins", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "raisins", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 375 degrees."}, {"position": 2, "text": "Butter a cookie sheet and line with baker's parchment."}, {"position": 3, "text": "Cream butter and sugar until light and fluffy. Stir in v
{"slug": "oatmeal-tabbouleh", "nyt_id": 12744, "url": "https://cooking.nytimes.com/recipes/12744-oatmeal-tabbouleh", "name": "Oatmeal Tabbouleh", "author": "Martha Rose Shulman", "description": "This is a good tabbouleh alternative for those of you who can’t tolerate wheat, though you must seek out a brand of steel-cut oats that has been processed in a gluten-free facility if you need to avoid gluten. Unlike traditional tabbouleh, which is a really a parsley salad with a little bit of fine bulgur, this is more of a lemony grain salad with a generous amount of parsley and other herbs. For best results, toss the soaked oats with the dressing and refrigerate overnight.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "½ cup quick-cooking steel-cut oats", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "quick-cooking steel-cut oats", "preparation": null, "optional": false}, {"position": 2, "raw": "Salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup boiling water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "boiling water", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup fresh lemon juice", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon cumin seeds, lightly toasted and ground", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "cumin seeds", "preparation": "lightly toasted and ground", "optional": false}, {"position": 6, "raw": "¼ cup extra virgin olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup chopped fresh parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "chopped fresh parsley", "preparation": null, "optional": false}, {"position": 8, "raw": "2 to 4 tablespoons chopped fresh mint (to taste)", "group": null, "quantity": 2.0, "quantity_max": 4.0, "unit": "tbsp", "item": "chopped fresh mint (to taste)", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons chopped chives", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped chives", "preparation": null, "optional": false}, {"position": 10, "raw": "2 to 3 medium tomatoes, finely chopped (omit if not in season)", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": null, "item": "medium tomatoes", "preparation": "finely chopped (omit if not in season)", "optional": false}, {"position": 11, "raw": "1 cucumber, 2 Persian cucumbers, or ½ European cucumber, seeded if necessary and cut in small dice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "cucumber", "preparation": "2 Persian cucumbers, or ½ European cucumber, seeded if necessary and cut in small dice", "optional": false}], "steps": [{"position": 1, "text": "Combine the steel-cut oats and salt to taste in a bowl and pour on 1 cup of boiling water. Let sit for 25 to 30 minutes. Drain through a strainer and press the oats against the strainer with the back of your spoon to extract water. Transfer to a bowl."}, {"position": 2, "text": "Combine the lemon juice, salt to taste, cumin and olive oil and whisk together. Toss with the oats and let sit for at least 20 minutes or, preferably, cover and refrigerate overnight."}, {"position": 3, "text": "Add the remaining ingredients, toss together and let sit for 10 to 15 minutes or longer (in the refrigerator if longer than 15 minutes) before serving."}], "nutrition": {"calories": 182.3, "protein_g": 2.8, "carbohydrates_g": 12.4, "fat_g": 14.6, "saturated_fat_g": 2.0, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 455.6, "fiber_g": 2.8, "sugar_g": 2.7, "unsaturated_fat_g": 11.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["dairy-free", "gluten-free", "healthy", "high fiber", "low-sodium", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["boil", "halal", "low cholesterol", "oat", "parsley", "salad", "summer", "tomato"]}, "images": [{"url": "https://static01.nyt.com/images/2012/09/12/science/12recipehealth/12recipehealth-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 71}, "video_url": null, "comment_count": null, "published_at": "2012-09-12", "scraped_at": "2026-09-07T03:18:17.686371+00:00", "scraper_version": "1.0.0"}

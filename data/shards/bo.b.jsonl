{"slug": "boston-lettuce-and-endive-salad", "nyt_id": 12039, "url": "https://cooking.nytimes.com/recipes/12039-boston-lettuce-and-endive-salad", "name": "Boston Lettuce and Endive Salad", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 large heads Belgian endive", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large heads belgian endive", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon fresh lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon red wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "4 tablespoons canola or vegetable oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "canola or vegetable oil", "preparation": null, "optional": false}, {"position": 7, "raw": "1 head Boston lettuce cleaned, rinsed and patted dry", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "boston lettuce cleaned", "preparation": "rinsed and patted dry", "optional": false}, {"position": 8, "raw": "4 tablespoons chopped fresh scallions", "group": null, "quantity": 4.0, "q
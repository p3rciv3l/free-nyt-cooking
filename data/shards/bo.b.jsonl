{"slug": "boston-lettuce-and-endive-salad", "nyt_id": 12039, "url": "https://cooking.nytimes.com/recipes/12039-boston-lettuce-and-endive-salad", "name": "Boston Lettuce and Endive Salad", "author": "Pierre Franey", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 large heads Belgian endive", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large heads belgian endive", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 3, "raw": "1 tablespoon fresh lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon red wine vinegar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "red wine vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 6, "raw": "4 tablespoons canola or vegetable oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "canola or vegetable oil", "preparation": null, "optional": false}, {"position": 7, "raw": "1 head Boston lettuce cleaned, rinsed and patted dry", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "boston lettuce cleaned", "preparation": "rinsed and patted dry", "optional": false}, {"position": 8, "raw": "4 tablespoons chopped fresh scallions", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh scallions", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons chopped fresh chervil or parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh chervil or parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Trim off the bottom of the endives, cut them into inch-long pieces or cut them lengthwise into thin shreds. Drop the pieces into cold water to keep them from turning dark. Drain, spin or pat dry."}, {"position": 2, "text": "In a salad bowl, combine the mustard, lemon juice, vinegar, salt and pepper. Blend well with a wire whisk, then add the oil slowly to form an emulsion."}, {"position": 3, "text": "Place the salad greens, the scallions and chervil into the salad bowl and toss well with the dressing. Serve immediately."}], "nutrition": {"calories": 142.0, "protein_g": 1.2, "carbohydrates_g": 3.5, "fat_g": 14.3, "saturated_fat_g": 0.9, "trans_fat_g": 0.1, "cholesterol_mg": 0.0, "sodium_mg": 250.0, "fiber_g": 1.9, "sugar_g": 0.7, "unsaturated_fat_g": 12.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegan", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["lettuce", "salad"]}, "images": [], "rating": {"average": 4.0, "count": 14}, "video_url": null, "comment_count": null, "published_at": "1991-11-27", "scraped_at": "2026-09-06T23:52:43.202992+00:00", "scraper_version": "1.0.0"}
{"slug": "bozeman-flank-and-beans", "nyt_id": 4084, "url": "https://cooking.nytimes.com/recipes/4084-bozeman-flank-and-beans", "name": "Bozeman Flank And Beans", "author": "Molly O’Neill", "description": "", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 240, "raw": {"total": "4 hours"}}, "ingredients": [{"position": 1, "raw": "1 pound dry pinto beans, rinsed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "dry pinto beans", "preparation": "rinsed", "optional": false}, {"position": 2, "raw": "6 plum tomatoes, cut in half lengthwise", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "plum tomatoes", "preparation": "cut in half lengthwise", "optional": false}, {"position": 3, "raw": "4 frying peppers, cut in half lengthwise, cored, deribbed and seeded", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "frying peppers", "preparation": "cut in half lengthwise, cored, deribbed and seeded", "optional": false}, {"position": 4, "raw": "1 hot red pepper, seeded and cut across in ¼-inch slices", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "hot red pepper", "preparation": "seeded and cut across in ¼-inch slices", "optional": false}, {"position": 5, "raw": "1 teaspoon dry mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dry mustard", "preparation": null, "optional": false}, {"position": 6, "raw": "3 tablespoons molasses", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "molasses", "preparation": null, "optional": false}, {"position": 7, "raw": "4 teaspoons salt, plus more to taste", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 8, "raw": "1 teaspoon freshly ground black pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 9, "raw": "1 teaspoon olive oil or bacon fat", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "olive oil or bacon fat", "preparation": null, "optional": false}, {"position": 10, "raw": "1 medium onion, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "minced", "optional": false}, {"position": 11, "raw": "1 1-pound flank steak", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "1-pound flank steak", "preparation": null, "optional": false}, {"position": 12, "raw": "2 teaspoons kosher salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 13, "raw": "1 teaspoon coarsely ground black pepper", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "coarsely ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the beans in a large, heavy-bottom pot. Cover with 2 inches of water. Bring to a boil for 3 minutes. Remove from heat. Cover and let stand for 2 hours."}, {"position": 2, "text": "Preheat the oven to 400 degrees. Place the tomatoes and frying peppers, skin side up, on a baking sheet. Roast for 25 minutes. Carefully transfer the vegetables with their juices to a food processor or blender. Add the hot red pepper. Puree until smooth. Set aside. In a small bowl, stir together the mustard, molasses, salt and pepper. Set aside."}, {"position": 3, "text": "Drain beans, discard liquid and dry the pot. Set beans aside. Place the olive oil or bacon fat in the pot and warm over medium heat. Add the onion and cook until soft, about 5 minutes. Add the beans to the onion. Pour in enough water to barely cover the beans. Stir in the tomato-pepper puree and the molasses mixture. Cover. Bake until tender, about 1 ¾ hours, adding water as needed to keep beans very moist but not soupy. Add salt to taste."}, {"position": 4, "text": "Fifteen minutes before serving, season the steak with 1 teaspoon salt and pepper. Set aside. 10 minutes before serving, place a cast-iron skillet over high heat. Add the remaining salt to the skillet. Heat until hot. Quickly sear the steak, allowing it to cook 2 to 3 minutes on each side, depending on its thickness and how you like your steak cooked. Remove from pan. Let stand for 5 minutes. Slice and serve around beans."}], "nutrition": {"calories": 467.0, "protein_g": 34.0, "carbohydrates_g": 64.7, "fat_g": 8.4, "saturated_fat_g": 3.0, "trans_fat_g": 0.0, "cholesterol_mg": 51.4, "sodium_mg": 793.6, "fiber_g": 14.7, "sugar_g": 14.6, "unsaturated_fat_g": 4.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["southwestern"], "diet": ["dairy-free", "gluten-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "boil", "flank steak", "fry", "pinto bean", "roast"]}, "images": [], "rating": {"average": 3.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "1992-10-18", "scraped_at": "2026-09-07T00:29:36.289300+00:00", "scraper_version": "1.0.0"}

"optional": false}, {"position": 8, "raw": "2 sprigs fresh thyme or ½ teaspoon dried", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "sprig", "item": "fresh thyme or ½ teaspoon dried", "preparation": null, "optional": false}, {"position": 9, "raw": "1 shallot, peeled and cut in half", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "shallot", "preparation": "peeled and cut in half", "optional": false}, {"position": 10, "raw": "2 tablespoons pureed shallots and onions (see recipe)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "pureed shallots and onions (see recipe)", "preparation": null, "optional": false}, {"position": 11, "raw": "⅓ cup dry white wine", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 12, "raw": "⅓ cup water", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 14, "raw": "3 large tomatoes, about ½ pound each or slightly larger, for garnish", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "large tomatoes", "preparation": "about ½ pound each or slightly larger, for garnish", "optional": false}, {"position": 15, "raw": "6 sprigs watercress", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "sprig", "item": "watercress", "preparation": null, "optional": false}, {"position": 16, "raw": "Woodland sauce (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "woodland sauce (see recipe)", "preparation": null, "optional": false}, {"position": 17, "raw": "Zucchini cake mousse (see recipe)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "zucchini cake mousse (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 500 degrees."}, {"position": 2, "text": "Open up boned racks, fat side down. Arrange slices of garlic along base of the main meat portion. Roll flap around the main meat portion to enclose garlic neatly. Tie each rolled-up rack with string in several places."}, {"position": 3, "text": "Heat heavy oval baking dish large enough to hold tied racks plus chopped bones. Add oil and rolled racks. Scatter bones all around. Brown meat on all sides over high heat. Transfer dish to oven and bake 12 minutes."}, {"position": 4, "text": "Scatter carrot, onion, thyme and shallot around lamb and continue cooking 5 minutes. Remove racks and cover with foil to keep warm."}, {"position": 5, "text": "Carefully pour fat from pan. Place pan atop stove. Add pureed shallots and onions and cook briefly, stirring. Add wine and water and bring to boil over high heat, stirring occasionally. Cook 5 minutes. Strain sauce into saucepan and bring to boil. Swirl in butter."}, {"position": 6, "text": "Meanwhile, prepare tomatoes for garnish. Drop tomatoes into boiling water and let stand 12 seconds. Drain and peel. Cut each tomato into 6 wedges of equal size. Cut away pulp and seeds of each wedge, leaving only outer shell. Warm these shells briefly without cooking in microwave or regular oven."}, {"position": 7, "text": "To serve, cut meat into inch thick slices."}, {"position": 8, "text": "Spoon equal portions of woodland sauce onto each of 6 warmed plates. Unmold zucchini cake in center of sauce. Surround zucchini cake with slices of lamb. Spoon hot pan sauce over lamb. Garnish each serving with 3 warmed tomato wedges and 2 sprigs of watercress."}], "nutrition": {"calories": 1546.7, "protein_g": 57.2, "carbohydrates_g": 12.2, "fat_g": 139.2, "saturated_fat_g": 59.7, "trans_fat_g": 0.0, "cholesterol_mg": 292.4, "sodium_m
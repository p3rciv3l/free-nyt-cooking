{"slug": "yogurt-cucumber-relish", "nyt_id": 2017, "url": "https://cooking.nytimes.com/recipes/2017-yogurt-cucumber-relish", "name": "Yogurt Cucumber Relish", "author": "Robert Farrar Capon", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "About 15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 large cucumbers", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large cucumbers", "preparation": null, "optional": false}, {"position": 2, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "2 cups plain yogurt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "plain yogurt", "preparation": null, "optional": false}, {"position": 4, "raw": "1 small clove garlic, minced very fine", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small clove garlic", "preparation": "minced very fine", "optional": false}, {"position": 5, "raw": "1 quarter cup fresh coriander leaves, chopped coarse", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "quarter cup fresh coriander leaves", "preparation": "chopped coarse", "optional": false}, {"position": 6, "raw": "Additional salt as desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "additional salt as desired", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel cucumbers, cut them in half lengthwise, scrape out the seeds and cut the halves crosswise into ⅛-inch slices. Put slices in a bowl and mix with salt. Allow to stand 10 minutes. Empty slices into a colander and press them to remove excess moisture."}, {"position": 2, "text": "Combine cucumber slices with yogurt, garlic and coriander. Season to taste with salt and serve as a side dish with the tabbouleh."}], "nutrition": {"calories": 99.1, "protein_g": 5.3, "carbohydrates_g": 11.5, "fat_g": 4.2, "saturated_fat_g": 2.6, "trans_fat_g": 0.0, "cholesterol_mg": 15.9, "sodium_mg": 645.5, "fiber_g": 0.9, "sugar_g": 8.3, "unsaturated_fat_g": 1.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["middle eastern"], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["condiments", "coriander", "cucumber", "easy", "summer", "yogurt"]}, "images": [], "rating": {"average": 4.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "1985-06-12", "scraped_at": "2026-09-07T04:03:23.620693+00:00", "scraper_version": "1.0.0"}
{"slug": "yogurt-sauce", "nyt_id": 1751, "url": "https://cooking.nytimes.com/recipes/1751-yogurt-sauce", "name": "Yogurt Sauce", "author": "Julia Reed", "description": "", "servings": {"text": "2 cups", "min": 2, "max": 2, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "2 cups plain whole milk yogurt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "plain whole milk yogurt", "preparation": null, "optional": false}, {"position": 2, "raw": "2 garlic cloves, peeled and crushed or pushed through a garlic press", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "garlic cloves", "preparation": "peeled and crushed or pushed through a garlic press", "optional": false}, {"position": 3, "raw": "Pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place yogurt in cheesecloth or a muslin-lined strainer and drain over a bowl for 1 hour. Mix with garlic and salt to taste."}], "nutrition": {"calories": 77.0, "protein_g": 4.3, "carbohydrates_g": 6.2, "fat_g": 4.0, "saturated_fat_g": 2.6, "trans_fat_g": 0.0, "cholesterol_mg": 15.9, "sodium_mg": 93.5, "fiber_g": 0.0, "sugar_g": 5.7, "unsaturated_fat_g": 1.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["condiments", "garlic", "salt"]}, "images": [], "rating": {"average": 3.0, "count": 8}, "video_url": null, "comment_count": null, "published_at": "2003-12-07", "scraped_at": "2026-09-07T03:49:10.292093+00:00", "scraper_version": "1.0.0"}
{"slug": "yogurt-with-plantain-and-mango", "nyt_id": 5949, "url": "https://cooking.nytimes.com/recipes/5949-yogurt-with-plantain-and-mango", "name": "Yogurt With Plantain And Mango", "author": "Amanda Hesser", "description": "Amanda Hesser", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "1 medium yellow plantain, peeled and cut into ¾-inch dice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium yellow plantain", "preparation": "peeled and cut into ¾-inch dice", "optional": false}, {"position": 2, "raw": "1 ½ cups plain yogurt", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "plain yogurt", "preparation": null, "optional": false}, {"position": 3, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon vegetable oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "vegetable oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon yellow split peas (chana dal)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "yellow split peas (chana dal)", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon whole brown mustard seeds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "whole brown mustard seeds", "preparation": null, "optional": false}, {"position": 7, "raw": "2 hot, dried, red chilies, halved", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "hot", "preparation": "dried, red chilies, halved", "optional": false}, {"position": 8, "raw": "15 fresh curry leaves or basil leaves", "group": null, "quantity": 15.0, "quantity_max": null, "unit": null, "item": "fresh curry leaves or basil leaves", "preparation": null, "optional": false}, {"position": 9, "raw": "1 medium shallot, peeled and cut into fine slivers", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium shallot", "preparation": "peeled and cut into fine slivers", "optional": false}, {"position": 10, "raw": "3 thin slices of fresh, peeled ginger cut into fine shreds", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "thin slices of fresh", "preparation": "peeled ginger cut into fine shreds", "optional": false}, {"position": 11, "raw": "1 cup ¾-inch diced mango", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "¾-inch diced mango", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place plantain in small pan. Cover with water, and bring to boil. Cover, reduce heat to low and cook until plantain is tender, about 10 to 15 minutes. Drain, and set aside."}, {"position": 2, "text": "In small bowl, beat yogurt with fork until smooth and creamy. Slowly add 1 cup water and the salt. Stir to mix, and set aside."}, {"position": 3, "text": "Put oil in small, deep frying pan, and set over medium heat. When oil becomes hot, put in the split peas. Stir until peas just start to turn reddish. Add mustard seeds. As soon as seeds begin to pop, a matter of seconds, add red chilies. Stir once, and add curry leaves. Stir again, and then add shallot and ginger. Reduce heat to medium-low. Stir and fry shallot and ginger until golden, about 2 minutes. Add this to the yogurt, and stir to combine. Add diced plantain and mango. Stir to mix. Serve at room temperature or cold with steamed basmati rice. As you are eating, discard curry leaves as you come across them."}], "nutrition": {"calories": 221.2, "protein_g": 5.6, "carbohydrates_g": 37.5, "fat_g": 7.2, "saturated_fat_g": 2.2, "trans_fat_g": 0.0, "cholesterol_mg": 11.9, "sodium_mg": 340.5, "fiber_g": 3.0, "sugar_g": 24.2, "unsaturated_fat_g": 4.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free"], "course": ["main course"], "meal": [], "occasion": [], "other": ["curry powder", "deep fry", "plantain", "yogurt"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1998-07-29", "scraped_at": "2026-09-07T07:57:43.375843+00:00", "scraper_version": "1.0.0"}
{"slug": "yotam-ottolenghis-chermoula-eggplant-with-bulgur-and-yogurt", "nyt_id": 12957, "url": "https://cooking.nytimes.com/recipes/12957-yotam-ottolenghis-chermoula-eggplant-with-bulgur-and-yogurt", "name": "Yotam Ottolenghi’s Chermoula Eggplant With Bulgur and Yogurt", "author": "Tara Parker-Pope", "description": "A mixture of herbs and spices used in North African cooking, chermoula is often used to season fish. In this recipe from \"Jerusalem,\" the famed Middle Eastern cookbook by Yotam Ottolenghi, it is rubbed over eggplant, which is then roasted and topped with a tabbouleh-like salad. Tara Parker-Pope", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "About 1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 cloves garlic, crushed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "crushed", "optional": false}, {"position": 2, "raw": "2 teaspoons ground cumin", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "ground cumin", "preparation": null, "optional": false}, {"position": 3, "raw": "2 teaspoons ground coriander", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "ground coriander", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon chili flakes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chili flakes", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon sweet paprika", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sweet paprika", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons finely chopped preserved lemon peel (available in stores)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped preserved lemon peel (available in stores)", "preparation": null, "optional": false}, {"position": 7, "raw": "⅔ cup olive oil, plus extra to finish", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": "plus extra to finish", "optional": false}, {"position": 8, "raw": "2 medium eggplants", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium eggplants", "preparation": null, "optional": false}, {"position": 9, "raw": "1 cup fine bulgur", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fine bulgur", "preparation": null, "optional": false}, {"position": 10, "raw": "⅔ cup boiling water", "group": null, "quantity": 0.6666666666666666, "quantity_max": null, "unit": "cup", "item": "boiling water", "preparation": null, "optional": false}, {"position": 11, "raw": "⅓ cup golden raisins", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "golden raisins", "preparation": null, "optional": false}, {"position": 12, "raw": "3 ½ tablespoons warm water", "group": null, "quantity": 3.5, "quantity_max": null, "unit": "tbsp", "item": "warm water", "preparation": null, "optional": false}, {"position": 13, "raw": "⅓ ounce (2 teaspoons) cilantro, chopped, plus extra to finish", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "oz", "item": "(2 teaspoons) cilantro", "preparation": "chopped, plus extra to finish", "optional": false}, {"position": 14, "raw": "⅓ ounce (2 teaspoons) mint, chopped", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "oz", "item": "(2 teaspoons) mint", "preparation": "chopped", "optional": false}, {"position": 15, "raw": "⅓ cup pitted green olives, halved", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "pitted green olives", "preparation": "halved", "optional": false}, {"position": 16, "raw": "⅓ cup sliced almonds, toasted", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "sliced almonds", "preparation": "toasted", "optional": false}, {"position": 17, "raw": "3 green onions, chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "green onions", "preparation": "chopped", "optional": false}, {"position": 18, "raw": "1 ½ tablespoons freshly squeezed lemon juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "freshly squeezed lemon juice", "preparation": null, "optional": false}, {"position": 19, "raw": "½ cup Greek yogurt (optional)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "greek yogurt", "preparation": null, "optional": true}, {"position": 20, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 400 degrees."}, {"position": 2, "text": "To make the chermoula, mix together in a small bowl the garlic, cumin, coriander, chili, paprika, preserved lemon, two-thirds of the olive oil, and ½ teaspoon salt."}, {"position": 3, "text": "Cut the eggplants in half lengthwise. Score the flesh of each half with deep, diagonal crisscross cuts, making sure not to pierce the skin. Spoon the chermoula over each half, spreading it evenly, and place the eggplant halves on a baking sheet, cut side up. Put in the oven and roast for 40 minutes, or until the eggplants are completely soft."}, {"position": 4, "text": "Meanwhile, place the bulgur in a large bowl and cover with the boiling water."}, {"position": 5, "text": "Soak the raisins in the warm water. After 10 minutes, drain the raisins and add them to the bulgur, along with the remaining oil. Add the herbs, olives, almonds, green onions, lemon juice and a pinch of salt and stir to combine. Taste and add more salt if necessary."}, {"position": 6, "text": "Serve the eggplants warm or at 
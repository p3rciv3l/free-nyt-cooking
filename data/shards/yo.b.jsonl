{"slug": "yogurt-berry-parfait-with-steel-cut-oats", "nyt_id": 12746, "url": "https://cooking.nytimes.com/recipes/12746-yogurt-berry-parfait-with-steel-cut-oats", "name": "Yogurt Berry Parfait With Steel-Cut Oats", "author": "Martha Rose Shulman", "description": "This is a great way to enjoy both steel-cut oats and yogurt, whether or not you use the yogurt for this parfait. The oats soften overnight in the yogurt and thicken the yogurt at the same time. Look for organic yogurt that has no thickeners or gums added to it.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes, plus 12 hours' sitting and 1 hours' chilling"}}, "ingredients": [{"position": 1, "raw": "6 tablespoons quick-cooking steel-cut oats", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "quick-cooking steel-cut oats", "preparation": null, "optional": false}, {"position": 2, "raw": "2 cups Greek-style yogurt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "greek-style yogurt", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup clover honey or organic sugar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "clover honey or organic sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cups blueberries or mixed raspberries, blackberries and blueberries", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "blueberries or mixed raspberries", "preparation": "blackberries and blueberries", "optional": false}, {"position": 5, "raw": "2 teaspoons freshly squeezed lime juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "freshly squeezed lime juice", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon balsamic vinegar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 7, "raw": "1 tablespoon shelled pistachios, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "shelled pistachios", "preparation": "finely chopped", "optional": false}], "steps": [{"position": 1, "text": "Heat a dry skillet over medium-high heat and add the oatmeal. Toast, stirring or shaking the pan, until the oatmeal begins to color and smell toasty. Transfer to a bowl and allow to cool. Stir into the yogurt along with 4 teaspoons of the honey or sugar, cover tightly and refrigerate overnight."}, {"position": 2, "text": "The next day, combine the berries, remaining honey or sugar, lime juice and balsamic vinegar in a medium saucepan and bring to a boil over medium heat. Cook for 5 to 10 minutes, until the liquid is reduced and the berries have cooked down to a jamlike consistency. Allow to cool. You should have about 1 cup of thick, jammy sauce."}, {"position": 3, "text": "Spoon or pipe ¼ cup of the yogurt/oatmeal mix into the bottom of each of 4 tumblers or parfait glasses. Top with 2 tablespoons of the berry sauce. Make another ¼ cup layer of yogurt on top of the berry sauce, and finish with another layer of berry sauce. Cover tightly and chill for at least 1 hour. Just before serving, sprinkle finely chopped pistachios over the top."}], "nutrition": {"calories": 376.8, "protein_g": 14.8, "carbohydrates_g": 63.9, "fat_g": 10.3, "saturated_fat_g": 5.0, "trans_fat_g": 0.0, "cholesterol_mg": 19.2, "sodium_mg": 71.3, "fiber_g": 12.3, "sugar_g": 43.5, "unsaturated_fat_g": 1.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "healthy", "high fiber", "low-sodium", "vegetarian"], "course": ["main course"], "meal": ["breakfast"], "occasion": [], "other": ["berry", "boil", "halal", "low cholesterol", "oat", "parfaits and trifles", "saute", "summer", "yogurt"]}, "images": [{"url": "https://static01.nyt.com/images/2012/09/12/science/14recipehealth/14recipehealth-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 141}, "video_url": null, "comment_count": null, "published_at": "2012-09-14", "scraped_at": "2026-09-07T03:18:23.954434+00:00", "scraper_version": "1.0.0"}

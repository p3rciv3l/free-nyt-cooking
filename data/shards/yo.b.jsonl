{"slug": "yogurt-and-basil-sauce", "nyt_id": 2377, "url": "https://cooking.nytimes.com/recipes/2377-yogurt-and-basil-sauce", "name": "Yogurt and Basil Sauce", "author": "Moira Hodgson", "description": "", "servings": {"text": "1 1/2 cups", "min": 1, "max": 1, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 5, "raw": {"total": "5 minutes"}}, "ingredients": [{"position": 1, "raw": "1 cup plain yogurt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "plain yogurt", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup fresh basil leaves, chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "fresh basil leaves", "preparation": "chopped", "optional": false}, {"position": 3, "raw": "1 clove garlic, minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 4, "raw": "Juice of half lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of half lemon", "preparation": null, "optional": false}, {"position": 5, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine all the ingredients in a small bowl. Use as a sauce for eggplant and lamb kebabs."}], "nutrition": {"calories": 55.7, "protein_g": 3.2, "carbohydrates_g": 5.3, "fat_g": 2.7, "saturated_fat_g": 1.7, "trans_fat_g": 0.0, "cholesterol_mg": 10.6, "sodium_mg": 223.9, "fiber_g": 0.4, "sugar_g": 4.1, "unsaturated_fat_g": 0.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": []}, "images": [], "rating": {"average": 5.0, "count": 5}, "video_url": null, "comm
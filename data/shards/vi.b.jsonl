{"slug": "vincent-scottos-onion-salad", "nyt_id": 11495, "url": "https://cooking.nytimes.com/recipes/11495-vincent-scottos-onion-salad", "name": "Vincent Scotto's Onion Salad", "author": "Jonathan Reynolds", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "About 1 hour"}}, "ingredients": [{"position": 1, "raw": "4 large yellow onions, unpeeled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large yellow onions", "preparation": "unpeeled", "optional": false}, {"position": 2, "raw": "10 tablespoons olive oil", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "Kosher salt to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "2 slices Tuscan bread, ¾-inch thick", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "slice", "item": "tuscan bread", "preparation": "¾-inch thick", "optional": false}, {"position": 5, "raw": "1 clove garlic, unpeeled, halved", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "unpeeled, halved", "optional": false}, {"position": 6, "raw": "¼ cup fresh parsley leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fresh parsley leaves", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup shaved Parmesan cheese", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "shaved parmesan cheese", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons fresh lemon juice", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "fresh lemon juice", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat a griddle over medium-low heat until hot. Cut off the ends of each onion so that you can see the rings. Cut the onions crosswise into ¾-inch to 1-inch slices, keeping the rings intact and the skins on as much as possible. Brush cut sides with 4 tablespoons of the oil and sprinkle with salt. Grill slices until tender and caramelized, about 20 minutes per side. If they burn, scrape off the charred portion. (A little tastes O.K.) Let cool."}, {"position": 2, "text": "Meanwhile, grill the bread until toasted, rub on both sides with the cut sides of the garlic and sprinkle with 2 tablespoons of the oil and salt. Cut into crouton-size pieces."}, {"position": 3, "text": "When onions are cool, remove remaining skins and separate into rings -- they will resemble small bottomless bowls. Divide ½ among 4 plates, sprinkle with ½ the parsley, ½ the Parmesan and ½ the croutons. Repeat with the remaining ingredients on top. Drizzle with the lemon juice and the remaining oil."}], "nutrition": {"calories": 439.5, "protein_g": 6.7, "carbohydrates_g": 22.5, "fat_g": 36.9, "saturated_fat_g": 6.2, "trans_fat_g": 0.0, "cholesterol_mg": 6.3, "sodium_mg": 519.7, "fiber_g": 3.3, "sugar_g": 7.5, "unsaturated_fat_g": 29.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["grill", "onion", "salad", "saute"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2002-11-10", "scraped_at": "2026-09-06T23:47:18.423718+00:00", "scraper_version": "1.0.0"}

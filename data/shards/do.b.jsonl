{"slug": "double-vanilla-pound-cake", "nyt_id": 2175, "url": "https://cooking.nytimes.com/recipes/2175-double-vanilla-pound-cake", "name": "Double Vanilla Pound Cake", "author": "Jeannette Ferrary", "description": "", "servings": {"text": "8 to 10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": 15, "cook_minutes": 60, "total_minutes": 75, "raw": {"total": "1 hour 15 minutes", "prep": "15 minutes", "cook": "1 hour"}}, "ingredients": [{"position": 1, "raw": "8 tablespoons butter at room temperature, plus butter for greasing pan", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "tbsp", "item": "butter at room temperature", "preparation": "plus butter for greasing pan", "optional": false}, {"position": 2, "raw": "2 cups all-purpose flour, plus flour for dusting the pan", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": "plus flour for dusting the pan", "optional": false}, {"position": 3, "raw": "1 ½ cups sugar", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "Pinch salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch salt", "preparation": null, "optional": false}, {"position": 5, "raw": "5 large eggs", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon pure vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "pure vanilla extract", "preparation": null, "optional": false}, {"position": 7, "raw": "1 vanilla bean", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "vanilla bean", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 325 degrees. Grease and flour 9-inch tube pan."}, {"position": 2, "text": "In large mixing bowl, cream butter, sugar and salt. Add eggs one at a time, beating well after each addition, stirring in a bit of the flour after the third egg. Add remaining flour, mixing until well combined."}, {"position": 3, "text": "Scrape the insides from one inch of a vanilla bean and add along with the teaspoon of vanilla, blending well. Pour batter into prepared pan and bake 1 hour."}, {"position": 4, "text": "Remove from oven, let cool on wire rack about 15 minutes and unmold. When cool, store covered with plastic wrap or foil. Serve with fresh raspberries or vanilla ice cream."}], "nutrition": {"calories": 330.0, "protein_g": 5.9, "carbohydrates_g": 50.0, "fat_g": 11.8, "saturated_fat_g": 6.6, "trans_fat_g": 0.0, "cholesterol_mg": 117.4, "sodium_mg": 52.4, "fiber_g": 0.7, "sugar_g": 30.2, "unsaturated_fat_g": 4.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["dessert"], "meal": [], "occasion": [], "other": ["all-purpose flour", "bake", "egg", "vanilla bean"]}, "images": [], "rating": {"average": 4.0, "count": 22}, "video_url": null, "comment_count": null, "published_at": "1988-01-13", "scraped_at": "2026-09-07T04:13:53.610586+00:00", "scraper_version": "1.0.0"}
{"slug": "double-veal-chops-with-braised-spring-vegetables", "nyt_id": 9138, "url": "https://cooking.nytimes.com/recipes/9138-double-veal-chops-with-braised-spring-vegetables", "name": "Double Veal Chops With Braised Spring Vegetables", "author": "Bryan Miller", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "4 tablespoons olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 3, "raw": "½ pound lean veal trimmings for stew, cubed", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "lean veal trimmings for stew", "preparation": "cubed", "optional": false}, {"position": 4, "raw": "2 thick loin veal chops, 1 ½ pounds each", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "thick loin veal chops", "preparation": "1 ½ pounds each", "optional": false}, {"position": 5, "raw": "10 garlic cloves, unpeeled", "group": null, "quantity": 10.0, "quantity_max": null, "unit": null, "item": "garlic cloves", "preparation": "unpeeled", "optional": false}, {"position": 6, "raw": "Sea salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sea salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "1 ½ cups homemade chicken broth, or canned", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "homemade chicken broth", "preparation": "or canned", "optional": false}, {"position": 8, "raw": "4 ounces pancetta, cut into 4 pieces", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "pancetta", "preparation": "cut into 4 pieces", "optional": false}, {"position": 9, "raw": "1 pound small new potatoes, halved", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "small new potatoes", "preparation": "halved", "optional": false}, {"position": 10, "raw": "4 large carrots, ½ pound, peeled and trimmed, halved on a bias", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large carrots", "preparation": "½ pound, peeled and trimmed, halved on a bias", "optional": false}, {"position": 11, "raw": "20 pearl onions, peeled", "group": null, "quantity": 20.0, "quantity_max": null, "unit": null, "item": "pearl onions", "preparation": "peeled", "optional": false}, {"position": 12, "raw": "4 stalks salsify, peeled and cut into the same length as carrots", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "stalk", "item": "salsify", "preparation": "peeled and cut into the same length as carrots", "optional": false}, {"position": 13, "raw": "4 scallions, cleaned and trimmed", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "cleaned and trimmed", "optional": false}, {"position": 14, "raw": "8 asparagus spears, peeled and trimmed", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "asparagus spears", "preparation": "peeled and trimmed", "optional": false}, {"position": 15, "raw": "2 cups sugar snap peas, trimmed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "sugar snap peas", "preparation": "trimmed", "optional": false}, {"position": 16, "raw": "1 bunch broccoli rabe, hard stems removed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "broccoli rabe", "preparation": "hard stems removed", "optional": false}], "steps": [{"position": 1, "text": "In a heavy skillet large enough to hold the veal chops in one layer, add 2 tablespoons of olive oil and 1 tablespoon butter. Add the veal trimmings. Over medium-high heat, brown for 5 minutes, stirring. Add the veal chops and garlic. Season well with sea salt and pepper. Cook the veal chops for about 10 minutes a side, moving the chops around the pan periodically. Remove the veal chops, leaving the garlic and the veal trimming in the pan. Drain all fat from the skillet."}, {"position": 2, "text": "Add the chicken broth to the pan. Deglaze over high heat, reducing by half. Check seasonings. Return the veal chops to the pan with any of their accumulated juices. Remove from the heat, and keep warm."}, {"position": 3, "text": "Meanwhile, in a large skillet, preferably cast iron, brown the pancetta over medium heat in 2 tablespoons olive oil. Cook for 2 minutes, stirring, and add the potatoes, carrots, onions, salsify and scallions. Reduce heat to medium-low. Cook, stirring, for 30 minutes."}, {"position": 4, "text": "Bring 4 cups of salted water to a boil. Add the asparagus, sugar snap peas and broccoli rabe. Return to a boil, and cook for 1 minute. Drain well."}, {"position": 5, "text": "Add remaining butter to the vegetable skillet. Add the drained vegetables. Check for seasonings."}, {"position": 6, "text": "Slice the veal thinly and serve with vegetables and reduced pan juices. Include garlic cloves if desired."}], "nutrition": null, "tags": {"cuisine": ["italian"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": ["christmas"], "other": ["fall", "pancetta", "saute", "veal", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1994-04-20", "scraped_at": "2026-09-07T01:27:15.832832+00:00", "scraper_version": "1.0.0"}
{"slug": "dough-for-pissaladiere-or-tarte-flambee", "nyt_id": 9676, "url": "https://cooking.nytimes.com/recipes/9676-dough-for-pissaladiere-or-tarte-flambee", "name": "Dough For Pissaladiere Or Tarte Flambee", "author": "Mark Bittman", "description": "", "servings": {"text": "Enough dough for 2 pizzas, each about 12 inches", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 teaspoon instant or rapid-rise yeast", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "instant or rapid-rise yeast", "preparation": null, "optional": false}, {"position": 2, "raw": "3 cups (about 14 ounces) all-purpose or bread flour, plus more as needed", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "(about 14 ounces) all-purpose or bread flour", "preparation": "plus more as needed", "optional": false}, {"position": 3, "raw": "2 teaspoons salt", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons plus 1 teaspoon olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "plus 1 teaspoon olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine yeast, flour and salt in food processor. Turn machine on, and add 1 cup water and 2 tablespoons oil through feed tube."}, {"position": 2, "text": "Process for about 30 seconds, adding more water through feed tube, a little at a time, until mixture forms a ball and is slightly sticky to the touch. If it is dry, add another tablespoon or two of water, and process for another 10 seconds. (In unlikely event that mixture is too sticky, add flour, a tablespoon at a time.)"}, {"position": 3, "text": "Turn dough onto floured work surface, and knead by hand for a few seconds to form a smooth, round ball. Grease bowl with remaining olive oil, and place dough in it. Cover with plastic wrap or damp cloth, and let rise in warm, draft-free area until dough just about doubles in size, or at least 1 hour. (You can also let dough rise more slowly, in refrigerator, for as long as 6 or 8 hours.)"}, {"position": 4, "text": "Follow recipe for pissaladiere or tarte flambee."}], "nutrition": {"calories": 862.1, "protein_g": 24.6, "carbohydrates_g": 144.7, "fat_g": 19.2, "saturated_fat_g": 2.7, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 502.8, "fiber_g": 5.3, "sugar_g": 0.6, "unsaturated_fat_g": 15.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["active dry yeast", "all-purpose flour", "bake", "olive oil", "pizza and calzones", "project"]}, "images": [], "rating": {"average": 4.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "1998-09-23", "scraped_at": "2026-09-07T01:32:20.023898+00:00", "scraper_version": "1.0.0"}
{"slug": "down-east-clam-pie", "nyt_id": 10943, "url": "https://cooking.nytimes.com/recipes/10943-down-east-clam-pie", "name": "Down East Clam Pie", "author": "Nancy Harmon Jenkins", "description": "", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 pound shucked steamer clams", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "shucked steamer clams", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup minced yellow onion", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "minced yellow onion", "preparation": null, "optional": false}, {"position": 3, "raw": "¼ cup minced red bell pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "minced red bell pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons minced flat-leaf parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "minced flat-leaf parsley", "preparation": null, "optional": false}, {"position": 5, "raw": "6 tablespoons unsalted butter", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 6, "raw": "24 saltine crackers", "group": null, "quantity": 24.0, "quantity_max": null, "unit": null, "item": "saltine crackers", "preparation": null, "optional": false}, {"position": 7, "raw": "¾ cup milk or half-and-half", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "milk or half-and-half", "preparation": null, "optional": false}, {"position": 8, "raw": "2 large eggs, lightly beaten", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "lightly beaten", "optional": false}, {"position": 9, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ to ½ teaspoon ground red chili pepper, optional", "group": null, "quantity": 0.25, "quantity_max": 0.5, "unit": "tsp", "item": "ground red chili pepper", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "Heat oven to 325 degrees. Pick over clams, and set them in a colander over a bowl to collect juices. When clams are well drained, transfer them to another bowl."}, {"position": 2, "text": "In a sauté pan, combine onion, red pepper and parsley with 2 tablespoons butter; cook gently over medium-low heat until vegetables are very soft but not brown. Add to bowl with clams. Crumble half the saltines in your hands, and stir into clam mixture."}, {"position": 3, "text": "Measure amount of juice from clams and add enough milk or half-and-half to make 1 cup. Add to clam mixture along with eggs, and stir to mix well. Add salt and black pepper to taste, and chili pepper, if you wish."}, {"position": 4, "text": "Use ½ tablespoon butter to butter bottom and sides of a 1-quart baking or soufflé dish. Turn clam mixture into dish."}, {"position": 5, "text": "Crumble remaining saltines a little more finely than first batch. In sauté pan, combine cracker crumbs with remaining butter; cook over medium heat just until they start to brown. Spoon crumbs over clams, and set dish in oven for 1 hour, checking after 45 minutes. If top of casserole is still pale, turn heat to 425 degrees for last 15 minutes. If it is starting to get too brown, place a sheet of aluminum foil loosely over top while casserole finishes cooking. Remove from oven and serve immediately."}], "nutrition": {"calories": 286.5, "protein_g": 15.6, "carbohydrates_g": 14.4, "fat_g": 18.4, "saturated_fat_g": 10.2, "trans_fat_g": 0.2, "cholesterol_mg": 125.8, "sodium_mg": 612.3, "fiber_g": 0.7, "sugar_g": 2.0, "unsaturated_fat_g": 6.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "clam", "seafood"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2002-08-21", "scraped_at": "2026-09-07T01:56:30.072073+00:00", "scraper_version": "1.0.0"}

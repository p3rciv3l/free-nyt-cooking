{"slug": "dolly-sinatras-marinara-sauce", "nyt_id": 11648, "url": "https://cooking.nytimes.com/recipes/11648-dolly-sinatras-marinara-sauce", "name": "Dolly Sinatra's Marinara Sauce", "author": "Alex Witchel", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "½ cup olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 small onion, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small onion", "preparation": "finely chopped", "optional": false}, {"position": 3, "raw": "3 garlic cloves, finely chopped", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "garlic cloves", "preparation": "finely chopped", "optional": false}, {"position": 4, "raw": "1 (28-ounce) can crushed tomatoes with puree", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(28-ounce) can crushed tomatoes with puree", "preparation": null, "optional": false}, {"position": 5, "raw": "1 sprig fresh oregano, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "sprig", "item": "fresh oregano", "preparation": "finely chopped", "optional": false}, {"position": 6, "raw": "1 teaspoon dried basil, crumbled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "dried basil", "preparation": "crumbled", "optional": false}, {"position": 7, "raw": "1 teaspoon Italian seasoning, crumbled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "italian seasoning", "preparation": "crumbled", "optional": false}, {"position": 8, "raw": "Salt and pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oil in a large saucepan over medium-high heat. Add the onion and cook, stirring, until tender, about 5 minutes. Add the garlic and cook, stirring, until the oil is fragrant and is seasoned, about 2 minutes. Stir in the tomatoes, and purée. Heat to simmering, and cook on low heat until the sauce thickens, about 20 minutes."}, {"position": 2, "text": "Add the oregano, basil and Italian seasoning, and mix well. Season with salt and pepper. Cook on low heat for another 15 minutes or so as it thickens."}], "nutrition": {"calories": 738.4, "protein_g": 18.6, "carbohydrates_g": 102.8, "fat_g": 29.4, "saturated_fat_g": 4.2, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 838.6, "fiber_g": 8.4, "sugar_g": 12.6, "unsaturated_fat_g": 23.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["gluten-free", "vegan", "vegetarian"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["easy", "garlic", "saute", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 56}, "video_url": null, "comment_count": null, "published_at": "2003-11-02", "scraped_at": "2026-09-07T02:30:35.476830+00:00", "scraper_version": "1.0.0"}
{"slug": "dom-yam-gung-spiced-shrimp-soup", "nyt_id": 1950, "url": "https://cooking.nytimes.com/recipes/1950-dom-yam-gung-spiced-shrimp-soup", "name": "Dom Yam Gung (Spiced Shrimp Soup)", "author": "Marian Burros", "description": "Marian Burros", "servings": {"text": "5 1/2 cups ", "min": 5, "max": 5, "yield_type": "volume"}, "time": {"prep_minutes": 18, "cook_minutes": 14, "total_minutes": 28, "raw": {"total": "28 minutes", "prep": "18 minutes", "cook": "14 minutes"}}, "ingredients": [{"position": 1, "raw": "6 peppercorns", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "peppercorns", "preparation": null, "optional": false}, {"position": 2, "raw": "8 coriander roots", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "coriander roots", "preparation": null, "optional": false}, {"position": 3, "raw": "3 stalks lemon grass", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "stalk", "item": "lemon grass", "preparation": null, "optional": false}, {"position": 4, "raw": "4 cups fish stock", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "fish stock", "preparation": null, "optional": false}, {"position": 5, "raw": "3 slices Siamese ginger", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "slice", "item": "siamese ginger", "preparation": null, "optional": false}, {"position": 6, "raw": "2 cups large shelled uncooked shrimp", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "large shelled uncooked shrimp", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons lime juice", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "lime juice", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons fish sauce (nam pla)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "fish sauce (nam pla)", "preparation": null, "optional": false}, {"position": 9, "raw": "2 to 5 chilies, seeded and finely minced (prik khee nu)", "group": null, "quantity": 2.0, "quantity_max": 5.0, "unit": null, "item": "chilies", "preparation": "seeded and finely minced (prik khee nu)", "optional": false}, {"position": 10, "raw": "2 tablespoons chopped coriander sprigs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped coriander sprigs", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "With a food processor running, add peppercorns and coriander root slowly and process to a paste."}, {"position": 2, "text": "Trim root end off lemon grass and peel away tough layers. Thinly slice first six inches of each stalk."}, {"position": 3, "text": "Bring fish stock to a boil. Add coriander-pepper mixture and simmer while adding lemon grass, ginger and shrimp. Stir in remaining stock and return to boil."}, {"position": 4, "text": "Season to taste with lime juice, fish sauce and chilies."}, {"position": 5, "text": "Sprinkle each serving with chopped coriander"}], "nutrition": {"calories": 109.1, "protein_g": 15.7, "carbohydrates_g": 6.6, "fat_g": 2.8, "saturated_fat_g": 0.5, "trans_fat_g": 0.0, "cholesterol_mg": 136.0, "sodium_mg": 1415.6, "fiber_g": 2.1, "sugar_g": 0.6, "unsaturated_fat_g": 1.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["thai"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["boil", "fish broth", "lemongrass", "quick", "shrimp", "soup"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1987-03-18", "scraped_at": "2026-09-07T04:00:02.550667+00:00", "scraper_version": "1.0.0"}
{"slug": "dorie-greenspans-chocolate-pudding", "nyt_id": 1843, "url": "https://cooking.nytimes.com/recipes/1843-dorie-greenspans-chocolate-pudding", "name": "Dorie Greenspan’s Chocolate Pudding", "author": "Amanda Hesser", "description": "This chocolate pudding, which is adapted from Dorie Greenspan, is everything you want in a creamy dessert: It’s light and airy, just sweet enough, not too sticky, and above all, it tastes of good-quality chocolate. Amanda Hesser", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 250, "raw": {"total": "10 minutes, plus chilling"}}, "ingredients": [{"position": 1, "raw": "2 ¼ cups whole milk", "group": null, "quantity": 2.25, "quantity_max": null, "unit": "cup", "item": "whole milk", "preparation": null, "optional": false}, {"position": 2, "raw": "6 tablespoons sugar", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons cocoa", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "cocoa", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons cornstarch", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ teaspoon salt", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "1 large egg", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large egg", "preparation": null, "optional": false}, {"position": 7, "raw": "2 large egg yolks", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large egg yolks", "preparation": null, "optional": false}, {"position": 8, "raw": "5 ounces bittersweet chocolate, melted and still warm", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "oz", "item": "bittersweet chocolate", "preparation": "melted and still warm", "optional": false}, {"position": 9, "raw": "2 tablespoons unsalted butter, at room temperature and cut into 4 pieces", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": "at room temperature and cut into 4 pieces", "optional": false}, {"position": 10, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Bring 2 cups of the milk and 3 tablespoons of the sugar to a boil in a saucepan. While the milk is heating, toss the cocoa, cornstarch and salt into the work bowl of a food processor and pulse to blend; turn the ingredients out onto a sheet of wax paper. Place the egg, egg yolks and remaining 3 tablespoons sugar in the work bowl and process for 1 minute. Scrape down the sides of the bowl and add the remaining ¼ cup milk. Process for a few seconds, return the dry ingredients to the bowl and pulse just until blended."}, {"position": 2, "text": "With the machine running, slowly pour in the hot milk, processing to blend. The mixture will be foamy, but the bubbles will disappear when the pudding is cooked. Pour the mixture into the saucepan and cook over medium-high heat, stirring continuously, for about 2 minutes, or until the pudding thickens. (The pudding should not boil.) Scrape the pudding into the processor, add the remaining ingredients and pulse until they are evenly blended."}, {"position": 3, "text": "Pour the pudding into 6 ½-cup bowls or 1 large bowl. Chill for at least 4 hours. Serve plain or topped with heavy cream, whipped or not."}], "nutrition": {"calories": 298.0, "protein_g": 6.2, "carbohydrates_g": 35.8, "fat_g": 16.4, "saturated_fat_g": 9.2, "trans_fat_g": 0.0, "cholesterol_mg": 111.5, "sodium_mg": 154.8, "fiber_g": 2.1, "sugar_g": 30.2, "unsaturated_fat_g": 6.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["cocoa powder", "custards and puddings", "egg yolk", "milk", "winter"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/23/dining/Chocolate-Pudding/Chocolate-Pudding-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 244}, "video_url": null, "comment_count": null, "published_at": "2004-12-05", "scraped_at": "2026-09-07T03:53:47.902891+00:00", "scraper_version": "1.0.0"}
{"slug": "dorothy-stones-bourbon-glazed-sweet-potatoes", "nyt_id": 312, "url": "https://cooking.nytimes.com/recipes/312-dorothy-stones-bourbon-glazed-sweet-potatoes", "name": "Dorothy Stone's Bourbon-Glazed Sweet Potatoes", "author": "Florence Fabricant", "description": "", "servings": {"text": "8 - 10 servings", "min": 8, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": 10, "cook_minutes": 60, "total_minutes": 70, "raw": {"total": "1 hour 10 minutes", "prep": "10 minutes", "cook": "1 hour"}}, "ingredients": [{"position": 1, "raw": "3 pounds medium-large sweet potatoes, of uniform size", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "medium-large sweet potatoes", "preparation": "of uniform size", "optional": false}, {"position": 2, "raw": "4 tablespoons melted butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "melted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt and freshly ground black pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons light brown sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup bourbon", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "bourbon", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Scrub the sweet potatoes, place in a pot, and cover with water. Bring to a boil, and cook until barely tender, 15 to 20 minutes. Drain and rinse under cold water."}, {"position": 2, "text": "When the potatoes are cool enough to handle, peel them, and slice in rounds ¼ inch thick."}, {"position": 3, "text": "Use 1 tablespoon of the butter to grease a shallow baking dish about 10 inches by 14 inches."}, {"position": 4, "text": "Arrange the potato slices, slightly overlapping them, in the dish, and drizzle with the remaining butter. Season with salt and pepper, then sprinkle evenly with the sugar. If desired, the dish can be prepared in advance up to this point and set aside, covered, for 3 hours at room temperature or overnight in the refrigerator."}, {"position": 5, "text": "Preheat oven to 425 degrees. Bake the potatoes for 20 minutes, then lower oven temperature to 350 degrees, and bake 20 minutes longer, until the potatoes are nicely glazed."}, {"position": 6, "text": "Just before serving, warm the bourbon in a small saucepan. Wear oven mitts, and stand back from the pan. Ignite the bourbon, and pour it, still flaming, even over the potatoes. Serve at once."}], "nutrition": {"calories": 179.8, "protein_g": 2.2, "carbohydrates_g": 29.4, "fat_g": 4.7, "saturated_fat_g": 2.9, "trans_fat_g": 0.0, "cholesterol_mg": 12.2, "sodium_mg": 347.9, "fiber_g": 4.2, "sugar_g": 7.5, "unsaturated_fat_g": 1.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": ["thanksgiving"], "other": ["bake", "boil", "bourbon", "fall", "five ingredient", "sweet potato"]}, "images": [], "rating": {"average": 4.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "1988-11-23", "scraped_at": "2026-09-07T04:58:24.089527+00:00", "scraper_version": "1.0.0"}
{"slug": "double-chocolate-mocha-drop-cookies", "nyt_id": 12032, "url": "https://cooking.nytimes.com/recipes/12032-double-chocolate-mocha-drop-cookies", "name": "Double Chocolate Mocha Drop Cookies", "author": "Joan Nathan", "description": "Joan Nathan", "servings": {"text": "About 3 dozen cookies", "min": 36, "max": 36, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "¾ cup plus 3 tablespoons chocolate chips", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "plus 3 tablespoons chocolate chips", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ cup brewed coffee", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "brewed coffee", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup unsalted butter or margarine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "unsalted butter or margarine", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup white sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "white sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "¾ cup brown sugar", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "brown sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "2 large eggs", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon vanilla extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "vanilla extract", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup matzo cake meal", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "matzo cake meal", "preparation": null, "optional": false}, {"position"
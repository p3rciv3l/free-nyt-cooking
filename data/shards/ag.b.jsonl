{"slug": "agghiotta-di-pesce-spada", "nyt_id": 4052, "url": "https://cooking.nytimes.com/recipes/4052-agghiotta-di-pesce-spada", "name": "Agghiotta Di Pesce Spada", "author": "Nancy Harmon Jenkins", "description": "Nancy Harmon Jenkins", "servings": {"text": "Six servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons sultana raisins", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sultana raisins", "preparation": null, "optional": false}, {"position": 2, "raw": "3 swordfish steaks, approximately 1 inch thick, weighing a total of 1 ½ to 2 pounds", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "swordfish steaks", "preparation": "approximately 1 inch thick, weighing a total of 1 ½ to 2 pounds", "optional": false}, {"position": 3, "raw": "¼ cup all-purpose flour", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "all-purpose flour", "preparation": null, "optional": false}, {"position": 4, "raw": "5 tablespoons olive oil", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "1 medium onion, thinly sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium onion", "preparation": "thinly sliced", "optional": false}, {"position": 6, "raw": "1 clove garlic, peeled and mashed with the flat blade of a knife", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "peeled and mashed with the flat blade of a knife", "optional": false}, {"position": 7, "raw": "2 tablespoons pine nuts", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "pine nuts", "preparation": null, "optional": false}, {"position": 8, "raw": "1 celery stalk, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "celery stalk", "preparation": "finely chopped", "optional": false}, {"position": 9, "raw": "1 tablespoon capers", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "capers", "preparation": null, "optional": false}, {"position": 10, "raw": "½ cup pitted Mediterranean-style green olives", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "pitted mediterranean-style green olives", "preparation": null, "optional": false}, {"position": 11, "raw": "1 8-ounce can imported Italian tomatoes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "8-ounce can imported italian tomatoes", "preparation": null, "optional": false}, {"position": 12, "raw": "3 bay leaves", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the raisins in a small bowl of hot water to soften and plump them while you proceed with the recipe."}, {"position": 2, "text": "Lightly flour each side of the swordfish steaks. Over medium-high heat, saute the steaks briefly in two tablespoons of olive oil, just enough to brown them - about two to three minutes to a side. Set the browned steaks aside."}, {"position": 3, "text": "Turn the heat to low, add three tablespoons of olive oil to the same pan and gently stew the thinly sliced onions, 15 to 20 minutes, until they are soft. Add the garlic, pine nuts, celery, capers and olives. Drain the sultanas and add to the pan."}, {"position": 4, "text": "Add the tomatoes to the pan, raise heat again and cook all ingredients together rapidly, approximately 10 minutes, until the sauce is thick. Remove from heat."}, {"position": 5, "text": "Preheat the oven to 400 degrees."}, {"position": 6, "text": "Place half the sauce in a shallow oven dish. Arrange the steaks in the dish and spoon the remaining sauce on top. Place a bay leaf on each steak. Bake the swordfish steaks for seven to nine minutes, or until they are cooked through but still juicy. Do not overcook. Serve immediately. (They may also be set aside in a warm place for 30 minutes to an hour before serving.)"}], "nutrition": {"calories": 275.1, "protein_g": 15.2, "carbohydrates_g": 10.8, "fat_g": 19.4, "saturated_fat_g": 3.0, "trans_fat_g": 0.0, "cholesterol_mg": 44.9, "sodium_mg": 295.6, "fiber_g": 2.0, "sugar_g": 4.0, "unsaturated_fat_g": 15.1, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["dairy-free"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "braise", "green olive", "saute", "swordfish", "tomato"]}, "images": [], "rating": {"average": 4.0, "count": 20}, "video_url": null, "comment_count": null, "published_at": "1987-08-23", "scraped_at": "2026-09-07T05:40:44.759879+00:00", "scraper_version": "1.0.0"}
{"slug": "agginares-meh-koukia-artichokes-with-fava-beans", "nyt_id": 5682, "url": "https://cooking.nytimes.com/recipes/5682-agginares-meh-koukia-artichokes-with-fava-beans", "name": "Agginares meh Koukia (Artichokes With Fava Beans)", "author": "Molly O’Neill", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "12 pearl onions, peeled and halved", "group": null, "quantity": 12.0, "quantity_max": null, "unit": null, "item": "pearl onions", "preparation": "peeled and halved", "optional": false}, {"position": 2, "raw": "8 scallions, white parts and 2 inches of green parts sliced into ½-inch pieces", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "scallions", "preparation": "white parts and 2 inches of green parts sliced into ½-inch pieces", "optional": false}, {"position": 3, "raw": "½ cup corn oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "corn oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ teaspoons kosher salt, plus more to taste", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": "plus more to taste", "optional": false}, {"position": 5, "raw": "8 large artichoke bottoms and stems, outer leaves and choke removed, stems peeled and separated from bottoms", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "large artichoke bottoms and stems", "preparation": "outer leaves and choke removed, stems peeled and separated from bottoms", "optional": false}, {"position": 6, "raw": "1 pound dry fava beans, soaked 24 hours in water and peeled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "dry fava beans", "preparation": "soaked 24 hours in water and peeled", "optional": false}, {"position": 7, "raw": "2 carrots, peeled and cut into ¼-inch rounds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "carrots", "preparation": "peeled and cut into ¼-inch rounds", "optional": false}, {"position": 8, "raw": "¼ cup chopped fresh dill leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped fresh dill leaves", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup lemon juice", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup extra-virgin olive oil", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the onions and scallions in a very large, deep skillet over medium heat for 2 minutes to remove excess moisture. Add the corn oil and 1 ½ teaspoons salt and continue to cook until onions become just translucent, 3 minutes."}, {"position": 2, "text": "Add the artichokes to the pan in an even layer. Add enough water to come of the way up the artichokes. Reduce the heat to a strong simmer, cover and cook for 12 minutes. Turn artichoke pieces over, cover and continue cooking until just barely tender, about 10 minutes more."}, {"position": 3, "text": "Add the beans, carrots and ½the dill. Add water to the level of the beans and continue cooking, covered, until the beans are tender, about 7 minutes more."}, {"position": 4, "text": "Remove from the heat. Gently stir in the lemon juice and season with salt to taste. (Some of the beans will lose shape.) Transfer to a platter, drizzle with the olive oil, garnish with the remaining dill and serve warm."}], "nutrition": {"calories": 329.8, "protein_g": 10.5, "carbohydrates_g": 32.1, "fat_g": 21.1, "saturated_fat_g": 2.8, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 533.6, "fibe
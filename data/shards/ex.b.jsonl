{"slug": "extra-rich-chocolate-cake", "nyt_id": 7177, "url": "https://cooking.nytimes.com/recipes/7177-extra-rich-chocolate-cake", "name": "Extra Rich Chocolate Cake", "author": "Moira Hodgson", "description": "", "servings": {"text": "10 to 12 servings", "min": 10, "max": 12, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "Butter for greasing", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "butter for greasing", "preparation": null, "optional": false}, {"position": 2, "raw": "10 ounces semisweet chocolate, broken into pieces", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "oz", "item": "semisweet chocolate", "preparation": "broken into pieces", "optional": false}, {"position": 3, "raw": "2 tablespoons strong coffee", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "strong coffee", "preparation": null, "optional": false}, {"position": 4, "raw": "½ pound unsalted butter", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup granulated sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "granulated sugar", "preparation": null, "optional": false}, {"position": 6, "raw": "5 large eggs, separated", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "large eggs", "preparation": "separated", "optional": false}, {"position": 7, "raw": "¼ cup flour", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "flour", "preparation": null, "optional": false}, {"position": 8, "raw": "2 teaspoons confectioners' sugar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "confectioners' sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 350 degrees. Butter a nine-and-a-half-inch springform pan or nonstick cake pan."}, {"position": 2, "text": "Melt the chocolate with the coffee, butter and granulated sugar in the top of a double boiler over gently simmering water. Stir until blended. Set the mixture aside, uncovered, to cool."}, {"position": 3, "text": "When the mixture has cooled, whisk the egg yolks into the chocolate one at a time. Add the flour and whisk until smooth."}, {"position": 4, "text": "In a separate bowl, beat the egg whites until they stand up in stiff peaks. Add one-third of the egg white to the chocolate mixture. Fold them in carefully until blended. Fold in the remaining whites gently until there are no streaks left."}, {"position": 5, "text": "Pour the mixture into the prepared pan and bake for about 35 minutes, or until the cake is firm. A toothpick or skewer inserted into the cake about three inches from the center of the pan should come out clean (the cake should not be too dry). Cool on a rack before unmolding. Dust with confectioners' sugar before serving."}], "nutrition": {"calories": 329.6, "protein_g": 4.1, "carbohydrates_g": 26.0, "fat_g": 25.3, "saturated_fat_g": 14.9, "trans_fat_g": 0.0, "cholesterol_mg": 120.4, "sodium_mg": 34.6, "fiber_g": 1.5, "sugar_g": 21.7, "unsaturated_fat_g": 9.0, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["valentine’s day"], "other": ["all-purpose flour", "bake", "butter", "coffee", "egg", "semisweet chocolate", "sugar"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1995-02-12", "scraped_at": "2026-09-07T08:57:21.833339+00:00", "scraper_version": "1.0.0"}

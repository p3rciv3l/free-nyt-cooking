{"slug": "extra-special-meat-loaf", "nyt_id": 10742, "url": "https://cooking.nytimes.com/recipes/10742-extra-special-meat-loaf", "name": "Extra Special Meat Loaf", "author": "Marialisa Calta", "description": "", "servings": {"text": "Four to six servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds lean ground beef", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "lean ground beef", "preparation": null, "optional": false}, {"position": 2, "raw": "2 eggs, beaten", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": "beaten", "optional": false}, {"position": 3, "raw": "½ cup Italian-style bread crumbs", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "italian-style bread crumbs", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup tomato juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "tomato juice", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon garlic powder", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "garlic powder", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ teaspoon black pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "black pepper", "preparation": null, "optional": false}, {"position": 8, "raw": "½ teaspoon oregano", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "oregano", "preparation": null, "optional": false}, {"position": 9, "raw": "Dash of cayenne pepper", "group": null, "quantity": null, "quantity_max": null, "un
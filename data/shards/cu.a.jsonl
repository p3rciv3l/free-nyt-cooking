{"slug": "cucumber-salsa-salad", "nyt_id": 1012683, "url": "https://cooking.nytimes.com/recipes/1012683-cucumber-salsa-salad", "name": "Cucumber Salsa Salad", "author": "Martha Rose Shulman", "description": "This salad, which resembles gazpacho, is a lovely, light way to begin a Mexican meal. Serve it atop lettuce leaves as a salad, or serve over rice. Alternately, use it as a sauce with fish, chicken or fajitas.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "PT30M"}}, "ingredients": [{"position": 1, "raw": "1 long European cucumber, very finely diced", "group": null, "quantity": 1.0, "unit": null, "item": "long european cucumber", "preparation": "very finely diced", "optional": false}, {"position": 2, "raw": "Salt to taste", "group": null, "quantity": null, "unit": null, "item": "salt to taste", "preparation": null, "optional": false}, {"position": 3, "raw": "1 small red onion, finely minced", "group": null, "quantity": 1.0, "unit": null, "item": "small red onion", "preparation": "finely minced", "optional": false}, {"position": 4, "raw": "5 medium-size ripe tomatoes, finely chopped", "group": null, "quantity": 5.0, "unit": null, "item": "medium-size ripe tomatoes", "preparation": "finely chopped", "optional": false}, {"position": 5, "raw": "2 jalapeño or serrano peppers, seeded if desired and finely chopped", "group": null, "quantity": 2.0, "unit": null, "item": "jalapeño or serrano peppers", "preparation": "seeded if desired and finely chopped", "optional": false}, {"position": 6, "raw": "¼ to ½ cup chopped cilantro (to taste), plus several sprigs for garnish", "group": null, "quantity": 0.25, "unit": null, "item": "to ½ cup chopped cilantro", "preparation": "plus several sprigs for garnish", "optional": false}, {"position": 7, "raw": "1 teaspoon balsamic vinegar", "group": null, "quantity": 1.0, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 8, "raw": "3 tablespoons fresh lime juice", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "fresh lime juice", "preparation": null, "optional": false}, {"position": 9, "raw": "3 tablespoons extra virgin olive oil", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 10, "raw": "Leaf lettuce or Boston lettuce for serving (optional)", "group": null, "quantity": null, "unit": null, "item": "leaf lettuce or boston lettuce for serving", "preparation": null, "optional": true}, {"position": 11, "raw": "1 avocado, sliced, for garnish", "group": null, "quantity": 1.0, "unit": null, "item": "avocado", "preparation": "sliced, for garnish", "optional": false}], "steps": [{"position": 1, "text": "Place the finely diced cucumber in a colander, and sprinkle with salt. Toss and allow to sit for 15 minutes. Rinse the cucumber thoroughly with cold water, and drain again on paper towels."}, {"position": 2, "text": "Meanwhile, place the onion in a bowl and cover with cold water. Let sit for five minutes, then drain, rinse with cold water and drain on paper towels."}, {"position": 3, "text": "Combine the tomatoes, chiles, cilantro, vinegar, lime juice and olive oil in a bowl. Add the cucumber and onion, and season to taste with salt. Taste and adjust seasoning."}, {"position": 4, "text": "Serve the salad on lettuce leaves, garnished with slices of avocado and cilantro sprigs, or spoon over steamed rice."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 147.5, "protein_g": 2.1, "carbohydrates_g": 10.7, "fat_g": 12.0, "saturated_fat_g": 1.7, "unsaturated_fat_g": 1.4, "trans_fat_g": null, "cholesterol_mg": null, "sodium_mg": 504.7, "fiber_g": 4.1, "sugar_g": 4.6, "computed_with": null}, "tags": {"cuisine": ["mexican"], "diet": [], "course": ["salad"], "meal": [], "occasion": [], "other": ["cucumber", "easy", "quick", "sum
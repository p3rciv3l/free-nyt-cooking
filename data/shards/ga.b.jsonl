{"slug": "gabriella-marriottis-egg-and-eggplant-appetizer", "nyt_id": 11843, "url": "https://cooking.nytimes.com/recipes/11843-gabriella-marriottis-egg-and-eggplant-appetizer", "name": "Gabriella Marriotti's Egg And Eggplant Appetizer", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "Eight or more appetizer servings", "min": 8, "max": 8, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 1470, "raw": {"total": "About 30 minutes, plus 24 hours' refrigeration"}}, "ingredients": [{"position": 1, "raw": "1 eggplant, about 1 pound", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "eggplant", "preparation": "about 1 pound", "optional": false}, {"position": 2, "raw": "3 hard-cooked eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "hard-cooked eggs", "preparation": null, "optional": false}, {"position": 3, "raw": "Salt to taste, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt to taste", "preparation": "if desired", "optional": false}, {"position": 4, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "½ cup drained small capers", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "drained small capers", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons finely minced garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 7, "raw": "1 2-ounce can anchovies, drained and finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "2-ounce can anchovies", "preparation": "drained and finely chopped", "optional": false}, {"position": 8, "raw": "1 cup finely chopped parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "finely chopped parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "1 cup olive oil, approximately", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "olive oil", "preparation": "approximately", "optional": false}, {"position": 10, "raw": "2 tablespoons red-wine vinegar, approximately", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "red-wine vinegar", "preparation": "approximately", "optional": false}], "steps": [{"position": 1, "text": "Preheat a charcoal grill or a kitchen broiler."}, {"position": 2, "text": "Cut off the ends of the eggplant. Cut the eggplant into slices about one-quarter-inch thick. There should be about 18 slices."}, {"position": 3, "text": "Remove the yolks from the eggs and put them through a fine sieve. Finely chop the whites. Combine the two. Put in a mixing bowl."}, {"position": 4, "text": "Place the eggplant slices, a few at a time, over the charcoal or under the broiler and cook, turning once, about 45 seconds on each side. The partly cooked slices will be slightly limp."}, {"position": 5, "text": "Remove the slices and sprinkle with salt and pepper."}, {"position": 6, "text": "Add the capers, garlic, anchovies and parsley to the eggs and toss to blend well."}, {"position": 7, "text": "Line a six-cup loaf pan lengthwise with one layer of eggplant slices. Sprinkle with one tablespoon oil and one-half teaspoon vinegar. Cover with one-quarter cup of the egg mixture. Add another layer of eggplant slices and sprinkle as before with the same amount of oil and vinegar. Add another layer of the egg mixture and cover with a layer of eggplant slices. Sprinkle with the same amount of oil and vinegar."}, {"position": 8, "text": "Continue making layers until all the eggplant slices and the egg mixture are used, ending with the egg mixture. Sprinkle that final layer with one tablespoon of vinegar and 10 tablespoons of olive oil. Press down with the fingers. Cover closely with clear plastic wrap and let stand 24 hours in the refrigerator."}, {"position": 9, "text": "When ready, the dish may be cut into crosswise slices, but ideally the eggplant slices should be rolled individually, with the egg filling in the center. Serve one or two rolled slices as an appetizer."}], "nutrition": {"calories": 300.0, "protein_g": 5.0, "carbohydrates_g": 5.2, "fat_g": 29.5, "saturated_fat_g": 4.4, "trans_fat_g": 0.0, "cholesterol_mg": 62.0, "sodium_mg": 436.9, "fiber_g": 2.3, "sugar_g": 2.3, "unsaturated_fat_g": 23.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["gluten-free"], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["broil", "egg", "eggplant", "grill", "summer"]}, "images": [], "rating": {"average": 4.0, "count": 9}, "video_url": null, "comment_count": null, "published_at": "1986-01-05", "scraped_at": "2026-09-06T23:50:32.961679+00:00", "scraper_version": "1.0.0"}
{"slug": "galangal-ice-cream", "nyt_id": 10422, "url": "https://cooking.nytimes.com/recipes/10422-galangal-ice-cream", "name": "Galangal Ice Cream", "author": "William Grimes", "description": "William Grimes", "servings": {"text": "About 3 cups", "min": 3, "max": 3, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "1 hour"}}, "ingredients": [{"position": 1, "raw": "1 ¾ cups milk", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ¼ cups heavy cream", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup finely chopped fresh galangal (about 3 ounces unchopped); available at Asian markets", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "finely chopped fresh galangal (about 3 ounces unchopped); available at asian markets", "preparation": null, "optional": false}, {"position": 5, "raw": "6 large egg yolks", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "large egg yolks", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a medium saucepan, combine the milk, heavy cream, sugar and galangal. Bring to a boil, and immediately remove from the heat. Allow the mixture to cool, then transfer to a covered container. Refrigerate at least eight hours, or overnight, to infuse the flavor of the galangal."}, {"position": 2, "text": "Place the egg yolks in a medium bowl, whisk until blended, and set aside. Return the galangal mixture to a saucepan over medium-high heat, bring to a simmer and reduce heat to low. Slowly mix about a cup of the hot galangal mixture into the egg yolks. Add the yolk mixture to the saucepan. Cook over low heat, stirring slowly, until the custard has thickened enough to coat the back of the spoon. Remove from the heat."}, {"position": 3, "text": "Strain the custard into a mixing bowl, and place in a container of ice water to cool. When the custard is chilled, freeze in an ice cream maker, according to the manufacturer's instructions."}], "nutrition": {"calories": 253.2, "protein_g": 4.9, "carbohydrates_g": 17.6, "fat_g": 18.6, "saturated_fat_g": 10.8, "trans_fat_g": 0.5, "cholesterol_mg": 185.1, "sodium_mg": 40.0, "fiber_g": 0.1, "sugar_g": 16.4, "unsaturated_fat_g": 6.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["boil", "five ingredient", "ice creams and sorbets"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1998-08-05", "scraped_at": "2026-09-06T22:22:03.680514+00:00", "scraper_version": "1.0.0"}
{"slug": "garganelli-pasta-with-fava-beans", "nyt_id": 6171, "url": "https://cooking.nytimes.com/recipes/6171-garganelli-pasta-with-fava-beans", "name": "Garganelli Pasta With Fava Beans", "author": "Amanda Hesser", "description": "Amanda Hesser", "servings": {"text": "Serves 4", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 2, "raw": "3 pounds fava beans", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "fava beans", "preparation": null, "optional": false}, {"position": 3, "raw": "1 pound garganelli pasta", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "garganelli pasta", "preparation": null, "optional": false}, {"position": 4, "raw": "3 tablespoons extra-virgin olive oil, plus extra to drizzle over pasta", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": "plus extra to drizzle over pasta", "optional": false}, {"position": 5, "raw": "1 ½ cups thinly sliced spring onions", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "thinly sliced spring onions", "preparation": null, "optional": false}, {"position": 6, "raw": "1 tablespoon finely chopped garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped garlic", "preparation": null, "optional": false}, {"position": 7, "raw": "1 teaspoon chopped rosemary", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped rosemary", "preparation": null, "optional": false}, {"position": 8, "raw": "1 teaspoon chopped savory", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "chopped savory", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "Few drops lemon juice", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "few drops lemon juice", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons chopped parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 12, "raw": "4 ounces ricotta salata cheese, chilled", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "ricotta salata cheese", "preparation": "chilled", "optional": false}], "steps": [{"position": 1, "text": "To prepare the fava beans, bring a pot of salted water to a boil. Shell the beans and parboil for 30 to 40 seconds. Plunge the favas into ice water to stop the cooking. Pop each bean out of its outer skin by pinching with thumb and forefinger; you may have to slit the outer skin with a knife if the beans are mature. (You should have about 3 cups.)"}, {"position": 2, "text": "Bring another pot of salted water to a boil. Cook the pasta in the salted water until it is al dente."}, {"position": 3, "text": "While the pasta is cooking, prepare the fava-bean ragout. Heat 3 tablespoons of olive oil in a large skillet over moderate heat. Add the fava beans, onion, garlic, rosemary and savory and season generously with salt and pepper. Gently cook the mixture until the onions are soft and the fava beans are tender, about 5 minutes. Do not let the vegetables brown much; add a splash of water as needed. The ragout should be a bit moist by the end of cooking."}, {"position": 4, "text": "Drain the pasta, reserving a cup of the cooking water. Return the pasta to the pot and add the fava-bean ragout. Stir over low heat until the pasta is thoroughly coated, adding a bit of the reserved water if the mixture seems dry. Add lemon juice and taste for seasoning."}, {"position": 5, "text": "Transfer the pasta to a warmed bowl. Sprinkle with the chopped parsley. Use a sharp vegetable peeler to cut shavings of the ricotta salata over the top. Drizzle with extra-virgin olive oil."}], "nutrition": {"calories": 873.6, "protein_g": 49.9, "carbohydrates_g": 154.1, "fat_g": 13.9, "saturated_fat_g": 6.1, "trans_fat_g": 0.0, "cholesterol_mg": 28.1, "sodium_mg": 1233.7, "fiber_g": 31.0, "sugar_g": 35.5, "unsaturated_fat_g": 5.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": ["vegetarian"], "course": ["main course", "side dish"], "meal": ["dinner", "lunch"], "occasion": [], "other": ["boil", "fava bean", "pasta", "pastas", "saute", "weeknight"]}, "images": [], "rating": {"average": 4.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "2005-06-12", "scraped_at": "2026-09-07T00:50:26.714565+00:00", "scraper_version": "1.0.0"}
{"slug": "garlic-sauteed-shiitake-mushrooms", "nyt_id": 3766, "url": "https://cooking.nytimes.com/recipes/3766-garlic-sauteed-shiitake-mushrooms", "name": "Garlic Sauteed Shiitake Mushrooms", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "4 tablespoons unsalted butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 2, "raw": "2 large cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": "minced", "optional": false}, {"position": 3, "raw": "6 ounces large shiitake mushrooms, stems removed", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "oz", "item": "large shiitake mushrooms", "preparation": "stems removed", "optional": false}, {"position": 4, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon chopped parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Combine butter and garlic in saute pan. Heat until butter is melted and garlic starts to sizzle, about 30 seconds. Do not let garlic brown."}, {"position": 2, "text": "Add mushrooms and saute 3 to 4 minutes, turning until lightly browned. Season to taste with salt and pepper, sprinkle with parsley and serve."}], "nutrition": {"calories": 241.6, "protein_g": 2.6, "carbohydrates_g": 7.8, "fat_g": 23.5, "saturated_fat_g": 14.4, "trans_fat_g": 0.0, "cholester
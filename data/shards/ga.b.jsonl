{"slug": "garlicky-shrimp-with-zucchini-and-beans", "nyt_id": 778170186, "url": "https://cooking.nytimes.com/recipes/778170186-garlicky-shrimp-with-zucchini-and-beans", "name": "Garlicky Shrimp With Zucchini and Beans", "author": "Kay Chun", "description": "Aromatic leeks, garlic, clam juice and sweet zucchini create a flavorful base in this brothy shrimp stew. The shrimp gets poached directly in the broth, infusing the liquid with its briny liquor; the canned beans add heft and a pat of butter transforms the juices into a luscious sauce brightened by fresh chives and lemon juice. Serve with warm crusty bread on the side for sopping everything up. Leftovers also make a fantastic pasta salad the next day, tossed with any short pasta, olive oil and grated Parmesan.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 15, "cook_minutes": 15, "total_minutes": 30, "raw": {"total": "30 min", "prep": "PT0H15M", "cook": "PT0H15M"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 medium leek, white and light green parts only, halved lengthwise and thinly sliced (1 cup)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium leek", "preparation": "white and light green parts only, halved lengthwise and thinly sliced (1 cup)", "optional": false}, {"position": 3, "raw": "Kosher salt and pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "kosher salt and pepper", "preparation": null, "optional": false}, {"position": 4, "raw": "1 medium zucchini or yellow squash (8 ounces), cut into ¼-inch cubes (about 2 cups)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium zucchini or yellow squash (8 ounces)", "preparation": "cut into ¼-inch cubes (about 2 cups)", "optional": false}, {"position": 5, "raw": "5 garlic cloves, thinly sliced", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "garlic cloves", "preparation": "thinly sliced", "optional": false}, {"position": 6, "raw": "1 (8-ounce) bottle clam juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(8-ounce) bottle clam juice", "preparation": null, "optional": false}, {"position": 7, "raw": "1 (14-ounce) can white beans, rinsed", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "(14-ounce) can white beans", "preparation": "rinsed", "optional": false}, {"position": 8, "raw": "1 pound peeled and deveined large shrimp", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "peeled and deveined large shrimp", "preparation": null, "optional": false}, {"position": 9, "raw": "1 tablespoon lemon juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 10, "raw": "1 tablespoon unsalted butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 11, "raw": "¼ teaspoon crushed red pepper", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "crushed red pepper", "preparation": null, "optional": false}, {"position": 12, "raw": "2 tablespoons chopped chives", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped chives", "preparation": null, "optional": false}, {"position": 13, "raw": "Crusty bread, for serving", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "crusty bread", "preparation": "for serving", "optional": false}], "steps": [{"position": 1, "text": "In a large Dutch oven, heat oil over medium. Add leek, season with salt and pepper, and cook, stirring occasionally, until softened, 2 minutes. Add zucchini, season with salt and pepper, and cook, stirring occasionally, until zucchini is softened, 3 minutes. Add garlic and stir until fragrant, 1 minute."}, {"position": 2, "text": "Add clam juice, beans and shrimp and mix well, then cover and reduce heat to medium-low. Cook until shrimp are just cooked through, 4 to 5 minutes."}, {"position": 3, "text": "Stir in lemon juice, butter, crushed red pepper and 1 tablespoon of the chives. Season to taste with salt and pepper."}, {"position": 4, "text": "Divide the shrimp mixture among 4 shallow bowls and top with the remaining chives. Serve warm, with crusty bread on the side."}], "nutrition": {"calories": 406.3, "protein_g": 36.9, "carbohydrates_g": 41.9, "fat_g": 11.4, "saturated_fat_g": 3.1, "trans_fat_g": 0.0, "cholesterol_mg": 190.2, "sodium_mg": 930.2, "fiber_g": 7.6, "sugar_g": 3.7, "unsaturated_fat_g": 7.4, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["healthy"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["leek", "zucchini", "garlic", "clam juice", "white bean", "shrimp", "stew", "seafood", "beans", "poach", "stovetop", "easy", "one pot", "quick", "weeknight", "great leftovers", "squash", "summer"]}, "images": [{"url": "https://static01.nyt.com/images/2026/05/13/multimedia/KC-Garlicky-Shrimp-With-Summer-Squash-and-Beans-wlbm/KC-Garlicky-Shrimp-With-Summer-Squash-and-Beans-wlbm-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 987}, "video_url": null, "comment_count": null, "published_at": "2026-05-13", "scraped_at": "2026-09-07T01:10:43.098826+00:00", "scraper_version": "1.0.0"}

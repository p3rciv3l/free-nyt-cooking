{"slug": "garlicky-bean-salad", "nyt_id": 11670, "url": "https://cooking.nytimes.com/recipes/11670-garlicky-bean-salad", "name": "Garlicky Bean Salad", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": 75, "cook_minutes": 45, "total_minutes": 120, "raw": {"total": "2 hours", "prep": "1 hour 15 minutes", "cook": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 ½ cups dried pinto beans", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "dried pinto beans", "preparation": null, "optional": false}, {"position": 2, "raw": "4 ½ cups water", "group": null, "quantity": 4.5, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "2 teaspoons finely chopped garlic", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "finely chopped garlic", "preparation": null, "optional": false}, {"position": 4, "raw": "4 tablespoons chopped Italian parsley", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "chopped italian parsley", "preparation": null, "optional": false}, {"position": 5, "raw": "⅓ cup extra-virgin olive oil", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon salt (or to taste)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "salt (or to taste)", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak the beans in water overnight or place in a saucepan, bring to a boil and cook two minutes. Then allow to soak for one hour."}, {"position": 2, "text": "Bring to a simmer and cook, partly covered, until tender, about 40 minutes. Drain."}, {"position": 3, "text": "Transfer beans to a bowl and gently mix with garlic, parsley, one-fourth cup of the oil, salt and pepper. Allow to cool to room temperature, about 30 minutes. Just before serving, check seasonings and drizzle on remaining olive oil."}], "nutrition": {"calories": 292.1, "protein_g": 13.1, "carbohydrates_g": 38.5, "fat_g": 9.8, "saturated_fat_g": 1.4, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 305.0, "fiber_g": 9.6, "sugar_g": 1.3, "unsaturated_fat_g": 7.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["gluten-free", "vegan", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["bean", "five ingredient", "salad"]}, "images": [], "rating": {"average": 4.0, "count": 14}, "video_url": null, "comment_count": null, "published_at": "1988-05-15", "scraped_at": "2026-09-06T23:48:45.936601+00:00", "scraper_version": "1.0.0"}

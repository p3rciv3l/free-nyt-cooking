{"slug": "eileen-weinbergs-sweet-potato-salad", "nyt_id": 9467, "url": "https://cooking.nytimes.com/recipes/9467-eileen-weinbergs-sweet-potato-salad", "name": "Eileen Weinberg's Sweet Potato Salad", "author": "Suzanne Hamlin", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 45, "raw": {"total": "45 minutes"}}, "ingredients": [{"position": 1, "raw": "6 sweet potatoes, scrubbed but not peeled", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "sweet potatoes", "preparation": "scrubbed but not peeled", "optional": false}, {"position": 2, "raw": "Fine sea salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "fine sea salt", "preparation": null, "optional": false}, {"position": 3, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 4, "raw": "1 ½ tablespoons lemon juice", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon finely grated lemon zest", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "finely grated lemon zest", "preparation": null, "optional": false}, {"position": 6, "raw": "¾ to 1 cup mayonnaise", "group": null, "quantity": 0.75, "quantity_max": 1.0, "unit": "cup", "item": "mayonnaise", "preparation": null, "optional": false}, {"position": 7, "raw": "1 bunch scallions, trimmed and sliced into thin rounds, including most of the green", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "bunch", "item": "scallions", "preparation": "trimmed and sliced into thin rounds, including most of the green", "optional": false}, {"position": 8, "raw": "1 cup sliced celery, cut on the diagonal", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "sliced celery", "preparation": "cut on the diagonal", "optional": false}, {"position": 9, "raw": "1 green pepper, seeded and diced (optional)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "green pepper", "preparation": "seeded and diced", "optional": true}, {"position": 10, "raw": "4 hard-cooked eggs, peeled and cut into small chunks", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "hard-cooked eggs", "preparation": "peeled and cut into small chunks", "optional": false}], "steps": [{"position": 1, "text": "Cut the sweet potatoes in half, crosswise. Put them in a large pan, and add enough lightly salted water to cover them by 2 inches. Bring to a boil, and boil gently for 15 to 20 minutes, until just tender. Drain, and let rest until cool enough to handle."}, {"position": 2, "text": "Peel the potatoes, and cut them into chunks or slices. Salt and pepper lightly. Add lemon juice and zest to 1 cup mayonnaise; mix ¾ cup with the potatoes. Mix in scallions, celery and optional green pepper."}, {"position": 3, "text": "Gently mix in the hard-cooked eggs. Add more mayonnaise if desired. Adjust salt and generous amounts of black pepper. Chill slightly and serve."}], "nutrition": {"calories": 301.0, "protein_g": 4.6, "carbohydrates_g": 22.5, "fat_g": 21.7, "saturated_fat_g": 3.6, "trans_fat_g": 0.0, "cholesterol_mg": 84.5, "sodium_mg": 436.5, "fiber_g": 3.9, "sugar_g": 5.2, "unsaturated_fat_g": 17.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["side dish"], "meal": [], "occasion": ["fourth of july"], "other": ["boil", "mayonnaise", "potato salad", "scallion", "sweet potato"]}, "images": [], "rating": {"average": 4.0, "count": 17}, "video_url": null, "comment_count": null, "published_at": "1997-07-02", "scraped_at": "2026-09-07T01:30:16.118649+00:00", "s
{"slug": "kush", "nyt_id": 11207, "url": "https://cooking.nytimes.com/recipes/11207-kush", "name": "Kush", "author": "Anita M Samuels", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "2 ½ cups dry bulgur (grain No. 1)", "group": null, "quantity": 2.5, "quantity_max": null, "unit": "cup", "item": "dry bulgur (grain no. 1)", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon curry powder", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "curry powder", "preparation": null, "optional": false}, {"position": 3, "raw": "2 teaspoons garlic powder", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "garlic powder", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup tamari", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "tamari", "preparation": null, "optional": false}, {"position": 5, "raw": "1 ¼ cups spring water (see note)", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "spring water (see note)", "preparation": null, "optional": false}, {"position": 6, "raw": "½ cup extra virgin olive oil", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ pound carrots, grated (1 cup)", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "lb", "item": "carrots", "preparation": "grated (1 cup)", "optional": false}, {"position": 8, "raw": "½ head cauliflower, finely chopped", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "head", "item": "cauliflower", "preparation": "finely chopped", "optional": false}, {"position": 9, "raw": "1 small red onion, diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small red onion", "preparation": "diced", "optional": false}, {"position": 10, "raw": "1 green pepper, diced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "green pepper", "preparation": "diced", "optional": false}], "steps": [{"position": 1, "text": "Put the bulgur into a container, and add the spices."}, {"position": 2, "text": "Blend the tamari into the mixture with a large spoon. Add enough water to provide about a ¼-inch layer of water on top of the bulgur mixture. Stir well, and pat the mixture down evenly so that the kush will be evenly soaked."}, {"position": 3, "text": "Cover, and let sit for 25 to 30 minutes."}, {"position": 4, "text": "After soaking, add the oil and stir. Then add the vegetables and stir."}], "nutrition": {"calories": 599.9, "protein_g": 15.1, "carbohydrates_g": 78.4, "fat_g": 28.7, "saturated_fat_g": 4.1, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 1067.0, "fiber_g": 15.0, "sugar_g": 4.8, "unsaturated_fat_g": 23.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["side dish"], "meal": [], "occasion": [], "other": ["bulgur", "carrot"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1995-04-19", "scraped_at": "2026-09-07T02:08:36.915399+00:00", "scraper_version": "1.0.0"}

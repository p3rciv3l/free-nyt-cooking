{"slug": "amaretti-apple-crisp", "nyt_id": 3226, "url": "https://cooking.nytimes.com/recipes/3226-amaretti-apple-crisp", "name": "Amaretti Apple Crisp", "author": "Barbara Kafka", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 20, "raw": {"total": "20 minutes"}}, "ingredients": [{"position": 1, "raw": "4 Granny Smith apples (7 ounces each), peeled, cored and cut into 1-inch pieces", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "granny smith apples (7 ounces each)", "preparation": "peeled, cored and cut into 1-inch pieces", "optional": false}, {"position": 2, "raw": "¼ cup fresh lemon juice", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ½ teaspoons cornstarch", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "tsp", "item": "cornstarch", "preparation": null, "optional": false}, {"position": 4, "raw": "5 tablespoons light brown sugar", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "light brown sugar", "preparation": null, "optional": false}, {"position": 5, "raw": "1 teaspoon almond extract", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "almond extract", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ teaspoon ground nutmeg", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "ground nutmeg", "preparation": null, "optional": false}, {"position": 7, "raw": "⅛ teaspoon ground cloves", "group": null, "quantity": 0.125, "quantity_max": null, "unit": "tsp", "item": "ground cloves", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup slivered almonds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "slivered almonds", "preparation": null, "optional": false}, {"position": 9, "raw": "2 tablespoons sweet butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sweet butter", "preparation": null, "optional": false}, {"position": 10, "raw": "3 ounces amaretti cookies", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "oz", "item": "amaretti cookies", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place apples in an 8-by-8-by-2-inch glass or ceramic baking dish. Add 3 tablespoons of the lemon juice, and toss to combine."}, {"position": 2, "text": "Place the cornstarch in a very small bowl. Stir in 1 tablespoon of the lemon juice. Stir in remaining 2 teaspoons lemon juice, 2 tablespoons of the brown sugar and the almond extract, nutmeg and cloves."}, {"position": 3, "text": "Add the cornstarch mixture and almonds to the apples, and toss to combine. Cover tightly with microwave plastic wrap. Cook at 100 percent power in a high-power oven for 7 minutes, stirring once. Then prick the plastic to release steam."}, {"position": 4, "text": "Remove from the oven, uncover and set aside. Preheat the broiler."}, {"position": 5, "text": "Place the butter in a 1-cup glass measure. Cook, uncovered, for 1 minute, then remove from the oven."}, {"position": 6, "text": "Place the butter, amaretti and remaining brown sugar in a food processor. Process until finely chopped. Sprinkle over the apples, and brown under broiler for about 3 minutes."}], "nutrition": {"calories": 314.2, "protein_g": 5.5, "carbohydrates_g": 41.3, "fat_g": 15.1, "saturated_fat_g": 3.6, "trans_fat_g": 0.0, "cholesterol_mg": 10.2, "sodium_mg": 62.2, "fiber_g": 6.2, "sugar_g": 24.4, "unsaturated_fat_g": 10.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["apple", "broil", "brown sugar", "crisp", "easy", "microwave", "quick", "baking"]}, "images": [], "rating": {"a
{"slug": "ambassador-roland-engs-khmer-noodles", "nyt_id": 1910, "url": "https://cooking.nytimes.com/recipes/1910-ambassador-roland-engs-khmer-noodles", "name": "Ambassador Roland Eng's Khmer Noodles", "author": "Jonathan Reynolds", "description": "", "servings": {"text": "Serves 10", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 180, "raw": {"total": "3 hours"}}, "ingredients": [{"position": 1, "raw": "3 pounds pork leg bones", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "pork leg bones", "preparation": null, "optional": false}, {"position": 2, "raw": "¼ of a large jicama", "group": null, "quantity": 0.25, "quantity_max": null, "unit": null, "item": "of a large jicama", "preparation": null, "optional": false}, {"position": 3, "raw": "1 head garlic, cut in half", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "head", "item": "garlic", "preparation": "cut in half", "optional": false}, {"position": 4, "raw": "1 onion, quartered", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "onion", "preparation": "quartered", "optional": false}, {"position": 5, "raw": "½ cup dried shrimp", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dried shrimp", "preparation": null, "optional": false}, {"position": 6, "raw": "1 dried squid", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "dried squid", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons preserved cabbage", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "preserved cabbage", "preparation": null, "optional": false}, {"position": 8, "raw": "1 2-inch piece ginger, sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "2-inch piece ginger", "preparation": "sliced", "optional": false}, {"position": 9, "raw": "1 tablespoon white peppercorns", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "white peppercorns", "preparation": null, "optional": false}, {"position": 10, "raw": "Handful of cilantro stems", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "handful of cilantro stems", "preparation": null, "optional": false}, {"position": 11, "raw": "2 tablespoons fish sauce", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "fish sauce", "preparation": null, "optional": false}, {"position": 12, "raw": "1 tablespoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 13, "raw": "1 tablespoon salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "salt", "preparation": null, "optional": false}, {"position": 14, "raw": "3 pounds pork (preferably heart and tongue, but pork loin cut into two pieces also works well)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "pork (preferably heart and tongue", "preparation": "but pork loin cut into two pieces also works well)", "optional": false}, {"position": 15, "raw": "5 tablespoons plus 2 teaspoons vegetable oil", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "plus 2 teaspoons vegetable oil", "preparation": null, "optional": false}, {"position": 16, "raw": "¼ cup (about 8 cloves) chopped garlic", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "(about 8 cloves) chopped garlic", "preparation": null, "optional": false}, {"position": 17, "raw": "1 pound ground pork", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "ground pork", "preparation": null, "optional": false}, {"position": 18, "raw": "3 pounds large shrimp, peeled and deveined, or 2 pounds shrimp and 1 pound squid sliced into rings", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "lb", "item": "large shrimp", "preparation": "peeled and deveined, or 2 pounds shrimp and 1 pound squid sliced into rings", "optional": false}, {"position": 19, "raw": "6 cups loosely packed bean sprouts", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "cup", "item": "loosely packed bean sprouts", "preparation": null, "optional": false}, {"position": 20, "raw": "10 handfuls (about 10 ounces) fresh or dried rice noodles", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "handful", "item": "(about 10 ounces) fresh or dried rice noodles", "preparation": null, "optional": false}, {"position": 21, "raw": "5 teaspoons preserved cabbage", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tsp", "item": "preserved cabbage", "preparation": null, "optional": false}, {"position": 22, "raw": "10 teaspoons soy sauce", "group": null, "quantity": 10.0, "quantity_max": null, "unit": "tsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 23, "raw": "Freshly ground white pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground white pepper", "preparation": null, "optional": false}, {"position": 24, "raw": "¼ cup chopped cilantro leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped cilantro leaves", "preparation": null, "optional": false}, {"position": 25, "raw": "¼ cup chopped parsley leaves", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped parsley leaves", "preparation": null, "optional": false}, {"position": 26, "raw": "¼ cup chopped scallions", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "chopped scallions", "preparation": null, "optional": false}, {"position": 27, "raw": "Chinese hot sauce or chilies in vinegar", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "chinese hot sauce or chilies in vinegar", "preparation": null, "optional": false}, {"position": 28, "raw": "Hoisin sauce", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "hoisin sauce", "preparation": null, "optional": false}, {"position": 29, "raw": "4 limes, quartered", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "limes", "preparation": "quartered", "optional": false}], "steps": [{"position": 1, "text": "To make the broth and pork, place the bones in a large stockpot and add 12 quarts cold water. Bring to a boil over medium-high heat, adjust heat and simmer, uncovered, skimming off and discarding any foam that forms on top of the liquid. Meanwhile, in a large square of cheesecloth, tie together the jicama, garlic, onion, dried shrimp, dried squid, cabbage, ginger, peppercorns and cilantro stems and add them to the pot. Add fish sauce, sugar and salt. Simmer for 2 hours. Season to taste, only if needed."}, {"position": 2, "text": "Strain the broth and discard cheesecloth and bones. Return broth to the pot, bring back to a boil and add the pork. Simmer until just cooked through, about 30 minutes. Lift out the pork and slice thinly."}, {"position": 3, "text": "Make the garnishes: in a small skillet, heat 5 tablespoons of the oil over medium heat. Add the garlic and cook, stirring occasionally, until just golden, about 5 minutes. Set aside."}, {"position": 4, "text": "Heat remaining 2 teaspoons oil in a skillet over medium heat. Add ground pork and cook, breaking up pieces, until no longer pink. Spoon into a bowl."}, {"position": 5, "text": "Lower shrimp into the broth using a colander or strainer (you may have to do this in batches) and simmer 1 to 2 minutes. Do the same with the squid if you are using it. Remove to a bowl."}, {"position": 6, "text": "Divide half the sprouts among 10 large soup bowls. Bring a large pot of water to a boil. Add noodles and cook, stirring with chopsticks, until soft, about 1 minute for dried (less for fresh). Drain. Divide the noodles between the bowls. Toss the noodles with a teaspoon of the garlic and oil. Top each with half a teaspoon of preserved cabbage, 1 teaspoon soy sauce and a sprinkle of ground white pepper."}, {"position": 7, "text": "Add a few slices meat to each bowl, 1 tablespoon ground pork, a few shrimp (and squid, if using). Fill each bowl with hot broth. Combine the cilantro, parsley and scallion and top each bowl with about a tablespoon of the herbs. Top with bean sprouts."}, {"position": 8, "text": "Bring bowls to the table and serve with soy sauce, hot sauce and hoisin. Guests should squeeze lime over their soups and season them with condiments of their choice."}], "nutrition": null, "tags": {"cuisine": ["asian"], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["boil", "pork", "rice noodle", "saute", "shrimp"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/23/dining/Khmer-Noodles/Khmer-Noodles-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 3.0, "count": 18}, "video_url": null, "comment_count": null, "published_at": "2004-12-19", "scraped_at": "2026-09-07T03:57:52.233353+00:00", "scraper_version": "1.0.0"}
{"slug": "amber-veal-shanks", "nyt_id": 10442, "url": "https://cooking.nytimes.com/recipes/10442-amber-veal-shanks", "name": "Amber Veal Shanks", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 180, "raw": {"total": "3 hours"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons butter or vegetable oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter or vegetable oil", "preparation": null, "optional": false}, {"position": 2, "raw": "3 cups very thinly sliced onions", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "very thinly sliced onions", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup thinly sliced carrots", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "thinly sliced carrots", "preparation": null, "optional": false}, {"position": 4, "raw": "2 cups very thinly sliced fennel", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "very thinly sliced fennel", "preparation": null, "optional": false}, {"position": 5, "raw": "4 large cloves garlic", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "large cloves garlic", "preparation": null, "optional": false}, {"position": 6, "raw": "6 pieces veal shank, cut 2 inches thick, 10 to 12 ounces each", "group": null, "quantity": 6.0, "quantity_max": null, "unit": "piece", "item": "veal shank", "preparation": "cut 2 inches thick, 10 to 12 ounces each", "optional": false}, {"position": 7, "raw": "½ cup amber beer or pale ale", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "amber beer or pale ale", "preparation": null, "optional": false}, {"position": 8, "raw": "2 bay leaves", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "bay leaves", "preparation": null, "optional": false}, {"position": 9, "raw": "6 whole cloves", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "whole cloves", "preparation": null, "optional": false}, {"position": 10, "raw": "2 tablespoons balsamic vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 11, "raw": "1 tablespoon Dijon mustard", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "dijon mustard", "preparation": null, "optional": false}, {"position": 12, "raw": "Salt and freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground black pepper", "preparation": null, "optional": false}, {"position": 13, "raw": "2 tablespoons chopped fresh parsley", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chopped fresh parsley", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the butter or oil in a heavy casserole large enough to hold the meat snugly. Add the onions, carrots and fennel, cover and cook over medium-low heat until the vegetables are tender, about 15 minutes. Add the garlic and continue to cook, stirring from time to time, until the vegetables are golden, about 15 minutes longer. Remove the vegetables from the casserole and reserve them."}, {"position": 2, "text": "Pat the veal shanks dry, then brown them in the casserole over medium heat. You may not be able to do all at once. Set them aside."}, {"position": 3, "text": "Stir the beer into the casserole and bring it to a simmer, scraping the bottom of the pan. Add the bay leaves and cloves and return the vegetables to the casserole. Add the veal shanks, then place a piece of wax paper into the casserole, directly on top of the meat."}, {"position": 4, "text": "Bring to a simmer, cover and cook over low heat about two hours, turning the meat once or twice during the cooking. The veal should be very tender."}, {"position": 5, "text": "Remove the wax paper and discard it. Remove the veal from the casserole and set it aside, covered. Stir the vinegar and mustard into the casserole and reheat the sauce. Season to taste with salt and pepper. Serve the veal at once, with the sauce, or, if desired, return the veal to the casserole and set it aside. Reheat it just before serving. Sprinkle with parsley."}], "nutrition": {"calories": 458.6, "protein_g": 61.7, "carbohydrates_g": 13.5, "fat_g": 15.9, "saturated_fat_g": 3.7, "trans_fat_g": 0.0, "cholesterol_mg": 233.9, "sodium_mg": 1063.7, "fiber_g": 3.1, "sugar_g": 5.4, "unsaturated_fat_g": 9.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["braise", "saute", "veal"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "1993-10-31", "scraped_at": "2026-09-06T22:23:25.965344+00:00", "scraper_version": "1.0.0"}
{"slug": "ambrosia", "nyt_id": 11199, "url": "https://cooking.nytimes.com/recipes/11199-ambrosia", "name": "Ambrosia", "author": "Peter Feibleman", "description": "This is a classic Southern dessert in which layers of oranges, bananas and coconut are drizzled with honey, lemon juice and Cointreau. The perfect sweet to serve in the dreary midwinter months when your palate is craving something bright and juicy, but the berries haven't arrived yet.", "servings": {"text": "Serves 6 to 8", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "6 oranges, peeled and sliced into ¼ -inch rounds", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "oranges", "preparation": "peeled and sliced into ¼ -inch rounds", "optional": false}, {"position": 2, "raw": "1 banana, peeled and thinly sliced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "banana", "preparation": "peeled and thinly sliced", "optional": false}, {"position": 3, "raw": "½ cup sweetened shredded coconut", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sweetened shredded coconut", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup orange juice", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "orange juice", "preparation": null, "optional": false}, {"position": 5, "raw": "3 tablespoons lemon juice", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 6, "raw": "2 tablespoons honey (optional)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "honey", "preparation": null, "optional": true}, {"position": 7, "raw": "Splash of Cointreau (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "splash of cointreau", "preparation": null, "optional": true}], "steps": [{"position": 1, "text": "In a glass serving bowl, form a single layer of orange slices and top with a few slices of banana. Sprinkle a thin layer of coconut over the top. Repeat layering until all of these ingredients are finished, reserving a tablespoon of the coconut. Stir together the juices and honey, if using, and pour over the fruit. Follow with the Cointreau, if desired, and a final sprinkling of coconut. Serve immediately or cover and refrigerate for several hours."}], "nutrition": {"calories": 123.4, "protein_g": 1.5, "carbohydrates_g": 25.6, "fat_g": 2.3, "saturated_fat_g": 1.9, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 16.0, "fiber_g": 3.1, "sugar_g": 20.5, "unsaturated_fat_g": 0.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["southern"], "diet": [], "course": ["dessert"], "meal": [], "occasion": [], "other": ["banana", "orange"]}, "images": [{"url": "https://static01.nyt.com/images/2014/05/29/dining/Ambrosia/Ambrosia-facebookJumbo-v2.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 57}, "video_url": null, "comment_count": null, "published_at": "2006-04-23", "scraped_at": "2026-09-07T02:08:06.451092+00:00", "scraper_version": "1.0.0"}

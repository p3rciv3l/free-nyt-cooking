{"slug": "amaretti-pears", "nyt_id": 3206, "url": "https://cooking.nytimes.com/recipes/3206-amaretti-pears", "name": "Amaretti Pears", "author": "Moira Hodgson", "description": "", "servings": {"text": "8 servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": 20, "cook_minutes": 60, "total_minutes": 60, "raw": {"total": "1 hour", "prep": "20 minutes", "cook": "1 hour"}}, "ingredients": [{"position": 1, "raw": "8 pears", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "pears", "preparation": null, "optional": false}, {"position": 2, "raw": "6 amaretti cookies", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "amaretti cookies", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons unsalted butter at room temperature", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter at room temperature", "preparation": null, "optional": false}, {"position": 4, "raw": "¾ cup dry white wine", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 5, "raw": "2 to 3 tablespoons sugar", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": "tbsp", "item": "sugar", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat oven to 400 degrees."}, {"position": 2, "text": "Peel, core and halve the pears and place them in a greased baking dish. Crush the cookies and mix them with the butter. Stuff into the pear cavities."}, {"position": 3, "text": "Pour the wine over the pears, sprinkle with sugar and bake for 45 minutes to one hour, until tender."}], "nutrition": {"calories": 198.7, "protein_g": 0.9, "carbohydrates_g": 34.2, "fat_g": 6.3, "saturated_fat_g": 3.7, "trans_fat_g": 0.0, "cholesterol_mg": 15.3, "sodium_mg": 11.4, "fiber_g": 5.8, "sugar_g": 22.7, "unsaturated_fat_g": 2.4, "source": "nyt", "basis": "per_s
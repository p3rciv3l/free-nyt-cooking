{"slug": "hinds-head-chocolate-wine", "nyt_id": 11263, "url": "https://cooking.nytimes.com/recipes/11263-hinds-head-chocolate-wine", "name": "Hinds Head Chocolate Wine", "author": "Christine Muhlke", "description": "Christine Muhlke", "servings": {"text": "Serves 6", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "2, 375-ml. bottles Banyuls or Maury wine, or 1, 750-ml. bottle ruby port", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "2, 375-ml. bottles banyuls or maury wine, or 1, 750-ml. bottle ruby port", "preparation": "375-ml. bottles Banyuls or Maury wine, or 1, 750-ml. bottle ruby port", "optional": false}, {"position": 2, "raw": "½ cup 2% milk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "2% milk", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ounce 33% Valrhona milk chocolate, finely chopped", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "oz", "item": "33% valrhona milk chocolate", "preparation": "finely chopped", "optional": false}], "steps": [{"position": 1, "text": "In a wide saucepan, boil the wine until reduced to 1 ¼ cups. Meanwhile, heat the milk to a boil. Place the chocolate in a mixing bowl, pour the milk over it and stir until the chocolate is melted."}, {"position": 2, "text": "Stir the wine into the chocolate mixture, return to the saucepan and reheat just until steaming. Using a hand blender, blend until frothy. Serve in small cups."}], "nutrition": {"calories": 209.6, "protein_g": 1.3, "carbohydrates_g": 18.7, "fat_g": 1.8, "saturated_fat_g": 1.1, "trans_fat_g": 0.0, "cholesterol_mg": 2.7, "sodium_mg": 23.1, "fiber_g": 0.2, "sugar_g": 11.9, "unsaturated_fat_g": 0.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion
{"slug": "hijiki-with-shiitakes-and-beans", "nyt_id": 7380, "url": "https://cooking.nytimes.com/recipes/7380-hijiki-with-shiitakes-and-beans", "name": "Hijiki With Shiitakes And Beans", "author": "Mark Bittman", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ½ ounces hijiki (about 1 cup)", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "oz", "item": "hijiki (about 1 cup)", "preparation": null, "optional": false}, {"position": 2, "raw": "5 large or 10 small dried shiitake mushrooms", "group": null, "quantity": 5.0, "quantity_max": null, "unit": null, "item": "large or 10 small dried shiitake mushrooms", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup diced chicken, shrimp or shucked small clams (canned are fine), optional", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "diced chicken", "preparation": "shrimp or shucked small clams (canned are fine)", "optional": true}, {"position": 5, "raw": "2 medium carrots, peeled and shredded", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium carrots", "preparation": "peeled and shredded", "optional": false}, {"position": 6, "raw": "1 cup fresh soybeans, flageolets, peas or black-eyed peas", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "fresh soybeans", "preparation": "flageolets, peas or black-eyed peas", "optional": false}, {"position": 7, "raw": "1 cup dashi or chicken stock", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dashi or chicken stock", "preparation": null, "optional": false}, {"position": 8, "raw": "2 tablespoons mirin (or 1 tablespoon honey)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "mirin (or 1 tablespoon honey)", "preparation": null, "optional": false}, {"position": 9, "raw": "¼ cup soy sauce, or to taste", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "soy sauce", "preparation": "or to taste", "optional": false}, {"position": 10, "raw": "Salt if necessary", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt if necessary", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Soak hijiki in cold water to cover, and shiitakes in very hot water to cover, each for about 10 minutes. Slice shiitakes, discarding tough stems. Reserve soaking liquid."}, {"position": 2, "text": "Put olive oil in a 12-inch skillet over medium-high heat. If you are using chicken or shrimp, brown pieces quickly in oil, for 2 or 3 minutes, stirring only once or twice. Remove with a slotted spoon."}, {"position": 3, "text": "Drain hijiki, and put in skillet; stir once, then add carrots and shiitakes. Stir again; add chicken, shrimp or clams, along with beans, shiitake soaking liquid, dashi or stock, and mirin and soy sauce. Stir, turn heat to medium-low, and cook, stirring occasionally, until carrots are tender, about 10 minutes. Mixture should be thick, not soupy. Taste, add more soy sauce or salt if necessary, and serve."}], "nutrition": {"calories": 239.3, "protein_g": 11.7, "carbohydrates_g": 17.5, "fat_g": 13.2, "saturated_fat_g": 2.7, "trans_fat_g": 0.0, "cholesterol_mg": 28.1, "sodium_mg": 1182.9, "fiber_g": 3.3, "sugar_g": 3.8, "unsaturated_fat_g": 9.7, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["japanese"], "diet": [], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["edamame", "hijiki", "one pot", "saute", "shiitake"]}, "images": [], "rat
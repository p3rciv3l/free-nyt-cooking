{"slug": "hirame-with-spicy-cucumber-vinaigrette", "nyt_id": 12043, "url": "https://cooking.nytimes.com/recipes/12043-hirame-with-spicy-cucumber-vinaigrette", "name": "Hirame With Spicy Cucumber Vinaigrette", "author": "Robert Schroeder", "description": "Robert Schroeder", "servings": {"text": "Serves 4", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 10, "raw": {"total": "10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 Japanese cucumbers or 1 small cucumber, sliced lengthwise and seeded", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "japanese cucumbers or 1 small cucumber", "preparation": "sliced lengthwise and seeded", "optional": false}, {"position": 2, "raw": "2 to 3 jalapenos, stems and seeds removed", "group": null, "quantity": 2.0, "quantity_max": 3.0, "unit": null, "item": "jalapenos", "preparation": "stems and seeds removed", "optional": false}, {"position": 3, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 4, "raw": "¼ cup rice vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "rice vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "¼ cup nam pla fish sauce", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "nam pla fish sauce", "preparation": null, "optional": false}, {"position": 6, "raw": "4 ounces hirame fluke fillet, skinned and boned (flounder or sole may be substituted)", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "hirame fluke fillet", "preparation": "skinned and boned (flounder or sole may be substituted)", "optional": false}, {"position": 7, "raw": "Lime, cut into wedges", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "lime", "preparation": "cut into wedges", "optional": false}, {"
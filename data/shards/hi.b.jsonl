{"slug": "hibiscus-gelee", "nyt_id": 1832, "url": "https://cooking.nytimes.com/recipes/1832-hibiscus-gelee", "name": "Hibiscus Gelée", "author": "Bill Yosses", "description": "", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": 60, "cook_minutes": 120, "total_minutes": 180, "raw": {"total": " 3.5 hours (210 minutes)", "prep": "1.5 hours", "cook": "2 hours for chilling"}}, "ingredients": [{"position": 1, "raw": "2 cups bottled water", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "bottled water", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ¼ cups sugar", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 ¾ ounces (about 1 ¼ cups) dried hibiscus flowers (see note)", "group": null, "quantity": 1.75, "quantity_max": null, "unit": "oz", "item": "(about 1 ¼ cups) dried hibiscus flowers (see note)", "preparation": null, "optional": false}, {"position": 4, "raw": "9 sheets (¾ ounce) leaf gelatin (see note)", "group": null, "quantity": 9.0, "quantity_max": null, "unit": "sheet", "item": "(¾ ounce) leaf gelatin (see note)", "preparation": null, "optional": false}, {"position": 5, "raw": "2 cups pure pomegranate juice (see note)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "cup", "item": "pure pomegranate juice (see note)", "preparation": null, "optional": false}, {"position": 6, "raw": "2 star fruits", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "star fruits", "preparation": null, "optional": false}, {"position": 7, "raw": "2 bananas, peeled and sliced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "bananas", "preparation": "peeled and sliced", "optional": false}, {"position": 8, "raw": "2 tablespoons pomegranate seeds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "pomegranate seeds", "preparation": null, "optional": false}, {"position": 9, "raw": "¾ cup diced pineapple or sliced strawberries for serving", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "diced pineapple or sliced strawberries for serving", "preparation": null, "optional": false}, {"position": 10, "raw": "¾ cup diced mango for serving", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "diced mango for serving", "preparation": null, "optional": false}, {"position": 11, "raw": "Plain yogurt for serving", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "plain yogurt for serving", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a saucepan, bring water to a boil. Add sugar, stirring until dissolved. Remove from heat, wait 20 seconds, add hibiscus. Steep 10 minutes. Set a mesh sieve over a bowl, strain and press to extract liquid."}, {"position": 2, "text": "Meanwhile, put gelatin in a small bowl, add ice water to cover. Set aside 5 minutes. When gelatin is soft, use a clean dish towel to squeeze out excess liquid gently."}, {"position": 3, "text": "Put hibiscus mixture in a saucepan over medium heat. Bring to a simmer. Turn off heat, and add softened gelatin. Whisk until dissolved. Strain liquid into another bowl, and stir in pomegranate juice."}, {"position": 4, "text": "Cut 1 star fruit into ¼-inch slices. In a decorative 6-cup mold, arrange half the slices in a single layer. Pour enough hibiscus liquid into the mold to not quite cover star fruit. Place mold in freezer or refrigerator 5 to 20 minutes to set gelatin."}, {"position": 5, "text": "Arrange half the banana over the gelatin, and gently pour half of the remaining hibiscus liquid into the mold. Scatter pomegranate seeds over the liquid and place mold in freezer or refrigerator for 20 to 45 minutes to set gelatin."}, {"position": 6, "text": "Gently pour remaining hibiscus liquid into the mold, and scatter remaining banana and star fruit slices over the top. Refrigerate until set, about 2 hours."}, {"position": 7, "text": "To serve, cut remaining star fruit into ¼-inch slices. Place in a bowl with pineapple or strawberries and mango, and combine. Invert mold onto a serving dish. Briefly run a hair dryer over the outer surface of the mold to release gelée. Lift off the mold, and serve gelée in slices with some of the mixed fruit and dollops of the yogurt."}], "nutrition": {"calories": 248.1, "protein_g": 7.3, "carbohydrates_g": 54.4, "fat_g": 1.4, "saturated_fat_g": 0.7, "trans_fat_g": 0.0, "cholesterol_mg": 3.7, "sodium_mg": 34.0, "fiber_g": 2.0, "sugar_g": 48.8, "unsaturated_fat_g": 0.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dessert"], "meal": [], "occasion": ["christmas"], "other": ["boil", "gelatin", "hibiscus", "pomegranate juice"]}, "images": [], "rating": null, "video_url": null, "comment_count": null, "published_at": "2001-12-19", "scraped_at": "2026-09-07T03:53:18.718596+00:00", "scraper_version": "1.0.0"}
{"slug": "hibiscus-hot-iced-tea", "nyt_id": 7552, "url": "https://cooking.nytimes.com/recipes/7552-hibiscus-hot-iced-tea", "name": "Hibiscus Hot Iced Tea", "author": "Matt Lee", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 60, "total_minutes": 60, "raw": {"cook": "About 1 hour", "total": "About 1 hour"}}, "ingredients": [{"position": 1, "raw": "1 ounce (a heaping ½ cup) dried hibiscus flowers (see note)", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "oz", "item": "(a heaping ½ cup) dried hibiscus flowers (see note)", "preparation": null, "optional": false}, {"position": 2, "raw": "½ cup sugar", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 small fresh habanero chili", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small fresh habanero chili", "preparation": null, "optional": false}, {"position": 4, "raw": "Ice for serving", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "ice for serving", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat 1 quart water to boiling and let stand 5 minutes."}, {"position": 2, "text": "Meanwhile, combine the hibiscus flowers and the sugar in a heat-safe 2-quart pitcher."}, {"position": 3, "text": "Over a gas burner, or in a hot, dry skillet, toast the chili until the skin has blackened in places. (Hold the chili with tongs; its natural oils irritate skin.) Cut the chili in half widthwise; discard the top half, which includes the seed pod and stem. Remove any stray seeds and add the chili to the sugar mixture."}, {"position": 4, "text": "Pour the hot water into the pitcher and cover with plastic wrap. Let steep for 30 minutes, removing the chili after it has flavored the tea to the desired hotness (10 to 30 minutes). Strain the tea through a sieve into a serving pitcher, and refrigerate until cool."}, {"position": 5, "text": "Serve in tall glasses over ice."}], "nutrition": {"calories": 67.1, "protein_g": 0.1, "carbohydrates_g": 17.3, "fat_g": 0.0, "saturated_fat_g": 0.0, "unsaturated_fat_g": null, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 0.6, "fiber_g": 0.0, "sugar_g": 16.7, "source": "nyt", "basis": "per_serving"}, "tags": {"cuisine": [], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["boil", "hibiscus", "non-alcoholic drinks", "sugar", "summer"]}, "images": [], "rating": {"average": 4.0, "count": 6}, "video_url": null, "comment_count": null, "published_at": "2003-05-04", "scraped_at": "2026-09-07T10:02:48.012652+00:00", "scraper_version": "1.0.0"}

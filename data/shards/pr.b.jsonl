{"slug": "provencal-chickpea-salad", "nyt_id": 3173, "url": "https://cooking.nytimes.com/recipes/3173-provencal-chickpea-salad", "name": "Provencal Chickpea Salad", "author": "Molly O’Neill", "description": "", "servings": {"text": "Eight servings", "min": 8, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 135, "raw": {"total": "2 hours 15 minutes"}}, "ingredients": [{"position": 1, "raw": "3 cups dried chickpeas, soaked in water overnight and drained", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "dried chickpeas", "preparation": "soaked in water overnight and drained", "optional": false}, {"position": 2, "raw": "4 fresh rosemary branches, plus 4 teaspoons, chopped fresh rosemary", "group": null, "quantity": 4.0, "quantity_max": null, "unit": null, "item": "fresh rosemary branches", "preparation": "plus 4 teaspoons, chopped fresh rosemary", "optional": false}, {"position": 3, "raw": "¼ cup red-wine vinegar", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "red-wine vinegar", "preparation": null, "optional": false}, {"position": 4, "raw": "1 medium-size head roasted garlic, peeled", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size head roasted garlic", "preparation": "peeled", "optional": false}, {"position": 5, "raw": "2 tablespoons, plus 2 teaspoons, olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "tablespoons", "preparation": "plus 2 teaspoons, olive oil", "optional": false}, {"position": 6, "raw": "¾ cup chopped Italian parsley", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "chopped italian parsley", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup pitted and chopped green olives", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "pitted and chopped green olives", "preparation": null, "optional": false}, {"position": 8, "raw": "¼ cup pitted and chopped imported black olives", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "pitted and chopped imported black olives", "preparation": null, "optional": false}, {"position": 9, "raw": "3 teaspoons salt, plus more to taste", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": "plus more to taste", "optional": false}, {"position": 10, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the chickpeas in a large pot and cover with cold water. Add the rosemary branches and bring to a boil over high heat. Reduce heat and simmer until the chickpeas are tender, about 2 hours, adding more water if necessary to keep them covered. Drain the chickpeas, place in a large bowl and discard the rosemary stems. Set aside."}, {"position": 2, "text": "Whisk together the vinegar and roasted garlic. Whisk in the olive oil. Stir in the chopped rosemary, parsley and olives. Toss the olive mixture with the chickpeas. Stir in the salt and pepper to taste. Serve at room temperature."}], "nutrition": {"calories": 341.0, "protein_g": 16.1, "carbohydrates_g": 50.9, "fat_g": 9.2, "saturated_fat_g": 1.2, "trans_fat_g": 0.0, "cholesterol_mg": 0.0, "sodium_mg": 253.1, "fiber_g": 10.1, "sugar_g": 8.2, "unsaturated_fat_g": 6.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": ["vegan", "vegetarian"], "course": [], "meal": [], "occasion": [], "other": ["beans", "boil", "chickpea", "olive", "parsley", "salad", "winter"]}, "images": [], "rating": {"average": 5.0, "count": 11}, "video_url": null, "comment_count": null, "published_at": "1994-05-22", "scraped_at": "2026-09-07T00:18:51.738803+00:00", "scraper_version": "1.0.0"}
{"slug": "provencal-tomato-and-squash-gratin", "nyt_id": 12681, "url": "https://cooking.nytimes.com/recipes/12681-provencal-tomato-and-squash-gratin", "name": "Provençal Tomato and Squash Gratin", "author": "Martha Rose Shulman", "description": "Some of the tomatoes in this gratin are cooked down to a savory sauce, while the rest are sliced and used to decorate the top.", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 105, "raw": {"total": "1 hour 45 minutes"}}, "ingredients": [{"position": 1, "raw": "2 pounds tomatoes", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "tomatoes", "preparation": null, "optional": false}, {"position": 2, "raw": "2 tablespoons extra virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "2 large garlic cloves, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "large garlic cloves", "preparation": "minced", "optional": false}, {"position": 4, "raw": "½ medium or 1 small onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "medium or 1 small onion", "preparation": null, "optional": false}, {"position": 5, "raw": "½ pound summer squash (1 good-size zucchini, for example), cut in ½-inch dice", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "lb", "item": "summer squash (1 good-size zucchini", "preparation": "for example), cut in ½-inch dice", "optional": false}, {"position": 6, "raw": "Salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 7, "raw": "2 teaspoons fresh thyme leaves, or 1 teaspoon crumbled dried thyme", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "fresh thyme leaves", "preparation": "or 1 teaspoon crumbled dried thyme", "optional": false}, {"position": 8, "raw": "1 cup cooked rice, farro or barley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "cooked rice", "preparation": "farro or barley", "optional": false}, {"position": 9, "raw": "3 eggs", "group": null, "quantity": 3.0, "quantity_max": null, "unit": null, "item": "eggs", "preparation": null, "optional": false}, {"position": 10, "raw": "2 ounces Gruyère cheese, grated (½ cup)", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "oz", "item": "gruyère cheese", "preparation": "grated (½ cup)", "optional": false}, {"position": 11, "raw": "1 to 2 tablespoons slivered or chopped fresh basil leaves", "group": null, "quantity": 1.0, "quantity_max": 2.0, "unit": "tbsp", "item": "slivered or chopped fresh basil leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Peel and seed half the tomatoes, and chop fine. Slice the rest and set aside. Preheat the oven to 375 degrees. Oil a 2-quart gratin or baking dish."}, {"position": 2, "text": "Heat 1 tablespoon of the olive oil in a large, heavy nonstick skillet over medium heat. Add the onion and cook, stirring often, until it is translucent, about 5 minutes. Add the garlic, stir together for about 30 seconds, until it begins to smell fragrant, and stir in the squash. Cook, stirring often, until the squash is translucent, about 5 minutes. Add the chopped tomatoes and the thyme, season with salt and pepper, raise the heat slightly and cook, stirring often, until the tomatoes have cooked down and smell fragrant, 10 to 15 minutes. Stir in the rice or other grains and remove from the heat."}, {"position": 3, "text": "Beat the eggs in a large bowl. Stir in the cooked vegetables, salt and pepper to taste, and the cheese and combine well. Scrape into the gratin dish."}, {"position": 4, "text": "Slice 
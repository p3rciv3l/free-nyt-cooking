{"slug": "pressure-cooker-squash-with-honey-and-lemongrass", "nyt_id": 12283, "url": "https://cooking.nytimes.com/recipes/12283-pressure-cooker-squash-with-honey-and-lemongrass", "name": "Pressure Cooker Squash With Honey and Lemongrass", "author": "Melissa Clark", "description": "This caramelized delicata squash purée, adapted from Nathan Myhrvold's multivolume “Modernist Cuisine: The Art and Science of Cooking,” is prepared in a pressure cooker. Normally, a pressure cooker wouldn’t get hot enough to caramelize anything. But, Mr. Myhrvold explained, if you create an alkaline environment with a sprinkle of baking soda, you can caramelize at a lower temperature. And the pressurized environment helps ingredients caramelize through and through, not just around the outside. This gives the squash an intense, nutty flavor, which is enhanced here with buckwheat honey and lemongrass. Melissa Clark", "servings": {"text": "10 servings", "min": 10, "max": 10, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 35, "raw": {"total": "35 minutes"}}, "ingredients": [{"position": 1, "raw": "4 tablespoons unsalted butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "unsalted butter", "preparation": null, "optional": false}, {"position": 2, "raw": "1 ½ pounds delicata squash, peeled, seeded and cut into ½-inch cubes (4 cups)", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "lb", "item": "delicata squash", "preparation": "peeled, seeded and cut into ½-inch cubes (4 cups)", "optional": false}, {"position": 3, "raw": "½ lemongrass stalk", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "lemongrass stalk", "preparation": null, "optional": false}, {"position": 4, "raw": "1 teaspoon kosher salt", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "kosher salt", "preparation": null, "optional": false}, {"position": 5, "raw": "½ teaspoon baking soda", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "baking soda", "preparation": null, "optional": false}, {"position": 6, "raw": "Buckwheat honey or other honey", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "buckwheat honey or other honey", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Melt butter in a pressure cooker. Stir in squash, lemongrass, salt and baking soda. Cover tightly with pressure cooker lid and cook at a gauge pressure of 1 bar (15 p.s.i.) for 20 minutes. Begin the timing after the pressure has been reached."}, {"position": 2, "text": "Depressurize the cooker according to the manufacturer’s instructions."}, {"position": 3, "text": "Remove lemongrass. Blend the squash to a smooth purée. Season with honey to taste. Serve, or refrigerate and then reheat gently before serving."}], "nutrition": null, "tags": {"cuisine": [], "diet": ["gluten-free", "vegetarian"], "course": ["side dish"], "meal": [], "occasion": [], "other": ["five ingredient", "squash", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2012/01/18/dining/video-myhrvoldsquash/video-myhrvoldsquash-superJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 174}, "video_url": "https://www.nytimes.com/video/dining/100000001265540/in-the-kitchen-with-nathan-myhrvold.html", "comment_count": null, "published_at": "2012-01-17", "scraped_at": "2026-09-06T23:55:00.288374+00:00", "scraper_version": "1.0.0"}
{"slug": "profiteroles-with-port-wine-mushrooms", "nyt_id": 6808, "url": "https://cooking.nytimes.com/recipes/6808-profiteroles-with-port-wine-mushrooms", "name": "Profiteroles With Port-Wine Mushrooms", "author": "Craig Claiborne, Pierre Franey", "description": "", "servings": {"text": "24 filled cream puffs", "min": 24, "max": 24, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons butter", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon finely chopped shallots", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped shallots", "preparation": null, "optional": false}, {"position": 3, "raw": "¾ pound mushrooms, cut into quarter-inch cubes, about 3 cups", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "lb", "item": "mushrooms", "preparation": "cut into quarter-inch cubes, about 3 cups", "optional": false}, {"position": 4, "raw": "2 tablespoons lemon juice", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "lemon juice", "preparation": null, "optional": false}, {"position": 5, "raw": "Salt, if desired", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": "if desired", "optional": false}, {"position": 6, "raw": "Freshly ground pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper", "preparation": null, "optional": false}, {"position": 7, "raw": "¼ cup Port wine", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "port wine", "preparation": null, "optional": false}, {"position": 8, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 9, "raw": "24 cream puffs (see recipe)", "group": null, "quantity": 24.0, "quantity_max": null, "unit": null, "item": "cream puffs (see recipe)", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Melt the butter in a skillet and add the shallots. Cook briefly, stirring."}, {"position": 2, "text": "Add the mushrooms, lemon juice, salt and pepper to taste. Cook, stirring, until the liquid evaporates. Add the wine and cook until it is almost wholly evaporated."}, {"position": 3, "text": "Add the cream and cook down about 10 minutes or until the mixture is reduced to two cups."}, {"position": 4, "text": "Slice off the tops of all the cream puffs. Spoon an equal portion of the mixture into each cream-puff bottom. Replace the tops and serve."}], "nutrition": {"calories": 382.6, "protein_g": 5.2, "carbohydrates_g": 38.7, "fat_g": 23.1, "saturated_fat_g": 10.0, "trans_fat_g": 0.1, "cholesterol_mg": 79.8, "sodium_mg": 298.6, "fiber_g": 1.2, "sugar_g": 22.7, "unsaturated_fat_g": 11.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": [], "course": ["appetizer"], "meal": [], "occasion": [], "other": ["all-purpose flour", "bake", "butter", "egg", "heavy cream", "mushroom", "port", "project", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 5}, "video_url": null, "comment_count": null, "published_at": "1982-02-21", "scraped_at": "2026-09-07T00:56:40.814336+00:00", "scraper_version": "1.0.0"}
{"slug": "prosciutto-and-tomato-salad-with-smoked-mozzarella-croutes", "nyt_id": 3910, "url": "https://cooking.nytimes.com/recipes/3910-prosciutto-and-tomato-salad-with-smoked-mozzarella-croutes", "name": "Prosciutto and Tomato Salad With Smoked Mozzarella Croutes", "author": "Molly O’Neill", "description": "", "servings": {"text": "Two main-course or four first-course servings", "min": 2, "max": 2, "yield_type": "pieces"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "¾ cup sun-dried tomatoes, not oil-packed", "group": null, "quantity": 0.75, "quantity_max": null, "unit": "cup", "item": "sun-dried tomatoes", "preparation": "not oil-packed", "optional": false}, {"position": 2, "raw": "4 cups mixed salad greens", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "cup", "item": "mixed salad greens", "preparation": null, "optional": false}, {"position": 3, "raw": "8 thin slices prosciutto, cut across into thin strips", "group": null, "quantity": 8.0, "quantity_max": null, "unit": null, "item": "thin slices prosciutto", "preparation": "cut across into thin strips", "optional": false}, {"position": 4, "raw": "2 teaspoons balsamic vinegar", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "balsamic vinegar", "preparation": null, "optional": false}, {"position": 5, "raw": "2 teaspoons olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon salt", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "salt", "preparation": null, "optional": false}, {"position": 7, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 8, "raw": "8 ½-inch slices 
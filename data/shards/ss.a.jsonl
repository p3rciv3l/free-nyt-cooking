{"slug": "ssamjang-pork-meatballs", "nyt_id": 1025911, "url": "https://cooking.nytimes.com/recipes/1025911-ssamjang-pork-meatballs", "name": "Ssamjang Pork Meatballs", "author": "Samantha Seneviratne", "description": "Sweet and spicy ssamjang is a Korean sauce, mostly used for grilled dishes. Made with slow-fermented soybean paste, it’s salty and pungent and adds quite a bit of flavor, perfect to spruce up some ground pork for a quick, weeknight meatball. You can buy it in the Asian grocery section or make your own. Try these meatballs in a lettuce cup with rice and kimchi or served straight-up with some grilled vegetables.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": 15, "cook_minutes": 15, "total_minutes": 30, "raw": {"prep": "PT15M", "cook": "PT15M", "total": "PT30M"}}, "ingredients": [{"position": 1, "raw": "1 pound ground pork", "group": null, "quantity": 1.0, "unit": "lb", "item": "ground pork", "preparation": null, "optional": false}, {"position": 2, "raw": "⅓ cup ssamjang, store bought or homemade", "group": null, "quantity": 0.3333333333333333, "unit": "cup", "item": "ssamjang", "preparation": "store bought or homemade", "optional": false}, {"position": 3, "raw": "¼ cup/20 grams panko bread crumbs", "group": null, "quantity": 0.25, "unit": "cup", "item": "/20 grams panko bread crumbs", "preparation": null, "optional": false}, {"position": 4, "raw": "3 scallions, minced, plus more for serving", "group": null, "quantity": 3.0, "unit": null, "item": "scallions", "preparation": "minced, plus more for serving", "optional": false}, {"position": 5, "raw": "3 tablespoons minced ginger (from one 2-inch piece, no need to peel)", "group": null, "quantity": 3.0, "unit": "tbsp", "item": "minced ginger (from one 2-inch piece", "preparation": "no need to peel)", "optional": false}, {"position": 6, "raw": "1 tablespoon minced garlic (from 2 to 3 large cloves)", "group": null, "quantity": 1.0, "unit": "tbsp", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 7, "raw": "Kosher salt", "group": null, "quantity": null, "unit": null, "item": "kosher salt", "preparation": null, "optional": false}, {"position": 8, "raw": "Lettuce, for serving", "group": null, "quantity": null, "unit": null, "item": "lettuce", "preparation": "for serving", "optional": false}, {"position": 9, "raw": "Cooked rice, for serving", "group": null, "quantity": null, "unit": null, "item": "cooked rice", "preparation": "for serving", "optional": false}], "steps": [{"position": 1, "text": "Heat oven to 425 degrees. In a large bowl, combine the pork, ssamjang, panko, scallions, ginger, garlic and ½ teaspoon salt and use your hands to gently mix."}, {"position": 2, "text": "Shape the meat into 16 balls (about 1 ½ inches in diameter) and arrange on a parchment or foil-lined, rimmed baking sheet."}, {"position": 3, "text": "Bake until golden and cooked through, about 15 minutes. Serve warm, sprinkled with scallions, in lettuce cups with rice if desired."}], "nutrition": {"source": "nyt", "basis": "per_serving", "calories": 441.5, "protein_g": 24.9, "carbohydrates_g": 26.6, "fat_g": 25.9, "saturated_fat_g": 9.2, "unsaturated_fat_g": 2.9, "trans_fat_g": null, "cholesterol_mg": 81.6, "sodium_mg": 930.6, "fiber_g": 2.5, "sugar_g": 2.3, "computed_with": null}, "tags": {"cuisine": [], "diet": [], "course": ["dinner-lunch-main-course-meatballs"], "meal": [], "occasion": [], "other": ["budget", "easy", "great-leftovers", "ground-pork", "panko", "quick", "sheet-pan", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2024/10/22/multimedia/ss-ssamjang-pork-meatballs-tvpm/ss-ssamjang-pork-meatballs-tvpm-videoSixteenByNineJumbo1600.jpg", "alt": "", "primary": true}, {"url": "https://static01.nyt.com/images/2024/10/22/multimedia/ss-ssamjang-pork-meatballs-tvpm/ss-ssamjang-pork-meatballs-tvpm-googleFourByThree.jpg", "alt": "", "primary": false}, {"url": "https://static01.nyt.com/i
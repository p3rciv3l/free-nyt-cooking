{"slug": "clams-with-chinese-black-bean-sauce", "nyt_id": 4607, "url": "https://cooking.nytimes.com/recipes/4607-clams-with-chinese-black-bean-sauce", "name": "Clams with Chinese Black Bean Sauce", "author": "Florence Fabricant", "description": "Florence Fabricant", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 25, "raw": {"total": "25 minutes"}}, "ingredients": [{"position": 1, "raw": "2 tablespoons Chinese fermented black beans", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "chinese fermented black beans", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon olive oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 3, "raw": "1 medium-size shallot, peeled and minced", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "medium-size shallot", "preparation": "peeled and minced", "optional": false}, {"position": 4, "raw": "2 small cloves garlic, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small cloves garlic", "preparation": "minced", "optional": false}, {"position": 5, "raw": "2 sun-dried tomatoes, minced", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "sun-dried tomatoes", "preparation": "minced", "optional": false}, {"position": 6, "raw": "2 teaspoons grated ginger", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tsp", "item": "grated ginger", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup dry white wine, or to taste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": "or to taste", "optional": false}, {"position": 8, "raw": "2 pounds littleneck clams (about 3 dozen), scrubbed", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "lb", "item": "littleneck clams (about 3 dozen)", "preparation": "scrubbed", "optional": false}, {"position": 9, "raw": "1 tablespoon fresh coriander leaves", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "fresh coriander leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Rinse the beans and put them in a bowl. Cover with cold water and soak overnight."}, {"position": 2, "text": "Heat the olive oil in a heavy 3- to 4-quart saucepan. Add the shallots and saute over low heat until tender. Stir in the garlic, sun-dried tomatoes and ginger. Drain the black beans and add them. Add the cup of wine, bring to a simmer and add the clams."}, {"position": 3, "text": "Cover tightly and cook over medium heat until the clams open, about 10 minutes. Taste sauce and add a little water or wine if it is too salty. Transfer to soup plates, garnish with coriander and serve."}], "nutrition": {"calories": 305.8, "protein_g": 35.1, "carbohydrates_g": 15.4, "fat_g": 6.1, "saturated_fat_g": 1.0, "trans_fat_g": 0.0, "cholesterol_mg": 68.0, "sodium_mg": 1686.4, "fiber_g": 1.1, "sugar_g": 2.7, "unsaturated_fat_g": 3.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["asian"], "diet": [], "course": ["main course"], "meal": [], "occasion": [], "other": ["clam", "fermented black bean", "saute", "sun-dried tomato", "weeknight"]}, "images": [], "rating": {"average": 3.0, "count": 10}, "video_url": null, "comment_count": null, "published_at": "1992-03-25", "scraped_at": "2026-09-07T00:34:40.636368+00:00", "scraper_version": "1.0.0"}
{"slug": "classic-irish-salad", "nyt_id": 3995, "url": "https://cooking.nytimes.com/recipes/3995-classic-irish-salad", "name": "Classic Irish Salad", "author": "Moira Hodgson", "description": "", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 70, "raw": {"total": "1 hour 10 minutes"}}, "ingredients": [{"position": 1, "raw": "2 medium beets", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "medium beets", "preparation": null, "optional": false}, {"position": 2, "raw": "2 small heads bibb lettuce", "group": null, "quantity": 2.0, "quantity_max": null, "unit": null, "item": "small heads bibb lettuce", "preparation": null, "optional": false}, {"position": 3, "raw": "2 bunches watercress", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "bunch", "item": "watercress", "preparation": null, "optional": false}, {"position": 4, "raw": "2 tablespoons creme fraiche", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "creme fraiche", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon chopped parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "chopped parsley", "preparation": null, "optional": false}, {"position": 6, "raw": "5 tablespoons extra-virgin olive oil", "group": null, "quantity": 5.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 7, "raw": "3 tablespoons herb infused white vinegar (or to taste)", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "tbsp", "item": "herb infused white vinegar (or to taste)", "preparation": null, "optional": false}, {"position": 8, "raw": "Coarse salt and freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt and freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 9, "raw": "1 dozen quail eggs, boiled for two minutes", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "dozen quail eggs", "preparation": "boiled for two minutes", "optional": false}, {"position": 10, "raw": "½ cup chopped chervil leaves", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped chervil leaves", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Place the beets in a saucepan with water to cover and simmer for one hour or until tender. Remove from heat and allow to cool in the liquid. Peel and julienne."}, {"position": 2, "text": "Break up the heads of bibb lettuce, leaving the leaves whole. Wash and dry. Cut the stems from the watercress; wash and dry the leaves."}, {"position": 3, "text": "Make the dressing. Mix the creme fraiche, parsley, olive oil and vinegar together and season to taste with salt and pepper."}, {"position": 4, "text": "To assemble, put whole leaves of lettuce around the outer edges of six individual plates. Place watercress in the middle of the plate and sprinkle the beets on top. Peel the quail eggs and cut them in half. Place the eggs on top and sprinkle with chervil. Drizzle dressing over and serve."}], "nutrition": {"calories": 162.3, "protein_g": 4.4, "carbohydrates_g": 4.9, "fat_g": 14.4, "saturated_fat_g": 2.7, "trans_fat_g": 0.0, "cholesterol_mg": 154.7, "sodium_mg": 346.2, "fiber_g": 1.7, "sugar_g": 2.6, "unsaturated_fat_g": 10.8, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["irish"], "diet": ["gluten-free", "vegetarian"], "course": ["appetizer", "main course", "side dish"], "meal": ["dinner", "lunch"], "occasion": ["st. patrick’s day"], "other": ["beet", "boil", "mixed greens", "salad"]}, "images": [], "rating": {"average": 4.0, "count": 31}, "video_url": null, "comment_count": null, "published_at": "1991-03-17", "scraped_at": "2026-09-07T00:28:23.872570+00:00", "scraper_version": "1.0.0"}
{"slug": "classic-stuffed-mushrooms", "nyt_id": 27, "url": "https://cooking.nytimes.com/recipes/27-classic-stuffed-mushrooms", "name": "Classic Stuffed Mushrooms", "author": "Craig Claiborne", "description": "This classic hors d'oeuvres recipe first appeared in The Times in a February 1981 column by Craig Claiborne on the then-popular topic of no-salt cooking. Mushrooms, he said, are “the one basic ingredient best suited to a no-salt cookery,” noting a “depth of flavor” and “a meat-like consistency.” We may have relaxed our beliefs regarding our salt consumption, but this more than 30-year old recipe remains a reader favorite. It's also blessedly easy to make. After removing the stems from the mushrooms, you simply sauté the caps with a little butter, lemon juice and black pepper (we won't tell if you add a little salt). Make a simple stuffing of chopped mushroom stems, shallots, garlic, celery, thyme, egg, bread crumbs and shredded Gouda. Stuff the mushroom caps, drizzle with butter and bake for about 15 minutes. See? The 1980s weren't so bad.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 40, "raw": {"total": "40 minutes"}}, "ingredients": [{"position": 1, "raw": "1 ¼ pounds mushrooms", "group": null, "quantity": 1.25, "quantity_max": null, "unit": "lb", "item": "mushrooms", "preparation": null, "optional": false}, {"position": 2, "raw": "4 tablespoons butter", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": null, "optional": false}, {"position": 3, "raw": "Juice of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1 lemon", "preparation": null, "optional": false}, {"position": 4, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}, {"position": 5, "raw": "⅓ cup coarsely chopped shallots", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "coarsely chopped shallots", "preparation": null, "optional": false}, {"position": 6, "raw": "½ teaspoon minced garlic", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "minced garlic", "preparation": null, "optional": false}, {"position": 7, "raw": "1 cup coarsely chopped celery, optional", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "coarsely chopped celery", "preparation": null, "optional": true}, {"position": 8, "raw": "¼ teaspoon dried thyme", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "tsp", "item": "dried thyme", "preparation": null, "optional": false}, {"position": 9, "raw": "1 small bay leaf", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "small bay leaf", "preparation": null, "optional": false}, {"position": 10, "raw": "¼ cup coarsely chopped parsley", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "coarsely chopped parsley", "preparation": null, "optional": false}, {"position": 11, "raw": "1 egg, lightly beaten", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "egg", "preparation": "lightly beaten", "optional": false}, {"position": 12, "raw": "¼ cup fine fresh bread crumbs", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "fine fresh bread crumbs", "preparation": null, "optional": false}, {"position": 13, "raw": "¼ cup grated cheese, preferably low-sodium cheese, such as Gouda", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "grated cheese", "preparation": "preferably low-sodium cheese, such as Gouda", "optional": false}, {"position": 14, "raw": "Salt and pepper, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt and pepper", "preparation": "to taste", "optional": false}], "steps": [{"position": 1, "text": "Preheat the oven to 400 degrees."}, {"position": 2, "text": "Remove and reserve the mushroom stems. There should be about two cups. Chop the stems coarsely."}, {"position": 3, "text": "Heat one tablespoon of the butter in a saucepan and add the mushroom caps. Sprinkle with the juice of half a lemon and a generous grinding of pepper. Cook, stirring often but gently so as not to break the caps. This is to remove the moisture from the caps. Cook about two minutes. Remove the caps to a platter."}, {"position": 4, "text": "Add one tablespoon of butter to the saucepan and add the shallots and garlic. When they've begun to soften, add the chopped mushroom stems and juice of the remaining half a lemon. Add the celery, thyme and bay leaf. Cook, stirring often, about five minutes. Remove the bay leaf."}, {"position": 5, "text": "Spoon and scrape the mixture into the container of a food processor. Add the parsley and process to a fine puree."}, {"position": 6, "text": "Return the mixture to a saucepan and cook, stirring often, about five minutes. Add the egg and bread crumbs. Cook about 10 seconds, stirring, and remove from the heat. Stir in cheese. Salt and pepper to taste."}, {"position": 7, "text": "Stuff the caps with an equal amount of the filling. Smooth over the tops. Arrange the caps as they are stuffed close together in a baking dish. Sprinkle with two tablespoons of melted butter."}, {"position": 8, "text": "Place the mushrooms caps in the oven and bake 15 minutes."}], "nutrition": {"calories": 135.6, "protein_g": 5.8, "carbohydrates_g": 8.2, "fat_g": 10.1, "saturated_fat_g": 5.9, "trans_fat_g": 0.0, "cholesterol_mg": 52.1, "sodium_mg": 373.5, "fiber_g": 2.3, "sugar_g": 3.4, "unsaturated_fat_g": 3.5, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": ["vegetarian"], "course": ["appetizer"], "meal": [], "occasion": [], "other": 
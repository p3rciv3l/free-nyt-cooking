{"slug": "baked-feta-with-honey", "nyt_id": 10427, "url": "https://cooking.nytimes.com/recipes/10427-baked-feta-with-honey", "name": "Baked Feta With Honey", "author": "Sara Dickerman", "description": "A drizzle of honey and a blast of heat transform a standard block of crumbly feta into an unexpectedly luscious, creamy spread for pita and vegetables. This, with a hunk of crusty bread and a glass of chilled white wine, is the perfect warm weather supper. If you can't get your hands on thyme honey, the regular sort will do just fine.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 8-ounce block of feta, preferably Greek, blotted dry", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "8-ounce block of feta", "preparation": "preferably Greek, blotted dry", "optional": false}, {"position": 2, "raw": "Sprig of fresh thyme, optional", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sprig of fresh thyme", "preparation": null, "optional": true}, {"position": 3, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon honey", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 5, "raw": "Black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "Pita bread, toasted and cut into wedges", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pita bread", "preparation": "toasted and cut into wedges", "optional": false}, {"position": 7, "raw": "Heirloom tomatoes, roasted beets, nuts or pickled vegetables (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "heirloom tomatoes", "preparation": "roasted beets, nuts or pickled vegetables", "optional": true}], "steps": [{"position": 1, "text": "Heat the oven to 400 degrees. Select a small oven-to-table earthenware dish or a small ovenproof sauté pan. Place the feta in the dish, top with thyme, if using, and cover with the olive oil. Bake until the cheese is soft and springy to the touch but not melted, about 8 minutes."}, {"position": 2, "text": "Heat the broiler. Heat the honey in the microwave or over a pan of simmering water until it is fluid enough to be spread with a pastry brush, then paint the surface of the feta with it. Broil until the top of the cheese browns and just starts to bubble. Season to taste with black pepper. Serve immediately with pita wedges and, if desired, sliced heirloom tomatoes, roasted beets, nuts or pickled vegetables."}], "nutrition": {"calories": 175.4, "protein_g": 6.4, "carbohydrates_g": 9.7, "fat_g": 12.8, "saturated_fat_g": 5.7, "trans_fat_g": 0.0, "cholesterol_mg": 33.6, "sodium_mg": 464.5, "fiber_g": 0.8, "sugar_g": 3.6, "unsaturated_fat_g": 5.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["greek"], "diet": ["vegetarian"], "course": ["appetizer"], "meal": ["dinner", "lunch"], "occasion": ["vegetarian thanksgiving"], "other": ["bake", "broil", "dips and spreads", "easy", "feta", "five ingredient", "for one", "quick", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2023/11/01/multimedia/SD-Roasted-Feta-With-Thyme-Honey-vqlk/SD-Roasted-Feta-With-Thyme-Honey-vqlk-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 3623}, "video_url": "https://www.nytimes.com/video/embedded/dining/100000009443519/baked-feta-with-honey.html", "comment_count": null, "published_at": "2007-09-09", "scraped_at": "2026-09-06T22:22:20.892688+00:00", "scraper_version": "1.0.0"}
{"slug": "bagna-cauda-with-butter", "nyt_id": 10474, "url": "https://cooking.nytimes.com/recipes/10474-bagna-cauda-with-butter", "name": "Bagna Cauda With Butter", "author": "Craig Claiborne, Pierre Franey", "description": "This sauce is a Northern Italian classic, and tastes delicious on pretty much anything. It is a traditional dipping sauce for vegetables, but try drizzling it over roasted fish. Be sure to sop up all leftovers with good bread, and do not skimp on the anchovies.", "servings": {"text": "Three-quarters of a cup", "min": 0, "max": 0, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "4 tablespoons olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup dry white wine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 4, "raw": "8 tablespoons butter, cut into small squares", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": "cut into small squares", "optional": false}, {"position": 5, "raw": "1 tablespoon finely chopped anchovies or anchovy paste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped anchovies or anchovy paste", "preparation": null, "optional": false}, {"position": 6, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oil in a 
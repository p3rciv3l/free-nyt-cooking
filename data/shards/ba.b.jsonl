{"slug": "bagna-cauda-with-butter", "nyt_id": 10474, "url": "https://cooking.nytimes.com/recipes/10474-bagna-cauda-with-butter", "name": "Bagna Cauda With Butter", "author": "Craig Claiborne, Pierre Franey", "description": "This sauce is a Northern Italian classic, and tastes delicious on pretty much anything. It is a traditional dipping sauce for vegetables, but try drizzling it over roasted fish. Be sure to sop up all leftovers with good bread, and do not skimp on the anchovies.", "servings": {"text": "Three-quarters of a cup", "min": 0, "max": 0, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "15 minutes"}}, "ingredients": [{"position": 1, "raw": "4 tablespoons olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "olive oil", "preparation": null, "optional": false}, {"position": 2, "raw": "1 tablespoon finely minced garlic", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely minced garlic", "preparation": null, "optional": false}, {"position": 3, "raw": "½ cup dry white wine", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry white wine", "preparation": null, "optional": false}, {"position": 4, "raw": "8 tablespoons butter, cut into small squares", "group": null, "quantity": 8.0, "quantity_max": null, "unit": "tbsp", "item": "butter", "preparation": "cut into small squares", "optional": false}, {"position": 5, "raw": "1 tablespoon finely chopped anchovies or anchovy paste", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "finely chopped anchovies or anchovy paste", "preparation": null, "optional": false}, {"position": 6, "raw": "Freshly ground pepper to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground pepper to taste", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Heat the oil in a saucepan over medium-high heat and add the garlic. Cook briefly, stirring, without browning. Add the wine and cook until reduced by half."}, {"position": 2, "text": "Add the butter, a little at a time, beating rapidly with a wire whisk. Stir in the anchovy, season with pepper and serve hot."}], "nutrition": {"calories": 238.1, "protein_g": 0.9, "carbohydrates_g": 1.1, "fat_g": 24.6, "saturated_fat_g": 10.9, "trans_fat_g": 0.0, "cholesterol_mg": 42.4, "sodium_mg": 76.9, "fiber_g": 0.1, "sugar_g": 0.2, "unsaturated_fat_g": 12.6, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["italian"], "diet": [], "course": [], "meal": [], "occasion": [], "other": ["anchovy", "condiments", "garlic", "olive oil", "sauces and gravies"]}, "images": [{"url": "https://static01.nyt.com/images/2016/04/20/dining/20ASPARAGUS28/20ASPARAGUS28-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 4.0, "count": 67}, "video_url": null, "comment_count": null, "published_at": "1985-05-19", "scraped_at": "2026-09-06T22:25:18.494479+00:00", "scraper_version": "1.0.0"}
{"slug": "baked-farfalle-with-eggplant", "nyt_id": 10725, "url": "https://cooking.nytimes.com/recipes/10725-baked-farfalle-with-eggplant", "name": "Baked Farfalle With Eggplant", "author": "Florence Fabricant", "description": "", "servings": {"text": "6 to 8 servings", "min": 6, "max": 8, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 90, "raw": {"total": "1 hour 30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 eggplant, about 1 ½ pounds", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "eggplant", "preparation": "about 1 ½ pounds", "optional": false}, {"position": 2, "raw": "Salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "salt", "preparation": null, "optional": false}, {"position": 3, "raw": "4 tablespoons extra-virgin olive oil", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "½ cup chopped onion", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "chopped onion", "preparation": null, "optional": false}, {"position": 5, "raw": "4 cloves garlic, minced", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "clove", "item": "garlic", "preparation": "minced", "optional": false}, {"position": 6, "raw": "½ teaspoon hot red pepper flakes (or to taste)", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "hot red pepper flakes (or to taste)", "preparation": null, "optional": false}, {"position": 7, "raw": "3 cups coarsely chopped ripe or well-drained canned tomatoes", "group": null, "quantity": 3.0, "quantity_max": null, "unit": "cup", "item": "coarsely chopped ripe or well-drained canned tomatoes", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon minced flat-leaf parsley", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "minced flat-leaf parsley", "preparation": null, "optional": false}, {"position": 9, "raw": "Freshly ground black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "freshly ground black pepper", "preparation": null, "optional": false}, {"position": 10, "raw": "1 pound farfalle", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "lb", "item": "farfalle", "preparation": null, "optional": false}, {"position": 11, "raw": "4 ounces shredded mozzarella cheese", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "oz", "item": "shredded mozzarella cheese", "preparation": null, "optional": false}, {"position": 12, "raw": "½ cup freshly grated Parmesan cheese", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "freshly grated parmesan cheese", "preparation": null, "optional": false}, {"position": 13, "raw": "½ cup dry bread crumbs", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "cup", "item": "dry bread crumbs", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "Preheat a broiler or grill. Slice the eggplant one-half-inch thick. Grill or broil it, turning it once, until it is nicely browned. It will look dry and papery. Set it aside."}, {"position": 2, "text": "Place a pot with four quarts of salted water over high heat."}, {"position": 3, "text": "Heat one tablespoon of the oil in a heavy skillet, add the onion and saute until golden. Stir in the garlic and hot red pepper. Add the tomatoes and simmer about 15 minutes, until the sauce is slightly thickened. Stir in the parsley and season to taste with salt and pepper, adding additional hot pepper if desired."}, {"position": 4, "text": "When the water is boiling, add the farfalle and cook until it is just tender, about eight minutes. Drain it well; toss it with a tablespoon of the oil, and season with salt and pepper."}, {"position": 5, "text": "Oil a baking dish 8 by 12 inches with half a tablespoon of the oil and spread one-third of the farfalle in the dish. Spread half the eggplant on the farfalle and spoon on one-third of the tomato sauce. Top with half the mozzarella. Repeat with a layer of farfalle, the rest of the eggplant, half the remaining tomato sauce and the rest of the mozzarella. Spread the remaining farfalle and tomato sauce on top and sprinkle with the Parmesan cheese, bread crumbs and remaining oil. Set aside until half an hour before serving time. If you refrigerate it, be sure to bring the dish to room temperature before baking."}, {"position": 6, "text": "Preheat oven to 375 degrees. Place the baking dish in the oven and bake for 30 minutes, until the sauce is bubbling and the top has browned."}], "nutrition": {"calories": 422.5, "protein_g": 16.5, "carbohydrates_g": 58.0, "fat_g": 14.2, "saturated_fat_g": 4.8, "trans_fat_g": 0.0, "cholesterol_mg": 18.9, "sodium_mg": 655.1, "fiber_g": 6.8, "sugar_g": 7.9, "unsaturated_fat_g": 8.3, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["vegetarian"], "course": ["main course"], "meal": ["dinner"], "occasion": [], "other": ["bake", "boil", "broil", "casseroles", "eggplant", "farfalle", "great leftovers", "grill", "pastas", "saute"]}, "images": [], "rating": {"average": 4.0, "count": 15}, "video_url": null, "comment_count": null, "published_at": "1994-06-12", "scraped_at": "2026-09-06T22:31:21.074068+00:00", "scraper_version": "1.0.0"}
{"slug": "baked-feta-with-honey", "nyt_id": 10427, "url": "https://cooking.nytimes.com/recipes/10427-baked-feta-with-honey", "name": "Baked Feta With Honey", "author": "Sara Dickerman", "description": "A drizzle of honey and a blast of heat transform a standard block of crumbly feta into an unexpectedly luscious, creamy spread for pita and vegetables. This, with a hunk of crusty bread and a glass of chilled white wine, is the perfect warm weather supper. If you can't get your hands on thyme honey, the regular sort will do just fine.", "servings": {"text": "4 to 6 servings", "min": 4, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 30, "raw": {"total": "30 minutes"}}, "ingredients": [{"position": 1, "raw": "1 8-ounce block of feta, preferably Greek, blotted dry", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "8-ounce block of feta", "preparation": "preferably Greek, blotted dry", "optional": false}, {"position": 2, "raw": "Sprig of fresh thyme, optional", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "sprig of fresh thyme", "preparation": null, "optional": true}, {"position": 3, "raw": "2 tablespoons extra-virgin olive oil", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "extra-virgin olive oil", "preparation": null, "optional": false}, {"position": 4, "raw": "1 tablespoon honey", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "honey", "preparation": null, "optional": false}, {"position": 5, "raw": "Black pepper", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "black pepper", "preparation": null, "optional": false}, {"position": 6, "raw": "Pita bread, toasted and cut into wedges", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pita bread", "preparation": "toasted and cut into wedges", "optional": false}, {"position": 7, "raw": "Heirloom tomatoes, roasted beets, nuts or pickled vegetables (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "heirloom tomatoes", "preparation": "roasted beets, nuts or pickled vegetables", "optional": true}], "steps": [{"position": 1, "text": "Heat the oven to 400 degrees. Select a small oven-to-table earthenware dish or a small ovenproof sauté pan. Place the feta in the dish, top with thyme, if using, and cover with the olive oil. Bake until the cheese is soft and springy to the touch but not melted, about 8 minutes."}, {"position": 2, "text": "Heat the broiler. Heat the honey in the microwave or over a pan of simmering water until it is fluid enough to be spread with a pastry brush, then paint the surface of the feta with it. Broil until the top of the cheese browns and just starts to bubble. Season to taste with black pepper. Serve immediately with pita wedges and, if desired, sliced heirloom tomatoes, roasted beets, nuts or pickled vegetables."}], "nutrition": {"calories": 175.4, "protein_g": 6.4, "carbohydrates_g": 9.7, "fat_g": 12.8, "saturated_fat_g": 5.7, "trans_fat_g": 0.0, "cholesterol_mg": 33.6, "sodium_mg": 464.5, "fiber_g": 0.8, "sugar_g": 3.6, "unsaturated_fat_g": 5.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["greek"], "diet": ["vegetarian"], "course": ["appetizer"], "meal": ["dinner", "lunch"], "occasion": ["vegetarian thanksgiving"], "other": ["bake", "broil", "dips and spreads", "easy", "feta", "five ingredient", "for one", "quick", "weeknight"]}, "images": [{"url": "https://static01.nyt.com/images/2023/11/01/multimedia/SD-Roasted-Feta-With-Thyme-Honey-vqlk/SD-Roasted-Feta-With-Thyme-Honey-vqlk-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 3623}, "video_url": "https://www.nytimes.com/video/embedded/dining/100000009443519/baked-feta-with-honey.html", "comment_count": null, "published_at": "2007-09-09", "scraped_at": "2026-09-06T22:22:20.892688+00:00", "scraper_version": "1.0.0"}
{"slug": "banana-nut-oatmeal", "nyt_id": 787678669, "url": "https://cooking.nytimes.com/recipes/787678669-banana-nut-oatmeal", "name": "Banana Nut Oatmeal", "author": "Ali Slagle", "description": "This quick, pantry-friendly oatmeal has banana bread sensibilities: It gets its sweetness from mashed banana and its toastiness from nut butter and cinnamon. Cooking the oats in a combination of milk and water makes it creamy but not stodgy, while a scattering of toasted nuts gives these soft bowls a bit of crunch. (You can add more texture with hemp or flax seeds, too.) If your banana isn’t super ripe, you may want to add some maple syrup for sweetness to balance the earthiness of the nuts and oats.", "servings": {"text": "2 servings", "min": 2, "max": 2, "yield_type": "servings"}, "time": {"prep_minutes": 10, "cook_minutes": 10, "total_minutes": 20, "raw": {"total": "20 min", "prep": "PT0H10M", "cook": "PT0H10M"}}, "ingredients": [{"position": 1, "raw": "1 ½ cups unsweetened non-dairy or whole milk, plus more for serving", "group": null, "quantity": 1.5, "quantity_max": null, "unit": "cup", "item": "unsweetened non-dairy or whole milk", "preparation": "plus more for serving", "optional": false}, {"position": 2, "raw": "1 cup water", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup old-fashioned rolled oats", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "cup", "item": "old-fashioned rolled oats", "preparation": null, "optional": false}, {"position": 4, "raw": "Pinch of salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "pinch of salt", "preparation": null, "optional": false}, {"position": 5, "raw": "1 large, ripe banana", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large", "preparation": "ripe banana", "optional": false}, {"position": 6, "raw": "1 tablespoon almond butter", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "almond butter", "preparation": null, "optional": false}, {"position": 7, "raw": "½ teaspoon ground cinnamon, plus more for serving", "group": null, "quantity": 0.5, "quantity_max": null, "unit": "tsp", "item": "ground cinnamon", "preparation": "plus more for serving", "optional": false}, {"position": 8, "raw": "Maple syrup, to taste", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "maple syrup", "preparation": "to taste", "optional": false}, {"position": 9, "raw": "2 tablespoons toasted, chopped nuts, for topping", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "toasted", "preparation": "chopped nuts, for topping", "optional": false}], "steps": [{"position": 1, "text": "In a large, nonstick skillet, combine the milk, water, oats and a pinch of salt. Bring to a simmer over medium-high, then reduce heat to medium and cook, stirring frequently, until the oats are tender and a spoon dragged through the liquid leaves a trail for a second or two, 5 to 7 minutes. (The oatmeal will thicken off the heat.)"}, {"position": 2, "text": "Remove from the heat. Thinly slice the banana. Add half the banana and all the almond butter and cinnamon to the oatmeal. Smash the banana with a fork, then stir to combine. Taste and if you’d like it sweeter, add maple syrup to taste."}, {"position": 3, "text": "Scoop into bowls and top with the remaining banana slices, nuts and a sprinkle of cinnamon – plus a drizzle of milk and maple syrup if you’d like."}], "nutrition": {"calories": 454.2, "protein_g": 15.3, "carbohydrates_g": 64.0, "fat_g": 17.8, "saturated_fat_g": 4.9, "trans_fat_g": 0.0, "cholesterol_mg": 18.3, "sodium_mg": 161.5, "fiber_g": 7.2, "sugar_g": 26.6, "unsaturated_fat_g": 10.9, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": [], "diet": ["egg-free", "soy-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "alcohol-free", "vegetarian", "pescatarian", "high fiber", "vegan", "healthy", "dairy-free"], "course": ["main course"], "meal": ["breakfast"], "occasion": [], "other": ["non-dairy milk", "milk", "rolled oat", "banana", "almond butter", "ground cinnamon", "nut", "oatmeal", "simmer", "for two", "stovetop", "easy", "quick", "one pot"]}, "images": [{"url": "https://static01.nyt.com/images/2026/08/26/multimedia/AS-Banana-Nut-Oatmeal-lqkp/AS-Banana-Nut-Oatmeal-lqkp-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 71}, "video_url": null, "comment_count": null, "published_at": "2026-08-26", "scraped_at": "2026-09-06T22:28:28.044325+00:00", "scraper_version": "1.0.0"}
{"slug": "bananes-flambees-flamed-bananas", "nyt_id": 785942856, "url": "https://cooking.nytimes.com/recipes/785942856-bananes-flambees-flamed-bananas", "name": "Bananes Flambées (Flamed Bananas)", "author": "Pete Wells", "description": "In his classic step-by-step illustrated cookbook “La Technique” (first published in 1976 by Times Books), Jacques Pépin called flamed bananas “an inexpensive and delicious dessert.” And they are. Roasting the bananas in their skins keeps them intact during the initial cooking. Things get trickier once you peel them and introduce them to the caramel sauce. Be gentle. And when it’s time to ignite the rum, watch your fingers. Fireplace matches or one of those butane-fueled grill lighters are helpful, as is a long-handled spoon for basting. Pete Wells", "servings": {"text": "6 servings", "min": 6, "max": 6, "yield_type": "servings"}, "time": {"prep_minutes": 5, "cook_minutes": 35, "total_minutes": 40, "raw": {"total": "40 min", "prep": "PT0H5M", "cook": "PT0H35M"}}, "ingredients": [{"position": 1, "raw": "6 large ripe (not over-ripe) bananas, unpeeled", "group": null, "quantity": 6.0, "quantity_max": null, "unit": null, "item": "large ripe (not over-ripe) bananas", "preparation": "unpeeled", "optional": false}, {"position": 2, "raw": "½ cup/113 grams unsalted butter", "group": null, "quantity": 0.5, "quantity_max": null, "unit": null, "item": "cup/113 grams unsalted butter", "preparation": null, "optional": false}, {"position": 3, "raw": "⅓ cup/66 grams sugar", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": null, "item": "cup/66 grams sugar", "preparation": null, "optional": false}, {"position": 4, "raw": "Juice of 1½ limes", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1½ limes", "preparation": null, "optional": false}, {"position": 5, "raw": "Juice of 1 lemon", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "juice of 1 lemon", "preparation": null, "optional": false}, {"position": 6, "raw": "¼ cup water", "group": null, "quantity": 0.25, "quantity_max": null, "unit": "cup", "item": "water", "preparation": null, "optional": false}, {"position": 7, "raw": "⅓ cup good, dark rum", "group": null, "quantity": 0.3333333333333333, "quantity_max": null, "unit": "cup", "item": "good", "preparation": "dark rum", "optional": false}, {"position": 8, "raw": "Vanilla ice cream, for serving (optional)", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "vanilla ice cream", "preparation": "for serving", "optional": true}], "steps": [{"position": 1, "text": "Heat the oven to 400 degrees. Trim off the ends of the bananas. With the point of a paring knife, make an incision down one side of each banana."}, {"position": 2, "text": "Place bananas in a roasting pan or on a baking sheet and bake for 15 minutes. The skin will turn black and the bananas will become soft to the touch. Keep at room temperature until serving time."}, {"position": 3, "text": "At serving time, melt the butter in a 10-inch, preferably straight-sided pan (not nonstick) over medium-high heat and stir in the sugar, lime juice, lemon juice and water. Cook for about 5 minutes, until it turns a nice golden caramel color. “Unwrap” the bananas into the sauce."}, {"position": 4, "text": "Using a spoon and fork, flip the bananas over in the sauce. Add the rum and gently shake the pan back and forth briefly to combine. With a long match or a long-handled igniter, carefully ignite."}, {"position": 5, "text": "Using a large, long-handled metal spoon, baste the bananas with the sauce until the flames subside. Remove from the heat."}, {"position": 6, "text": "Serve on warm plates or in shallow bowls, 1 banana per person with sauce, with ice cream alongside if you like."}], "nutrition": {"calories": 324.2, "protein_g": 1.8, "carbohydrates_g": 41.1, "fat_g": 16.0, "saturated_fat_g": 9.8, "trans_fat_g": 0.0, "cholesterol_mg": 41.7, "sodium_mg": 6.7, "fiber_g": 3.9, "sugar_g": 26.3, "unsaturated_fat_g": 5.2, "source": "nyt", "basis": "per_serving", "computed_with": null}, "tags": {"cuisine": ["french"], "diet": ["gluten-free", "egg-free", "peanut-free", "tree nut-free", "soy-free", "fish-free", "shellfish-free", "pork-free", "sesame-free", "vegetarian", "pescatarian", "low-sodium"], "course": ["dessert"], "meal": [], "occasion": [], "other": ["banana", "lime juice", "lemon juice", "rum", "roast", "caramelize", "budget"]}, "images": [{"url": "https://static01.nyt.com/images/2026/08/05/multimedia/06FD-PEPIN-BOOKREX-PW-Bananes-Flambees-1-zqml/06FD-PEPIN-BOOKREX-PW-Bananes-Flambees-1-zqml-facebookJumbo.jpg", "alt": "", "primary": true}], "rating": {"average": 5.0, "count": 8}, "video_url": null, "comment_count": null, "published_at": "2026-08-05", "scraped_at": "2026-09-06T22:27:20.099694+00:00", "scraper_version": "1.0.0"}
{"slug": "barbecued-eggplant-chinese-style", "nyt_id": 10923, "url": "https://cooking.nytimes.com/recipes/10923-barbecued-eggplant-chinese-style", "name": "Barbecued Eggplant Chinese Style", "author": "Moira Hodgson", "description": "", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": 15, "total_minutes": 15, "raw": {"total": "15 minutes, plus 1 hour unattended if salt leaching, 10 minutes hands-on."}}, "ingredients": [{"position": 1, "raw": "1 large or four baby eggplant", "group": null, "quantity": 1.0, "quantity_max": null, "unit": null, "item": "large or four baby eggplant", "preparation": null, "optional": false}, {"position": 2, "raw": "Coarse salt", "group": null, "quantity": null, "quantity_max": null, "unit": null, "item": "coarse salt", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons sesame seeds", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "sesame seeds", "preparation": null, "optional": false}, {"position": 4, "raw": "4 tablespoons hoisin sauce", "group": null, "quantity": 4.0, "quantity_max": null, "unit": "tbsp", "item": "hoisin sauce", "preparation": null, "optional": false}, {"position": 5, "raw": "1 tablespoon soy sauce", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "soy sauce", "preparation": null, "optional": false}, {"position": 6, "raw": "1 teaspoon sugar", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tsp", "item": "sugar", "preparation": null, "optional": false}, {"position": 7, "raw": "2 tablespoons dry sherry", "group": null, "quantity": 2.0, "quantity_max": null, "unit": "tbsp", "item": "dry sherry", "preparation": null, "optional": false}, {"position": 8, "raw": "1 tablespoon peanut or vegetable oil", "group": null, "quantity": 1.0, "quantity_max": null, "unit": "tbsp", "item": "peanut or vegetable oil", "preparation": null, "optional": false}, {"
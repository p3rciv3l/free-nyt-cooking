{"slug": "asparagus-salad-with-hard-boiled-eggs", "nyt_id": 1012567, "url": "https://cooking.nytimes.com/recipes/1012567-asparagus-salad-with-hard-boiled-eggs", "name": "Asparagus Salad With Hard-Boiled Eggs", "author": "Martha Rose Shulman", "description": "A classic Italian salad, there are many versions of this dish. Sometimes the asparagus are not cut up, just topped with chopped hard-boiled eggs and vinaigrette. I like to cut them into pieces and toss everything together.", "servings": {"text": "4 servings", "min": 4, "max": 4, "yield_type": "servings"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 15, "raw": {"total": "PT15M"}}, "ingredients": [{"position": 1, "raw": "1 pound asparagus", "group": null, "quantity": 1.0, "unit": "lb", "item": "asparagus", "preparation": null, "optional": false}, {"position": 2, "raw": "2 hard-boiled eggs", "group": null, "quantity": 2.0, "unit": null, "item": "hard-boiled eggs", "preparation": null, "optional": false}, {"position": 3, "raw": "2 tablespoons champagne vinegar or sherry vinegar, or 1 tablespoon each fresh lemon juice and vinegar", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "champagne vinegar or sherry vinegar", "preparation": "or 1 tablespoon each fresh lemon juice and vinegar", "optional": false}, {"position": 4, "raw": "¼ cup extra virgin olive oil", "group": null, "quantity": 0.25, "unit": "cup", "item": "extra virgin olive oil", "preparation": null, "optional": false}, {"position": 5, "raw": "2 teaspoons capers, rinsed and chopped", "group": null, "quantity": 2.0, "unit": "tsp", "item": "capers", "preparation": "rinsed and chopped", "optional": false}, {"position": 6, "raw": "2 tablespoons chopped fresh parsley or a mixture of parsley, chives and tarragon", "group": null, "quantity": 2.0, "unit": "tbsp", "item": "chopped fresh parsley or a mixture of parsley", "preparation": "chives and tarragon", "optional": false}, {"position": 7, "raw": "Salt", "group": null, "quantity":
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p3rciv3l/free-nyt-cooking/schema/recipe.schema.json",
  "title": "NytCookingRecipe",
  "type": "object",
  "required": [
    "slug",
    "nyt_id",
    "url",
    "name",
    "author",
    "description",
    "servings",
    "time",
    "ingredients",
    "steps",
    "nutrition",
    "tags",
    "images",
    "rating",
    "scraped_at",
    "scraper_version"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nyt_id": {
      "type": "integer"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "servings": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "min": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max": {
          "type": [
            "integer",
            "null"
          ]
        },
        "yield_type": {
          "type": "string",
          "enum": [
            "servings",
            "pieces",
            "volume",
            "other"
          ],
          "default": "servings"
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "raw"
      ],
      "properties": {
        "prep_minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cook_minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raw": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "position",
          "raw",
          "group",
          "quantity",
          "unit",
          "item",
          "preparation",
          "optional"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "raw": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "quantity_max": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "item": {
            "type": "string",
            "minLength": 1
          },
          "preparation": {
            "type": [
              "string",
              "null"
            ]
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "text"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nutrition": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "basis"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "nyt",
            "computed",
            "mixed"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "per_serving",
            "per_recipe"
          ],
          "default": "per_serving"
        },
        "calories": {
          "type": [
            "number",
            "null"
          ]
        },
        "protein_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "carbohydrates_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "fat_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "saturated_fat_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "unsaturated_fat_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "trans_fat_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "cholesterol_mg": {
          "type": [
            "number",
            "null"
          ]
        },
        "sodium_mg": {
          "type": [
            "number",
            "null"
          ]
        },
        "fiber_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "sugar_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "computed_with": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tags": {
      "type": "object",
      "required": [
        "cuisine",
        "diet",
        "course",
        "meal",
        "occasion",
        "other"
      ],
      "properties": {
        "cuisine": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diet": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "course": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "occasion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "other": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "primary"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "alt": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          }
        }
      }
    },
    "rating": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "average",
        "count"
      ],
      "properties": {
        "average": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "video_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "comment_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time"
    },
    "scraper_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
{"slug": "lemon-buttermilk-ice-cream", "nyt_id": 10421, "url": "https://cooking.nytimes.com/recipes/10421-lemon-buttermilk-ice-cream", "name": "Lemon-Buttermilk Ice Cream", "author": "William Grimes", "description": "William Grimes", "servings": {"text": "1 quart", "min": 1, "max": 1, "yield_type": "volume"}, "time": {"prep_minutes": null, "cook_minutes": null, "total_minutes": 60, "raw": {"total": "PT1H"}}, "ingredients": [{"position": 1, "raw": "¼ cup fresh lemon juice", "group": null, "quantity": 0.25, "unit": "cup", "item": "fresh lemon juice", "preparation": null, "optional": false}, {"position": 2, "raw": "¾ cup sugar", "group": null, "quantity": 0.75, "unit": "cup", "item": "sugar", "preparation": null, "optional": false}, {"position": 3, "raw": "1 cup milk", "group": null, "quantity": 1.0, "unit": "cup", "item": "milk", "preparation": null, "optional": false}, {"position": 4, "raw": "1 cup buttermilk", "group": null, "quantity": 1.0, "unit": "cup", "item": "buttermilk", "preparation": null, "optional": false}, {"position": 5, "raw": "1 cup heavy cream", "group": null, "quantity": 1.0, "unit": "cup", "item": "heavy cream", "preparation": null, "optional": false}, {"position": 6, "raw": "6 large egg yolks", "group": null, "quantity": 6.0, "unit": null, "item": "large egg yolks", "preparation": null, "optional": false}], "steps": [{"position": 1, "text": "In a small saucepan, combine lemon juice and ¼ cup of sugar. Place over medium-low heat, and stir until dissolved. Remove from heat, and allow to cool."}, {"position": 2, "text": "In a medium, heavy-bottomed saucepan, combine the milk, buttermilk, heavy cream, and ¼ cup of sugar. Place over medium-low heat until steam rises from the surface. Remove from heat."}, {"position": 3, "text": "In a medium mixing bowl, combine egg yolks with remaining ¼ cup sugar. Whisk to blend. While continuing to whisk yolks, slowly drizzle about a cup of the hot milk mixture into them, to gradually warm them. Add yolk mixture to s